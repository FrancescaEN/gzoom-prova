    <select id="getContentListByContentTypeId" resultMap="contentExDataResource" parameterType="java.util.Map">
         SELECT
         C.CHARACTER_SET_ID AS C_CHARACTER_SET_ID, C.CHILD_BRANCH_COUNT AS C_CHILD_BRANCH_COUNT, C.CHILD_LEAF_COUNT AS C_CHILD_LEAF_COUNT, C.CONTENT_ID AS C_CONTENT_ID, C.CONTENT_NAME AS C_CONTENT_NAME, C.CONTENT_TYPE_ID AS C_CONTENT_TYPE_ID, C.CREATED_BY_USER_LOGIN AS C_CREATED_BY_USER_LOGIN, C.CREATED_DATE AS C_CREATED_DATE, C.CREATED_STAMP AS C_CREATED_STAMP, C.CREATED_TX_STAMP AS C_CREATED_TX_STAMP, C.DATA_RESOURCE_ID AS C_DATA_RESOURCE_ID, C.DATA_SOURCE_ID AS C_DATA_SOURCE_ID, C.DECORATOR_CONTENT_ID AS C_DECORATOR_CONTENT_ID, C.DESCRIPTION AS C_DESCRIPTION, C.DESCRIPTION_LANG AS C_DESCRIPTION_LANG, C.INSTANCE_OF_CONTENT_ID AS C_INSTANCE_OF_CONTENT_ID, C.LAST_MODIFIED_BY_USER_LOGIN AS C_LAST_MODIFIED_BY_USER_LOGIN, C.LAST_MODIFIED_DATE AS C_LAST_MODIFIED_DATE, C.LAST_UPDATED_STAMP AS C_LAST_UPDATED_STAMP, C.LAST_UPDATED_TX_STAMP AS C_LAST_UPDATED_TX_STAMP, C.LOCALE_STRING AS C_LOCALE_STRING, C.MIME_TYPE_ID AS C_MIME_TYPE_ID, C.OWNER_CONTENT_ID AS C_OWNER_CONTENT_ID, C.PRIVILEGE_ENUM_ID AS C_PRIVILEGE_ENUM_ID, C.SERVICE_NAME AS C_SERVICE_NAME, C.STATUS_ID AS C_STATUS_ID, C.TEMPLATE_DATA_RESOURCE_ID AS C_TEMPLATE_DATA_RESOURCE_ID,
        DR.CHARACTER_SET_ID AS DR_CHARACTER_SET_ID, DR.CREATED_BY_USER_LOGIN AS DR_CREATED_BY_USER_LOGIN, DR.CREATED_DATE AS DR_CREATED_DATE, DR.CREATED_STAMP AS DR_CREATED_STAMP, DR.CREATED_TX_STAMP AS DR_CREATED_TX_STAMP, DR.DATA_CATEGORY_ID AS DR_DATA_CATEGORY_ID, DR.DATA_RESOURCE_ID AS DR_DATA_RESOURCE_ID, DR.DATA_RESOURCE_NAME AS DR_DATA_RESOURCE_NAME, DR.DATA_RESOURCE_TYPE_ID AS DR_DATA_RESOURCE_TYPE_ID, DR.DATA_SOURCE_ID AS DR_DATA_SOURCE_ID, DR.DATA_TEMPLATE_TYPE_ID AS DR_DATA_TEMPLATE_TYPE_ID, DR.IS_PUBLIC AS DR_IS_PUBLIC, DR.LAST_MODIFIED_BY_USER_LOGIN AS DR_LAST_MODIFIED_BY_USER_LOGIN, DR.LAST_MODIFIED_DATE AS DR_LAST_MODIFIED_DATE, DR.LAST_UPDATED_STAMP AS DR_LAST_UPDATED_STAMP, DR.LAST_UPDATED_TX_STAMP AS DR_LAST_UPDATED_TX_STAMP, DR.LOCALE_STRING AS DR_LOCALE_STRING, DR.MIME_TYPE_ID AS DR_MIME_TYPE_ID, DR.OBJECT_INFO AS DR_OBJECT_INFO, DR.RELATED_DETAIL_ID AS DR_RELATED_DETAIL_ID, DR.STATUS_ID AS DR_STATUS_ID, DR.SURVEY_ID AS DR_SURVEY_ID, DR.SURVEY_RESPONSE_ID AS DR_SURVEY_RESPONSE_ID
        FROM CONTENT C
        INNER JOIN DATA_RESOURCE DR
        ON DR.DATA_RESOURCE_ID = C.DATA_RESOURCE_ID
        WHERE C.CONTENT_TYPE_ID = #{contentTypeId}
    </select>
</mapper>