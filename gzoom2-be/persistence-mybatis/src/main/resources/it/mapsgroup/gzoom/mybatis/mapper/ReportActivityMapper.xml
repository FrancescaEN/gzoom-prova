<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="it.mapsgroup.gzoom.mybatis.mapper.ReportActivityMapper">
    <select id="getActivitiesByStates">
        SELECT *
        FROM REPORT_ACTIVITY RA 
        WHERE
        <include refid="it.mapsgroup.gzoom.mybatis.mapper.CommonMapper.forEachIn">
            <property name="columnName" value="STATUS"/>
            <property name="inList" value="states"/>
        </include>
        ORDER BY ACTIVITY_ID ASC
    </select>
</mapper>