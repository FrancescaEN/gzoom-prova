    <sql id="selectWorkEffortContentEx">
        SELECT WEC.*,
        C.CHARACTER_SET_ID AS C_CHARACTER_SET_ID, C.CHILD_BRANCH_COUNT AS C_CHILD_BRANCH_COUNT, C.CHILD_LEAF_COUNT AS C_CHILD_LEAF_COUNT, C.CONTENT_ID AS C_CONTENT_ID, C.CONTENT_NAME AS C_CONTENT_NAME, C.CONTENT_TYPE_ID AS C_CONTENT_TYPE_ID, C.CREATED_BY_USER_LOGIN AS C_CREATED_BY_USER_LOGIN, C.CREATED_DATE AS C_CREATED_DATE, C.CREATED_STAMP AS C_CREATED_STAMP, C.CREATED_TX_STAMP AS C_CREATED_TX_STAMP, C.DATA_RESOURCE_ID AS C_DATA_RESOURCE_ID, C.DATA_SOURCE_ID AS C_DATA_SOURCE_ID, C.DECORATOR_CONTENT_ID AS C_DECORATOR_CONTENT_ID, C.DESCRIPTION AS C_DESCRIPTION, C.DESCRIPTION_LANG AS C_DESCRIPTION_LANG, C.INSTANCE_OF_CONTENT_ID AS C_INSTANCE_OF_CONTENT_ID, C.LAST_MODIFIED_BY_USER_LOGIN AS C_LAST_MODIFIED_BY_USER_LOGIN, C.LAST_MODIFIED_DATE AS C_LAST_MODIFIED_DATE, C.LAST_UPDATED_STAMP AS C_LAST_UPDATED_STAMP, C.LAST_UPDATED_TX_STAMP AS C_LAST_UPDATED_TX_STAMP, C.LOCALE_STRING AS C_LOCALE_STRING, C.MIME_TYPE_ID AS C_MIME_TYPE_ID, C.OWNER_CONTENT_ID AS C_OWNER_CONTENT_ID, C.PRIVILEGE_ENUM_ID AS C_PRIVILEGE_ENUM_ID, C.SERVICE_NAME AS C_SERVICE_NAME, C.STATUS_ID AS C_STATUS_ID, C.TEMPLATE_DATA_RESOURCE_ID AS C_TEMPLATE_DATA_RESOURCE_ID,
        DR.CHARACTER_SET_ID AS DR_CHARACTER_SET_ID, DR.CREATED_BY_USER_LOGIN AS DR_CREATED_BY_USER_LOGIN, DR.CREATED_DATE AS DR_CREATED_DATE, DR.CREATED_STAMP AS DR_CREATED_STAMP, DR.CREATED_TX_STAMP AS DR_CREATED_TX_STAMP, DR.DATA_CATEGORY_ID AS DR_DATA_CATEGORY_ID, DR.DATA_RESOURCE_ID AS DR_DATA_RESOURCE_ID, DR.DATA_RESOURCE_NAME AS DR_DATA_RESOURCE_NAME, DR.DATA_RESOURCE_TYPE_ID AS DR_DATA_RESOURCE_TYPE_ID, DR.DATA_SOURCE_ID AS DR_DATA_SOURCE_ID, DR.DATA_TEMPLATE_TYPE_ID AS DR_DATA_TEMPLATE_TYPE_ID, DR.IS_PUBLIC AS DR_IS_PUBLIC, DR.LAST_MODIFIED_BY_USER_LOGIN AS DR_LAST_MODIFIED_BY_USER_LOGIN, DR.LAST_MODIFIED_DATE AS DR_LAST_MODIFIED_DATE, DR.LAST_UPDATED_STAMP AS DR_LAST_UPDATED_STAMP, DR.LAST_UPDATED_TX_STAMP AS DR_LAST_UPDATED_TX_STAMP, DR.LOCALE_STRING AS DR_LOCALE_STRING, DR.MIME_TYPE_ID AS DR_MIME_TYPE_ID, DR.OBJECT_INFO AS DR_OBJECT_INFO, DR.RELATED_DETAIL_ID AS DR_RELATED_DETAIL_ID, DR.STATUS_ID AS DR_STATUS_ID, DR.SURVEY_ID AS DR_SURVEY_ID, DR.SURVEY_RESPONSE_ID AS DR_SURVEY_RESPONSE_ID,
        WECT.CONTENT_TYPE_ID AS WECT_CONTENT_TYPE_ID, WECT.CREATED_BY_USER_LOGIN AS WECT_CREATED_BY_USER_LOGIN, WECT.CREATED_STAMP AS WECT_CREATED_STAMP, WECT.CREATED_TX_STAMP AS WECT_CREATED_TX_STAMP, WECT.DESCRIPTION AS WECT_DESCRIPTION, WECT.DESCRIPTION_LANG AS WECT_DESCRIPTION_LANG, WECT.IN_INQUIRY AS WECT_IN_INQUIRY, WECT.LAST_MODIFIED_BY_USER_LOGIN AS WECT_LAST_MODIFIED_BY_USER_LOGIN, WECT.LAST_UPDATED_STAMP AS WECT_LAST_UPDATED_STAMP, WECT.LAST_UPDATED_TX_STAMP AS WECT_LAST_UPDATED_TX_STAMP, WECT.PARENT_TYPE_ID AS WECT_PARENT_TYPE_ID, WECT.WORK_EFFORT_CONTENT_TYPE_ID AS WECT_WORK_EFFORT_CONTENT_TYPE_ID, WEV.WORK_EFFORT_NAME AS WEV_WORK_EFFORT_NAME, WEV.WORK_EFFORT_NAME_LANG AS WEV_WORK_EFFORT_NAME_LANG,  WEV.ETCH AS WEV_ETCH
        FROM WORK_EFFORT_CONTENT WEC
        INNER JOIN CONTENT C
        ON WEC.CONTENT_ID = C.CONTENT_ID
        INNER JOIN WORK_EFFORT_CONTENT_TYPE WECT
        ON WECT.WORK_EFFORT_CONTENT_TYPE_ID = WEC.WORK_EFFORT_CONTENT_TYPE_ID
        INNER JOIN DATA_RESOURCE DR
        ON DR.DATA_RESOURCE_ID = C.DATA_RESOURCE_ID
        INNER JOIN WORK_EFFORT_VIEW WEV
        ON WEV.WORK_EFFORT_ID = WEC.WORK_EFFORT_ID

    </sql>

    <select id="getWorkEffortContentEx" resultMap="workEffortContentEx" parameterType="java.util.Map">
        <include refid="selectWorkEffortContentEx"/>
        where DR.DATA_RESOURCE_ID = #{dataResourceId}
    </select>

    <select id="getWorkEffortContentExList" resultMap="workEffortContentEx" parameterType="java.util.Map">
        <include refid="selectWorkEffortContentEx"/>
    </select>

    <select id="getWorkEffortContentExListFilter" resultMap="workEffortContentEx" parameterType="java.util.Map">
        <include refid="selectWorkEffortContentEx"/>

        <include refid="filterMatch"></include>
        <if test='filters != null '>
            AND (
        </if>
        <include refid="filter"></include>
        <if test='filters != null '>
            )
        </if>
    </select>


    <sql id="filter" >
        <if test='filters != null and filters.length > 0'>
            <foreach collection='filters' item="item" index="index" open=" " close="" separator=" AND ">
                <choose>
                    <when test='item.field == "workEffortIdDesc" and item.value != null'>
                            WEV.WORK_EFFORT_ID = #{item.value}
                    </when>
                    <when test='item.field == "workEffortContentTypeId" and item.value != null' >
                            WECT.work_effort_content_type_id = #{item.value}
                    </when>

                </choose>
            </foreach>
        </if>
    </sql>


    <sql id="filterMatch" >
        <if test='filterGenericLabel != null and filterGenericLabel.length > 0'>
            WHERE (
            <foreach collection='filterGenericLabel' item="item" index="index" open="  " close=""
                     separator=" OR ">
                <choose>
                    <when test='item.field == "workEffortIdMatch" and item.value != null'>
                        <if test='SECONDARYLANGUAGE == true'>
                            <include refid="it.mapsgroup.gzoom.mybatis.mapper.CommonMapper.searchConditions">
                                <property name="columnName" value="WEV.WORK_EFFORT_NAME_LANG"/>
                                <property name="text" value="#{item.value}"/>
                                <property name="matchMode" value="matchModeSearch"/>
                            </include>
                        </if>
                        <if test='SECONDARYLANGUAGE == false'>
                            <include refid="it.mapsgroup.gzoom.mybatis.mapper.CommonMapper.searchConditions">
                                <property name="columnName" value="WEV.WORK_EFFORT_NAME"/>
                                <property name="text" value="#{item.value}"/>
                                <property name="matchMode" value="matchModeSearch"/>
                            </include>
                        </if>
                    </when>
                    <when test='item.field == "workEffortContentTypeIdMatch" and item.value != null'>
                        <if test='SECONDARYLANGUAGE == true'>
                            <include refid="it.mapsgroup.gzoom.mybatis.mapper.CommonMapper.searchConditions">
                                <property name="columnName" value="WECT.DESCRIPTION_LANG"/>
                                <property name="text" value="#{item.value}"/>
                                <property name="matchMode" value="matchModeSearch"/>
                            </include>
                        </if>
                        <if test='SECONDARYLANGUAGE == false'>
                            <include refid="it.mapsgroup.gzoom.mybatis.mapper.CommonMapper.searchConditions">
                                <property name="columnName" value="WECT.DESCRIPTION"/>
                                <property name="text" value="#{item.value}"/>
                                <property name="matchMode" value="matchModeSearch"/>
                            </include>
                        </if>
                    </when>
                </choose>
            </foreach>
            )
        </if>
    </sql>


