<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="it.mapsgroup.gzoom.mybatis.mapper.WorkEffortTypeMapper">

    <select id="getWorkEffortTypes" resultMap="workEffortType">
        SELECT *
        FROM WORK_EFFORT_TYPE
        WHERE
        <foreach item="workEffortTypeId" index="index" collection="workEffortTypeIds" open="WORK_EFFORT_TYPE_ID like " separator=" or WORK_EFFORT_TYPE_ID like " >
         #{workEffortTypeId}
        </foreach>
    </select>

</mapper>