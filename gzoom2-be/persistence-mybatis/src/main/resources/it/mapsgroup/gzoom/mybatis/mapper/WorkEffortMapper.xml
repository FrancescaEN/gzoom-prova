    <sql id="filter">
        <if test='filters != null and filters.length > 0'>
            <foreach collection='filters' item="item" index="index" open="" close="" separator=" AND ">
                <choose>
                    <when test='item.field == "workEffortId" and item.value != null' >
                        LOWER(WE.WORK_EFFORT_ID) LIKE LOWER(CONCAT('%', CONCAT(#{item.value}, '%')))
                    </when>
                    <when test='item.field == "sourceReferenceId" and item.value != null' >
                        LOWER(WE.SOURCE_REFERENCE_ID) LIKE LOWER(CONCAT('%', CONCAT(#{item.value}, '%')))
                    </when>
                    <when test='item.field == "workEffortTypeIdDesc" and item.value != null' >
                        LOWER(WET.WORK_EFFORT_TYPE_ID) LIKE LOWER(CONCAT('%', CONCAT(#{item.value}, '%')))
                    </when>
                    <when test='item.field == "currentStatusDesc" and item.value != null' >
                        LOWER(SI.STATUS_ID) LIKE LOWER(CONCAT('%', CONCAT(#{item.value}, '%')))
                    </when>
                    <when test='item.field == "workEffortName" and item.value != null' >
                        LOWER(concat( WE.etch, concat(' - ', WE.work_effort_name))) LIKE LOWER(CONCAT('%', CONCAT(#{item.value}, '%')))
                    </when>
                    <when test='item.field == "workEffortNameLang" and item.value != null' >
                        LOWER(concat( WE.etch, concat(' - ', WE.work_effort_name_lang))) LIKE LOWER(CONCAT('%', CONCAT(#{item.value}, '%')))
                    </when>
                    <when test='item.field == "estimatedStartDate" and item.dateValue != null' >
                        WE.ESTIMATED_START_DATE   = #{item.dateValue}
                    </when>
                    <when test='item.field == "estimatedCompletionDate" and item.dateValue != null' >
                        WE.ESTIMATED_COMPLETION_DATE   = #{item.dateValue}
                    </when>
                    <when test='item.field == "orgDesc" and item.value != null' >
                        <if test='SECONDARYLANGUAGE == true'>
                            LOWER(P.PARTY_NAME_LANG) LIKE LOWER(CONCAT('%', CONCAT(#{item.value}, '%')))
                        </if>
                        <if test='SECONDARYLANGUAGE == false'>
                            LOWER(P.PARTY_NAME) LIKE LOWER(CONCAT('%', CONCAT(#{item.value}, '%')))
                        </if>
                    </when>
                    <when test='item.field == "orgDesc" and item.objValue != null' >
                        <foreach collection='item.objValue' item="e" index="index2" open="" close="" separator=" AND ">
                            <choose>
                            <when test='e.field == "roleTypeId"' >
                                RT.ROLE_TYPE_ID = #{e.value}
                            </when>
                            <when test='e.field == "partyId"' >
                                P.PARTY_ID = #{e.value}
                            </when>
                            </choose>
                        </foreach>
                    </when>
                </choose>
            </foreach>
        </if>
    </sql>

