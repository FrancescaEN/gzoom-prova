    <select id="getWorkEfforts" resultMap="workEffortResultMap" parameterType="java.util.Map">
        SELECT WE.* FROM WORK_EFFORT WE
        INNER JOIN WORK_EFFORT_TYPE WET ON WET.WORK_EFFORT_TYPE_ID = WE.WORK_EFFORT_TYPE_ID

        <if test="(filter.isOrgMgr or filter.isSup or filter.isTop) and useFilter">
        INNER JOIN USER_LOGIN_VALID_PARTY_ROLE ULVPR ON ULVPR.PARTY_ID = WE.ORGANIZATION_ID
                                                            AND ULVPR.ROLE_TYPE_ID = 'INTERNAL_ORGANIZATIO'
                                                            AND ULVPR.USER_LOGIN_ID = #{userLoginId}
        INNER JOIN USER_LOGIN UL ON UL.USER_LOGIN_ID = ULVPR.USER_LOGIN_ID
        INNER JOIN STATUS_ITEM SI ON SI.STATUS_ID = WE.CURRENT_STATUS_ID

        LEFT JOIN WORK_EFFORT_TYPE_STATUS WETS ON WETS.WORK_EFFORT_TYPE_ROOT_ID = WE.WORK_EFFORT_TYPE_ID
                                                      AND WE.CURRENT_STATUS_ID = WETS.CURRENT_STATUS_ID

        LEFT JOIN PARTY_RELATIONSHIP PRE ON PRE.ROLE_TYPE_ID_FROM = WE.ORG_UNIT_ROLE_TYPE_ID
                                                AND PRE.PARTY_ID_FROM = WE.ORG_UNIT_ID
                                                AND (
                                                    PRE.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
                                                        OR (
                                                            PRE.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_DELEGATE'
                                                                AND (
                                                                    PRE.CTX_ENABLED IS NULL OR PRE.CTX_ENABLED LIKE concat('%', concat(#{parentTypeId},'%'))
                                                                    )
                                                            )
                                                    )
                                                AND PRE.FROM_DATE &lt;= WE.ESTIMATED_COMPLETION_DATE
                                                AND(PRE.THRU_DATE IS NULL OR PRE.THRU_DATE &gt;= WE.ESTIMATED_COMPLETION_DATE)
                                                AND PRE.PARTY_ID_TO = UL.PARTY_ID

        LEFT JOIN PARTY_RELATIONSHIP PRZ ON PRZ.ROLE_TYPE_ID_TO = WE.ORG_UNIT_ROLE_TYPE_ID
                                                AND PRZ.PARTY_ID_TO = WE.ORG_UNIT_ID
                                                AND PRZ.PARTY_RELATIONSHIP_TYPE_ID = 'GROUP_ROLLUP'
                                                AND PRZ.FROM_DATE &lt;= WE.ESTIMATED_COMPLETION_DATE
                                                AND (PRZ.THRU_DATE IS NULL OR PRZ.THRU_DATE &gt;= WE.ESTIMATED_COMPLETION_DATE)

        LEFT JOIN PARTY_RELATIONSHIP PRY ON PRY.ROLE_TYPE_ID_FROM = PRZ.ROLE_TYPE_ID_FROM
                                                AND PRY.PARTY_ID_FROM = PRZ.PARTY_ID_FROM
                                                AND (
                                                    PRY.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
                                                        OR (
                                                            PRY.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_DELEGATE'
                                                                AND (
                                                                    PRY.CTX_ENABLED IS NULL OR PRY.CTX_ENABLED  LIKE concat('%', concat(#{parentTypeId},'%'))
                                                                    )
                                                            )
                                                    )
                                                AND PRY.FROM_DATE &lt;= WE.ESTIMATED_COMPLETION_DATE
                                                AND (PRY.THRU_DATE IS NULL OR PRY.THRU_DATE &gt;= WE.ESTIMATED_COMPLETION_DATE)
                                                AND PRY.PARTY_ID_TO = UL.PARTY_ID

            LEFT JOIN PARTY_RELATIONSHIP PRZ2 ON PRZ2.ROLE_TYPE_ID_TO = PRZ.ROLE_TYPE_ID_FROM
                                                     AND PRZ2.PARTY_ID_TO = PRZ.PARTY_ID_FROM
                                                     AND PRZ2.PARTY_RELATIONSHIP_TYPE_ID = 'GROUP_ROLLUP'
                                                     AND PRZ2.FROM_DATE &lt;= WE.ESTIMATED_COMPLETION_DATE
                                                     AND (PRZ2.THRU_DATE IS NULL OR PRZ2.THRU_DATE &gt;= WE.ESTIMATED_COMPLETION_DATE)

            LEFT JOIN PARTY_RELATIONSHIP PRY2 ON PRY2.ROLE_TYPE_ID_FROM = PRZ2.ROLE_TYPE_ID_FROM
                                                     AND PRY2.PARTY_ID_FROM = PRZ2.PARTY_ID_FROM
                                                     AND (
                                                         PRY2.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
                                                             OR (
                                                                 PRY2.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_DELEGATE'
                                                                     AND (
                                                                         PRY2.CTX_ENABLED IS NULL OR PRY2.CTX_ENABLED  LIKE concat('%', concat(#{parentTypeId},'%'))
                                                                         )
                                                                 )
                                                         )
                                                     AND PRY2.FROM_DATE &lt;= WE.ESTIMATED_COMPLETION_DATE
                                                     AND (PRY2.THRU_DATE IS NULL OR PRY2.THRU_DATE &gt;= WE.ESTIMATED_COMPLETION_DATE)
                                                     AND PRY2.PARTY_ID_TO = UL.PARTY_ID

        LEFT JOIN WORK_EFFORT_PARTY_ASSIGNMENT WEPA ON WEPA.WORK_EFFORT_ID = WE.WORK_EFFORT_ID
                                                           AND WEPA.THRU_DATE = WE.ESTIMATED_COMPLETION_DATE
                                                           AND WEPA.ROLE_TYPE_ID LIKE 'WEM%'
                                                           AND WEPA.PARTY_ID = UL.PARTY_ID

        INNER JOIN PARTY P ON P.PARTY_ID = WE.ORG_UNIT_ID
        INNER JOIN PARTY_PARENT_ROLE PPR ON PPR.PARTY_ID = P.PARTY_ID
                                                AND PPR.ROLE_TYPE_ID = 'ORGANIZATION_UNIT'
        </if>

        WHERE
        <foreach collection='workEffortTypeIds' item="item" index="index" open="" close="" separator=" OR " >
            WE.WORK_EFFORT_TYPE_ID LIKE #{item}
        </foreach>
            AND WET.PARENT_TYPE_ID LIKE 'CTX%'
            AND WE.WORK_EFFORT_REVISION_ID IS NULL
            AND WE.ORGANIZATION_ID = #{userPreferenceOrganizationUnitId}
        <if test="filter.isOrgMgr and useFilter">
            AND PRE.PARTY_ID_TO IS NOT NULL
        </if>
        <if test="filter.isSup and useFilter">
            AND PRY.PARTY_ID_TO IS NOT NULL
        </if>
        <if test="filter.isRole and useFilter">
            AND WEPA.PARTY_ID IS NOT NULL
        </if>
        <if test="filter.isTop and useFilter">
            AND PRY2.PARTY_ID_TO IS NOT NULL
        </if>

        ORDER BY WET.SEQ_ESP ASC, WE.SOURCE_REFERENCE_ID ASC, WE.WORK_EFFORT_NAME ASC, WET.DESCRIPTION ASC

    </select>

