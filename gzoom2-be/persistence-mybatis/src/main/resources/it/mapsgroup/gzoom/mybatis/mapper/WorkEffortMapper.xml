    <update id="anonymizeWorkEffort">
        UPDATE
            WORK_EFFORT
        SET WORK_EFFORT_NAME = WORK_EFFORT_ID
        WHERE WORK_EFFORT_ID IN (
        <if test="_databaseId == 'mysql'">
            SELECT WORK_EFFORT_ID FROM(
        </if>
               SELECT WE.WORK_EFFORT_ID
               FROM WORK_EFFORT WE
                        INNER JOIN WORK_EFFORT_TYPE WET ON
                   WET.WORK_EFFORT_TYPE_ID = WE.WORK_EFFORT_TYPE_ID
                        INNER JOIN WORK_EFFORT_PARTY_ASSIGNMENT WP ON
                   WP.WORK_EFFORT_ID = WE.WORK_EFFORT_ID
                       AND WP.ROLE_TYPE_ID = 'WEM_EVAL_IN_CHARGE'
                        INNER JOIN PARTY PA ON
                   PA.PARTY_ID = WP.PARTY_ID
                       AND PA.STATUS_ID = 'PARTY_DISABLED'
                       AND PA.END_DATE IS NOT NULL
                       AND PA.END_DATE &lt; #{expirationDate}
               WHERE WET.PARENT_TYPE_ID IN ('CTX_EP', 'CTX_DI')
                 AND WET.IS_TEMPLATE = 'N'
                 AND WET.IS_ROOT = 'Y'
                 AND WE.WORK_EFFORT_NAME &lt;&gt; WE.WORK_EFFORT_ID
        <if test="_databaseId == 'mysql'">
            ) AS subquery
        </if>
               )
    </update>

