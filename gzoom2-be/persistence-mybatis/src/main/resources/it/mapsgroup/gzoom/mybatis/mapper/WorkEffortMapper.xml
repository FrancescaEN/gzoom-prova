    join status_item si on si.status_id = we.current_status_id
    join status_type st on st.status_type_id = si.status_type_id
    join party p on p.party_id = we.org_unit_id
    join role_type rt on rt.role_type_id = we.org_unit_role_type_id
    inner join party_parent_role pp on pp.party_id = p.party_id
    <if test='_databaseId == "mysql"'>
        join (
        select COUNT(*) AS "TOTALE"
        from work_effort we
        join work_effort_type wet on wet.work_effort_type_id = we.work_effort_type_id
        join status_item si on si.status_id = we.current_status_id
        join status_type st on st.status_type_id = si.status_type_id
        join party p on p.party_id = we.org_unit_id
        join role_type rt on rt.role_type_id = we.org_unit_role_type_id
        inner join party_parent_role pp on pp.party_id = p.party_id
        where pp.role_type_id = 'ORGANIZATION_UNIT'
        and pp.organization_id = #{ORGANIZATIONID}
        <include refid="filterMatch"></include>
        <if test='filters != null and filters.length > 0'>
            AND (
        </if>
