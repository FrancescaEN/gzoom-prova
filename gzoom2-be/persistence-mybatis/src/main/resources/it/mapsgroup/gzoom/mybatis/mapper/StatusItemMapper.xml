    <select id="getStatusItems" resultMap="StatusItem2" parameterType="java.util.Map">
        SELECT SI.*, WE.*, WET.*
        FROM STATUS_ITEM SI
        INNER JOIN WORK_EFFORT WE ON WE.CURRENT_STATUS_ID = SI.STATUS_ID
        INNER JOIN WORK_EFFORT_TYPE WET ON WET.WORK_EFFORT_TYPE_ID = WE.WORK_EFFORT_TYPE_ID
        WHERE WE.WORK_EFFORT_REVISION_ID IS NULL
          AND WET.IS_TEMPLATE = 'N'
          AND WET.IS_ROOT = 'Y'
          AND WET.PARENT_TYPE_ID = #{userLoginId}
        ORDER BY SI.SEQUENCE_ID ASC
   </select>

