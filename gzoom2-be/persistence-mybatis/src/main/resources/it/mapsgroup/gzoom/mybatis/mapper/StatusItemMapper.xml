    <resultMap id="StatusItemExType" type="it.mapsgroup.gzoom.mybatis.dto.StatusItemExType">
        <id column="status_id" property="statusId" jdbcType="VARCHAR"/>
        <result column="description" property="description" jdbcType="VARCHAR"/>
        <result column="description_lang" property="descriptionLang" jdbcType="VARCHAR"/>
        <association property="statusType" columnPrefix="ST_" resultMap="it.mapsgroup.gzoom.mybatis.mapper.StatusTypeMapper.statusType"/>
    </resultMap>
    <select id="getStatusItemStateTo" resultMap="StatusItemExType" parameterType="java.util.Map">
        SELECT
            SI.STATUS_ID,
            SI.DESCRIPTION,
            SI.DESCRIPTION_LANG,
            ST.DESCRIPTION AS ST_DESCRIPTION
        FROM
            STATUS_ITEM SI
        INNER JOIN STATUS_TYPE ST ON
            ST.STATUS_TYPE_ID = SI.STATUS_TYPE_ID
        ORDER BY
            ST.DESCRIPTION ASC,
            SI.SEQUENCE_ID ASC
    </select>

    <select id="getStatusItemStateFrom" resultMap="StatusItemExType" parameterType="java.util.Map">
        SELECT
            SI.STATUS_ID,
            SI.DESCRIPTION,
            SI.DESCRIPTION_LANG,
            ST.DESCRIPTION AS ST_DESCRIPTION
        FROM
            STATUS_ITEM SI
                INNER JOIN STATUS_TYPE ST ON
                ST.STATUS_TYPE_ID = SI.STATUS_TYPE_ID
        WHERE SI.STATUS_TYPE_ID = #{statusTypeId,jdbcType=VARCHAR}
        ORDER BY
            ST.DESCRIPTION ASC,
            SI.SEQUENCE_ID ASC
    </select>

    <resultMap id="StatusItem" type="it.mapsgroup.gzoom.mybatis.dto.StatusItem">
        <result column = "DESCRIPTION" property = "description" jdbcType="VARCHAR"/>
        <result column = "DESCRIPTION_LANG" property = "descriptionLang" jdbcType="VARCHAR"/>
        <result column = "STATUS_ID" property = "statusId" jdbcType="VARCHAR"/>
    </resultMap>

    <select id="getTimesheetStatusDropdownFilter" resultMap="StatusItem" parameterType="java.util.Map">
        SELECT DISTINCT ST.DESCRIPTION  AS "DESCRIPTION", ST.DESCRIPTION_LANG  AS "DESCRIPTION_LANG", ST.STATUS_ID  AS "STATUS_ID"
        FROM TIMESHEET TM
        INNER JOIN TS_BY_USER_LOGIN TU ON TU.TIMESHEET_ID = TM.TIMESHEET_ID AND TU.USER_LOGIN_ID = #{userLoginId}
        INNER JOIN STATUS_ITEM ST ON ST.STATUS_ID = TM.STATUS_ID
   </select>

