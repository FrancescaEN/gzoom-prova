    <select id="findTimesheetsPagination" resultMap="TimesheetExResultMap" parameterType="java.util.Map">
        SELECT TM.*,
        PE.PARTY_NAME AS "PARTY_PARTY_NAME",
        UO.PARTY_NAME AS "PARTY_STRUCTURE_PARTY_NAME", UO.PARTY_NAME_LANG AS "PARTY_STRUCTURE_PARTY_NAME_LANG",
        ST.DESCRIPTION AS "STATUS_ITEM_DESC", ST.DESCRIPTION_LANG AS "STATUS_ITEM_DESC_LANG",
        UM.DESCRIPTION AS "UOM_DESCRIPTION", UM.DESCRIPTION_LANG AS "UOM_DESCRIPTION_LANG",
        TU.UPDATEABLE AS "TS_BY_USER_LOGIN",
        CTP.PERIOD_NAME AS "CUSTOM_TIME_PERIOD_PERIOD_NAME",
        CTP.PERIOD_NAME_LANG AS "CUSTOM_TIME_PERIOD_PERIOD_NAME_LANG",
        PPR.PARENT_ROLE_CODE AS "PARTY_PARENT_ROLE_PARENT_ROLE_CODE",
        PPO.PARENT_ROLE_CODE AS "PARTY_PARENT_ROLE_USER_PARENT_ROLE_CODE",
        COUNT(*) OVER () AS "TOTALE"
        FROM TIMESHEET TM
        INNER JOIN TS_BY_USER_LOGIN TU
        ON TU.TIMESHEET_ID = TM.TIMESHEET_ID AND TU.USER_LOGIN_ID = #{userLoginId}
        INNER JOIN PARTY_HISTORY_VIEW PV
        ON PV.PARTY_ID = TM.PARTY_ID AND PV.FROM_DATE &lt; TM.THRU_DATE AND (PV.THRU_DATE IS NULL OR PV.THRU_DATE &gt; TM.THRU_DATE)
        INNER JOIN EMPL_POSITION_TYPE EP
        ON EP.EMPL_POSITION_TYPE_ID = PV.EMPL_POSITION_TYPE_ID
        INNER JOIN STATUS_ITEM ST
        ON ST.STATUS_ID = TM.STATUS_ID
        INNER JOIN WORK_EFFORT_TYPE_PERIOD PDO
        ON PDO.WORK_EFFORT_TYPE_PERIOD_ID = TM.WORK_EFFORT_TYPE_PERIOD_ID
        INNER JOIN PARTY PE
        ON PE.PARTY_ID = TU.PARTY_ID_PE
        INNER JOIN PARTY UO
        ON UO.PARTY_ID = TU.PARTY_ID_UO
        INNER JOIN UOM UM
        ON UM.UOM_ID = TM.EFFORT_UOM_ID
        INNER JOIN WORK_EFFORT_NOTE WN
        ON WN.WORK_EFFORT_ID = TM.WORK_EFFORT_ID AND WN.SEQUENCE_ID = 10
        INNER JOIN NOTE_DATA ND
        ON ND.NOTE_ID = WN.NOTE_ID
        INNER JOIN PARTY_PARENT_ROLE PPR
        ON PPR.PARTY_ID = TU.PARTY_ID_PE
        INNER JOIN PARTY_PARENT_ROLE PPO
        ON PPO.PARTY_ID = TU.PARTY_ID_UO
        INNER JOIN CUSTOM_TIME_PERIOD CTP
        ON CTP.CUSTOM_TIME_PERIOD_ID = PDO.CUSTOM_TIME_PERIOD_ID

        <if test='filters != null and filters.length > 0'>
            <foreach collection='filters' item="item" index="index" open="WHERE " close="" separator=" AND " >
                <choose>
                    <when test='item.field == "workEffortTypePeriod" and item.value != null' >
                        <if test='SECONDARYLANGUAGE == true'>
                            LOWER(CTP.PERIOD_NAME_LANG) LIKE  LOWER(CONCAT('%', CONCAT(#{item.value}, '%')))
                        </if>
                        <if test='SECONDARYLANGUAGE == false'>
                             LOWER(CTP.PERIOD_NAME) LIKE  LOWER(CONCAT('%', CONCAT(#{item.value}, '%')))
                        </if>
                    </when>
                    <when test='item.field == "partyName" and item.value != null' >
                         LOWER(PE.PARTY_NAME) LIKE  LOWER(CONCAT('%', CONCAT(#{item.value}, '%'))) OR  LOWER(PPR.PARENT_ROLE_CODE) LIKE LOWER(CONCAT('%', CONCAT(#{item.value}, '%')))
                    </when>
                    <when test='item.field == "abbreviation" and item.value != null' >
                        <if test='SECONDARYLANGUAGE == true'>
                              LOWER(UM.DESCRIPTION_LANG) LIKE  LOWER(CONCAT('%', CONCAT(#{item.value}, '%')))
                        </if>
                        <if test='SECONDARYLANGUAGE == false'>
                              LOWER(UM.DESCRIPTION) LIKE  LOWER(CONCAT('%', CONCAT(#{item.value}, '%')))
                        </if>
                    </when>
                    <when test='item.field == "partyStructure" and item.value != null' >
                        <if test='SECONDARYLANGUAGE == true'>
                             LOWER(PPO.PARENT_ROLE_CODE) LIKE LOWER(CONCAT('%', CONCAT(#{item.value}, '%'))) OR LOWER(UO.PARTY_NAME_LANG) LIKE LOWER(CONCAT('%', CONCAT(#{item.value}, '%')))
                        </if>
                        <if test='SECONDARYLANGUAGE == false'>
                             LOWER(PPO.PARENT_ROLE_CODE) LIKE LOWER(CONCAT('%', CONCAT(#{item.value}, '%'))) OR LOWER(UO.PARTY_NAME) LIKE LOWER(CONCAT('%', CONCAT(#{item.value}, '%')))
                        </if>
                    </when>
                    <when test='item.field == "actualHours" and item.value != null' >
                         TM.ACTUAL_HOURS = #{item.doubleValue}
                    </when>
                    <when test='item.field == "description" and item.value != null' >
                        ST.STATUS_ID = #{item.value}
                    </when>
                    <when test='item.field == "updatable" and item.value != null' >
                         LOWER(TU.UPDATEABLE) LIKE LOWER(CONCAT('%', CONCAT(#{item.value}, '%')))
                    </when>
                </choose>
            </foreach>
        </if>

        <if test='SORTFIELD != null'>
            <choose>

                <when test='SORTFIELD == "workEffortTypePeriod"' >
                    <if test='SORTORDER == 1 and SECONDARYLANGUAGE == true'>
                        ORDER BY CTP.PERIOD_NAME_LANG ASC
                    </if>
                    <if test='SORTORDER == 1 and SECONDARYLANGUAGE == false'>
                        ORDER BY CTP.PERIOD_NAME_LANG ASC
                    </if>
                    <if test='SORTORDER == -1 and SECONDARYLANGUAGE == true'>
                        ORDER BY CTP.PERIOD_NAME ASC
                    </if>
                    <if test='SORTORDER == -1 and SECONDARYLANGUAGE == false'>
                        ORDER BY CTP.PERIOD_NAME DESC
                    </if>
                </when>
                <when test='SORTFIELD == "partyName"' >
                    <if test='SORTORDER == 1'>
                        ORDER BY PE.PARTY_NAME ASC
                    </if>
                    <if test='SORTORDER == -1'>
                        ORDER BY PE.PARTY_NAME DESC
                    </if>
                </when>
                <when test='SORTFIELD == "abbreviation"' >
                    <if test='SORTORDER == 1 and SECONDARYLANGUAGE == true'>
                        ORDER BY UM.DESCRIPTION_LANG ASC
                    </if>
                    <if test='SORTORDER == 1 and SECONDARYLANGUAGE == false'>
                        ORDER BY UM.DESCRIPTION_LANG ASC
                    </if>
                    <if test='SORTORDER == -1 and SECONDARYLANGUAGE == true'>
                        ORDER BY UM.DESCRIPTION ASC
                    </if>
                    <if test='SORTORDER == -1 and SECONDARYLANGUAGE == false'>
                        ORDER BY UM.DESCRIPTION DESC
                    </if>
                </when>
                <when test='SORTFIELD == "partyStructure"' >
                    <if test='SORTORDER == 1 and SECONDARYLANGUAGE == true'>
                        ORDER BY UO.PARTY_NAME_LANG ASC
                    </if>
                    <if test='SORTORDER == 1 and SECONDARYLANGUAGE == false'>
                        ORDER BY UO.PARTY_NAME_LANG ASC
                    </if>
                    <if test='SORTORDER == -1 and SECONDARYLANGUAGE == true'>
                        ORDER BY UO.PARTY_NAME ASC
                    </if>
                    <if test='SORTORDER == -1 and SECONDARYLANGUAGE == false'>
                        ORDER BY UO.PARTY_NAME DESC
                    </if>
                </when>
                <when test='SORTFIELD == "actualHours"' >
                    <if test='SORTORDER == 1'>
                        ORDER BY TM.ACTUAL_HOURS ASC
                    </if>
                    <if test='SORTORDER == -1'>
                        ORDER BY TM.ACTUAL_HOURS DESC
                    </if>
                </when>
                <when test='SORTFIELD == "description"' >
                    <if test='SORTORDER == 1 and SECONDARYLANGUAGE == true'>
                        ORDER BY ST.DESCRIPTION_LANG ASC
                    </if>
                    <if test='SORTORDER == 1 and SECONDARYLANGUAGE == false'>
                        ORDER BY ST.DESCRIPTION_LANG ASC
                    </if>
                    <if test='SORTORDER == -1 and SECONDARYLANGUAGE == true'>
                        ORDER BY ST.DESCRIPTION ASC
                    </if>
                    <if test='SORTORDER == -1 and SECONDARYLANGUAGE == false'>
                        ORDER BY ST.DESCRIPTION DESC
                    </if>
                </when>
            </choose>
        </if>
        <if test='SORTFIELD == null'>
            ORDER BY TU.UPDATEABLE DESC, CTP.CUSTOM_TIME_PERIOD_ID DESC, PE.PARTY_NAME ASC
        </if>
        <if test='_databaseId == "mysql"'>
            LIMIT #{LIMIT}
            OFFSET #{OFFSET}
        </if>
        <if  test='_databaseId != "mysql"'>
            OFFSET #{OFFSET} ROWS FETCH NEXT #{LIMIT} ROWS ONLY
        </if>
    </select>

