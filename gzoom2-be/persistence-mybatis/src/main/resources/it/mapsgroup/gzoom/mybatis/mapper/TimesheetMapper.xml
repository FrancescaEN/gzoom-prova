    <select id="getTimesheetExsById" resultMap="TimesheetExResultMap3" parameterType="java.util.Map">
        SELECT TM.*, PV.*, ND.*, PDO.*, UM.*, TU.*, CTP.*,
        PE.PARTY_NAME AS "PARTY_PARTY_NAME",
        UO.PARTY_NAME AS "PARTY_STRUCTURE_PARTY_NAME", UO.PARTY_NAME_LANG AS "PARTY_STRUCTURE_PARTY_NAME_LANG",
        ST.DESCRIPTION AS "STATUS_ITEM_DESC", ST.DESCRIPTION_LANG AS "STATUS_ITEM_DESC_LANG"
        FROM TIMESHEET TM
        INNER JOIN TS_BY_USER_LOGIN TU
        ON TU.TIMESHEET_ID = TM.TIMESHEET_ID AND TU.USER_LOGIN_ID = #{userLoginId}
        INNER JOIN PARTY_HISTORY_VIEW PV
        ON PV.PARTY_ID = TM.PARTY_ID AND PV.FROM_DATE &lt; TM.THRU_DATE AND (PV.THRU_DATE IS NULL OR PV.THRU_DATE &gt; TM.THRU_DATE)
        INNER JOIN EMPL_POSITION_TYPE EP
        ON EP.EMPL_POSITION_TYPE_ID = PV.EMPL_POSITION_TYPE_ID
        INNER JOIN STATUS_ITEM ST
        ON ST.STATUS_ID = TM.STATUS_ID
        INNER JOIN WORK_EFFORT_TYPE_PERIOD PDO
        ON PDO.WORK_EFFORT_TYPE_PERIOD_ID = TM.WORK_EFFORT_TYPE_PERIOD_ID
        INNER JOIN PARTY PE
        ON PE.PARTY_ID = TU.PARTY_ID_PE
        INNER JOIN PARTY UO
        ON UO.PARTY_ID = TU.PARTY_ID_UO
        INNER JOIN UOM UM
        ON UM.UOM_ID = TM.EFFORT_UOM_ID
        INNER JOIN WORK_EFFORT_NOTE WN
        ON WN.WORK_EFFORT_ID = TM.WORK_EFFORT_ID AND WN.SEQUENCE_ID = 10
        INNER JOIN NOTE_DATA ND
        ON ND.NOTE_ID = WN.NOTE_ID
        INNER JOIN PARTY_PARENT_ROLE PPR
        ON PPR.PARTY_ID = TU.PARTY_ID_PE
        INNER JOIN PARTY_PARENT_ROLE PPO
        ON PPO.PARTY_ID = TU.PARTY_ID_UO
        INNER JOIN CUSTOM_TIME_PERIOD CTP
        ON CTP.CUSTOM_TIME_PERIOD_ID = PDO.CUSTOM_TIME_PERIOD_ID
        WHERE TM.TIMESHEET_ID = #{timesheetId}

    </select>

