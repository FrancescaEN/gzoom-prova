<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="it.mapsgroup.gzoom.mybatis.mapper.WorkEffortStatusMapper">

    <resultMap id="workEffortStatusResultMap" type="it.mapsgroup.gzoom.mybatis.dto.WorkEffortStatusEx">
        <id property="workEffortId" column="work_effort_id" jdbcType="VARCHAR"/>
        <id property="statusId" column="status_id" jdbcType="VARCHAR"/>
        <id property="statusDatetime" column="status_datetime" jdbcType="TIMESTAMP"/>
        <result column="set_by_user_login" property="setByUserLogin" jdbcType="VARCHAR"/>
        <result column="reason" property="reason" jdbcType="VARCHAR"/>
        <result column="last_updated_stamp" property="lastUpdatedStamp" jdbcType="TIMESTAMP"/>
        <result column="last_updated_tx_stamp" property="lastUpdatedTxStamp" jdbcType="TIMESTAMP"/>
        <result column="created_stamp" property="createdStamp" jdbcType="TIMESTAMP"/>
        <result column="created_tx_stamp" property="createdTxStamp" jdbcType="TIMESTAMP"/>
        <result column="last_modified_by_user_login" property="lastModifiedByUserLogin" jdbcType="VARCHAR"/>
        <result column="created_by_user_login" property="createdByUserLogin" jdbcType="VARCHAR"/>

        <result column="DESCRIPTION" property="statusItem.description" jdbcType="VARCHAR"/>
        <result column="DESCLANG" property="statusItem.descriptionLang" jdbcType="VARCHAR"/>
    </resultMap>


    <select id="selectWorkEffortStatusEx" resultMap="workEffortStatusResultMap" parameterType="java.util.Map">
        select wes.*, si.description AS DESCRIPTION , si.description_lang AS DESCLANG  from work_effort_status wes
        join status_item si on si.status_id = wes.status_id
        where wes.work_effort_id = #{workEffortId}
    </select>

</mapper>