<?xml version="1.0" encoding="UTF-8"?>
<fontFamilies>
    <fontFamily name="Helvetica">
        <!-- Normal Helvetica Font -->
        <normal><![CDATA[fonts/Helvetica/Helvetica.ttf]]></normal> <!-- location of the normal font on resource folder -->
        <!-- Bold Helvetica Font -->
        <bold><![CDATA[fonts/Helvetica/Helvetica-Bold.ttf]]></bold>
        <!-- Italic Helvetica Font -->
        <italic><![CDATA[fonts/Helvetica/Helvetica-Oblique.ttf]]></italic>
        <!-- Bolt italic Helvetica Font -->
        <boldItalic><![CDATA[fonts/Helvetica/Helvetica-BoldOblique.ttf]]></boldItalic>
        <!-- Is font is embedded in PDF -->
        <pdfEncoding><![CDATA[Identity-H]]></pdfEncoding>
        <pdfEmbedded><![CDATA[true]]></pdfEmbedded>
    </fontFamily>
    <fontFamily name="Times-New-Roman">
        <!-- Normal Helvetica Font -->
        <normal><![CDATA[fonts/Times-New-Roman/times-new-roman.ttf]]></normal> <!-- location of the normal font on resource folder -->
        <!-- Bold Helvetica Font -->
        <bold><![CDATA[fonts/Times-New-Roman/times-new-roman-bold.ttf]]></bold>
        <!-- Italic Helvetica Font -->
        <italic><![CDATA[fonts/Times-New-Roman/times-new-roman-bold-italic.ttf]]></italic>
        <!-- Bolt italic Helvetica Font -->
        <boldItalic><![CDATA[fonts/Times-New-Roman/times-new-roman-italic.ttf]]></boldItalic>
        <!-- Is font is embedded in PDF -->
        <pdfEncoding><![CDATA[Identity-H]]></pdfEncoding>
        <pdfEmbedded><![CDATA[true]]></pdfEmbedded>
    </fontFamily>
    <fontFamily name="Titillium-Web">
        <!-- Normal Titillium-Web Font -->
        <normal><![CDATA[fonts/Titillium-Web/TitilliumWeb-Regular.ttf]]></normal> <!-- location of the normal font on resource folder -->
        <!-- Bold Titillium-Web Font -->
        <bold><![CDATA[fonts/Titillium-Web/TitilliumWeb-Bold.ttf]]></bold>
        <!-- Italic Titillium-Web Font -->
        <italic><![CDATA[fonts/Titillium-Web/TitilliumWeb-BoldItalic.ttf]]></italic>
        <!-- Bolt italic Titillium-Web Font -->
        <boldItalic><![CDATA[fonts/Titillium-Web/TitilliumWeb-Italic.ttf]]></boldItalic>
        <!-- Is font is embedded in PDF -->
        <pdfEncoding><![CDATA[Identity-H]]></pdfEncoding>
        <pdfEmbedded><![CDATA[true]]></pdfEmbedded>
    </fontFamily>
</fontFamilies>