                </structure>
                <structure>
                    <property name="position">49</property>
                    <property name="name">BUDGET_RIF_3112</property>
                    <property name="nativeName">BUDGET_RIF_3112</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">50</property>
                    <property name="name">BUDGET_RIF_3112_PIU_UNO</property>
                    <property name="nativeName">BUDGET_RIF_3112_PIU_UNO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">51</property>
                    <property name="name">BUDGET_RIF_3112_PIU_DUE</property>
                    <property name="nativeName">BUDGET_RIF_3112_PIU_DUE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">52</property>
                    <property name="name">SCORE_DATO_3006</property>
                    <property name="nativeName">SCORE_DATO_3006</property>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="position">53</property>
                    <property name="name">SCORE_DATO_3112</property>
                    <property name="nativeName">SCORE_DATO_3112</property>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="position">54</property>
                    <property name="name">SCORE_COMM_3112</property>
                    <property name="nativeName">SCORE_COMM_3112</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">55</property>
                    <property name="name">SCORE_COMM_3006</property>
                    <property name="nativeName">SCORE_COMM_3006</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">56</property>
                    <property name="name">SCORE_RIF_3006</property>
                    <property name="nativeName">SCORE_RIF_3006</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">57</property>
                    <property name="name">SCORE_RIF_3112</property>
                    <property name="nativeName">SCORE_RIF_3112</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">58</property>
                    <property name="name">SCORE_DESC_3006</property>
                    <property name="nativeName">SCORE_DESC_3006</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">59</property>
                    <property name="name">SCORE_DESC_3112</property>
                    <property name="nativeName">SCORE_DESC_3112</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">60</property>
                    <property name="name">SCORE_EMOTICON_3006</property>
                    <property name="nativeName">SCORE_EMOTICON_3006</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">61</property>
                    <property name="name">SCORE_EMOTICON_3112</property>
                    <property name="nativeName">SCORE_EMOTICON_3112</property>
