                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="position">44</property>
                    <property name="name">BUDGET_COMM_3006</property>
                    <property name="nativeName">BUDGET_COMM_3006</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">45</property>
                    <property name="name">BUDGET_COMM_3112</property>
                    <property name="nativeName">BUDGET_COMM_3112</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">46</property>
