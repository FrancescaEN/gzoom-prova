	<subDataset name="RoleDS" uuid="61e4d813-3180-4b12-bd37-1b1bc0c4f318">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="gzoom_provbrescia_prod"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="workEffortId" class="java.lang.String" isForPrompting="false"/>
		<parameter name="retrieveWorkEffortId" class="java.lang.String">
			<defaultValueExpression><![CDATA[IF ($P{workEffortId} != null && $P{workEffortId}  != ""  && LEN($P{workEffortId}) != 0,
	" AND  FIL_W.ORG_UNIT_ID= '"+ $P{workEffortId} + "' "  ,
	" AND true"
	)]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT  
  RT.DESCRIPTION AS "DESCRIPTION", 
  P.PARTY_NAME AS "PARTY_NAME", 
  A.THRU_DATE AS "THRU_DATE", 
  A.FROM_DATE AS "FROM_DATE",
  WTIC.ETCH AS "ETCH",
  A.COMMENTS AS "COMMENTS"
FROM WORK_EFFORT_PARTY_ASSIGNMENT A 
INNER JOIN PARTY P ON P.PARTY_ID = A.PARTY_ID 
INNER JOIN WORK_EFFORT W ON W.WORK_EFFORT_ID = A.WORK_EFFORT_ID
INNER JOIN WORK_EFFORT_TYPE_CONTENT WTIC ON WTIC.WORK_EFFORT_TYPE_ID = W.WORK_EFFORT_TYPE_ID
	AND WTIC.WE_TYPE_CONTENT_TYPE_ID = 'FOLDER' 
	AND WTIC.CONTENT_ID = 'WEFLD_WROLE'
	AND WTIC.IS_VISIBLE = 'Y'	
INNER JOIN ROLE_TYPE RT ON RT.ROLE_TYPE_ID  = A.ROLE_TYPE_ID
  AND RT.PARENT_TYPE_ID = 'EMPLOYEE'	
WHERE A.WORK_EFFORT_ID =  $P{workEffortId} 
ORDER BY P.PARTY_NAME]]>
		</queryString>
		<field name="DESCRIPTION" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="DESCRIPTION"/>
			<property name="com.jaspersoft.studio.field.label" value="DESCRIPTION"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="role_type"/>
		</field>
		<field name="PARTY_NAME" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="PARTY_NAME"/>
			<property name="com.jaspersoft.studio.field.label" value="PARTY_NAME"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="party"/>
		</field>
		<field name="THRU_DATE" class="java.sql.Timestamp">
			<property name="com.jaspersoft.studio.field.name" value="THRU_DATE"/>
			<property name="com.jaspersoft.studio.field.label" value="THRU_DATE"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort_party_assignment"/>
		</field>
		<field name="FROM_DATE" class="java.sql.Timestamp">
			<property name="com.jaspersoft.studio.field.name" value="FROM_DATE"/>
			<property name="com.jaspersoft.studio.field.label" value="FROM_DATE"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort_party_assignment"/>
		</field>
		<field name="ETCH" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="ETCH"/>
			<property name="com.jaspersoft.studio.field.label" value="ETCH"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort_type_content"/>
		</field>
		<field name="COMMENTS" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="COMMENTS"/>
			<property name="com.jaspersoft.studio.field.label" value="COMMENTS"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort_party_assignment"/>
		</field>
		<group name="Group1">
			<groupExpression><![CDATA[$F{ETCH}]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="DestinationsDS" uuid="511eda98-7433-49e4-a112-b56810cc4ae1">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="gzoom_provbrescia_prod"/>
		<parameter name="workEffortId" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[$P{workEffortId} != null && $P{workEffortId}  != ""  && LEN($P{workEffortId}) != 0? " AND FIL_W.WORK_EFFORT_ID = '"+ $P{workEffortId} + "'" : " "]]></defaultValueExpression>
		</parameter>
		<queryString language="SQL">
			<![CDATA[SELECT  
  RT.DESCRIPTION AS "DESCRIPTION", 
  P.PARTY_NAME AS "PARTY_NAME", 
  A.THRU_DATE AS "THRU_DATE", 
  A.FROM_DATE AS "FROM_DATE",
  WTIC.ETCH AS "ETCH",
  A.COMMENTS AS "COMMENTS"
FROM WORK_EFFORT_PARTY_ASSIGNMENT A 
INNER JOIN PARTY P ON P.PARTY_ID = A.PARTY_ID 
INNER JOIN WORK_EFFORT W ON W.WORK_EFFORT_ID = A.WORK_EFFORT_ID
INNER JOIN WORK_EFFORT_TYPE_CONTENT WTIC ON WTIC.WORK_EFFORT_TYPE_ID = W.WORK_EFFORT_TYPE_ID
	AND WTIC.WE_TYPE_CONTENT_TYPE_ID = 'FOLDER' 
	AND WTIC.CONTENT_ID = 'WEFLD_DEST'
	AND WTIC.IS_VISIBLE = 'Y'	
INNER JOIN ROLE_TYPE RT ON RT.ROLE_TYPE_ID  = A.ROLE_TYPE_ID
  AND RT.PARENT_TYPE_ID LIKE 'GOAL%'	
WHERE A.WORK_EFFORT_ID =  $P{workEffortId} 
ORDER BY P.PARTY_NAME]]>
		</queryString>
		<field name="DESCRIPTION" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="DESCRIPTION"/>
			<property name="com.jaspersoft.studio.field.label" value="DESCRIPTION"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="role_type"/>
		</field>
		<field name="PARTY_NAME" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="PARTY_NAME"/>
			<property name="com.jaspersoft.studio.field.label" value="PARTY_NAME"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="party"/>
		</field>
		<field name="THRU_DATE" class="java.sql.Timestamp">
			<property name="com.jaspersoft.studio.field.name" value="THRU_DATE"/>
			<property name="com.jaspersoft.studio.field.label" value="THRU_DATE"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort_party_assignment"/>
		</field>
		<field name="FROM_DATE" class="java.sql.Timestamp">
			<property name="com.jaspersoft.studio.field.name" value="FROM_DATE"/>
			<property name="com.jaspersoft.studio.field.label" value="FROM_DATE"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort_party_assignment"/>
		</field>
		<field name="ETCH" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="ETCH"/>
			<property name="com.jaspersoft.studio.field.label" value="ETCH"/>
