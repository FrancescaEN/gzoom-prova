	<subDataset name="NoteDS" uuid="313d7738-878e-4409-9417-303827296405">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="gzoom_provbrescia_prod"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="workEffortId" class="java.lang.String" isForPrompting="false"/>
		<parameter name="retrieveWorkEffortId" class="java.lang.String">
			<defaultValueExpression><![CDATA[IF ($P{workEffortId} != null && $P{workEffortId}  != ""  && LEN($P{workEffortId}) != 0,
	" AND  FIL_W.ORG_UNIT_ID= '"+ $P{workEffortId} + "' "  ,
	" AND true"
	)]]></defaultValueExpression>
		</parameter>
		<parameter name="description" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT 
 ND.NOTE_ID AS "NOTE_ID", 
 ND.NOTE_NAME AS "NOTE_NAME",
 ND.NOTE_INFO AS "NOTE_INFO",
 N.SEQUENCE_ID AS "SEQUENCE_ID",
 ND.NOTE_DATE_TIME AS "NOTE_DATE_TIME",
 N.IS_HTML AS "IS_HTML",
 WT.CONTENT_ID AS "CONTENT_ID",
 WTIC.ETCH AS "ETCH",
 WTIC.SEQUENCE_NUM AS "SEQ_FOLDER"
 
FROM WORK_EFFORT W 
INNER JOIN WORK_EFFORT_NOTE N ON N.WORK_EFFORT_ID = W.WORK_EFFORT_ID
INNER JOIN NOTE_DATA ND ON ND.NOTE_ID = N.NOTE_ID
INNER JOIN WORK_EFFORT_TYPE_ATTR WT ON WT.ATTR_NAME = ND.NOTE_NAME
	AND WT.WORK_EFFORT_TYPE_ID = W.WORK_EFFORT_TYPE_ID
INNER JOIN WORK_EFFORT_TYPE_CONTENT WTIC ON WTIC.WORK_EFFORT_TYPE_ID = WT.WORK_EFFORT_TYPE_ID
	AND WTIC.WE_TYPE_CONTENT_TYPE_ID = 'FOLDER' 
	AND WTIC.CONTENT_ID = WT.CONTENT_ID
	AND WTIC.IS_VISIBLE = 'Y'
		
		
WHERE N.WORK_EFFORT_ID =  $P{workEffortId} 
    
ORDER BY 
	N.SEQUENCE_ID, 
	ND.NOTE_ID]]>
		</queryString>
		<field name="NOTE_ID" class="java.lang.String">
