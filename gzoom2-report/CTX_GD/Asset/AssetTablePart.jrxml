	<subDataset name="OrgUnitDS" uuid="d63033b3-b929-4953-9b6c-c075d73bf1dd">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="gzoom_provbrescia_prod"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="workEffortId" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[$P{workEffortId} != null && $P{workEffortId}  != ""  && LEN($P{workEffortId}) != 0? " AND FIL_W.WORK_EFFORT_ID = '"+ $P{workEffortId} + "'" : " "]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT  
  RT.DESCRIPTION AS "DESCRIPTION", 
  P.PARTY_NAME AS "PARTY_NAME", 
  A.THRU_DATE AS "THRU_DATE", 
  A.FROM_DATE AS "FROM_DATE",
  WTIC.ETCH AS "ETCH",
  A.COMMENTS AS "COMMENTS"
FROM WORK_EFFORT_PARTY_ASSIGNMENT A 
INNER JOIN PARTY P ON P.PARTY_ID = A.PARTY_ID 
INNER JOIN WORK_EFFORT W ON W.WORK_EFFORT_ID = A.WORK_EFFORT_ID
INNER JOIN WORK_EFFORT_TYPE_CONTENT WTIC ON WTIC.WORK_EFFORT_TYPE_ID = W.WORK_EFFORT_TYPE_ID
	AND WTIC.WE_TYPE_CONTENT_TYPE_ID = 'FOLDER' 
	AND WTIC.CONTENT_ID = 'WEFLD_ORGUNIT'
	AND WTIC.IS_VISIBLE = 'Y'	
INNER JOIN ROLE_TYPE RT ON RT.ROLE_TYPE_ID  = A.ROLE_TYPE_ID
  AND RT.PARENT_TYPE_ID = 'ORGANIZATION_UNIT'	
WHERE A.WORK_EFFORT_ID =  $P{workEffortId} 
ORDER BY P.PARTY_NAME]]>
		</queryString>
		<field name="DESCRIPTION" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="DESCRIPTION"/>
			<property name="com.jaspersoft.studio.field.label" value="DESCRIPTION"/>
