            <xml-property name="queryText"><![CDATA[select ind.work_effort_name as sos_indicatore
from work_effort_assoc indsos
inner join work_effort ind on ind.work_effort_id = indsos.work_effort_id_from 
where indsos.work_effort_id_to = ? -- main.work_effort_id
  and indsos.work_effort_assoc_type_id = '20C20PRO2'
order by indsos.sequence_num , ind.source_reference_id]]></xml-property>
