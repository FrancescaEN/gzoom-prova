            <xml-property name="queryText"><![CDATA[select
al.data_resource_name as sos_all_nome, co.description as sos_all_descrizione
from work_effort_content wc 
inner join content co on co.content_id = wc.content_id
inner join data_resource al on al.data_resource_id = co.data_resource_id
where wc.work_effort_id = ? -- main.work_effort_id
]]></xml-property>
