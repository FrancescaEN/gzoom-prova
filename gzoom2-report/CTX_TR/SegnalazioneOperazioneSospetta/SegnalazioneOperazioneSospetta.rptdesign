            <xml-property name="queryText"><![CDATA[select 
nd110.note_info AS "sos_pers_fis", nd120.note_info AS "sos_pers_giu", 
sos.work_effort_name AS "sos_descrizione", 
sost.work_effort_name AS "sos_tipologia",
sos.estimated_completion_date AS "sos_data", sos.source_reference_id AS "sos_codice",
ac0.account_name AS "sos_categ0_des", rs0.uom_code AS "sos_cat0_val", ac1.account_name AS "sos_categ1_des", rs1.uom_code AS "sos_cat1_val",
ac2.account_name AS "sos_categ2_des", rs2.uom_code AS "sos_cat2_val", ac3.account_name AS "sos_categ3_des", rs3.uom_code AS "sos_cat3_val",
rs4.uom_code AS "sos_origine", 
nd210.note_info AS "sos_motivazioni",
rs5.uom_code AS "sos_rischio",
uo.party_name AS "sos_struttura",
sos.work_effort_id
from work_effort sos
inner join party uo on uo.party_id = sos.org_unit_id
inner join work_effort_note wn110 on wn110.work_effort_id = sos.work_effort_id and wn110.sequence_id = '110'
inner join note_data nd110 on nd110.note_id = wn110.note_id
inner join work_effort_note wn120 on wn120.work_effort_id = sos.work_effort_id and wn120.sequence_id = '120'
inner join note_data nd120 on nd120.note_id = wn120.note_id
inner join work_effort_note wn210 on wn210.work_effort_id = sos.work_effort_id and wn210.sequence_id = '210'
inner join note_data nd210 on nd210.note_id = wn210.note_id
inner join work_effort_measure wm0 on wm0.work_effort_id = sos.work_effort_id 
inner join gl_account ac0 on ac0.gl_account_id = wm0.gl_account_id and ac0.account_code = 'SOSGEN.10'
left join acctg_trans_entry ae0 on ae0.voucher_ref = wm0.work_effort_measure_id
left join work_effort_meas_rat_sc rs0 on rs0.work_effort_measure_id = wm0.work_effort_measure_id and rs0.uom_rating_value = ae0.amount
and rs0.UOM_ID = ae0.CURRENCY_UOM_ID and ae0.amount is not null and wm0.work_effort_measure_id is not null
inner join work_effort_measure wm1 on wm1.work_effort_id = sos.work_effort_id 
inner join gl_account ac1 on ac1.gl_account_id = wm1.gl_account_id and ac1.account_code = 'SOSGEN.20'
left join acctg_trans_entry ae1 on ae1.voucher_ref = wm1.work_effort_measure_id
left join work_effort_meas_rat_sc rs1 on rs1.work_effort_measure_id = wm1.work_effort_measure_id and rs1.uom_rating_value = ae1.amount
and rs1.UOM_ID = ae1.CURRENCY_UOM_ID and ae1.amount is not null and wm1.work_effort_measure_id is not null
inner join work_effort_measure wm2 on wm2.work_effort_id = sos.work_effort_id 
inner join gl_account ac2 on ac2.gl_account_id = wm2.gl_account_id and ac2.account_code = 'SOSGEN.30'
left join acctg_trans_entry ae2 on ae2.voucher_ref = wm2.work_effort_measure_id
left join work_effort_meas_rat_sc rs2 on rs2.work_effort_measure_id = wm2.work_effort_measure_id and rs2.uom_rating_value = ae2.amount
and rs2.UOM_ID = ae2.CURRENCY_UOM_ID and ae2.amount is not null and wm2.work_effort_measure_id is not null
inner join work_effort_measure wm3 on wm3.work_effort_id = sos.work_effort_id 
inner join gl_account ac3 on ac3.gl_account_id = wm3.gl_account_id and ac3.account_code = 'SOSGEN.40'
left join acctg_trans_entry ae3 on ae3.voucher_ref = wm3.work_effort_measure_id
left join work_effort_meas_rat_sc rs3 on rs3.work_effort_measure_id = wm3.work_effort_measure_id and rs3.uom_rating_value = ae3.amount
and rs3.UOM_ID = ae3.CURRENCY_UOM_ID and ae3.amount is not null and wm3.work_effort_measure_id is not null
inner join work_effort_measure wm4 on wm4.work_effort_id = sos.work_effort_id 
inner join gl_account ac4 on ac4.gl_account_id = wm4.gl_account_id and ac4.account_code = 'SOSGEN.50'
left join acctg_trans_entry ae4 on ae4.voucher_ref = wm4.work_effort_measure_id
left join work_effort_meas_rat_sc rs4 on rs4.work_effort_measure_id = wm4.work_effort_measure_id and rs4.uom_rating_value = ae4.amount
and rs4.UOM_ID = ae4.CURRENCY_UOM_ID and ae4.amount is not null and wm4.work_effort_measure_id is not null
inner join work_effort_measure wm5 on wm5.work_effort_id = sos.work_effort_id 
inner join gl_account ac5 on ac5.gl_account_id = wm5.gl_account_id and ac5.account_code = 'SOSOPE.10'
left join acctg_trans_entry ae5 on ae5.voucher_ref = wm5.work_effort_measure_id
left join work_effort_meas_rat_sc rs5 on rs5.work_effort_measure_id = wm5.work_effort_measure_id and rs5.uom_rating_value = ae5.amount
and rs5.UOM_ID = ae5.CURRENCY_UOM_ID and ae5.amount is not null and wm5.work_effort_measure_id is not null
inner join work_effort_assoc wa on wa.work_effort_id_to = sos.work_effort_id and wa.work_effort_assoc_type_id = '20C20PROC'
inner join work_effort sost on sost.work_effort_id = wa.work_effort_id_from
inner join work_effort FIL_W on FIL_W.work_effort_id = wa.work_effort_id_to
@filterInnerJoin
@filterLeftJoin	
where 
sos.work_effort_type_id = '20G20SEG'

@workEffortId
@orgUnitId

@filterWhere
]]></xml-property>
