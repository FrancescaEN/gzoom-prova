	<queryString>
		<![CDATA[select * from exp_ope_obo eoo 
inner join work_effort FIL_W
on FIL_W.work_effort_id = eoo.work_effort_id_obo
/* START filterInnerJoin */
   $P!{filterInnerJoinString}
/* END filterInnerJoin */
/* START filterLeftJoin */
  $P!{filterLeftJoinString}
/* END filterLeftJoin */
  /* START filterWhere */
  where anno = TO_CHAR($P{monitoringDateString}::date, 'YYYY')
  and (eoo.work_effort_id_obo = $P{workEffortId} or $P{workEffortId} is null or $P{workEffortId} = '')
   $P!{orgUnitIdString} 
$P!{filterWhereString}
   /* END filterWhere */  
order by eoo.direzione]]>
	</queryString>
