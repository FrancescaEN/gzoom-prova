	<parameter name="direzione" class="java.lang.String" isForPrompting="false"/>
	<parameter name="date" class="java.lang.String" isForPrompting="false"/>
	<parameter name="codice" class="java.lang.String" isForPrompting="false"/>
	<parameter name="monitoringDateString" class="java.lang.String"/>
	<parameter name="orgUnitIdObo" class="java.lang.String"/>
	<parameter name="workEffortIdObo" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select * from exp_ope_obo eoo
where eoo.direzione= $P{direzione}
and eoo.anno= TO_CHAR($P{monitoringDateString}::date, 'YYYY')
and (eoo.work_effort_id_obo =  $P{workEffortIdObo}  or  $P{workEffortIdObo}  is null or  $P{workEffortIdObo}  = '')
 $P!{orgUnitIdObo}
order by etch]]>
	</queryString>
