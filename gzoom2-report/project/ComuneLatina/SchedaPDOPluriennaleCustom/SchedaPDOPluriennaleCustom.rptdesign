            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">DIPENDENTE</property>
                    <property name="nativeName">DIPENDENTE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">PROFILO</property>
                    <property name="nativeName">PROFILO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">CATEGORIA</property>
                    <property name="nativeName">CATEGORIA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">PER_PT</property>
                    <property name="nativeName">PER_PT</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">TOT_IMPIEGO</property>
                    <property name="nativeName">TOT_IMPIEGO</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">ANNI_PERSONA</property>
                    <property name="nativeName">ANNI_PERSONA</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">CENTRO_COST_IMPIEGO</property>
                    <property name="nativeName">CENTRO_COST_IMPIEGO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">COUNTER</property>
                    <property name="nativeName">COUNTER</property>
                    <property name="dataType">decimal</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT
PA.PARTY_NAME    AS   DIPENDENTE,
PA1.PARTY_NAME   AS   PROFILO , 
E.DESCRIPTION 	  AS   CATEGORIA, 
PE.employment_amount  AS  PER_PT,
SUM(X_ASS.ROLE_TYPE_WEIGHT) AS TOT_IMPIEGO,
SUM(PE.employment_amount * X_ASS.ROLE_TYPE_WEIGHT /100)/100 AS ANNI_PERSONA,
X_ASS.PARTY_NAME  AS   CENTRO_COST_IMPIEGO,
COUNT(*) AS COUNTER   
FROM  WORK_EFFORT W
JOIN  PARTY_RELATIONSHIP             P_R
ON  P_R.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_ALLOCATION'  
AND P_R.PARTY_ID_FROM      = W.ORG_UNIT_ID
AND P_R.ROLE_TYPE_ID_FROM  = W.ORG_UNIT_ROLE_TYPE_ID
AND ((? = 'Y' AND P_R.THRU_DATE IS NULL ) OR (? = 'N' AND (P_R.FROM_DATE  <= ? AND (P_R.THRU_DATE >= ? OR P_R.THRU_DATE IS NULL ))))
JOIN PARTY PA
ON P_R.PARTY_ID_TO = PA.PARTY_ID
JOIN        PERSON                      PE
ON          PA.PARTY_ID = PE.PARTY_ID
LEFT OUTER
JOIN        EMPL_POSITION_TYPE         E
ON          E.EMPL_POSITION_TYPE_ID = PE.EMPL_POSITION_TYPE_ID
LEFT OUTER  
JOIN        PARTY_RELATIONSHIP         PR
ON          PR.PARTY_ID_FROM              = PE.PARTY_ID
AND         PR.PARTY_RELATIONSHIP_TYPE_ID = 'QUALIF'
AND ((? = 'Y' AND PR.THRU_DATE IS NULL ) OR (? = 'N' AND (PR.FROM_DATE  <= ? AND (PR.THRU_DATE >= ? OR PR.THRU_DATE IS NULL ))))
LEFT OUTER JOIN PARTY    PA1
ON          PR.PARTY_ID_TO = PA1.PARTY_ID
LEFT OUTER JOIN 
    (SELECT P_ASS.PARTY_ID,U.PARTY_NAME,ROLE_TYPE_WEIGHT , P_ASS.FROM_DATE,P_ASS.THRU_DATE  
     FROM WORK_EFFORT_PARTY_ASSIGNMENT  P_ASS
     JOIN WORK_EFFORT W_ASS
     ON P_ASS.WORK_EFFORT_ID = W_ASS.WORK_EFFORT_ID
     JOIN PARTY U  
     ON U.PARTY_ID =  W_ASS.ORG_UNIT_ID 
     WHERE P_ASS.ROLE_TYPE_ID  = 'WE_ASSIGNMENT'
     )  X_ASS
ON   X_ASS.PARTY_ID = PE.PARTY_ID
AND  X_ASS.FROM_DATE <= W.ESTIMATED_COMPLETION_DATE
AND  X_ASS.THRU_DATE >= W.ESTIMATED_START_DATE  

WHERE W.WORK_EFFORT_ID = ?
GROUP BY PA.PARTY_NAME ,
PA1.PARTY_NAME   ,
E.DESCRIPTION ,
PE.employment_amount,
X_ASS.PARTY_NAME

]]></xml-property>
        </oda-data-set>
