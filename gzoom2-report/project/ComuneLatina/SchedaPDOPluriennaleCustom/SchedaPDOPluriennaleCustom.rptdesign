            <method name="beforeOpen"><![CDATA[this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value);
//this.queryText = this.queryText.replace("@monitoringDate", "'2018-12-31 00:00:00.000'");
]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">PARTY_NAME</property>
                    <property name="nativeName">PARTY_NAME</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">PARENT_ROLE_CODE</property>
                    <property name="nativeName">PARENT_ROLE_CODE</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">EMPLOYMENT_AMOUNT</property>
                    <property name="nativeName">EMPLOYMENT_AMOUNT</property>
                    <property name="dataType">decimal</property>
                    <property name="nativeDataType">3</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">CATEGORIA</property>
                    <property name="nativeName">CATEGORIA</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">ROLE_TYPE_WEIGHT</property>
                    <property name="nativeName">ROLE_TYPE_WEIGHT</property>
                    <property name="dataType">float</property>
                    <property name="nativeDataType">8</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">PROFILO</property>
                    <property name="nativeName">PROFILO</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">CDR_APPARTENENZA</property>
                    <property name="nativeName">CDR_APPARTENENZA</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">ANNI_PERSONA</property>
                    <property name="nativeName">ANNI_PERSONA</property>
                    <property name="dataType">float</property>
                    <property name="nativeDataType">8</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT DISTINCT
  PA.PARTY_NAME,
  PPR.PARENT_ROLE_CODE,
  PE.EMPLOYMENT_AMOUNT,
  EPT.DESCRIPTION AS CATEGORIA,
  WEPA.ROLE_TYPE_WEIGHT,
  PA1.PARTY_NAME AS PROFILO,
  P_UO.PARTY_NAME AS CDR_APPARTENENZA,
  CASE WHEN (PE.EMPLOYMENT_AMOUNT IS NOT NULL AND WEPA.ROLE_TYPE_WEIGHT IS NOT NULL)
	 THEN (PE.EMPLOYMENT_AMOUNT*WEPA.ROLE_TYPE_WEIGHT/100)/100 ELSE 0.0 END ANNI_PERSONA
FROM WORK_EFFORT_ASSOC WEA
INNER JOIN WORK_EFFORT WE ON WE.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_TO
INNER JOIN WORK_EFFORT_PARTY_ASSIGNMENT WEPA ON WEA.WORK_EFFORT_ID_TO = WEPA.WORK_EFFORT_ID
INNER JOIN PARTY PA ON PA.PARTY_ID = WEPA.PARTY_ID
LEFT OUTER JOIN PERSON PE ON PE.PARTY_ID = PA.PARTY_ID
LEFT OUTER JOIN PARTY_PARENT_ROLE PPR
ON PPR.PARTY_ID = PA.PARTY_ID AND PPR.ROLE_TYPE_ID = 'EMPLOYEE'
LEFT OUTER JOIN EMPL_POSITION_TYPE EPT ON PE.EMPL_POSITION_TYPE_ID = EPT.EMPL_POSITION_TYPE_ID 
LEFT OUTER JOIN PARTY_RELATIONSHIP PR ON PR.PARTY_ID_FROM = WEPA.PARTY_ID
	AND PR.PARTY_RELATIONSHIP_TYPE_ID = 'QUALIF' AND PR.THRU_DATE IS NULL
LEFT OUTER JOIN PARTY PA1 ON PR.PARTY_ID_TO = PA1.PARTY_ID
INNER JOIN PARTY_RELATIONSHIP PR_UO ON PR_UO.PARTY_ID_TO = WEPA.PARTY_ID
	AND PR_UO.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_EMPLOYMENT'
	AND (PR_UO.THRU_DATE is null or (PR_UO.FROM_DATE <= @monitoringDate and PR_UO.THRU_DATE>= @monitoringDate))
LEFT OUTER JOIN PARTY P_UO ON P_UO.PARTY_ID = PR_UO.PARTY_ID_FROM
WHERE WEA.WORK_EFFORT_ID_FROM = ?
AND WEPA.FROM_DATE <= @monitoringDate AND WEPA.THRU_DATE >= ?
AND WEA.FROM_DATE <= @monitoringDate AND WEA.THRU_DATE >= ?
ORDER BY PA.PARTY_NAME
]]></xml-property>
