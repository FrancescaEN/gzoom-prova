            <xml-property name="queryText"><![CDATA[SELECT WEN.WORK_EFFORT_ID, ND.NOTE_ID, ND.NOTE_INFO, ND.NOTE_NAME, WEN.SEQUENCE_ID, ND.NOTE_DATE_TIME
FROM WORK_EFFORT_NOTE WEN
LEFT OUTER JOIN NOTE_DATA ND ON ND.NOTE_ID = WEN.NOTE_ID 
WHERE WEN.WORK_EFFORT_ID = ?
 AND YEAR(ND.NOTE_DATE_TIME) = @year
 AND WEN.SEQUENCE_ID = 2
ORDER BY ND.NOTE_DATE_TIME DESC , WEN.SEQUENCE_ID
]]></xml-property>
