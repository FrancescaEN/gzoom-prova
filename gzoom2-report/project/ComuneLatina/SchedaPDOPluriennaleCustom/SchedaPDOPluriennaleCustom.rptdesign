            <xml-property name="queryText"><![CDATA[SELECT M_WORK_EFFORT_MEASURE_ID, M_KPI_SCORE_WEIGHT, GT.DESCRIPTION, G_ACCOUNT_NAME,G_DESCRIPTION, G_UOM_ABBREVIATION, G_DETAIL_ENUM_ID, G_INPUT_ENUM_ID, WP.UOM_DESCR, WP.COMMENTS, 
M_UOM_DESCR, M_COMMENTS, V.M_SEQUENCE_ID,
  M_PARTY_NAME AS DESCRIZIONE_CENTRO_COSTO,  M_PARENT_ROLE_CODE AS CODICE_CENTRO_COSTO,
  V.M_WE_MEASURE_TYPE_ENUM_ID,
  V.G_ACCOUNT_CODE,
  V.G_GL_ACCOUNT_ID ,
  V.G_UOM_TYPE_ID,
  V.W_WORK_EFFORT_TYPE_ID,
  G_UOM_DECIMAL_SCALE,
  WTIC.CONTENT_ID AS CONTENT_FOLDER_IND,
  WTIC.ETCH AS ETCH_FOLDER_IND,
  COUNT(*) COUNTER,
  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN TT_DESCRIPTION ELSE NULL END)  ACTUAL_ACC_TRN_ABB_3009,  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN TT_DESCRIPTION ELSE NULL END)  ACTUAL_ACC_TRN_ABB_3112,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN TM_DESCRIPTION ELSE NULL END)  ACTUAL_ACC_TRN_ENTRY_ABB_3009,  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN TM_DESCRIPTION ELSE NULL END)  ACTUAL_ACC_TRN_ENTRY_ABB_3112,

MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN TT_DESCRIPTION ELSE NULL END)  BUDGET_ACC_TRN_ABB_3009,  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN TT_DESCRIPTION ELSE NULL END)  BUDGET_ACC_TRN_ABB_3112,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN TM_DESCRIPTION ELSE NULL END)  BUDGET_ACC_TRN_ENTRY_ABB_3009,  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN TM_DESCRIPTION ELSE NULL END)  BUDGET_ACC_TRN_ENTRY_ABB_3112,

SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN TM_AMOUNT ELSE NULL END)  ACTUAL_DATO_3112_MENO_TRE,  
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN TM_AMOUNT ELSE NULL END)  ACTUAL_DATO_3112_MENO_DUE,  
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN TM_AMOUNT ELSE NULL END)  ACTUAL_DATO_3112_MENO_UNO,  
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN TM_AMOUNT ELSE NULL END)  ACTUAL_DATO_3009,  
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN TM_AMOUNT ELSE NULL END)  ACTUAL_DATO_3112,

MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN R_UOM_CODE ELSE NULL END)  ACTUAL_COD_3112_MENO_TRE,  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN R_UOM_CODE ELSE NULL END)  ACTUAL_COD_3112_MENO_DUE,  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN R_UOM_CODE ELSE NULL END)  ACTUAL_COD_3112_MENO_UNO,  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN R_UOM_CODE ELSE NULL END)  ACTUAL_COD_3009,  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN R_UOM_CODE ELSE NULL END)  ACTUAL_COD_3112,

MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN R_UOM_CODE ELSE NULL END) BUDGET_COD_3112_MENO_TRE,  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN R_UOM_CODE ELSE NULL END) BUDGET_COD_3112_MENO_DUE,  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN R_UOM_CODE ELSE NULL END) BUDGET_COD_3112_MENO_UNO,  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN R_UOM_CODE ELSE NULL END) BUDGET_COD_3009,  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN R_UOM_CODE ELSE NULL END) BUDGET_COD_3112,

SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN TM_AMOUNT ELSE NULL END)  BUDGET_DATO_3112_MENO_TRE,  
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN TM_AMOUNT ELSE NULL END)  BUDGET_DATO_3112_MENO_DUE,  
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN TM_AMOUNT ELSE NULL END)  BUDGET_DATO_3112_MENO_UNO,  
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN TM_AMOUNT ELSE NULL END)  BUDGET_DATO_3009,  
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN TM_AMOUNT ELSE NULL END)  BUDGET_DATO_3112,

MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN R_UOM_CODE ELSE NULL END) BUDGET_COD_3112_PIU_DUE,  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN R_UOM_CODE ELSE NULL END) BUDGET_COD_3112_PIU_UNO,  
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN TM_AMOUNT ELSE NULL END)  BUDGET_DATO_3112_PIU_DUE,  
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN TM_AMOUNT ELSE NULL END)  BUDGET_DATO_3112_PIU_UNO,

MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN TT_DESCRIPTION ELSE NULL END)  ACTUAL_ACC_TRN_ABB_PIU_UNO,  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN TT_DESCRIPTION ELSE NULL END)  ACTUAL_ACC_TRN_ABB_PIU_DUE,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN TT_DESCRIPTION ELSE NULL END)  BUDGET_ACC_TRN_ABB_PIU_UNO,  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = ?  THEN TT_DESCRIPTION ELSE NULL END)  BUDGET_ACC_TRN_ABB_PIU_DUE,

MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112PIU1  THEN TM_DESCRIPTION ELSE NULL END)  ACTUAL_ACC_TRN_ENTRY_ABB_PIU_UNO,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112PIU2  THEN TM_DESCRIPTION ELSE NULL END)  ACTUAL_ACC_TRN_ENTRY_ABB_PIU_DUE,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112PIU1  THEN TM_DESCRIPTION ELSE NULL END)  BUDGET_ACC_TRN_ENTRY_ABB_PIU_UNO,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112PIU2  THEN TM_DESCRIPTION ELSE NULL END)  BUDGET_ACC_TRN_ENTRY_ABB_PIU_DUE,
 
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3009  THEN TT_DESCRIPTION ELSE NULL END)  ACTUAL_ACC_TRN_ABB_3110, 
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3009  THEN TM_DESCRIPTION ELSE NULL END)  ACTUAL_ACC_TRN_ENTRY_ABB_3110,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3009  THEN TT_DESCRIPTION ELSE NULL END)  BUDGET_ACC_TRN_ABB_3110,  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3009  THEN TM_DESCRIPTION ELSE NULL END)  BUDGET_ACC_TRN_ENTRY_ABB_3110,
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3009  THEN TM_AMOUNT ELSE NULL END)  ACTUAL_DATO_3110,
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3009  THEN TM_AMOUNT ELSE NULL END)  BUDGET_DATO_3110,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3009  THEN R_UOM_CODE ELSE NULL END)  ACTUAL_COD_3110,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3009  THEN R_UOM_CODE ELSE NULL END)  BUDGET_COD_3110

FROM WORK_EFFORT_TRANS_INDIC_VIEW V
INNER JOIN ENUMERATION E ON V.M_WE_MEASURE_TYPE_ENUM_ID = E.ENUM_ID        
INNER JOIN WORK_EFFORT_TYPE WT ON WT.WORK_EFFORT_TYPE_ID = V.W_WORK_EFFORT_TYPE_ID
INNER JOIN WORK_EFFORT_TYPE_CONTENT WTIC ON WTIC.WORK_EFFORT_TYPE_ID = WT.WORK_EFFORT_TYPE_ID
INNER JOIN  WORK_EFFORT_PURPOSE_ACCOUNT WA ON WA.GL_ACCOUNT_ID = V.G_GL_ACCOUNT_ID
	AND WA.WORK_EFFORT_PURPOSE_TYPE_ID =  WTIC.WORK_EFFORT_PURPOSE_TYPE_ID
INNER JOIN GL_ACCOUNT_TYPE GT ON GT.GL_ACCOUNT_TYPE_ID = V.G_GL_ACCOUNT_TYPE_ID
   

LEFT OUTER JOIN 
	( SELECT WM.GL_ACCOUNT_ID, PR.INTERNAL_NAME, PR.PRODUCT_ID, WM.UOM_DESCR, WM.COMMENTS
	FROM WORK_EFFORT_MEASURE WM
	INNER JOIN PRODUCT PR ON PR.PRODUCT_ID = WM.PRODUCT_ID
	WHERE WM.WORK_EFFORT_ID IS NULL) WP
	ON WP.GL_ACCOUNT_ID = M_GL_ACCOUNT_ID AND WP.PRODUCT_ID = M_PRODUCT_ID
	
WHERE V.M_WORK_EFFORT_ID = ? 
	  AND V.M_THRU_DATE >= ?
	  AND V.M_FROM_DATE <= ?
	  AND (TM_GL_ACCOUNT_ID <> 'SCORE' OR TM_GL_ACCOUNT_ID IS NULL )
	  @workEffortRevisionId 
	  AND ( ? = 'N' OR ( ? = 'Y' AND V.M_WE_MEASURE_TYPE_ENUM_ID = 'WEMT_PERF'))
	  AND V.M_SEQUENCE_ID <> '999' -- ESCLUDO TUTTE LE MISURE CON QUESTO SEQUENCE
	  
GROUP BY  GT.DESCRIPTION, M_KPI_SCORE_WEIGHT, G_ACCOUNT_NAME, G_DESCRIPTION, G_UOM_ABBREVIATION, V.M_WE_MEASURE_TYPE_ENUM_ID,V.G_ACCOUNT_CODE, V.G_GL_ACCOUNT_ID ,
M_WORK_EFFORT_MEASURE_ID,G_DETAIL_ENUM_ID,G_INPUT_ENUM_ID, WP.UOM_DESCR, WP.COMMENTS, M_UOM_DESCR, M_COMMENTS, V.M_SEQUENCE_ID,
M_PARTY_NAME,  M_PARENT_ROLE_CODE, V.G_ACCOUNT_CODE, V.W_WORK_EFFORT_TYPE_ID, V.G_GL_ACCOUNT_ID , V.G_UOM_TYPE_ID, G_UOM_DECIMAL_SCALE,
WTIC.CONTENT_ID, WTIC.ETCH

ORDER BY    
 V.M_WE_MEASURE_TYPE_ENUM_ID,
  V.G_ACCOUNT_CODE,
  V.G_GL_ACCOUNT_ID ,
  V.M_WORK_EFFORT_MEASURE_ID]]></xml-property>
