            <method name="beforeOpen"><![CDATA[var notOb2WorkEffortId = '';
if (params["workEffortId"].value != null &amp;&amp; params["workEffortId"].value != '') {
    notOb2WorkEffortId = " AND OB2.WORK_EFFORT_ID <> '" + params["workEffortId"].value +"'";
}
this.queryText = this.queryText.replace("@notOb2WorkEffortId", notOb2WorkEffortId);

var workEffortRevisionId = '';
if (params["workEffortRevisionId"].value != null &amp;&amp; params["workEffortRevisionId"].value != '') {
    workEffortRevisionId = "AND (RAD.WORK_EFFORT_REVISION_ID = '" +params["workEffortRevisionId"].value + "'";
    workEffortRevisionId += " OR OB1.WORK_EFFORT_REVISION_ID = '" +params["workEffortRevisionId"].value + "'";
    workEffortRevisionId += " OR OB2.WORK_EFFORT_REVISION_ID = '" +params["workEffortRevisionId"].value + "'";
    workEffortRevisionId += " OR OB3.WORK_EFFORT_REVISION_ID = '" +params["workEffortRevisionId"].value + "')";
} else {
    workEffortRevisionId = "AND RAD.WORK_EFFORT_REVISION_ID IS NULL AND OB1.WORK_EFFORT_REVISION_ID IS NULL AND OB2.WORK_EFFORT_REVISION_ID IS NULL AND OB3.WORK_EFFORT_REVISION_ID IS NULL";
}
this.queryText = this.queryText.replace("@workEffortRevisionId", workEffortRevisionId);


//GESTIRE PERMESSI
/**/
filter = new com.mapsengineering.base.birt.util.UtilFilter(params["userLoginId"].value, params["localDispatcherName"].value);
var filterInnerJoin = filter.getWorkEffortFilterInner();
var filterLeftJoin = filter.getWorkEffortFilterLeftJoin();
var filterWhere = filter.getWorkEffortFilterWhere();

/*
var filterInnerJoin = "";
var filterLeftJoin = "";
var filterWhere = "";
*/
this.queryText = this.queryText.replace("@filterInnerJoin",  filterInnerJoin );
this.queryText = this.queryText.replace("@filterLeftJoin",  filterLeftJoin );
this.queryText = this.queryText.replace("@filterWhere",  filterWhere );]]></method>
