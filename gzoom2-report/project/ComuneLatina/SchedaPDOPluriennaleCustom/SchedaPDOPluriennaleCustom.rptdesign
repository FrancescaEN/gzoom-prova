       WAL6.WE_FROM_TYPE_ETCH AS FROM_TYPE_ETCH2, WAL6.WE_FROM_ETCH AS FROM_ETCH2, WAL6.WE_FROM_NAME AS FROM_NAME2,
       WAL5.WE_FROM_TYPE_ETCH AS FROM_TYPE_ETCH3, WAL5.WE_FROM_ETCH AS FROM_ETCH3, WAL5.WE_FROM_NAME AS FROM_NAME3,
       WAL4.WE_FROM_TYPE_ETCH AS FROM_TYPE_ETCH4, WAL4.WE_FROM_ETCH AS FROM_ETCH4, WAL4.WE_FROM_NAME AS FROM_NAME4,
       WAL3.WE_FROM_TYPE_ETCH AS FROM_TYPE_ETCH5, WAL3.WE_FROM_ETCH AS FROM_ETCH5, WAL3.WE_FROM_NAME AS FROM_NAME5,
       WAL2.WE_FROM_TYPE_ETCH AS FROM_TYPE_ETCH6, WAL2.WE_FROM_ETCH AS FROM_ETCH6, WAL2.WE_FROM_NAME AS FROM_NAME6,
       WAL1.WE_FROM_TYPE_ETCH AS FROM_TYPE_ETCH7, WAL1.WE_FROM_ETCH AS FROM_ETCH7, WAL1.WE_FROM_NAME AS FROM_NAME7
       
FROM WORK_EFFORT WE
  INNER JOIN WORK_EFFORT_TYPE WT ON WT.WORK_EFFORT_TYPE_ID = WE.WORK_EFFORT_TYPE_ID
  LEFT JOIN WORK_EFFORT_TYPE_TYPE WTL1 ON WTL1.WORK_EFFORT_TYPE_ID_ROOT = WT.WORK_EFFORT_TYPE_HIERARCHY_ID AND WTL1.WORK_EFFORT_TYPE_ID_TO = WE.WORK_EFFORT_TYPE_ID
  LEFT JOIN WORK_EFFORT_ASSOC_VIEW WAL1 ON WAL1.WE_TO_ID = WE.WORK_EFFORT_ID AND WAL1.WE_FROM_TYPE_ID = WTL1.WORK_EFFORT_TYPE_ID_FROM  
  LEFT JOIN WORK_EFFORT_TYPE_TYPE WTL2 ON WTL2.WORK_EFFORT_TYPE_ID_ROOT = WT.WORK_EFFORT_TYPE_HIERARCHY_ID AND WTL2.WORK_EFFORT_TYPE_ID_TO = WAL1.WE_FROM_TYPE_ID
  LEFT JOIN WORK_EFFORT_ASSOC_VIEW WAL2 ON WAL2.WE_TO_ID = WAL1.WE_FROM_ID AND WAL2.WE_FROM_TYPE_ID = WTL2.WORK_EFFORT_TYPE_ID_FROM 
  LEFT JOIN WORK_EFFORT_TYPE_TYPE WTL3 ON WTL3.WORK_EFFORT_TYPE_ID_ROOT = WT.WORK_EFFORT_TYPE_HIERARCHY_ID AND WTL3.WORK_EFFORT_TYPE_ID_TO = WAL2.WE_FROM_TYPE_ID
  LEFT JOIN WORK_EFFORT_ASSOC_VIEW WAL3 ON WAL3.WE_TO_ID = WAL2.WE_FROM_ID AND WAL3.WE_FROM_TYPE_ID = WTL3.WORK_EFFORT_TYPE_ID_FROM 
  LEFT JOIN WORK_EFFORT_TYPE_TYPE WTL4 ON WTL4.WORK_EFFORT_TYPE_ID_ROOT = WT.WORK_EFFORT_TYPE_HIERARCHY_ID AND WTL4.WORK_EFFORT_TYPE_ID_TO = WAL3.WE_FROM_TYPE_ID
  LEFT JOIN WORK_EFFORT_ASSOC_VIEW WAL4 ON WAL4.WE_TO_ID = WAL3.WE_FROM_ID AND WAL4.WE_FROM_TYPE_ID = WTL4.WORK_EFFORT_TYPE_ID_FROM 
  LEFT JOIN WORK_EFFORT_TYPE_TYPE WTL5 ON WTL5.WORK_EFFORT_TYPE_ID_ROOT = WT.WORK_EFFORT_TYPE_HIERARCHY_ID AND WTL5.WORK_EFFORT_TYPE_ID_TO = WAL4.WE_FROM_TYPE_ID
  LEFT JOIN WORK_EFFORT_ASSOC_VIEW WAL5 ON WAL5.WE_TO_ID = WAL4.WE_FROM_ID AND WAL5.WE_FROM_TYPE_ID = WTL5.WORK_EFFORT_TYPE_ID_FROM 
  LEFT JOIN WORK_EFFORT_TYPE_TYPE WTL6 ON WTL6.WORK_EFFORT_TYPE_ID_ROOT = WT.WORK_EFFORT_TYPE_HIERARCHY_ID AND WTL6.WORK_EFFORT_TYPE_ID_TO = WAL5.WE_FROM_TYPE_ID
  LEFT JOIN WORK_EFFORT_ASSOC_VIEW WAL6 ON WAL6.WE_TO_ID = WAL5.WE_FROM_ID AND WAL6.WE_FROM_TYPE_ID = WTL6.WORK_EFFORT_TYPE_ID_FROM 
  LEFT JOIN WORK_EFFORT_TYPE_TYPE WTL7 ON WTL7.WORK_EFFORT_TYPE_ID_ROOT = WT.WORK_EFFORT_TYPE_HIERARCHY_ID AND WTL7.WORK_EFFORT_TYPE_ID_TO = WAL6.WE_FROM_TYPE_ID
  LEFT JOIN WORK_EFFORT_ASSOC_VIEW WAL7 ON WAL7.WE_TO_ID = WAL6.WE_FROM_ID AND WAL7.WE_FROM_TYPE_ID = WTL7.WORK_EFFORT_TYPE_ID_FROM 
WHERE WE.WORK_EFFORT_ID = ?]]></xml-property>
        </oda-data-set>
