            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">PARTY_NAME</property>
                    <property name="nativeName">PARTY_NAME</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">WORK_EFFORT_NAME</property>
                    <property name="nativeName">WORK_EFFORT_NAME</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">RICHIESTA</property>
                    <property name="nativeName">RICHIESTA</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">STATO_RICHIESTA</property>
                    <property name="nativeName">STATO_RICHIESTA</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">RISPOSTA</property>
                    <property name="nativeName">RISPOSTA</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">COUNTER</property>
                    <property name="nativeName">COUNTER</property>
                    <property name="dataType">decimal</property>
                    <property name="nativeDataType">4</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT  
	P_CDC.PARTY_NAME AS PARTY_NAME, 
	ATT.WORK_EFFORT_NAME AS WORK_EFFORT_NAME, 
	A_CDC.COMMENTS AS RICHIESTA , 
	E.DESCRIPTION AS STATO_RICHIESTA, 
	A_CDC.NOTE AS RISPOSTA, 
	COUNT(*) AS COUNTER
FROM WORK_EFFORT W
INNER JOIN WORK_EFFORT_ASSOC A ON A.WORK_EFFORT_ID_FROM = W.WORK_EFFORT_ID
INNER JOIN WORK_EFFORT ATT ON  ATT.WORK_EFFORT_ID = A.WORK_EFFORT_ID_TO
INNER JOIN WORK_EFFORT_ASSOC_TYPE   ATT_AT ON ATT_AT.WORK_EFFORT_ASSOC_TYPE_ID = A.WORK_EFFORT_ASSOC_TYPE_ID
	AND ATT_AT.PARENT_TYPE_ID = 'HIE' 
	AND W.WORK_EFFORT_PARENT_ID = ATT.WORK_EFFORT_PARENT_ID
	AND (A.THRU_DATE = W.ESTIMATED_COMPLETION_DATE OR A.THRU_DATE = ATT.ESTIMATED_COMPLETION_DATE)
INNER JOIN WORK_EFFORT_ASSOC A_CDC ON A_CDC.WORK_EFFORT_ID_FROM = ATT.WORK_EFFORT_ID
INNER JOIN WORK_EFFORT W_CDC ON W_CDC.WORK_EFFORT_ID = A_CDC.WORK_EFFORT_ID_TO 
	AND (A_CDC.THRU_DATE = W_CDC.ESTIMATED_COMPLETION_DATE OR A_CDC.THRU_DATE = ATT.ESTIMATED_COMPLETION_DATE)
INNER JOIN WORK_EFFORT_ASSOC_TYPE   W_CDC_AT ON W_CDC_AT.WORK_EFFORT_ASSOC_TYPE_ID = A_CDC.WORK_EFFORT_ASSOC_TYPE_ID
	AND W_CDC_AT.has_response = 'Y'
INNER JOIN PARTY P_CDC ON  W_CDC.ORG_UNIT_ID = P_CDC.PARTY_ID   
LEFT OUTER JOIN ENUMERATION E ON E.ENUM_ID = A_CDC.RESPONSE_ENUM_ID  

WHERE A.WORK_EFFORT_ID_FROM = ?
GROUP BY 
	P_CDC.PARTY_NAME, 
	ATT.WORK_EFFORT_NAME, 
	A_CDC.COMMENTS, 
	E.DESCRIPTION, 
	A_CDC.NOTE
	
ORDER BY  PARTY_NAME]]></xml-property>
        </oda-data-set>
