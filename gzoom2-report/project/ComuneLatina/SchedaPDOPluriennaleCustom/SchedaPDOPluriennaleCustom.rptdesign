            <xml-property name="queryText"><![CDATA[SELECT P_CDC.PARTY_NAME AS PARTY_NAME, OBB.WORK_EFFORT_NAME AS OB3_WORK_EFFORT_NAME, ATT.WORK_EFFORT_NAME AS WORK_EFFORT_NAME, 
COUNT(*) COUNTER, A.SEQUENCE_NUM, ATT.SOURCE_REFERENCE_ID, ATT.WORK_EFFORT_ID 
FROM    WORK_EFFORT W
JOIN    WORK_EFFORT_ASSOC  A
ON      A.WORK_EFFORT_ID_FROM = W.WORK_EFFORT_ID
JOIN     WORK_EFFORT ATT
ON       ATT.WORK_EFFORT_ID = A.WORK_EFFORT_ID_TO
JOIN     WORK_EFFORT_ASSOC_TYPE   ATT_AT
ON       ATT_AT.WORK_EFFORT_ASSOC_TYPE_ID = A.WORK_EFFORT_ASSOC_TYPE_ID
AND     (ATT_AT.PARENT_TYPE_ID = 'HIE' AND W.WORK_EFFORT_PARENT_ID = ATT.WORK_EFFORT_PARENT_ID)
AND      (A.THRU_DATE = W.ESTIMATED_COMPLETION_DATE OR A.THRU_DATE = ATT.ESTIMATED_COMPLETION_DATE)
JOIN    WORK_EFFORT_ASSOC  A_OBB
ON      A_OBB.WORK_EFFORT_ID_FROM = ATT.WORK_EFFORT_ID
JOIN     WORK_EFFORT OBB
ON       OBB.WORK_EFFORT_ID = A_OBB.WORK_EFFORT_ID_TO
JOIN     WORK_EFFORT_ASSOC_TYPE   OBB_AT
ON       OBB_AT.WORK_EFFORT_ASSOC_TYPE_ID = A_OBB.WORK_EFFORT_ASSOC_TYPE_ID
AND      (OBB_AT.PARENT_TYPE_ID = 'ASS' )
AND      (A_OBB.THRU_DATE = OBB.ESTIMATED_COMPLETION_DATE OR A_OBB.THRU_DATE = ATT.ESTIMATED_COMPLETION_DATE)
JOIN      PARTY   P_CDC
ON        OBB.ORG_UNIT_ID = P_CDC.PARTY_ID   
WHERE     A.WORK_EFFORT_ID_FROM = ?

GROUP BY P_CDC.PARTY_NAME, OBB.WORK_EFFORT_NAME, ATT.WORK_EFFORT_NAME, A.SEQUENCE_NUM, ATT.SOURCE_REFERENCE_ID, ATT.WORK_EFFORT_ID  
ORDER BY  P_CDC.PARTY_NAME, A.SEQUENCE_NUM,   ATT.SOURCE_REFERENCE_ID ,  ATT.WORK_EFFORT_ID ]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="ObiettiviCollegatiRichiestiDS" id="31134">
