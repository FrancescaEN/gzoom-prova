            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT  
	P_UO.PARTY_NAME AS CENTRO_DI_COSTO, 
	W.WORK_EFFORT_NAME AS OBIETTIVO,  
	ATT.WORK_EFFORT_NAME AS ATTIVITA,
	ATT.WORK_EFFORT_ID AS ID_ATTIVITA,
	A_CDC.COMMENTS AS RICHIESTA , 
	E.DESCRIPTION AS STATO_RICHIESTA, 
	A_CDC.NOTE AS RISPOSTA,
	COUNT(*) AS COUNTER

FROM WORK_EFFORT W
INNER JOIN PARTY P_UO ON P_UO.PARTY_ID = W.ORG_UNIT_ID
INNER JOIN WORK_EFFORT_ASSOC  A ON A.WORK_EFFORT_ID_FROM = W.WORK_EFFORT_ID
INNER JOIN WORK_EFFORT ATT ON ATT.WORK_EFFORT_ID = A.WORK_EFFORT_ID_TO
INNER JOIN WORK_EFFORT_ASSOC_TYPE ATT_AT ON ATT_AT.WORK_EFFORT_ASSOC_TYPE_ID = A.WORK_EFFORT_ASSOC_TYPE_ID
	AND (ATT_AT.PARENT_TYPE_ID = 'HIE' AND W.WORK_EFFORT_PARENT_ID = ATT.WORK_EFFORT_PARENT_ID)
	AND (A.THRU_DATE = W.ESTIMATED_COMPLETION_DATE OR A.THRU_DATE = ATT.ESTIMATED_COMPLETION_DATE)
INNER JOIN WORK_EFFORT_ASSOC A_CDC ON A_CDC.WORK_EFFORT_ID_FROM = ATT.WORK_EFFORT_ID
INNER JOIN WORK_EFFORT W_CDC ON W_CDC.WORK_EFFORT_ID = A_CDC.WORK_EFFORT_ID_TO 
	AND (A_CDC.THRU_DATE = W_CDC.ESTIMATED_COMPLETION_DATE OR A_CDC.THRU_DATE = ATT.ESTIMATED_COMPLETION_DATE)
INNER JOIN WORK_EFFORT_ASSOC_TYPE W_CDC_AT ON W_CDC_AT.WORK_EFFORT_ASSOC_TYPE_ID = A_CDC.WORK_EFFORT_ASSOC_TYPE_ID
	AND W_CDC_AT.has_response = 'Y'
LEFT OUTER JOIN ENUMERATION E ON E.ENUM_ID = A_CDC.RESPONSE_ENUM_ID  

WHERE W_CDC.WORK_EFFORT_ID  = ?
	AND ATT.ESTIMATED_COMPLETION_DATE >= ? AND ATT.ESTIMATED_START_DATE <= ?

GROUP BY P_UO.PARTY_NAME, W.WORK_EFFORT_NAME,  ATT.WORK_EFFORT_NAME, ATT.WORK_EFFORT_ID, 
A_CDC.COMMENTS, E.DESCRIPTION, A_CDC.NOTE]]></xml-property>
