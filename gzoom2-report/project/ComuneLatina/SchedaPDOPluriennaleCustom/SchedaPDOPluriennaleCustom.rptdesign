            <xml-property name="queryText"><![CDATA[ SELECT 
 	RADTC.ETCH AS RAD_TITOLO,
 	A_OB1.SEQUENCE_NUM AS A_OB1_SEQUENCE_NUM,
 	OB1.WORK_EFFORT_ID AS AREA_ID,
 	OB1.ETCH AS  AREA1,
 	OB1.WORK_EFFORT_NAME  AS  AREA,
 	OB1.WEIGHT_SONS AS OB1_WEIGHT_SONS,
 	A_OB2.SEQUENCE_NUM		AS A_OB2_SEQUENCE_NUM, 
 	OB2.ETCH AS  CENTRO_DI_RESPONSABILITA1,
 	OB2.WORK_EFFORT_NAME  AS  CENTRO_DI_RESPONSABILITA,
  	OB2.WEIGHT_SONS AS OB2_WEIGHT_SONS,
	RAD.WORK_EFFORT_NAME	AS  TITOLO_RADICE ,
	P_E.PARTY_NAME			AS  NOME_ENTE,
  	P_RES_A.PARTY_NAME      AS    RESPONSABILE_AREA,  
  	P_RES_C.PARTY_NAME      AS    RESPONSABILE_CENT,  
	OB3.DESCRIPTION AS DESCRIZIONE_OBIETTIVO,
	T_OB3.DESCRIPTION 		AS TIPO,
	T_OB3.ETCH 		AS ETCH,
	OB3.ETCH AS ATTIVITA_OBIETTIVO1,
 	OB3.WORK_EFFORT_NAME AS ATTIVITA_OBIETTIVO,
  	P_R_UO.PARTY_NAME  		AS RESP_TEC_IN_CASO_MANC_DET,
  	OB1.SOURCE_REFERENCE_ID AS OB1_SOURCE_REFERENCE_ID,
 	OB1.WORK_EFFORT_ID 		AS OB1_WORK_EFFORT_ID,
 	
 	OB2.SOURCE_REFERENCE_ID AS OB2_SOURCE_REFERENCE_ID,
 	OB2.WORK_EFFORT_ID 		AS OB2_WORK_EFFORT_ID,
 	A_OB3.SEQUENCE_NUM		AS A_OB3_SEQUENCE_NUM , 
 	OB3.SOURCE_REFERENCE_ID AS OB3_OURCE_REFERENCE_ID,	
 	OB3.WORK_EFFORT_ID 		AS OB3_WORK_EFFORT_ID,
 	OB3.WORK_EFFORT_TYPE_ID	AS OB3_WORK_EFFORT_TYPE_ID,
 	
 	V_COL.OB6_ETCH  AS PROGETTO1,
 	V_COL.OB6_WORK_EFFORT_NAME AS PROGETTO,
 	V_COL.OB5_ETCH AS SOTTO_PR_STRATEGICO1,
    V_COL.OB5_WORK_EFFORT_NAME AS SOTTO_PR_STRATEGICO,
    V_COL.OB4_ETCH AS PROGETTO_STRATEGICO1, 
    V_COL.OB4_WORK_EFFORT_NAME AS PROGETTO_STRATEGICO,
 
	OB3.ESTIMATED_START_DATE 	AS  ESTIMATED_START_DATE,
	OB3.ESTIMATED_COMPLETION_DATE	AS  ESTIMATED_COMPLETION_DATE,
	OB4_WORK_EFFORT_ID,
	OB5_WORK_EFFORT_ID,
	OB6_WORK_EFFORT_ID,
	OB2.ORG_UNIT_ID AS OB2_ORG_UNIT_ID,
	T_OB3.CODE_PREFIX,
	T_OB1.ETCH AS TIPO_OB1,
	T_OB2.ETCH AS TIPO_OB2,
	
	-- PUNTEGGIO 
	MAX(CASE WHEN I3.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN I3.AMOUNT ELSE NULL END) PUNTEGGIO_OB3
		
 	
FROM WORK_EFFORT_TYPE     T_RAD
JOIN WORK_EFFORT          RAD
ON   T_RAD.WORK_EFFORT_TYPE_ID = RAD.WORK_EFFORT_TYPE_ID 
AND  T_RAD.IS_ROOT             = 'Y'    
AND (? = 'Y' OR (? = 'N' AND( RAD.ESTIMATED_START_DATE      <= ? AND RAD.ESTIMATED_COMPLETION_DATE >= ? ))) 
INNER JOIN WORK_EFFORT_TYPE_CONTENT RADTC ON RADTC.WORK_EFFORT_TYPE_ID = RAD.WORK_EFFORT_TYPE_ID
		AND RADTC.CONTENT_ID = ?

JOIN WORK_EFFORT_ASSOC A_OB1 
     ON  A_OB1.WORK_EFFORT_ID_FROM       = RAD.WORK_EFFORT_ID
     AND (? = 'Y' OR (? = 'N' AND( A_OB1.FROM_DATE     <= ? AND (A_OB1.THRU_DATE IS NULL OR A_OB1.THRU_DATE >= ?) )))

JOIN WORK_EFFORT_ASSOC_TYPE TA_OB1 ON TA_OB1.WORK_EFFORT_ASSOC_TYPE_ID = A_OB1.WORK_EFFORT_ASSOC_TYPE_ID
JOIN WORK_EFFORT OB1
     ON  A_OB1.WORK_EFFORT_ID_TO         = OB1.WORK_EFFORT_ID
     AND  (A_OB1.THRU_DATE = OB1.ESTIMATED_COMPLETION_DATE   OR
           A_OB1.THRU_DATE = RAD.ESTIMATED_COMPLETION_DATE)
JOIN WORK_EFFORT_TYPE T_OB1 ON T_OB1.WORK_EFFORT_TYPE_ID = OB1.WORK_EFFORT_TYPE_ID

JOIN WORK_EFFORT_ASSOC A_OB2 
     ON  A_OB2.WORK_EFFORT_ID_FROM       = OB1.WORK_EFFORT_ID
     AND (? = 'Y' OR (? = 'N' AND( A_OB2.FROM_DATE     <= ? AND (A_OB2.THRU_DATE IS NULL OR A_OB2.THRU_DATE >= ?) )))

JOIN WORK_EFFORT_ASSOC_TYPE TA_OB2 ON TA_OB2.WORK_EFFORT_ASSOC_TYPE_ID = A_OB2.WORK_EFFORT_ASSOC_TYPE_ID    
JOIN WORK_EFFORT       OB2
     ON  A_OB2.WORK_EFFORT_ID_TO  = OB2.WORK_EFFORT_ID
     AND  (A_OB2.THRU_DATE = OB1.ESTIMATED_COMPLETION_DATE   OR
           A_OB2.THRU_DATE = OB2.ESTIMATED_COMPLETION_DATE)

JOIN WORK_EFFORT_TYPE  T_OB2 
     ON  T_OB2.WORK_EFFORT_TYPE_ID       = OB2.WORK_EFFORT_TYPE_ID
JOIN WORK_EFFORT_ASSOC A_OB3 
     ON  A_OB3.WORK_EFFORT_ID_FROM       = OB2.WORK_EFFORT_ID
     AND (? = 'Y' OR (? = 'N' AND( A_OB3.FROM_DATE     <= ? AND (A_OB3.THRU_DATE IS NULL OR A_OB3.THRU_DATE >= ?) )))
JOIN WORK_EFFORT_ASSOC_TYPE TA_OB3 ON TA_OB3.WORK_EFFORT_ASSOC_TYPE_ID = A_OB3.WORK_EFFORT_ASSOC_TYPE_ID

JOIN WORK_EFFORT       OB3
     ON  A_OB3.WORK_EFFORT_ID_TO  = OB3.WORK_EFFORT_ID
     AND  (A_OB3.THRU_DATE = OB2.ESTIMATED_COMPLETION_DATE   OR
           A_OB3.THRU_DATE = OB3.ESTIMATED_COMPLETION_DATE)

JOIN WORK_EFFORT_TYPE  T_OB3 
     ON  T_OB3.WORK_EFFORT_TYPE_ID       = OB3.WORK_EFFORT_TYPE_ID
     
@filterInnerJoin
@filterLeftJoin

LEFT OUTER JOIN
     (SELECT OB4.WORK_EFFORT_NAME          OB4_WORK_EFFORT_NAME,
             OB4.ESTIMATED_COMPLETION_DATE OB4_ESTIMATED_COMPLETION_DATE, 
             A_OB4.THRU_DATE               A_OB4_THRU_DATE,
             OB4.ETCH                      OB4_ETCH,
             A_OB4.WORK_EFFORT_ID_TO       A_OB4_WORK_EFFORT_ID_TO ,
             OB5.WORK_EFFORT_NAME          OB5_WORK_EFFORT_NAME,
             OB5.ETCH                      OB5_ETCH,            
             OB6.WORK_EFFORT_NAME          OB6_WORK_EFFORT_NAME,
             OB6.ETCH                      OB6_ETCH,
             OB4.WORK_EFFORT_ID          OB4_WORK_EFFORT_ID,
			 OB5.WORK_EFFORT_ID          OB5_WORK_EFFORT_ID,
			 OB6.WORK_EFFORT_ID          OB6_WORK_EFFORT_ID             
      FROM   WORK_EFFORT       OB4         
      JOIN   WORK_EFFORT_ASSOC A_OB4
      ON    A_OB4.WORK_EFFORT_ID_FROM = OB4.WORK_EFFORT_ID
      AND (? = 'Y' OR (? = 'N' AND( A_OB4.FROM_DATE     <= ? AND (A_OB4.THRU_DATE IS NULL OR A_OB4.THRU_DATE >= ?) )))

      AND A_OB4.WORK_EFFORT_ASSOC_TYPE_ID =   OB4.WORK_EFFORT_ASSOC_TYPE_ID
      JOIN  WORK_EFFORT_ASSOC A_OB5
      ON    A_OB5.WORK_EFFORT_ID_TO = OB4.WORK_EFFORT_ID
      AND (? = 'Y' OR (? = 'N' AND( A_OB5.FROM_DATE     <= ? AND (A_OB5.THRU_DATE IS NULL OR A_OB5.THRU_DATE >= ?) )))
      JOIN  WORK_EFFORT       OB5
      ON    A_OB5.WORK_EFFORT_ID_FROM = OB5.WORK_EFFORT_ID
      	AND  	(A_OB5.THRU_DATE = OB4.ESTIMATED_COMPLETION_DATE   OR A_OB5.THRU_DATE = OB5.ESTIMATED_COMPLETION_DATE)

      AND A_OB5.WORK_EFFORT_ASSOC_TYPE_ID =   OB5.WORK_EFFORT_ASSOC_TYPE_ID                                       
      JOIN  WORK_EFFORT_ASSOC A_OB6
      ON    A_OB6.WORK_EFFORT_ID_TO = OB5.WORK_EFFORT_ID
      AND (? = 'Y' OR (? = 'N' AND( A_OB6.FROM_DATE     <= ? AND (A_OB6.THRU_DATE IS NULL OR A_OB6.THRU_DATE >= ?) )))
      JOIN  WORK_EFFORT       OB6
      ON    A_OB6.WORK_EFFORT_ID_FROM = OB6.WORK_EFFORT_ID
      	AND  (A_OB6.THRU_DATE = OB5.ESTIMATED_COMPLETION_DATE OR A_OB6.THRU_DATE = OB6.ESTIMATED_COMPLETION_DATE)
  

      AND A_OB6.WORK_EFFORT_ASSOC_TYPE_ID =   OB6.WORK_EFFORT_ASSOC_TYPE_ID 
      WHERE OB4.WORK_EFFORT_REVISION_ID IS NULL AND OB5.WORK_EFFORT_REVISION_ID IS NULL AND OB6.WORK_EFFORT_REVISION_ID IS NULL                                                             
             )   V_COL
      ON    V_COL.A_OB4_WORK_EFFORT_ID_TO = OB3.WORK_EFFORT_ID
      AND  (V_COL.A_OB4_THRU_DATE         = OB3.ESTIMATED_COMPLETION_DATE   OR
            V_COL.A_OB4_THRU_DATE      = V_COL.OB4_ESTIMATED_COMPLETION_DATE)
            

          
JOIN            PARTY P_E    
     ON P_E.PARTY_ID  = RAD.ORGANIZATION_ID    
     
LEFT OUTER JOIN PARTY_RELATIONSHIP R_R_UO
ON   R_R_UO.PARTY_ID_FROM     = OB3.ORG_UNIT_ID
AND  R_R_UO.ROLE_TYPE_ID_FROM = OB3.ORG_UNIT_ROLE_TYPE_ID
AND  R_R_UO.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
AND (? = 'N' OR (? = 'Y' AND(R_R_UO.THRU_DATE IS NULL)))
AND (? = 'Y' OR (? = 'N' AND( R_R_UO.FROM_DATE  <= ? AND (R_R_UO.THRU_DATE  >= ? OR  R_R_UO.THRU_DATE IS NULL))))  

LEFT OUTER JOIN  PARTY P_R_UO
ON      P_R_UO.PARTY_ID = R_R_UO.PARTY_ID_TO 

--  13/4/2012 INIZIO
LEFT OUTER JOIN PARTY_RELATIONSHIP PR_RES_A
     ON  PR_RES_A.PARTY_ID_FROM              = OB1.ORG_UNIT_ID
     AND PR_RES_A.ROLE_TYPE_ID_FROM          = OB1.ORG_UNIT_ROLE_TYPE_ID
     AND PR_RES_A.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
AND (? = 'N' OR (? = 'Y' AND PR_RES_A.THRU_DATE IS NULL))
AND (? = 'Y' OR (? = 'N' AND(PR_RES_A.FROM_DATE   <= ? AND (PR_RES_A.THRU_DATE  >= ? OR PR_RES_A.THRU_DATE IS NULL)  )))

LEFT OUTER JOIN PARTY  P_RES_A
     ON P_RES_A.PARTY_ID = PR_RES_A.PARTY_ID_TO
LEFT OUTER JOIN PARTY_RELATIONSHIP PR_RES_C
     ON  PR_RES_C.PARTY_ID_FROM              = OB2.ORG_UNIT_ID
     AND PR_RES_C.ROLE_TYPE_ID_FROM          = OB2.ORG_UNIT_ROLE_TYPE_ID
     AND PR_RES_C.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
AND (? = 'N' OR (? = 'Y' AND(PR_RES_C.THRU_DATE          IS NULL)))
AND (? = 'Y' OR (? = 'N' AND( PR_RES_C.FROM_DATE   <= ? AND (PR_RES_C.THRU_DATE  >= ? OR PR_RES_C.THRU_DATE IS NULL) )))

LEFT OUTER JOIN PARTY  P_RES_C
     ON P_RES_C.PARTY_ID = PR_RES_C.PARTY_ID_TO

-- PUNTEGGIO 
LEFT OUTER JOIN (
		  SELECT Q3.WORK_EFFORT_ID, Q3.TRANSACTION_DATE, R3.AMOUNT, R3.GL_FISCAL_TYPE_ID, R3.HAS_SCORE_ALERT, Q3.DESCRIPTION
		  FROM ACCTG_TRANS Q3 
			INNER JOIN ACCTG_TRANS_ENTRY R3 ON Q3.ACCTG_TRANS_ID = R3.ACCTG_TRANS_ID
		  WHERE R3.GL_ACCOUNT_ID = 'SCORE' 
			AND Q3.TRANSACTION_DATE = ?
			AND (R3.GL_FISCAL_TYPE_ID = 'ACTUAL')
					 ) I3 ON I3.WORK_EFFORT_ID = OB3.WORK_EFFORT_ID 
	 
WHERE  (? IS NULL OR ? = '' OR RAD.WORK_EFFORT_ID = ? )
        @notOb2WorkEffortId
		AND (? IS NULL OR ? = '' OR P_RES_A.PARTY_ID = ? OR P_RES_C.PARTY_ID = ?)
		AND (? IS NULL OR ? = '' OR OB1.ORG_UNIT_ID = ? OR OB2.ORG_UNIT_ID = ? )         
        AND (? IS NULL OR ? = '' OR OB3.WORK_EFFORT_ID = ? OR OB1.WORK_EFFORT_ID = ? OR OB2.WORK_EFFORT_ID = ? OR V_COL.OB6_WORK_EFFORT_ID = ? OR V_COL.OB5_WORK_EFFORT_ID = ? OR V_COL.OB4_WORK_EFFORT_ID = ?)
	    AND (? IS NULL OR ? = '' OR OB2.WORK_EFFORT_ID = ? )
		AND ( T_OB3.CODE_PREFIX LIKE 'O%' OR T_OB3.CODE_PREFIX LIKE 'A%' )
		AND ( T_OB3.CODE_PREFIX LIKE ?)
		-- AND ((RAD.WEIGHT_SONS > 0 AND TA_OB1.PARENT_TYPE_ID = 'HIE'
        --	AND OB1.WORK_EFFORT_PARENT_ID = RAD.WORK_EFFORT_PARENT_ID)
			--   OR (RAD.WEIGHT_ASSOC_WORK_EFFORT > 0 AND A_OB1.WORK_EFFORT_ASSOC_TYPE_ID = RAD.WORK_EFFORT_ASSOC_TYPE_ID))
    
	    AND ((OB1.WEIGHT_SONS > 0 AND TA_OB2.PARENT_TYPE_ID = 'HIE'
               AND OB2.WORK_EFFORT_PARENT_ID = OB1.WORK_EFFORT_PARENT_ID)
		    OR (OB1.WEIGHT_ASSOC_WORK_EFFORT > 0 AND A_OB2.WORK_EFFORT_ASSOC_TYPE_ID = OB1.WORK_EFFORT_ASSOC_TYPE_ID))
    
		AND ((OB2.WEIGHT_SONS > 0 AND TA_OB3.PARENT_TYPE_ID = 'HIE'
               AND OB3.WORK_EFFORT_PARENT_ID = OB2.WORK_EFFORT_PARENT_ID)
		   OR (OB2.WEIGHT_ASSOC_WORK_EFFORT > 0 AND A_OB3.WORK_EFFORT_ASSOC_TYPE_ID = OB2.WORK_EFFORT_ASSOC_TYPE_ID))
	
	@workEffortRevisionId
	@filterWhere
			    
GROUP BY 
	RADTC.ETCH,
 	A_OB1.SEQUENCE_NUM,
 	OB1.WORK_EFFORT_ID,
 	OB1.ETCH,
 	OB1.WORK_EFFORT_NAME,
 	OB1.WEIGHT_SONS,
 	A_OB2.SEQUENCE_NUM, 
 	OB2.ETCH,
 	OB2.WORK_EFFORT_NAME,
 	OB2.WEIGHT_SONS,  	
	RAD.WORK_EFFORT_NAME,
	P_E.PARTY_NAME,
  	P_RES_A.PARTY_NAME,  
  	P_RES_C.PARTY_NAME,  
	OB3.DESCRIPTION,
	T_OB3.DESCRIPTION,
	T_OB3.ETCH,
	OB3.ETCH,
 	OB3.WORK_EFFORT_NAME,
  	P_R_UO.PARTY_NAME,
  	OB1.SOURCE_REFERENCE_ID,
 	OB1.WORK_EFFORT_ID, 	
 	OB2.SOURCE_REFERENCE_ID,
 	OB2.WORK_EFFORT_ID,
 	A_OB3.SEQUENCE_NUM, 
 	OB3.SOURCE_REFERENCE_ID,	
 	OB3.WORK_EFFORT_ID,
 	OB3.WORK_EFFORT_TYPE_ID, 	
 	V_COL.OB6_ETCH,
 	V_COL.OB6_WORK_EFFORT_NAME,
 	V_COL.OB5_ETCH,
    V_COL.OB5_WORK_EFFORT_NAME,
    V_COL.OB4_ETCH, 
    V_COL.OB4_WORK_EFFORT_NAME,
 
	OB3.ESTIMATED_START_DATE,
	OB3.ESTIMATED_COMPLETION_DATE,
	OB4_WORK_EFFORT_ID,
	OB5_WORK_EFFORT_ID,
	OB6_WORK_EFFORT_ID,
	OB2.ORG_UNIT_ID,
	T_OB3.CODE_PREFIX,
	T_OB1.ETCH,
	T_OB2.ETCH
			    
ORDER BY  
 A_OB1.SEQUENCE_NUM    , 
 OB1.SOURCE_REFERENCE_ID ,
 OB1.WORK_EFFORT_ID,  
 A_OB2.SEQUENCE_NUM    , 
 OB2.SOURCE_REFERENCE_ID ,
 OB2.WORK_EFFORT_ID,
 A_OB3.SEQUENCE_NUM, 
 OB3.SOURCE_REFERENCE_ID ,
 OB3.WORK_EFFORT_ID
 ]]></xml-property>
