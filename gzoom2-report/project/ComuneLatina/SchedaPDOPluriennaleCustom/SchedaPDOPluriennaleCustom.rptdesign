                </structure>
                <structure>
                    <property name="position">13</property>
                    <property name="name">CENTRO_GESTORE</property>
                    <property name="nativeName">CENTRO_GESTORE</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">14</property>
                    <property name="name">TOT_STA_COL_P1</property>
                    <property name="nativeName">TOT_STA_COL_P1</property>
