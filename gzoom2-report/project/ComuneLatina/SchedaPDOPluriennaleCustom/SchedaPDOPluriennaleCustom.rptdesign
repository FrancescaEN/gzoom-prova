            <xml-property name="queryText"><![CDATA[SELECT
TP.GL_ACCOUNT_TYPE_ID AS GL_ACCOUNT_TYPE_ID,
TP.DESCRIPTION AS DESCRIPTION,
G.ACCOUNT_CODE     AS    CAPITOLO,
G.ACCOUNT_NAME     AS    DESCRIZIONE,
PCG.PARTY_NAME     AS    CENTRO_GESTIONE,
T.DESCRIPTION      AS   TITOLO,
(CASE WHEN I.TRANSACTION_DATE = ? THEN I.AMOUNT ELSE NULL END ) AS IMPORTO_ANNO,
(CASE WHEN I.TRANSACTION_DATE = ? THEN I.AMOUNT ELSE NULL END ) AS IMPORTO_ANNO_P1,
(CASE WHEN I.TRANSACTION_DATE = ? THEN I.AMOUNT ELSE NULL END ) AS IMPORTO_ANNO_P2,
COUNT(*) AS COUNTER   
 FROM       WORK_EFFORT_MEASURE M
 JOIN       GL_ACCOUNT          G
 ON         G.GL_ACCOUNT_ID = M.GL_ACCOUNT_ID
 JOIN       GL_ACCOUNT_TYPE     T
 ON         T.GL_ACCOUNT_TYPE_ID = G.GL_ACCOUNT_TYPE_ID
 JOIN       GL_ACCOUNT_TYPE     TP
 ON         T.PARENT_TYPE_ID = TP.GL_ACCOUNT_TYPE_ID
 INNER JOIN (
          SELECT Q.WORK_EFFORT_ID, Q.TRANSACTION_DATE, R.AMOUNT, R.GL_ACCOUNT_ID
                , Q.VOUCHER_REF   
                , Q.GL_FISCAL_TYPE_ID
          FROM ACCTG_TRANS Q 
          JOIN ACCTG_TRANS_ENTRY R ON Q.ACCTG_TRANS_ID = R.ACCTG_TRANS_ID
          ) I ON I.VOUCHER_REF = M.WORK_EFFORT_MEASURE_ID --AND I.TRANSACTION_DATE = ? 
          AND I.GL_FISCAL_TYPE_ID = 'STANZIATO'
LEFT OUTER JOIN
(SELECT   GL_ACCOUNT_ID, MAX(PARTY_ID) PARTY_ID
FROM     GL_ACCOUNT_ROLE GR
JOIN     ROLE_TYPE       R
ON       GR.ROLE_TYPE_ID = R.ROLE_TYPE_ID
AND      R.PARENT_TYPE_ID = 'ORGANIZATION_UNIT'
GROUP BY GL_ACCOUNT_ID ) CG
ON    CG.GL_ACCOUNT_ID = G.GL_ACCOUNT_ID
LEFT OUTER JOIN    PARTY PCG
ON    PCG.PARTY_ID = CG.PARTY_ID  
          	
WHERE   M.WORK_EFFORT_ID = ? 
--AND     M.WE_MEASURE_TYPE_ENUM_ID  <> 'WEMT_SCORE' 
AND     G.ACCOUNT_TYPE_ENUM_ID = 'FINANCIAL'                             
GROUP BY TP.GL_ACCOUNT_TYPE_ID,
T.DESCRIPTION,   
G.ACCOUNT_CODE,
G.ACCOUNT_NAME,
TP.DESCRIPTION,
PCG.PARTY_NAME,
I.AMOUNT,
I.TRANSACTION_DATE]]></xml-property>
