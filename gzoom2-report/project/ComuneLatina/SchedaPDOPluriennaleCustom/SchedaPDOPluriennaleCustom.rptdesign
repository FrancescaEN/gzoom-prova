            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">WORK_EFFORT_ID</property>
                    <property name="nativeName">WORK_EFFORT_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">WORK_EFFORT_TYPE_ID</property>
                    <property name="nativeName">WORK_EFFORT_TYPE_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">SOURCE_REFERENCE_ID</property>
                    <property name="nativeName">SOURCE_REFERENCE_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">WORK_EFFORT_NAME</property>
                    <property name="nativeName">WORK_EFFORT_NAME</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">ETCH_TYPE</property>
                    <property name="nativeName">ETCH_TYPE</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
 WE.WORK_EFFORT_ID,
 WET.WORK_EFFORT_TYPE_ID,
 WE.SOURCE_REFERENCE_ID, 
 WE.WORK_EFFORT_NAME,
 WET.ETCH AS ETCH_TYPE
FROM WORK_EFFORT_ASSOC WEA
INNER JOIN WORK_EFFORT WE ON WE.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_TO
INNER JOIN WORK_EFFORT_TYPE WET ON WET.WORK_EFFORT_TYPE_ID = WE.WORK_EFFORT_TYPE_ID
WHERE WEA.WORK_EFFORT_ID_FROM = ?
AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '13OCDR'
AND ( @excludeValidity = 'Y' OR  (@excludeValidity = 'N' AND ( WEA.FROM_DATE <= @monitoringDate AND (WEA.THRU_DATE >= @monitoringDate OR WEA.THRU_DATE IS NULL ))))
ORDER BY WE.SOURCE_REFERENCE_ID]]></xml-property>
