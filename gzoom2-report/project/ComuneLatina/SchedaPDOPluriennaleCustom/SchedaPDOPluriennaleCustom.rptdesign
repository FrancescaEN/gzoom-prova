            </structure>
            <method name="beforeOpen"><![CDATA[this.queryText = this.queryText.replace("@excludeValidity", "'" + params["excludeValidity"].value+ "'");

]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">WORK_EFFORT_NAME</property>
                    <property name="nativeName">WORK_EFFORT_NAME</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">SOURCE_REFERENCE_ID</property>
                    <property name="nativeName">SOURCE_REFERENCE_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">PARTY_NAME</property>
                    <property name="nativeName">PARTY_NAME</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
  OBB.WORK_EFFORT_NAME,
  OBB.SOURCE_REFERENCE_ID,
  AREA.PARTY_NAME 
  
FROM WORK_EFFORT_ASSOC ASS 
INNER JOIN WORK_EFFORT OBB ON OBB.WORK_EFFORT_ID = ASS.WORK_EFFORT_ID_TO
	AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND( OBB.ESTIMATED_START_DATE <= ? AND OBB.ESTIMATED_COMPLETION_DATE >= ? )))

LEFT OUTER JOIN PARTY P_RES ON P_RES.PARTY_ID = OBB.ORG_UNIT_ID

LEFT JOIN PARTY_RELATIONSHIP  UOAR
     ON  UOAR.PARTY_ID_TO = OBB.ORG_UNIT_ID
     AND UOAR.ROLE_TYPE_ID_TO = OBB.ORG_UNIT_ROLE_TYPE_ID
     AND UOAR.FROM_DATE <= ?
     AND (UOAR.THRU_DATE IS NULL OR UOAR.THRU_DATE >= ?)
     AND UOAR.PARTY_RELATIONSHIP_TYPE_ID = 'GROUP_ROLLUP'
LEFT JOIN PARTY AREA
     ON AREA.PARTY_ID = UOAR.PARTY_ID_FROM 
	
	
	
WHERE ASS.WORK_EFFORT_ID_FROM = ?
  AND ASS.WORK_EFFORT_ASSOC_TYPE_ID = 'PEG12GR'

ORDER BY ASS.SEQUENCE_NUM, OBB.SOURCE_REFERENCE_ID, OBB.WORK_EFFORT_ID]]></xml-property>
