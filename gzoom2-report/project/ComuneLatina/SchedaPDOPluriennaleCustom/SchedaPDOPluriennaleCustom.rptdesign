            <method name="beforeOpen"><![CDATA[/**/
this.queryText = this.queryText.replace("@date3110",  params["date3110Sql"].value);
this.queryText = this.queryText.replace("@date3009",  params["date3009Sql"].value);
this.queryText = this.queryText.replace("@date3112PIU1",  params["date3112PIU1Sql"].value);
this.queryText = this.queryText.replace("@date3112PIU2",  params["date3112PIU2Sql"].value);

/*
this.queryText = this.queryText.replace("@date3009",  "'2021-09-30 00:00:00.000'");
this.queryText = this.queryText.replace("@date3110", "'2021-10-31 00:00:00.000'");
this.queryText = this.queryText.replace("@date3112PIU1",  "'2022-09-30 00:00:00.000'");
this.queryText = this.queryText.replace("@date3112PIU2",  "'2023-09-30 00:00:00.000'");
*/
var workEffortRevisionIdStr = "";
if (params["workEffortRevisionId"].value != null &amp;&amp; params["workEffortRevisionId"].value != "") {
    workEffortRevisionIdStr = "AND G_WORK_EFFORT_REVISION_ID = '" +params["workEffortRevisionId"].value + "'";
} else {
    workEffortRevisionIdStr = "AND G_WORK_EFFORT_SNAPSHOT_ID IS NULL";
}
this.queryText = this.queryText.replace("@workEffortRevisionId", workEffortRevisionIdStr);
]]></method>
