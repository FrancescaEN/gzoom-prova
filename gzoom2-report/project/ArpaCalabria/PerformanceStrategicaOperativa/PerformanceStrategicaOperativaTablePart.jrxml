	<queryString>
		<![CDATA[select * from exp_str EXP
inner join work_effort FIL_W
on FIL_W.work_effort_id = EXP.work_effort_id_str
/* START filterInnerJoin */
   $P!{filterInnerJoinString} 
/* END filterInnerJoin */
/* START filterLeftJoin */
  $P!{filterLeftJoinString} 
/* END filterLeftJoin */
where EXP.anno = TO_CHAR($P{monitoringDateString}::date, 'YYYY')
and EXP.work_Effort_Type_Id = $P{workEffortTypeId}
  /* START filterWhere */
 $P!{filterWhereString} 
   /* END filterWhere */  
 /* START orgUnitIdString */
 $P!{orgUnitIdString}
 /* END orgUnitIdString */
 order by EXP.des_struttura_padre , EXP.des_struttura ]]>
	</queryString>
