	<parameter name="correlated_org_unit_id_str" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select * from exp_str EXP
inner join exp_str_ob OB
on EXP.work_effort_id_str = OB.work_effort_id_str
inner join work_effort FIL_W
on FIL_W.work_effort_id = EXP.work_effort_id_str
where EXP.anno = TO_CHAR($P{monitoringDateString}::date, 'YYYY')
and OB.anno = TO_CHAR($P{monitoringDateString}::date, 'YYYY')
and EXP.work_Effort_Type_Id = $P{workEffortTypeId}
and EXP.org_unit_id_str  = $P{correlated_org_unit_id_str}
order by EXP.cod_struttura, etch_ob]]>
	</queryString>
