		<parameter name="work_effort_id_ob" class="java.lang.String"/>
		<parameter name="monitoringDateString" class="java.lang.String"/>
		<queryString language="SQL">
			<![CDATA[select * from EXP_STR_OB_STRCOINV
where work_effort_id_ob = $P{work_effort_id_ob} 
and anno = TO_CHAR($P{monitoringDateString}::date, 'YYYY') 
order by TIPO_STR_COINVOLTA, DES_STR_COINVOLTA]]>
		</queryString>
	</subDataset>
