	<queryString>
		<![CDATA[select * from exp_dip EXP
inner join work_effort FIL_W
on FIL_W.work_effort_id = EXP.work_effort_id_sk
/* START filterInnerJoin */
   $P!{filterInnerJoinString} 
/* END filterInnerJoin */
/* START filterLeftJoin */
  $P!{filterLeftJoinString} 
/* END filterLeftJoin */
where EXP.anno = TO_CHAR($P{monitoringDateString}::date, 'YYYY')
and fil_w.work_Effort_Type_Id = $P{workEffortTypeId}
  /* START filterWhere */
 $P!{filterWhereString} 
   /* END filterWhere */  
 /* START orgUnitIdString */
 $P!{orgUnitIdString}
 /* END orgUnitIdString */
 order by EXP.cod_str_scheda]]>
	</queryString>
