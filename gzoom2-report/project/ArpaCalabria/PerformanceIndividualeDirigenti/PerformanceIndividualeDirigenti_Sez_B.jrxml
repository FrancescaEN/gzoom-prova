	<parameter name="workEffortIdSk" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select * from exp_dip EXP
inner join exp_dip_ob OB on EXP.work_effort_id_sk = OB.work_effort_id_sk
inner join work_effort FIL_W on FIL_W.work_effort_id = EXP.work_effort_id_sk
where EXP.anno = TO_CHAR($P{monitoringDateString}::date, 'YYYY')
and OB.COD_AMBITO = 'CO'
and work_Effort_Type_Id = $P{workEffortTypeId}
and EXP.org_unit_id_str  = $P{correlated_org_unit_id_str}
and OB.work_effort_id_sk = $P{workEffortIdSk}
order by EXP.cod_str_scheda, etch_ob]]>
	</queryString>
