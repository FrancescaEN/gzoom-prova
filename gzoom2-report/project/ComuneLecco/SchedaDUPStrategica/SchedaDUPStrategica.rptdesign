                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT we.WORK_EFFORT_NAME AS "STAKEHOLDER_NAME"
FROM work_effort_assoc wea 
INNER JOIN work_effort we ON wea.WORK_EFFORT_ID_FROM = we.WORK_EFFORT_ID 
WHERE wea.WORK_EFFORT_ID_TO = ?
AND wea.WORK_EFFORT_ASSOC_TYPE_ID = '16STAKE' ]]></xml-property>
