	<queryString language="SQL">
		<![CDATA[SELECT
    wept.description AS "Tipologia Misura",
    COUNT(mis.work_effort_id) AS "Quantità",
    sotta.work_effort_name as "Nome Area",
    ROUND(COUNT(mis.work_effort_id) * 100.0 / SUM(COUNT(mis.work_effort_id)) OVER (), 0) AS "Percentuale sul totale",
    SUM(COUNT(mis.work_effort_id)) OVER () AS "Totale"
from work_effort mis
inner join work_effort_assoc wea1 on wea1.work_effort_id_to=mis.work_effort_id and wea1.work_effort_assoc_type_id='COPY' 
inner join work_effort miscat on miscat.work_effort_id=wea1.work_effort_id_from
inner join work_effort_assoc wea2 on wea2.work_effort_id_to=miscat.work_effort_id and wea2.work_effort_assoc_type_id='15APAREC' 
inner join work_effort are on are.work_effort_id=wea2.work_effort_id_from
inner join work_effort_purpose_type wept on wept.work_effort_purpose_type_id=mis.work_effort_purpose_type_id
inner join work_effort proc on proc.work_effort_id=mis.work_effort_parent_id
inner join work_effort_assoc wea4 on wea4.work_effort_id_to=proc.work_effort_id and wea4.work_effort_assoc_type_id='15APSARC'
inner join work_effort sotta on sotta.work_effort_id=wea4.work_effort_id_from 
where sotta.work_effort_id= $P{areaId} 
and (mis.estimated_start_date<=$P{date3112}  and mis.estimated_completion_date>= $P{date0101} )
GROUP BY wept.description, sotta.work_effort_name]]>
