	<queryString>
		<![CDATA[select 
	RADTC.ETCH as "RAD_TITOLO",
	RA.WORK_EFFORT_ID as "RA_WORK_EFFORT_ID",
	WET.ETCH as "AREA_TYPE",
	AR.WORK_EFFORT_ID as "ID_AREA",
	CONCAT(AR.ETCH,' - ',AR.WORK_EFFORT_NAME) as "AREA_RISCHIO",
	WET2.ETCH as "PROCESSO_TYPE",
	FIL_W.WORK_EFFORT_ID as "ID_PROCESSO",
	CONCAT(FIL_W.ETCH,' - ',FIL_W.WORK_EFFORT_NAME) as "PROCESSO",
	CONCAT(PPR.PARENT_ROLE_CODE,' - ',P.PARTY_NAME) as "STRUTTURA",
	P2.PARTY_NAME as "RESP_STRUTTURA",
	VALUT.AMOUNT as "VALUTAZIONE_RISCHIO",
	VALUT.COMMENTS as "FASCIA_VALUTAZIONE",
	VALUT.OBJECT_INFO as "EMOTE",
	NOTEPRO.MOTIVAZIONE_NAME as "MOTIVAZIONE_VAL_RISC_NAME",
	NOTEPRO.MODALITA_NAME as "MODALITA_VERIFICA_NAME",
	NOTEPRO.EVENTI_NAME as "EVENTI_SENTINELLA_NAME",	
	NOTEPRO.MOTIVAZIONE as "MOTIVAZIONE_VALUTAZIONE_RISCHIO",
	NOTEPRO.MODALITA as "MODALITA_VERIFICA",
	NOTEPRO.EVENTI as "EVENTI_SENTINELLA",
	RESPRO.NOTE_NAME as "ETCH_RESP_PROCESSO",
	RESPRO.NOTE_INFO as "RESP_PROCESSO"
from
	WORK_EFFORT RA
inner join WORK_EFFORT_TYPE RAT on
	RAT.WORK_EFFORT_TYPE_ID = RA.WORK_EFFORT_TYPE_ID
inner join WORK_EFFORT_TYPE_CONTENT RADTC on
	RADTC.WORK_EFFORT_TYPE_ID = RAT.WORK_EFFORT_TYPE_ID
	and RADTC.CONTENT_ID = $P{reportContentId}
join WORK_EFFORT_ASSOC WEA on
	WEA.WORK_EFFORT_ID_FROM = RA.WORK_EFFORT_ID
	and WEA.WORK_EFFORT_ASSOC_TYPE_ID = '15APPPC'
join WORK_EFFORT ARSUP on
	ARSUP.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_TO
	and ARSUP.WORK_EFFORT_TYPE_ID = '15AP1ARE'
	and ARSUP.WORK_EFFORT_REVISION_ID is null
	and ARSUP.ESTIMATED_START_DATE <= $P{date3112}
	and ($P{excludeValidity} = 'Y'
		or ($P{excludeValidity} = 'N'
			and ARSUP.ESTIMATED_START_DATE <= $P{date3112}
			and (ARSUP.ESTIMATED_COMPLETION_DATE is null
				or ARSUP.ESTIMATED_COMPLETION_DATE >= $P{date0101})))
join WORK_EFFORT_TYPE WET on
	WET.WORK_EFFORT_TYPE_ID = ARSUP.WORK_EFFORT_TYPE_ID
join WORK_EFFORT_ASSOC WEA2 on
	WEA2.WORK_EFFORT_ID_FROM = ARSUP.WORK_EFFORT_ID
	and WEA2.WORK_EFFORT_ASSOC_TYPE_ID = '15APPPC'
join WORK_EFFORT AR on
	AR.WORK_EFFORT_ID = WEA2.WORK_EFFORT_ID_TO
	and AR.WORK_EFFORT_TYPE_ID = '15AP2SAR'
	and AR.WORK_EFFORT_REVISION_ID is null
	and ($P{excludeValidity} = 'Y'
		or ($P{excludeValidity} = 'N'
			and AR.ESTIMATED_START_DATE <= $P{date3112}
			and (AR.ESTIMATED_COMPLETION_DATE is null
				or AR.ESTIMATED_COMPLETION_DATE >= $P{date0101})))
join WORK_EFFORT_ASSOC WEA3 on
	WEA3.WORK_EFFORT_ID_FROM = AR.WORK_EFFORT_ID
	and WEA3.WORK_EFFORT_ASSOC_TYPE_ID = '15APSARC'
join WORK_EFFORT FIL_W on
	FIL_W.WORK_EFFORT_ID = WEA3.WORK_EFFORT_ID_TO
	and FIL_W.WORK_EFFORT_TYPE_ID = '15AP3PRO'
	and FIL_W.WORK_EFFORT_REVISION_ID is null
	and ($P{excludeValidity} = 'Y'
		or ($P{excludeValidity} = 'N'
			and FIL_W.ESTIMATED_START_DATE <= $P{date3112}
			and (FIL_W.ESTIMATED_COMPLETION_DATE is null
				or FIL_W.ESTIMATED_COMPLETION_DATE >= $P{date0101})))	

/* RESPONSABILE DI PROCESSO */
left join (
	select 
		ND.NOTE_NAME,
		ND.NOTE_INFO,
		WEN.WORK_EFFORT_ID
	from
		WORK_EFFORT_NOTE WEN
	join NOTE_DATA ND on
		ND.NOTE_ID = WEN.NOTE_ID
	where
		WEN.SEQUENCE_ID = 10
) RESPRO on
	RESPRO.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
join WORK_EFFORT_TYPE WET2 on
	WET2.WORK_EFFORT_TYPE_ID = FIL_W.WORK_EFFORT_TYPE_ID
left join (
	select 
		WEM.WORK_EFFORT_ID, 
		ATE.AMOUNT, 
		URV.COMMENTS,
		DR.OBJECT_INFO
	from
		WORK_EFFORT_MEASURE WEM
	left join ACCTG_TRANS ACT on
		ACT.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID
		and ACT.TRANSACTION_DATE >= $P{date0101}
		and ACT.TRANSACTION_DATE <= $P{date3112}
	left join ACCTG_TRANS_ENTRY ATE on
		ATE.ACCTG_TRANS_ID = ACT.ACCTG_TRANS_ID
	left join UOM_RANGE_VALUES URV on
		URV.UOM_RANGE_ID = 'CORRISS'
		and URV.FROM_VALUE <= ATE.AMOUNT
		and URV.THRU_VALUE >= ATE.AMOUNT
	left join content C on
		C.CONTENT_ID = URV.ICON_CONTENT_ID
	left join DATA_RESOURCE DR on
		DR.DATA_RESOURCE_ID = C.DATA_RESOURCE_ID
	where
		WEM.GL_ACCOUNT_ID = '10502'
) VALUT on
	VALUT.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
left join (
	select 
		WEN.WORK_EFFORT_ID,
		MAX(case when WEN.SEQUENCE_ID = 102 then ND.NOTE_NAME else null end) as MOTIVAZIONE_NAME,
		MAX(case when WEN.SEQUENCE_ID = 200 then ND.NOTE_NAME else null end) as MODALITA_NAME,
		MAX(case when WEN.SEQUENCE_ID = 201 then ND.NOTE_NAME else null end) as EVENTI_NAME,
		MAX(case when WEN.SEQUENCE_ID = 102 then ND.NOTE_INFO else null end) as MOTIVAZIONE,
		MAX(case when WEN.SEQUENCE_ID = 200 then ND.NOTE_INFO else null end) as MODALITA,
		MAX(case when WEN.SEQUENCE_ID = 201 then ND.NOTE_INFO else null end) as EVENTI
	from
		WORK_EFFORT_NOTE WEN
	join NOTE_DATA ND on
		ND.NOTE_ID = WEN.NOTE_ID
		and ND.NOTE_DATE_TIME >= $P{date0101}
		and ND.NOTE_DATE_TIME <= $P{date3112}
	group by
		WEN.WORK_EFFORT_ID 
) NOTEPRO on
	NOTEPRO.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
join PARTY P on
	P.PARTY_ID = FIL_W.ORG_UNIT_ID
join PARTY_PARENT_ROLE PPR on
	PPR.PARTY_ID = P.PARTY_ID
	and PPR.ROLE_TYPE_ID = 'ORGANIZATION_UNIT'
left join PARTY_RELATIONSHIP PR2 on
	PR2.PARTY_ID_FROM = FIL_W.ORG_UNIT_ID
	and PR2.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
	and PR2.THRU_DATE is null
left join PARTY P2 on
	P2.PARTY_ID = PR2.PARTY_ID_TO 
/* START filterInnerJoin */
	$P!{filterInnerJoinString} 
/* END filterInnerJoin */
	/* START filterLeftJoin */
	$P!{filterLeftJoinString} 
/* END filterLeftJoin */
WHERE 1 = 1
	/* START orgUnitIdString */
	$P!{orgUnitIdString}
	/* END orgUnitIdString */
	/* START workEffortIdString */
	$P!{workEffortIdString}
	/* END workEffortIdString */
	/* START organizationIdString */
	$P!{organizationIdString} 
    /* END organizationIdString */  
	/* START filterWhere */
	$P!{filterWhereString} 
    /* END filterWhere */
           
ORDER BY wea.SEQUENCE_NUM,
	AR.ETCH, 
	WEA2.SEQUENCE_NUM,
	FIL_W.ETCH,
	FIL_W.WORK_EFFORT_NAME,
	FIL_W.DESCRIPTION]]>
	</queryString>
