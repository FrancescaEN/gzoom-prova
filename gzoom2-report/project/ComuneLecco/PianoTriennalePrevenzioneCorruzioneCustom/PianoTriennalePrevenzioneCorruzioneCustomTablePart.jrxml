 $P{workEffortIdChild}  != null && $P{workEffortIdChild} != "" ? " AND ( AR.WORK_EFFORT_ID = '" + $P{workEffortIdChild} + "' OR ARSUP.WORK_EFFORT_ID = '" + $P{workEffortIdChild} + "' OR AR.WORK_EFFORT_ID = '" + $P{workEffortIdChild} + "' OR FIL_W.WORK_EFFORT_ID = '" + $P{workEffortIdChild} + "') " : ""]]></defaultValueExpression>
