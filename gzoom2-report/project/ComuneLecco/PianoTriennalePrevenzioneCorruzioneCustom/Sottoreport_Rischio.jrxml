	<queryString language="SQL">
		<![CDATA[select 
    ris.work_effort_id as "ID_RISCHIO",
	concat(ris.etch, ' - ', ris.work_effort_name) as "RISCHIO",
	fatt.lista as "FATTORI_ABILITANTI",
	mis.work_effort_id as "ID_MISURA",
	obbl.uom_descr as "OBBL_ULT",
	concat('Misura ', obbl.uom_descr) as "MISURA_OBBL_ULT",
	concat(mis.etch, ' - ', mis.work_effort_name) as "MISURA",
	notemis.responsabile_name as "RESP_MISURA_NAME",
	notemis.tempi_name as "TEMPI_MODI_ATTUAZIONE_NAME",	
	notemis.responsabile as "RESP_MISURA",
	notemis.tempi as "TEMPI_MODI_ATTUAZIONE",
	indic.gl_account_id as "ID_INDICATORE",
	indic.account_name as "ACCOUNT_NAME",
	indic.uom_descr as "INDICATORE",
	indic.abbreviation as "UDM",
	indic.target as "TARGET",
	wept.description as "CATEGORIA",
	wet.description as "TIPOLOGIA"
from work_effort_assoc wea4 
join work_effort ris on ris.work_effort_id = wea4.work_effort_id_to 
    and ris.work_effort_type_id = '15AP4RIS' 
    and ris.work_effort_revision_id is null
    and ($P{excludeValidity} = 'Y' or ($P{excludeValidity} = 'N' and ris.estimated_start_date <= $P{date3112} and (ris.estimated_completion_date >= $P{date0101} or ris.estimated_completion_date is null)))
left join (
	select 
		wem.work_effort_id,
		string_agg(gl.account_name, ',
' order by gl.account_name) as lista 
	from work_effort_measure wem
	join gl_account gl on gl.gl_account_id = wem.gl_account_id 
	join work_effort_purpose_account wepa on wepa.gl_account_id = wem.gl_account_id 
	    and wepa.work_effort_purpose_type_id = 'CORFAT'
	join acctg_trans act on act.voucher_ref = wem.work_effort_measure_id 
	    and act.transaction_date = $P{date3112}
	join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id 
	    and ate.amount = 100
	group by wem.work_effort_id 
) fatt on fatt.work_effort_id = ris.work_effort_id 
join work_effort_assoc wea5 on wea5.work_effort_id_from = ris.work_effort_id 
    and wea5.work_effort_assoc_type_id = '15APPRO'
join work_effort mis on mis.work_effort_id = wea5.work_effort_id_to 
    and mis.work_effort_type_id like '15AP5M%' 
    and mis.work_effort_revision_id is null
    and ($P{excludeValidity} = 'Y' or ($P{excludeValidity} = 'N' and mis.estimated_start_date <= $P{date3112} and (mis.estimated_completion_date >= $P{date0101} or mis.estimated_completion_date is null)))
left join (
	select 
		wem.work_effort_id,
		gamrs.uom_descr 
	from work_effort_measure wem
	join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id 
	    and ate.gl_account_id = 'NIG10010'
	join acctg_trans at on at.acctg_trans_id = ate.acctg_trans_id 
	    and at.gl_fiscal_type_id = 'CARMIS'
	join gl_account_meas_rat_sc gamrs on gamrs.gl_account_id = wem.gl_account_id 
		and ate.amount = gamrs.uom_rating_value 
) obbl on obbl.work_effort_id = mis.work_effort_id

left join work_effort_purpose_type wept on wept.work_effort_purpose_type_id = mis.work_effort_purpose_type_id
join work_effort_type wet on wet.work_effort_type_id = mis.work_effort_type_id

left join (
	select 
		wen.work_effort_id,
		max(case when wen.sequence_id = 10 then nd.note_name else null end) as responsabile_name,
		max(case when wen.sequence_id = 20 then nd.note_name else null end) as tempi_name,		
		max(case when wen.sequence_id = 10 then nd.note_info else null end) as responsabile,
		max(case when wen.sequence_id = 20 then nd.note_info else null end) as tempi
	from work_effort_note wen
	join note_data nd on nd.note_id = wen.note_id
	group by
		wen.work_effort_id
) notemis on notemis.work_effort_id = mis.work_effort_id 
left join (
	select 
		wem.work_effort_id,
		wem.uom_descr,
		u.abbreviation,
		gl.gl_account_id,
		gl.account_name,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' then 
			(case when u.uom_type_id = 'RATING_SCALE' then gamrs.uom_descr else ate.amount::text end) else null end) as target,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' then 
			(case when u.uom_type_id = 'RATING_SCALE' then gamrs.uom_descr else ate.amount::text end) else null end) as consuntivo
	from work_effort_measure wem
	join gl_account gl on gl.gl_account_id = wem.gl_account_id 
	join uom u on u.uom_id = gl.default_uom_id 
	join work_effort_purpose_account wepa on wepa.gl_account_id = wem.gl_account_id 
	    and wepa.work_effort_purpose_type_id = 'CORMIS'
	left join acctg_trans act on act.voucher_ref = wem.work_effort_measure_id 
	    and act.transaction_date = $P{date3112}
	left join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id 
	left join gl_account_meas_rat_sc gamrs on gamrs.gl_account_id = gl.gl_account_id 
	    and gamrs.uom_rating_value = ate.amount
	where wem.from_date <=  $P{monitoringDate}
    and (wem.thru_date is null or wem.thru_date >= $P{monitoringDate})
	group by
		wem.work_effort_id, 
		wem.uom_descr, 
		u.abbreviation,
		gl.gl_account_id,
		gl.account_name
) indic on indic.work_effort_id = mis.work_effort_id 
where wea4.work_effort_assoc_type_id = '15APPRO'
and wea4.work_effort_id_from =  $P{processoId} 
order by
   concat(ris.etch, ' - ', ris.work_effort_name),
   concat(mis.etch, ' - ', mis.work_effort_name)]]>
	</queryString>
