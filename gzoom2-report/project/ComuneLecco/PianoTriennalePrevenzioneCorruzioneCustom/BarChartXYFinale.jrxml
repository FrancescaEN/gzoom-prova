		</parameter>
		<parameter name="filterWhereString" class="java.lang.String" isForPrompting="false"/>
		<parameter name="filterLeftJoinString" class="java.lang.String" isForPrompting="false"/>
		<parameter name="filterInnerJoinString" class="java.lang.String" isForPrompting="false"/>
		<parameter name="organizationId" class="java.lang.String">
			<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
		</parameter>
		<parameter name="organizationIdString" class="java.lang.String">
			<defaultValueExpression><![CDATA[$P{organizationId}  != null && $P{organizationId}  != ""   && LEN($P{organizationId}) != 0 ? "' AND  PTPC.ORGANIZATION_ID ='" + $P{orgUnitId}  + "'": ""]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[WITH counts AS (
    SELECT
        are.work_effort_name as "Area",
        COUNT(mis.work_effort_id) AS "N. Misure",
        COUNT(DISTINCT fil_w.work_effort_id) AS "N. processi"
    FROM work_effort mis
    INNER JOIN work_effort_assoc wea1 ON wea1.work_effort_id_to = mis.work_effort_id
        AND wea1.work_effort_assoc_type_id = 'COPY'
    INNER JOIN work_effort miscat ON miscat.work_effort_id = wea1.work_effort_id_from
    INNER JOIN work_effort_assoc wea2 ON wea2.work_effort_id_to = miscat.work_effort_id
        AND wea2.work_effort_assoc_type_id = '15APAREC'
    INNER JOIN work_effort are ON are.work_effort_id = wea2.work_effort_id_from
    INNER JOIN work_effort_purpose_type wept ON wept.work_effort_purpose_type_id = mis.work_effort_purpose_type_id
    INNER JOIN work_effort fil_w ON fil_w.work_effort_id = mis.work_effort_parent_id
    INNER JOIN work_effort_assoc wea4 ON wea4.work_effort_id_to = fil_w.work_effort_id
        AND wea4.work_effort_assoc_type_id = '15APSARC'
    INNER JOIN work_effort sotta ON sotta.work_effort_id = wea4.work_effort_id_from
    INNER JOIN work_effort_assoc wea5 on wea5.work_effort_id_to=are.work_effort_id
        AND wea5.work_effort_assoc_type_id = '15APPPC' 
     INNER JOIN work_effort ptpc on ptpc.work_effort_id=wea5.work_effort_id_from
    /* START filterInnerJoin */
	$P!{filterInnerJoinString} 
/* END filterInnerJoin */
	/* START filterLeftJoin */
	$P!{filterLeftJoinString} 
/* END filterLeftJoin */
    WHERE mis.estimated_start_date <=  $P{date3112} 
        AND mis.estimated_completion_date >=  $P{date0101} 
        /* START orgUnitIdString */
	--$P!{orgUnitIdString}
	/* END orgUnitIdString */
	/* START organizationIdString */
	$P!{organizationIdString} 
    /* END organizationIdString */  
	/* START filterWhere */
	$P!{filterWhereString} 
		/* END filterWhere */
    GROUP BY are.work_effort_name
)
SELECT
    "Area",
    "N. Misure",
    "N. processi",
    ROUND("N. Misure" * 1.0 / NULLIF("N. processi", 0), 2) AS "N. Misure / N. processi"
FROM counts;]]>
		</queryString>
