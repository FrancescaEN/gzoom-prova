            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
	   RAD.WORK_EFFORT_NAME AS "TITLE",
	   RAT.ETCH AS "RAD_TITOLO_ETCH",
	   RAD.WORK_EFFORT_ID AS "ID_RAD",
	   RADTC.ETCH AS "RAD_TITOLO",
	   B0.ETCH AS "ETICHETTA0",
	   A0.ETCH AS "ETCH0",
	   A0.WORK_EFFORT_NAME AS "NAME0",
	   Z0.SEQUENCE_NUM AS "SEQ0",
	   A0.WORK_EFFORT_ID AS "ID0",
	   A0.DESCRIPTION AS "DESCRIPTION0",
	   Z0.ASSOC_WEIGHT AS "ASSOC_WEIGHT0",
	   A0.SOURCE_REFERENCE_ID AS "CODE0", 	   
	   ND0.NOTE_INFO AS "NOTE_INFO0",
	   B1.ETCH AS "ETICHETTA1",
	   FIL_W.ETCH AS "ETCH1",
	   FIL_W.WORK_EFFORT_NAME AS "NAME1",
	   Z1.SEQUENCE_NUM AS "SEQ1",
	   FIL_W.WORK_EFFORT_ID AS "ID1",
	   FIL_W.DESCRIPTION AS "DESCRIPTION1",
	   Z1.ASSOC_WEIGHT AS "ASSOC_WEIGHT1",
	   FIL_W.SOURCE_REFERENCE_ID AS "CODE1",        
       FIL_W.ESTIMATED_START_DATE AS "ESTIMATED_START_DATE1",
       FIL_W.ESTIMATED_COMPLETION_DATE AS "ESTIMATED_COMPLETION_DATE1",
       ND1.NOTE_INFO AS "NOTE_INFO1", 
	   B2.ETCH AS "ETICHETTA2",
	   A2.ETCH AS "ETCH2",
	   A2.WORK_EFFORT_NAME AS "NAME2",
	   Z2.SEQUENCE_NUM AS "SEQ2",
	   A2.WORK_EFFORT_ID AS "ID2",
	   A2.DESCRIPTION AS "DESCRIPTION2",
	   Z2.ASSOC_WEIGHT AS "ASSOC_WEIGHT2",
	   A2.SOURCE_REFERENCE_ID AS "CODE2",        
 	   A2.ESTIMATED_START_DATE AS "ESTIMATED_START_DATE2",
 	   A2.ESTIMATED_COMPLETION_DATE AS "ESTIMATED_COMPLETION_DATE2",      

	   P_A1.PARTY_NAME AS "RESPONSABILE1",
	   P_STRUT.PARTY_ID AS "STRUTTURA_ID1",
	   P_STRUT.PARTY_NAME AS "STRUTTURA1",	   
	   R_STRUT.DESCRIPTION AS "TIPO_STRUTTURA1"
 	     
	     
FROM WORK_EFFORT RAD
	 INNER JOIN WORK_EFFORT_TYPE RAT ON RAT.WORK_EFFORT_TYPE_ID = RAD.WORK_EFFORT_TYPE_ID	
	 INNER JOIN WORK_EFFORT_TYPE_CONTENT RADTC ON RADTC.WORK_EFFORT_TYPE_ID = RAD.WORK_EFFORT_TYPE_ID
		AND RADTC.CONTENT_ID = @reportContentId
	 -- missioni
	 INNER JOIN WORK_EFFORT_ASSOC Z0 ON Z0.WORK_EFFORT_ID_FROM = RAD.WORK_EFFORT_ID
	 	AND Z0.WORK_EFFORT_ASSOC_TYPE_ID = RAT.HIERARCHY_ASSOC_TYPE_ID		
     	AND ( @excludeValidity = 'Y' OR  (@excludeValidity = 'N' AND ( Z0.FROM_DATE <= @monitoringDate AND (Z0.THRU_DATE >= @monitoringDate OR Z0.THRU_DATE IS NULL ))))
     INNER JOIN WORK_EFFORT A0 ON A0.WORK_EFFORT_ID = Z0.WORK_EFFORT_ID_TO
     INNER JOIN WORK_EFFORT_ASSOC_TYPE D0 ON D0.WORK_EFFORT_ASSOC_TYPE_ID = Z0.WORK_EFFORT_ASSOC_TYPE_ID     
     INNER JOIN WORK_EFFORT_TYPE B0 ON B0.WORK_EFFORT_TYPE_ID = A0.WORK_EFFORT_TYPE_ID     
	 	
	 -- obiettivo strategico
     INNER JOIN WORK_EFFORT_ASSOC Z1 ON Z1.WORK_EFFORT_ID_FROM = A0.WORK_EFFORT_ID
     	AND Z1.WORK_EFFORT_ASSOC_TYPE_ID = RAT.HIERARCHY_ASSOC_TYPE_ID
     	AND ( @excludeValidity = 'Y' OR  (@excludeValidity = 'N' AND ( Z1.FROM_DATE <= @monitoringDate AND (Z1.THRU_DATE >= @monitoringDate OR Z1.THRU_DATE IS NULL ))))     	
     INNER JOIN WORK_EFFORT FIL_W ON FIL_W.WORK_EFFORT_ID = Z1.WORK_EFFORT_ID_TO
     INNER JOIN WORK_EFFORT_ASSOC_TYPE D1 ON D1.WORK_EFFORT_ASSOC_TYPE_ID = Z1.WORK_EFFORT_ASSOC_TYPE_ID     
     INNER JOIN WORK_EFFORT_TYPE B1 ON B1.WORK_EFFORT_TYPE_ID = FIL_W.WORK_EFFORT_TYPE_ID     	
     
       -- lena mandato
     INNER JOIN WORK_EFFORT_ASSOC Z2 ON Z2.WORK_EFFORT_ID_TO = FIL_W.WORK_EFFORT_ID
     	 AND Z2.WORK_EFFORT_ASSOC_TYPE_ID = '15BILC'
     	 AND ( @excludeValidity = 'Y' OR  (@excludeValidity = 'N' AND ( Z2.FROM_DATE <= @monitoringDate AND (Z2.THRU_DATE >= @monitoringDate OR Z2.THRU_DATE IS NULL ))))     	 
     INNER JOIN WORK_EFFORT A2 ON A2.WORK_EFFORT_ID = Z2.WORK_EFFORT_ID_FROM
     INNER JOIN WORK_EFFORT_ASSOC_TYPE D2 ON D2.WORK_EFFORT_ASSOC_TYPE_ID = Z2.WORK_EFFORT_ASSOC_TYPE_ID     
     INNER JOIN WORK_EFFORT_TYPE B2 ON B2.WORK_EFFORT_TYPE_ID = A2.WORK_EFFORT_TYPE_ID
     
      @filterInnerJoin
     @filterLeftJoin
    
     
	 -- responsabile obiettivo
  	 LEFT OUTER JOIN PARTY_RELATIONSHIP P_RESP_A1 ON  P_RESP_A1.PARTY_ID_FROM = FIL_W.ORG_UNIT_ID
     	AND P_RESP_A1.ROLE_TYPE_ID_FROM = FIL_W.ORG_UNIT_ROLE_TYPE_ID
     	AND P_RESP_A1.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
     	AND (@excludeValidity = 'N' OR (@excludeValidity = 'Y' AND P_RESP_A1.THRU_DATE IS NULL))     
     	AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND P_RESP_A1.FROM_DATE <= @monitoringDate AND (P_RESP_A1.THRU_DATE >= @monitoringDate OR P_RESP_A1.THRU_DATE IS NULL) )) 

	LEFT OUTER JOIN PARTY P_A1 ON P_A1.PARTY_ID = P_RESP_A1.PARTY_ID_TO
	
	-- STRUTTURA
	LEFT OUTER JOIN PARTY P_STRUT ON P_STRUT.PARTY_ID = FIL_W.ORG_UNIT_ID
    LEFT OUTER JOIN ROLE_TYPE R_STRUT ON R_STRUT.ROLE_TYPE_ID = FIL_W.ORG_UNIT_ROLE_TYPE_ID
    
   -- descrizione estesa MISSIONE
   LEFT OUTER JOIN WORK_EFFORT_NOTE WEN0 ON WEN0.WORK_EFFORT_ID = A0.WORK_EFFORT_ID
   		AND WEN0.IS_MAIN = 'Y'
   LEFT OUTER JOIN NOTE_DATA ND0 ON ND0.NOTE_ID = WEN0.NOTE_ID
   
   -- descrizione estesa OBIETTIVO
   LEFT OUTER JOIN WORK_EFFORT_NOTE WEN1 ON WEN1.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
   		AND WEN1.IS_MAIN = 'Y'
   LEFT OUTER JOIN NOTE_DATA ND1 ON ND1.NOTE_ID = WEN1.NOTE_ID
	
WHERE 0=0
  
  -- valorizzati solo se esistenti
  @workEffortId	 
  @workEffortIdChild
  @orgUnitId
  @filterWhere
  
order by Z0.SEQUENCE_NUM,A0.SOURCE_REFERENCE_ID,A0.WORK_EFFORT_ID,Z1.SEQUENCE_NUM,FIL_W.SOURCE_REFERENCE_ID,FIL_W.WORK_EFFORT_ID]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="IndicatoriDS" id="49522">
            <list-property name="computedColumns">
                <structure>
                    <property name="name">INDICATORE</property>
                    <expression name="expression">if(row["G_INPUT_ENUM_ID"] == "ACCINP_UO"){&#13;
	 row["G_ACCOUNT_NAME"];&#13;
} else if(row["G_INPUT_ENUM_ID"] == "ACCINP_PRD"){&#13;
	 (row["UOM_DESCR"] != null &amp;&amp; row["UOM_DESCR"] != "" ? row["UOM_DESCR"]  :  row["G_ACCOUNT_NAME"])&#13;
} else if(row["G_INPUT_ENUM_ID"] == "ACCINP_OBJ"){&#13;
	(row["M_UOM_DESCR"] != null &amp;&amp; row["M_UOM_DESCR"] != "" ? row["M_UOM_DESCR"]  : row["G_ACCOUNT_NAME"])&#13;
} else {&#13;
	row["G_ACCOUNT_NAME"];&#13;
}</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">COUNT</property>
                    <property name="dataType">integer</property>
                    <property name="aggregateFunction">COUNT</property>
                    <list-property name="arguments">
                        <structure>
                            <property name="name">Expression</property>
                            <expression name="value">row["M_WORK_EFFORT_MEASURE_ID"]</expression>
                        </structure>
                    </list-property>
                </structure>
            </list-property>
