            <method name="beforeOpen"><![CDATA[this.queryText = this.queryText.replace("@excludePerformanceKPI", "'" + params["excludePerformanceKPI"].value+ "'");

// prendo la data inizio della linea di mandato
// prendo l'anno della data inizio e vado avanti di 4 così avro i 4 periodi di riferimento
/**/
var dataInizio = this.getInputParameterValue("dataInizio");
var date3112 = com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc(UtilDateTime.getMonthEndFromDatetime('12', reportContext.getTimeZone().getID(), BirtDateTime.year(dataInizio), reportContext.getLocale()), params["odaDialect"].value);
var date3112P1 = com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc(UtilDateTime.getMonthEndFromDatetime('12', reportContext.getTimeZone().getID(), BirtDateTime.year(dataInizio)+1, reportContext.getLocale()), params["odaDialect"].value);
var date3112P2 = com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc(UtilDateTime.getMonthEndFromDatetime('12', reportContext.getTimeZone().getID(), BirtDateTime.year(dataInizio)+2, reportContext.getLocale()), params["odaDialect"].value);
var date3112P3 = com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc(UtilDateTime.getMonthEndFromDatetime('12', reportContext.getTimeZone().getID(), BirtDateTime.year(dataInizio)+3, reportContext.getLocale()), params["odaDialect"].value);
var date3112P4 = com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc(UtilDateTime.getMonthEndFromDatetime('12', reportContext.getTimeZone().getID(), BirtDateTime.year(dataInizio)+4, reportContext.getLocale()), params["odaDialect"].value);

this.queryText = this.queryText.replace("@date3112P1",  date3112P1 );
this.queryText = this.queryText.replace("@date3112P2",  date3112P2 );
this.queryText = this.queryText.replace("@date3112P3",  date3112P3 );
this.queryText = this.queryText.replace("@date3112P4",  date3112P4 );
this.queryText = this.queryText.replace("@date3112",  date3112 );
this.queryText = this.queryText.replace("@date0101",  date0101 );															


