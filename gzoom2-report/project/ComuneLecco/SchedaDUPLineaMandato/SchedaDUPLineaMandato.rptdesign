                    <property name="name">monitoringDate1</property>
                    <property name="paramName">monitoringDate</property>
                    <property name="nativeName"></property>
                    <property name="dataType">dateTime</property>
                    <property name="nativeDataType">93</property>
                    <property name="position">2</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
                <structure>
                    <property name="name">workEffortId</property>
                    <property name="nativeName"></property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                    <property name="position">3</property>
                    <expression name="defaultValue" type="constant">N/A</expression>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">WORK_EFFORT_ID</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">PARTY_NAME</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <method name="beforeOpen"><![CDATA[ReportLog.info("... this.queryText ASSESSORI: "+this.queryText);
ReportLog.info("... this.queryText ASSESSORIREPORT: "+this.getInputParameters());]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">WORK_EFFORT_ID</property>
                    <property name="nativeName">WORK_EFFORT_ID</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">PARTY_NAME</property>
                    <property name="nativeName">PARTY_NAME</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
	OB.WORK_EFFORT_ID AS "WORK_EFFORT_ID",  
	P.PARTY_NAME AS "PARTY_NAME"

FROM WORK_EFFORT OB
INNER JOIN WORK_EFFORT_PARTY_ASSIGNMENT A ON A.WORK_EFFORT_ID = OB.WORK_EFFORT_ID
	AND A.ROLE_TYPE_ID = 'WEM_ASSESORE'
	AND A.FROM_DATE <= ?
    AND A.THRU_DATE >= ?

INNER JOIN PARTY P ON P.PARTY_ID = A.PARTY_ID
  
WHERE OB.WORK_EFFORT_ID = ? 
GROUP BY OB.WORK_EFFORT_ID, P.PARTY_NAME
ORDER BY P.PARTY_NAME
]]></xml-property>
