                                                            <row id="53031">
                                                                <cell id="53033">
                                                                    <data id="53134">
                                                                        <property name="resultSetColumn">INDICATORE</property>
                                                                    </data>
                                                                    <data id="53135">
                                                                        <property name="style">fieldLabel-7-italic</property>
                                                                        <property name="resultSetColumn">G_DESCRIPTION</property>
                                                                    </data>
                                                                </cell>
                                                                <cell id="53034">
                                                                    <data id="53136">
                                                                        <property name="resultSetColumn">G_UOM_ABBREVIATION</property>
                                                                    </data>
                                                                </cell>
                                                                <cell id="53035">
                                                                    <text-data id="53137">
                                                                        <property name="fontSize">8pt</property>
                                                                        <property name="paddingTop">0pt</property>
                                                                        <property name="paddingBottom">0pt</property>
                                                                        <property name="textAlign">center</property>
                                                                        <list-property name="visibility"/>
                                                                        <expression name="valueExpr">importPackage(Packages.com.mapsengineering.base.birt.util);&#13;
var atteso =  "";&#13;
var ottenuto = "";&#13;
var attesoRiferimento = row["BUDGET_RIFERIMENTO"] == null ? '' : row["BUDGET_RIFERIMENTO"];&#13;
var ottenutoRiferimento = row["ACTUAL_RIFERIMENTO"] == null ? '' : row["ACTUAL_RIFERIMENTO"];&#13;
&#13;
&#13;
if (row["G_UOM_TYPE_ID"] == 'RATING_SCALE') {&#13;
	var atteso =  row["BUDGET_COD"];&#13;
    var ottenuto = row["ACTUAL_COD"];&#13;
	&#13;
} else if (row["G_UOM_TYPE_ID"] == 'DATE_MEASURE') {&#13;
	ottenuto = UtilDateTime.numberConvertToDate(row["ACTUAL_DATO"], reportContext.getLocale());&#13;
	atteso = UtilDateTime.numberConvertToDate(row["BUDGET_DATO"], reportContext.getLocale());&#13;
} else {&#13;
	ottenuto = row["ACTUAL_DATO"] != null ? Formatter.format(row["FORMAT"].indexOf('%') != -1 ? row["ACTUAL_DATO"]/100 : row["ACTUAL_DATO"], row["FORMAT"]) : '';&#13;
	atteso = row["BUDGET_DATO"] != null ? Formatter.format(row["FORMAT"].indexOf('%') != -1 ? row["BUDGET_DATO"]/100 : row["BUDGET_DATO"], row["FORMAT"]) : '';&#13;
}&#13;
&#13;
if (BirtDateTime.year(params["monitoringDate"].value) &lt;= BirtDateTime.year(row._outer["ESTIMATED_START_DATE1"])) {&#13;
	// mostro atteso&#13;
	atteso == null  ? attesoRiferimento : atteso + "&lt;br>"  + attesoRiferimento;&#13;
} else {&#13;
	// mostro atteso di ottenuto&#13;
	ottenuto == null ? ottenutoRiferimento : ottenuto + "&lt;br>"  + ottenutoRiferimento;&#13;
}</expression>
                                                                        <property name="contentType">html</property>
                                                                    </text-data>
                                                                </cell>
                                                                <cell id="53036">
                                                                    <text-data id="53212">
                                                                        <property name="fontSize">8pt</property>
                                                                        <property name="paddingTop">0pt</property>
                                                                        <property name="paddingBottom">0pt</property>
                                                                        <property name="textAlign">center</property>
                                                                        <list-property name="visibility"/>
                                                                        <expression name="valueExpr">importPackage(Packages.com.mapsengineering.base.birt.util);&#13;
var atteso = "";&#13;
var ottenuto = "";&#13;
var attesoRiferimento = row["BUDGET_RIFERIMENTO_P1"] == null ? '' : row["BUDGET_RIFERIMENTO_P1"];&#13;
var ottenutoRiferimento = row["ACTUAL_RIFERIMENTO_P1"] == null ? '' : row["ACTUAL_RIFERIMENTO_P1"];&#13;
&#13;
if (row["G_UOM_TYPE_ID"] == 'RATING_SCALE') {&#13;
	ottenuto = row["ACTUAL_COD_P1"];&#13;
	atteso = row["BUDGET_COD_P1"];&#13;
} else if (row["G_UOM_TYPE_ID"] == 'DATE_MEASURE') {&#13;
	ottenuto = UtilDateTime.numberConvertToDate(row["ACTUAL_DATO_P1"], reportContext.getLocale());&#13;
	atteso = UtilDateTime.numberConvertToDate(row["BUDGET_DATO_P1"], reportContext.getLocale());&#13;
} else {&#13;
