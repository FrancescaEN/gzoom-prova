            <method name="beforeOpen"><![CDATA[/**/
var dataInizio = this.getInputParameterValue("dataInizio");
var date3112 = com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc(UtilDateTime.getMonthEndFromDatetime('12', reportContext.getTimeZone().getID(), BirtDateTime.year(dataInizio), reportContext.getLocale()), params["odaDialect"].value);
var date3112M1 = com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc(UtilDateTime.getMonthEndFromDatetime('12', reportContext.getTimeZone().getID(), BirtDateTime.year(dataInizio)-1, reportContext.getLocale()), params["odaDialect"].value);
var date0101M1 = com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc(UtilDateTime.getMonthEndFromDatetime('01', reportContext.getTimeZone().getID(), BirtDateTime.year(dataInizio)-1, reportContext.getLocale()), params["odaDialect"].value);


this.queryText = this.queryText.replace("@date3112M1",  date3112M1 );
this.queryText = this.queryText.replace("@date0101M1",  date0101M1 );	

/*
this.queryText = this.queryText.replace("@date3112M1",  "'202-12-31 00:00:00.000'" );
this.queryText = this.queryText.replace("@date0101M1", "'2021-01-01 00:00:00.000'");
*/]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">WORK_EFFORT_ID</property>
                    <property name="nativeName">WORK_EFFORT_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">NOTE_ID</property>
                    <property name="nativeName">NOTE_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">NOTE_INFO</property>
                    <property name="nativeName">NOTE_INFO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">NOTE_NAME</property>
                    <property name="nativeName">NOTE_NAME</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">SEQUENCE_ID</property>
                    <property name="nativeName">SEQUENCE_ID</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">NOTE_DATE_TIME</property>
                    <property name="nativeName">NOTE_DATE_TIME</property>
                    <property name="dataType">date-time</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT WEN.WORK_EFFORT_ID AS "WORK_EFFORT_ID",
ND.NOTE_ID AS "NOTE_ID",
ND.NOTE_INFO AS "NOTE_INFO",
ND.NOTE_NAME AS "NOTE_NAME",
WEN.SEQUENCE_ID AS "SEQUENCE_ID",
ND.NOTE_DATE_TIME AS "NOTE_DATE_TIME"
FROM WORK_EFFORT_NOTE WEN
LEFT OUTER JOIN NOTE_DATA ND ON ND.NOTE_ID = WEN.NOTE_ID 
WHERE WEN.WORK_EFFORT_ID = ?
 AND ND.NOTE_DATE_TIME >= @date0101M1
 AND ND.NOTE_DATE_TIME <= @date3112M1
 AND (WEN.SEQUENCE_ID = '901' OR WEN.SEQUENCE_ID = '902')
ORDER BY ND.NOTE_DATE_TIME DESC , WEN.SEQUENCE_ID
]]></xml-property>
