            <xml-property name="queryText"><![CDATA[SELECT 
		INDIC.G_INPUT_ENUM_ID AS "G_INPUT_ENUM_ID",
		INDIC.G_ACCOUNT_CODE AS "G_ACCOUNT_CODE",
		INDIC.G_ACCOUNT_NAME AS "G_ACCOUNT_NAME",
		INDIC.G_GL_ACCOUNT_TYPE_ID AS "G_GL_ACCOUNT_TYPE_ID",
		INDIC.M_SEQUENCE_ID AS "M_SEQUENCE_ID",
		INDIC.M_WORK_EFFORT_MEASURE_ID AS "M_WORK_EFFORT_MEASURE_ID",		
		INDIC.G_UOM_ABBREVIATION AS "G_UOM_ABBREVIATION",
		INDIC.M_KPI_SCORE_WEIGHT AS "M_KPI_SCORE_WEIGHT",
		INDIC.G_UOM_DECIMAL_SCALE AS "G_UOM_DECIMAL_SCALE",
		INDIC.M_UOM_DESCR AS "M_UOM_DESCR",
		INDIC.M_WE_MEASURE_TYPE_ENUM_ID AS "M_WE_MEASURE_TYPE_ENUM_ID",
		INDIC.G_GL_ACCOUNT_ID AS "G_GL_ACCOUNT_ID",	
		INDIC.G_UOM_TYPE_ID AS "G_UOM_TYPE_ID",
		INDIC.M_THRU_DATE AS "M_THRU_DATE",
		WP.UOM_DESCR AS "UOM_DESCR",
		INDIC.G_DESCRIPTION AS "G_DESCRIPTION",
		GT.DESCRIPTION AS "GT_DESCRIPTION",
	
      SUM(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3112 THEN INDIC.TM_AMOUNT ELSE NULL END)  "BUDGET_DATO",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3112 THEN INDIC.R_UOM_CODE ELSE NULL END)  "BUDGET_COD",	  	   
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3112 THEN INDIC.TT_DESCRIPTION ELSE NULL END) "BUDGET_COMMENTO",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3112 THEN INDIC.TM_DESCRIPTION ELSE NULL END)  "BUDGET_RIFERIMENTO",
	  SUM(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3112 THEN INDIC.TM_AMOUNT ELSE NULL END)  "ACTUAL_DATO",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3112 THEN INDIC.R_UOM_CODE ELSE NULL END)  "ACTUAL_COD",	  	   
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3112 THEN INDIC.TT_DESCRIPTION ELSE NULL END) "ACTUAL_COMMENTO",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3112 THEN INDIC.TM_DESCRIPTION ELSE NULL END)  "ACTUAL_RIFERIMENTO",
	  
	  
	  SUM(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3112P1 THEN INDIC.TM_AMOUNT ELSE NULL END)  "BUDGET_DATO_P1",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3112P1 THEN INDIC.R_UOM_CODE ELSE NULL END)  "BUDGET_COD_P1",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3112P1 THEN INDIC.TT_DESCRIPTION ELSE NULL END) "BUDGET_COMMENTO_P1",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3112P1 THEN INDIC.TM_DESCRIPTION ELSE NULL END)  "BUDGET_RIFERIMENTO_P1",
	  SUM(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3112P1 THEN INDIC.TM_AMOUNT ELSE NULL END)  "ACTUAL_DATO_P1",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3112P1 THEN INDIC.R_UOM_CODE ELSE NULL END)  "ACTUAL_COD_P1",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3112P1 THEN INDIC.TT_DESCRIPTION ELSE NULL END) "ACTUAL_COMMENTO_P1",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3112P1 THEN INDIC.TM_DESCRIPTION ELSE NULL END)  "ACTUAL_RIFERIMENTO_P1",
	   
	  SUM(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3112P2 THEN INDIC.TM_AMOUNT ELSE NULL END)  "BUDGET_DATO_P2",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3112P2 THEN INDIC.R_UOM_CODE ELSE NULL END)  "BUDGET_COD_P2",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3112P2 THEN INDIC.TT_DESCRIPTION ELSE NULL END) "BUDGET_COMMENTO_P2",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3112P2 THEN INDIC.TM_DESCRIPTION ELSE NULL END)  "BUDGET_RIFERIMENTO_P2",
	  SUM(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3112P2 THEN INDIC.TM_AMOUNT ELSE NULL END)  "ACTUAL_DATO_P2",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3112P2 THEN INDIC.R_UOM_CODE ELSE NULL END)  "ACTUAL_COD_P2",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3112P2 THEN INDIC.TT_DESCRIPTION ELSE NULL END) "ACTUAL_COMMENTO_P2",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3112P2 THEN INDIC.TM_DESCRIPTION ELSE NULL END)  "ACTUAL_RIFERIMENTO_P2",
	  
	  SUM(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3112P3 THEN INDIC.TM_AMOUNT ELSE NULL END)  "BUDGET_DATO_P3",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3112P3 THEN INDIC.R_UOM_CODE ELSE NULL END)  "BUDGET_COD_P3",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3112P3 THEN INDIC.TT_DESCRIPTION ELSE NULL END) "BUDGET_COMMENTO_P3",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3112P3 THEN INDIC.TM_DESCRIPTION ELSE NULL END)  "BUDGET_RIFERIMENTO_P3",	   	
	  SUM(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3112P3 THEN INDIC.TM_AMOUNT ELSE NULL END)  "ACTUAL_DATO_P3",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3112P3 THEN INDIC.R_UOM_CODE ELSE NULL END)  "ACTUAL_COD_P3",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3112P3 THEN INDIC.TT_DESCRIPTION ELSE NULL END) "ACTUAL_COMMENTO_P3",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3112P3 THEN INDIC.TM_DESCRIPTION ELSE NULL END) "ACTUAL_RIFERIMENTO_P3",
	  
	  SUM(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3112P4 THEN INDIC.TM_AMOUNT ELSE NULL END)  "BUDGET_DATO_P4",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3112P4 THEN INDIC.R_UOM_CODE ELSE NULL END)  "BUDGET_COD_P4",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3112P4 THEN INDIC.TT_DESCRIPTION ELSE NULL END) "BUDGET_COMMENTO_P4",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3112P4 THEN INDIC.TM_DESCRIPTION ELSE NULL END)  "BUDGET_RIFERIMENTO_P4",	  
	  SUM(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3112P4 THEN INDIC.TM_AMOUNT ELSE NULL END)  "ACTUAL_DATO_P4",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3112P4 THEN INDIC.R_UOM_CODE ELSE NULL END)  "ACTUAL_COD_P4",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3112P4 THEN INDIC.TT_DESCRIPTION ELSE NULL END) "ACTUAL_COMMENTO_P4",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3112P4 THEN INDIC.TM_DESCRIPTION ELSE NULL END)  "ACTUAL_RIFERIMENTO_P4"
	  
	FROM WORK_EFFORT_TRANS_INDIC_VIEW INDIC
	INNER JOIN GL_ACCOUNT_TYPE GT ON GT.GL_ACCOUNT_TYPE_ID = INDIC.G_GL_ACCOUNT_TYPE_ID
	LEFT OUTER JOIN 
	( SELECT WM.GL_ACCOUNT_ID, PR.PRODUCT_ID, WM.UOM_DESCR
		FROM WORK_EFFORT_MEASURE WM
		INNER JOIN PRODUCT PR ON PR.PRODUCT_ID = WM.PRODUCT_ID
		WHERE WM.WORK_EFFORT_ID IS NULL) WP
		ON WP.GL_ACCOUNT_ID = INDIC.M_GL_ACCOUNT_ID AND WP.PRODUCT_ID = INDIC.M_PRODUCT_ID

	WHERE (INDIC.G_GL_ACCOUNT_ID <> 'SCORE' OR INDIC.G_GL_ACCOUNT_ID IS NULL)
		 AND INDIC.G_ACCOUNT_TYPE_ENUM_ID = 'INDICATOR'
		 AND ( INDIC.TM_GL_ACCOUNT_ID <> 'SCOREKPI'	OR INDIC.TM_GL_ACCOUNT_ID IS NULL )	 
		 AND ( @excludePerformanceKPI = 'N' OR ( @excludePerformanceKPI = 'Y' AND INDIC.M_WE_MEASURE_TYPE_ENUM_ID = 'WEMT_PERF'))
		 AND INDIC.M_WORK_EFFORT_ID = ?
   		 AND INDIC.M_THRU_DATE >= ?
	  	 AND INDIC.M_FROM_DATE <= ?
	  	 	
 GROUP BY          	
		INDIC.G_INPUT_ENUM_ID,
		INDIC.G_ACCOUNT_CODE,
		INDIC.G_ACCOUNT_NAME,
		INDIC.G_GL_ACCOUNT_TYPE_ID,
		INDIC.M_SEQUENCE_ID,
		INDIC.M_WORK_EFFORT_MEASURE_ID,		
		INDIC.G_UOM_ABBREVIATION,
		INDIC.M_KPI_SCORE_WEIGHT,
		INDIC.G_UOM_DECIMAL_SCALE,
		INDIC.M_UOM_DESCR,
		INDIC.M_WE_MEASURE_TYPE_ENUM_ID,
		INDIC.G_GL_ACCOUNT_ID,	
		INDIC.G_UOM_TYPE_ID,
		INDIC.M_THRU_DATE,
		WP.UOM_DESCR,
		INDIC.G_DESCRIPTION,
		GT.DESCRIPTION

ORDER BY
		INDIC.G_ACCOUNT_CODE,
  		INDIC.G_GL_ACCOUNT_ID ,
  		INDIC.M_WORK_EFFORT_MEASURE_ID
]]></xml-property>
