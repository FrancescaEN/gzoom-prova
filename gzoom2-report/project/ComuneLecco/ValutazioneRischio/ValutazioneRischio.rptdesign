            <method name="beforeOpen"><![CDATA[//@workEffortIdChild
var workEffortIdChildString = '';
if (params["workEffortIdChild"].value != null &amp;&amp; params["workEffortIdChild"].value != '') {
	/**/workEffortIdChildString = "AND ( OB1.WORK_EFFORT_ID = '"+ params["workEffortIdChild"].value 
		+ "' OR OB2.WORK_EFFORT_ID = '" + params["workEffortIdChild"].value +"')";	
}
this.queryText = this.queryText.replace("@workEffortIdChild",  workEffortIdChildString );

//@workEffortId
var workEffortIdString = '';
if (params["workEffortId"].value != null &amp;&amp; params["workEffortId"].value != '') {
	workEffortIdString = "AND RAD.WORK_EFFORT_ID = '"+ params["workEffortId"].value + "'";	
}
this.queryText = this.queryText.replace("@workEffortId",  workEffortIdString );

//@orgUnitIdÌ
var orgUnitIdString = '';
/**/ if (params["orgUnitId"].value != null &amp;&amp; params["orgUnitId"].value != '') {
	orgUnitIdString = "AND (FIL_W.ORG_UNIT_ID = '"+ params["orgUnitId"].value + "' or FIL_W.ORG_UNIT_ID in ( select " +
			"stf.party_id " +
			"from PARTY uo "+
			"left join PARTY_PARENT_ROLE ppruo ON ppruo.PARTY_ID = uo.PARTY_ID  AND ppruo.ROLE_TYPE_ID = 'ORGANIZATION_UNIT' "+
			"inner join party_role pr on pr.party_id = uo.PARTY_ID and pr.role_type_id = 'DIR' "+
			"left join party_relationship rel on rel.party_id_from = uo.party_id and rel.party_relationship_type_id = 'GROUP_ROLLUP' "+
			"left join party_parent_role pprsf on pprsf.party_id = rel.party_id_to and pprsf.role_type_id <> 'INTERNAL_ORGANIZATIO' "+
			"left join party stf on stf.party_id = rel.party_id_to "+
			"where uo.party_id = '"+ params["orgUnitId"].value + "' "+
			") "+
		 " )";	
} 
this.queryText = this.queryText.replace("@orgUnitId",  orgUnitIdString );

//AGGIUNGO PARAMETRI PER GESTIRE IL BILINGUISMO
//estraggo la descrizione corretta agg. _LANG se è la seconda, 
//altrimenti aggiungerà solo una stringa vuota
this.queryText = this.queryText.replace("@langLocale",  params["langLocale"].value);
/*	*/
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value );
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );	
									
/* 
this.queryText = this.queryText.replace("@date0101",  "'2020-01-01 00:00:00.000'" );
this.queryText = this.queryText.replace("@date3112",  "'2020-12-31 00:00:00.000'" );
*/
//GESTIRE PERMESSI
/*  */
filter = new com.mapsengineering.base.birt.util.UtilFilter(params["userLoginId"].value, params["localDispatcherName"].value);
var filterInnerJoin = filter.getWorkEffortFilterInner();
var filterLeftJoin = filter.getWorkEffortFilterLeftJoin();
var filterWhere = filter.getWorkEffortFilterWhere();
  
/* 
var filterInnerJoin = "";
var filterLeftJoin = "";
var filterWhere = "";
*/
this.queryText = this.queryText.replace("@filterInnerJoin",  filterInnerJoin );
this.queryText = this.queryText.replace("@filterLeftJoin",  filterLeftJoin );
this.queryText = this.queryText.replace("@filterWhere",  filterWhere );


/*ReportLog.info("......this.queryText"+this.queryText);

ReportLog.info("Parmas "+ this.getInputParameters());*/
]]></method>
