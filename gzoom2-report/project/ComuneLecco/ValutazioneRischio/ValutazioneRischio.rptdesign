            <xml-property name="queryText"><![CDATA[SELECT  
	RAD.WORK_EFFORT_ID AS "WORK_EFFORT_ID0",
	RADTC.ETCH@langLocale AS "RAD_TITOLO",
	
	OB1.WORK_EFFORT_ID AS "WORK_EFFORT_ID1",
	OB1.ETCH AS "ETCH1",
	OB1A.SEQUENCE_NUM AS "SEQUENCE_NUM1",
	OB1A.ASSOC_WEIGHT AS "ASSOC_WEIGHT1", 
	OB1.SOURCE_REFERENCE_ID AS "SOURCE_REFERENCE_ID1",
	  
	-- ELEMENTI DIFFERENTI X IL BILINGUISMO
	OB1T.ETCH@langLocale AS "ETCH_TYPE1", 
	OB1.WORK_EFFORT_NAME@langLocale AS "WORK_EFFORT_NAME1",
	OB1.DESCRIPTION@langLocale AS "DESCRIPTION1",
	      
	OB2.WORK_EFFORT_ID AS "WORK_EFFORT_ID2",
	OB2.ETCH AS "ETCH2",
	OB2A.SEQUENCE_NUM AS "SEQUENCE_NUM2",
	OB2A.ASSOC_WEIGHT AS "ASSOC_WEIGHT2", 
	OB2.SOURCE_REFERENCE_ID AS "SOURCE_REFERENCE_ID2",
	
	-- ELEMENTI DIFFERENTI X IL BILINGUISMO
	OB2T.ETCH@langLocale AS "ETCH_TYPE2", 
	OB2.WORK_EFFORT_NAME@langLocale AS "WORK_EFFORT_NAME2",
	OB2.DESCRIPTION@langLocale AS "DESCRIPTION2",

	FIL_W.WORK_EFFORT_ID AS "WORK_EFFORT_ID3",
	FIL_W.ETCH AS "ETCH3",
	OB3A.SEQUENCE_NUM AS "SEQUENCE_NUM3",
	OB3A.ASSOC_WEIGHT AS "ASSOC_WEIGHT3", 
	FIL_W.SOURCE_REFERENCE_ID AS "SOURCE_REFERENCE_ID3",
	
	-- ELEMENTI DIFFERENTI X IL BILINGUISMO
	OB3T.ETCH@langLocale AS "ETCH_TYPE3", 
	FIL_W.WORK_EFFORT_NAME@langLocale AS "WORK_EFFORT_NAME3",
	FIL_W.DESCRIPTION@langLocale AS "DESCRIPTION3",  
	
	SC.PARENT_ROLE_CODE AS "SC_PARENT_ROLE_CODE", 
	ST.PARTY_NAME@langLocale AS "ST_PARTY_NAME",
	
	-- indicatori	  
	MAX(CASE WHEN AC.GL_RESOURCE_TYPE_ID = 'RISS' AND AC.ACCOUNT_CODE LIKE '%1.1%' THEN RI.AMOUNT ELSE NULL END)  "PROB_AMOUNT_1",
	MAX(CASE WHEN AC.GL_RESOURCE_TYPE_ID = 'RISS' AND AC.ACCOUNT_CODE LIKE '%2.1%' THEN RI.AMOUNT ELSE NULL END)  "IMP_AMOUNT_1", 
	MAX(CASE WHEN AC.GL_RESOURCE_TYPE_ID = 'RISS' AND AC.ACCOUNT_CODE LIKE '%3.1%' THEN RI.AMOUNT ELSE NULL END)  "TOT_RISC_POT", 
	MAX(CASE WHEN AC.GL_RESOURCE_TYPE_ID = 'RISS' AND AC.ACCOUNT_CODE LIKE '%4.1%' THEN RI.AMOUNT ELSE NULL END)  "GRAD_RISC_GIUD",
	
	-- SCORE
	MAX(CASE WHEN RP.GL_FISCAL_TYPE_ID = 'CORRIS' THEN RI.AMOUNT ELSE NULL END) "RIS_AMOUNT_SCORE",
	MAX(CASE WHEN RP.GL_FISCAL_TYPE_ID = 'CORRIS' THEN VP.COMMENTS@langLocale ELSE NULL END) "RIS_COMMENTS_SCORE",
	MAX(CASE WHEN RP.GL_FISCAL_TYPE_ID = 'CORRIS' THEN EP.OBJECT_INFO ELSE NULL END) "RIS_OBJECT_INFO_SCORE",
	MAX(CASE WHEN RP.GL_FISCAL_TYPE_ID = 'CORRIS' THEN VP.UOM_RANGE_ID ELSE NULL END) "RIS_UOM_RANGE_ID",
	MAX(CASE WHEN RP.GL_FISCAL_TYPE_ID = 'CORRIS' THEN VP.UOM_RANGE_VALUES_ID ELSE NULL END) "RIS_UOM_RANGE_VALUES_ID",
	MAX(CASE WHEN RP.GL_FISCAL_TYPE_ID = 'CORRIS' THEN UOM.DECIMAL_SCALE ELSE NULL END) "RIS_DECIMAL_SCALE",
	MAX(CASE WHEN RP.GL_FISCAL_TYPE_ID = 'CORRIS' THEN UOM.ABBREVIATION@langLocale ELSE NULL END) "RIS_ABBREVIATION",
	
	MAX(CASE WHEN RP.GL_FISCAL_TYPE_ID = 'CORCON' THEN RI.AMOUNT ELSE NULL END) "CON_AMOUNT_SCORE",
	MAX(CASE WHEN RP.GL_FISCAL_TYPE_ID = 'CORCON' THEN VP.COMMENTS@langLocale ELSE NULL END) "CON_COMMENTS_SCORE",
	MAX(CASE WHEN RP.GL_FISCAL_TYPE_ID = 'CORCON' THEN EP.OBJECT_INFO ELSE NULL END) "CON_OBJECT_INFO_SCORE",
	MAX(CASE WHEN RP.GL_FISCAL_TYPE_ID = 'CORCON' THEN VP.UOM_RANGE_ID ELSE NULL END) "CON_UOM_RANGE_ID",
	MAX(CASE WHEN RP.GL_FISCAL_TYPE_ID = 'CORCON' THEN VP.UOM_RANGE_VALUES_ID ELSE NULL END) "CON_UOM_RANGE_VALUES_ID",
	MAX(CASE WHEN RP.GL_FISCAL_TYPE_ID = 'CORCON' THEN UOM.DECIMAL_SCALE ELSE NULL END) "CON_DECIMAL_SCALE",
	MAX(CASE WHEN RP.GL_FISCAL_TYPE_ID = 'CORCON' THEN UOM.ABBREVIATION@langLocale ELSE NULL END) "CON_ABBREVIATION"
		
FROM WORK_EFFORT RAD		

INNER JOIN WORK_EFFORT_TYPE RADT ON RADT.WORK_EFFORT_TYPE_ID = RAD.WORK_EFFORT_TYPE_ID
INNER JOIN WORK_EFFORT_TYPE_CONTENT RADTC ON RADTC.WORK_EFFORT_TYPE_ID = RAD.WORK_EFFORT_TYPE_ID
	AND RADTC.CONTENT_ID = ?

-- area																									
INNER JOIN WORK_EFFORT_ASSOC OB1A ON OB1A.WORK_EFFORT_ID_FROM = RAD.WORK_EFFORT_ID																											
	AND OB1A.WORK_EFFORT_ASSOC_TYPE_ID = RADT.hierarchy_assoc_type_id																										
INNER JOIN WORK_EFFORT OB1 ON OB1.WORK_EFFORT_ID = OB1A.WORK_EFFORT_ID_TO
	AND (? = 'Y' OR (? = 'N' AND OB1.ESTIMATED_START_DATE <= @date3112 AND OB1.ESTIMATED_COMPLETION_DATE >= @date0101))	
	AND OB1.WORK_EFFORT_REVISION_ID IS NULL 
INNER JOIN WORK_EFFORT_TYPE OB1T ON OB1T.WORK_EFFORT_TYPE_ID = OB1.WORK_EFFORT_TYPE_ID		

-- sottoarea
INNER JOIN WORK_EFFORT_ASSOC OB2A ON OB2A.WORK_EFFORT_ID_FROM = OB1.WORK_EFFORT_ID																											
	AND OB2A.WORK_EFFORT_ASSOC_TYPE_ID = OB1T.WORK_EFFORT_ASSOC_TYPE_ID
INNER JOIN WORK_EFFORT OB2 ON OB2.WORK_EFFORT_ID = OB2A.WORK_EFFORT_ID_TO
	AND (? = 'Y' OR (? = 'N' AND OB2.ESTIMATED_START_DATE <= @date3112 AND OB2.ESTIMATED_COMPLETION_DATE >= @date0101)) AND OB2.WORK_EFFORT_REVISION_ID IS NULL 																										
INNER JOIN WORK_EFFORT_TYPE OB2T ON OB2T.WORK_EFFORT_TYPE_ID = OB2.WORK_EFFORT_TYPE_ID

-- processo																										
INNER JOIN WORK_EFFORT_ASSOC OB3A ON OB3A.WORK_EFFORT_ID_FROM = OB2.WORK_EFFORT_ID																											
	AND OB3A.WORK_EFFORT_ASSOC_TYPE_ID = OB2T.WORK_EFFORT_ASSOC_TYPE_ID	
INNER JOIN WORK_EFFORT FIL_W ON FIL_W.WORK_EFFORT_ID = OB3A.WORK_EFFORT_ID_TO
	AND (? = 'Y' OR (? = 'N' AND FIL_W.ESTIMATED_START_DATE <= @date3112 AND FIL_W.ESTIMATED_COMPLETION_DATE >= @date0101))	AND FIL_W.WORK_EFFORT_REVISION_ID IS NULL 																										
INNER JOIN WORK_EFFORT_TYPE OB3T ON OB3T.WORK_EFFORT_TYPE_ID = FIL_W.WORK_EFFORT_TYPE_ID																										

INNER JOIN PARTY ST ON  ST.PARTY_ID = FIL_W.ORG_UNIT_ID 
INNER JOIN PARTY_PARENT_ROLE SC ON SC.PARTY_ID = ST.PARTY_ID  AND SC.ROLE_TYPE_ID = 'ORGANIZATION_UNIT'

@filterInnerJoin
@filterLeftJoin

-- VADO A PRENDERE GLI INDICATORI
LEFT JOIN WORK_EFFORT_MEASURE WI ON WI.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID AND WI.FROM_DATE <= @date3112 AND WI.THRU_DATE >= @date0101 
	-- AND WI.WE_MEASURE_TYPE_ENUM_ID <> 'WEMT_SCORE'
LEFT JOIN GL_ACCOUNT AC ON AC.GL_ACCOUNT_ID = WI.GL_ACCOUNT_ID
LEFT JOIN UOM UOM ON AC.DEFAULT_UOM_ID = UOM.UOM_ID
																					
LEFT JOIN (																																				
	SELECT TP.VOUCHER_REF, TP.TRANSACTION_DATE, EP.AMOUNT																																			
	FROM ACCTG_TRANS TP																																			
		INNER JOIN ACCTG_TRANS_ENTRY EP ON EP.ACCTG_TRANS_ID = TP.ACCTG_TRANS_ID																																		
	WHERE EP.GL_ACCOUNT_ID <> 'SCOREKPI'																																		
	) RI ON RI.VOUCHER_REF = WI.WORK_EFFORT_MEASURE_ID AND RI.TRANSACTION_DATE = @date3112    
																																				

-- VADO A PRENDERE LO SCORE
LEFT JOIN (																											
	SELECT TP.VOUCHER_REF, TP.TRANSACTION_DATE, EP.AMOUNT, EP.GL_FISCAL_TYPE_ID																										
	FROM ACCTG_TRANS TP																										
		INNER JOIN ACCTG_TRANS_ENTRY EP ON EP.ACCTG_TRANS_ID = TP.ACCTG_TRANS_ID																									
	WHERE EP.GL_ACCOUNT_ID = 'SCORE' AND (EP.GL_FISCAL_TYPE_ID = 'CORRIS' OR EP.GL_FISCAL_TYPE_ID = 'CORCON' )																										
	) RP ON RP.VOUCHER_REF = WI.WORK_EFFORT_MEASURE_ID  AND RP.TRANSACTION_DATE = @date3112																									
LEFT JOIN UOM_RANGE_VALUES VP ON VP.UOM_RANGE_ID = OB3T.UOM_RANGE_SCORE_ID																											
		AND VP.FROM_VALUE <= RP.AMOUNT AND VP.THRU_VALUE >= RP.AMOUNT		
LEFT JOIN ENUMERATION CP ON CP.ENUM_ID = VP.COLOR_ENUM_ID																											
LEFT JOIN CONTENT IP ON IP.CONTENT_ID = VP.ICON_CONTENT_ID																											
LEFT JOIN DATA_RESOURCE EP ON EP.DATA_RESOURCE_ID = IP.DATA_RESOURCE_ID	
																										
WHERE 0=0
	 @workEffortIdChild
	 @workEffortId
	 @orgUnitId
	 @filterWhere
	
GROUP BY
	RADTC.ETCH@langLocale, RAD.WORK_EFFORT_ID,
	OB1.WORK_EFFORT_ID, OB1T.ETCH@langLocale, OB1.ETCH, OB1.WORK_EFFORT_NAME@langLocale, OB1A.SEQUENCE_NUM, OB1.DESCRIPTION@langLocale, OB1A.ASSOC_WEIGHT, OB1.SOURCE_REFERENCE_ID,        
	OB2.WORK_EFFORT_ID, OB2T.ETCH@langLocale, OB2.ETCH, OB2.WORK_EFFORT_NAME@langLocale, OB2A.SEQUENCE_NUM, OB2.DESCRIPTION@langLocale, OB2A.ASSOC_WEIGHT, OB2.SOURCE_REFERENCE_ID,  
	FIL_W.WORK_EFFORT_ID, OB3T.ETCH@langLocale, FIL_W.ETCH, FIL_W.WORK_EFFORT_NAME@langLocale, OB3A.SEQUENCE_NUM, FIL_W.DESCRIPTION@langLocale, OB3A.ASSOC_WEIGHT, FIL_W.SOURCE_REFERENCE_ID,	
	SC.PARENT_ROLE_CODE, ST.PARTY_NAME@langLocale																					]]></xml-property>
