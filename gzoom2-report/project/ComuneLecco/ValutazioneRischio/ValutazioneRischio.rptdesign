]]></method>
    <method name="beforeFactory"><![CDATA[function dropElement(name) {
	var element = reportContext.getDesignHandle().findElement(name);
	element.drop();
}

// Tabella degli indetificativi
if (params["reportContentId"].value != 'REPORT_RISVALU') {
	dropElement("tbValutazione");
} 

// Tabella degli indetificativi
if (params["reportContentId"].value != 'REPORT_RIPRITRATT') {
	dropElement("tbPriorita");
}  
]]></method>
