            <method name="beforeOpen"><![CDATA[/* */
this.queryText = this.queryText.replace("@excludeValidity", "'" + params["excludeValidity"].value+ "'");
this.queryText = this.queryText.replace("@reportContentId", "'" + params["reportContentId"].value+ "'");
this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value );
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );
this.queryText = this.queryText.replace("@workEffortId",  "'" + params["workEffortId"].value+ "'" );
this.queryText = this.queryText.replace("@partyId",  "'" + params["partyId"].value+ "'" );
this.queryText = this.queryText.replace("@orgUnitId",  "'" + params["orgUnitId"].value+ "'" );
this.queryText = this.queryText.replace("@workEffortChild",  "'" + params["workEffortIdChild"].value+ "'" );
this.queryText = this.queryText.replace("@workEffortTypeId",  "'" + params["workEffortTypeId"].value+ "'" );


/*
this.queryText = this.queryText.replace("@excludeValidity",  "'N'" );
