            <xml-property name="queryText"><![CDATA[ SELECT 
 	RADTC.ETCH AS "RAD_TITOLO",
 	T_OB1.ETCH AS "ETICHETTA1",
 	T_OB2.ETCH AS "ETICHETTA2",
 	A_OB1.SEQUENCE_NUM AS "A_OB1_SEQUENCE_NUM",
 	OB1.ETCH AS "AREA1",
 	OB1.WORK_EFFORT_NAME  AS "AREA",
 	A_OB2.SEQUENCE_NUM AS "A_OB2_SEQUENCE_NUM",
 	FIL_W.ETCH AS "OBIETTIVO_ETCH",
 	FIL_W.WORK_EFFORT_NAME AS "OBIETTIVO_NAME",
	RAD.WORK_EFFORT_NAME AS "TITOLO_RADICE",
	P_E.PARTY_NAME AS "NOME_ENTE",
  	P_RES_A.PARTY_NAME AS "RESPONSABILE_AREA",
  	OB1.SOURCE_REFERENCE_ID AS "OB1_SOURCE_REFERENCE_ID",
 	OB1.WORK_EFFORT_ID AS "OB1_WORK_EFFORT_ID",
 	FIL_W.SOURCE_REFERENCE_ID AS "OB2_SOURCE_REFERENCE_ID",
 	FIL_W.WORK_EFFORT_ID AS "OB2_WORK_EFFORT_ID",
	RAD.ESTIMATED_START_DATE AS "ESTIMATED_START_DATE",
	RAD.ESTIMATED_COMPLETION_DATE AS "ESTIMATED_COMPLETION_DATE",
	FIL_W.ORG_UNIT_ID AS "OB2_ORG_UNIT_ID",
	
	T_OB1.UOM_RANGE_SCORE_ID AS "FASCETACHIMETRO1",
	T_OB2.UOM_RANGE_SCORE_ID AS "FASCETACHIMETRO2",
	
	-- PUNTEGGIO
	MAX(CASE WHEN I2.GL_FISCAL_TYPE_ID = 'ACTUAL' AND I2.TRANSACTION_DATE = @monitoringDate THEN I2.AMOUNT ELSE NULL END) AS "ACTUAL_OB2",
	MAX(CASE WHEN I1.GL_FISCAL_TYPE_ID = 'ACTUAL' AND I1.TRANSACTION_DATE = @monitoringDate THEN I1.AMOUNT ELSE NULL END) AS "ACTUAL_OB1",
	MAX(CASE WHEN I2.GL_FISCAL_TYPE_ID = 'SALFAS' AND I2.TRANSACTION_DATE = @monitoringDate THEN I2.AMOUNT ELSE NULL END) AS "SALFAS_OB2",
	MAX(CASE WHEN I1.GL_FISCAL_TYPE_ID = 'SALFAS' AND I1.TRANSACTION_DATE = @monitoringDate THEN I1.AMOUNT ELSE NULL END) AS "SALFAS_OB1"
 	
FROM WORK_EFFORT_TYPE T_RAD
JOIN WORK_EFFORT RAD
ON   T_RAD.WORK_EFFORT_TYPE_ID = RAD.WORK_EFFORT_TYPE_ID
AND  T_RAD.IS_ROOT = 'Y'
AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND( RAD.ESTIMATED_START_DATE <= @date3112 AND RAD.ESTIMATED_COMPLETION_DATE >= @date0101 ))) 
INNER JOIN WORK_EFFORT_TYPE_CONTENT RADTC ON RADTC.WORK_EFFORT_TYPE_ID = RAD.WORK_EFFORT_TYPE_ID
		AND RADTC.CONTENT_ID = @reportContentId

JOIN WORK_EFFORT_ASSOC A_OB1 
     ON  A_OB1.WORK_EFFORT_ID_FROM = RAD.WORK_EFFORT_ID

JOIN WORK_EFFORT_ASSOC_TYPE TA_OB1 ON TA_OB1.WORK_EFFORT_ASSOC_TYPE_ID = A_OB1.WORK_EFFORT_ASSOC_TYPE_ID
JOIN WORK_EFFORT OB1
     ON  A_OB1.WORK_EFFORT_ID_TO = OB1.WORK_EFFORT_ID
     AND  (A_OB1.THRU_DATE = OB1.ESTIMATED_COMPLETION_DATE OR
           A_OB1.THRU_DATE = RAD.ESTIMATED_COMPLETION_DATE)
AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND( OB1.ESTIMATED_START_DATE <= @date3112 AND OB1.ESTIMATED_COMPLETION_DATE >= @date0101 )))

JOIN WORK_EFFORT_TYPE  T_OB1
     ON  T_OB1.WORK_EFFORT_TYPE_ID = OB1.WORK_EFFORT_TYPE_ID

JOIN WORK_EFFORT_ASSOC A_OB2 
     ON  A_OB2.WORK_EFFORT_ID_FROM = OB1.WORK_EFFORT_ID

JOIN WORK_EFFORT_ASSOC_TYPE TA_OB2 ON TA_OB2.WORK_EFFORT_ASSOC_TYPE_ID = A_OB2.WORK_EFFORT_ASSOC_TYPE_ID    
JOIN WORK_EFFORT FIL_W
     ON  A_OB2.WORK_EFFORT_ID_TO = FIL_W.WORK_EFFORT_ID
     AND  (A_OB2.THRU_DATE = OB1.ESTIMATED_COMPLETION_DATE OR
           A_OB2.THRU_DATE = FIL_W.ESTIMATED_COMPLETION_DATE)
AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND( FIL_W.ESTIMATED_START_DATE <= @date3112 AND  FIL_W.ESTIMATED_COMPLETION_DATE >= @date0101 )))

JOIN WORK_EFFORT_TYPE  T_OB2 
     ON  T_OB2.WORK_EFFORT_TYPE_ID = FIL_W.WORK_EFFORT_TYPE_ID
     
JOIN PARTY P_E    
     ON P_E.PARTY_ID  = RAD.ORGANIZATION_ID    
@filterInnerJoin
@filterLeftJoin     
     
LEFT OUTER JOIN PARTY_RELATIONSHIP PR_RES_A
     ON  PR_RES_A.PARTY_ID_FROM = OB1.ORG_UNIT_ID
     AND PR_RES_A.ROLE_TYPE_ID_FROM = OB1.ORG_UNIT_ROLE_TYPE_ID
     AND PR_RES_A.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
AND (@excludeValidity = 'N' OR (@excludeValidity = 'Y' AND PR_RES_A.THRU_DATE IS NULL))
AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND(PR_RES_A.FROM_DATE <= @monitoringDate AND (PR_RES_A.THRU_DATE >= @monitoringDate OR PR_RES_A.THRU_DATE IS NULL)  )))

LEFT OUTER JOIN PARTY  P_RES_A
     ON P_RES_A.PARTY_ID = PR_RES_A.PARTY_ID_TO
LEFT OUTER JOIN PARTY_RELATIONSHIP PR_RES_C
     ON  PR_RES_C.PARTY_ID_FROM = FIL_W.ORG_UNIT_ID
     AND PR_RES_C.ROLE_TYPE_ID_FROM = FIL_W.ORG_UNIT_ROLE_TYPE_ID
     AND PR_RES_C.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
AND (@excludeValidity = 'N' OR (@excludeValidity = 'Y' AND(PR_RES_C.THRU_DATE IS NULL)))
AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND( PR_RES_C.FROM_DATE <= @monitoringDate AND (PR_RES_C.THRU_DATE >= @monitoringDate OR PR_RES_C.THRU_DATE IS NULL) )))

LEFT OUTER JOIN PARTY  P_RES_C
     ON P_RES_C.PARTY_ID = PR_RES_C.PARTY_ID_TO


-- PUNTEGGIO OBIETTIVO
	LEFT OUTER JOIN (
		  SELECT Q2.WORK_EFFORT_ID, Q2.TRANSACTION_DATE, R2.AMOUNT, R2.GL_FISCAL_TYPE_ID, R2.HAS_SCORE_ALERT, R2.DESCRIPTION
		  FROM ACCTG_TRANS Q2 
		  INNER JOIN ACCTG_TRANS_ENTRY R2 ON Q2.ACCTG_TRANS_ID = R2.ACCTG_TRANS_ID
		  WHERE R2.GL_ACCOUNT_ID = 'SCORE' 
			AND Q2.TRANSACTION_DATE = @monitoringDate
			-- AND (R3.GL_FISCAL_TYPE_ID = 'ACTUAL')
					 ) I2 ON I2.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID 
					 
-- PUNTEGGIO AREA 
	LEFT OUTER JOIN (
		  SELECT Q1.WORK_EFFORT_ID, Q1.TRANSACTION_DATE, R1.AMOUNT, R1.GL_FISCAL_TYPE_ID, R1.HAS_SCORE_ALERT, Q1.DESCRIPTION
		  FROM ACCTG_TRANS Q1 
		  INNER JOIN ACCTG_TRANS_ENTRY R1 ON Q1.ACCTG_TRANS_ID = R1.ACCTG_TRANS_ID
		  WHERE R1.GL_ACCOUNT_ID = 'SCORE' 
			AND Q1.TRANSACTION_DATE = @monitoringDate
			-- AND (R1.GL_FISCAL_TYPE_ID = 'ACTUAL')
					 ) I1 ON I1.WORK_EFFORT_ID = OB1.WORK_EFFORT_ID
						 	 
WHERE  (@workEffortId IS NULL OR @workEffortId = '' OR RAD.WORK_EFFORT_ID = @workEffortId )
		AND (@partyId IS NULL OR @partyId = '' OR P_RES_A.PARTY_ID = @partyId)
		AND (@orgUnitId IS NULL OR @orgUnitId = '' OR OB1.ORG_UNIT_ID = @orgUnitId OR FIL_W.ORG_UNIT_ID = @orgUnitId )         
        AND (@workEffortChild IS NULL OR @workEffortChild = '' OR OB1.WORK_EFFORT_ID = @workEffortChild OR FIL_W.WORK_EFFORT_ID = @workEffortChild)
	    AND (? IS NULL OR ? = '' OR FIL_W.WORK_EFFORT_ID = ? )
	    AND ( T_OB2.CODE_PREFIX LIKE 'O%' OR T_OB2.CODE_PREFIX LIKE 'A%' )
		AND ( T_OB2.CODE_PREFIX LIKE ? )
		AND (RAD.WORK_EFFORT_TYPE_ID = @workEffortTypeId OR OB1.WORK_EFFORT_TYPE_ID = @workEffortTypeId OR FIL_W.WORK_EFFORT_TYPE_ID = @workEffortTypeId)
		
		AND ((RAD.WEIGHT_SONS > 0 AND TA_OB1.PARENT_TYPE_ID = 'HIE'
        	AND OB1.WORK_EFFORT_PARENT_ID = RAD.WORK_EFFORT_PARENT_ID)
			    OR (RAD.WEIGHT_ASSOC_WORK_EFFORT > 0 AND A_OB1.WORK_EFFORT_ASSOC_TYPE_ID = RAD.WORK_EFFORT_ASSOC_TYPE_ID))
    
	    AND ((OB1.WEIGHT_SONS > 0 AND TA_OB2.PARENT_TYPE_ID = 'HIE'
               AND FIL_W.WORK_EFFORT_PARENT_ID = OB1.WORK_EFFORT_PARENT_ID)
		    OR (OB1.WEIGHT_ASSOC_WORK_EFFORT > 0 AND A_OB2.WORK_EFFORT_ASSOC_TYPE_ID = OB1.WORK_EFFORT_ASSOC_TYPE_ID))
    
		-- FILTRI PER ESCLUDERE I DATI STORICI
	AND RAD.WORK_EFFORT_REVISION_ID IS NULL
	AND OB1.WORK_EFFORT_REVISION_ID IS NULL
	AND FIL_W.WORK_EFFORT_REVISION_ID IS NULL
	@filterWhere
	  
GROUP BY 
	RADTC.ETCH,
	T_OB1.ETCH,
 	T_OB2.ETCH,
 	A_OB1.SEQUENCE_NUM,
 	OB1.ETCH,
 	OB1.WORK_EFFORT_NAME,
 	A_OB2.SEQUENCE_NUM, 
 	FIL_W.ETCH,
 	FIL_W.WORK_EFFORT_NAME,  	
	RAD.WORK_EFFORT_NAME,
	P_E.PARTY_NAME,
  	P_RES_A.PARTY_NAME,  
  	OB1.SOURCE_REFERENCE_ID,
 	OB1.WORK_EFFORT_ID, 	
 	FIL_W.SOURCE_REFERENCE_ID,
 	FIL_W.WORK_EFFORT_ID,
	RAD.ESTIMATED_START_DATE,
	RAD.ESTIMATED_COMPLETION_DATE,
	FIL_W.ORG_UNIT_ID,
	T_OB1.UOM_RANGE_SCORE_ID,
	T_OB2.UOM_RANGE_SCORE_ID
	

ORDER BY  
 A_OB1.SEQUENCE_NUM    , 
 OB1.SOURCE_REFERENCE_ID ,
 OB1.WORK_EFFORT_ID,  
 A_OB2.SEQUENCE_NUM    , 
 FIL_W.SOURCE_REFERENCE_ID ,
 FIL_W.WORK_EFFORT_ID
 ]]></xml-property>
            <xml-property name="designerValues"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<model:DesignValues xmlns:design="http://www.eclipse.org/datatools/connectivity/oda/design" xmlns:model="http://www.eclipse.org/birt/report/model/adapter/odaModel">
  <Version>2.0</Version>
