	<parameter name="date3009" class="java.util.Date" isForPrompting="false"/>
	<parameter name="date3009sql" class="java.lang.String" isForPrompting="false"/>
	<parameter name="exposePaginator" class="java.lang.String" isForPrompting="false"/>
	<parameter name="YEAR" class="java.lang.String"/>
	<parameter name="idProcesso" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select
CONCAT (PROGMIS.WE_FROM_etch,' ',progmis.we_from_name) as "Missione",
concat (procprog.we_from_etch,' ',procprog.we_from_name) as "Programma",
wenv.note_info as "Descrizione Programma"
from work_effort mcp
join work_effort_assoc_view macpro on macpro.we_from_id=mcp.work_effort_id and macpro.we_ass_type_id ='24MPORG' and macpro.we_to_type_id='24M08' and macpro.wa_from_date<= $P{date3112}  and macpro.wa_thru_date>= $P{date0101} 
left join work_effort_assoc_view procprog on procprog.we_to_id = macpro.we_to_id and procprog.we_from_type_id='15B2PRO' and procprog.wa_from_date<= $P{date3112}  and procprog.wa_thru_date>= $P{date0101} 
left join work_effort_assoc_view progmis on progmis.we_to_id=procprog.we_from_id and progmis.we_from_type_id='15B1MIS' and progmis.wa_from_date<= $P{date3112}  and progmis.wa_thru_date>= $P{date0101} 
left join work_effort_note_view wenv on wenv.work_effort_id=procprog.we_from_id and wenv.sequence_id='1' and wenv.is_main='Y'
where mcp.work_effort_type_id='24MP07'
and macpro.we_to_id= $P{idProcesso}]]>
	</queryString>
