	<queryString language="SQL">
		<![CDATA[select
    indic.description as "Dimensione",
    indic.classe as "Tipologia indicatore",
    indic.account_name as "Titolo dato di attività / di contesto",
    indic.source as "Fonte dei dati",
    indic.description2 as "Periodicità di rilevazione",
    indic.g_uom_abbreviation as "UdM",
    indic.actual_3 as "Effettivo -3",
    indic.actual_2 as "Effettivo -2",
    indic.actual_1 as "Effettivo -1",
    (coalesce(indic.actual_3, 0) + coalesce(indic.actual_2, 0) + coalesce(indic.actual_1, 0)) / 
    nullif(3 - (case when indic.actual_3 is null then 1 else 0 end + 
                case when indic.actual_2 is null then 1 else 0 end + 
                case when indic.actual_1 is null then 1 else 0 end), 0) 
    as "Media triennio prec.",
    indic.budget as "Previsto",
    indic.actual as "Effettivo",
    (indic.actual - indic.budget) as "Differenza  Effett.-Prev.",
    indic.actual / nullif(
        (coalesce(indic.actual_3, 0) + coalesce(indic.actual_2, 0) + coalesce(indic.actual_1, 0)) / 
        nullif(3 - (case when indic.actual_3 is null then 1 else 0 end + 
                    case when indic.actual_2 is null then 1 else 0 end + 
                    case when indic.actual_1 is null then 1 else 0 end), 0), 
        0
    ) as "Trend eff./media tr. p.",
    (indic.actual / nullif(indic.budget, 0)) * 100 as "% Effettivo/Previsto"
from work_effort we
/* VALORI INDICATORI */
left join (
    select 
        wetav.m_work_effort_id as work_effort_id,
        wetav.tm_gl_account_id as gl_account_id,
        grt.description,
        wetav.g_account_name as account_name,
        wetav.g_account_code,
        wetav.g_uom_abbreviation,
        gac.description as "classe",
        ga.source,
        max(case when wetav.tm_gl_fiscal_type_id='ACTUAL' and wetav.tt_transaction_date=TO_DATE(  $P{date3112sql} , 'YYYY-MM-DD') - INTERVAL '3 year' then wetav.tm_amount else null end) as actual_3,
        max(case when wetav.tm_gl_fiscal_type_id='ACTUAL' and wetav.tt_transaction_date=TO_DATE(  $P{date3112sql} , 'YYYY-MM-DD') - INTERVAL '2 year' then wetav.tm_amount else null end) as actual_2,
        max(case when wetav.tm_gl_fiscal_type_id='ACTUAL' and wetav.tt_transaction_date=TO_DATE(  $P{date3112sql} , 'YYYY-MM-DD') - INTERVAL '1 year' then wetav.tm_amount else null end) as actual_1,
        max(case when wetav.tm_gl_fiscal_type_id='BUDGET' and wetav.tt_transaction_date=TO_DATE(  $P{date3112sql} , 'YYYY-MM-DD') then wetav.tm_amount else null end) as budget,
        max(case when wetav.tm_gl_fiscal_type_id='ACTUAL' and wetav.tt_transaction_date=TO_DATE(  $P{date3112sql} , 'YYYY-MM-DD') then wetav.tm_amount else null end) as actual,
        scorekpi.scorekpi_s1,
        scorekpi.comments_s1,
        scorekpi.scorekpi_s2,
        scorekpi.comments_s2,
        scorekpi.description as "description2",
        score.score_s1,
        score.score_s2,
        score.sequence_id,
        score.note_date_time,
        score.note_info
    from work_effort_trans_all_view wetav
    join work_effort_purpose_account wepa on wepa.gl_account_id = wetav.m_gl_account_id and wepa.work_effort_purpose_type_id ='COGERSU'
    join gl_resource_type grt on grt.gl_resource_type_id = g_gl_resource_type_id
    left join gl_account ga on ga.gl_account_id=wetav.m_gl_account_id
    left join gl_account_class gac on gac.gl_account_class_id=ga.gl_account_class_id
    /* SCOREKPI */
    left join (
        select 
            wem.work_effort_measure_id,
            pt.description,
            max(case when ate.gl_fiscal_type_id = 'ACTUAL' and act.transaction_date = TO_DATE(  $P{date3006sql} , 'YYYY-MM-DD') then ate.amount else null end) as scorekpi_s1,
            max(case when ate.gl_fiscal_type_id = 'ACTUAL' and act.transaction_date = TO_DATE(  $P{date3112sql} , 'YYYY-MM-DD') then ate.amount else null end) as scorekpi_s2,
            max(case when ate.gl_fiscal_type_id = 'ACTUAL' and act.transaction_date = TO_DATE(  $P{date3006sql} , 'YYYY-MM-DD') then urv.comments else null end) as comments_s1,
            max(case when ate.gl_fiscal_type_id = 'ACTUAL' and act.transaction_date = TO_DATE(  $P{date3112sql} , 'YYYY-MM-DD') then urv.comments else null end) as comments_s2
        from work_effort_measure wem
        join acctg_trans act on act.voucher_ref = wem.work_effort_measure_id 
        join period_type pt on pt.period_type_id=wem.period_type_id
        join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id and ate.gl_account_id = 'SCOREKPI'
        left join uom_range ur on ur.uom_id = ate.currency_uom_id
        left join uom_range_values urv on urv.uom_range_id = ur.uom_range_id 
            and ate.amount <= urv.thru_value and ate.amount >= urv.from_value 
        group by
            wem.work_effort_measure_id,pt.description
    ) scorekpi on scorekpi.work_effort_measure_id = wetav.m_work_effort_measure_id
    /* PUNTEGGIO SCHEDA */
    left join (
        select 
            wem.work_effort_id,
            max(case when ate.gl_fiscal_type_id = 'ACTUAL' and act.transaction_date = TO_DATE(  $P{date3006sql} , 'YYYY-MM-DD') then ate.amount else null end) as score_s1,
            max(case when ate.gl_fiscal_type_id = 'ACTUAL' and act.transaction_date = TO_DATE(  $P{date3112sql} , 'YYYY-MM-DD') then ate.amount else null end) as score_s2,
            wen.sequence_id,
            nd.note_date_time,
            nd.note_info
        from work_effort_measure wem
        join acctg_trans act on act.voucher_ref = wem.work_effort_measure_id
        join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id and ate.gl_account_id = 'SCORE'
        left join work_effort_note wen on wen.work_effort_id = wem.work_effort_id 
        left join note_data nd on nd.note_id = wen.note_id
        group by
            wem.work_effort_id, wen.sequence_id, nd.note_date_time, nd.note_info
    ) score on score.work_effort_id = wetav.m_work_effort_id 
    where wetav.w_work_effort_type_id='24M08'
    group by
        wetav.m_work_effort_id,
        wetav.tm_gl_account_id,
        wetav.g_account_name,
        wetav.g_account_code,
        grt.description,
        wetav.g_uom_abbreviation,
        gac.description,
        scorekpi.scorekpi_s1,
        scorekpi.comments_s1,
        scorekpi.scorekpi_s2,
        scorekpi.comments_s2,
        scorekpi.description,
        score.score_s1,
        score.score_s2,
        score.sequence_id,
        score.note_date_time,
        score.note_info,
        ga.source
) indic on indic.work_effort_id = we.work_effort_id
where we.work_effort_type_id = '24M08'
and we.work_effort_id= $P{idProcesso} 
group by 
    we.source_reference_id,
    we.work_effort_name,
    indic.score_s1,
    indic.score_s2,
    indic.description,
    indic.account_name,
    indic.g_uom_abbreviation,
    indic.actual_3,
    indic.actual_2,
    indic.actual_1,
    indic.budget,
    indic.actual,
    indic.scorekpi_s1,
    indic.comments_s1,
    indic.scorekpi_s2,
    indic.comments_s2,
    indic.classe,
    indic.source,
	indic.description2,
    indic.g_account_code
    order by indic.description desc, indic.g_account_code asc]]>
	</queryString>
