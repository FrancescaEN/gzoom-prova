            <xml-property name="queryText"><![CDATA[SELECT 
	   A.ETCH AS "TITOLO1",
	   A.WORK_EFFORT_NAME AS  "TITOLO",
	   A.DESCRIPTION AS "DESCRIPTION",
       A.ESTIMATED_START_DATE AS "START_DATE",
       A.ESTIMATED_COMPLETION_DATE AS "COMPLETATION_DATE",  
       Z.ASSOC_WEIGHT AS "PESO",
       (CASE WHEN U.UOM_TYPE_ID = 'RATING_SCALE' THEN 'SN' ELSE 'AVANZAMENTO' END) AS "TIPO_ESPOSIZIONE",
       Z.WORK_EFFORT_ID_TO AS "WORKEFFORT_ID_TO",       
       A.WORK_EFFORT_ID AS "WORK_EFFORT_ID",
       A.SOURCE_REFERENCE_ID AS "SOURCE_REFERENCE_ID",
       Z.SEQUENCE_NUM AS "SEQUENCE_NUM",
       E.UOM_DESCR AS "MEASURE_DESCR",
      COUNT(*) AS "COUNTER",
    
    MAX(CASE WHEN (I.TRANSACTION_DATE >= @start01Piu2 AND I.TRANSACTION_DATE <= @end01Piu2 AND I.GL_FISCAL_TYPE_ID = 'BUDGET') THEN I.AMOUNT ELSE NULL END) AS "JAN_AMOUNT_BUDGET",
    MAX(CASE WHEN (I.TRANSACTION_DATE >= @start02Piu2 AND I.TRANSACTION_DATE <= @end02Piu2 AND I.GL_FISCAL_TYPE_ID = 'BUDGET') THEN I.AMOUNT ELSE NULL END) AS "FEB_AMOUNT_BUDGET",
    MAX(CASE WHEN (I.TRANSACTION_DATE >= @start03Piu2 AND I.TRANSACTION_DATE <= @end03Piu2 AND I.GL_FISCAL_TYPE_ID = 'BUDGET') THEN I.AMOUNT ELSE NULL END) AS "MAR_AMOUNT_BUDGET",
    MAX(CASE WHEN (I.TRANSACTION_DATE >= @start04Piu2 AND I.TRANSACTION_DATE <= @end04Piu2 AND I.GL_FISCAL_TYPE_ID = 'BUDGET') THEN I.AMOUNT ELSE NULL END) AS "APR_AMOUNT_BUDGET",
    MAX(CASE WHEN (I.TRANSACTION_DATE >= @start05Piu2 AND I.TRANSACTION_DATE <= @end05Piu2 AND I.GL_FISCAL_TYPE_ID = 'BUDGET') THEN I.AMOUNT ELSE NULL END) AS "MAY_AMOUNT_BUDGET",
    MAX(CASE WHEN (I.TRANSACTION_DATE >= @start06Piu2 AND I.TRANSACTION_DATE <= @end06Piu2 AND I.GL_FISCAL_TYPE_ID = 'BUDGET') THEN I.AMOUNT ELSE NULL END) AS "JUN_AMOUNT_BUDGET",
    MAX(CASE WHEN (I.TRANSACTION_DATE >= @start07Piu2 AND I.TRANSACTION_DATE <= @end07Piu2 AND I.GL_FISCAL_TYPE_ID = 'BUDGET') THEN I.AMOUNT ELSE NULL END) AS "JUL_AMOUNT_BUDGET",
    MAX(CASE WHEN (I.TRANSACTION_DATE >= @start08Piu2 AND I.TRANSACTION_DATE <= @end08Piu2 AND I.GL_FISCAL_TYPE_ID = 'BUDGET') THEN I.AMOUNT ELSE NULL END) AS "AUG_AMOUNT_BUDGET",
    MAX(CASE WHEN (I.TRANSACTION_DATE >= @start09Piu2 AND I.TRANSACTION_DATE <= @end09Piu2 AND I.GL_FISCAL_TYPE_ID = 'BUDGET') THEN I.AMOUNT ELSE NULL END) AS "SEP_AMOUNT_BUDGET",
    MAX(CASE WHEN (I.TRANSACTION_DATE >= @start10Piu2 AND I.TRANSACTION_DATE <= @end10Piu2 AND I.GL_FISCAL_TYPE_ID = 'BUDGET') THEN I.AMOUNT ELSE NULL END) AS "OCT_AMOUNT_BUDGET",
    MAX(CASE WHEN (I.TRANSACTION_DATE >= @start11Piu2 AND I.TRANSACTION_DATE <= @end11Piu2 AND I.GL_FISCAL_TYPE_ID = 'BUDGET') THEN I.AMOUNT ELSE NULL END) AS "NOV_AMOUNT_BUDGET",
    MAX(CASE WHEN (I.TRANSACTION_DATE >= @start12Piu2 AND I.TRANSACTION_DATE <= @end12Piu2 AND I.GL_FISCAL_TYPE_ID = 'BUDGET') THEN I.AMOUNT ELSE NULL END) AS "DEC_AMOUNT_BUDGET",
    
           
    MAX(CASE WHEN (I.TRANSACTION_DATE >= @start01Piu2 AND I.TRANSACTION_DATE <= @end01Piu2 AND I.GL_FISCAL_TYPE_ID = 'ACTUAL') THEN I.AMOUNT ELSE NULL END) AS "JAN_AMOUNT_ACTUAL",
    MAX(CASE WHEN (I.TRANSACTION_DATE >= @start02Piu2 AND I.TRANSACTION_DATE <= @end02Piu2 AND I.GL_FISCAL_TYPE_ID = 'ACTUAL') THEN I.AMOUNT ELSE NULL END) AS "FEB_AMOUNT_ACTUAL",
    MAX(CASE WHEN (I.TRANSACTION_DATE >= @start03Piu2 AND I.TRANSACTION_DATE <= @end03Piu2 AND I.GL_FISCAL_TYPE_ID = 'ACTUAL') THEN I.AMOUNT ELSE NULL END) AS "MAR_AMOUNT_ACTUAL",
    MAX(CASE WHEN (I.TRANSACTION_DATE >= @start04Piu2 AND I.TRANSACTION_DATE <= @end04Piu2 AND I.GL_FISCAL_TYPE_ID = 'ACTUAL') THEN I.AMOUNT ELSE NULL END) AS "APR_AMOUNT_ACTUAL",
    MAX(CASE WHEN (I.TRANSACTION_DATE >= @start05Piu2 AND I.TRANSACTION_DATE <= @end05Piu2 AND I.GL_FISCAL_TYPE_ID = 'ACTUAL') THEN I.AMOUNT ELSE NULL END) AS "MAY_AMOUNT_ACTUAL",
    MAX(CASE WHEN (I.TRANSACTION_DATE >= @start06Piu2 AND I.TRANSACTION_DATE <= @end06Piu2 AND I.GL_FISCAL_TYPE_ID = 'ACTUAL') THEN I.AMOUNT ELSE NULL END) AS "JUN_AMOUNT_ACTUAL",
    MAX(CASE WHEN (I.TRANSACTION_DATE >= @start07Piu2 AND I.TRANSACTION_DATE <= @end07Piu2 AND I.GL_FISCAL_TYPE_ID = 'ACTUAL') THEN I.AMOUNT ELSE NULL END) AS "JUL_AMOUNT_ACTUAL",
    MAX(CASE WHEN (I.TRANSACTION_DATE >= @start08Piu2 AND I.TRANSACTION_DATE <= @end08Piu2 AND I.GL_FISCAL_TYPE_ID = 'ACTUAL') THEN I.AMOUNT ELSE NULL END) AS "AUG_AMOUNT_ACTUAL",
    MAX(CASE WHEN (I.TRANSACTION_DATE >= @start09Piu2 AND I.TRANSACTION_DATE <= @end09Piu2 AND I.GL_FISCAL_TYPE_ID = 'ACTUAL') THEN I.AMOUNT ELSE NULL END) AS "SEP_AMOUNT_ACTUAL",
    MAX(CASE WHEN (I.TRANSACTION_DATE >= @start10Piu2 AND I.TRANSACTION_DATE <= @end10Piu2 AND I.GL_FISCAL_TYPE_ID = 'ACTUAL') THEN I.AMOUNT ELSE NULL END) AS "OCT_AMOUNT_ACTUAL",
    MAX(CASE WHEN (I.TRANSACTION_DATE >= @start11Piu2 AND I.TRANSACTION_DATE <= @end11Piu2 AND I.GL_FISCAL_TYPE_ID = 'ACTUAL') THEN I.AMOUNT ELSE NULL END) AS "NOV_AMOUNT_ACTUAL",
    MAX(CASE WHEN (I.TRANSACTION_DATE >= @start12Piu2 AND I.TRANSACTION_DATE <= @end12Piu2 AND I.GL_FISCAL_TYPE_ID = 'ACTUAL') THEN I.AMOUNT ELSE NULL END) AS "DEC_AMOUNT_ACTUAL"
      
 FROM WORK_EFFORT A
     JOIN WORK_EFFORT_TYPE B ON B.WORK_EFFORT_TYPE_ID = A.WORK_EFFORT_TYPE_ID
     JOIN WORK_EFFORT_ASSOC Z ON Z.WORK_EFFORT_ID_TO = A.WORK_EFFORT_ID
     JOIN WORK_EFFORT C ON C.WORK_EFFORT_ID = Z.WORK_EFFORT_ID_FROM
     JOIN WORK_EFFORT_ASSOC_TYPE D ON D.WORK_EFFORT_ASSOC_TYPE_ID = Z.WORK_EFFORT_ASSOC_TYPE_ID
     LEFT OUTER JOIN WORK_EFFORT_MEASURE E ON E.WORK_EFFORT_ID = A.WORK_EFFORT_ID
                                          AND E.WE_MEASURE_TYPE_ENUM_ID  <> 'WEMT_SCORE'  
     LEFT OUTER JOIN GL_ACCOUNT G ON E.GL_ACCOUNT_ID  = G.GL_ACCOUNT_ID    
     LEFT OUTER JOIN UOM        U ON G.DEFAULT_UOM_ID = U.UOM_ID
     LEFT OUTER JOIN (
          SELECT Q.WORK_EFFORT_ID, Q.TRANSACTION_DATE, R.AMOUNT, R.GL_ACCOUNT_ID, R.GL_FISCAL_TYPE_ID
          FROM ACCTG_TRANS Q 
          JOIN ACCTG_TRANS_ENTRY R ON Q.ACCTG_TRANS_ID = R.ACCTG_TRANS_ID
                     ) I ON I.WORK_EFFORT_ID = A.WORK_EFFORT_ID AND I.GL_ACCOUNT_ID = E.GL_ACCOUNT_ID
WHERE   Z.WORK_EFFORT_ID_FROM = ?
 AND ((D.PARENT_TYPE_ID = 'HIE' AND A.WORK_EFFORT_PARENT_ID = C.WORK_EFFORT_PARENT_ID) OR Z.WORK_EFFORT_ASSOC_TYPE_ID = C.WORK_EFFORT_ASSOC_TYPE_ID) 
  AND G.GL_ACCOUNT_ID = 'SAL03'
-- AND  (Z.THRU_DATE = C.ESTIMATED_COMPLETION_DATE OR Z.THRU_DATE = A.ESTIMATED_COMPLETION_DATE)
 AND (A.ESTIMATED_START_DATE <= @end12Piu2 AND A.ESTIMATED_COMPLETION_DATE >= @start01Piu2)
 GROUP BY 
 	   Z.WORK_EFFORT_ID_TO,
	   A.WORK_EFFORT_NAME ,
	   A.DESCRIPTION,
       A.ESTIMATED_START_DATE ,
       A.ESTIMATED_COMPLETION_DATE ,  
       Z.ASSOC_WEIGHT,
       U.UOM_TYPE_ID,
       A.ETCH,
	   A.WORK_EFFORT_ID,
       A.SOURCE_REFERENCE_ID,
       Z.SEQUENCE_NUM,
       E.UOM_DESCR
       
   
 ORDER BY 
 	A.SOURCE_REFERENCE_ID, 
 	Z.SEQUENCE_NUM,
 	A.WORK_EFFORT_ID
         
]]></xml-property>
