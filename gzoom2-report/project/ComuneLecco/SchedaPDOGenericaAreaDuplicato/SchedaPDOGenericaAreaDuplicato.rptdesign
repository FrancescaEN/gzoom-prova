            <xml-property name="queryText"><![CDATA[SELECT 
TP.GL_ACCOUNT_TYPE_ID AS "GL_ACCOUNT_TYPE_ID", 
T.DESCRIPTION     AS  "TITOLO", 
AC.ACCOUNT_CODE AS "CAPITOLO", 
AC.ACCOUNT_NAME AS "DESCRIZIONE_CAPITOLO", 

COLL.TOT_STA_COLL AS "TOT_STA_COL",   
COLL.TOT_ASS_COLL AS "TOT_ASS_COLL",  
COLL.TOT_IMP_COLL AS "TOT_IMP_COLL",  
 COLL.TOT_PAG_COLL AS "TOT_PAG_COLL",
NONCO.TOT_STA_NONCO AS "TOT_STA_NON_COLL", 
NONCO.TOT_ASS_NONCO AS "TOT_ASS_NON_COLL",
NONCO.TOT_IMP_NONCO AS "TOT_IMP_NON_COLL", 
NONCO.TOT_PAG_NONCO AS "TOT_PAG_NON_COLL",
PCG.PARTY_NAME     AS    "CENTRO_GESTORE",
COUNT(*) AS "COUNTER"


FROM        WORK_EFFORT W 
CROSS JOIN  GL_ACCOUNT  AC
JOIN       GL_ACCOUNT_TYPE     T
ON         T.GL_ACCOUNT_TYPE_ID = AC.GL_ACCOUNT_TYPE_ID
JOIN       GL_ACCOUNT_TYPE     TP
ON         T.PARENT_TYPE_ID = TP.GL_ACCOUNT_TYPE_ID

LEFT OUTER JOIN
(SELECT   GL_ACCOUNT_ID, MAX(PARTY_ID) PARTY_ID
FROM     GL_ACCOUNT_ROLE GR
JOIN     ROLE_TYPE       R
ON       GR.ROLE_TYPE_ID = R.ROLE_TYPE_ID
AND      R.PARENT_TYPE_ID = 'ORGANIZATION_UNIT'
GROUP BY GL_ACCOUNT_ID ) CG
ON    CG.GL_ACCOUNT_ID = AC.GL_ACCOUNT_ID
LEFT OUTER JOIN    PARTY PCG
ON    PCG.PARTY_ID = CG.PARTY_ID

LEFT  JOIN 
   (SELECT WP.WORK_EFFORT_ID, MI.GL_ACCOUNT_ID,

    (CASE  WHEN MR.GL_FISCAL_TYPE_ID = 'STANZIATO' THEN SUM(MR.AMOUNT) END) TOT_STA_COLL , 
    (CASE  WHEN MR.GL_FISCAL_TYPE_ID = 'ASSESTATO' THEN SUM(MR.AMOUNT) END) TOT_ASS_COLL , 
    (CASE  WHEN MR.GL_FISCAL_TYPE_ID = 'IMPACC'    THEN SUM(MR.AMOUNT) END) TOT_IMP_COLL , 
    (CASE  WHEN MR.GL_FISCAL_TYPE_ID = 'PAGINC'    THEN SUM(MR.AMOUNT) END) TOT_PAG_COLL  

    FROM ACCTG_TRANS_ENTRY   MR 
    JOIN ACCTG_TRANS         MT ON  MT.ACCTG_TRANS_ID         = MR.ACCTG_TRANS_ID
    JOIN WORK_EFFORT_MEASURE MI ON  MI.WORK_EFFORT_MEASURE_ID = MT.VOUCHER_REF
    JOIN WORK_EFFORT         W  ON  W.WORK_EFFORT_ID          = MI.WORK_EFFORT_ID
    JOIN WORK_EFFORT_ASSOC   WA ON  WA.WORK_EFFORT_ID_TO      = W.WORK_EFFORT_ID
    JOIN WORK_EFFORT         WP ON  WP.WORK_EFFORT_ID         = WA.WORK_EFFORT_ID_FROM
                                AND  (WA.THRU_DATE = W.ESTIMATED_COMPLETION_DATE   OR
                                      WA.THRU_DATE = WP.ESTIMATED_COMPLETION_DATE)
    JOIN WORK_EFFORT         WR ON  WP.WORK_EFFORT_PARENT_ID = WR.WORK_EFFORT_ID
    JOIN WORK_EFFORT_TYPE    WT ON  WT.WORK_EFFORT_TYPE_ID = WR.WORK_EFFORT_TYPE_ID
                                AND WA.WORK_EFFORT_ASSOC_TYPE_ID = WT.HIERARCHY_ASSOC_TYPE_ID                                
    WHERE MR.GL_ACCOUNT_FIN_ID IS NOT NULL 

    AND   MR.GL_FISCAL_TYPE_ID   = 'STANZIATO'   
    AND  (( MT.TRANSACTION_DATE    = ?   AND MR.GL_FISCAL_TYPE_ID = 'STANZIATO' ) OR   
          ( MT.TRANSACTION_DATE    = ?   AND MR.GL_FISCAL_TYPE_ID <> 'STANZIATO' ))   

    GROUP BY  WP.WORK_EFFORT_ID, MI.GL_ACCOUNT_ID, MR.GL_FISCAL_TYPE_ID
   ) COLL ON COLL.GL_ACCOUNT_ID = AC.GL_ACCOUNT_ID  AND  COLL.WORK_EFFORT_ID = W.WORK_EFFORT_ID
LEFT JOIN 
  (SELECT MI.WORK_EFFORT_ID, MI.GL_ACCOUNT_ID,

    (CASE  WHEN MR.GL_FISCAL_TYPE_ID = 'STANZIATO' THEN SUM(MR.AMOUNT) END) TOT_STA_NONCO , 
    (CASE  WHEN MR.GL_FISCAL_TYPE_ID = 'ASSESTATO' THEN SUM(MR.AMOUNT) END) TOT_ASS_NONCO , 
    (CASE  WHEN MR.GL_FISCAL_TYPE_ID = 'IMPACC'    THEN SUM(MR.AMOUNT) END) TOT_IMP_NONCO , 
    (CASE  WHEN MR.GL_FISCAL_TYPE_ID = 'PAGINC'    THEN SUM(MR.AMOUNT) END) TOT_PAG_NONCO   

    FROM ACCTG_TRANS_ENTRY   MR 
    JOIN ACCTG_TRANS         MT ON  MT.ACCTG_TRANS_ID         = MR.ACCTG_TRANS_ID
    JOIN WORK_EFFORT_MEASURE MI ON  MI.WORK_EFFORT_MEASURE_ID = MT.VOUCHER_REF
    WHERE MR.GL_ACCOUNT_FIN_ID IS NOT NULL 
    AND MT.TRANSACTION_DATE = ?    
    AND MR.GL_FISCAL_TYPE_ID   = 'STANZIATO'    

    AND   MR.GL_FISCAL_TYPE_ID   = 'STANZIATO'    -- FISSO
    AND  (( MT.TRANSACTION_DATE    = ?   AND MR.GL_FISCAL_TYPE_ID =  'STANZIATO') OR   
          ( MT.TRANSACTION_DATE    = ?  AND MR.GL_FISCAL_TYPE_ID <> 'STANZIATO'))      

    GROUP BY MI.WORK_EFFORT_ID, MI.GL_ACCOUNT_ID, MR.GL_FISCAL_TYPE_ID  ) NONCO ON NONCO.GL_ACCOUNT_ID = AC.GL_ACCOUNT_ID AND  NONCO.WORK_EFFORT_ID = W.WORK_EFFORT_ID
WHERE    W.WORK_EFFORT_ID = ?  
AND ( COLL.TOT_STA_COLL   IS NOT NULL OR COLL.TOT_ASS_COLL   IS NOT NULL OR COLL.TOT_IMP_COLL   IS NOT NULL OR COLL.TOT_PAG_COLL IS NOT NULL OR 
      NONCO.TOT_STA_NONCO IS NOT NULL OR NONCO.TOT_ASS_NONCO IS NOT NULL OR NONCO.TOT_IMP_NONCO IS NOT NULL OR NONCO.TOT_PAG_NONCO IS NOT NULL )

GROUP BY
TP.GL_ACCOUNT_TYPE_ID,
T.DESCRIPTION,   
AC.ACCOUNT_CODE,
AC.ACCOUNT_NAME,
COLL.TOT_STA_COLL,   
COLL.TOT_ASS_COLL,  
COLL.TOT_IMP_COLL,  
 COLL.TOT_PAG_COLL,
NONCO.TOT_STA_NONCO, 
NONCO.TOT_ASS_NONCO,
NONCO.TOT_IMP_NONCO, 
NONCO.TOT_PAG_NONCO,
PCG.PARTY_NAME

ORDER BY 
TP.GL_ACCOUNT_TYPE_ID,
T.DESCRIPTION,   
AC.ACCOUNT_CODE,
AC.ACCOUNT_NAME,
COLL.TOT_STA_COLL,   
COLL.TOT_ASS_COLL,  
COLL.TOT_IMP_COLL,  
 COLL.TOT_PAG_COLL,
