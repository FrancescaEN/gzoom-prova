            <method name="beforeOpen"><![CDATA[/**/
this.queryText = this.queryText.replace("@excludeValidity", "'" + params["excludeValidity"].value+ "'");
this.queryText = this.queryText.replace("@reportContentId", "'" + params["reportContentId"].value+ "'");
this.queryText = this.queryText.replace("@workEffortId", "'" + params["workEffortId"].value+ "'");
this.queryText = this.queryText.replace("@partyId", "'" + params["partyId"].value+ "'");
this.queryText = this.queryText.replace("@orgUnitId", "'" + params["orgUnitId"].value+ "'");
this.queryText = this.queryText.replace("@workEffortTypeId", "'" + params["workEffortTypeId"].value+ "'");
this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value );
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );


/*
this.queryText = this.queryText.replace("@excludeValidity",  "'N'" );
this.queryText = this.queryText.replace("@reportContentId",  "'REP_PDO_AREA'" );
this.queryText = this.queryText.replace("@workEffortId",  "'E21072'" );
this.queryText = this.queryText.replace("@partyId",  "' '" );
this.queryText = this.queryText.replace("@orgUnitId",  "' '" );
this.queryText = this.queryText.replace("@workEffortTypeId",  "' '" );
this.queryText = this.queryText.replace("@monitoringDate",  "'2021-01-01 00:00:00.000'" );
this.queryText = this.queryText.replace("@date0101",  "'2021-01-01 00:00:00.000'" );
this.queryText = this.queryText.replace("@date3112",  "'2021-01-01 00:00:00.000'" );
*/

var workEffortRevisionId = " AND RAD.WORK_EFFORT_REVISION_ID IS NULL ";
workEffortRevisionId += " AND OB1.WORK_EFFORT_REVISION_ID IS NULL ";
workEffortRevisionId += " AND OB2.WORK_EFFORT_REVISION_ID IS NULL ";
workEffortRevisionId += " AND FIL_W.WORK_EFFORT_REVISION_ID IS NULL ";
	
if (params["workEffortRevisionId"].value != null &amp;&amp; params["workEffortRevisionId"].value != '') {
    workEffortRevisionId = " AND RAD.WORK_EFFORT_REVISION_ID = '" + params["workEffortRevisionId"].value + "'";
    workEffortRevisionId += " AND OB1.WORK_EFFORT_REVISION_ID = '" + params["workEffortRevisionId"].value + "'";
    workEffortRevisionId += " AND OB2.WORK_EFFORT_REVISION_ID = '" + params["workEffortRevisionId"].value + "'";
    workEffortRevisionId += " AND FIL_W.WORK_EFFORT_REVISION_ID = '" + params["workEffortRevisionId"].value + "'";

}  
this.queryText = this.queryText.replace("@workEffortRevisionId",  workEffortRevisionId ); 

//GESTIRE PERMESSI
/**/
filter = new com.mapsengineering.base.birt.util.UtilFilter(params["userLoginId"].value, params["localDispatcherName"].value);
var filterInnerJoin = filter.getWorkEffortFilterInner();
var filterLeftJoin = filter.getWorkEffortFilterLeftJoin();
var filterWhere = filter.getWorkEffortFilterWhere();

/*
var filterInnerJoin = "";
var filterLeftJoin = "";
var filterWhere = "";
 */
this.queryText = this.queryText.replace("@filterInnerJoin",  filterInnerJoin );
this.queryText = this.queryText.replace("@filterLeftJoin",  filterLeftJoin );
this.queryText = this.queryText.replace("@filterWhere",  filterWhere );

ReportLog.info("......this.queryText MasterAttivita : "+this.queryText);
//ReportLog.info("......this.queryText MasterAttivitaPARAMS : "+this.getInputParameters());]]></method>
