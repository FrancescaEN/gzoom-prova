            <method name="beforeOpen"><![CDATA[/*
this.queryText = this.queryText.replace("@monitoringDate",  "'2022-12-31 00:00:00.000'");
this.queryText = this.queryText.replace("@date0101Piu1", "'2022-12-31 00:00:00.000'");
this.queryText = this.queryText.replace("@date3112Piu1", "'2022-12-31 00:00:00.000'");
*/
/**/
this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value);
this.queryText = this.queryText.replace("@date0101Piu1",  params["date0101Piu1Sql"].value );
this.queryText = this.queryText.replace("@date3112Piu1",  params["date3112Piu1Sql"].value );
]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">ETCH</property>
                    <property name="nativeName">ETCH</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">WORK_EFFORT_NAME</property>
                    <property name="nativeName">WORK_EFFORT_NAME</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">DESCRIPTION</property>
                    <property name="nativeName">DESCRIPTION</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">UOM_DESCR</property>
                    <property name="nativeName">UOM_DESCR</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">AVANZ_ACTUAL</property>
                    <property name="nativeName">AVANZ_ACTUAL</property>
                    <property name="dataType">float</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[ SELECT 
	WE.ETCH AS "ETCH",
	WE.WORK_EFFORT_NAME AS "WORK_EFFORT_NAME",
	WE.DESCRIPTION AS "DESCRIPTION", 
	WEM.UOM_DESCR AS "UOM_DESCR",
	
	MAX(CASE WHEN (I.TRANSACTION_DATE = @monitoringDate AND I.GL_FISCAL_TYPE_ID = 'SALFAS' AND G.ACCOUNT_CODE = 'AVAFAS') THEN I.AMOUNT ELSE NULL END) AS "AVANZ_ACTUAL"
 
 FROM WORK_EFFORT WE 
 INNER JOIN WORK_EFFORT_MEASURE WEM ON WEM.WORK_EFFORT_ID = WE.WORK_EFFORT_ID AND WEM.FROM_DATE <= @date3112Piu1 AND WEM.THRU_DATE >= @date0101Piu1
 INNER JOIN GL_ACCOUNT G ON WEM.GL_ACCOUNT_ID  = G.GL_ACCOUNT_ID
 LEFT OUTER JOIN (
          SELECT Q.WORK_EFFORT_ID, Q.TRANSACTION_DATE, R.AMOUNT, R.GL_ACCOUNT_ID, R.GL_FISCAL_TYPE_ID, Q.VOUCHER_REF
          FROM ACCTG_TRANS Q 
          JOIN ACCTG_TRANS_ENTRY R ON Q.ACCTG_TRANS_ID = R.ACCTG_TRANS_ID
                     ) I ON I.WORK_EFFORT_ID = WE.WORK_EFFORT_ID AND I.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID
                     	AND WEM.WORK_EFFORT_MEASURE_ID = I.VOUCHER_REF
                     
 WHERE WE.WORK_EFFORT_ID = ? AND G.ACCOUNT_CODE = 'AVAFAS'
 
 GROUP BY WE.ETCH, WE.WORK_EFFORT_NAME, WE.DESCRIPTION, WEM.UOM_DESCR,WEM.SEQUENCE_ID
 
 ORDER BY WEM.SEQUENCE_ID]]></xml-property>
