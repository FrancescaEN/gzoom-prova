            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">WE1_NAME</property>
                    <property name="nativeName">WE1_NAME</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
	WE1.WORK_EFFORT_NAME AS "WE1_NAME"
		
	FROM WORK_EFFORT WE
	INNER JOIN WORK_EFFORT_ASSOC WEA ON WE.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_TO
	INNER JOIN WORK_EFFORT WE1 ON  WEA.WORK_EFFORT_ID_FROM = WE1.WORK_EFFORT_ID

WHERE WE.WORK_EFFORT_TYPE_ID='15PM10' AND WEA.WORK_EFFORT_ASSOC_TYPE_ID='15PM09_15PMCP'
AND WE.WORK_EFFORT_ID = ?
]]></xml-property>
        </oda-data-set>
