                    <property name="nativeName">SEQUENCE_NUM</property>
                    <property name="dataType">decimal</property>
                    <property name="nativeDataType">2</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">SOURCE_REFERENCE_ID</property>
                    <property name="nativeName">SOURCE_REFERENCE_ID</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">WORK_EFFORT_ID</property>
                    <property name="nativeName">WORK_EFFORT_ID</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT P_CDC.PARTY_NAME AS "PARTY_NAME", 
	   OBB.WORK_EFFORT_NAME AS "OB3_WORK_EFFORT_NAME", 
	   ATT.WORK_EFFORT_NAME AS "WORK_EFFORT_NAME",
	   COUNT(*) AS "COUNTER", 
	   A.SEQUENCE_NUM AS "SEQUENCE_NUM", 
	   ATT.SOURCE_REFERENCE_ID AS "SOURCE_REFERENCE_ID", 
	   ATT.WORK_EFFORT_ID AS "WORK_EFFORT_ID" 
FROM    WORK_EFFORT W
JOIN    WORK_EFFORT_ASSOC  A
ON      A.WORK_EFFORT_ID_TO = W.WORK_EFFORT_ID
JOIN     WORK_EFFORT ATT 
ON       ATT.WORK_EFFORT_ID = A.WORK_EFFORT_ID_FROM
JOIN     WORK_EFFORT_ASSOC_TYPE   ATT_AT
ON       ATT_AT.WORK_EFFORT_ASSOC_TYPE_ID = A.WORK_EFFORT_ASSOC_TYPE_ID
AND      (ATT_AT.PARENT_TYPE_ID = 'ASS' )
AND      (A.THRU_DATE = W.ESTIMATED_COMPLETION_DATE OR A.THRU_DATE = ATT.ESTIMATED_COMPLETION_DATE)
JOIN    WORK_EFFORT_ASSOC  A_OB
ON      A_OB.WORK_EFFORT_ID_TO = ATT.WORK_EFFORT_ID
JOIN     WORK_EFFORT OBB
ON       OBB.WORK_EFFORT_ID = A_OB.WORK_EFFORT_ID_FROM
JOIN     WORK_EFFORT_ASSOC_TYPE   OB_AT
ON       OB_AT.WORK_EFFORT_ASSOC_TYPE_ID = A_OB.WORK_EFFORT_ASSOC_TYPE_ID
AND     (OB_AT.PARENT_TYPE_ID = 'HIE' AND OBB.WORK_EFFORT_PARENT_ID = ATT.WORK_EFFORT_PARENT_ID)
AND      (A_OB.THRU_DATE = OBB.ESTIMATED_COMPLETION_DATE OR A_OB.THRU_DATE = ATT.ESTIMATED_COMPLETION_DATE)
JOIN     PARTY   P_CDC
ON       ATT.ORG_UNIT_ID = P_CDC.PARTY_ID   
WHERE    W.WORK_EFFORT_ID = ?
GROUP BY P_CDC.PARTY_NAME, OBB.WORK_EFFORT_NAME, ATT.WORK_EFFORT_NAME, A.SEQUENCE_NUM, ATT.SOURCE_REFERENCE_ID, ATT.WORK_EFFORT_ID  
ORDER BY  A.SEQUENCE_NUM,   ATT.SOURCE_REFERENCE_ID ,  ATT.WORK_EFFORT_ID ]]></xml-property>
        </oda-data-set>
