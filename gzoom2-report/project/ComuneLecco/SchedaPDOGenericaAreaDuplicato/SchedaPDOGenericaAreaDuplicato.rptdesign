            <method name="beforeOpen"><![CDATA[var workEffortRevisionId = " AND WAL1.WE_FROM_REVISION_ID IS NULL ";
workEffortRevisionId += " AND WAL2.WE_FROM_REVISION_ID IS NULL ";
workEffortRevisionId += " AND WAL3.WE_FROM_REVISION_ID IS NULL ";
workEffortRevisionId += " AND WAL4.WE_FROM_REVISION_ID IS NULL ";
workEffortRevisionId += " AND WAL5.WE_FROM_REVISION_ID IS NULL ";
workEffortRevisionId += " AND WAL6.WE_FROM_REVISION_ID IS NULL ";
workEffortRevisionId += " AND WAL7.WE_FROM_REVISION_ID IS NULL ";

if (params["workEffortRevisionId"].value != null &amp;&amp; params["workEffortRevisionId"].value != '') {
    workEffortRevisionId = " AND WAL1.WE_FROM_REVISION_ID = '" + params["workEffortRevisionId"].value + "'";
    workEffortRevisionId += " AND WAL2.WE_FROM_REVISION_ID = '" + params["workEffortRevisionId"].value + "'";
    workEffortRevisionId += " AND WAL3.WE_FROM_REVISION_ID = '" + params["workEffortRevisionId"].value + "'";
    workEffortRevisionId += " AND WAL4.WE_FROM_REVISION_ID = '" + params["workEffortRevisionId"].value + "'";
    workEffortRevisionId += " AND WAL5.WE_FROM_REVISION_ID = '" + params["workEffortRevisionId"].value + "'";
    workEffortRevisionId += " AND WAL6.WE_FROM_REVISION_ID = '" + params["workEffortRevisionId"].value + "'";
    workEffortRevisionId += " AND WAL7.WE_FROM_REVISION_ID = '" + params["workEffortRevisionId"].value + "'";
}  
this.queryText = this.queryText.replace("@workEffortRevisionId",  workEffortRevisionId ); ]]></method>
