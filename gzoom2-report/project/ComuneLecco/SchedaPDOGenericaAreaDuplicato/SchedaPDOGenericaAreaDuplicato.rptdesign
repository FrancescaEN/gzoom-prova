    <property name="createdBy">Eclipse BIRT Designer Version 4.8.0.v201806261756</property>
    <simple-property-list name="includeResource">
        <value>custom/SchedaPDOGenericaArea/SchedaPDOGenericaArea</value>
        <value>project/ComuneLecco/SchedaPDOGenericaArea/SchedaPDOGenericaArea</value>
    </simple-property-list>
    <property name="units">in</property>
    <method name="initialize"><![CDATA[importPackage(Packages.java.util);
importPackage(Packages.java.lang);
importPackage(Packages.javolution.util);
importPackage(Packages.org.ofbiz.base.util);
importPackage(Packages.com.mapsengineering.base.appheader);
importPackage(Packages.it.mapsgroup.gzoom);
importPackage(Packages.com.mapsengineering.base.birt.util);


var vectorPageNumber = new Vector();
reportContext.setGlobalVariable("vectorPageNumber", vectorPageNumber);
reportContext.setGlobalVariable("nPagina", 1);

var isMonitoring = true;

if 	((BirtDateTime.day(params["monitoringDate"].value) == 01 &amp;&amp; BirtDateTime.month(params["monitoringDate"].value) == 1))	{
	 isMonitoring = false;
}

var header_title = reportContext.getMessage('PDO_HeaderLabel', reportContext.getLocale())  + " " + (BirtDateTime.year(params["monitoringDate"].value) );


var date_label =  "31/08/"

if (BirtDateTime.year(params["monitoringDate"].value) > 2016) {
	date_label = "30/06/"
}

var date = " " + reportContext.getMessage('al', reportContext.getLocale()) + " " + Formatter.format(params["monitoringDate"].value,'dd/MM/yyyy');
]]></method>
    <method name="beforeFactory"><![CDATA[//In base ai parametri di lancio della pagina elimino o no le sezioni del report

// escludo la sezione del gant
if (params["excludeGantt"].value == 'Y') {
	var tblfasi = reportContext.getDesignHandle().findElement("tblfasi");
	tblfasi.drop();
}

// mostro una sola sezione indicatori
// escludi excludeIndicator
var tbIndicatoriDett = reportContext.getDesignHandle().findElement("tbIndicatoriDett");
var tbIndicatoriNoDett = reportContext.getDesignHandle().findElement("tbIndicatoriNoDett");
if (params["excludeIndicator"].value == 'Y') {
	tbIndicatoriDett.drop();
	tbIndicatoriNoDett.drop();

} else if (params["exposeDetailIndicator"].value == 'N') {		
		tbIndicatoriDett.drop();
	} else {		
		tbIndicatoriNoDett.drop();
	}


// escludo risorse umane assegnate
// escludo risorse umane assegnate group
// escludo risorse umane appartenenza
if (params["excludeHumanResource"].value == 'Y') {
	var tabRisorsaUmane = reportContext.getDesignHandle().findElement("tabRisorseUmane");
	tabRisorsaUmane.drop();
}

// escludo risorse finanziarie
if (params["excludeFinalcialResource"].value == 'Y') {
	var tabRisorseFinanziarie = reportContext.getDesignHandle().findElement("tabRisorseFinanziarie");
	tabRisorseFinanziarie.drop();
	
	var tbRisorseFinanziareOB2 = reportContext.getDesignHandle().findElement("tbRisorseFinanziareOB2");
	tbRisorseFinanziareOB2.drop();
}


// escludo richieste di supporto
//escludo centro di costo collegato
if (params["excludeRequest"].value == 'Y') {
	var tabCDCC = reportContext.getDesignHandle().findElement("tabCDCC");
	tabCDCC.drop();
	
	var tbCentroCostoCollegato = reportContext.getDesignHandle().findElement("tbCentroCostoCollegato");
	tbCentroCostoCollegato.drop();
}

// escludo richieste di support
if (params["excludeCollegati"].value == 'Y') {
	var tbObiettiviCollegatiRichiesti = reportContext.getDesignHandle().findElement("tbObiettiviCollegatiRichiesti");
	tbObiettiviCollegatiRichiesti.drop();
	
	var tbObiettiviCollegatiRicevuti = reportContext.getDesignHandle().findElement("tbObiettiviCollegatiRicevuti");
	tbObiettiviCollegatiRicevuti.drop();
	
}]]></method>
