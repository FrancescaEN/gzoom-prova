            <method name="beforeOpen"><![CDATA[/**/
this.queryText = this.queryText.replace("@excludeValidity", "'" + params["excludeValidity"].value+ "'");
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value );
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );

/*
this.queryText = this.queryText.replace("@excludeValidity",  "'N'" );
this.queryText = this.queryText.replace("@date0101",  "'2021-01-01 00:00:00.000'" );
this.queryText = this.queryText.replace("@date3112",  "'2021-01-01 00:00:00.000'" );
*/

var workEffortRevisionId = " AND WAL1.WE_FROM_REVISION_ID IS NULL ";
if (params["workEffortRevisionId"].value != null &amp;&amp; params["workEffortRevisionId"].value != '') {
    workEffortRevisionId = " AND WAL1.WE_FROM_REVISION_ID = '" + params["workEffortRevisionId"].value + "'";
}  
this.queryText = this.queryText.replace("@workEffortRevisionId",  workEffortRevisionId ); ]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">FROM_TYPE_ETCH</property>
                    <property name="nativeName">FROM_TYPE_ETCH</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">FROM_ETCH</property>
                    <property name="nativeName">FROM_ETCH</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">FROM_NAME</property>
                    <property name="nativeName">FROM_NAME</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">ID</property>
                    <property name="nativeName">ID</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
	WAL1.WE_FROM_TYPE_ETCH AS "FROM_TYPE_ETCH",
	WAL1.WE_FROM_ETCH AS "FROM_ETCH", 
	WAL1.WE_FROM_NAME AS "FROM_NAME",
	WAL1.WE_FROM_ID AS "ID"
       
FROM WORK_EFFORT WE
  INNER JOIN WORK_EFFORT_TYPE WT ON WT.WORK_EFFORT_TYPE_ID = WE.WORK_EFFORT_TYPE_ID
  LEFT JOIN WORK_EFFORT_TYPE_TYPE WTL1 ON WTL1.WORK_EFFORT_TYPE_ID_ROOT = WT.WORK_EFFORT_TYPE_HIERARCHY_ID AND WTL1.WORK_EFFORT_TYPE_ID_TO = WE.WORK_EFFORT_TYPE_ID
  LEFT JOIN WORK_EFFORT_ASSOC_VIEW WAL1 ON WAL1.WE_TO_ID = WE.WORK_EFFORT_ID AND WAL1.WE_FROM_TYPE_ID = WTL1.WORK_EFFORT_TYPE_ID_FROM 
  AND ( @excludeValidity = 'Y' OR  (@excludeValidity = 'N' AND ( WAL1.WA_FROM_DATE <= @date3112 AND (WAL1.WA_THRU_DATE >= @date0101 OR WAL1.WA_THRU_DATE IS NULL )))) 
WHERE WE.WORK_EFFORT_ID = ?
	@workEffortRevisionId]]></xml-property>
        </oda-data-set>
