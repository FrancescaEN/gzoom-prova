            <xml-property name="queryText"><![CDATA[SELECT WC.ETCH AS "ETCH", 
	   WEA.WE_ASS_WEIGHT AS "WE_ASS_WEIGHT", 
	   WEA.WE_FROM_TYPE_ETCH AS "WE_FROM_TYPE_ETCH", 
	   WEA.WE_FROM_ETCH AS "WE_FROM_ETCH", 
	   WEA.WE_FROM_NAME AS "WE_FROM_NAME"
FROM WORK_EFFORT WE
INNER JOIN WORK_EFFORT_TYPE_CONTENT WC ON WC.WORK_EFFORT_TYPE_ID = WE.WORK_EFFORT_TYPE_ID 
	AND WC.WE_TYPE_CONTENT_TYPE_ID = 'FOLDER' AND WC.CONTENT_ID = 'WEFLD_WETO5'
INNER JOIN WORK_EFFORT_TYPE_ASSOC WA ON WA.WORK_EFFORT_TYPE_ID = WC.WORK_EFFORT_TYPE_ID AND WA.CONTENT_ID = WC.CONTENT_ID
LEFT JOIN WORK_EFFORT_ASSOC_VIEW WEA ON WEA.WE_TO_ID = WE.WORK_EFFORT_ID 
	AND WEA.WE_FROM_TYPE_ID = WA.WORK_EFFORT_TYPE_ID_REF
WHERE WE.WORK_EFFORT_ID = ? AND WEA.WE_TO_CODE = ?
	  AND WEA.WE_FROM_TYPE_ETCH = 'Servizio'
	  AND WEA.WA_FROM_DATE <= @date3112
	  AND WEA.WA_THRU_DATE >= @date0101
	@workEffortRevisionId]]></xml-property>
