MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3006  THEN TM_DESCRIPTION ELSE NULL END)  "ACTUAL_ACC_TRN_ENTRY_ABB_3006",  
