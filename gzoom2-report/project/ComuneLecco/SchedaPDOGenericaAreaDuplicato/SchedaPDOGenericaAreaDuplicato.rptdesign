                    <property name="name">RICHIESTA</property>
                    <property name="nativeName">RICHIESTA</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">STATO_RICHIESTA</property>
                    <property name="nativeName">STATO_RICHIESTA</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">RISPOSTA</property>
                    <property name="nativeName">RISPOSTA</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">COUNTER</property>
                    <property name="nativeName">COUNTER</property>
                    <property name="dataType">decimal</property>
                    <property name="nativeDataType">-5</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT  P_UO.PARTY_NAME AS "CENTRO_DI_COSTO", 
	    W.WORK_EFFORT_NAME AS "OBIETTIVO",  
	    ATT.WORK_EFFORT_NAME AS "ATTIVITA",
	    A_CDC.COMMENTS AS "RICHIESTA", 
	    E.DESCRIPTION AS "STATO_RICHIESTA", 
	    A_CDC.NOTE AS "RISPOSTA",
	    COUNT(*) AS "COUNTER"

FROM    WORK_EFFORT W
JOIN    PARTY P_UO
ON      P_UO.PARTY_ID = W.ORG_UNIT_ID
JOIN    WORK_EFFORT_ASSOC  A
ON      A.WORK_EFFORT_ID_FROM = W.WORK_EFFORT_ID
JOIN     WORK_EFFORT ATT
ON       ATT.WORK_EFFORT_ID = A.WORK_EFFORT_ID_TO
JOIN     WORK_EFFORT_ASSOC_TYPE   ATT_AT
ON       ATT_AT.WORK_EFFORT_ASSOC_TYPE_ID = A.WORK_EFFORT_ASSOC_TYPE_ID
AND     (ATT_AT.PARENT_TYPE_ID = 'HIE' AND W.WORK_EFFORT_PARENT_ID = ATT.WORK_EFFORT_PARENT_ID)
AND      (A.THRU_DATE = W.ESTIMATED_COMPLETION_DATE OR A.THRU_DATE = ATT.ESTIMATED_COMPLETION_DATE)
JOIN     WORK_EFFORT_ASSOC A_CDC
ON       A_CDC.WORK_EFFORT_ID_FROM = ATT.WORK_EFFORT_ID
JOIN     WORK_EFFORT        W_CDC
ON       W_CDC.WORK_EFFORT_ID = A_CDC.WORK_EFFORT_ID_TO 
AND     (A_CDC.THRU_DATE = W_CDC.ESTIMATED_COMPLETION_DATE OR A_CDC.THRU_DATE = ATT.ESTIMATED_COMPLETION_DATE)
JOIN     WORK_EFFORT_ASSOC_TYPE   W_CDC_AT
ON       W_CDC_AT.WORK_EFFORT_ASSOC_TYPE_ID = A_CDC.WORK_EFFORT_ASSOC_TYPE_ID
AND      W_CDC_AT.has_response = 'Y'
LEFT OUTER JOIN ENUMERATION E
ON   E.ENUM_ID =   A_CDC.RESPONSE_ENUM_ID  

WHERE W_CDC.ORG_UNIT_ID = ?
AND ATT.ESTIMATED_COMPLETION_DATE >= ? AND ATT.ESTIMATED_START_DATE <= ?

GROUP BY P_UO.PARTY_NAME, W.WORK_EFFORT_NAME,  ATT.WORK_EFFORT_NAME, A_CDC.COMMENTS,
 E.DESCRIPTION, A_CDC.NOTE,ATT.ESTIMATED_COMPLETION_DATE, ATT.ESTIMATED_START_DATE]]></xml-property>
        </oda-data-set>
