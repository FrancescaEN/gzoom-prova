                <structure>
                    <property name="position">31</property>
                    <property name="name">OB3_PT_DESCRIPTION</property>
                    <property name="nativeName">OB3_PT_DESCRIPTION</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">32</property>
                    <property name="name">ESTIMATED_START_DATE</property>
                    <property name="nativeName">ESTIMATED_START_DATE</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">33</property>
                    <property name="name">ESTIMATED_COMPLETION_DATE</property>
                    <property name="nativeName">ESTIMATED_COMPLETION_DATE</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">34</property>
                    <property name="name">OB2_ORG_UNIT_ID</property>
                    <property name="nativeName">OB2_ORG_UNIT_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">35</property>
                    <property name="name">CODE_PREFIX</property>
                    <property name="nativeName">CODE_PREFIX</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">36</property>
                    <property name="name">OB3_ESTIMATED_START_DATE</property>
                    <property name="nativeName">OB3_ESTIMATED_START_DATE</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">37</property>
                    <property name="name">OB3_ESTIMATED_COMPLETION_DATE</property>
                    <property name="nativeName">OB3_ESTIMATED_COMPLETION_DATE</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">38</property>
                    <property name="name">PUNTEGGIO_OB3</property>
                    <property name="nativeName">PUNTEGGIO_OB3</property>
                    <property name="dataType">float</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
	RADTC.ETCH AS "RAD_TITOLO", 
 	T_OB5.ETCH AS "ETICHETTA1",
 	T_OB4.ETCH AS "ETICHETTA2",
 	T_OB3.ETCH AS "ETICHETTA3", 	
 	A_OB5.SEQUENCE_NUM AS "A_OB1_SEQUENCE_NUM",
 	A_OB5.ASSOC_WEIGHT AS "A_OB1_ASSOC_WEIGHT",
 	OB5.ETCH AS  "AREA1",
 	OB5.WORK_EFFORT_NAME  AS  "AREA",
 	A_OB4.SEQUENCE_NUM		AS "A_OB2_SEQUENCE_NUM", 
 	A_OB4.ASSOC_WEIGHT AS "A_OB2_ASSOC_WEIGHT",
 	OB4.ETCH AS  "CENTRO_DI_RESPONSABILITA1",
 	OB4.WORK_EFFORT_NAME  AS  "CENTRO_DI_RESPONSABILITA",
  	
	RAD.WORK_EFFORT_NAME	AS  "TITOLO_RADICE" ,
	P_E.PARTY_NAME			AS  "NOME_ENTE",
  	P_RES_A.PARTY_NAME      AS    "RESPONSABILE_AREA",  
  	P_RES_C.PARTY_NAME      AS    "RESPONSABILE_CENT",  
	FIL_W.DESCRIPTION AS "DESCRIZIONE_OBIETTIVO",
	T_OB3.DESCRIPTION 		AS "TIPO",
	T_OB3.ETCH 		AS "ETCH",
	FIL_W.ETCH AS "ATTIVITA_OBIETTIVO1",
 	FIL_W.WORK_EFFORT_NAME AS "ATTIVITA_OBIETTIVO",
  	P_R_UO.PARTY_NAME  		AS "RESP_TEC_IN_CASO_MANC_DET",
  	OB5.SOURCE_REFERENCE_ID AS "OB1_SOURCE_REFERENCE_ID",
 	OB5.WORK_EFFORT_ID 		AS "OB1_WORK_EFFORT_ID",
 	
 	OB4.SOURCE_REFERENCE_ID AS "OB2_SOURCE_REFERENCE_ID",
 	OB4.WORK_EFFORT_ID 		AS "OB2_WORK_EFFORT_ID",
 	A_OB3.SEQUENCE_NUM		AS "A_OB3_SEQUENCE_NUM" , 
 	FIL_W.SOURCE_REFERENCE_ID AS "OB3_OURCE_REFERENCE_ID",	
 	FIL_W.WORK_EFFORT_ID 		AS "OB3_WORK_EFFORT_ID",
 	FIL_W.WORK_EFFORT_TYPE_ID	AS "OB3_WORK_EFFORT_TYPE_ID",
 	PT_OB3.DESCRIPTION 		AS "OB3_PT_DESCRIPTION",
 	RAD.ESTIMATED_START_DATE 	AS  "ESTIMATED_START_DATE",
	RAD.ESTIMATED_COMPLETION_DATE	AS  "ESTIMATED_COMPLETION_DATE",
	OB4.ORG_UNIT_ID AS "OB2_ORG_UNIT_ID",
	T_OB3.CODE_PREFIX AS "CODE_PREFIX",
	FIL_W.ESTIMATED_START_DATE AS "OB3_ESTIMATED_START_DATE",      
	FIL_W.ESTIMATED_COMPLETION_DATE AS "OB3_ESTIMATED_COMPLETION_DATE",
	-- PUNTEGGIO
	MAX(CASE WHEN I3.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN I3.AMOUNT ELSE NULL END) "PUNTEGGIO_OB3"
 	
FROM WORK_EFFORT_TYPE     T_RAD
JOIN WORK_EFFORT          RAD
ON   T_RAD.WORK_EFFORT_TYPE_ID = RAD.WORK_EFFORT_TYPE_ID 
AND  T_RAD.IS_ROOT             = 'Y'    
AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND( RAD.ESTIMATED_START_DATE      <= @date3112 AND RAD.ESTIMATED_COMPLETION_DATE >= @date0101 ))) 
INNER JOIN WORK_EFFORT_TYPE_CONTENT RADTC ON RADTC.WORK_EFFORT_TYPE_ID = RAD.WORK_EFFORT_TYPE_ID
		AND RADTC.CONTENT_ID = @reportContentId

JOIN WORK_EFFORT_ASSOC A_OB1 
     ON  A_OB1.WORK_EFFORT_ID_FROM       = RAD.WORK_EFFORT_ID

JOIN WORK_EFFORT_ASSOC_TYPE TA_OB1 ON TA_OB1.WORK_EFFORT_ASSOC_TYPE_ID = A_OB1.WORK_EFFORT_ASSOC_TYPE_ID
JOIN WORK_EFFORT OB1
     ON  A_OB1.WORK_EFFORT_ID_TO         = OB1.WORK_EFFORT_ID
     AND  (A_OB1.THRU_DATE = OB1.ESTIMATED_COMPLETION_DATE   OR
           A_OB1.THRU_DATE = RAD.ESTIMATED_COMPLETION_DATE)
AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND( OB1.ESTIMATED_START_DATE      <= @date3112 AND OB1.ESTIMATED_COMPLETION_DATE >= @date0101 )))

JOIN WORK_EFFORT_TYPE  T_OB1
     ON  T_OB1.WORK_EFFORT_TYPE_ID       = OB1.WORK_EFFORT_TYPE_ID

JOIN WORK_EFFORT_ASSOC A_OB2 
     ON  A_OB2.WORK_EFFORT_ID_FROM       = OB1.WORK_EFFORT_ID

JOIN WORK_EFFORT_ASSOC_TYPE TA_OB2 ON TA_OB2.WORK_EFFORT_ASSOC_TYPE_ID = A_OB2.WORK_EFFORT_ASSOC_TYPE_ID    
JOIN WORK_EFFORT       OB2
     ON  A_OB2.WORK_EFFORT_ID_TO  = OB2.WORK_EFFORT_ID
     AND  (A_OB2.THRU_DATE = OB1.ESTIMATED_COMPLETION_DATE   OR
           A_OB2.THRU_DATE = OB2.ESTIMATED_COMPLETION_DATE)
AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND( OB2.ESTIMATED_START_DATE      <= @date3112 AND OB2.ESTIMATED_COMPLETION_DATE >= @date0101 )))

JOIN WORK_EFFORT_TYPE  T_OB2 
     ON  T_OB2.WORK_EFFORT_TYPE_ID       = OB2.WORK_EFFORT_TYPE_ID
JOIN WORK_EFFORT_ASSOC A_OB3 
     ON  A_OB3.WORK_EFFORT_ID_FROM       = OB2.WORK_EFFORT_ID
JOIN WORK_EFFORT_ASSOC_TYPE TA_OB3 ON TA_OB3.WORK_EFFORT_ASSOC_TYPE_ID = A_OB3.WORK_EFFORT_ASSOC_TYPE_ID

JOIN WORK_EFFORT       FIL_W
     ON  A_OB3.WORK_EFFORT_ID_TO  = FIL_W.WORK_EFFORT_ID
     AND  (A_OB3.THRU_DATE = OB2.ESTIMATED_COMPLETION_DATE   OR
           A_OB3.THRU_DATE = FIL_W.ESTIMATED_COMPLETION_DATE)
AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND( FIL_W.ESTIMATED_START_DATE      <= @date3112 AND FIL_W.ESTIMATED_COMPLETION_DATE >= @date0101    )))

JOIN WORK_EFFORT_PURPOSE_TYPE PT_OB3 ON PT_OB3.WORK_EFFORT_PURPOSE_TYPE_ID = FIL_W.WORK_EFFORT_PURPOSE_TYPE_ID

JOIN WORK_EFFORT_TYPE  T_OB3 
     ON  T_OB3.WORK_EFFORT_TYPE_ID       = FIL_W.WORK_EFFORT_TYPE_ID
     


join work_effort_assoc A_OB4 on A_OB4.work_effort_id_to = FIL_W.work_effort_id and A_OB4.work_effort_assoc_type_id = '15PM09OB'
JOIN WORK_EFFORT_ASSOC_TYPE TA_OB4 ON TA_OB4.WORK_EFFORT_ASSOC_TYPE_ID = A_OB4.WORK_EFFORT_ASSOC_TYPE_ID
join work_effort OB4 ON  A_OB4.WORK_EFFORT_ID_FROM  = OB4.WORK_EFFORT_ID
JOIN WORK_EFFORT_TYPE  T_OB4 ON  T_OB4.WORK_EFFORT_TYPE_ID       = OB4.WORK_EFFORT_TYPE_ID
join work_effort_assoc A_OB5 on A_OB5.work_effort_id_to = OB4.work_effort_id and A_OB5.work_effort_assoc_type_id = '15PEG'
JOIN WORK_EFFORT_ASSOC_TYPE TA_OB5 ON TA_OB5.WORK_EFFORT_ASSOC_TYPE_ID = A_OB5.WORK_EFFORT_ASSOC_TYPE_ID
join work_effort OB5 ON  A_OB5.WORK_EFFORT_ID_FROM  = OB5.WORK_EFFORT_ID
JOIN WORK_EFFORT_TYPE  T_OB5 ON  T_OB5.WORK_EFFORT_TYPE_ID       = OB5.WORK_EFFORT_TYPE_ID


JOIN            PARTY P_E    
     ON P_E.PARTY_ID  = RAD.ORGANIZATION_ID    

@filterInnerJoin
@filterLeftJoin
     
LEFT OUTER JOIN PARTY_RELATIONSHIP R_R_UO
ON   R_R_UO.PARTY_ID_FROM     = FIL_W.ORG_UNIT_ID
AND  R_R_UO.ROLE_TYPE_ID_FROM = FIL_W.ORG_UNIT_ROLE_TYPE_ID
AND  R_R_UO.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
AND (@excludeValidity = 'N' OR (@excludeValidity = 'Y' AND(R_R_UO.THRU_DATE IS NULL)))
AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND( R_R_UO.FROM_DATE  <= @monitoringDate AND (R_R_UO.THRU_DATE  >= @monitoringDate OR  R_R_UO.THRU_DATE IS NULL))))  

LEFT OUTER JOIN  PARTY P_R_UO
ON      P_R_UO.PARTY_ID = R_R_UO.PARTY_ID_TO 

--  13/4/2012 INIZIO
LEFT OUTER JOIN PARTY_RELATIONSHIP PR_RES_A
     ON  PR_RES_A.PARTY_ID_FROM              = OB5.ORG_UNIT_ID
     AND PR_RES_A.ROLE_TYPE_ID_FROM          = OB5.ORG_UNIT_ROLE_TYPE_ID
     AND PR_RES_A.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
AND (@excludeValidity = 'N' OR (@excludeValidity = 'Y' AND PR_RES_A.THRU_DATE IS NULL))
AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND(PR_RES_A.FROM_DATE   <= @monitoringDate AND (PR_RES_A.THRU_DATE  >= @monitoringDate OR PR_RES_A.THRU_DATE IS NULL)  )))

LEFT OUTER JOIN PARTY  P_RES_A
     ON P_RES_A.PARTY_ID = PR_RES_A.PARTY_ID_TO
LEFT OUTER JOIN PARTY_RELATIONSHIP PR_RES_C
     ON  PR_RES_C.PARTY_ID_FROM              = OB2.ORG_UNIT_ID
     AND PR_RES_C.ROLE_TYPE_ID_FROM          = OB2.ORG_UNIT_ROLE_TYPE_ID
     AND PR_RES_C.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
AND (@excludeValidity = 'N' OR (@excludeValidity = 'Y' AND(PR_RES_C.THRU_DATE          IS NULL)))
AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND( PR_RES_C.FROM_DATE   <= @monitoringDate AND (PR_RES_C.THRU_DATE  >= @monitoringDate OR PR_RES_C.THRU_DATE IS NULL) )))

LEFT OUTER JOIN PARTY  P_RES_C
     ON P_RES_C.PARTY_ID = PR_RES_C.PARTY_ID_TO


-- PUNTEGGIO 
	LEFT OUTER JOIN (
		  SELECT Q3.WORK_EFFORT_ID, Q3.TRANSACTION_DATE, R3.AMOUNT, R3.GL_FISCAL_TYPE_ID, R3.HAS_SCORE_ALERT, Q3.DESCRIPTION
		  FROM ACCTG_TRANS Q3 
		  INNER JOIN ACCTG_TRANS_ENTRY R3 ON Q3.ACCTG_TRANS_ID = R3.ACCTG_TRANS_ID
		  WHERE R3.GL_ACCOUNT_ID = 'SCORE' 
			AND Q3.TRANSACTION_DATE = @monitoringDate
			AND (R3.GL_FISCAL_TYPE_ID = 'ACTUAL')
					 ) I3 ON I3.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID 
						 	 
WHERE  (@workEffortId IS NULL OR @workEffortId = '' OR RAD.WORK_EFFORT_ID = @workEffortId )
		AND (@partyId IS NULL OR @partyId = '' OR P_RES_A.PARTY_ID = @partyId OR P_RES_C.PARTY_ID = @partyId)
		AND (@orgUnitId IS NULL OR @orgUnitId = '' OR OB1.ORG_UNIT_ID = @orgUnitId OR OB2.ORG_UNIT_ID = @orgUnitId )
		AND (? IS NULL OR ? = '' OR OB2.WORK_EFFORT_ID = ? )
	    AND ( T_OB3.CODE_PREFIX LIKE 'O%' OR T_OB3.CODE_PREFIX LIKE 'A%' )
		AND ( T_OB3.CODE_PREFIX LIKE ? )
		AND (RAD.WORK_EFFORT_TYPE_ID = @workEffortTypeId OR OB1.WORK_EFFORT_TYPE_ID = @workEffortTypeId OR OB2.WORK_EFFORT_TYPE_ID = @workEffortTypeId OR FIL_W.WORK_EFFORT_TYPE_ID = @workEffortTypeId)
		AND (? IS NULL OR ? = '' OR FIL_W.WORK_EFFORT_ID = ? OR OB1.WORK_EFFORT_ID = ? OR OB2.WORK_EFFORT_ID = ? )              
		
		AND ((RAD.WEIGHT_SONS > 0 
        	AND OB1.WORK_EFFORT_PARENT_ID = RAD.WORK_EFFORT_PARENT_ID)
			    OR (RAD.WEIGHT_ASSOC_WORK_EFFORT > 0 AND A_OB1.WORK_EFFORT_ASSOC_TYPE_ID = RAD.WORK_EFFORT_ASSOC_TYPE_ID))
    
	     AND ((OB1.WEIGHT_SONS > 0 
               AND OB2.WORK_EFFORT_PARENT_ID = OB1.WORK_EFFORT_PARENT_ID)
		    OR (OB1.WEIGHT_ASSOC_WORK_EFFORT > 0 AND A_OB2.WORK_EFFORT_ASSOC_TYPE_ID = OB1.WORK_EFFORT_ASSOC_TYPE_ID))
    
		-- AND ((OB2.WEIGHT_SONS > 0 AND TA_OB3.PARENT_TYPE_ID = 'HIE'
        --       AND FIL_W.WORK_EFFORT_PARENT_ID = OB2.WORK_EFFORT_PARENT_ID)
		--    OR (OB2.WEIGHT_ASSOC_WORK_EFFORT > 0 AND A_OB3.WORK_EFFORT_ASSOC_TYPE_ID = OB2.WORK_EFFORT_ASSOC_TYPE_ID))
	
	

	AND T_OB3.ETCH <> 'Attività strutturali'
	and T_OB3.ETCH <> 'Processo'
	-- FILTRI DATI STORICI
	@workEffortRevisionId
	@filterWhere
	
group BY
	 RADTC.ETCH,
	T_OB5.ETCH,
 	T_OB4.ETCH,
 	T_OB3.ETCH, 
 	A_OB5.SEQUENCE_NUM,
 	A_OB5.ASSOC_WEIGHT,
 	OB5.ETCH,
 	OB5.WORK_EFFORT_NAME,
 	A_OB4.SEQUENCE_NUM, 
 	A_OB4.ASSOC_WEIGHT, 	
 	OB4.ETCH,
 	OB4.WORK_EFFORT_NAME,  	
	RAD.WORK_EFFORT_NAME,
	P_E.PARTY_NAME,
  	P_RES_A.PARTY_NAME,  
  	P_RES_C.PARTY_NAME,  
	FIL_W.DESCRIPTION,
	PT_OB3.DESCRIPTION,
	T_OB3.DESCRIPTION,
	T_OB3.ETCH,
	FIL_W.ETCH,
 	FIL_W.WORK_EFFORT_NAME,
  	P_R_UO.PARTY_NAME,
  	OB5.SOURCE_REFERENCE_ID,
 	OB5.WORK_EFFORT_ID, 	
 	OB4.SOURCE_REFERENCE_ID,
 	OB4.WORK_EFFORT_ID,
 	A_OB3.SEQUENCE_NUM, 
 	FIL_W.SOURCE_REFERENCE_ID,	
 	FIL_W.WORK_EFFORT_ID,
 	FIL_W.WORK_EFFORT_TYPE_ID, 	
 	RAD.ESTIMATED_START_DATE,
	RAD.ESTIMATED_COMPLETION_DATE,
	OB4.ORG_UNIT_ID,
	T_OB3.CODE_PREFIX,
	FIL_W.ESTIMATED_START_DATE,     
	FIL_W.ESTIMATED_COMPLETION_DATE]]></xml-property>
            <xml-property name="designerValues"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<model:DesignValues xmlns:design="http://www.eclipse.org/datatools/connectivity/oda/design" xmlns:model="http://www.eclipse.org/birt/report/model/adapter/odaModel">
