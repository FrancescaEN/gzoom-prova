                </structure>
                <structure>
                    <property name="position">19</property>
                    <property name="name">ETCH</property>
                    <property name="nativeName">ETCH</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">20</property>
                    <property name="name">ATTIVITA_OBIETTIVO1</property>
                    <property name="nativeName">ATTIVITA_OBIETTIVO1</property>
