        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="FasiDSAnnoPiuUno" id="55212">
            <property name="nullsOrdering">nulls lowest</property>
            <list-property name="computedColumns">
                <structure>
                    <property name="name">START_MONTH</property>
                    <expression name="expression">BirtDateTime.month(row["START_DATE"])</expression>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="name">END_MONTH</property>
                    <expression name="expression">BirtDateTime.month(row["COMPLETATION_DATE"])</expression>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="name">TITOLO_CONCAT</property>
                    <expression name="expression">row["TITOLO1"] != null &amp;&amp; row["TITOLO1"] != ' ' ? row["TITOLO1"] + ' - ' + row["TITOLO"] : row["TITOLO"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">JAN_AMOUNT_ACTUAL_FILTER</property>
                    <expression name="expression">row["TIPO_ESPOSIZIONE"] == 'SN' ? row["JAN_AMOUNT_ACTUAL"] == 0 ? 'X' : ' ' : row["JAN_AMOUNT_ACTUAL"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">FEB_AMOUNT_ACTUAL_FILTER</property>
                    <expression name="expression">row["TIPO_ESPOSIZIONE"] == 'SN' ? row["FEB_AMOUNT_ACTUAL"] == 0 ? 'X' : ' ' : row["FEB_AMOUNT_ACTUAL"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">MAR_AMOUNT_ACTUAL_FILTER</property>
                    <expression name="expression">row["TIPO_ESPOSIZIONE"] == 'SN' ? row["MAR_AMOUNT_ACTUAL"] == 0 ? 'X' : ' ' : row["MAR_AMOUNT_ACTUAL"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">APR_AMOUNT_ACTUAL_FILTER</property>
                    <expression name="expression">row["TIPO_ESPOSIZIONE"] == 'SN' ? row["APR_AMOUNT_ACTUAL"] == 0 ? 'X' : ' ' : row["APR_AMOUNT_ACTUAL"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">MAY_AMOUNT_ACTUAL_FILTER</property>
                    <expression name="expression">row["TIPO_ESPOSIZIONE"] == 'SN' ? row["MAY_AMOUNT_ACTUAL"] == 0 ? 'X' : ' ' : row["MAY_AMOUNT_ACTUAL"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">JUN_AMOUNT_ACTUAL_FILTER</property>
                    <expression name="expression">row["TIPO_ESPOSIZIONE"] == 'SN' ? row["JUN_AMOUNT_ACTUAL"] == 0 ? 'X' : ' ' : row["JUN_AMOUNT_ACTUAL"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">JUL_AMOUNT_ACTUAL_FILTER</property>
                    <expression name="expression">row["TIPO_ESPOSIZIONE"] == 'SN' ? row["JUL_AMOUNT_ACTUAL"] == 0 ? 'X' : ' ' : row["JUL_AMOUNT_ACTUAL"]</expression>
                    <property name="dataType">string</property>
                </structure>
