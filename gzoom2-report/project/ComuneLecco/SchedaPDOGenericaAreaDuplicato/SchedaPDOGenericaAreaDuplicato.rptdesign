                    <property name="position">5</property>
                    <property name="name">PROFILO</property>
                    <property name="nativeName">PROFILO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">CATEGORIA</property>
                    <property name="nativeName">CATEGORIA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">PER_PR</property>
                    <property name="nativeName">PER_PR</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">SOMMA_IMPIEGATO</property>
                    <property name="nativeName">SOMMA_IMPIEGATO</property>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="position">9</property>
                    <property name="name">CDR_APPARTENENZA</property>
                    <property name="nativeName">CDR_APPARTENENZA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">10</property>
                    <property name="name">ANNI_PERSONA</property>
                    <property name="nativeName">ANNI_PERSONA</property>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="position">11</property>
                    <property name="name">COUNTER</property>
                    <property name="nativeName">COUNTER</property>
                    <property name="dataType">decimal</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
PA.PARTY_ID          AS  "ID_DIPENDENTE",
PPR.PARENT_ROLE_CODE AS  "MATRICOLA",
PA.PARTY_NAME        AS  "DIPENDENTE",
PA1.PARTY_ID         AS  "ID_PROFILO",
PA1.PARTY_NAME       AS  "PROFILO",
E.DESCRIPTION 	     AS  "CATEGORIA", 
PE.EMPLOYMENT_AMOUNT AS  "PER_PR",   
SUM(ROLE_TYPE_WEIGHT)  AS "SOMMA_IMPIEGATO",
P_UO.PARTY_NAME  AS   "CDR_APPARTENENZA",

CASE WHEN (PE.EMPLOYMENT_AMOUNT IS NOT NULL AND WA.ROLE_TYPE_WEIGHT IS NOT NULL) 
	THEN (SUM(PE.EMPLOYMENT_AMOUNT*WA.ROLE_TYPE_WEIGHT/100)/100) ELSE 0.0 END "ANNI_PERSONA",
COUNT(*) AS "COUNTER"

FROM WORK_EFFORT W1
INNER JOIN WORK_EFFORT W2 ON W1.WORK_EFFORT_ID = W2.WORK_EFFORT_PARENT_ID
INNER JOIN WORK_EFFORT_PARTY_ASSIGNMENT WA ON W2.WORK_EFFORT_ID = WA.WORK_EFFORT_ID

JOIN        PARTY                       PA 
ON          WA.PARTY_ID = PA.PARTY_ID
JOIN		PARTY_PARENT_ROLE 			PPR
ON			PPR.PARTY_ID = PA.PARTY_ID
JOIN        PERSON                      PE
ON          WA.PARTY_ID = PE.PARTY_ID
LEFT OUTER
JOIN        EMPL_POSITION_TYPE         E
ON          E.EMPL_POSITION_TYPE_ID = PE.EMPL_POSITION_TYPE_ID
LEFT OUTER  
JOIN        PARTY_RELATIONSHIP         PR
ON          PR.PARTY_ID_FROM              = WA.PARTY_ID
AND         PR.PARTY_RELATIONSHIP_TYPE_ID = 'QUALIF'
AND PR.FROM_DATE <= @monitoringDate
AND (PR.THRU_DATE IS null OR PR.THRU_DATE >= @monitoringDate)
LEFT OUTER  
JOIN        PARTY                      PA1
ON          PR.PARTY_ID_TO = PA1.PARTY_ID
LEFT OUTER JOIN PARTY_RELATIONSHIP PR_UO
ON      PR_UO.PARTY_ID_TO = WA.PARTY_ID
AND     PR_UO.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_EMPLOYMENT'
AND PR_UO.FROM_DATE <= @monitoringDate
AND (PR_UO.THRU_DATE IS null OR PR_UO.THRU_DATE >= @monitoringDate)
LEFT OUTER JOIN PARTY              P_UO
ON      P_UO.PARTY_ID = PR_UO.PARTY_ID_FROM
WHERE       WA.ROLE_TYPE_ID = 'WE_ASSIGNMENT' AND   W1.SOURCE_REFERENCE_ID = ?
AND W2.WORK_EFFORT_SNAPSHOT_ID IS NULL
AND WA.WORK_EFFORT_ID_FROM IS NULL
AND (WA.FROM_DATE <= ? AND WA.THRU_DATE >= ?)

GROUP BY 
PA.PARTY_ID,
PA.PARTY_NAME,
PA1.PARTY_ID,
PA1.PARTY_NAME,
E.DESCRIPTION , 
P_UO.PARTY_NAME,
PPR.PARENT_ROLE_CODE,
PE.EMPLOYMENT_AMOUNT,
WA.ROLE_TYPE_WEIGHT

ORDER BY    PA.PARTY_NAME, PA1.PARTY_NAME
]]></xml-property>
        </oda-data-set>
