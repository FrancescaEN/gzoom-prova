            <xml-property name="queryText"><![CDATA[SELECT M_WORK_EFFORT_MEASURE_ID AS "M_WORK_EFFORT_MEASURE_ID", 
	   GT.DESCRIPTION AS "DESCRIPTION", 
	   G_ACCOUNT_NAME AS "G_ACCOUNT_NAME",
	   G_DESCRIPTION AS "G_DESCRIPTION", 
