	</parameter>
	<parameter name="customTimePeriodSql" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[SUBSTITUTE(com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc($P{customTimePeriod}, $P{odaDialect}),"'","")]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	$P{YEAR} as "Anno",
	-- paca inizio
	area.parent_role_code as "Area Codice",
	area.party_name as "Area Descrizione",
	-- paca fine
	max(case when wetav.g_account_code = 'CARPRO.05' then wetav.r_uom_descr else null end) as "Classificazione processi caratteristici o di supporto. Funzioni accorpate con altre",
	max(case when wetav.g_account_code = 'CARPRO.01' then wetav.r_uom_descr else null end) as "Processi connessi ad attività di regolazione",
	max(case when wetav.g_account_code = 'CARPRO.02' then wetav.r_uom_descr else null end) as "Processi connessi ad attività di pianificazione",
	max(case when wetav.g_account_code = 'CARPRO.03' then wetav.r_uom_descr else null end) as "Processi connessi ad attività di programmazione",
	max(case when wetav.g_account_code = 'CARPRO.04' then wetav.r_uom_descr else null end) as "Processi con utenza esterna",
	macrop.source_reference_id as "Cod. Macroprocesso",
	macrop.work_effort_name as "Macroprocesso",
	fil_w.source_reference_id as "Cod. Processo",
	fil_w.work_effort_name as "Processo",
	max(case when wetav.g_account_code = 'CARPRO.06' then wetav.r_uom_descr else null end) as "Processi non coincidenti con classificazione contabile",
	concat(pe.first_name,' ',pe.last_name) as "Dirigente responsabile",
	macroattivita.macro as "Macro Attività",
	cdcosto.centrod as "Centri di Costo",
	fil_w.work_effort_id as "Id Processo",
	-- paca-V03  INZIIO
     V.note_info as "Descrizione" 
     -- paca-V03 FINE
from
	work_effort fil_w
		-- paca inizio
join  party_role_view area on  area.party_id = fil_w.org_unit_id and area.role_type_id = fil_w.org_unit_role_type_id 
-- paca fine
left join work_effort_assoc from_macrop on
	from_macrop.work_effort_id_to = fil_w.work_effort_id
	and from_macrop.work_effort_assoc_type_id = '24MPORG'
inner join work_effort macrop on
	macrop.work_effort_id = from_macrop.work_effort_id_from
-- paca-V03 INIZIO 
left join  work_effort_note_view V
on    V.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
and   V.NOTE_NAME = 'Descrizione'
-- paca-V03 FINE 
left join work_effort_trans_all_view wetav on
	wetav.m_work_effort_id = fil_w.work_effort_id
left join party_relationship pr on
	pr.party_id_from = fil_w.org_unit_id
	and PR.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
	and pr.FROM_DATE <= fil_w.ESTIMATED_COMPLETION_DATE
	and (pr.THRU_DATE is null
		or pr.THRU_DATE >= fil_w.ESTIMATED_COMPLETION_DATE)
	--and (pr.from_date<current_date and pr.thru_date>current_date)
inner join person pe on
	pr.party_id_to = pe.party_id
/* START filterInnerJoin */
	$P!{filterInnerJoinString} 
/* END filterInnerJoin */
/* START filterLeftJoin */
	$P!{filterLeftJoinString} 
/* END filterLeftJoin */
left join (select string_agg(concat('- ',macro.work_effort_name),'
') as macro, macro.work_effort_parent_id 
from work_effort macro where macro.work_effort_type_id='24MAC01'
group by macro.work_effort_parent_id
) macroattivita on macroattivita.work_effort_parent_id=fil_w.work_effort_id
left join (select string_agg(concat('- ',centrod.work_effort_name),'
') as centrod, centrod.work_effort_parent_id 
from work_effort centrod where centrod.work_effort_type_id='24CDC1'
group by centrod.work_effort_parent_id
) cdcosto on cdcosto.work_effort_parent_id=fil_w.work_effort_id
where fil_w.work_effort_type_id='24M08'
and fil_w.estimated_completion_date>=  $P{date0101}   -- condizione per non mostrare i processi portati a scadenza
and fil_w.estimated_start_date<=  $P{date3112} 
$P!{orgUnitIdString}
 $P!{workEffortIdString} 
 /* START filterWhere */
 $P!{filterWhereString} 
   /* END filterWhere */
group by
-- paca inizio
 area.parent_role_code ,
area.party_name ,
-- paca fine 
fil_w.etch,fil_w.work_effort_name,macroattivita.macro,cdcosto.centrod, fil_w.source_reference_id, macrop.source_reference_id, macrop.work_effort_name, pe.first_name,pe.last_name,fil_w.work_effort_id,v.note_info
order by 
-- paca inizio
 area.parent_role_code ,
-- paca fine
fil_w.source_reference_id]]>
	</queryString>
