	<parameter name="date3009sql" class="java.lang.String" isForPrompting="false"/>
	<parameter name="exposePaginator" class="java.lang.String" isForPrompting="false"/>
	<parameter name="YEAR" class="java.lang.Integer"/>
	<parameter name="idProcesso" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT
macro.etch as "Etichetta Macro",
macro.work_effort_name AS "Macro Attività",
proant.work_effort_name AS "Collegamento con processi/fasi/attività Anticorruzione",
MAX(CASE WHEN wen.sequence_id = 10 THEN nd.note_info ELSE NULL END) AS "Descrizione eventuali criticità",
MAX(CASE WHEN wen.sequence_id = 20 THEN nd.note_info ELSE NULL END) AS "Descrizione proposte di miglioramento"
FROM work_effort macro
INNER JOIN work_effort proce ON proce.work_effort_id = macro.work_effort_parent_id
LEFT JOIN work_effort_assoc wea ON wea.work_effort_id_to = macro.work_effort_id AND wea.work_effort_assoc_type_id = '24MACRAT_PROC_COR'
LEFT JOIN work_effort proant ON proant.work_effort_id = wea.work_effort_id_from
LEFT JOIN work_effort_note wen ON wen.work_effort_id = macro.work_effort_id
LEFT JOIN note_data nd ON nd.note_id = wen.note_id and extract(year from nd.note_date_time) = $P{YEAR} 
WHERE macro.work_effort_type_id = '24MAC01'
  --AND proce.source_reference_id = 'P01.1'
  AND macro.estimated_completion_date >=   $P{date0101} 
  and macro.estimated_start_date<=   $P{date3112} 
  and proce.work_effort_id= $P{idProcesso} 
GROUP BY macro.work_effort_name, proce.work_effort_name, proce.etch, proant.work_effort_name,macro.etch,PROCE.WORK_EFFORT_ID
ORDER BY macro.etch]]>
	</queryString>
