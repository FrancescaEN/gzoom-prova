	<parameter name="date3009sql" class="java.lang.String" isForPrompting="false"/>
	<parameter name="exposePaginator" class="java.lang.String" isForPrompting="false"/>
	<parameter name="YEAR" class="java.lang.Integer"/>
	<parameter name="idProcesso" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select
cdc.work_effort_name as "Nome centro di costo",
miss.work_effort_name as "Missione",
progr.work_effort_name as "Programma",
max(case when wetav.g_account_code='CDCFIN.01' then wetav.tm_amount else null end) as "TOT Entrate",
max(case when wetav.g_account_code='CDCFIN.02' then wetav.tm_amount else null end) as "TOT Spese",
max(case when wetav.g_account_code='CDCFIN.02' then wetav.tm_amount else null end) as "Delta",
max(case when wen.sequence_id='10' then nd.note_info else null end) as "Note"
from work_effort proce
left join work_effort cdc on cdc.work_effort_parent_id=proce.work_effort_id and cdc.work_effort_type_id ='24CDC1'
left join work_effort_trans_all_view wetav on wetav.m_work_effort_id=cdc.work_effort_id and extract(year from wetav.tt_transaction_date) = $P{YEAR}
left join work_effort_purpose_account wepa on wepa.gl_account_id=wetav.m_gl_account_id and wepa.work_effort_purpose_type_id = 'CDCFIN'
left join work_effort_note wen on wen.work_effort_id =cdc.work_effort_id 
left join note_data nd on nd.note_id=wen.note_id and extract(year from nd.note_date_time) =  $P{YEAR} 
left join work_effort_assoc wea on wea.work_effort_id_to=cdc.work_effort_id and wea.work_effort_assoc_type_id ='24CDCPROGR'
left join work_effort progr on progr.work_effort_id =wea.work_effort_id_from
left join work_effort_assoc wea2 on wea2.work_effort_id_to=progr.work_effort_id and wea2.work_effort_assoc_type_id='15BIL' and wea2.from_date<= $P{date3112} and wea2.thru_date>= $P{date0101} 
left join work_effort miss on miss.work_effort_id=wea2.work_effort_id_from
where proce.work_effort_type_id='24M08'
--and proce.source_reference_id='P01.2'
and cdc.estimated_completion_date>=  $P{date0101}  -- condizione per non mostrare i processi portati a scadenza
and cdc.estimated_start_date<=  $P{date3112} 
and proce.work_effort_id= $P{idProcesso} 
group by proce.etch,proce.work_effort_name,cdc.work_effort_name,progr.work_effort_name, miss.work_effort_name
order by proce.etch]]>
	</queryString>
