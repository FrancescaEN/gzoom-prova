	<queryString language="SQL">
		<![CDATA[select
wetav.m_work_effort_id as Id_Processo,
wetav.w_source_reference_id as Codice_Processo,
TO_CHAR(wetav.tt_transaction_date, 'YYYY') AS anno,
MAX(case WHEN wetav.tm_gl_fiscal_type_id = 'ACTUAL' AND wetav.m_gl_account_id = '10718' THEN wetav.tm_amount ELSE 0 END) AS Entrate_Totali,
MAX(case WHEN wetav.tm_gl_fiscal_type_id = 'ACTUAL' AND wetav.m_gl_account_id = '10719' THEN wetav.tm_amount ELSE 0 END) AS Spese_Totali,
MAX(CASE WHEN wetav.tm_gl_fiscal_type_id = 'ACTUAL' AND wetav.m_gl_account_id = '10720' THEN wetav.tm_amount ELSE 0 END) AS Differenza_Spese_Entrate
FROM work_effort_trans_all_view wetav
JOIN work_effort_purpose_account wepa 
    ON wepa.gl_account_id = wetav.m_gl_account_id 
    AND wepa.work_effort_purpose_type_id = 'COGERSU'
JOIN gl_resource_type grt 
    ON grt.gl_resource_type_id = g_gl_resource_type_id
left JOIN gl_account ga 
    ON ga.gl_account_id = wetav.m_gl_account_id 
    AND ga.account_code IN ('GENPRO.15', 'GENPRO.16', 'GENPRO.17')
LEFT JOIN gl_account_class gac 
    ON gac.gl_account_class_id = ga.gl_account_class_id
WHERE wetav.tm_gl_fiscal_type_id = 'ACTUAL'
and TO_CHAR(wetav.tt_transaction_date, 'YYYY') <=  $P{YEAR} 
and wetav.m_work_effort_id = $P{idProcesso} 
GROUP BY wetav.m_work_effort_id,wetav.w_source_reference_id,TO_CHAR(wetav.tt_transaction_date, 'YYYY') 
ORDER BY anno;]]>
	</queryString>
