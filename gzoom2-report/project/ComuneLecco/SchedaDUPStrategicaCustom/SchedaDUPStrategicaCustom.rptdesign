            <method name="beforeOpen"><![CDATA[/**/
this.queryText = this.queryText.replace("@excludeValidity", "'" + params["excludeValidity"].value+ "'");
this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );

/*
this.queryText = this.queryText.replace("@excludeValidity",  "'N'" );
this.queryText = this.queryText.replace("@monitoringDate",  "'2021-12-31 00:00:00.000'");
*/

ReportLog.info("......this.queryText TEST"+this.queryText);
ReportLog.info("......this.queryText TESTPARAMS"+this.getInputParameters());]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">ETICHETTA2</property>
                    <property name="nativeName">ETICHETTA2</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">ETCH2</property>
                    <property name="nativeName">ETCH2</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">NAME2</property>
                    <property name="nativeName">NAME2</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">SEQUENCE_NUM</property>
                    <property name="nativeName">SEQUENCE_NUM</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">SOURCE_REFERENCE_ID</property>
                    <property name="nativeName">SOURCE_REFERENCE_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">WORK_EFFORT_ID</property>
                    <property name="nativeName">WORK_EFFORT_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">ESTIMATED_START_DATE2</property>
                    <property name="nativeName">ESTIMATED_START_DATE2</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">ESTIMATED_COMPLETION_DATE2</property>
                    <property name="nativeName">ESTIMATED_COMPLETION_DATE2</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">9</property>
                    <property name="name">NOTE_INFO2</property>
                    <property name="nativeName">NOTE_INFO2</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">10</property>
                    <property name="name">DESCRIPTION2</property>
                    <property name="nativeName">DESCRIPTION2</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 

       B2.ETCH AS "ETICHETTA2",
       A2.ETCH AS "ETCH2",
       A2.WORK_EFFORT_NAME AS "NAME2",
       Z2.SEQUENCE_NUM AS "SEQUENCE_NUM",
       A2.SOURCE_REFERENCE_ID AS "SOURCE_REFERENCE_ID",
       A2.WORK_EFFORT_ID AS "WORK_EFFORT_ID",
       A2.ESTIMATED_START_DATE AS "ESTIMATED_START_DATE2",
       A2.ESTIMATED_COMPLETION_DATE AS "ESTIMATED_COMPLETION_DATE2",
       ND2.NOTE_INFO AS "NOTE_INFO2",
       A2.DESCRIPTION AS "DESCRIPTION2"

	     
FROM  WORK_EFFORT RAD
      INNER JOIN WORK_EFFORT_TYPE RAT ON RAT.WORK_EFFORT_TYPE_ID = RAD.WORK_EFFORT_TYPE_ID	
	 
	 -- missioni
	 INNER JOIN WORK_EFFORT_ASSOC Z0 ON Z0.WORK_EFFORT_ID_FROM = RAD.WORK_EFFORT_ID
	 	AND Z0.WORK_EFFORT_ASSOC_TYPE_ID = RAT.HIERARCHY_ASSOC_TYPE_ID		
     	AND ( @excludeValidity = 'Y' OR  (@excludeValidity = 'N' AND ( Z0.FROM_DATE <= @monitoringDate AND (Z0.THRU_DATE >= @monitoringDate OR Z0.THRU_DATE IS NULL ))))
  	 	
	 -- obiettivo strategico
     INNER JOIN WORK_EFFORT_ASSOC Z1 ON Z1.WORK_EFFORT_ID_FROM = Z0.WORK_EFFORT_ID_TO
     	AND Z1.WORK_EFFORT_ASSOC_TYPE_ID <> RAT.HIERARCHY_ASSOC_TYPE_ID
     	AND ( @excludeValidity = 'Y' OR  (@excludeValidity = 'N' AND ( Z1.FROM_DATE <= @monitoringDate AND (Z1.THRU_DATE >= @monitoringDate OR Z1.THRU_DATE IS NULL ))))     	
      
       -- strategico
     INNER JOIN WORK_EFFORT_ASSOC Z2 ON Z2.WORK_EFFORT_ID_FROM = Z1.WORK_EFFORT_ID_TO
     	 AND Z2.WORK_EFFORT_ASSOC_TYPE_ID = '15PMC'
     	 AND ( @excludeValidity = 'Y' OR  (@excludeValidity = 'N' AND ( Z2.FROM_DATE <= @monitoringDate AND (Z2.THRU_DATE >= @monitoringDate OR Z2.THRU_DATE IS NULL ))))     	 
     INNER JOIN WORK_EFFORT A2 ON A2.WORK_EFFORT_ID = Z2.WORK_EFFORT_ID_TO
     INNER JOIN WORK_EFFORT_TYPE B2 ON B2.WORK_EFFORT_TYPE_ID = A2.WORK_EFFORT_TYPE_ID

     LEFT OUTER JOIN WORK_EFFORT_NOTE WEN2 ON WEN2.WORK_EFFORT_ID = A2.WORK_EFFORT_ID
   		AND WEN2.IS_MAIN = 'Y'
     LEFT OUTER JOIN NOTE_DATA ND2 ON ND2.NOTE_ID = WEN2.NOTE_ID
   
     
WHERE RAD.WORK_EFFORT_ID = ? AND Z0.WORK_EFFORT_ID_TO = ? AND Z1.WORK_EFFORT_ID_TO = ? 

ORDER BY Z2.SEQUENCE_NUM, A2.SOURCE_REFERENCE_ID, A2.WORK_EFFORT_ID
    

	]]></xml-property>
        </oda-data-set>
