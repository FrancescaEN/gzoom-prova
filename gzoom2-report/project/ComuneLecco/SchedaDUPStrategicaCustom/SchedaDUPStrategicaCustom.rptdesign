                </structure>
                <structure>
                    <property name="position">33</property>
                    <property name="name">ESTIMATED_START_DATE2</property>
                    <property name="nativeName">ESTIMATED_START_DATE2</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">34</property>
                    <property name="name">ESTIMATED_COMPLETION_DATE2</property>
                    <property name="nativeName">ESTIMATED_COMPLETION_DATE2</property>
