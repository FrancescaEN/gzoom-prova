            <xml-property name="queryText"><![CDATA[ SELECT 
	P.PARTY_NAME AS "PARTY_NAME",   
	W_P.WORK_EFFORT_ID AS "WORK_EFFORT_ID"
 FROM WORK_EFFORT_PARTY_ASSIGNMENT W_P
 INNER JOIN PARTY_RELATIONSHIP P_R ON P_R.PARTY_ID_FROM = W_P.PARTY_ID
 	AND P_R.ROLE_TYPE_ID_FROM  = W_P.ROLE_TYPE_ID
 	AND P_R.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
 	AND P_R.FROM_DATE <= ?
 	AND (P_R.THRU_DATE >= ? OR P_R.THRU_DATE IS NULL )
 INNER JOIN PARTY P ON P.PARTY_ID = P_R.PARTY_ID_TO
 WHERE W_P.WORK_EFFORT_ID  = ? 
 	AND W_P.FROM_DATE <= ?
    AND W_P.THRU_DATE >= ? 
 ORDER BY PARTY_NAME]]></xml-property>
