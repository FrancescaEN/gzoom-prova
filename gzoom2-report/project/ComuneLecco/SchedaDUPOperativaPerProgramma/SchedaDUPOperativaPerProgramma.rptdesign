            <method name="beforeOpen"><![CDATA[// prendo la data inizio della linea di mandato
// prendo l'anno della data inizio e vado avanti di 4 così avro i 4 periodi di riferimento

/**/
var date0101P1 = com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc(UtilDateTime.getMonthStartFromDatetime('1', reportContext.getTimeZone().getID(), BirtDateTime.year(params["monitoringDate"].value)+1, reportContext.getLocale()), params["odaDialect"].value);
var date0101P2 = com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc(UtilDateTime.getMonthStartFromDatetime('1', reportContext.getTimeZone().getID(), BirtDateTime.year(params["monitoringDate"].value)+2, reportContext.getLocale()), params["odaDialect"].value);
var date0101M1 = com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc(UtilDateTime.getMonthStartFromDatetime('1', reportContext.getTimeZone().getID(), BirtDateTime.year(params["monitoringDate"].value)-1, reportContext.getLocale()), params["odaDialect"].value);
var date0101M2 = com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc(UtilDateTime.getMonthStartFromDatetime('1', reportContext.getTimeZone().getID(), BirtDateTime.year(params["monitoringDate"].value)-2, reportContext.getLocale()), params["odaDialect"].value);

this.queryText = this.queryText.replace("@date3112P1",  params["date3112P1Sql"].value );
this.queryText = this.queryText.replace("@date3112P2",  params["date3112P2Sql"].value );
this.queryText = this.queryText.replace("@date3112M1",  params["date3112M1Sql"].value );
this.queryText = this.queryText.replace("@date3112M2",  params["date3112M2Sql"].value );
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );

this.queryText = this.queryText.replace("@date0101M1",  date0101M1 );
this.queryText = this.queryText.replace("@date0101M2",  date0101M2 );
this.queryText = this.queryText.replace("@date0101P1",  date0101P1 );
this.queryText = this.queryText.replace("@date0101P2",  date0101P2 );
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value );														



this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );

this.queryText = this.queryText.replace("@excludeValidity", "'" + params["excludeValidity"].value+ "'");

/*
this.queryText = this.queryText.replace("@date3112M1",  "'2022-01-01 00:00:00.000'" );
