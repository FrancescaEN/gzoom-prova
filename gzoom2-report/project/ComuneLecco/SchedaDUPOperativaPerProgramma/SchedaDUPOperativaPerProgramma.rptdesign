                </structure>
                <structure>
                    <property name="position">26</property>
                    <property name="name">ACTUAL_P1_COUNT</property>
                    <property name="nativeName">ACTUAL_P1_COUNT</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">27</property>
                    <property name="name">BUDGET_P2</property>
                    <property name="nativeName">BUDGET_P2</property>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="position">28</property>
                    <property name="name">BUDGET_P2_COUNT</property>
                    <property name="nativeName">BUDGET_P2_COUNT</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">29</property>
                    <property name="name">ACTUAL_P2</property>
                    <property name="nativeName">ACTUAL_P2</property>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="position">30</property>
                    <property name="name">ACTUAL_P2_COUNT</property>
                    <property name="nativeName">ACTUAL_P2_COUNT</property>
                    <property name="dataType">decimal</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
	   A.ETCH AS "ETCH",
	   A.WORK_EFFORT_NAME AS "TITOLO",
       A.ESTIMATED_START_DATE AS "START_DATE",
       A.ESTIMATED_COMPLETION_DATE AS "COMPLETATION_DATE",  
       (CASE WHEN U.UOM_TYPE_ID = 'RATING_SCALE' THEN 'SN' ELSE 'AVANZAMENTO' END) AS  "TIPO_ESPOSIZIONE",
       Z.WORK_EFFORT_ID_TO AS "WORKEFFORT_ID_TO",       
       A.WORK_EFFORT_ID AS "WORK_EFFORT_ID",
       A.SOURCE_REFERENCE_ID AS "SOURCE_REFERENCE_ID",
       Z.SEQUENCE_NUM AS "SEQUENCE_NUM",
       B.ETCH AS "ETICHETTA",
	   
	   SUM(CASE WHEN I.GL_FISCAL_TYPE_ID = 'BUDGET' AND I.TRANSACTION_DATE >= @date0101 AND I.TRANSACTION_DATE <= @date3112 THEN I.AMOUNT  ELSE NULL END) AS "BUDGET",
	   COUNT(CASE WHEN I.GL_FISCAL_TYPE_ID = 'BUDGET' AND I.TRANSACTION_DATE >= @date0101 AND I.TRANSACTION_DATE <= @date3112 THEN I.AMOUNT  ELSE NULL END) AS "BUDGET_COUNT",
	   
	   SUM(CASE WHEN I.GL_FISCAL_TYPE_ID = 'ACTUAL' AND I.TRANSACTION_DATE >= @date0101 AND I.TRANSACTION_DATE <= @date3112 THEN I.AMOUNT  ELSE NULL END) AS "ACTUAL",
	   COUNT(CASE WHEN I.GL_FISCAL_TYPE_ID = 'ACTUAL' AND I.TRANSACTION_DATE >= @date0101 AND I.TRANSACTION_DATE <= @date3112 THEN I.AMOUNT  ELSE NULL END) AS "ACTUAL_COUNT",
	   
	   SUM(CASE WHEN I.GL_FISCAL_TYPE_ID = 'BUDGET' AND I.TRANSACTION_DATE >= @date0101M1 AND I.TRANSACTION_DATE <= @date3112M1 THEN I.AMOUNT  ELSE NULL END) AS "BUDGET_M1",
	   COUNT(CASE WHEN I.GL_FISCAL_TYPE_ID = 'BUDGET' AND I.TRANSACTION_DATE >= @date0101M1 AND I.TRANSACTION_DATE <= @date3112M1 THEN I.AMOUNT  ELSE NULL END) AS "BUDGET_M1_COUNT",	
	   
	   SUM(CASE WHEN I.GL_FISCAL_TYPE_ID = 'ACTUAL' AND I.TRANSACTION_DATE >= @date0101M1 AND I.TRANSACTION_DATE <= @date3112M1 THEN I.AMOUNT  ELSE NULL END) AS "ACTUAL_M1",
	   COUNT(CASE WHEN I.GL_FISCAL_TYPE_ID = 'ACTUAL' AND I.TRANSACTION_DATE >= @date0101M1 AND I.TRANSACTION_DATE <= @date3112M1 THEN I.AMOUNT  ELSE NULL END) AS "ACTUAL_M1_COUNT",	
	   
	   SUM(CASE WHEN I.GL_FISCAL_TYPE_ID = 'BUDGET' AND I.TRANSACTION_DATE >= @date0101M2 AND I.TRANSACTION_DATE <= @date3112M2 THEN I.AMOUNT  ELSE NULL END) AS "BUDGET_M2",
	   COUNT(CASE WHEN I.GL_FISCAL_TYPE_ID = 'BUDGET' AND I.TRANSACTION_DATE >= @date0101M2 AND I.TRANSACTION_DATE <= @date3112M2 THEN I.AMOUNT  ELSE NULL END) AS "BUDGET_M2_COUNT",
	   	
	   SUM(CASE WHEN I.GL_FISCAL_TYPE_ID = 'ACTUAL' AND I.TRANSACTION_DATE >= @date0101M2 AND I.TRANSACTION_DATE <= @date3112M2 THEN I.AMOUNT  ELSE NULL END) AS "ACTUAL_M2",
	   COUNT(CASE WHEN I.GL_FISCAL_TYPE_ID = 'ACTUAL' AND I.TRANSACTION_DATE >= @date0101M2 AND I.TRANSACTION_DATE <= @date3112M2 THEN I.AMOUNT  ELSE NULL END) AS "ACTUAL_M2_COUNT",
	   	
	   SUM(CASE WHEN I.GL_FISCAL_TYPE_ID = 'BUDGET' AND I.TRANSACTION_DATE >= @date0101P1 AND I.TRANSACTION_DATE <= @date3112P1 THEN I.AMOUNT  ELSE NULL END) AS "BUDGET_P1",
	   COUNT(CASE WHEN I.GL_FISCAL_TYPE_ID = 'BUDGET' AND I.TRANSACTION_DATE >= @date0101P1 AND I.TRANSACTION_DATE <= @date3112P1 THEN I.AMOUNT  ELSE NULL END) AS "BUDGET_P1_COUNT",
	   	
	   SUM(CASE WHEN I.GL_FISCAL_TYPE_ID = 'ACTUAL' AND I.TRANSACTION_DATE >= @date0101P1 AND I.TRANSACTION_DATE <= @date3112P1 THEN I.AMOUNT  ELSE NULL END) AS "ACTUAL_P1",
	   COUNT(CASE WHEN I.GL_FISCAL_TYPE_ID = 'ACTUAL' AND I.TRANSACTION_DATE >= @date0101P1 AND I.TRANSACTION_DATE <= @date3112P1 THEN I.AMOUNT  ELSE NULL END) AS "ACTUAL_P1_COUNT",	
	   
	   SUM(CASE WHEN I.GL_FISCAL_TYPE_ID = 'BUDGET' AND I.TRANSACTION_DATE >= @date0101P2 AND I.TRANSACTION_DATE <= @date3112P2 THEN I.AMOUNT  ELSE NULL END) AS "BUDGET_P2",
	   COUNT(CASE WHEN I.GL_FISCAL_TYPE_ID = 'BUDGET' AND I.TRANSACTION_DATE >= @date0101P2 AND I.TRANSACTION_DATE <= @date3112P2 THEN I.AMOUNT  ELSE NULL END) AS "BUDGET_P2_COUNT",
	   	
	   SUM(CASE WHEN I.GL_FISCAL_TYPE_ID = 'ACTUAL' AND I.TRANSACTION_DATE >= @date0101P2 AND I.TRANSACTION_DATE <= @date3112P2 THEN I.AMOUNT  ELSE NULL END) AS "ACTUAL_P2",
       COUNT(CASE WHEN I.GL_FISCAL_TYPE_ID = 'ACTUAL' AND I.TRANSACTION_DATE >= @date0101P2 AND I.TRANSACTION_DATE <= @date3112P2 THEN I.AMOUNT  ELSE NULL END) AS "ACTUAL_P2_COUNT"	
    
   
 FROM WORK_EFFORT_ASSOC Z2 
     INNER JOIN WORK_EFFORT A2 ON A2.WORK_EFFORT_ID = Z2.WORK_EFFORT_ID_TO
     INNER JOIN WORK_EFFORT_ASSOC_TYPE D2 ON D2.WORK_EFFORT_ASSOC_TYPE_ID = Z2.WORK_EFFORT_ASSOC_TYPE_ID     
     INNER JOIN WORK_EFFORT_TYPE B2 ON B2.WORK_EFFORT_TYPE_ID = A2.WORK_EFFORT_TYPE_ID

	 INNER JOIN WORK_EFFORT_ASSOC Z ON Z.WORK_EFFORT_ID_FROM = A2.WORK_EFFORT_ID
	 INNER JOIN WORK_EFFORT A ON A.WORK_EFFORT_ID = Z.WORK_EFFORT_ID_TO
	 INNER JOIN WORK_EFFORT_TYPE B ON B.WORK_EFFORT_TYPE_ID = A.WORK_EFFORT_TYPE_ID 
     INNER JOIN WORK_EFFORT_ASSOC_TYPE D ON D.WORK_EFFORT_ASSOC_TYPE_ID = Z.WORK_EFFORT_ASSOC_TYPE_ID
     
     LEFT OUTER JOIN WORK_EFFORT_MEASURE E ON E.WORK_EFFORT_ID = A.WORK_EFFORT_ID
                                          AND E.WE_MEASURE_TYPE_ENUM_ID  <> 'WEMT_SCORE'  
     LEFT OUTER JOIN GL_ACCOUNT G ON E.GL_ACCOUNT_ID  = G.GL_ACCOUNT_ID    
     LEFT OUTER JOIN UOM        U ON G.DEFAULT_UOM_ID = U.UOM_ID
     LEFT OUTER JOIN (
          SELECT Q.WORK_EFFORT_ID, Q.TRANSACTION_DATE, R.AMOUNT, R.GL_ACCOUNT_ID, R.GL_FISCAL_TYPE_ID
          FROM ACCTG_TRANS Q 
          JOIN ACCTG_TRANS_ENTRY R ON Q.ACCTG_TRANS_ID = R.ACCTG_TRANS_ID
                     ) I ON I.WORK_EFFORT_ID = A.WORK_EFFORT_ID AND I.GL_ACCOUNT_ID = E.GL_ACCOUNT_ID
                     
WHERE   Z2.WORK_EFFORT_ID_FROM = ?
	AND Z2.WORK_EFFORT_ASSOC_TYPE_ID = '15BILC'
    AND ( @excludeValidity = 'Y' OR  (@excludeValidity = 'N' AND ( Z2.FROM_DATE <= @monitoringDate AND (Z2.THRU_DATE >= @monitoringDate OR Z2.THRU_DATE IS NULL ))))
 

 	AND ((D.PARENT_TYPE_ID = 'HIE' AND A.WORK_EFFORT_PARENT_ID = A2.WORK_EFFORT_PARENT_ID) OR Z.WORK_EFFORT_ASSOC_TYPE_ID = A2.WORK_EFFORT_ASSOC_TYPE_ID) 
 	AND (A.ESTIMATED_START_DATE <= ? AND A.ESTIMATED_COMPLETION_DATE >= ?)
 	AND A.WORK_EFFORT_REVISION_ID IS NULL -- INSERITO PER FILTRARE GLI OBIETTIVI STORICIZZATI
 	
 GROUP BY 
 	   Z.WORK_EFFORT_ID_TO,
	   A.WORK_EFFORT_NAME,
       A.ESTIMATED_START_DATE,
       A.ESTIMATED_COMPLETION_DATE,  
       U.UOM_TYPE_ID,
       A.ETCH,
	   A.WORK_EFFORT_ID,
       A.SOURCE_REFERENCE_ID,
       Z.SEQUENCE_NUM,
       B.ETCH
   
 ORDER BY 
 		Z.SEQUENCE_NUM,
 		A.SOURCE_REFERENCE_ID, 		
 		A.WORK_EFFORT_ID
         
]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="ResponsabiliSettoriCoinvoltiDS" id="53881">
