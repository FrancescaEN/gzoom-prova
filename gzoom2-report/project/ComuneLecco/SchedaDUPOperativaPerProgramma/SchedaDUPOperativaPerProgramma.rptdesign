} else if (row["G_UOM_TYPE_ID"] == 'DATE_MEASURE') {&#13;
	UtilDateTime.numberConvertToDate(row["ACTUAL_DATO_M1"], reportContext.getLocale());&#13;
} else {&#13;
	row["ACTUAL_DATO_M1"] != null ? Formatter.format(row["FORMAT"].indexOf('%') != -1 ? row["ACTUAL_DATO_M1"]/100 : row["ACTUAL_DATO_M1"], row["FORMAT"]) : '';&#13;
}</expression>
