                                                                    <list-property name="visibility"/>
                                                                    <expression name="valueExpr">importPackage(Packages.com.mapsengineering.base.birt.util);&#13;
if (row["G_UOM_TYPE_ID"] == 'RATING_SCALE') {&#13;
	row["ACTUAL_COD_M3"];	&#13;
} else if (row["G_UOM_TYPE_ID"] == 'DATE_MEASURE') {&#13;
	UtilDateTime.numberConvertToDate(row["ACTUAL_DATO_M3"], reportContext.getLocale());&#13;
} else {&#13;
	if (row["ACTUAL_DATO_M3"] != null &amp;&amp; row["CALC_CUSTOM_METHOD_ID"] != null &amp;&amp; row["DEFAULT_UOM_ID"] == 'OTH_100') {	&#13;
		row["ACTUAL_DATO_M3"] > 100 ? Formatter.format(1, row["FORMAT"])  : Formatter.format(row["ACTUAL_DATO_M3"]/100 , row["FORMAT"]) ;&#13;
	} else {&#13;
		row["ACTUAL_DATO_M3"] != null ? Formatter.format(BirtStr.indexOf("%",row["FORMAT"],0) != -1 ? row["ACTUAL_DATO_M3"]/100 : row["ACTUAL_DATO_M3"], row["FORMAT"]) : '';&#13;
	}&#13;
}</expression>
