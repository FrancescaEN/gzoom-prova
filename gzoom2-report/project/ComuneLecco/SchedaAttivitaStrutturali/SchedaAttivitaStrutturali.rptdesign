            <xml-property name="queryText"><![CDATA[select P.DESCRIPTION AS "DESCRIPTION" 
from work_effort W
left join work_effort_purpose_type P 
on W.work_effort_purpose_type_ID = P.work_effort_purpose_type_ID
where work_effort_id = ?  -- ID WORK_EFFORT DELL' ATTIVITA' STRUTTURALE]]></xml-property>
