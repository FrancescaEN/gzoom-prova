            <method name="beforeOpen"><![CDATA[/**/
this.queryText = this.queryText.replace("@excludeValidity", "'" + params["excludeValidity"].value+ "'");
this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );

/*
this.queryText = this.queryText.replace("@excludeValidity",  "'N'" );
this.queryText = this.queryText.replace("@monitoringDate",  "'2021-12-31 00:00:00.000'");
*/

var workEffortRevisionId = " AND RAD.WORK_EFFORT_REVISION_ID IS NULL ";
workEffortRevisionId += " AND A0.WORK_EFFORT_REVISION_ID IS NULL ";
workEffortRevisionId += " AND A1.WORK_EFFORT_REVISION_ID IS NULL ";
workEffortRevisionId += " AND FIL_W.WORK_EFFORT_REVISION_ID IS NULL ";
	
if (params["workEffortRevisionId"].value != null &amp;&amp; params["workEffortRevisionId"].value != '') {
    workEffortRevisionId = " AND RAD.WORK_EFFORT_REVISION_ID = '" + params["workEffortRevisionId"].value + "'";
    workEffortRevisionId += " AND A0.WORK_EFFORT_REVISION_ID = '" + params["workEffortRevisionId"].value + "'";
    workEffortRevisionId += " AND A1.WORK_EFFORT_REVISION_ID = '" + params["workEffortRevisionId"].value + "'";
    workEffortRevisionId += " AND FIL_W.WORK_EFFORT_REVISION_ID = '" + params["workEffortRevisionId"].value + "'";

}  
this.queryText = this.queryText.replace("@workEffortRevisionId",  workEffortRevisionId ); 

//@workEffortIdChild
var workEffortIdChildString = '';
if (params["workEffortIdChild"].value != null &amp;&amp; params["workEffortIdChild"].value != '') {
	workEffortIdChildString = "AND ( A1.WORK_EFFORT_ID = '"+ params["workEffortIdChild"].value + "' OR";
	workEffortIdChildString += " FIL_W.WORK_EFFORT_ID = '"+ params["workEffortIdChild"].value + "' )";	
}
this.queryText = this.queryText.replace("@workEffortIdChild",  workEffortIdChildString );

//@workEffortId
var workEffortIdString = '';
if (params["workEffortId"].value != null &amp;&amp; params["workEffortId"].value != '') {
	workEffortIdString = "AND RAD.WORK_EFFORT_ID = '"+ params["workEffortId"].value + "'";	
}
this.queryText = this.queryText.replace("@workEffortId",  workEffortIdString );



//@orgUnitId
var orgUnitIdString = '';
if (params["orgUnitId"].value != null &amp;&amp; params["orgUnitId"].value != '') {
	//orgUnitIdString = "AND A1.ORG_UNIT_ID = '"+ params["orgUnitId"].value + "'";
	orgUnitIdString = "AND ( A1.ORG_UNIT_ID = '"+ params["orgUnitId"].value + "' OR";
	orgUnitIdString += " FIL_W.ORG_UNIT_ID = '"+ params["orgUnitId"].value + "' )";	
}
this.queryText = this.queryText.replace("@orgUnitId",  orgUnitIdString );

//GESTIRE PERMESSI
/*
var filterInnerJoin = "";
var filterLeftJoin = "";
var filterWhere = ""; 
 */
/* */
filter = new com.mapsengineering.base.birt.util.UtilFilter(params["userLoginId"].value, params["localDispatcherName"].value);
filterInnerJoin = filter.getWorkEffortFilterInner();
filterLeftJoin = filter.getWorkEffortFilterLeftJoin();
filterWhere = filter.getWorkEffortFilterWhere();

this.queryText = this.queryText.replace("@filterInnerJoin",  filterInnerJoin );
this.queryText = this.queryText.replace("@filterLeftJoin",  filterLeftJoin );
this.queryText = this.queryText.replace("@filterWhere",  filterWhere );

ReportLog.info("... this.queryText IndexDS: "+this.queryText);
ReportLog.info("... this.queryText PARAMS: "+this.getInputParameters());]]></method>
