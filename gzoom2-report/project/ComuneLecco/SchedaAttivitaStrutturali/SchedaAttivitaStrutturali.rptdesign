        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="RelazioniADS" id="53957">
            <list-property name="columnHints"/>
            <list-property name="parameters">
                <structure>
                    <property name="name">workEffortId</property>
                    <property name="nativeName"></property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">0</property>
                    <property name="position">1</property>
                    <expression name="defaultValue" type="constant">N/A</expression>
                    <property name="isOptional">false</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">ETCH</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">WE_FROM_NAME</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">CONTENT_ID</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <method name="beforeOpen"><![CDATA[/**/
this.queryText = this.queryText.replace("@excludeValidity", "'" + params["excludeValidity"].value+ "'");
this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );

/*
this.queryText = this.queryText.replace("@excludeValidity",  "'N'" );
this.queryText = this.queryText.replace("@monitoringDate",  "'2021-12-31 00:00:00.000'");
*/
 
var workEffortRevisionId = " AND WEA.WE_FROM_REVISION_ID IS NULL ";
if (params["workEffortRevisionId"].value != null &amp;&amp; params["workEffortRevisionId"].value != '') {
    workEffortRevisionId = " AND WEA.WE_FROM_REVISION_ID = '" + params["workEffortRevisionId"].value + "'";
}  
this.queryText = this.queryText.replace("@workEffortRevisionId",  workEffortRevisionId ); ]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">ETCH</property>
                    <property name="nativeName">ETCH</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">WE_FROM_NAME</property>
                    <property name="nativeName">WE_FROM_NAME</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">CONTENT_ID</property>
                    <property name="nativeName">CONTENT_ID</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT WC.ETCH AS "ETCH",
WEA.WE_FROM_NAME AS "WE_FROM_NAME",
WC.CONTENT_ID AS "CONTENT_ID"

FROM WORK_EFFORT WE
INNER JOIN work_effort_type_content WC ON WC.WORK_EFFORT_TYPE_ID = WE.WORK_EFFORT_TYPE_ID AND WC.WE_TYPE_CONTENT_TYPE_ID = 'FOLDER' AND WC.CONTENT_ID LIKE 'WEFLD_WET%'
INNER JOIN work_effort_type_assoc WA ON WA.WORK_EFFORT_TYPE_ID = WC.WORK_EFFORT_TYPE_ID AND WA.CONTENT_ID = WC.CONTENT_ID
LEFT JOIN WORK_EFFORT_ASSOC_VIEW WEA ON WEA.WE_TO_ID = WE.WORK_EFFORT_ID AND WEA.WE_FROM_TYPE_ID = WA.WORK_EFFORT_TYPE_ID_REF
AND ( @excludeValidity = 'Y' OR  (@excludeValidity = 'N' AND ( WEA.WA_FROM_DATE <= @monitoringDate AND (WEA.WA_THRU_DATE >= @monitoringDate OR WEA.WA_THRU_DATE IS NULL ))))
WHERE WE.WORK_EFFORT_ID = ? 
	AND WE_FROM_TYPE_ID IN ('15PM02','16T1ST')
	@workEffortRevisionId]]></xml-property>
            <xml-property name="designerValues"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<model:DesignValues xmlns:design="http://www.eclipse.org/datatools/connectivity/oda/design" xmlns:model="http://www.eclipse.org/birt/report/model/adapter/odaModel">
  <Version>2.0</Version>
