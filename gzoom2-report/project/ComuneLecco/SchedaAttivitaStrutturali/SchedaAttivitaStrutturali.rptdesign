            <xml-property name="queryText"><![CDATA[SELECT 
WA.WORK_EFFORT_ID AS "ID_OBIETTIVO",
PA.PARTY_ID AS "ID_DIPENDENTE",
PPR.PARENT_ROLE_CODE AS "MATRICOLA",
PA.PARTY_NAME AS "DIPENDENTE",
PA1.PARTY_ID AS "ID_PROFILO",
PA1.PARTY_NAME AS "PROFILO",
E.DESCRIPTION AS  "CATEGORIA", 
PE.employment_amount AS "PER_PR",   
WA.ROLE_TYPE_WEIGHT  AS "IMPIEGATO",
P_UO.PARTY_NAME AS "CDR_APPARTENENZA",
CASE WHEN (PE.employment_amount IS NOT NULL AND WA.ROLE_TYPE_WEIGHT IS NOT NULL) 
	THEN (PE.employment_amount*WA.ROLE_TYPE_WEIGHT/100)/100 ELSE 0.0 END ANNI_PERSONA,
COUNT(*) AS "COUNTER"

FROM        WORK_EFFORT_PARTY_ASSIGNMENT WA
JOIN        PARTY                       PA 
ON          WA.PARTY_ID = PA.PARTY_ID
JOIN		PARTY_PARENT_ROLE 			PPR
ON			PPR.PARTY_ID = PA.PARTY_ID
JOIN        PERSON                      PE
ON          WA.PARTY_ID = PE.PARTY_ID
LEFT OUTER
JOIN        EMPL_POSITION_TYPE         E
ON          E.EMPL_POSITION_TYPE_ID = PE.EMPL_POSITION_TYPE_ID
LEFT OUTER  
JOIN        PARTY_RELATIONSHIP         PR
ON          PR.PARTY_ID_FROM              = WA.PARTY_ID
AND         PR.PARTY_RELATIONSHIP_TYPE_ID = 'QUALIF'
AND         PR.THRU_DATE IS NULL
LEFT OUTER  
JOIN        PARTY                      PA1
ON          PR.PARTY_ID_TO = PA1.PARTY_ID
LEFT OUTER JOIN PARTY_RELATIONSHIP PR_UO
ON      PR_UO.PARTY_ID_TO = WA.PARTY_ID
AND     PR_UO.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_EMPLOYMENT'
AND     PR_UO.THRU_DATE IS NULL
LEFT OUTER JOIN PARTY              P_UO
ON      P_UO.PARTY_ID = PR_UO.PARTY_ID_FROM
WHERE       WA.ROLE_TYPE_ID = 'WE_ASSIGNMENT'  AND   WA.WORK_EFFORT_ID  = ?
AND (WA.FROM_DATE <= ? AND WA.THRU_DATE >= ?)

GROUP BY 
WA.WORK_EFFORT_ID ,
PA.PARTY_ID,
PA.PARTY_NAME,
PA1.PARTY_ID,
PA1.PARTY_NAME,
E.DESCRIPTION , 
PE.employment_amount,   
WA.ROLE_TYPE_WEIGHT,
P_UO.PARTY_NAME,
PPR.PARENT_ROLE_CODE

ORDER BY    PA.PARTY_NAME, PA1.PARTY_NAME
]]></xml-property>
