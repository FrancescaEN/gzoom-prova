            <method name="beforeOpen"><![CDATA[//filtri per le note

var selectNote = "";
if (params["selectNote"].value == 'SELECT_NOTE_DATE') {
	selectNote = "AND ND.NOTE_DATE_TIME = " + params["monitoringDateSql"].value;
} else if (params["selectNote"].value == 'SELECT_NOTE_NONE') {
	selectNote = "AND N.WORK_EFFORT_ID = '_NA_' ";
}
this.queryText = this.queryText.replace("@selectNote", selectNote);

var typeNotes = "";
if (params["typeNotes"].value == 'TYPE_NOTES_INT') {
	typeNotes = "AND N.INTERNAL_NOTE = 'Y'";
} else {
	typeNotes = "AND ( N.INTERNAL_NOTE IS NULL OR N.INTERNAL_NOTE = 'N') ";
}
this.queryText = this.queryText.replace("@typeNotes", typeNotes);]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">NOTE_ID</property>
                    <property name="nativeName">NOTE_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">NOTE_NAME</property>
                    <property name="nativeName">NOTE_NAME</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">NOTE_INFO</property>
                    <property name="nativeName">NOTE_INFO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">SEQUENCE_ID</property>
                    <property name="nativeName">SEQUENCE_ID</property>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">NOTE_DATE_TIME</property>
                    <property name="nativeName">NOTE_DATE_TIME</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">IS_HTML</property>
                    <property name="nativeName">IS_HTML</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
 ND.NOTE_ID AS "NOTE_ID", 
 ND.NOTE_NAME AS "NOTE_NAME",
 ND.NOTE_INFO AS "NOTE_INFO",
 N.SEQUENCE_ID AS "SEQUENCE_ID",
 ND.NOTE_DATE_TIME AS "NOTE_DATE_TIME",
 N.IS_HTML AS "IS_HTML"
FROM    WORK_EFFORT_NOTE N
INNER JOIN NOTE_DATA ND ON ND.NOTE_ID = N.NOTE_ID
WHERE N.WORK_EFFORT_ID = ? 	
	AND N.IS_MAIN = 'N'
	AND ( ? = 'Y' OR N.SEQUENCE_ID >= 100) -- per prendere la nota della radice
	
	@selectNote
	@typeNotes
	
ORDER BY 
	N.SEQUENCE_ID, 
	N.NOTE_ID

]]></xml-property>
