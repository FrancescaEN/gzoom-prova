	<queryString language="SQL">
		<![CDATA[--select *
--from exp_ope_oo OO
--where anno='2023' and cod_tip_struttura='DIP_CRA'
--order by cod_programma, struttura, etch_oo
 --AND false
 
select OO.*, GP.ramoamm, GP.gradoreal, case when ((sommapesi<100) or (checkcons like '%#%') or (checkpsao like '%#%')) then ' - (DA ATTENZIONARE) '||OO.cod_struttura else '' end as allarme
from exp_ope_oo OO
join
(select GP2.work_effort_id_oo, GP2.l2_desc as ramoamm, SUM(REPLACE('0'||GP2.peso_score_azione_orig,',','.')::decimal) as gradoreal, SUM(TO_NUMBER(GP2.peso_azione,'999')) as sommapesi, GP2.checkcons, GP2.checkpsao
from 
(select anno, cod_tip_struttura, fine_responsabilita, work_effort_id_oo, work_effort_id_azi, l2_desc, peso_score_azione_orig, peso_azione, string_agg((case when consuntivo='' then '#' else 'OK' end),'-') as checkcons, string_agg((case when (peso_score_azione_orig='' or (consuntivo='Sì' and peso_score_azione_orig='0,00')) then '#' else 'OK' end),'-') as checkpsao
from cst_sd_exp_ope_oo_ind
group by anno, cod_tip_struttura, fine_responsabilita, work_effort_id_oo, work_effort_id_azi, l2_desc, peso_score_azione_orig, peso_azione
) GP2
where GP2.anno=$P{Anno} and GP2.cod_tip_struttura='DIP_CRA' and REGEXP_REPLACE(GP2.fine_responsabilita,'(.*)/(.*)/(.*)','\3\2\1')>'20230214' and REGEXP_REPLACE(GP2.fine_responsabilita,'(.*)/(.*)/(.*)','\3\2\1')<>'20230501' and REGEXP_REPLACE(GP2.fine_responsabilita,'(.*)/(.*)/(.*)','\3\2\1')<>'20230507'
group by GP2.work_effort_id_oo, GP2.l2_desc, GP2.checkcons, GP2.checkpsao 
) GP on GP.work_effort_id_oo=OO.work_effort_id_oo
where OO.anno=$P{Anno} and OO.cod_tip_struttura='DIP_CRA' and org_unit_id_str like '%$P!{orgUnitId}%'
order by allarme desc, OO.cod_programma, OO.struttura, OO.etch_oo]]>
	</queryString>
