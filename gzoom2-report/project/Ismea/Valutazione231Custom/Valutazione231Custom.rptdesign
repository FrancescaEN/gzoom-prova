            <method name="beforeOpen"><![CDATA[/* */

this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value );
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );


/*this.queryText = this.queryText.replace("@date0101",  "'2019-01-01 00:00:00.000'" );
this.queryText = this.queryText.replace("@date3112",  "'2019-12-31 00:00:00.000'" );*/
 

//ReportLog.info("......this.queryText"+this.queryText);]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">WORK_EFFORT_ID</property>
                    <property name="nativeName">WORK_EFFORT_ID</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">EFFICAICA_MISURE</property>
                    <property name="nativeName">EFFICAICA_MISURE</property>
                    <property name="dataType">decimal</property>
                    <property name="nativeDataType">3</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">GRADO_RISCHIO_RESIDUO</property>
                    <property name="nativeName">GRADO_RISCHIO_RESIDUO</property>
                    <property name="dataType">decimal</property>
                    <property name="nativeDataType">3</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
    OB3.WORK_EFFORT_ID,
    MAX(CASE WHEN SUBSTR(AC.ACCOUNT_CODE,13,2) = '1E' then AMOUNT ELSE NULL END) AS EFFICAICA_MISURE,
    MAX(CASE WHEN SUBSTR(AC.ACCOUNT_CODE,13,2) = '1R' then AMOUNT ELSE NULL END) AS GRADO_RISCHIO_RESIDUO
FROM WORK_EFFORT OB3
LEFT JOIN WORK_EFFORT_MEASURE WI ON WI.WORK_EFFORT_ID = OB3.WORK_EFFORT_ID 
AND WI.FROM_DATE <= @date0101
AND WI.THRU_DATE >= @date0101
AND WI.WE_MEASURE_TYPE_ENUM_ID <> 'WEMT_SCORE'
LEFT JOIN GL_ACCOUNT AC ON AC.GL_ACCOUNT_ID = WI.GL_ACCOUNT_ID
          AND AC.ACCOUNT_CODE  like 'COR231%'
LEFT JOIN UOM UOM ON AC.DEFAULT_UOM_ID = UOM.UOM_ID																				
LEFT JOIN (																																				
	SELECT TP.VOUCHER_REF, TP.TRANSACTION_DATE, EP.AMOUNT																																			
	FROM ACCTG_TRANS TP																																			
		INNER JOIN ACCTG_TRANS_ENTRY EP ON EP.ACCTG_TRANS_ID = TP.ACCTG_TRANS_ID																																		
	WHERE EP.GL_ACCOUNT_ID <> 'SCOREKPI'																																		
	)  RI ON RI.VOUCHER_REF = WI.WORK_EFFORT_MEASURE_ID AND RI.TRANSACTION_DATE = @date3112
WHERE OB3.WORK_EFFORT_ID = ?
GROUP BY OB3.WORK_EFFORT_ID
   ]]></xml-property>
