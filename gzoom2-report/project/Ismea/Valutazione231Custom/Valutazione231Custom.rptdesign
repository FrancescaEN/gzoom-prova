            <method name="beforeOpen"><![CDATA[/* */

this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value );
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );


/*this.queryText = this.queryText.replace("@date0101",  "'2019-01-01 00:00:00.000'" );
this.queryText = this.queryText.replace("@date3112",  "'2019-12-31 00:00:00.000'" );*/


//ReportLog.info("......this.queryText"+this.queryText);]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">WORK_EFFORT_ID</property>
                    <property name="nativeName">WORK_EFFORT_ID</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">CODICE_REATO</property>
                    <property name="nativeName">CODICE_REATO</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">DESCRIZIONE_REATO</property>
                    <property name="nativeName">DESCRIZIONE_REATO</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">PROBABILITA_RISCHIO</property>
                    <property name="nativeName">PROBABILITA_RISCHIO</property>
                    <property name="dataType">decimal</property>
                    <property name="nativeDataType">3</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">IMPATTO_RISCHIO</property>
                    <property name="nativeName">IMPATTO_RISCHIO</property>
                    <property name="dataType">decimal</property>
                    <property name="nativeDataType">3</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">GRADO_RISCHIO_POTENZIALE</property>
                    <property name="nativeName">GRADO_RISCHIO_POTENZIALE</property>
                    <property name="dataType">decimal</property>
                    <property name="nativeDataType">3</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT * FROM (
SELECT 
    OB3.WORK_EFFORT_ID,
    SUBSTR(AC.ACCOUNT_CODE,8,4) AS CODICE_REATO,
    MAX(
        CASE WHEN SUBSTR(AC.ACCOUNT_CODE,13,2) = '3G'  then 
             case when  SUBSTR(AC.ACCOUNT_CODE,8,4) <> '9999'  
                        then  
                       SUBSTR(AC.ACCOUNT_NAME ,20,20000)
             ELSE  
                    
                            '********** M e d i a **********'
                    
             END 
        else 
              '******* R e s i d u o *********'
        END  
             ) AS DESCRIZIONE_REATO,
    MAX(CASE WHEN SUBSTR(AC.ACCOUNT_CODE,13,2) = '1P' THEN AMOUNT ELSE NULL END) AS PROBABILITA_RISCHIO,
    MAX(CASE WHEN SUBSTR(AC.ACCOUNT_CODE,13,2) = '2I' THEN AMOUNT ELSE NULL END) AS IMPATTO_RISCHIO,
    MAX(CASE WHEN SUBSTR(AC.ACCOUNT_CODE,13,2) = '3G' then AMOUNT ELSE NULL END) AS GRADO_RISCHIO_POTENZIALE
FROM WORK_EFFORT OB3
LEFT JOIN WORK_EFFORT_MEASURE WI ON WI.WORK_EFFORT_ID = OB3.WORK_EFFORT_ID 
AND WI.FROM_DATE <= @date0101
AND WI.THRU_DATE >= @date0101 
LEFT JOIN GL_ACCOUNT AC ON AC.GL_ACCOUNT_ID = WI.GL_ACCOUNT_ID
          AND AC.ACCOUNT_CODE  like 'COR231%'
LEFT JOIN UOM UOM ON AC.DEFAULT_UOM_ID = UOM.UOM_ID																				
LEFT JOIN (																																				
	SELECT TP.VOUCHER_REF, TP.TRANSACTION_DATE, EP.AMOUNT																																			
	FROM ACCTG_TRANS TP																																			
		INNER JOIN ACCTG_TRANS_ENTRY EP ON EP.ACCTG_TRANS_ID = TP.ACCTG_TRANS_ID																																		
	WHERE EP.GL_ACCOUNT_ID <> 'SCOREKPI'																																		
	) RI ON RI.VOUCHER_REF = WI.WORK_EFFORT_MEASURE_ID AND RI.TRANSACTION_DATE = @date3112	 															
	WHERE  0 = 0
AND SUBSTR(AC.ACCOUNT_CODE,13,2) in ('1P','2I','3G','1E','1R') 
AND AC.ACCOUNT_CODE NOT LIKE '%A100%'
AND OB3.WORK_EFFORT_ID = ?
GROUP BY OB3.WORK_EFFORT_ID, SUBSTR(AC.ACCOUNT_CODE,8,4)
ORDER BY SUBSTR(AC.ACCOUNT_CODE,8,4)
) A WHERE A.GRADO_RISCHIO_POTENZIALE IS NOT NULL
  ORDER BY A.CODICE_REATO

]]></xml-property>
        </oda-data-set>
    </data-sets>
