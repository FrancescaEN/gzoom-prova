                    <property name="position">11</property>
                    <property name="name">ETICHETTA_FASE</property>
                    <property name="nativeName">ETICHETTA_FASE</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">12</property>
                    <property name="name">DESCRIZIONE_FASE</property>
                    <property name="nativeName">DESCRIZIONE_FASE</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">13</property>
                    <property name="name">CODICE_UO</property>
                    <property name="nativeName">CODICE_UO</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">14</property>
                    <property name="name">DESCRIZIONE_UO</property>
                    <property name="nativeName">DESCRIZIONE_UO</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">15</property>
                    <property name="name">RESPONSABILE</property>
                    <property name="nativeName">RESPONSABILE</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT  
    OB1.WORK_EFFORT_ID AS ID_AREA,
	OB1.SOURCE_REFERENCE_ID  AS CODICE_AREA, 
	OB1.ETCH AS ETICHETTA_AREA,
	OB1.WORK_EFFORT_NAME AS DESCRIZIONE_AREA, 
	OB2.WORK_EFFORT_ID AS ID_PROCESSO,    
	OB2.SOURCE_REFERENCE_ID AS CODICE_PROCESSO,
	OB2.ETCH AS ETICHETTA_PROCESSO,
	OB2.WORK_EFFORT_NAME AS DESCRIZIONE_PROCESSO,
	OB3.WORK_EFFORT_ID AS ID_FASE,
	OB3.SOURCE_REFERENCE_ID AS CODICE_FASE,
	OB3.ETCH AS ETICHETTA_FASE,
	OB3.WORK_EFFORT_NAME AS DESCRIZIONE_FASE,
    SC.PARENT_ROLE_CODE AS CODICE_UO,
    ST.PARTY_NAME AS DESCRIZIONE_UO,
    R.PARTY_NAME AS RESPONSABILE
FROM WORK_EFFORT RAD		
JOIN WORK_EFFORT_TYPE RADT ON RADT.WORK_EFFORT_TYPE_ID = RAD.WORK_EFFORT_TYPE_ID
JOIN WORK_EFFORT_ASSOC OB1A ON OB1A.WORK_EFFORT_ID_FROM = RAD.WORK_EFFORT_ID																											
	AND OB1A.WORK_EFFORT_ASSOC_TYPE_ID = RADT.HIERARCHY_ASSOC_TYPE_ID																										
JOIN WORK_EFFORT OB1 ON OB1.WORK_EFFORT_ID = OB1A.WORK_EFFORT_ID_TO
JOIN WORK_EFFORT_TYPE OB1T ON OB1T.WORK_EFFORT_TYPE_ID = OB1.WORK_EFFORT_TYPE_ID		
JOIN WORK_EFFORT_ASSOC OB2A ON OB2A.WORK_EFFORT_ID_FROM = OB1.WORK_EFFORT_ID																											
	AND OB2A.WORK_EFFORT_ASSOC_TYPE_ID = OB1T.WORK_EFFORT_ASSOC_TYPE_ID
JOIN WORK_EFFORT OB2 ON OB2.WORK_EFFORT_ID = OB2A.WORK_EFFORT_ID_TO
JOIN WORK_EFFORT_TYPE OB2T ON OB2T.WORK_EFFORT_TYPE_ID = OB2.WORK_EFFORT_TYPE_ID
JOIN WORK_EFFORT_ASSOC OB3A ON OB3A.WORK_EFFORT_ID_FROM = OB2.WORK_EFFORT_ID																											
	AND OB3A.WORK_EFFORT_ASSOC_TYPE_ID = OB2T.WORK_EFFORT_ASSOC_TYPE_ID	
JOIN WORK_EFFORT OB3 ON OB3.WORK_EFFORT_ID = OB3A.WORK_EFFORT_ID_TO
AND OB3.ESTIMATED_START_DATE       <= @date0101
AND OB3.ESTIMATED_COMPLETION_DATE  >= @date0101 
JOIN WORK_EFFORT_TYPE OB3T ON OB3T.WORK_EFFORT_TYPE_ID = OB3.WORK_EFFORT_TYPE_ID																										
JOIN PARTY ST ON  ST.PARTY_ID = OB3.ORG_UNIT_ID 
JOIN PARTY_PARENT_ROLE SC ON SC.PARTY_ID = ST.PARTY_ID  AND SC.ROLE_TYPE_ID = 'ORGANIZATION_UNIT'
LEFT JOIN PARTY_RELATIONSHIP PR 
ON  PR.PARTY_ID_FROM =  OB3.ORG_UNIT_ID 
AND PR.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
AND PR.FROM_DATE <= @date0101																	
AND (PR.THRU_DATE is null  or PR.THRU_DATE  > @date0101)
LEFT JOIN PARTY R 
ON  PR.PARTY_ID_TO =  R.PARTY_ID
ORDER BY
	OB1.SOURCE_REFERENCE_ID,
	OB2.SOURCE_REFERENCE_ID,
	OB3.SOURCE_REFERENCE_ID;
   ]]></xml-property>
