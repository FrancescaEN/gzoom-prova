            <xml-property name="queryText"><![CDATA[select 
	    a.etch as etch, a.work_effort_name as name, a.work_effort_id as id, a.source_reference_id as code,  
		indic.g_input_enum_id,
		indic.g_account_code,
		indic.g_account_name,
		indic.g_gl_account_type_id,
		indic.m_sequence_id,
		indic.m_work_effort_measure_id,		
		indic.g_uom_abbreviation,
		indic.m_kpi_score_weight,
		indic.g_uom_decimal_scale,
		indic.m_uom_descr,
		indic.m_we_measure_type_enum_id,
		indic.g_gl_account_id,	
		indic.g_uom_type_id,
		indic.m_thru_date,
		indic.g_description,
		gt.description as gt_description,
		indic.m_comments,
		enu.description as gcenum,
		ty.etch as tipologia,
      max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'BUDGET' and indic.tt_transaction_date = @3112Date then indic.tm_amount else null end)  budget_dato,
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'BUDGET' and indic.tt_transaction_date = @3112Date then indic.r_uom_code else null end)  budget_cod,	  	   
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'BUDGET' and indic.tt_transaction_date = @3112Date then indic.tt_description else null end) budget_commento,
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'BUDGET' and indic.tt_transaction_date = @3112Date then indic.tm_description else null end)  budget_riferimento,
	  
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'ACTUAL' and indic.tt_transaction_date = @3112Date then indic.tm_amount else null end)  actual_dato,
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'ACTUAL' and indic.tt_transaction_date = @3112Date then indic.r_uom_code else null end)  actual_cod,	  	   
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'ACTUAL' and indic.tt_transaction_date = @3112Date then indic.tt_description else null end) actual_commento,
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'ACTUAL' and indic.tt_transaction_date = @3112Date then indic.tm_description else null end)  actual_riferimento,
	    	  
	  max(p.party_name) as dir_name,
	  max(ppr.parent_role_code) as dir_code
	
	from work_effort a
	left outer join work_effort_trans_noobj_view indic on indic.m_work_effort_id = a.work_effort_id
	left outer join work_effort_type ty on ty.work_effort_type_id = indic.w_work_effort_type_id 
	left outer join enumeration enu on enu.enum_id = indic.g_debit_credit_default 	
    left outer join gl_account_type gt on gt.gl_account_type_id = indic.g_gl_account_type_id
	left outer join gl_account ga on ga.gl_account_id = indic.g_gl_account_id
    left outer join party p on p.party_id = ga.resp_center_id
    left outer join party_parent_role ppr on ppr.party_id = p.party_id and ppr.role_type_id = 'ORGANIZATION_UNIT'
    left outer join work_effort_purpose_account wepa on wepa.gl_account_id = indic.g_gl_account_id

	where (indic.g_gl_account_id <> 'SCORE' or indic.g_gl_account_id is null)
		 and indic.g_account_type_enum_id = 'INDICATOR'
   		 and indic.m_thru_date >= ?
	  	 and indic.m_from_date <= ?
	  	 and a.work_effort_id = ?
	  	 and wepa.work_effort_purpose_type_id = '19INDSTR'
	  	 and ga.detect_org_unit_id_flag = 'Y'
	  	 
 group by  
		a.etch, a.work_effort_name, a.work_effort_id, a.source_reference_id,          	
		indic.g_input_enum_id,
		indic.g_account_code,
		indic.g_account_name,
		indic.g_gl_account_type_id,
		indic.m_sequence_id,
		indic.m_work_effort_measure_id,		
		indic.g_uom_abbreviation,
		indic.m_kpi_score_weight,
		indic.g_uom_decimal_scale,
		indic.m_uom_descr,
		indic.m_we_measure_type_enum_id,
		indic.g_gl_account_id,	
		indic.g_uom_type_id,
		indic.m_thru_date,
		indic.g_description,
		gt.description,
		indic.m_comments,
		enu.description,
		ty.etch
order by
		indic.g_account_code,
  		indic.g_gl_account_id ,
  		indic.m_work_effort_measure_id
]]></xml-property>
        </oda-data-set>
    </data-sets>
