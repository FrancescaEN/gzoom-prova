    <property name="units">in</property>
    <method name="initialize"><![CDATA[importPackage(Packages.java.util);
importPackage(Packages.java.lang);
importPackage(Packages.javolution.util);
importPackage(Packages.org.ofbiz.base.util);
importPackage(Packages.com.mapsengineering.base.appheader);
importPackage(Packages.it.mapsgroup.gzoom);
importPackage(Packages.com.mapsengineering.base.birt.util);

var vectorPageNumber = new Vector();
reportContext.setGlobalVariable("vectorPageNumber", vectorPageNumber);
reportContext.setGlobalVariable("nPagina", 1);
reportContext.setGlobalVariable("NpageIndex", 0 );
reportContext.setGlobalVariable("nPageEmpty", 0 );

var logo_large = AppHeaderLogo.getReportContentUrl("REPORT_LARGE", params["defaultOrganizationPartyId"].value);
reportContext.setPersistentGlobalVariable("logo_large", logo_large);

var mapRealPageNumber = reportContext.getPersistentGlobalVariable("mapRealPageNumber");
if (mapRealPageNumber == null ) {
	mapRealPageNumber = new java.util.HashMap();
	reportContext.setPersistentGlobalVariable("mapRealPageNumber", mapRealPageNumber);
}

var title = reportContext.getMessage('HeaderLabel', reportContext.getLocale());


var isMonitoring = false;
var reportTitle = "";
if((BirtDateTime.month(params["monitoringDate"].value) == BirtDateTime.month(params["date3006"].value)) &amp;&amp; 
	(BirtDateTime.day(params["monitoringDate"].value) == BirtDateTime.day(params["date3006"].value)) ||
		(BirtDateTime.month(params["monitoringDate"].value) == BirtDateTime.month(params["date3112"].value)) &amp;&amp; 
	(BirtDateTime.day(params["monitoringDate"].value) == BirtDateTime.day(params["date3112"].value)))
{
	reportTitle = reportContext.getMessage('report_title_rend2', reportContext.getLocale());
	isMonitoring = true;
}
else
{
	reportTitle = reportContext.getMessage('report_title_rend1', reportContext.getLocale());
}]]></method>
    <method name="beforeFactory"><![CDATA[function dropElement(name) {
	var element = reportContext.getDesignHandle().findElement(name);
	element.drop();
}
// 
if (params["outputFormat"].value == 'xls') {	
	dropElement("masterGrid");
} else {
	dropElement("masterTable");
}]]></method>
