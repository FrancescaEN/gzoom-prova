                    </row>
                </header>
            </group>
        </table>
    </body>
    <property name="pageVariables">
        <variable-element name="NpageNumber">
            <property name="type">page</property>
        </variable-element>
        <variable-element name="NpageIndexRoman">
            <property name="type">page</property>
        </variable-element>
        <variable-element name="NumberPageEmpty">
            <expression name="value" type="javascript">0</expression>
            <property name="type">report</property>
        </variable-element>
        <variable-element name="items">
            <expression name="value" type="javascript">0</expression>
            <property name="type">report</property>
        </variable-element>
    </property>
</report>
