                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select a.work_effort_name as nameIndir
from work_effort_assoc z
inner join work_effort a on a.work_effort_id = z.work_effort_id_from
where  a.work_effort_type_id='19PM02'
	and z.work_effort_id_to = ?
	and z.from_date <= @3112Date --@endyearmonitoringDate
	and z.thru_date >= @0101Date --@beginyearnomonitoringDate]]></xml-property>
