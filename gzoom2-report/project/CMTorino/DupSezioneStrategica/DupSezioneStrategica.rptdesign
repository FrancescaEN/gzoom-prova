                    <property name="position">37</property>
                    <property name="name">current_status_id</property>
                    <property name="nativeName">current_status_id</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">38</property>
                    <property name="name">g_account_code</property>
                    <property name="nativeName">g_account_code</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">39</property>
                    <property name="name">g_account_name</property>
                    <property name="nativeName">g_account_name</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">40</property>
                    <property name="name">g_uom_abbreviation</property>
                    <property name="nativeName">g_uom_abbreviation</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">41</property>
                    <property name="name">g_description</property>
                    <property name="nativeName">g_description</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">42</property>
                    <property name="name">m_work_effort_id</property>
                    <property name="nativeName">m_work_effort_id</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">43</property>
                    <property name="name">gt_description</property>
                    <property name="nativeName">gt_description</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">44</property>
                    <property name="name">org_uni_name</property>
                    <property name="nativeName">org_uni_name</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">45</property>
                    <property name="name">natura</property>
                    <property name="nativeName">natura</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">46</property>
                    <property name="name">gcenum</property>
                    <property name="nativeName">gcenum</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select 
	 rad.work_effort_name as title, rat.etch as rad_titolo_etch, rad.work_effort_id as id_rad, radtc.etch as rad_titolo,
     b1.etch as etichetta1, a1.etch as etch1, a1.work_effort_name as name1, z1.sequence_num as seq1, a1.work_effort_id as id1, a1.description as description1, z1.assoc_weight as assoc_weight1, a1.source_reference_id as code1,
     b2.etch as etichetta2, FIL_W.etch as etch2, FIL_W.work_effort_name as name2, z2.sequence_num as seq2, FIL_W.work_effort_id as id2, FIL_W.description as description2, z2.assoc_weight as assoc_weight2, FIL_W.source_reference_id as code2,
     ob_op.*    
	     
from work_effort rad
inner join work_effort_type rat on rat.work_effort_type_id = rad.work_effort_type_id	

inner join work_effort_type_content radtc on radtc.work_effort_type_id = @workEffortTypeId
	 and radtc.content_id = @reportContentId  
	
-- struttura 1 livello - Missione
inner join work_effort_assoc z1 on z1.work_effort_id_from = rad.work_effort_id
	 and z1.work_effort_assoc_type_id = rat.hierarchy_assoc_type_id
	 and (z1.from_date <= @monitoringDate and (z1.thru_date >= @monitoringDate or z1.thru_date is null))
inner join work_effort a1 on a1.work_effort_id = z1.work_effort_id_to
     inner join work_effort_assoc_type d1 on d1.work_effort_assoc_type_id = z1.work_effort_assoc_type_id     
     inner join work_effort_type b1 on b1.work_effort_type_id = a1.work_effort_type_id      

-- strutture 2 livello - Programma
inner join work_effort_assoc z2 on z2.work_effort_id_from = a1.work_effort_id
     and z2.work_effort_assoc_type_id = rat.hierarchy_assoc_type_id
     and (z2.from_date <= @monitoringDate and (z2.thru_date >= @monitoringDate or z2.thru_date is null)) 
inner join work_effort FIL_W on FIL_W.work_effort_id = z2.work_effort_id_to
inner join work_effort_assoc_type d2 on d2.work_effort_assoc_type_id = z2.work_effort_assoc_type_id     
inner join work_effort_type b2 on b2.work_effort_type_id = FIL_W.work_effort_type_id 

@filterInnerJoin
@filterLeftJoin	

	-- 3 livello obiettivi strategici (opzionali) 
left outer join (
	select  z.work_effort_id_from as work_effort_id_from4, b.etch as etichetta4, a.etch as etch4, a.work_effort_name as name4, z.sequence_num as seq4, a.work_effort_id as id4, a.description as description4, z.assoc_weight as assoc_weight4, a.source_reference_id as code4 ,
		b.code_prefix as pref4,
		a.estimated_start_date as estimated_start_date4, a.estimated_completion_date as estimated_completion_date4,	
		i.amount4, z.work_effort_revision_id as z_work_effort_revision_id, a.work_effort_revision_id as a_work_effort_revision_id,
		a.work_effort_type_id, a.current_status_id,
		ind.g_account_code, ind.g_account_name, ind.g_uom_abbreviation, ind.g_description, ind.m_work_effort_id,
		ind.gt_description, ind.org_uni_name, ind.natura, ind.gcenum
	
 	from work_effort_assoc z
    inner join work_effort a on a.work_effort_id = z.work_effort_id_to
	inner join work_effort_type b on b.work_effort_type_id = a.work_effort_type_id  
	   
	-- punteggio obiettivo strategico
	left outer join (
          select q.work_effort_id as id_amount4, max(r.amount) as amount4
          from acctg_trans q
          inner join acctg_trans_entry r on q.acctg_trans_id = r.acctg_trans_id
          where r.gl_account_id = 'SCORE' 
          		and r.gl_fiscal_type_id = 'ACTUAL'
          		and q.transaction_date = @monitoringDate
          group by q.work_effort_id
       ) i on i.id_amount4 = a.work_effort_id		
	 
	 -- indicatori
	left outer join (
		select 
		indic.g_account_code,
		indic.g_account_name,
		indic.g_uom_abbreviation,
		indic.g_description,
		indic.m_work_effort_id,
		gt.description as gt_description,
		pa.party_name as org_uni_name,
		grt.description as natura,
		enu.description as gcenum
		
		from work_effort_trans_noobj_view indic
		left outer join work_effort_purpose_account wepa on wepa.gl_account_id = indic.g_gl_account_id
		left outer join enumeration enu on enu.enum_id = indic.g_debit_credit_default 
		left outer join acctg_trans_view g on g.b_gl_account_id= 'SCOREKPI' AND g.b_gl_fiscal_type_id = 'ACTUAL' AND g.b_voucher_ref = indic.m_work_effort_measure_id 
			and g.b_gl_fiscal_type_id = indic.tm_gl_fiscal_type_id and g.a_transaction_date = indic.tt_transaction_date	
		left outer join gl_account_type gt on gt.gl_account_type_id = indic.g_gl_account_type_id
		left outer join gl_account_role gr on gr.gl_account_id = indic.g_gl_account_id and gr.role_type_id = 'DIR'
		  and gr.from_date <= @monitoringDate and (gr.thru_date is null or gr.thru_date >= @monitoringDate)
		left outer join gl_account ga on ga.gl_account_id = gr.gl_account_id
    	left outer join party pa on pa.party_id = ga.resp_center_id
		left outer join gl_resource_type grt on grt.gl_resource_type_id = indic.g_gl_resource_type_id

		where (indic.g_gl_account_id <> 'SCORE' or indic.g_gl_account_id is null)
			 and indic.g_account_type_enum_id = 'INDICATOR'
			 and wepa.work_effort_purpose_type_id = '19AMBMIS'
			 and indic.m_thru_date >= @0101Date
			 and indic.m_from_date <= @3112Date
			 
		order by
			indic.g_account_code
	) ind on ind.m_work_effort_id = a.work_effort_id
  
	where  z.work_effort_assoc_type_id = '19BLOBS' 
		 and z.from_date <= @monitoringDate
		 and z.thru_date >= @monitoringDate 
		 @orgUnitId	
) ob_op on ob_op.work_effort_id_from4 = FIL_W.work_effort_id


where ob_op.id4 is not null
	@workEffortIdChild
	@workEffortId
	
	@filterWhere
	and ((rad.work_effort_revision_id is null and ob_op.a_work_effort_revision_id is null) or (rad.work_effort_revision_id is not null and rad.work_effort_revision_id = ob_op.a_work_effort_revision_id))
	and ((rad.work_effort_revision_id is null and ob_op.z_work_effort_revision_id is null) or (rad.work_effort_revision_id is not null and rad.work_effort_revision_id = ob_op.z_work_effort_revision_id))]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="IndirizziStrategiciDS" id="56768">
            <list-property name="parameters"/>
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">work_effort_name</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">note_info</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <method name="beforeOpen"><![CDATA[

this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );
//this.queryText = this.queryText.replace("@monitoringDate", "'2018-12-31 00:00:00.000'");

]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">work_effort_name</property>
                    <property name="nativeName">work_effort_name</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">note_info</property>
                    <property name="nativeName">note_info</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select ind.work_effort_name, nd.note_info
from work_effort ind
left outer join work_effort_note wn on wn.work_effort_id = ind.work_effort_id
left outer join note_data nd on wn.note_id = nd.note_id
where ind.work_effort_type_id='19PM02'and nd.note_name = 'Descrizione'
and nd.note_date_time <= @monitoringDate
and ind.work_effort_revision_id is null 
and ind.estimated_start_date <= @monitoringDate
and ind.estimated_completion_date >= @monitoringDate
order by ind.source_reference_id]]></xml-property>
            <xml-property name="designerValues"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<model:DesignValues xmlns:design="http://www.eclipse.org/datatools/connectivity/oda/design" xmlns:model="http://www.eclipse.org/birt/report/model/adapter/odaModel">
