            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">work_effort_id</property>
                    <property name="nativeName">work_effort_id</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">party_name</property>
                    <property name="nativeName">party_name</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">description</property>
                    <property name="nativeName">description</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select 
	ob.work_effort_id,  
	p.party_name,
	rt.description
	
from work_effort ob
inner join work_effort_party_assignment a on a.work_effort_id = ob.work_effort_id
	and a.from_date <= @monitoringDate
    and a.thru_date >= @monitoringDate

inner join party p on p.party_id = a.party_id
inner join role_type rt on rt.role_type_id = a.role_type_id
  
where ob.work_effort_id = ?
--and a.role_type_id='WEM_SIND_METR'
and a.role_type_id not in ('DIR')
group by ob.work_effort_id, p.party_name, rt.description
order by p.party_name]]></xml-property>
