            <xml-property name="queryText"><![CDATA[select 
	 rad.work_effort_name as title, rat.etch as rad_titolo_etch, rad.work_effort_id as id_rad, radtc.etch as rad_titolo,
     b1.etch as etichetta1, a1.etch as etch1, a1.work_effort_name as name1, z1.sequence_num as seq1, a1.work_effort_id as id1, a1.description as description1, z1.assoc_weight as assoc_weight1, a1.source_reference_id as code1,
     b2.etch as etichetta2, FIL_W.etch as etch2, FIL_W.work_effort_name as name2, z2.sequence_num as seq2, FIL_W.work_effort_id as id2, FIL_W.description as description2, z2.assoc_weight as assoc_weight2, FIL_W.source_reference_id as code2,
     ob_op.*    
	     
from work_effort rad
inner join work_effort_type rat on rat.work_effort_type_id = rad.work_effort_type_id	

inner join work_effort_type_content radtc on radtc.work_effort_type_id = @workEffortTypeId
	 and radtc.content_id = @reportContentId  
	
-- struttura 1 livello - Missione
inner join work_effort_assoc z1 on z1.work_effort_id_from = rad.work_effort_id
	 and z1.work_effort_assoc_type_id = rat.hierarchy_assoc_type_id
	 and (z1.from_date <= @monitoringDate and (z1.thru_date >= @monitoringDate or z1.thru_date is null))
inner join work_effort a1 on a1.work_effort_id = z1.work_effort_id_to
     inner join work_effort_assoc_type d1 on d1.work_effort_assoc_type_id = z1.work_effort_assoc_type_id     
     inner join work_effort_type b1 on b1.work_effort_type_id = a1.work_effort_type_id      

-- strutture 2 livello - Programma
inner join work_effort_assoc z2 on z2.work_effort_id_from = a1.work_effort_id
     and z2.work_effort_assoc_type_id = rat.hierarchy_assoc_type_id
     and (z2.from_date <= @monitoringDate and (z2.thru_date >= @monitoringDate or z2.thru_date is null)) 
inner join work_effort FIL_W on FIL_W.work_effort_id = z2.work_effort_id_to
inner join work_effort_assoc_type d2 on d2.work_effort_assoc_type_id = z2.work_effort_assoc_type_id     
inner join work_effort_type b2 on b2.work_effort_type_id = FIL_W.work_effort_type_id 

@filterInnerJoin
@filterLeftJoin	

	-- 3 livello obiettivi strategici (opzionali) 
left outer join (
	select  z.work_effort_id_from as work_effort_id_from4, b.etch as etichetta4, a.etch as etch4, a.work_effort_name as name4, z.sequence_num as seq4, a.work_effort_id as id4, a.description as description4, z.assoc_weight as assoc_weight4, a.source_reference_id as code4 ,
		b.code_prefix as pref4,
		a.estimated_start_date as estimated_start_date4, a.estimated_completion_date as estimated_completion_date4,	
		i.amount4, z.work_effort_revision_id as z_work_effort_revision_id, a.work_effort_revision_id as a_work_effort_revision_id,
		a.work_effort_type_id, a.current_status_id     
		
 	from work_effort_assoc z
    inner join work_effort a on a.work_effort_id = z.work_effort_id_to
	inner join work_effort_assoc_type d on d.work_effort_assoc_type_id = z.work_effort_assoc_type_id     
	inner join work_effort_type b on b.work_effort_type_id = a.work_effort_type_id  
	   
-- punteggio obiettivo strategico
	left outer join (
          select q.work_effort_id as id_amount4, max(r.amount) as amount4
          from acctg_trans q
          inner join acctg_trans_entry r on q.acctg_trans_id = r.acctg_trans_id
          where r.gl_account_id = 'SCORE' 
          		and r.gl_fiscal_type_id = 'ACTUAL'
          		and q.transaction_date = @monitoringDate
          group by q.work_effort_id
       ) i on i.id_amount4 = a.work_effort_id		
	where  z.work_effort_assoc_type_id = '19BLOBS' 
		 and z.from_date <= @monitoringDate
		 and z.thru_date >= @monitoringDate  	
		 @orgUnitId
) ob_op on ob_op.work_effort_id_from4 = FIL_W.work_effort_id


where ob_op.id4 is not null
	@workEffortIdChild
	@workEffortId
	
	@filterWhere
	and ((rad.work_effort_revision_id is null and ob_op.a_work_effort_revision_id is null) or (rad.work_effort_revision_id is not null and rad.work_effort_revision_id = ob_op.a_work_effort_revision_id))
	and ((rad.work_effort_revision_id is null and ob_op.z_work_effort_revision_id is null) or (rad.work_effort_revision_id is not null and rad.work_effort_revision_id = ob_op.z_work_effort_revision_id))
	
	]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="WorkEffortPartyAssignmentDS" id="54766">
