                    <property name="name">note_name</property>
                    <property name="nativeName">note_name</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">note_info</property>
                    <property name="nativeName">note_info</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">note_date_time</property>
                    <property name="nativeName">note_date_time</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">sequence_id</property>
                    <property name="nativeName">sequence_id</property>
                    <property name="dataType">decimal</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select 
  nd.note_name, 
  nd.note_info, 
  nd.note_date_time, 
  wn.sequence_id
from work_effort_note wn
inner join note_data nd on wn.note_id = nd.note_id
inner join work_effort we on we.work_effort_id = wn.work_effort_id
left outer join work_effort_type_attr attr on attr.work_effort_type_id = we.work_effort_type_id
and attr.attr_name = nd.note_name
where wn.work_effort_id = ?
and nd.note_date_time <= @monitoringDate
and wn.sequence_id = 1
order by nd.note_date_time desc]]></xml-property>
