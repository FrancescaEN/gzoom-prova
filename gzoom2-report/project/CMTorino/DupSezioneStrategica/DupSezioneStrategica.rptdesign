                    <property name="name">actual_scorekpi</property>
                    <property name="nativeName">actual_scorekpi</property>
                    <property name="dataType">float</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select 
	    a.etch as etch, a.work_effort_name as name, a.work_effort_id as id, a.source_reference_id as code,  
		indic.g_input_enum_id,
		indic.g_account_code,
		indic.g_account_name,
		indic.g_gl_account_type_id,
		indic.m_sequence_id,
		indic.m_work_effort_measure_id,		
		indic.g_uom_abbreviation,
		indic.m_kpi_score_weight,
		indic.g_uom_decimal_scale,
		indic.m_uom_descr,
		indic.m_we_measure_type_enum_id,
		indic.g_gl_account_id,	
		indic.g_uom_type_id,
		indic.m_thru_date,
		indic.g_description,
		gt.description as gt_description,
		indic.m_comments,
		enu.description as gcenum,
		pa.party_name as org_uni_name,
		ty.etch as tipologia,
		grt.description as natura,
      max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'BUDGET' and indic.tt_transaction_date = @monitoringDate then indic.tm_amount else null end)  budget_dato,
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'BUDGET' and indic.tt_transaction_date = @monitoringDate then indic.r_uom_code else null end)  budget_cod,	  	   
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'BUDGET' and indic.tt_transaction_date = @monitoringDate then indic.tt_description else null end) budget_commento,
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'BUDGET' and indic.tt_transaction_date = @monitoringDate then indic.tm_description else null end)  budget_riferimento,
	  
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'ACTUAL' and indic.tt_transaction_date = @monitoringDate then indic.tm_amount else null end)  actual_dato,
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'ACTUAL' and indic.tt_transaction_date = @monitoringDate then indic.r_uom_code else null end)  actual_cod,	  	   
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'ACTUAL' and indic.tt_transaction_date = @monitoringDate then indic.tt_description else null end) actual_commento,
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'ACTUAL' and indic.tt_transaction_date = @monitoringDate then indic.tm_description else null end)  actual_riferimento,
	    	  
	  max(case when g.a_transaction_date = @monitoringDate then g.b_amount else null end ) actual_scorekpi
	
	from work_effort a
	left outer join work_effort_trans_noobj_view indic on indic.m_work_effort_id = a.work_effort_id
	left outer join work_effort_purpose_account wepa on wepa.gl_account_id = indic.g_gl_account_id
	left outer join work_effort_type ty on ty.work_effort_type_id = indic.w_work_effort_type_id 
	left outer join enumeration enu on enu.enum_id = indic.g_debit_credit_default 
	left outer join acctg_trans_view g on g.b_gl_account_id= 'SCOREKPI' and g.b_gl_fiscal_type_id = 'ACTUAL' and g.b_voucher_ref = indic.m_work_effort_measure_id 
    	and g.b_gl_fiscal_type_id = indic.tm_gl_fiscal_type_id and g.a_transaction_date = indic.tt_transaction_date	
    left outer join gl_account_type gt on gt.gl_account_type_id = indic.g_gl_account_type_id
	left outer join gl_account_role gr on gr.gl_account_id = indic.g_gl_account_id and gr.role_type_id = 'DIR'
	  and gr.from_date <= @monitoringDate and (gr.thru_date is null or gr.thru_date >= @monitoringDate)
	left outer join gl_account ga on ga.gl_account_id = gr.gl_account_id
    left outer join party pa on pa.party_id = ga.resp_center_id
    left outer join gl_resource_type grt on grt.gl_resource_type_id = indic.g_gl_resource_type_id

	where (indic.g_gl_account_id <> 'SCORE' or indic.g_gl_account_id is null)
		 and indic.g_account_type_enum_id = 'INDICATOR'
		 and wepa.work_effort_purpose_type_id = '19AMBMIS'
   		 and indic.m_thru_date >= @0101Date
	  	 and indic.m_from_date <= @3112Date
	  	 and a.work_effort_id = ?
	  	 
 group by  
		a.etch, a.work_effort_name, a.work_effort_id, a.source_reference_id,          	
		indic.g_input_enum_id,
		indic.g_account_code,
		indic.g_account_name,
		indic.g_gl_account_type_id,
		indic.m_sequence_id,
		indic.m_work_effort_measure_id,		
		indic.g_uom_abbreviation,
		indic.m_kpi_score_weight,
		indic.g_uom_decimal_scale,
		indic.m_uom_descr,
		indic.m_we_measure_type_enum_id,
		indic.g_gl_account_id,	
		indic.g_uom_type_id,
		indic.m_thru_date,
		indic.g_description,
		gt.description,
		indic.m_comments,
		enu.description,
		pa.party_name,
		grt.description,
		ty.etch
order by
		indic.g_account_code,
  		indic.g_gl_account_id ,
  		indic.m_work_effort_measure_id
]]></xml-property>
        </oda-data-set>
