    <method name="initialize"><![CDATA[importPackage(Packages.java.util);
importPackage(Packages.java.lang);
importPackage(Packages.javolution.util);
importPackage(Packages.org.ofbiz.base.util);
importPackage(Packages.com.mapsengineering.base.appheader);
importPackage(Packages.it.mapsgroup.gzoom);
importPackage(Packages.com.mapsengineering.base.birt.util);

var vectorPageNumber = new Vector();
reportContext.setGlobalVariable("vectorPageNumber", vectorPageNumber);
reportContext.setGlobalVariable("nPagina", 1);
reportContext.setGlobalVariable("NpageIndex", 0 );

var logo_login = AppHeaderLogo.getReportContentUrl("LOGO_LOGIN", params["defaultOrganizationPartyId"].value);
reportContext.setPersistentGlobalVariable("logo_login", logo_login);
]]></method>
    <method name="beforeFactory"><![CDATA[importPackage(Packages.java.util);
importPackage(Packages.java.lang);

function dropElement(name) {
	var element = reportContext.getDesignHandle().findElement(name);
	element.drop();
}
// Tabella degli indetificativi
if (params["reportContentId"].value != 'REPORT_IDENT_PROC' &amp;&amp; params["reportContentId"].value != 'REPO_IDENT_PROC_NOTE' ) {
	dropElement("tbProcessiPDF");	
} else if (params["outputFormat"].value == 'xls') {	
	dropElement("tbProcessiPDF");
} else {
	dropElement("Processi");
}

// Tabella del catalogo
if (params["reportContentId"].value != 'REPORT_CAT_PROC' &amp;&amp; params["reportContentId"].value != 'REPO_CAT_PROC_NOTE' ) {
	dropElement("tbCatalogoProcessiPDF");	
} else if (params["outputFormat"].value == 'xls') {	
	dropElement("tbCatalogoProcessiPDF");
} else {
	dropElement("Processi");
}

// elimino i processi sono se sono nel caso di stampa rischio
if (params["reportContentId"].value != 'REPORT_CAT_PROC' &amp;&amp; params["reportContentId"].value != 'REPO_CAT_PROC_NOTE' &amp;&amp;
	params["reportContentId"].value != 'REPORT_IDENT_PROC' &amp;&amp; params["reportContentId"].value != 'REPO_IDENT_PROC_NOTE' ) {
	dropElement("Processi");
}

// Tabella del catalogo
if (params["reportContentId"].value != 'REPO_RISCHIO' &amp;&amp; params["reportContentId"].value != 'REPO_RISC_NOTE' ) {
	dropElement("tbRischioPDF");	
	dropElement("Rischio");
} else if (params["outputFormat"].value == 'xls') {	
	dropElement("tbRischioPDF");
} else {
	dropElement("Rischio");
}]]></method>
