            <method name="beforeOpen"><![CDATA[/**/
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value );


/*
this.queryText = this.queryText.replace("@date3112", "'2021-12-31 00:00:00.000'");
this.queryText = this.queryText.replace("@date0101", "'2021-01-01 00:00:00.000'");
*/


//GESTIRE PERMESSI
 
 /**/
filter = new com.mapsengineering.base.birt.util.UtilFilter(params["userLoginId"].value, params["localDispatcherName"].value);
var filterInnerJoin = filter.getWorkEffortFilterInner();
var filterLeftJoin = filter.getWorkEffortFilterLeftJoin();
var filterWhere = filter.getWorkEffortFilterWhere();


var orgUnitIdString = "";
if (params["orgUnitId"].value != null &amp;&amp; params["orgUnitId"].value != '') {
	orgUnitIdString = " AND ('" + params["orgUnitId"].value + "' IS NULL OR '" + params["orgUnitId"].value + "' = '' OR '" + params["orgUnitId"].value + "' = FIL_W.ORG_UNIT_ID) ";
}


/*
var filterInnerJoin = "";
var filterLeftJoin = "";
var filterWhere = "";
*/


this.queryText = this.queryText.replace("@filterInnerJoin",  filterInnerJoin );
this.queryText = this.queryText.replace("@filterLeftJoin",  filterLeftJoin );
this.queryText = this.queryText.replace("@filterWhere",  filterWhere );
this.queryText = this.queryText.replace("@orgUnitId", orgUnitIdString);


]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">CODICE STRUTTURA</property>
                    <property name="nativeName">CODICE STRUTTURA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">DESCRIZIONE STRUTTURA</property>
                    <property name="nativeName">DESCRIZIONE STRUTTURA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">RATING DI RISCHIO</property>
                    <property name="nativeName">RATING DI RISCHIO</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT
	PPR.PARENT_ROLE_CODE AS "CODICE STRUTTURA",
	CASE WHEN P.DESCRIPTION IS NOT NULL THEN P.DESCRIPTION ELSE P.PARTY_NAME END AS "DESCRIZIONE STRUTTURA",
	WEMRS.UOM_DESCR AS "RATING DI RISCHIO"
FROM WORK_EFFORT FIL_W
JOIN PARTY_PARENT_ROLE PPR ON PPR.PARTY_ID = FIL_W.ORG_UNIT_ID
JOIN PARTY P ON P.PARTY_ID = PPR.PARTY_ID 
JOIN WORK_EFFORT_MEASURE WEM ON WEM.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID AND WEM.GL_ACCOUNT_ID = '10110'
JOIN ACCTG_TRANS ACT ON ACT.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID AND ACT.TRANSACTION_DATE = @date3112
JOIN ACCTG_TRANS_ENTRY ATE ON ATE.ACCTG_TRANS_ID = ACT.ACCTG_TRANS_ID
JOIN WORK_EFFORT_MEAS_RAT_SC WEMRS ON WEMRS.WORK_EFFORT_MEASURE_ID = ATE.VOUCHER_REF 
	AND WEMRS.UOM_RATING_VALUE <= ATE.AMOUNT AND WEMRS.UOM_RATING_VALUE >= ATE.AMOUNT

@filterInnerJoin
@filterLeftJoin

WHERE FIL_W.WORK_EFFORT_TYPE_ID IN ('15AP3F2L', '15AP3PRO', '15AP3F4C') AND FIL_W.WORK_EFFORT_REVISION_ID IS NULL
	AND FIL_W.ESTIMATED_START_DATE <= @date3112 AND (FIL_W.ESTIMATED_COMPLETION_DATE >= @date0101 OR FIL_W.ESTIMATED_COMPLETION_DATE IS NULL)

@orgUnitId
@filterWhere

GROUP BY
	PPR.PARENT_ROLE_CODE,
	CASE WHEN P.DESCRIPTION IS NOT NULL THEN P.DESCRIPTION ELSE P.PARTY_NAME END,
	ATE.AMOUNT,
	WEMRS.UOM_DESCR
HAVING (PPR.PARENT_ROLE_CODE, ATE.AMOUNT) IN (
	SELECT PPR.PARENT_ROLE_CODE, MAX(ATE.AMOUNT)
	FROM WORK_EFFORT FASE
	JOIN PARTY_PARENT_ROLE PPR ON PPR.PARTY_ID = FASE.ORG_UNIT_ID
	JOIN WORK_EFFORT_MEASURE WEM ON WEM.WORK_EFFORT_ID = FASE.WORK_EFFORT_ID AND WEM.GL_ACCOUNT_ID = '10110'
	JOIN ACCTG_TRANS ACT ON ACT.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID AND ACT.TRANSACTION_DATE = @date3112
	JOIN ACCTG_TRANS_ENTRY ATE ON ATE.ACCTG_TRANS_ID = ACT.ACCTG_TRANS_ID 
	WHERE FASE.WORK_EFFORT_TYPE_ID IN ('15AP3F2L', '15AP3PRO', '15AP3F4C') AND FASE.WORK_EFFORT_REVISION_ID IS NULL
		AND FASE.ESTIMATED_START_DATE <= @date3112 AND (FASE.ESTIMATED_COMPLETION_DATE >= @date0101 OR FASE.ESTIMATED_COMPLETION_DATE IS NULL)
	GROUP BY PPR.PARENT_ROLE_CODE 
)
ORDER BY PPR.PARENT_ROLE_CODE]]></xml-property>
