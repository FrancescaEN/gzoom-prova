                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select 
	ob.work_effort_id,  
	p.party_name,
	rt.description
	
from work_effort ob
inner join work_effort_party_assignment a on a.work_effort_id = ob.work_effort_id
	and a.from_date <= @monitoringDate
    and a.thru_date >= @monitoringDate

inner join party p on p.party_id = a.party_id
inner join role_type rt on rt.role_type_id = a.role_type_id
  
where ob.work_effort_id = ?
and rt.parent_type_id = 'ORGANIZATION_UNIT'
group by ob.work_effort_id, p.party_name, rt.description
order by p.party_name]]></xml-property>
