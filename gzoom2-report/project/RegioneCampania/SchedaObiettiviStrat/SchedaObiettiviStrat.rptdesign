            <xml-property name="queryText"><![CDATA[select 
     rad.work_effort_name as title, rat.etch as rad_titolo_etch, rad.work_effort_id as id_rad, radtc.etch as rad_titolo,
     b1.etch as etichetta1, FIL_W.etch as etch1, FIL_W.work_effort_name as name1, z1.sequence_num as seq1, FIL_W.work_effort_id as id1, FIL_W.description as description1, z1.assoc_weight as assoc_weight1, FIL_W.source_reference_id as code1,
     b2.etch as etichetta2, a2.etch as etch2, a2.work_effort_name as name2, z2.sequence_num as seq2, a2.work_effort_id as id2, a2.description as description2, z2.assoc_weight as assoc_weight2, a2.source_reference_id as code2,
     b3.etch as etichetta_tri3, a3.work_effort_id as id3, a3.etch as etch_tri3, a3.work_effort_name as name_tri3, z3.sequence_num as seq3, a3.source_reference_id as code3, z3.assoc_weight as assoc_weight3,
     b4.etch as etichetta4, a4.work_effort_id as id4, a4.etch as etch4, a4.work_effort_name as name4, z4.sequence_num as seq4, a4.source_reference_id as code4,
     rs1.party_name, ppr1.parent_role_code
from work_effort rad
inner join work_effort_type rat on rat.work_effort_type_id = rad.work_effort_type_id	
inner join work_effort_type_content radtc on radtc.work_effort_type_id = @workEffortTypeId
	 and radtc.content_id = ?
inner join status_item st1 on st1.status_id = rad.current_status_id
	
-- struttura 1 livello
inner join work_effort_assoc z1 on z1.work_effort_id_from = rad.work_effort_id
	 and z1.work_effort_assoc_type_id = rat.hierarchy_assoc_type_id
	 and ( @excludeValidity = 'Y' or  (@excludeValidity = 'N' and ( z1.from_date <= @monitoringDate and (z1.thru_date >= @monitoringDate or z1.thru_date is null ))))	 			
inner join work_effort FIL_W on FIL_W.work_effort_id = z1.work_effort_id_to
     inner join work_effort_assoc_type d1 on d1.work_effort_assoc_type_id = z1.work_effort_assoc_type_id     
     inner join work_effort_type b1 on b1.work_effort_type_id = FIL_W.work_effort_type_id 
     inner join status_item st2 on st2.status_id = FIL_W.current_status_id     

-- strutture 2 livello
left join work_effort_assoc z2 on z2.work_effort_id_from = FIL_W.work_effort_id
     and z2.work_effort_assoc_type_id = '18ORGSPLC'
     and ( @excludeValidity = 'Y' or  (@excludeValidity = 'N' and ( z2.from_date <= @monitoringDate and (z2.thru_date >= @monitoringDate or z2.thru_date is null ))))
left join work_effort a2 on a2.work_effort_id = z2.work_effort_id_to
and a2.current_status_id not in (select status_id from status_item where act_st_enum_id = 'ACTSTATUS_REPLACED')
left join work_effort_assoc_type d2 on d2.work_effort_assoc_type_id = z2.work_effort_assoc_type_id     
left join work_effort_type b2 on b2.work_effort_type_id = a2.work_effort_type_id 

left join party uo1 on uo1.party_id = fil_w.org_unit_id
left outer join party_relationship pr1 ON pr1.party_id_from = fil_w.org_unit_id and pr1.party_relationship_type_id = 'ORG_RESPONSIBLE' and pr1.thru_date is null	
left outer join party rs1 ON rs1.party_id = pr1.party_id_to
left outer join party_parent_role ppr1 on ppr1.party_id = rs1.party_id and ppr1.role_type_id = 'EMPLOYEE'

-- obiettivo strategico annuale
inner join work_effort_assoc z3 on z3.work_effort_id_from = fil_w.work_effort_id
and z3.work_effort_assoc_type_id = '18ORGSPL'
and ((rad.work_effort_revision_id is null and z3.work_effort_revision_id is null) or (rad.work_effort_revision_id is not null and rad.work_effort_revision_id = z3.work_effort_revision_id))
 and ( @excludeValidity = 'Y' or  (@excludeValidity = 'N' and ( z3.from_date <= @monitoringDate and (z3.thru_date >= @monitoringDate or z3.thru_date is null ))))
inner join work_effort a3 on a3.work_effort_id = z3.work_effort_id_to
and ((rad.work_effort_revision_id is null and a3.work_effort_revision_id is null) or (rad.work_effort_revision_id is not null and rad.work_effort_revision_id = a3.work_effort_revision_id))     
inner join work_effort_type b3 on b3.work_effort_type_id = a3.work_effort_type_id 
inner join status_item st on st.status_id = a3.current_status_id

-- obiettivo strategico triennale
left join work_effort_assoc z4 on z4.work_effort_id_to = a3.work_effort_id
and z4.work_effort_assoc_type_id = '18PMAOBST'
 and ( @excludeValidity = 'Y' or  (@excludeValidity = 'N' and ( z4.from_date <= @monitoringDate and (z4.thru_date >= @monitoringDate or z3.thru_date is null ))))
left join work_effort a4 on a4.work_effort_id = z4.work_effort_id_from  
and a4.current_status_id not in (select status_id from status_item where act_st_enum_id = 'ACTSTATUS_REPLACED')    
left join work_effort_type b4 on b4.work_effort_type_id = a4.work_effort_type_id 

@filterInnerJoin
@filterLeftJoin	
     
where  0=0
and rad.work_effort_type_id = '18ORG0AMM' and rad.work_effort_snapshot_id is null
	@orgUnitId
	
	@filterWhere
	and st.act_st_enum_id <> 'ACTSTATUS_REPLACED'
	and st1.act_st_enum_id <> 'ACTSTATUS_REPLACED'
	and st2.act_st_enum_id <> 'ACTSTATUS_REPLACED'
	@typeId
	@statusId
	order by FIL_W.etch]]></xml-property>
        </oda-data-set>
