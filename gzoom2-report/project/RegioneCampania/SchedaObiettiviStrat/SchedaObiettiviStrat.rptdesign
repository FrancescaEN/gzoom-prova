            </list-property>
            <xml-property name="queryText"><![CDATA[select 
  a.work_effort_id_to, 
  a.from_date, 
  a.thru_date,
  b.work_effort_id,
  b.etch, 
  b.work_effort_name
from work_effort_assoc a
inner join work_effort b on b.work_effort_id = a.work_effort_id_from
where a.work_effort_id_to = ? 
and a.work_effort_assoc_type_id = '19DEFSTKC'
and a.from_date <= @monitoringDate and (a.thru_date is null or a.thru_date >= @monitoringDate)
order by b.source_reference_id]]></xml-property>
