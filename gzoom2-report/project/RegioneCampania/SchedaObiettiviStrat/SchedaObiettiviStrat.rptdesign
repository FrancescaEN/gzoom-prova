            <xml-property name="queryText"><![CDATA[select 
  we.work_effort_id,
  we.etch, 
  we.work_effort_name 
from work_effort_assoc wea
inner join work_effort we 
 on we.work_effort_id = wea.work_effort_id_from
inner join status_item st on st.status_id = we.current_status_id
where wea.work_effort_id_to = ?
and wea.work_effort_assoc_type_id = '18PMAOBSACM'
and st.act_st_enum_id <> 'ACTSTATUS_REPLACED'
order by we.etch]]></xml-property>
