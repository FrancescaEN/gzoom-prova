            <xml-property name="queryText"><![CDATA[select
  we.etch,
  we.work_effort_name,
  we.source_reference_id,
  b.code_prefix as pref 
from work_effort_assoc wa
inner join work_effort we on we.work_effort_id = wa.work_effort_id_from
inner join work_effort_type b on b.work_effort_type_id = we.work_effort_type_id 
where wa.work_effort_id_to = ?
and wa.work_effort_assoc_type_id = '18PMAOBSA']]></xml-property>
