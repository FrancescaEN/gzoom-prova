                                                <expression name="valueExpr">importPackage(Packages.com.mapsengineering.base.birt.util);&#13;
if (row["g_uom_type_id"] == 'RATING_SCALE') {&#13;
	row["start_cod"];	&#13;
} else if (row["g_uom_type_id"] == 'DATE_MEASURE') {&#13;
	UtilDateTime.numberConvertToDate(row["start_dato"], reportContext.getLocale());&#13;
} else {&#13;
	row["start_dato"] != null ? Formatter.format(BirtStr.indexOf("%",row["FORMAT"],0) != -1 ?  row["start_dato"]/100 : row["start_dato"], row["FORMAT"]) : '';&#13;
}</expression>
