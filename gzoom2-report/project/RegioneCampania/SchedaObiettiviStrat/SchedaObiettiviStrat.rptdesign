            <method name="beforeOpen"><![CDATA[this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );
//this.queryText = this.queryText.replace("@monitoringDate", "'2018-12-31 00:00:00.000'");]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">work_effort_id</property>
                    <property name="nativeName">work_effort_id</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">party_name</property>
                    <property name="nativeName">party_name</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">description</property>
                    <property name="nativeName">description</property>
