            <method name="beforeOpen"><![CDATA[this.queryText = this.queryText.replace("@excludePerformanceKPI", "'" + params["excludePerformanceKPI"].value+ "'");


this.queryText = this.queryText.replace("@date3006",  params["date3006Sql"].value );
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );																
this.queryText = this.queryText.replace("@monitoringDate",  monitoringDate );


if (params["reportContentId"].value == 'REPORT_OBI_STRAT_OP') {
    this.queryText = this.queryText.replace("@targetDate",  params["date3112Sql"].value );
} else {
    this.queryText = this.queryText.replace("@targetDate",  monitoringDate );
}

 /*
