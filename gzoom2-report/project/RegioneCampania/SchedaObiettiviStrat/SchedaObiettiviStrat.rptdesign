            <xml-property name="queryText"><![CDATA[select 
		indic.g_input_enum_id,
		indic.g_account_code,
		indic.g_account_name,
		indic.g_gl_account_type_id,
		indic.m_sequence_id,
		indic.m_work_effort_measure_id,		
		indic.g_uom_abbreviation,
		indic.m_kpi_score_weight,
		indic.g_uom_decimal_scale,
		indic.m_uom_descr,
		indic.m_we_measure_type_enum_id,
		indic.g_gl_account_id,	
		indic.g_uom_type_id,
		indic.m_thru_date,
		wp.uom_descr,
		indic.g_description,
		gt.description as gt_description,
		indic.m_comments,
	
      max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'BUDGET' and indic.tt_transaction_date = @targetDate then indic.tm_amount else null end)  budget_dato,
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'BUDGET' and indic.tt_transaction_date = @targetDate then indic.r_uom_code else null end)  budget_cod,	  	   
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'BUDGET' and indic.tt_transaction_date = @targetDate then indic.tt_description else null end) budget_commento,
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'BUDGET' and indic.tt_transaction_date = @targetDate then indic.tm_description else null end)  budget_riferimento,
	  
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'ACTUAL' and indic.tt_transaction_date = @monitoringDate then indic.tm_amount else null end)  actual_dato,
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'ACTUAL' and indic.tt_transaction_date = @monitoringDate then indic.r_uom_code else null end)  actual_cod,	  	   
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'ACTUAL' and indic.tt_transaction_date = @monitoringDate then indic.tt_description else null end) actual_commento,
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'ACTUAL' and indic.tt_transaction_date = @monitoringDate then indic.tm_description else null end)  actual_riferimento,
	    
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'START' and indic.tt_transaction_date = @date3006 then indic.tm_amount else null end)  start_dato,
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'START' and indic.tt_transaction_date = @date3006 then indic.r_uom_code else null end)  start_cod,
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'START' and indic.tt_transaction_date = @date3006 then indic.tt_description else null end) start_commento,
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'START' and indic.tt_transaction_date = @date3006 then indic.tm_description else null end)  start_riferimento,
	  
	  max(case when g.a_transaction_date = @monitoringDate then g.b_amount else null end ) actual_scorekpi
	  
	from work_effort_trans_obj_view indic
	inner join gl_account_type gt on gt.gl_account_type_id = indic.g_gl_account_type_id
	left outer join acctg_trans_view g on g.b_gl_account_id= 'SCOREKPI' AND g.b_gl_fiscal_type_id = 'ACTUAL' AND g.b_voucher_ref = indic.m_work_effort_measure_id 
    	and g.b_gl_fiscal_type_id = indic.tm_gl_fiscal_type_id and g.a_transaction_date = indic.tt_transaction_date	
	left outer join 
	( select wm.gl_account_id, pr.product_id, wm.uom_descr
		from work_effort_measure wm
		inner join product pr on pr.product_id = wm.product_id
		where wm.work_effort_id is null) wp
		on wp.gl_account_id = indic.m_gl_account_id and wp.product_id = indic.m_product_id

	where (indic.g_gl_account_id <> 'SCORE' or indic.g_gl_account_id is null)
		 and indic.g_account_type_enum_id = 'INDICATOR'
		-- and ( indic.tm_gl_account_id <> 'SCOREKPI'	or indic.tm_gl_account_id is null )	 
		 and ( @excludePerformanceKPI = 'N' or ( @excludePerformanceKPI = 'Y' and indic.m_we_measure_type_enum_id = 'WEMT_PERF'))
		 and indic.m_work_effort_id = ?
   		 and indic.m_thru_date >= ?
	  	 and indic.m_from_date <= ?
	  	 and gt.gl_account_type_id <> 'CARATT'
	  	 	
 group by          	
		indic.g_input_enum_id,
		indic.g_account_code,
		indic.g_account_name,
		indic.g_gl_account_type_id,
		indic.m_sequence_id,
		indic.m_work_effort_measure_id,		
		indic.g_uom_abbreviation,
		indic.m_kpi_score_weight,
		indic.g_uom_decimal_scale,
		indic.m_uom_descr,
		indic.m_we_measure_type_enum_id,
		indic.g_gl_account_id,	
		indic.g_uom_type_id,
		indic.m_thru_date,
		wp.uom_descr,
		indic.g_description,
		gt.description,
		indic.m_comments	

order by
		indic.m_sequence_id,
		indic.g_account_code,
  		indic.g_gl_account_id ,
  		indic.m_work_effort_measure_id
]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="AzioneIndicatoriDS" id="54970">
            <list-property name="computedColumns">
                <structure>
                    <property name="name">INDICATORE</property>
                    <expression name="expression">if(row["g_input_enum_id"] == "ACCINP_UO"){&#13;
	 row["g_account_name"];&#13;
} else if(row["g_input_enum_id"] == "ACCINP_PRD"){&#13;
	 (row["uom_descr"] != null &amp;&amp; row["uom_descr"] != "" ? row["uom_descr"]  :  row["g_account_name"])&#13;
} else if(row["g_input_enum_id"] == "ACCINP_OBJ"){&#13;
	(row["m_uom_descr"] != null &amp;&amp; row["m_uom_descr"] != "" ? row["m_uom_descr"]  : row["g_account_name"])&#13;
} else {&#13;
	row["g_account_name"];&#13;
}</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">COUNTER</property>
                    <property name="dataType">integer</property>
                    <property name="aggregateFunction">COUNT</property>
                    <list-property name="arguments">
                        <structure>
                            <property name="name">Expression</property>
                            <expression name="value">row["id"]</expression>
                        </structure>
                    </list-property>
                </structure>
                <structure>
                    <property name="name">TITOLO</property>
                    <expression name="expression">row["etch"] != '' &amp;&amp; row["etch"] != null ? row["etch"] + " - " + row["name"] : row["name"]</expression>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
