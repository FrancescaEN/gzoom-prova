            <xml-property name="queryText"><![CDATA[select 
  a.party_id, 
  b.party_name, 
  c.parent_role_code, 
  f.description
from work_effort_party_assignment a
left join party b on b.party_id = a.party_id
left join party_parent_role c on c.party_id = b.party_id and c.role_type_id = 'EMPLOYEE'
left join person d on d.party_id = b.party_id
left join empl_position_type e on e.empl_position_type_id = d.empl_position_type_id
left join empl_position_type f on f.empl_position_type_id = e.parent_type_id
where a.work_effort_id = ?
and a.role_type_id = 'WE_ASSIGNMENT'
order by b.party_name
]]></xml-property>
