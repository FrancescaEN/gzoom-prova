            </list-property>
            <xml-property name="queryText"><![CDATA[select 
	    a.etch as etch, a.work_effort_name as name, a.work_effort_id as id, z.sequence_num as seq,  a.source_reference_id as code,  
		indic.g_input_enum_id,
		indic.g_account_code,
		indic.g_account_name,
		indic.g_gl_account_type_id,
		indic.m_sequence_id,
		indic.m_work_effort_measure_id,		
		indic.g_uom_abbreviation,
		indic.m_kpi_score_weight,
		indic.g_uom_decimal_scale,
		indic.m_uom_descr,
		indic.m_we_measure_type_enum_id,
		indic.g_gl_account_id,	
		indic.g_uom_type_id,
		indic.m_thru_date,
		wp.uom_descr,
		indic.g_description,
		gt.description as gt_description,
		
	
      max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'BUDGET' and indic.tt_transaction_date = @date3112 then indic.tm_amount else null end)  budget_dato_3112,
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'BUDGET' and indic.tt_transaction_date = @date3112 then indic.r_uom_code else null end)  budget_cod_3112,	  	   
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'BUDGET' and indic.tt_transaction_date = @date3112 then indic.tt_description else null end) budget_commento_3112,
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'BUDGET' and indic.tt_transaction_date = @date3112 then indic.tm_description else null end)  budget_riferimento_3112,
	  
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'BUDGET' and indic.tt_transaction_date = @date3006 then indic.tm_amount else null end)  budget_dato_3006,
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'BUDGET' and indic.tt_transaction_date = @date3006 then indic.r_uom_code else null end)  budget_cod_3006,	  	   
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'BUDGET' and indic.tt_transaction_date = @date3006 then indic.tt_description else null end) budget_commento_3006,
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'BUDGET' and indic.tt_transaction_date = @date3006 then indic.tm_description else null end)  budget_riferimento_3006,
	  
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'ACTUAL' and indic.tt_transaction_date = @date3112 then indic.tm_amount else null end)  actual_dato_3112,
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'ACTUAL' and indic.tt_transaction_date = @date3112 then indic.r_uom_code else null end)  actual_cod_3112,	  	   
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'ACTUAL' and indic.tt_transaction_date = @date3112 then indic.tt_description else null end) actual_commento_3112,
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'ACTUAL' and indic.tt_transaction_date = @date3112 then indic.tm_description else null end)  actual_riferimento_3112,
	  
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'ACTUAL' and indic.tt_transaction_date = @date3006 then indic.tm_amount else null end)  actual_dato_3006,
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'ACTUAL' and indic.tt_transaction_date = @date3006 then indic.r_uom_code else null end)  actual_cod_3006,	  	   
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'ACTUAL' and indic.tt_transaction_date = @date3006 then indic.tt_description else null end) actual_commento_3006,
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'ACTUAL' and indic.tt_transaction_date = @date3006 then indic.tm_description else null end)  actual_riferimento_3006,
	    
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'START' and indic.tt_transaction_date = @date3112 then indic.tm_amount else null end)  start_dato_3112,
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'START' and indic.tt_transaction_date = @date3112 then indic.r_uom_code else null end)  start_cod_3112,
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'START' and indic.tt_transaction_date = @date3112 then indic.tt_description else null end) start_commento_3112,
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'START' and indic.tt_transaction_date = @date3112 then indic.tm_description else null end)  start_riferimento_3112,
	  
	  max(case when indic.tm_gl_account_id = 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'ACTUAL' and indic.tt_transaction_date = @monitoringDate then indic.tm_amount else null end)  actual_scorekpi
	
	from work_effort_assoc z
	inner join work_effort a on a.work_effort_id = z.work_effort_id_to
	left outer join work_effort_trans_obj_view indic on indic.m_work_effort_id = z.work_effort_id_to
	left outer join gl_account_type gt on gt.gl_account_type_id = indic.g_gl_account_type_id
	left outer join 
	( select wm.gl_account_id, pr.product_id, wm.uom_descr
		from work_effort_measure wm
		inner join product pr on pr.product_id = wm.product_id
		where wm.work_effort_id is null) wp
		on wp.gl_account_id = indic.m_gl_account_id and wp.product_id = indic.m_product_id

	where (indic.g_gl_account_id <> 'SCORE' or indic.g_gl_account_id is null)
		 and indic.g_account_type_enum_id = 'INDICATOR'
		-- and ( indic.tm_gl_account_id <> 'SCOREKPI'	or indic.tm_gl_account_id is null )	 
		 and ( @excludePerformanceKPI = 'N' or ( @excludePerformanceKPI = 'Y' and indic.m_we_measure_type_enum_id = 'WEMT_PERF'))
   		 and indic.m_thru_date >= ?
	  	 and indic.m_from_date <= ?
	  	 --
	  	 and work_effort_id_from = ?
	     and z.work_effort_assoc_type_id = '18PMAOBO'
	   --  and ( @excludeValidity = 'Y' or  (@excludeValidity = 'N' and ( z.from_date <= @monitoringDate and (z.thru_date >= @monitoringDate or z.thru_date is null ))))	 			
	  	 
 group by  
		a.etch, a.work_effort_name, a.work_effort_id, z.sequence_num,  a.source_reference_id,          	
		indic.g_input_enum_id,
		indic.g_account_code,
		indic.g_account_name,
		indic.g_gl_account_type_id,
		indic.m_sequence_id,
		indic.m_work_effort_measure_id,		
		indic.g_uom_abbreviation,
		indic.m_kpi_score_weight,
		indic.g_uom_decimal_scale,
		indic.m_uom_descr,
		indic.m_we_measure_type_enum_id,
		indic.g_gl_account_id,	
		indic.g_uom_type_id,
		indic.m_thru_date,
		wp.uom_descr,
		indic.g_description,
		gt.description	

order by
		indic.g_account_code,
  		indic.g_gl_account_id ,
  		indic.m_work_effort_measure_id
]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="WorkEffortAssocDS" id="55376">
