            <xml-property name="queryText"><![CDATA[ select b.party_name from
  work_effort_party_assignment a
  inner join party b on b.party_id = a.party_id
  where a.role_type_id = 'WEM_PART_IN_CHARGE'
  and a.work_effort_id = ?
  order by b.party_name]]></xml-property>
