            <method name="beforeOpen"><![CDATA[/**/
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value);
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value);
/*this.queryText = this.queryText.replace("@date3112", "'2018-12-31 00:00:00.000'");
this.queryText = this.queryText.replace("@date0101", "'2018-12-31 00:00:00.000'");
*/
var workEffortIdStr = '';
if (params["workEffortId"].value != null &amp;&amp; params["workEffortId"].value != '') {
    workEffortIdStr = "and li.work_effort_id = '" + params["workEffortId"].value + "'";
}
this.queryText = this.queryText.replace("@workEffortId", workEffortIdStr);

//Debug.log("query DatiDerfDS:  " +this.queryText);]]></method>
