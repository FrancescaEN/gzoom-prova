            <xml-property name="queryText"><![CDATA[select 
li.work_effort_id as "LINEA_AZIONE_ID",
li.etch as "LINEA_AZIONE_NUM",
concat(mi.etch,' - ',mi.work_effort_name) as "MISSIONE",
concat(substring(pr.etch, 3, 2),' - ',pr.work_effort_name) as "PROGRAMMA",
os.work_effort_name as "OBIETTIVO_STRATEGICO",
po.work_effort_name as "POLITICA",
concat(uoc.parent_role_code,' - ', uo.party_name) as "STRUTTURA_VERTICE",
nd109.note_info as "SOGGETTI_COINVOLTI",
li.work_effort_name as "LINEA_AZIONE",
nd111.note_info as "MODALITA_IMPLEMENTAZIONE",
nd112.note_info as "MODALITA_ATTUAZIONE",
nd121.note_info as "RISULTATI_121",
nd122.note_info as "RISULTATI_122",
nd123.note_info as "RISULTATI_123",
sk1.work_effort_name as "BENEFICIARIO_PRINCIPALE",
sk2.work_effort_name as "ALTRO_BENEFICIARIO",
nd116.note_info as "LINK_BANCHEDATI",
nd117.note_info as "RISULTATI_PRECEDENTI",
fi.obiet as "OBIETTIVO_AGENDA",
fi.dom as "DOMINIO_BENESSERE",
fi.indic as "INDICATORE_BENESSERE",
fi.fonti as "FONTI"
from work_effort li
inner join party uo on uo.party_id = li.org_unit_id
inner join party_parent_role uoc on uoc.party_id = uo.party_id and uoc.role_type_id = 'ORGANIZATION_UNIT'
left join work_effort_assoc poli on poli.work_effort_id_to = li.work_effort_id
 and poli.work_effort_assoc_type_id = '19DEFDEFC'
left join work_effort po on poli.work_effort_id_from is not null 
 and po.work_effort_id = poli.work_effort_id_from
left join work_effort_assoc prli on prli.work_effort_id_to = li.work_effort_id
 and prli.work_effort_assoc_type_id = '18BILPROC'
left join work_effort pr on prli.work_effort_id_from is not null 
 and pr.work_effort_id = prli.work_effort_id_from
left join work_effort_assoc mipr on pr.work_effort_id is not null
 and mipr.work_effort_id_to = pr.work_effort_id
 and mipr.work_effort_assoc_type_id = '18BILBIL'
left join work_effort mi on mipr.work_effort_id_from is not null 
 and mi.work_effort_id = mipr.work_effort_id_from
left join work_effort_assoc osli on osli.work_effort_id_to = li.work_effort_id
 and osli.work_effort_assoc_type_id = '19DEFSCHC'
left join work_effort os on osli.work_effort_id_from is not null 
 and os.work_effort_id = osli.work_effort_id_from
inner join work_effort_note wn109 on wn109.work_effort_id = li.work_effort_id
  and wn109.sequence_id = 109
inner join note_data nd109 on nd109.note_id = wn109.note_id
inner join work_effort_note wn111 on wn111.work_effort_id = li.work_effort_id
  and wn111.sequence_id = 111
inner join note_data nd111 on nd111.note_id = wn111.note_id
inner join work_effort_note wn116 on wn116.work_effort_id = li.work_effort_id
  and wn116.sequence_id = 116
inner join note_data nd116 on nd116.note_id = wn116.note_id
inner join work_effort_note wn112 on wn112.work_effort_id = li.work_effort_id
  and wn112.sequence_id = 112
inner join note_data nd112 on nd112.note_id = wn112.note_id
left join work_effort_note wn121 on wn121.work_effort_id = li.work_effort_id
  and wn121.sequence_id = 121
left join note_data nd121 on nd121.note_id = wn121.note_id
left join work_effort_note wn122 on wn122.work_effort_id = li.work_effort_id
  and wn122.sequence_id = 122
left join note_data nd122 on nd122.note_id = wn122.note_id
inner join work_effort_note wn123 on wn123.work_effort_id = li.work_effort_id
  and wn123.sequence_id = 123
inner join note_data nd123 on nd123.note_id = wn123.note_id
inner join work_effort_note wn117 on wn117.work_effort_id = li.work_effort_id
  and wn117.sequence_id = 117
inner join note_data nd117 on nd117.note_id = wn117.note_id
left join work_effort_assoc sk1li on sk1li.work_effort_id_to = li.work_effort_id
 and sk1li.work_effort_assoc_type_id = '19DEFSTKC'
left join work_effort sk1 on sk1li.work_effort_id_from is not null 
 and sk1.work_effort_id = sk1li.work_effort_id_from
left join work_effort_assoc sk2li on sk2li.work_effort_id_to = li.work_effort_id
 and sk2li.work_effort_assoc_type_id = '19DEFSTKC2'
left join work_effort sk2 on sk2li.work_effort_id_from is not null 
 and sk2.work_effort_id = sk2li.work_effort_id_from
left join (
	select wem.work_effort_id,
	max(case when gl.gl_account_id = '10171' then gamrs.uom_descr else null end) as obiet,
	max(case when gl.gl_account_id = '10180' then gamrs.uom_descr else null end) as dom,
	max(case when gl.gl_account_id = '10181' then gamrs.uom_descr else null end) as indic,
	max(case when gl.gl_account_id = '10120' then gamrs.uom_descr else null end) as fonti
	from work_effort_measure wem
	join gl_account gl on gl.gl_account_id = wem.gl_account_id
	join work_effort_purpose_account wepa on wepa.gl_account_id = gl.gl_account_id and wepa.work_effort_purpose_type_id = 'DEFRFIN'
	left join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id
	left join gl_account_meas_rat_sc gamrs on gamrs.gl_account_id = ate.gl_account_id
	and ate.amount = gamrs.uom_rating_value
	group by
	wem.work_effort_id
) fi on fi.work_effort_id = li.work_effort_id 
 
where li.work_effort_type_id = '19DEF3NAD'
  and li.estimated_start_date <= @date3112
  and li.estimated_completion_date >= @date0101
  @workEffortId 
order by li.etch]]></xml-property>
