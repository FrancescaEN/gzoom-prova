            <xml-property name="queryText"><![CDATA[SELECT 
   FIL_W.WORK_EFFORT_ID AS ID_SCHEDA_VALUTAZIONE,
   PDO.CUSTOM_TIME_PERIOD_CODE AS PERIODO,
   SOC.PARTY_NAME AS ORGANIZZAZIONE,
   AREAROLE.DESCRIPTION AS TIPO_UNITA_APP_SUP,
   AREA.PARTY_NAME AS UNITA_APP_SUP,
   DIRIGSUP.PARTY_NAME AS RESP_APP_SUP,
   UDIRROLE.DESCRIPTION AS TIPO_UNITA_APP,
   UDIR.PARTY_ID AS ID_UNITA_APPARTENENZA,
   UDIR.PARTY_NAME AS UNITA_APPARTENENZA,
   VALUT.PARTY_NAME AS VALUTATO,
   VALPER.FIRST_NAME AS NOME,
   VALPER.LAST_NAME AS COGNOME,
   VALCOD.PARENT_ROLE_CODE AS MATRICOLA,
   CATEG.DESCRIPTION AS CATEGORIA,
   MODEL.WORK_EFFORT_ID AS ID_MODELLO_VALUTAZIONE,
   MODEL.WORK_EFFORT_NAME AS DESCR_MODELLO_VALUTAZ,
   QUALIF.PARTY_NAME AS QUALIFICA,
   REFER.PARTY_ID AS ID_REFERENTE,
   REFER.PARTY_NAME AS DENOMINAZIONE_REFERENTE,
   DIRIG.PARTY_NAME AS RESP_UNITA_APP,
   VALUT.DESCRIPTION AS ALTRI_DATI1,
   VALPER.COMMENTS AS ALTRI_DATI2,
   VALPER.EMPLOYMENT_AMOUNT AS PARTTIME,
   FIL_W.ESTIMATED_START_DATE AS INIZIO_VALUTAZIONE,
   FIL_W.ESTIMATED_COMPLETION_DATE AS FINE_VALUTAZIONE,
   WT.ETCH AS TIPO_SCHEDA,
   FIL_W.SOURCE_REFERENCE_ID AS CODICE_VALUTAZIONE,
   FIL_W.WORK_EFFORT_NAME AS NOME_VALUTAZIONE,
   FIL_W.ETCH AS ETICHETTA_VALUTAZIONE,
   FIL_W.DESCRIPTION AS INCARICHI,
   STATUS.DESCRIPTION AS STATO_VALUTAZIONE,
   (CASE WHEN WT.WEIGHT_CONTROL_SUM > 0 THEN
         WT.WEIGHT_CONTROL_SUM ELSE NULL END) AS TOTALE_PESI_VALUTAZIONE,
   SCOT.TRANSACTION_DATE AS TRANS_DATE_RISULTATO_VALUT,
   SCOE.AMOUNT AS RISULTATO_VALUTAZIONE,
   RANGE1.COMMENTS AS LIVELLO_RISULTATO_VALUTAZIONE,
   COLOR.ENUM_CODE AS CODICE_COLORE_VALUTAZIONE,
   EMOT.DATA_RESOURCE_ID AS CODICE_EMOTICON_VALUTAZIONE,
   EMOT.OBJECT_INFO AS FILE_EMOTICON_VALUTAZIONE,
   LIVELLO1.VALORE_RISULTATO_LIV1,
   LIVELLO1.LIVELLO_RISULTATO_LIV1
FROM WORK_EFFORT_TYPE  WT
INNER JOIN WORK_EFFORT FIL_W
     ON  FIL_W.WORK_EFFORT_TYPE_ID = WT.WORK_EFFORT_TYPE_ID
INNER JOIN PARTY SOC    
     ON SOC.PARTY_ID = FIL_W.ORGANIZATION_ID 
@filterInnerJoin
@filterLeftJoin
LEFT JOIN CUSTOM_TIME_PERIOD PDO    
     ON PDO.PERIOD_TYPE_ID = WT.PERIOD_TYPE_ID 
     AND PDO.FROM_DATE <= FIL_W.ESTIMATED_COMPLETION_DATE
     AND PDO.THRU_DATE >= FIL_W.ESTIMATED_COMPLETION_DATE
LEFT JOIN STATUS_ITEM STATUS    
     ON STATUS.STATUS_ID = FIL_W.CURRENT_STATUS_ID 
-- SCORE SCHEDA
LEFT JOIN WORK_EFFORT_MEASURE SCOM
     ON SCOM.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID AND SCOM.WE_MEASURE_TYPE_ENUM_ID = 'WEMT_SCORE'
LEFT JOIN ACCTG_TRANS SCOT
     ON SCOT.VOUCHER_REF = SCOM.WORK_EFFORT_MEASURE_ID 
     AND SCOT.TRANSACTION_DATE = ?    
LEFT JOIN ACCTG_TRANS_ENTRY SCOE
     ON SCOE.ACCTG_TRANS_ID = SCOT.ACCTG_TRANS_ID
LEFT JOIN UOM_RANGE_VALUES RANGE1
     ON RANGE1.UOM_RANGE_ID = WT.UOM_RANGE_SCORE_ID
     AND RANGE1.FROM_VALUE <= SCOE.AMOUNT
     AND RANGE1.THRU_VALUE >= SCOE.AMOUNT
LEFT JOIN ENUMERATION COLOR
     ON COLOR.ENUM_ID = RANGE1.COLOR_ENUM_ID
LEFT JOIN CONTENT ICON
     ON ICON.CONTENT_ID = RANGE1.ICON_CONTENT_ID
LEFT JOIN DATA_RESOURCE EMOT
     ON EMOT.DATA_RESOURCE_ID = ICON.DATA_RESOURCE_ID
-- VALUTATO
LEFT JOIN WORK_EFFORT_PARTY_ASSIGNMENT VALASS
     ON  VALASS.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID 
     AND VALASS.ROLE_TYPE_ID = 'WEM_EVAL_IN_CHARGE'
     AND VALASS.THRU_DATE = FIL_W.ESTIMATED_COMPLETION_DATE
LEFT JOIN PARTY VALUT
     ON VALUT.PARTY_ID = VALASS.PARTY_ID
LEFT JOIN PERSON VALPER
     ON VALPER.PARTY_ID = VALASS.PARTY_ID
LEFT JOIN PARTY_PARENT_ROLE VALCOD
     ON  VALCOD.PARTY_ID = VALASS.PARTY_ID
     AND VALCOD.ROLE_TYPE_ID = 'EMPLOYEE'
LEFT JOIN EMPL_POSITION_TYPE VALPOS
     ON  VALPOS.EMPL_POSITION_TYPE_ID = VALPER.EMPL_POSITION_TYPE_ID
LEFT JOIN EMPL_POSITION_TYPE CATEG
     ON  CATEG.EMPL_POSITION_TYPE_ID = VALPOS.PARENT_TYPE_ID
LEFT JOIN WORK_EFFORT MODEL
     ON  MODEL.WORK_EFFORT_ID = VALPOS.TEMPLATE_ID
LEFT JOIN PARTY_RELATIONSHIP VALQUA
     ON  VALQUA.PARTY_ID_FROM = VALASS.PARTY_ID
     AND VALQUA.PARTY_RELATIONSHIP_TYPE_ID = 'QUALIF'
     AND VALQUA.FROM_DATE <= FIL_W.ESTIMATED_COMPLETION_DATE
     AND (VALQUA.THRU_DATE IS NULL OR VALQUA.THRU_DATE >= FIL_W.ESTIMATED_COMPLETION_DATE)
LEFT JOIN PARTY QUALIF
     ON QUALIF.PARTY_ID = VALQUA.PARTY_ID_TO
-- REFERENTE
LEFT JOIN WORK_EFFORT_PARTY_ASSIGNMENT  REFASS
     ON   REFASS.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID 
     AND  REFASS.ROLE_TYPE_ID = 'WEM_EVAL_MANAGER'
     AND  REFASS.THRU_DATE = FIL_W.ESTIMATED_COMPLETION_DATE
LEFT JOIN PARTY REFER
     ON  REFER.PARTY_ID = REFASS.PARTY_ID
-- VALUTATORE (DIRIGENTE)
LEFT JOIN PARTY_RELATIONSHIP DIRREL
     ON  DIRREL.PARTY_ID_FROM = FIL_W.ORG_UNIT_ID
     AND DIRREL.ROLE_TYPE_ID_FROM = FIL_W.ORG_UNIT_ROLE_TYPE_ID
     AND DIRREL.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
     AND DIRREL.FROM_DATE <= FIL_W.ESTIMATED_COMPLETION_DATE                            
     AND (DIRREL.THRU_DATE IS NULL OR DIRREL.THRU_DATE >= FIL_W.ESTIMATED_COMPLETION_DATE) 
LEFT JOIN PARTY DIRIG
     ON  DIRIG.PARTY_ID = DIRREL.PARTY_ID_TO
-- UDIR / AREA
LEFT JOIN PARTY UDIR
     ON  UDIR.PARTY_ID = FIL_W.ORG_UNIT_ID    
LEFT JOIN ROLE_TYPE UDIRROLE
     ON  UDIRROLE.ROLE_TYPE_ID = FIL_W.ORG_UNIT_ROLE_TYPE_ID
LEFT JOIN PARTY_RELATIONSHIP  UOAR
     ON  UOAR.PARTY_ID_TO = FIL_W.ORG_UNIT_ID
     AND UOAR.ROLE_TYPE_ID_TO = FIL_W.ORG_UNIT_ROLE_TYPE_ID
     AND UOAR.FROM_DATE <= FIL_W.ESTIMATED_COMPLETION_DATE
     AND (UOAR.THRU_DATE IS NULL OR UOAR.THRU_DATE >= FIL_W.ESTIMATED_COMPLETION_DATE)
     AND UOAR.PARTY_RELATIONSHIP_TYPE_ID = 'GROUP_ROLLUP'
LEFT JOIN PARTY AREA
     ON AREA.PARTY_ID = UOAR.PARTY_ID_FROM
LEFT JOIN ROLE_TYPE AREAROLE
     ON AREAROLE.ROLE_TYPE_ID = UOAR.ROLE_TYPE_ID_FROM
 -- responsabile sup
LEFT JOIN PARTY_RELATIONSHIP DIRRELSUP
     ON  DIRRELSUP.PARTY_ID_FROM = UOAR.PARTY_ID_FROM
     AND DIRRELSUP.ROLE_TYPE_ID_FROM = UOAR.ROLE_TYPE_ID_FROM
     AND DIRRELSUP.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
     AND DIRRELSUP.FROM_DATE <= FIL_W.ESTIMATED_COMPLETION_DATE                            
     AND (DIRRELSUP.THRU_DATE IS NULL OR DIRRELSUP.THRU_DATE >= FIL_W.ESTIMATED_COMPLETION_DATE) 
LEFT JOIN PARTY DIRIGSUP
     ON  DIRIGSUP.PARTY_ID = DIRRELSUP.PARTY_ID_TO
         
     
INNER JOIN (
	SELECT
   FIL_W.WORK_EFFORT_ID AS IDENTIFICATIVO_SCHEDA_VALUTAZ,
   LIV1.WORK_EFFORT_ID AS IDENTIFICATIVO_LIVELLO1,
   SVLIV1.SEQUENCE_NUM AS SEQUENZA_TIPO_LIV1,
   LIV1TYPE.ETCH AS ETICHETTO_TIPO_LIV1,
   LIV1.SOURCE_REFERENCE_ID AS CODICE_LIV1,
   LIV1.WORK_EFFORT_NAME AS NOME_LIV1,
   LIV1.ETCH AS ETICHETTA_LIV1,
   LIV1.DESCRIPTION AS DESCRIZIONE_LIV1,
   (CASE WHEN LIV1.WEIGHT_KPI > 0 AND LIV1TYPE.WEIGHT_KPI_CONTROL_SUM > 0
              THEN LIV1TYPE.WEIGHT_KPI_CONTROL_SUM
         WHEN LIV1.WEIGHT_SONS > 0 AND LIV1TYPE.WEIGHT_CONTROL_SUM > 0
              THEN LIV1TYPE.WEIGHT_CONTROL_SUM
         WHEN LIV1.WEIGHT_ASSOC_WORK_EFFORT > 0 AND LIV1TYPE.WEIGHT_CONTROL_SUM > 0
              THEN LIV1TYPE.WEIGHT_CONTROL_SUM
         ELSE NULL END) AS TOTALE_PESO_LIV1,
   SCOT.TRANSACTION_DATE AS TRANS_DATE_RISULTATO_LIV1,
   SCOE.AMOUNT AS VALORE_RISULTATO_LIV1,
   RANGE1.COMMENTS AS LIVELLO_RISULTATO_LIV1,
   COLOR.ENUM_CODE AS CODICE_COLORE_LIV1,
   EMOT.DATA_RESOURCE_ID AS CODICE_EMOTICON_LIV1,
   EMOT.OBJECT_INFO AS FILE_EMOTICON_LIV1,
   SVLIV1.ASSOC_WEIGHT AS VALORE_PESO_LIV1,
   (CASE WHEN FIL_W.WEIGHT_KPI > 0 THEN FIL_W.TOTAL_ENUM_ID_KPI
         WHEN FIL_W.WEIGHT_SONS > 0 THEN FIL_W.TOTAL_ENUM_ID_SONS
         WHEN FIL_W.WEIGHT_ASSOC_WORK_EFFORT > 0 THEN FIL_W.TOTAL_ENUM_ID_ASSOC
         ELSE NULL END) AS TIPOLOGIA_PESATURA_LIV1,
   WEIGHT.WEIGHT_CONTROL_SUM AS PESO_RIFERIMENTO_LIV1
   
FROM WORK_EFFORT_TYPE  WT
INNER JOIN WORK_EFFORT FIL_W
     ON  FIL_W.WORK_EFFORT_TYPE_ID = WT.WORK_EFFORT_TYPE_ID
INNER JOIN WORK_EFFORT_ASSOC SVLIV1    
     ON SVLIV1.WORK_EFFORT_ID_FROM = FIL_W.WORK_EFFORT_ID 
     AND SVLIV1.WORK_EFFORT_ASSOC_TYPE_ID = WT.HIERARCHY_ASSOC_TYPE_ID
INNER JOIN WORK_EFFORT LIV1
     ON LIV1.WORK_EFFORT_ID = SVLIV1.WORK_EFFORT_ID_TO
INNER JOIN WORK_EFFORT_TYPE LIV1TYPE
     ON LIV1TYPE.WORK_EFFORT_TYPE_ID = LIV1.WORK_EFFORT_TYPE_ID 
LEFT JOIN WORK_EFFORT_MEASURE SCOM
     ON SCOM.WORK_EFFORT_ID = LIV1.WORK_EFFORT_ID
     AND SCOM.WE_MEASURE_TYPE_ENUM_ID = 'WEMT_SCORE'
LEFT JOIN ACCTG_TRANS SCOT
     ON SCOT.VOUCHER_REF = SCOM.WORK_EFFORT_MEASURE_ID 
LEFT JOIN (SELECT WEIASS.WORK_EFFORT_ID_FROM AS WORK_EFFORT_ID, WEIASS.WORK_EFFORT_ASSOC_TYPE_ID,
                  SUM(WEIASS.ASSOC_WEIGHT) AS WEIGHT_CONTROL_SUM, WEIDATE.TRANSACTION_DATE
           FROM WORK_EFFORT_ASSOC WEIASS
           INNER JOIN WORK_EFFORT_MEASURE WEIMEAS ON WEIMEAS.WORK_EFFORT_ID = WEIASS.WORK_EFFORT_ID_TO
                                                  AND WEIMEAS.WE_MEASURE_TYPE_ENUM_ID = 'WEMT_SCORE'
           INNER JOIN ACCTG_TRANS WEIDATE ON  WEIDATE.VOUCHER_REF = WEIMEAS.WORK_EFFORT_MEASURE_ID
           GROUP BY WEIASS.WORK_EFFORT_ID_FROM, WEIASS.WORK_EFFORT_ASSOC_TYPE_ID, WEIDATE.TRANSACTION_DATE) WEIGHT
     ON WEIGHT.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID AND WEIGHT.WORK_EFFORT_ASSOC_TYPE_ID = WT.HIERARCHY_ASSOC_TYPE_ID
     AND WEIGHT.TRANSACTION_DATE = SCOT.TRANSACTION_DATE
LEFT JOIN ACCTG_TRANS_ENTRY SCOE
     ON SCOE.ACCTG_TRANS_ID = SCOT.ACCTG_TRANS_ID
LEFT JOIN GL_ACCOUNT SCOACC
     ON SCOACC.GL_ACCOUNT_ID = SCOM.GL_ACCOUNT_ID
LEFT JOIN UOM SCOUOM
     ON SCOUOM.UOM_ID = SCOACC.DEFAULT_UOM_ID
LEFT JOIN UOM_RANGE_VALUES RANGE1
     ON RANGE1.UOM_RANGE_ID = LIV1TYPE.UOM_RANGE_SCORE_ID
     AND RANGE1.FROM_VALUE <= SCOE.AMOUNT
     AND RANGE1.THRU_VALUE >= SCOE.AMOUNT
LEFT JOIN ENUMERATION COLOR
     ON COLOR.ENUM_ID = RANGE1.COLOR_ENUM_ID
LEFT JOIN CONTENT ICON
     ON ICON.CONTENT_ID = RANGE1.ICON_CONTENT_ID
LEFT JOIN DATA_RESOURCE EMOT
     ON EMOT.DATA_RESOURCE_ID = ICON.DATA_RESOURCE_ID
WHERE  WT.IS_ROOT = 'Y'
  AND WT.PARENT_TYPE_ID = 'CTX_EP'
  AND WT.IS_TEMPLATE = 'N'
  AND (SVLIV1.THRU_DATE = FIL_W.ESTIMATED_COMPLETION_DATE OR 
       SVLIV1.THRU_DATE = LIV1.ESTIMATED_COMPLETION_DATE)
AND ( ? IS NULL OR '' = ? OR FIL_W.WORK_EFFORT_ID = ? ) AND LIV1TYPE.ETCH = ?
	
)  LIVELLO1 ON LIVELLO1.IDENTIFICATIVO_SCHEDA_VALUTAZ =  FIL_W.WORK_EFFORT_ID   
     
WHERE  WT.IS_ROOT = 'Y'
  AND WT.PARENT_TYPE_ID = 'CTX_EP'
  AND WT.IS_TEMPLATE = 'N'
  AND ( ? IS NULL OR '' = ? OR FIL_W.WORK_EFFORT_ID = ? )
  AND (? IS NULL OR ? = '' OR MODEL.WORK_EFFORT_ID = ?)  -- valutIndType
  AND (? IS NULL OR ? = '' OR FIL_W.ORG_UNIT_ID = ? ) -- orgUnitId
  AND (? IS NULL OR ? = '' OR REFER.PARTY_ID = ? OR VALCOD.PARTY_ID = ?) -- partyId
  AND ( ? <= FIL_W.ESTIMATED_COMPLETION_DATE AND ? >= FIL_W.ESTIMATED_START_DATE )
  @workEffortRevisionId
  @currentStatusName
  
  @filterWhere

GROUP BY FIL_W.WORK_EFFORT_ID,
   PDO.CUSTOM_TIME_PERIOD_CODE,
   SOC.PARTY_NAME,
   AREAROLE.DESCRIPTION,
   AREA.PARTY_NAME,
   DIRIGSUP.PARTY_NAME,
   UDIRROLE.DESCRIPTION,
   UDIR.PARTY_ID,
   UDIR.PARTY_NAME ,
