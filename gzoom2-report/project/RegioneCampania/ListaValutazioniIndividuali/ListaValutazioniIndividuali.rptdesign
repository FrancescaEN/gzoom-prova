            <method name="beforeOpen"><![CDATA[

workEffortRevisionId = " AND FIL_W.WORK_EFFORT_REVISION_ID IS NULL ";
if (params["workEffortRevisionId"].value != null &amp;&amp; params["workEffortRevisionId"].value != '') {
    workEffortRevisionId = " AND FIL_W.WORK_EFFORT_REVISION_ID = '" + params["workEffortRevisionId"].value + "'";
}
this.queryText = this.queryText.replace("@workEffortRevisionId",  workEffortRevisionId );

currentStatusName = "";
if (params["currentStatusName"].value != null &amp;&amp; params["currentStatusName"].value != '') {
    currentStatusName = " AND STATUS.DESCRIPTION = '" + params["currentStatusName"].value + "'";
}
this.queryText = this.queryText.replace("@currentStatusName",  currentStatusName );




//GESTIRE PERMESSI
/**/
filter = new com.mapsengineering.base.birt.util.UtilFilter(params["userLoginId"].value, params["localDispatcherName"].value); 
var filterInnerJoin = filter.getWorkEffortFilterInner();
var filterLeftJoin = filter.getWorkEffortFilterLeftJoin();
var filterWhere = filter.getWorkEffortFilterWhere();
 
/*
var filterInnerJoin = "";
var filterLeftJoin = "";
var filterWhere = ""; 
*/

this.queryText = this.queryText.replace("@filterInnerJoin",  filterInnerJoin );
this.queryText = this.queryText.replace("@filterLeftJoin",  filterLeftJoin );
this.queryText = this.queryText.replace("@filterWhere",  filterWhere );
]]></method>
