                    <property name="nativeName">Assessorati coinvolti</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">12</property>
                    <property name="name">Struttura di vertice responsabile</property>
                    <property name="nativeName">Struttura di vertice responsabile</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">13</property>
                    <property name="name">Altri eventuali soggetti coinvolti</property>
                    <property name="nativeName">Altri eventuali soggetti coinvolti</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">14</property>
                    <property name="name">Linea d'azione</property>
                    <property name="nativeName">Linea d'azione</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">15</property>
                    <property name="name">Obiettivo (goal) dell’Agenda 2030 cui la linea d’azione con</property>
                    <property name="nativeName">Obiettivo (goal) dell’Agenda 2030 cui la linea d’azione con</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">16</property>
                    <property name="name">Dominio del Benessere Equo e Sostenibile (BES) cui la linea d</property>
                    <property name="nativeName">Dominio del Benessere Equo e Sostenibile (BES) cui la linea d</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">17</property>
                    <property name="name">Indicatore di benessere equo e sostenibile del Documento di Eco</property>
                    <property name="nativeName">Indicatore di benessere equo e sostenibile del Documento di Eco</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">18</property>
                    <property name="name">Principi fondamentali del pilastro europeo dei diritti sociali</property>
                    <property name="nativeName">Principi fondamentali del pilastro europeo dei diritti sociali</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">19</property>
                    <property name="name">Eventuale altro Obiettivo agenda 2030</property>
                    <property name="nativeName">Eventuale altro Obiettivo agenda 2030</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">20</property>
                    <property name="name">Eventuale altro Dominio BES</property>
                    <property name="nativeName">Eventuale altro Dominio BES</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">21</property>
                    <property name="name">Eventuale altro Indicatore di benessere</property>
                    <property name="nativeName">Eventuale altro Indicatore di benessere</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">22</property>
                    <property name="name">Eventuale altro principio fondamentale pilastro europeo</property>
                    <property name="nativeName">Eventuale altro principio fondamentale pilastro europeo</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">23</property>
                    <property name="name">INDICATORE Strategia Nazionale per lo Sviluppo Sostenibile</property>
                    <property name="nativeName">INDICATORE Strategia Nazionale per lo Sviluppo Sostenibile</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">24</property>
                    <property name="name">Target</property>
                    <property name="nativeName">Target</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">25</property>
                    <property name="name">Fonte</property>
                    <property name="nativeName">Fonte</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">26</property>
                    <property name="name">Riferimento Programmazione regionale</property>
                    <property name="nativeName">Riferimento Programmazione regionale</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">27</property>
                    <property name="name">Eventuale altro riferimento Programmazione regionale</property>
                    <property name="nativeName">Eventuale altro riferimento Programmazione regionale</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">28</property>
                    <property name="name">Fonti finanziarie per la realizzazione del programma</property>
                    <property name="nativeName">Fonti finanziarie per la realizzazione del programma</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">29</property>
                    <property name="name">Indirizzi Risoluzione Consiglio Regionale</property>
                    <property name="nativeName">Indirizzi Risoluzione Consiglio Regionale</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">30</property>
                    <property name="name">Modalità di implementazione linea d'azione</property>
                    <property name="nativeName">Modalità di implementazione linea d'azione</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">31</property>
                    <property name="name">Strumenti e modalità di attuazione</property>
                    <property name="nativeName">Strumenti e modalità di attuazione</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">32</property>
                    <property name="name">Risultati attesi</property>
                    <property name="nativeName">Risultati attesi</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">33</property>
                    <property name="name">Beneficiario</property>
                    <property name="nativeName">Beneficiario</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">34</property>
                    <property name="name">Eventuale altro beneficiaro</property>
                    <property name="nativeName">Eventuale altro beneficiaro</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">35</property>
                    <property name="name">Banche dati e link di interesse</property>
                    <property name="nativeName">Banche dati e link di interesse</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">36</property>
                    <property name="name">Risultati già raggiunti</property>
                    <property name="nativeName">Risultati già raggiunti</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select
	wet.description as "Tipologia",
	si.description as "Stato scheda",
	we.etch as "Linea d'azione n.",
	preg.work_effort_name as "Politica Regionale",
	concat(substring(mpro.etch, 1, 2), ' - ', mpro.work_effort_name) as "Missione",
	concat(substring(mpro2.source_reference_id, strpos(mpro2.source_reference_id, '.')+1,300),' - ',substring(mpro2.work_effort_name, strpos(mpro2.work_effort_name, ' - ')+3,100)) as "Programma (Obbligatorio)",
	progev.prgname as "Altri Programmi eventuali",
	instr.work_effort_name as "Indirizzo strategico - Ambito di valore pubblico",
	instr2.instrname as "Eventuali Indirizzi Strategici",
	p.party_name as "Assessorato di riferimento",
	assconv.str as "Assessorati coinvolti",
	concat(cod.parent_role_code, ' - ', p3.party_name) as "Struttura di vertice responsabile",
	sogg.note_info as "Altri eventuali soggetti coinvolti",
	we.work_effort_name as "Linea d'azione",
	obbl.indic1 as "Obiettivo (goal) dell’Agenda 2030 cui la linea d’azione concorre prevalentemente a realizzare",
	obbl.indic2 as "Dominio del Benessere Equo e Sostenibile (BES) cui la linea d’azione concorre prevalentemente a migliorare",
	obbl.indic3 as "Indicatore di benessere equo e sostenibile del Documento di Economia e Finanza nazionale cui la linea d’azione concorre prevalentemente a migliorare",
	obbl.indic4 as "Principi fondamentali del pilastro europeo dei diritti sociali",
	indic5.lista as "Eventuale altro Obiettivo agenda 2030",
	indic6.lista as "Eventuale altro Dominio BES",
	indic7.lista as "Eventuale altro Indicatore di benessere",
	indic8.lista as "Eventuale altro principio fondamentale pilastro europeo",
	indic9.lista as "INDICATORE Strategia Nazionale per lo Sviluppo Sostenibile",
	indic10.lista as "Target",
	indic11.lista as "Fonte",
	proreg.work_effort_name as "Riferimento Programmazione regionale",
	rifpro2.rif2name as "Eventuale altro riferimento Programmazione regionale",
	fonfin.fonfindescr as "Fonti finanziarie per la realizzazione del programma",
	ircreg.ircrname as "Indirizzi Risoluzione Consiglio Regionale",
	modimpl.note_info as "Modalità di implementazione linea d'azione",
	strimpl.note_info as "Strumenti e modalità di attuazione",
	risatt.note_info as "Risultati attesi",
	benef.work_effort_name as "Beneficiario",
	benef2.benefname as "Eventuale altro beneficiaro",
	link.note_info as "Banche dati e link di interesse",
	risragg.note_info as "Risultati già raggiunti"
from work_effort we
/* TIPOLOGIA SCHEDA */
join work_effort_type wet on wet.work_effort_type_id = we.work_effort_type_id
/* STATO DELLA SCHEDA */
join status_item si on si.status_id = we.current_status_id
/* POLITICA REGIONALE */
left join work_effort_assoc assoc on assoc.work_effort_id_to = we.work_effort_id and assoc.work_effort_assoc_type_id = '19DEFDEFC'
left join work_effort preg on preg.work_effort_id = assoc.work_effort_id_from
/* MISSIONE */
left join work_effort_assoc_view assoc2 on assoc2.we_to_id = we.work_effort_id and assoc2.we_ass_type_id = '18BILPROC' and assoc2.we_from_type_id not in ('18BIL2PRO')
left join work_effort mpro on mpro.work_effort_id = assoc2.we_from_id --and mpro.work_effort_type_id not in ('18BIL2PRO')
/* PROGRAMMA OBBLIGATORIO */
left join work_effort_assoc_view assoc3 on assoc3.we_to_id = we.work_effort_id and assoc3.we_ass_type_id = '18BILPROC' and assoc3.we_from_type_id ='18BIL2PRO'
left join work_effort mpro2 on mpro2.work_effort_id = assoc3.we_from_id --and mpro2.work_effort_type_id='18BIL2PRO'
/* PROGRAMMI EVENTUALI */
LEFT join(
select
string_agg(concat(substring(mpro3.source_reference_id, strpos(mpro3.source_reference_id, '.')+1,300),' - ',substring(mpro3.work_effort_name, strpos(mpro3.work_effort_name, ' - ')+3,100)),';
'
ORDER BY CAST(split_part(mpro3.source_reference_id, '.', 2) AS INTEGER))
AS prgname, assoc4.we_to_id
FROM work_effort_assoc_view assoc4
JOIN work_effort mpro3 ON mpro3.work_effort_id= assoc4.we_from_id and assoc4.we_ass_type_id = '18BILPROC2' and assoc4.we_from_type_id ='18BIL2PRO'
GROUP BY assoc4.we_to_id
) progev ON progev.we_to_id=we.work_effort_id
/* INDIRIZZO STRATEGICO PRINCIPALE */
left join work_effort_assoc assoc5 on assoc5.work_effort_id_to = we.work_effort_id and assoc5.work_effort_assoc_type_id = 'COLINDSTRAT'
left join work_effort instr on instr.work_effort_id = assoc5.work_effort_id_from
/* EVENTUALE ALTRO INDIRIZZO STRATEGICO */
left join(
	select string_agg(instr.work_effort_name, ';
') as instrname, weaind.work_effort_id_to  
	from work_effort_assoc weaind 
	join work_effort instr on instr.work_effort_id = weaind.work_effort_id_from 
	where weaind.work_effort_assoc_type_id = 'COLINDSTRAT2' 
	group by weaind.work_effort_id_to
) instr2 on instr2.work_effort_id_to = we.work_effort_id 
/* ASSESSORATO DI RIFERIMENTO */
left join work_effort_party_assignment wepa on wepa.work_effort_id = we.work_effort_id and wepa.role_type_id = 'WEM_PART_IN_CHARGE'
left join party p on p.party_id = wepa.party_id 
/* EVENTUALI ALTRI ASSESSORATI COINVOLTI */
left join(
	select string_agg(p2.party_name, '; 
') as str, wepa3.work_effort_id 
	from work_effort_party_assignment wepa3
	join party p2 on p2.party_id = wepa3.party_id 
	where wepa3.role_type_id = 'WEM_PART_MANAGER' 
	group by wepa3.work_effort_id 
) assconv on assconv.work_effort_id = we.work_effort_id
/* STRUTTURA DI VERTICE RESPONSABILE */
left join party p3 on p3.party_id = we.org_unit_id
left join party_parent_role cod on cod.party_id = p3.party_id
/* ALTRI EVENTUALI SOGGETTI COINVOLTI */
left join (
	select
		note.work_effort_id,
		nd.note_info 
	from work_effort_note note
	join note_data nd on nd.note_id = note.note_id and note.sequence_id = '109'
) sogg on sogg.work_effort_id = we.work_effort_id 
/* INDICATORI */
left join (
	select 
		wem.work_effort_id,
		MAX(
			case 
			when wem.gl_account_id = '10171' then gamrs.uom_descr
			else null
			end
		) as indic1,
			MAX(
			case 
			when wem.gl_account_id = '10180' then gamrs.uom_descr
			else null
			end
		) as indic2,
			MAX(
			case 
			when wem.gl_account_id = '10181' then gamrs.uom_descr
			else null
			end
		) as indic3 ,
			MAX(
			case 
			when wem.gl_account_id = '10120' then gamrs.uom_descr
			else null
			end
		) as indic4 
	from work_effort_measure wem
	join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id 
	join gl_account_meas_rat_sc gamrs on gamrs.gl_account_id = wem.gl_account_id and gamrs.uom_rating_value = ate.amount
	group by wem.work_effort_id 
) obbl on obbl.work_effort_id = we.work_effort_id
/* EVENTUALI ALTRI INDICATORI 5 */
left join(
	select wem.work_effort_id, string_agg(gamrs.uom_descr, '; 
') as lista
	from work_effort_measure wem
	join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id 
	join gl_account_meas_rat_sc gamrs on gamrs.gl_account_id = wem.gl_account_id and gamrs.uom_rating_value = ate.amount
	where wem.gl_account_id = '10235'
	group by wem.work_effort_id 
) indic5 on indic5.work_effort_id = we.work_effort_id
/* EVENTUALI ALTRI INDICATORI 6 */
left join(
	select wem.work_effort_id, string_agg(gamrs.uom_descr, '; 
') as lista
	from work_effort_measure wem
	join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id 
	join gl_account_meas_rat_sc gamrs on gamrs.gl_account_id = wem.gl_account_id and gamrs.uom_rating_value = ate.amount
	where wem.gl_account_id = '10236'
	group by wem.work_effort_id 
) indic6 on indic6.work_effort_id = we.work_effort_id --'10236' 10237 10238
/* EVENTUALI ALTRI INDICATORI 7 */
left join(
	select wem.work_effort_id, string_agg(gamrs.uom_descr, '; 
') as lista
	from work_effort_measure wem
	join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id 
	join gl_account_meas_rat_sc gamrs on gamrs.gl_account_id = wem.gl_account_id and gamrs.uom_rating_value = ate.amount
	where wem.gl_account_id = '10237'
	group by wem.work_effort_id 
) indic7 on indic7.work_effort_id = we.work_effort_id 
/* EVENTUALI ALTRI INDICATORI 8 */
left join(
	select wem.work_effort_id, string_agg(gamrs.uom_descr, '; 
') as lista
	from work_effort_measure wem
	join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id 
	join gl_account_meas_rat_sc gamrs on gamrs.gl_account_id = wem.gl_account_id and gamrs.uom_rating_value = ate.amount
	where wem.gl_account_id = '10238'
	group by wem.work_effort_id 
) indic8 on indic8.work_effort_id = we.work_effort_id
/* INDICATORI 9 RISULTATI ATTESI */
left join(
	select 
wem.work_effort_id, string_agg(ga.account_name, '; ') as lista
	from work_effort_measure wem
	join work_effort_purpose_account wepa2 on wepa2.gl_account_id=wem.gl_account_id
	inner join gl_account ga on ga.gl_account_id=wem.gl_account_id
	where wepa2.work_effort_purpose_type_id='DEFRPNRR'
	group by wem.work_effort_id
) indic9 on indic9.work_effort_id = we.work_effort_id 
/* INDICATORI 9 RISULTATI ATTESI: TARGET */
left join(
	select 
wem.work_effort_id, string_agg(ga.description, '; ') as lista
	from work_effort_measure wem
	join work_effort_purpose_account wepa2 on wepa2.gl_account_id=wem.gl_account_id
	inner join gl_account ga on ga.gl_account_id=wem.gl_account_id
	where wepa2.work_effort_purpose_type_id='DEFRPNRR'
	group by wem.work_effort_id
) indic10 on indic10.work_effort_id = we.work_effort_id
/* INDICATORI 9 RISULTATI ATTESI: FONTE */
left join(
	select 
wem.work_effort_id, string_agg(ga.source, '; ') as lista
	from work_effort_measure wem
	join work_effort_purpose_account wepa2 on wepa2.gl_account_id=wem.gl_account_id
	inner join gl_account ga on ga.gl_account_id=wem.gl_account_id
	where wepa2.work_effort_purpose_type_id='DEFRPNRR'
	group by wem.work_effort_id
) indic11 on indic11.work_effort_id = we.work_effort_id 
/* RIFERIMENTO PROGRAMMAZIONE REGIONALE */
left join work_effort_assoc assoc7 on assoc7.work_effort_id_to = we.work_effort_id and assoc7.work_effort_assoc_type_id = 'COLRIFPREG'
left join work_effort proreg on proreg.work_effort_id = assoc7.work_effort_id_from
/* EVENTUALE ALTRO RIFERIMENTO PROGRAMMAZIONE REGIONALE */
left join(
	select string_agg(rif2.work_effort_name, ';
') as rif2name, assocrif.work_effort_id_to  
	from work_effort_assoc assocrif 
	join work_effort rif2 on rif2.work_effort_id = assocrif.work_effort_id_from 
	where assocrif.work_effort_assoc_type_id = 'COLRIFPREG2' 
	group by assocrif.work_effort_id_to
) rifpro2 on rifpro2.work_effort_id_to = we.work_effort_id 
/* FONTI DI FINANZIAMENTO */
left join(
	select 
		wem.work_effort_id,
		string_agg(gamrs.uom_descr, '; 
') as fonfindescr
	from work_effort_measure wem
	join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id
	join gl_account_meas_rat_sc gamrs on gamrs.gl_account_id = wem.gl_account_id and gamrs.uom_rating_value = ate.amount 
	where wem.gl_account_id = '10239'
	group by wem.work_effort_id
) fonfin on fonfin.work_effort_id = we.work_effort_id
/* INDIRIZZI RISOLUZIONE CONSIGLIO REGIONALE */
LEFT JOIN (
    SELECT
        assoc8.we_to_id,
        string_agg(ircr.work_effort_name, E'\n') AS ircrname
    FROM work_effort_assoc_view assoc8
    JOIN work_effort ircr 
        ON ircr.work_effort_id = assoc8.we_from_id 
       AND assoc8.we_ass_type_id = '24COLLINDRIS' 
       AND assoc8.we_from_type_id = '24INDRIS1'
    GROUP BY assoc8.we_to_id
) ircreg ON ircreg.we_to_id = we.work_effort_id
/* MODALITA' DI IMPLEMENTAZIONE LINEA D'AZIONE */
left join (
	select
		note.work_effort_id,
		nd.note_info 
	from work_effort_note note
	join note_data nd on nd.note_id = note.note_id and note.sequence_id = '111'
) modimpl on modimpl.work_effort_id = we.work_effort_id
/* STRUMENTI E MODALITA' D'ATTUAZIONE */
left join (
	select
		note.work_effort_id,
		nd.note_info 
	from work_effort_note note
	join note_data nd on nd.note_id = note.note_id and note.sequence_id = '112'
) strimpl on strimpl.work_effort_id = we.work_effort_id
/* RISULTATI ATTESI */
left join (
	select
		note.work_effort_id,
		nd.note_info 
	from work_effort_note note
	join note_data nd on nd.note_id = note.note_id and note.sequence_id = '123'
) risatt on risatt.work_effort_id = we.work_effort_id
/* BENEFICIARIO */
left join work_effort_assoc assoc6 on assoc6.work_effort_id_to = we.work_effort_id and assoc6.work_effort_assoc_type_id = '19DEFSTKC'
left join work_effort benef on benef.work_effort_id = assoc6.work_effort_id_from
/* ULTERIORE BENEFICIARIO */
left join(
	select string_agg(we.work_effort_name, '; 
') as benefname, assoc.work_effort_id_to  
	from work_effort_assoc assoc
	join work_effort we on we.work_effort_id = assoc.work_effort_id_from 
	where assoc.work_effort_assoc_type_id = '19DEFSTKC2'
	group by assoc.work_effort_id_to
) benef2 on benef2.work_effort_id_to = we.work_effort_id
/* BANCHE DATI O LINK DI INTERESSE */
left join (
	select
		note.work_effort_id,
		nd.note_info 
	from work_effort_note note
	join note_data nd on nd.note_id = note.note_id and note.sequence_id = '116'
) link on link.work_effort_id = we.work_effort_id
/* RISULTATI RAGGIUNTI */
left join (
	select
		note.work_effort_id,
		nd.note_info 
	from work_effort_note note
	join note_data nd on nd.note_id = note.note_id and note.sequence_id = '117'
) risragg on risragg.work_effort_id = we.work_effort_id
where we.work_effort_type_id = '19DEF3SCH' and we.estimated_start_date <= @date3112 and we.estimated_completion_date>=@date0101
@workEffortId

group by
we.etch,
preg.work_effort_name,
mpro.etch,
mpro.work_effort_name,
mpro2.work_effort_name,
we.work_effort_name,
instr.work_effort_name,
instr2.instrname,
p.party_name,
assconv.str,
cod.parent_role_code,
p3.party_name,
sogg.note_info,
obbl.indic1,
obbl.indic2,
obbl.indic3,
obbl.indic4,
indic5.lista,
indic6.lista,
indic7.lista,
