	<queryString>
		<![CDATA[select 
 nd.note_id, 
 nd.note_name,
 nd.note_info,
 n.sequence_id,
 nd.note_date_time,
 n.is_html
from    work_effort_note n
inner join note_data nd on nd.note_id = n.note_id
where n.work_effort_id = $P{workEffortId} 
	and (n.is_main = 'N' or n.is_main is null)
	and ( 'N' = 'Y' or n.sequence_id >= 100) -- per prendere la nota della radice
	
	--@selectNote
	--@typeNotes
	
order by 
	n.sequence_id, 
	n.note_id]]>
	</queryString>
