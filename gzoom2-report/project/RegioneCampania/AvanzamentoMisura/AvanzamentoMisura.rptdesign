            <method name="beforeOpen"><![CDATA[/**/
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value );


/*
this.queryText = this.queryText.replace("@date3112", "'2021-12-31 00:00:00.000'");
this.queryText = this.queryText.replace("@date0101", "'2021-01-01 00:00:00.000'");
*/

//GESTIRE PERMESSI
/**/
filter = new com.mapsengineering.base.birt.util.UtilFilter(params["userLoginId"].value, params["localDispatcherName"].value);
var filterInnerJoin = filter.getWorkEffortFilterInner();
var filterLeftJoin = filter.getWorkEffortFilterLeftJoin();
var filterWhere = filter.getWorkEffortFilterWhere();


var orgUnitIdString = "";
if (params["orgUnitId"].value != null &amp;&amp; params["orgUnitId"].value != '') {
	orgUnitIdString = " AND ('" + params["orgUnitId"].value + "' IS NULL OR '" + params["orgUnitId"].value + "' = '' OR '" + params["orgUnitId"].value + "' = FIL_W.ORG_UNIT_ID) ";
}

/* 
var filterInnerJoin = "";
var filterLeftJoin = "";
var filterWhere = "";
var orgUnitIdString = "";
*/

this.queryText = this.queryText.replace("@filterInnerJoin",  filterInnerJoin );
this.queryText = this.queryText.replace("@filterLeftJoin",  filterLeftJoin );
this.queryText = this.queryText.replace("@filterWhere",  filterWhere );
this.queryText = this.queryText.replace("@orgUnitId", orgUnitIdString);]]></method>
