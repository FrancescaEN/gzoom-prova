                </structure>
                <structure>
                    <property name="position">12</property>
                    <property name="name">UNITÀ DI MISURA</property>
                    <property name="nativeName">UNITÀ DI MISURA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">13</property>
                    <property name="name">TARGET</property>
                    <property name="nativeName">TARGET</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">14</property>
                    <property name="name">ATTUAZIONE MISURA</property>
                    <property name="nativeName">ATTUAZIONE MISURA</property>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="position">15</property>
                    <property name="name">FINALITA</property>
                    <property name="nativeName">FINALITA</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT
	CONCAT(AR.ETCH, ' - ', AR.WORK_EFFORT_NAME) AS "AREA",
	-- SE C'È LA DESCRIPTION STAMPO QUELLA, ALTRIMENTI IL WORK_EFFORT_NAME
	CASE WHEN PR.DESCRIPTION IS NOT NULL THEN CONCAT(PR.ETCH, ' - ', PR.DESCRIPTION)
	ELSE CONCAT(PR.ETCH, ' - ', PR.WORK_EFFORT_NAME) END AS "PROCESSO",
	-- SE C'È LA DESCRIPTION STAMPO QUELLA, ALTRIMENTI IL PARTY_NAME
	CASE WHEN P.DESCRIPTION IS NOT NULL THEN CONCAT(PPR.PARENT_ROLE_CODE, ' - ', P.DESCRIPTION)
	ELSE CONCAT (PPR.PARENT_ROLE_CODE, ' - ', P.PARTY_NAME) END AS "STRUTTURA",
	FIL_W.WORK_EFFORT_ID AS "ID_FASE",
	FIL_W.ETCH AS "ETCH_FASE",
	CONCAT(FIL_W.ETCH, ' - ', FIL_W.WORK_EFFORT_NAME) AS "FASE",
	MIS.WORK_EFFORT_NAME AS "MISURA",
	MAX(CASE WHEN NOTE_MIS.SEQUENCE_ID = '70' THEN NOTE_MIS.NOTE_INFO ELSE NULL END) AS "MODALITÀ ATTUATIVE",
	MAX(CASE WHEN NOTE_MIS.SEQUENCE_ID = '80' THEN NOTE_MIS.NOTE_INFO ELSE NULL END) AS "TEMPISTICHE",
	MAX(CASE WHEN NOTE_MIS.SEQUENCE_ID = '90' THEN NOTE_MIS.NOTE_INFO ELSE NULL END) AS "RESPONSABILE DELLA MISURA",
	INDIC_MIS.DESCRIZIONE AS "DESCRIZIONE INDICATORE",
	INDIC_MIS.ABBREVIATION AS "UNITÀ DI MISURA",
	-- SE RATING_SCALE STAMPO LA STRINGA
	MAX(CASE WHEN INDIC_MIS.GL_FISCAL_TYPE_ID = 'BUDGET' THEN CASE WHEN INDIC_MIS.UOM_TYPE_ID = 'RATING_SCALE' THEN INDIC_MIS.UOM_DESCR
	ELSE TO_CHAR(INDIC_MIS.AMOUNT,'FM999999999.00') END END) AS "TARGET",
	-- CAMPO DI SOTTO DISMESSO POST 2022
	MAX(CASE WHEN ATT_MIS.GL_ACCOUNT_ID = 'CORMIS.SAL' THEN ATT_MIS.AMOUNT ELSE NULL END) AS "ATTUAZIONE MISURA",
	WEP.DESCRIPTION AS "FINALITA"
-- AREA
FROM WORK_EFFORT AR
-- PROCESSO
JOIN WORK_EFFORT_ASSOC WEA0 ON WEA0.WORK_EFFORT_ID_FROM = AR.WORK_EFFORT_ID AND WEA0.WORK_EFFORT_ASSOC_TYPE_ID = '15APPPC'
JOIN WORK_EFFORT PR ON PR.WORK_EFFORT_ID = WEA0.WORK_EFFORT_ID_TO AND PR.WORK_EFFORT_TYPE_ID = '15AP2SAR' AND PR.WORK_EFFORT_REVISION_ID IS NULL
	AND PR.ESTIMATED_START_DATE <= @date3112 AND (PR.ESTIMATED_COMPLETION_DATE >= @date0101 OR PR.ESTIMATED_COMPLETION_DATE IS NULL)
--FASE
JOIN WORK_EFFORT_ASSOC WEA ON WEA.WORK_EFFORT_ID_FROM = PR.WORK_EFFORT_ID AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '15APSARR'
JOIN WORK_EFFORT FIL_W ON FIL_W.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_TO AND FIL_W.WORK_EFFORT_TYPE_ID IN ('15AP3PRO', '15AP3F2L', '15AP3FFITSPL', '15AP3FFITSSL','15AP3F4C', '15AP3FFITSTC')
  AND FIL_W.WORK_EFFORT_REVISION_ID IS NULL
	AND FIL_W.ESTIMATED_START_DATE <=  @date3112 AND (FIL_W.ESTIMATED_COMPLETION_DATE >= @date0101 OR FIL_W.ESTIMATED_COMPLETION_DATE IS NULL)
-- STRUTTURA
JOIN PARTY P ON P.PARTY_ID = FIL_W.ORG_UNIT_ID
JOIN PARTY_PARENT_ROLE PPR ON PPR.PARTY_ID = P.PARTY_ID
 
@filterInnerJoin
@filterLeftJoin
 
-- MISURA
INNER JOIN WORK_EFFORT_ASSOC WEA2 ON WEA2.WORK_EFFORT_ID_FROM = FIL_W.WORK_EFFORT_ID AND WEA2.WORK_EFFORT_ASSOC_TYPE_ID = '15APPRO'
INNER JOIN WORK_EFFORT MIS ON MIS.WORK_EFFORT_ID = WEA2.WORK_EFFORT_ID_TO AND MIS.WORK_EFFORT_TYPE_ID IN ('15AP5M1', '15AP5M2') AND MIS.WORK_EFFORT_REVISION_ID IS NULL
	AND MIS.ESTIMATED_START_DATE <=  @date3112 AND (MIS.ESTIMATED_COMPLETION_DATE >= @date0101 OR MIS.ESTIMATED_COMPLETION_DATE IS NULL)
-- NOTE DELLA MISURA
 
-- FINALITA' MISURA
LEFT JOIN WORK_EFFORT_PURPOSE_TYPE WEP ON WEP.WORK_EFFORT_PURPOSE_TYPE_ID = MIS.WORK_EFFORT_PURPOSE_TYPE_ID
 
LEFT JOIN (
	SELECT ND.NOTE_NAME, ND.NOTE_INFO, WEN.WORK_EFFORT_ID, WEN.SEQUENCE_ID
	FROM WORK_EFFORT_NOTE WEN
	JOIN NOTE_DATA ND ON ND.NOTE_ID = WEN.NOTE_ID
) NOTE_MIS ON NOTE_MIS.WORK_EFFORT_ID = MIS.WORK_EFFORT_ID
-- INDICATORI DELLA MISURA
LEFT JOIN (
	SELECT WEM.WORK_EFFORT_ID, WEM.UOM_DESCR AS DESCRIZIONE, ATE.AMOUNT, WEMRS.UOM_DESCR, ATE.GL_FISCAL_TYPE_ID, U.UOM_TYPE_ID, U.ABBREVIATION
	FROM WORK_EFFORT_MEASURE WEM
	JOIN ACCTG_TRANS AT ON AT.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID AND AT.TRANSACTION_DATE =  @date3112
	JOIN ACCTG_TRANS_ENTRY ATE ON ATE.ACCTG_TRANS_ID = AT.ACCTG_TRANS_ID AND ATE.GL_ACCOUNT_TYPE_ID = 'CORMIS'
	JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = ATE.GL_ACCOUNT_ID
	LEFT JOIN WORK_EFFORT_MEAS_RAT_SC WEMRS ON WEMRS.WORK_EFFORT_MEASURE_ID = ATE.VOUCHER_REF
		AND ATE.AMOUNT <= WEMRS.UOM_RATING_VALUE AND ATE.AMOUNT >= WEMRS.UOM_RATING_VALUE
	JOIN UOM U ON U.UOM_ID = GL.DEFAULT_UOM_ID
) INDIC_MIS ON INDIC_MIS.WORK_EFFORT_ID = MIS.WORK_EFFORT_ID
-- AVANZAMENTO MISURA
LEFT JOIN (
	SELECT WEM.WORK_EFFORT_ID, WEMRS.UOM_DESCR, WEM.GL_ACCOUNT_ID, ATE.AMOUNT  
	FROM WORK_EFFORT_MEASURE WEM
	JOIN ACCTG_TRANS AT ON AT.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID AND AT.TRANSACTION_DATE =  @date3112
	JOIN ACCTG_TRANS_ENTRY ATE ON ATE.ACCTG_TRANS_ID = AT.ACCTG_TRANS_ID AND ATE.GL_ACCOUNT_TYPE_ID = 'CORSAL'
	LEFT JOIN WORK_EFFORT_MEAS_RAT_SC WEMRS ON WEMRS.WORK_EFFORT_MEASURE_ID = ATE.VOUCHER_REF
		AND ATE.AMOUNT <= WEMRS.UOM_RATING_VALUE AND ATE.AMOUNT >= WEMRS.UOM_RATING_VALUE
) ATT_MIS ON ATT_MIS.WORK_EFFORT_ID = MIS.WORK_EFFORT_ID
WHERE PR.WORK_EFFORT_TYPE_ID = '15AP2SAR' AND PR.WORK_EFFORT_REVISION_ID IS NULL
	AND PR.ESTIMATED_START_DATE <=  @date3112 AND (PR.ESTIMATED_COMPLETION_DATE >= @date0101 OR PR.ESTIMATED_COMPLETION_DATE IS NULL)
 
@orgUnitId
@filterWhere
 
GROUP BY
	CONCAT(AR.ETCH, ' - ', AR.WORK_EFFORT_NAME),
	CASE WHEN PR.DESCRIPTION IS NOT NULL THEN CONCAT(PR.ETCH, ' - ', PR.DESCRIPTION)
	ELSE CONCAT(PR.ETCH, ' - ', PR.WORK_EFFORT_NAME) END,
	CASE WHEN P.DESCRIPTION IS NOT NULL THEN CONCAT(PPR.PARENT_ROLE_CODE, ' - ', P.DESCRIPTION)
	ELSE CONCAT (PPR.PARENT_ROLE_CODE, ' - ', P.PARTY_NAME) END,
	FIL_W.WORK_EFFORT_ID,
	FIL_W.ETCH,
	CONCAT(FIL_W.ETCH, ' - ', FIL_W.WORK_EFFORT_NAME),
	MIS.WORK_EFFORT_NAME,
	INDIC_MIS.DESCRIZIONE,
	INDIC_MIS.ABBREVIATION,
	WEP.DESCRIPTION
 
]]></xml-property>
