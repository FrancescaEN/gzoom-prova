	<parameter name="Parameter1" class="java.lang.String"/>
	<parameter name="id4string" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
	z.work_effort_id_from as work_effort_id_from3,
	b.etch as etichetta3,
	a.etch as etch3,
	a.work_effort_name as name3,
	z.sequence_num as seq3,
	a.work_effort_id as id3,
	a.description as description3,
	z.assoc_weight as assoc_weight3,
	a.source_reference_id as code3,
		   a.estimated_start_date as estimated_start_date3,
	a.estimated_completion_date as estimated_completion_date3,
		   nd.note_name as note_name_spl3,
	nd.note_info as note_info_spl3,
	nd1.note_name as note_name_defr3,
	nd1.note_info as note_info_defr3,
		   b1.etch as etichetta_prg3,
	a1.etch as etch_prg3,
	a1.work_effort_name as name_prg3, 
		   b2.etch as etichetta_miss3,
	a2.etch as etch_miss3,
	a2.work_effort_name as name_miss3,
		   b3.etch as etichetta_tri3,
	a3.etch as etch_tri3,
	a3.work_effort_name as name_tri3,
	a3.source_reference_id as code_tri3,
		   i.amount3,
	b.code_prefix as pref3,
	b.work_effort_type_id as type_id3,
	linea.work_effort_id_to,
	linea.work_effort_name,
	linea.source_reference_id,
	linea.etch,
		   a.work_effort_purpose_type_id,
	wept.description as valorePublico,
	valpub.work_effort_name as ambitoValorePubblico,
	(select COUNT(*) from work_effort we
	join work_effort_assoc wea on wea.work_effort_id_from = we.work_effort_id 
	where we.work_effort_id = $P{workEffortId1} 
	and wea.work_effort_assoc_type_id like '26ORGST%'
	group by WE.work_effort_id ) as conta
from
	work_effort_assoc z
inner join work_effort a on
	a.work_effort_id = z.work_effort_id_to
inner join work_effort_assoc_type d on
	d.work_effort_assoc_type_id = z.work_effort_assoc_type_id
inner join work_effort_type b on
	b.work_effort_type_id = a.work_effort_type_id
inner join status_item st on
	st.status_id = a.current_status_id
left join (
	select
			wea.work_effort_id_to,
			lin.work_effort_name,
			lin.source_reference_id,
		lin.etch
	from
		work_effort_assoc wea
	join work_effort lin on
		lin.work_effort_id = wea.work_effort_id_from
	where
		wea.work_effort_assoc_type_id = '19DEFSCHC') linea on
	linea.work_effort_id_to = a.work_effort_id
	-- programma
left outer join work_effort_assoc z1 on
	z1.work_effort_id_to = a.work_effort_id
	and z1.work_effort_assoc_type_id = '18BILPROC'
	and (  $P{excludeValidity}  = 'Y'
		or ($P{excludeValidity} = 'N'
			and ( z1.from_date <= TO_DATE( $P{customTimePeriod},
			'YYYY/MM/DD')
				and (z1.thru_date >= TO_DATE($P{customTimePeriod},
				'YYYY/MM/DD')
					or z1.thru_date is null ))))
left outer join work_effort a1 on
	a1.work_effort_id = z1.work_effort_id_from
	and a1.current_status_id not in (
	select
		status_id
	from
		status_item
	where
		act_st_enum_id = 'ACTSTATUS_REPLACED')
left outer join work_effort_type b1 on
	b1.work_effort_type_id = a1.work_effort_type_id
	-- missione
left outer join work_effort_assoc z2 on
	z2.work_effort_id_to = a1.work_effort_id
	and z2.work_effort_assoc_type_id = '18BILBIL'
	and ( $P{excludeValidity} = 'Y'
		or ($P{excludeValidity} = 'N'
			and ( z2.from_date <= TO_DATE($P{customTimePeriod},
			'YYYY/MM/DD')
				and (z2.thru_date >= TO_DATE($P{customTimePeriod},
				'YYYY/MM/DD')
					or z2.thru_date is null ))))
left outer join work_effort a2 on
	a2.work_effort_id = z2.work_effort_id_from
	and a2.current_status_id not in (
	select
		status_id
	from
		status_item
	where
		act_st_enum_id = 'ACTSTATUS_REPLACED')
left outer join work_effort_type b2 on
	b2.work_effort_type_id = a2.work_effort_type_id
	-- obiettivo strategico triennale
left outer join work_effort_assoc z3 on
	z3.work_effort_id_to = a.work_effort_id
	and z3.work_effort_assoc_type_id = '18PMAOBST'
left outer join work_effort a3 on
	a3.work_effort_id = z3.work_effort_id_from
	and a3.current_status_id not in (
	select
		status_id
	from
		status_item
	where
		act_st_enum_id = 'ACTSTATUS_REPLACED')
left outer join work_effort_type b3 on
	b3.work_effort_type_id = a3.work_effort_type_id
	-- altre spl coinvolte
left outer join work_effort_note wen on
	wen.work_effort_id = a.work_effort_id
	and wen.is_main = 'Y'
	and wen.sequence_id = 10
left outer join note_data nd on
	nd.note_id = wen.note_id
	-- obiettivo defr
left outer join work_effort_note wen1 on
	wen1.work_effort_id = a.work_effort_id
	and wen1.is_main = 'Y'
	and wen1.sequence_id = 20
left outer join note_data nd1 on
	nd1.note_id = wen1.note_id
left outer join (
	select
		q.work_effort_id as id_amount3,
		max(r.amount) as amount3
	from
		acctg_trans q
	inner join acctg_trans_entry r on
		q.acctg_trans_id = r.acctg_trans_id
	where
		r.gl_account_id = 'SCORE'
		and r.gl_fiscal_type_id = 'ACTUAL'
		and q.transaction_date = TO_DATE($P{customTimePeriod},
		'YYYY/MM/DD')
	group by
		q.work_effort_id
       ) i on
	i.id_amount3 = a.work_effort_id
       
        /* VALORE PUBBLICO */
left join work_effort_purpose_type wept on
	wept.work_effort_purpose_type_id = a.work_effort_purpose_type_id
       
       /* AMBITO DI VALORE PUBBLICO */
left join work_effort_assoc wea on
	wea.work_effort_id_to = a.work_effort_id
	and wea.work_effort_assoc_type_id = '18OBSAVALP'
left join work_effort valpub on
	valpub.work_effort_id = wea.work_effort_id_from
	and valpub.work_effort_type_id = '24IST1MAP'
	and valpub.work_effort_revision_id is null
where
	z.work_effort_assoc_type_id = '26ORGSTA'
	and( $P{excludeValidity} = 'Y'
		or ($P{excludeValidity} = 'N'
			and ( z.from_date <= TO_DATE($P{customTimePeriod},
			'YYYY/MM/DD')
				and (z.thru_date >= TO_DATE($P{customTimePeriod},
				'YYYY/MM/DD')
					or z.thru_date is null ))))
	and z.work_effort_id_from =  $P{workEffortId1} 
	and st.act_st_enum_id <> 'ACTSTATUS_REPLACED'
	 $P!{id4string} 
	--@typeId
 		--  @statusId
order by z.sequence_num,a.source_reference_id,a.work_effort_id]]>
	</queryString>
