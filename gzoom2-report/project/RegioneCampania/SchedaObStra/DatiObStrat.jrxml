		<queryString>
			<![CDATA[select 
  we.work_effort_id,
  we.etch, 
  we.work_effort_name 
from work_effort_assoc wea
inner join work_effort we 
 on we.work_effort_id = wea.work_effort_id_from
where wea.work_effort_id_to =  $P{workEffortId3} 
and wea.work_effort_assoc_type_id = '18BILPROC'
order by we.etch]]>
		</queryString>
