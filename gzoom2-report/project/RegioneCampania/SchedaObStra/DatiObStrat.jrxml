		<queryString>
			<![CDATA[select 
  nd.note_name, 
  nd.note_info, 
  nd.note_date_time, 
  wn.sequence_id,
  we.work_effort_type_id 
from work_effort_note wn
inner join note_data nd on wn.note_id = nd.note_id
inner join work_effort we on we.work_effort_id = wn.work_effort_id
left outer join work_effort_type_attr attr on attr.work_effort_type_id = we.work_effort_type_id
  and attr.attr_name = nd.note_name
where wn.work_effort_id =  $P{workEffortId3} 
  and nd.note_date_time >= TO_DATE($P{date0101}, 'YYYY/MM/DD')
  and nd.note_date_time <= TO_DATE($P{customTimePeriod}, 'YYYY/MM/DD')
  and (
        nd.note_name = 'Altre strutture coinvolte'
     or nd.note_name = 'Altre PA o soggetti coinvolti'
     or (
          nd.note_name = 'Relazione sulla modifica'
          and $P{reportContentId} = 'REPORT_OBISTRAT2'
          and we.work_effort_type_id LIKE '%OBSAM'
          and nd.note_info IS NOT NULL
        )
     or (
          nd.note_name = 'Relazione sul monitoraggio' 
          and $P{reportContentId} = 'REPORT_OBISTRAT2'
          and nd.note_info IS NOT NULL
        )
     or (
          nd.note_name = 'Relazione sulla valutazione' 
          and $P{reportContentId} = 'REPORT_OBISTRAT3'
        )
      )
order by wn.sequence_id, nd.note_date_time desc]]>
		</queryString>
