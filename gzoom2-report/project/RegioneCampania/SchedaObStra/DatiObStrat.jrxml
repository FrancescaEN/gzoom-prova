	<subDataset name="StakeholdersDS" uuid="0af9368b-fbb0-4597-baf4-b7ed00f0d6a3">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="postgres_regione_campania"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="226"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="769"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="date3112" class="java.util.Date"/>
		<parameter name="workEffortId3" class="java.lang.String"/>
		<parameter name="customTimePeriod" class="java.lang.String"/>
		<queryString>
			<![CDATA[select 
  a.work_effort_id_to, 
  a.from_date, 
  a.thru_date,
  b.work_effort_id,
  b.etch, 
  b.work_effort_name
from work_effort_assoc a
inner join work_effort b on b.work_effort_id = a.work_effort_id_from
where a.work_effort_id_to = $P{workEffortId3} 
and a.work_effort_assoc_type_id = '19DEFSTKC'
and a.from_date <= TO_DATE( $P{customTimePeriod},
				'YYYY/MM/DD') and (a.thru_date is null or a.thru_date >= TO_DATE( $P{customTimePeriod},
				'YYYY/MM/DD'))
order by b.source_reference_id]]>
		</queryString>
