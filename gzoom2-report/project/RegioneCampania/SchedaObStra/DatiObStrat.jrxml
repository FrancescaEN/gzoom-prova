	<subDataset name="Correlazioni2DS" uuid="84f6f8d4-2524-4dcb-90ae-9a924c1c2653">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="postgres_regione_campania"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="226"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="769"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="workEffortId3" class="java.lang.String"/>
		<parameter name="customTimePeriod" class="java.lang.String"/>
		<queryString>
			<![CDATA[select distinct																													
	sp.etch as sottoprocesso_etch, 
	sp.work_effort_name as sottoprocesso_name,
	sp.work_effort_id as sottoprocesso_id,																																	
	ta.description as ta_description, 
	ta.gl_account_type_id as ta_gl_account_type_id,
	wl.account_name as ac_account_name, 
	wl.description as ac_description, 
	al.uom_code as al_uom_code, 
	al.uom_descr as al_uom_descr, 
	al.uom_rating_value as al_uom_rating_value, 
	ri.amount as ri_amount,
	wl.account_code as wl_account_code,
	wl.sequence_id as wl_sequence_id,
	sp.source_reference_id as sp_source_reference_id,
	wl.uom_type_id	
	
		 
from  work_effort sp 																																			
inner join work_effort_type spt on spt.work_effort_type_id = sp.work_effort_type_id																																				
left outer join (																																			
	select wi.work_effort_measure_id, wi.sequence_id, wi.work_effort_id, ac.gl_account_id, ac.gl_account_type_id, ac.default_uom_id,																																	
			ac.account_name, ac.description, ac.account_code, uo.uom_type_id																												
	from work_effort_measure wi 																																	
		inner join gl_account ac on ac.gl_account_id = wi.gl_account_id
		inner join uom uo on ac.default_uom_id = uo.uom_id 																												
	where wi.we_measure_type_enum_id <> 'WEMT_SCORE'																																	
	) wl on wl.work_effort_id = sp.work_effort_id																																	
left join gl_account_type ta on ta.gl_account_type_id = wl.gl_account_type_id																																				
left join gl_account_meas_rat_sc al on al.gl_account_id = wl.gl_account_id and al.uom_id = wl.default_uom_id																																				
left join (																																				
	select tp.voucher_ref, tp.transaction_date, ep.amount																																			
	from acctg_trans tp																																			
		inner join acctg_trans_entry ep on ep.acctg_trans_id = tp.acctg_trans_id																																		
	where ep.gl_account_id <> 'SCOREKPI' 																																	
	) ri on ri.voucher_ref = wl.work_effort_measure_id and ri.transaction_date =  TO_DATE($P{customTimePeriod},
			'YYYY/MM/DD')   -- mappa.ref_date 
  left outer join work_effort_purpose_account wapa on wl.gl_account_id = wapa.gl_account_id
  left outer join work_effort_type_content wtic ON wapa.work_effort_purpose_type_id = wtic.work_effort_purpose_type_id 																																			
where  sp.work_effort_id =  $P{workEffortId3}   and ta.gl_account_type_id = 'CARATT'
and wtic.content_id = 'WEFLD_IND2'
and (al.uom_rating_value = ri.amount or ri.amount is null)
order by sp.source_reference_id, ta.gl_account_type_id, wl.sequence_id, wl.account_code, al.uom_rating_value]]>
		</queryString>
		<field name="sottoprocesso_etch" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="sottoprocesso_etch"/>
