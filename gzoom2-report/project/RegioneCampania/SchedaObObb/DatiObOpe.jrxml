		<parameter name="organizationId" class="java.lang.String">
			<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
		</parameter>
		<parameter name="organizationIdString" class="java.lang.String">
			<defaultValueExpression><![CDATA[$P{organizationId}  != null && $P{organizationId}  != ""   && LEN($P{organizationId}) != 0 ? "' AND  RA.ORGANIZATION_ID = '" + $P{orgUnitId}  + "'": ""]]></defaultValueExpression>
		</parameter>
		<parameter name="date3006" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilDateTime.getMonthEndFromDatetime("6",$P{REPORT_TIME_ZONE}.getID(),YEAR($P{customDate}), $P{REPORT_LOCALE}.getDefault())]]></defaultValueExpression>
		</parameter>
		<parameter name="date3006sql" class="java.lang.String">
			<defaultValueExpression><![CDATA[SUBSTITUTE(com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc($P{date3006}, $P{odaDialect}),"'","")]]></defaultValueExpression>
		</parameter>
		<parameter name="excludePerformanceKPI" class="java.lang.String" isForPrompting="false"/>
		<parameter name="workEffortId4" class="java.lang.String"/>
		<queryString>
			<![CDATA[select 
		indic.g_input_enum_id,
		indic.g_account_code,
		indic.g_account_name,
		indic.g_gl_account_type_id,
		indic.m_sequence_id,
		indic.m_work_effort_measure_id,		
		indic.g_uom_abbreviation,
		indic.m_kpi_score_weight,
		indic.g_uom_decimal_scale,
		indic.m_uom_descr,
		indic.m_we_measure_type_enum_id,
		indic.g_gl_account_id,	
		indic.g_uom_type_id,
		indic.m_thru_date,
		wp.uom_descr,
		indic.g_description,
		gt.description as gt_description,
		indic.m_comments,
	
      max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'BUDGET' and indic.tt_transaction_date = $P{date3112} then indic.tm_amount else null end)  budget_dato,
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'BUDGET' and indic.tt_transaction_date = $P{date3112} then indic.r_uom_code else null end)  budget_cod,	  	   
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'BUDGET' and indic.tt_transaction_date = $P{date3112} then indic.tt_description else null end) budget_commento,
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'BUDGET' and indic.tt_transaction_date = $P{date3112} then indic.tm_description else null end)  budget_riferimento,
	  
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'ACTUAL' and indic.tt_transaction_date = TO_DATE( $P{customTimePeriod} ,'YYYY/MM/DD') then indic.tm_amount else null end)  actual_dato,
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'ACTUAL' and indic.tt_transaction_date = TO_DATE( $P{customTimePeriod} ,'YYYY/MM/DD') then indic.r_uom_code else null end)  actual_cod,	  	   
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'ACTUAL' and indic.tt_transaction_date = TO_DATE( $P{customTimePeriod} ,'YYYY/MM/DD') then indic.tt_description else null end) actual_commento,
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'ACTUAL' and indic.tt_transaction_date = TO_DATE( $P{customTimePeriod} ,'YYYY/MM/DD') then indic.tm_description else null end)  actual_riferimento,
	    
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'START' and indic.tt_transaction_date = $P{date3006} then indic.tm_amount else null end)  start_dato,
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'START' and indic.tt_transaction_date = $P{date3006} then indic.r_uom_code else null end)  start_cod,
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'START' and indic.tt_transaction_date = $P{date3006} then indic.tt_description else null end) start_commento,
	  max(case when indic.tm_gl_account_id <> 'SCOREKPI' and indic.tt_gl_fiscal_type_id = 'START' and indic.tt_transaction_date = $P{date3006} then indic.tm_description else null end)  start_riferimento,
	  
	  max(case when g.a_transaction_date = TO_DATE( $P{customTimePeriod} ,'YYYY/MM/DD') then g.b_amount else null end ) actual_scorekpi,
	  ROW_NUMBER() OVER (PARTITION BY indic.m_work_effort_id ORDER BY indic.m_sequence_id,indic.g_account_code,indic.m_work_effort_measure_id) as "Progressivo"
	from work_effort_trans_obj_view indic
	inner join gl_account_type gt on gt.gl_account_type_id = indic.g_gl_account_type_id
	left outer join acctg_trans_view g on g.b_gl_account_id= 'SCOREKPI' AND g.b_gl_fiscal_type_id = 'ACTUAL' AND g.b_voucher_ref = indic.m_work_effort_measure_id 
    	and g.b_gl_fiscal_type_id = indic.tm_gl_fiscal_type_id and g.a_transaction_date = indic.tt_transaction_date	
	left outer join 
	( select wm.gl_account_id, pr.product_id, wm.uom_descr
		from work_effort_measure wm
		inner join product pr on pr.product_id = wm.product_id
		where wm.work_effort_id is null) wp
		on wp.gl_account_id = indic.m_gl_account_id and wp.product_id = indic.m_product_id

	where (indic.g_gl_account_id <> 'SCORE' or indic.g_gl_account_id is null)
		 and indic.g_account_type_enum_id = 'INDICATOR'
		 and (  $P{excludePerformanceKPI}  = 'N' or (  $P{excludePerformanceKPI}  = 'Y' and indic.m_we_measure_type_enum_id = 'WEMT_PERF'))
		 and indic.m_work_effort_id = $P{workEffortId4} 
   		 and indic.m_thru_date >= $P{date0101}
	  	 and indic.m_from_date <= $P{date3112}
	  	 and gt.gl_account_type_id <> 'CARATT'
	  	 	
 group by  indic.m_work_effort_id,        	
		indic.g_input_enum_id,
		indic.g_account_code,
		indic.g_account_name,
		indic.g_gl_account_type_id,
		indic.m_sequence_id,
		indic.m_work_effort_measure_id,		
		indic.g_uom_abbreviation,
		indic.m_kpi_score_weight,
		indic.g_uom_decimal_scale,
		indic.m_uom_descr,
		indic.m_we_measure_type_enum_id,
		indic.g_gl_account_id,	
		indic.g_uom_type_id,
		indic.m_thru_date,
		wp.uom_descr,
		indic.g_description,
		gt.description,
		indic.m_comments	

order by
		indic.m_sequence_id,
		indic.g_account_code,
  		indic.g_gl_account_id ,
  		indic.m_work_effort_measure_id]]>
		</queryString>
