	<queryString>
		<![CDATA[select
	z.work_effort_id_from as work_effort_id_from4,
	b.etch as etichetta4,
	a.etch as etch4,
	a.work_effort_name as name4,
	z.sequence_num as seq4,
	a.work_effort_id as id4,
	a.description as description4,
	z.assoc_weight as assoc_weight4,
	a.source_reference_id as code4 ,
		a.estimated_start_date as estimated_start_date4,
	a.estimated_completion_date as estimated_completion_date4,		
		nd.note_name as note_name_spl4,
	nd.note_info as note_info_spl4,
	nd1.note_name as note_name_defr4,
	nd1.note_info as note_info_defr4,
		i.amount4,
	b.code_prefix as pref4,
	b.work_effort_type_id as type_id4,
		z2.sequence_num as seq5,
	a2.work_effort_id as id5,
	a2.etch as etch5,
	a2.work_effort_name as name5,
	a2.source_reference_id as code5,
	b2.code_prefix as pref5,    
		linea.work_effort_id_to,
	linea.work_effort_name,
	linea.source_reference_id,
	linea.etch
from
	work_effort_assoc z
inner join work_effort a on
	a.work_effort_id = z.work_effort_id_to
	---and ((? is null and a.work_effort_revision_id is null) or (? is not null and a.work_effort_revision_id = ?))
inner join work_effort_assoc_type d on
	d.work_effort_assoc_type_id = z.work_effort_assoc_type_id
inner join work_effort_type b on
	b.work_effort_type_id = a.work_effort_type_id
inner join status_item st on
	st.status_id = a.current_status_id
left join (
	select
			wea.work_effort_id_to,
			lin.work_effort_name,
			lin.source_reference_id,
		lin.etch
	from
		work_effort_assoc wea
	join work_effort lin on
		lin.work_effort_id = wea.work_effort_id_from
	where
		wea.work_effort_assoc_type_id = '19DEFSCHC') linea on
	linea.work_effort_id_to = a.work_effort_id
	-- altre spl coinvolte
left outer join work_effort_note wen on
	wen.work_effort_id = a.work_effort_id
	and wen.is_main = 'Y'
	and wen.sequence_id = 10
left outer join note_data nd on
	nd.note_id = wen.note_id
	-- obiettivo defr
left outer join work_effort_note wen1 on
	wen1.work_effort_id = a.work_effort_id
	and wen1.is_main = 'Y'
	and wen1.sequence_id = 20
left outer join note_data nd1 on
	nd1.note_id = wen1.note_id
left outer join (
	select
		q.work_effort_id as id_amount4,
		max(r.amount) as amount4
	from
		acctg_trans q
	inner join acctg_trans_entry r on
		q.acctg_trans_id = r.acctg_trans_id
	where
		r.gl_account_id = 'SCORE'
		and r.gl_fiscal_type_id = 'ACTUAL'
		and q.transaction_date = TO_DATE($P{customTimePeriod},
		'YYYY/MM/DD')
	group by
		q.work_effort_id
       ) i on
	i.id_amount4 = a.work_effort_id
inner join work_effort_assoc z2
     on
	z2.work_effort_id_to = a.work_effort_id
	and z2.work_effort_assoc_type_id = '18PMAOBSA'
	and( $P{excludeValidity} = 'Y'
		or ($P{excludeValidity} = 'N'
			and ( z2.from_date <= TO_DATE($P{customTimePeriod},
			'YYYY/MM/DD')
				and (z2.thru_date >= TO_DATE($P{customTimePeriod},
				'YYYY/MM/DD')
					or z2.thru_date is null ))))
inner join work_effort a2 on
	a2.work_effort_id = z2.work_effort_id_from
inner join work_effort_type b2 on
	b2.work_effort_type_id = a2.work_effort_type_id
inner join status_item st2 on
	st2.status_id = a2.current_status_id
where
	z.work_effort_assoc_type_id = '26ORGSTB'
	and( $P{excludeValidity} = 'Y'
		or ($P{excludeValidity} = 'N'
			and ( z.from_date <= TO_DATE($P{customTimePeriod},
			'YYYY/MM/DD')
				and (z.thru_date >= TO_DATE($P{customTimePeriod},
				'YYYY/MM/DD')
					or z.thru_date is null ))))
	and z.work_effort_id_from = $P{workEffortId2}
	and st.act_st_enum_id <> 'ACTSTATUS_REPLACED'
	and st2.act_st_enum_id <> 'ACTSTATUS_REPLACED'
	--@typeId
	--@statusId]]>
	</queryString>
