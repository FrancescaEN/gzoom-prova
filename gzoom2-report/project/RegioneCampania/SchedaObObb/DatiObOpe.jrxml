	<subDataset name="WorkEffortNoteAndData2DS" uuid="1f95786e-99a8-4cdd-9732-30a9d9f0b957">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="postgres_regione_campania"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="226"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="769"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="date3112" class="java.util.Date"/>
		<parameter name="workEffortId4" class="java.lang.String"/>
		<parameter name="reportContentId" class="java.lang.String"/>
		<parameter name="date0101" class="java.util.Date" isForPrompting="false"/>
		<parameter name="date0101sql" class="java.lang.String"/>
		<parameter name="customTimePeriod" class="java.lang.String"/>
		<queryString>
			<![CDATA[select 
  nd.note_name, 
  nd.note_info, 
  nd.note_date_time, 
  wn.sequence_id,
  we.work_effort_type_id 
from work_effort_note wn
inner join note_data nd on wn.note_id = nd.note_id
inner join work_effort we on we.work_effort_id = wn.work_effort_id
left outer join work_effort_type_attr attr on attr.work_effort_type_id = we.work_effort_type_id
and attr.attr_name = nd.note_name
where wn.work_effort_id =  $P{workEffortId4} 
and nd.note_date_time >=  TO_DATE( $P{date0101},
			'YYYY/MM/DD')
and nd.note_date_time <= TO_DATE( $P{customTimePeriod},
			'YYYY/MM/DD')
and attr.is_automatic = 'N'
and not (nd.note_name = 'Altre SSL coinvolte'
or nd.note_name = 'Nota UC sulla definizione'
or nd.note_name = 'Nota UC sulla modifica' 
or nd.note_name = 'Nota OIV sulla modifica' 
or nd.note_name = 'Nota UC su monitoraggio e valutazione' 
or nd.note_name ='Proposta nuovo Processo/Fase anticorruzione da collegare all’OBSA'
or nd.note_name ='Relazione sulla modifica'
or nd.note_name ='Codice obiettivo DEFR (solo per 2019)' 
or nd.note_name ='Relazione su monitoraggio e valutazione'
or nd.note_name = 'Nota'
or nd.note_name ='Altre SPL coinvolte'
)
and not ( $P{reportContentId}  != 'REPORT_OBISTRATOP3' and nd.note_name = 'Nota' )
and not ( $P{reportContentId}  = 'REPORT_OBISTRATOP2' and 
		(
			nd.note_name = 'Nota UC su monitoraggio e valutazione' or nd.note_name = 'Relazione su monitoraggio e valutazione'
		) and TO_CHAR(nd.note_date_time,'MM') != '06'
)
and not ( $P{reportContentId}  = 'REPORT_OBISTRATOP3' and (
		 TO_CHAR(nd.note_date_time,'MM') != '12' and (
			nd.note_name = 'Relazione su monitoraggio e valutazione'
		)
	)
)
order by wn.sequence_id, nd.note_date_time desc]]>
		</queryString>
		<field name="note_name" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="note_name"/>
			<property name="com.jaspersoft.studio.field.label" value="note_name"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="note_data"/>
		</field>
		<field name="note_info" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="note_info"/>
			<property name="com.jaspersoft.studio.field.label" value="note_info"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="note_data"/>
		</field>
		<field name="note_date_time" class="java.sql.Timestamp">
			<property name="com.jaspersoft.studio.field.name" value="note_date_time"/>
			<property name="com.jaspersoft.studio.field.label" value="note_date_time"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="note_data"/>
		</field>
		<field name="sequence_id" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="sequence_id"/>
			<property name="com.jaspersoft.studio.field.label" value="sequence_id"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort_note"/>
		</field>
		<field name="work_effort_type_id" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="work_effort_type_id"/>
			<property name="com.jaspersoft.studio.field.label" value="work_effort_type_id"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort"/>
		</field>
