" AND (RA.WORK_EFFORT_ID = '" +$P{workEffortId} +  "' AND (AR.WORK_EFFORT_ID = '" + $P{workEffortIdChild}  + "' OR PR.WORK_EFFORT_ID = '" + $P{workEffortIdChild} + 
