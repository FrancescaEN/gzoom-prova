			<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilDateTime.getMonthEndFromDatetime("12",$P{REPORT_TIME_ZONE}.getID(),(YEAR($P{customDate})+1), $P{REPORT_LOCALE}.getDefault())]]></defaultValueExpression>
		</parameter>
		<parameter name="date3112P1sql" class="java.lang.String">
			<defaultValueExpression><![CDATA[SUBSTITUTE(com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc($P{date3112P1}, $P{odaDialect}),"'","")]]></defaultValueExpression>
		</parameter>
		<parameter name="date3112P2" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilDateTime.getMonthEndFromDatetime("12",$P{REPORT_TIME_ZONE}.getID(),(YEAR($P{customDate})+2), $P{REPORT_LOCALE}.getDefault())]]></defaultValueExpression>
		</parameter>
		<parameter name="date3112P2sql" class="java.lang.String">
			<defaultValueExpression><![CDATA[SUBSTITUTE(com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc($P{date3112P2}, $P{odaDialect}),"'","")]]></defaultValueExpression>
		</parameter>
