			<property name="com.jaspersoft.studio.field.name" value="ri_amount"/>
			<property name="com.jaspersoft.studio.field.label" value="ri_amount"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="acctg_trans_entry"/>
		</field>
		<field name="wl_account_code" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="wl_account_code"/>
			<property name="com.jaspersoft.studio.field.label" value="wl_account_code"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="gl_account"/>
		</field>
		<field name="wl_sequence_id" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="wl_sequence_id"/>
			<property name="com.jaspersoft.studio.field.label" value="wl_sequence_id"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort_measure"/>
		</field>
		<field name="sp_source_reference_id" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="sp_source_reference_id"/>
			<property name="com.jaspersoft.studio.field.label" value="sp_source_reference_id"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort"/>
		</field>
		<field name="uom_type_id" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="uom_type_id"/>
			<property name="com.jaspersoft.studio.field.label" value="uom_type_id"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="uom"/>
