from work_effort_assoc wea
join work_effort lin on lin.work_effort_id = wea.work_effort_id_from
where wea.work_effort_assoc_type_id = '19DEFSCHC'
 and wea.work_effort_id_to =  $P{workEffortId4}]]>
		</queryString>
