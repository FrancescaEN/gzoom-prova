	<parameter name="excludePerformanceKPI" class="java.lang.String" isForPrompting="false"/>
	<parameter name="workEffortId1" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
	rad.work_effort_name as title,
	rat.etch as rad_titolo_etch,
	rad.work_effort_id as id_rad,
	radtc.etch as rad_titolo,
	rad.work_effort_revision_id,
	b1.etch as etichetta1,
	a1.etch as etch1,
	a1.work_effort_name as name1,
	z1.sequence_num as seq1,
	a1.work_effort_id as id1,
	a1.description as description1,
	z1.assoc_weight as assoc_weight1,
	a1.source_reference_id as code1,
	b2.etch as etichetta2,
	a2.etch as etch2,
	a2.work_effort_name as name2,
	z2.sequence_num as seq2,
	a2.work_effort_id as id2,
	a2.description as description2,
	z2.assoc_weight as assoc_weight2,
	a2.source_reference_id as code2,
	b3.etch as etichetta3,
	fil_w.etch as etch3,
	fil_w.work_effort_name as name3,
	z3.sequence_num as seq3,
	fil_w.work_effort_id as id3,
	fil_w.description as description3,
	z3.assoc_weight as assoc_weight3,
	fil_w.source_reference_id as code3,
	b4.etch as etch4,
	a4.work_effort_id as id4,
	a4.source_reference_id as code4,
	a4.work_effort_name as name4
from
	work_effort rad
inner join work_effort_type rat on
	rat.work_effort_type_id = rad.work_effort_type_id
inner join work_effort_type_content radtc on
	radtc.work_effort_type_id = $P{workEffortTypeId}
	and radtc.content_id = $P{reportContentId}
left  join status_item st1 on
	st1.status_id = rad.current_status_id
	and st1.act_st_enum_id <> 'ACTSTATUS_REPLACED'
	-- struttura 1 livello
left join work_effort_assoc z1 on
	z1.work_effort_id_from = rad.work_effort_id
	and z1.work_effort_assoc_type_id = rat.hierarchy_assoc_type_id
	and ( $P{excludeValidity} = 'Y'
		or ( $P{excludeValidity} = 'N'
			and ( z1.from_date <= TO_DATE( $P{customTimePeriod} ,
			'YYYY/MM/DD')
				and (z1.thru_date >= TO_DATE($P{customTimePeriod} ,
				'YYYY/MM/DD')
					or z1.thru_date is null ))))
left join work_effort a1 on
	a1.work_effort_id = z1.work_effort_id_to
left join work_effort_assoc_type d1 on
	d1.work_effort_assoc_type_id = z1.work_effort_assoc_type_id
left join work_effort_type b1 on
	b1.work_effort_type_id = a1.work_effort_type_id
left join status_item st2 on
	st2.status_id = a1.current_status_id
	and st2.act_st_enum_id <> 'ACTSTATUS_REPLACED'
	-- strutture 2 livello
left join work_effort_assoc z2 on
	z2.work_effort_id_from = a1.work_effort_id
	and z2.work_effort_assoc_type_id = rat.hierarchy_assoc_type_id
	and ( $P{excludeValidity} = 'Y'
		or ( $P{excludeValidity} = 'N'
			and ( z2.from_date <= TO_DATE( $P{customTimePeriod},
			'YYYY/MM/DD')
				and (z2.thru_date >= TO_DATE( $P{customTimePeriod},
				'YYYY/MM/DD')
					or z2.thru_date is null ))))
left join work_effort a2 on
	a2.work_effort_id = z2.work_effort_id_to
	and a2.current_status_id not in (
	select
		status_id
	from
		status_item
	where
		act_st_enum_id = 'ACTSTATUS_REPLACED')
left join work_effort_assoc_type d2 on
	d2.work_effort_assoc_type_id = z2.work_effort_assoc_type_id
left join work_effort_type b2 on
	b2.work_effort_type_id = a2.work_effort_type_id
	-- strutture 3 livello	
left join status_item st3 on
	st3.status_id = a2.current_status_id
	and st3.act_st_enum_id <> 'ACTSTATUS_REPLACED'
left join work_effort_assoc z3 on
	z3.work_effort_id_from = a2.work_effort_id
	and z3.work_effort_assoc_type_id = rat.hierarchy_assoc_type_id
	and ( $P{excludeValidity} = 'Y'
		or ( $P{excludeValidity} = 'N'
			and ( z3.from_date <= TO_DATE( $P{customTimePeriod},
			'YYYY/MM/DD')
				and (z3.thru_date >= TO_DATE( $P{customTimePeriod},
				'YYYY/MM/DD')
					or z3.thru_date is null ))))
left join work_effort fil_w on
	fil_w.work_effort_id = z3.work_effort_id_to
	and fil_w.current_status_id not in (
	select
		status_id
	from
		status_item
	where
		act_st_enum_id = 'ACTSTATUS_REPLACED')
left join work_effort_assoc_type d3 on
	d3.work_effort_assoc_type_id = z3.work_effort_assoc_type_id
left join work_effort_type b3 on
	b3.work_effort_type_id = fil_w.work_effort_type_id
left join status_item st4 on
	st4.status_id = fil_w.current_status_id	
	left join work_effort_assoc z4 on z4.work_effort_id_from = FIL_W.work_effort_id
     and z4.work_effort_assoc_type_id = '26ORGSTC'
     and ( $P{excludeValidity}  = 'Y' or  ($P{excludeValidity}  = 'N' and ( z2.from_date <= TO_DATE( $P{customTimePeriod},
				'YYYY/MM/DD') and (z2.thru_date >= TO_DATE( $P{customTimePeriod},
				'YYYY/MM/DD') or z2.thru_date is null ))))
left join work_effort a4 on a4.work_effort_id = z4.work_effort_id_to
and a4.current_status_id not in (select status_id from status_item where act_st_enum_id = 'ACTSTATUS_REPLACED')
left join work_effort_assoc_type d4 on d4.work_effort_assoc_type_id = z4.work_effort_assoc_type_id     
left join work_effort_type b4 on b4.work_effort_type_id = a4.work_effort_type_id 
 
 $P!{filterInnerJoinString} 
 $P!{filterLeftJoinString}
where
	0 = 0
	and rad.work_effort_type_id = '18ORG0AMM'
	and rad.work_effort_snapshot_id is null
	
 $P!{orgUnitIdString} 
 $P!{filterWhereString}
 $P!{workEffortIdString} 
order by
	z1.sequence_num,
	a1.source_reference_id,
	a1.work_effort_id,
	z2.sequence_num,
	a2.source_reference_id,
	a2.work_effort_id]]>
	</queryString>
