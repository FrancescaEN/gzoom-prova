		<parameter name="reportContentId" class="java.lang.String"/>
		<queryString>
			<![CDATA[select q.work_effort_id as id_amount3, max(r.amount) as amount3
          from acctg_trans q
          inner join acctg_trans_entry r on q.acctg_trans_id = r.acctg_trans_id
          inner join work_effort_measure wm on wm.work_effort_measure_id = q.voucher_ref 
          where r.gl_account_id = 'SCORE' 
          		and r.gl_fiscal_type_id = 'ACTUAL'
          		and wm.work_effort_id = $P{workEffortId1} 
          		and q.transaction_date = TO_DATE( $P{customTimePeriod},
			'YYYY/MM/DD')
          group by q.work_effort_id]]>
		</queryString>
		<field name="id_amount3" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="id_amount3"/>
			<property name="com.jaspersoft.studio.field.label" value="id_amount3"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="acctg_trans"/>
		</field>
		<field name="amount3" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="amount3"/>
			<property name="com.jaspersoft.studio.field.label" value="amount3"/>
		</field>
	</subDataset>
