            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT
	CONCAT(AR.ETCH, ' - ', AR.WORK_EFFORT_NAME) AS "AREA",
	CONCAT(PRO.ETCH, ' - ', PRO.WORK_EFFORT_NAME) AS "PROCESSO",
	CONCAT(PPR.PARENT_ROLE_CODE, ' - ', P.PARTY_NAME) AS "STRUTTURA",
	CONCAT(FIL_W.ETCH, ' - ', FIL_W.WORK_EFFORT_NAME) AS "FASE",
	RI.LISTA_RISCHI AS "EVENTI RISCHIOSI",
	FATT.ACCOUNT_NAME AS "FATTORI ABILITANTI",
	UI.ULTERIORI_EVENTI_RISC AS "ULTERIORI EVENTI RISC",
	MAX(CASE WHEN INDIC.GL_ACCOUNT_ID = 'CORRIS.1.2' THEN INDIC.UOM_DESCR ELSE NULL END) AS "INTERESSE ESTERNO",
	MAX(CASE WHEN INDIC.GL_ACCOUNT_ID = 'CORRIS.1.1' THEN INDIC.UOM_DESCR ELSE NULL END) AS "DISCREZIONALITA",
	MAX(CASE WHEN INDIC.GL_ACCOUNT_ID = 'CORRIS.1.3' THEN INDIC.UOM_DESCR ELSE NULL END) AS "EVENTI CORRUTTIVI PASSATI",
	MAX(CASE WHEN INDIC.GL_ACCOUNT_ID = 'CORRIS.1.4' THEN INDIC.UOM_DESCR ELSE NULL END) AS "OPACITA",
	MAX(CASE WHEN INDIC.GL_ACCOUNT_ID = 'CORRIS.1.5' THEN INDIC.UOM_DESCR ELSE NULL END) AS "CARENZA MISURE DI TRATTAMENTO",
	CASE WHEN MAX(CASE WHEN INDIC.GL_ACCOUNT_ID = '10130' THEN INDIC.DESCRIPTION ELSE NULL END) IS NOT NULL
	THEN (CONCAT(MAX(CASE WHEN INDIC.GL_ACCOUNT_ID = '10130' THEN INDIC.UOM_DESCR ELSE NULL END), ' - ', MAX(CASE WHEN INDIC.GL_ACCOUNT_ID = '10130' THEN INDIC.DESCRIPTION ELSE NULL END)))
	ELSE MAX(CASE WHEN INDIC.GL_ACCOUNT_ID = '10130' THEN INDIC.UOM_DESCR ELSE NULL END) END AS "MISURE ESISTENTI",
	-- SE C'E IL COMMENTO STAMPO GIUDIZIO - COMMENTO, ALTRIMENTI SOLO GIUDIZIO
	CASE WHEN MAX(CASE WHEN INDIC.GL_ACCOUNT_ID = 'CORRIS.1.6' THEN INDIC.DESCRIPTION ELSE NULL END) IS NOT NULL
	THEN (CONCAT(MAX(CASE WHEN INDIC.GL_ACCOUNT_ID = 'CORRIS.1.6' THEN INDIC.UOM_DESCR ELSE NULL END), ' - ', MAX(CASE WHEN INDIC.GL_ACCOUNT_ID = 'CORRIS.1.6' THEN INDIC.DESCRIPTION ELSE NULL END)))
	ELSE MAX(CASE WHEN INDIC.GL_ACCOUNT_ID = 'CORRIS.1.6' THEN INDIC.UOM_DESCR ELSE NULL END) END AS "GIUDIZIO SINTETICO",
	-- SE C'E IL COMMENTO STAMPO VALUTAZIONE - COMMENTO, ALTRIMENTI SOLO VALUTAZIONE
	CASE WHEN MAX(CASE WHEN INDIC.GL_ACCOUNT_ID = '10110' THEN INDIC.DESCRIPTION ELSE NULL END) IS NOT NULL
	THEN (CONCAT(MAX(CASE WHEN INDIC.GL_ACCOUNT_ID = '10110' THEN INDIC.UOM_DESCR ELSE NULL END), ' - ', MAX(CASE WHEN INDIC.GL_ACCOUNT_ID = '10110' THEN INDIC.DESCRIPTION ELSE NULL END)))
	ELSE MAX(CASE WHEN INDIC.GL_ACCOUNT_ID = '10110' THEN INDIC.UOM_DESCR ELSE NULL END) END AS "VALUTAZIONE FINALE DELL'ESPOSIZIONE AL RISCHIO",
	MIS.WORK_EFFORT_NAME AS "MISURA",
	MAX(CASE WHEN NOTE_MIS.SEQUENCE_ID = '70' THEN NOTE_MIS.NOTE_INFO ELSE NULL END) AS "MODALITÀ ATTUATIVE",
	MAX(CASE WHEN NOTE_MIS.SEQUENCE_ID = '80' THEN NOTE_MIS.NOTE_INFO ELSE NULL END) AS "TEMPISTICHE",
	MAX(CASE WHEN NOTE_MIS.SEQUENCE_ID = '90' THEN NOTE_MIS.NOTE_INFO ELSE NULL END) AS "RESPONSABILE DELLA MISURA",
	INDIC_MIS.DESCRIZIONE AS "DESCRIZIONE INDICATORE",
	INDIC_MIS.ABBREVIATION AS "UNITA DI MISURA",
	-- SE RATING_SCALE STAMPO LA STRINGA
	MAX(CASE WHEN INDIC_MIS.GL_FISCAL_TYPE_ID = 'BUDGET' THEN CASE WHEN INDIC_MIS.UOM_TYPE_ID = 'RATING_SCALE' THEN INDIC_MIS.UOM_DESCR
	ELSE TO_CHAR(INDIC_MIS.AMOUNT,'FM999999999.00') END END) AS "TARGET",
	WEP.DESCRIPTION AS "FINALITA"
FROM WORK_EFFORT PTPC 
-- AREA DI RISCHIO
JOIN WORK_EFFORT_ASSOC WEA ON WEA.WORK_EFFORT_ID_FROM = PTPC.WORK_EFFORT_ID AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '15APPPC'
JOIN WORK_EFFORT AR ON AR.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_TO AND AR.WORK_EFFORT_TYPE_ID = '15AP1ARE' AND AR.WORK_EFFORT_REVISION_ID IS NULL
	AND AR.ESTIMATED_START_DATE <= @date3112 AND (AR.ESTIMATED_COMPLETION_DATE >= @date3112 OR AR.ESTIMATED_COMPLETION_DATE IS NULL)
-- PROCESSO
JOIN WORK_EFFORT_ASSOC WEA2 ON WEA2.WORK_EFFORT_ID_FROM = AR.WORK_EFFORT_ID AND WEA2.WORK_EFFORT_ASSOC_TYPE_ID = '15APPPC'
JOIN WORK_EFFORT PRO ON PRO.WORK_EFFORT_ID = WEA2.WORK_EFFORT_ID_TO AND PRO.WORK_EFFORT_TYPE_ID = '15AP2SAR' AND PRO.WORK_EFFORT_REVISION_ID IS NULL
	AND PRO.ESTIMATED_START_DATE <= @date3112 AND (PRO.ESTIMATED_COMPLETION_DATE >= @date3112 OR PRO.ESTIMATED_COMPLETION_DATE IS NULL)
-- FASE
JOIN WORK_EFFORT_ASSOC WEA3 ON WEA3.WORK_EFFORT_ID_FROM = PRO.WORK_EFFORT_ID AND WEA3.WORK_EFFORT_ASSOC_TYPE_ID = '15APSARR'
JOIN WORK_EFFORT FIL_W ON FIL_W.WORK_EFFORT_ID = WEA3.WORK_EFFORT_ID_TO AND FIL_W.WORK_EFFORT_TYPE_ID IN ('15AP3PRO', '15AP3F2L', '15AP3F4C') AND FIL_W.WORK_EFFORT_REVISION_ID IS NULL
	AND FIL_W.ESTIMATED_START_DATE <= @date3112 AND (FIL_W.ESTIMATED_COMPLETION_DATE >= @date3112 OR FIL_W.ESTIMATED_COMPLETION_DATE IS NULL)
-- STRUTTURA RESPONSABILE DELLA FASE
JOIN PARTY P ON P.PARTY_ID = FIL_W.ORG_UNIT_ID
JOIN PARTY_PARENT_ROLE PPR ON PPR.PARTY_ID = P.PARTY_ID

@filterInnerJoin
@filterLeftJoin



-- RISCHIO
LEFT JOIN (
	SELECT 
		STRING_AGG(RI.WORK_EFFORT_NAME, '
')  AS LISTA_RISCHI, WEA.WORK_EFFORT_ID_TO 
	FROM WORK_EFFORT_ASSOC WEA
	JOIN WORK_EFFORT RI ON RI.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_FROM AND RI.WORK_EFFORT_TYPE_ID IN ('15AAR2RIS', '15AP4RIS') AND RI.WORK_EFFORT_REVISION_ID IS NULL
		AND RI.ESTIMATED_START_DATE <= @date3112 AND (RI.ESTIMATED_COMPLETION_DATE >= @date3112 OR RI.ESTIMATED_COMPLETION_DATE IS NULL)
	WHERE WEA.WORK_EFFORT_ASSOC_TYPE_ID = '15AARISC'
	GROUP BY WEA.WORK_EFFORT_ID_TO 
) RI ON RI.WORK_EFFORT_ID_TO = FIL_W.WORK_EFFORT_ID
-- FATTORI ABILITANTI
LEFT JOIN (
--	SELECT
--		WEM.WORK_EFFORT_ID,
--		STRING_AGG(GL.ACCOUNT_NAME, '
--') AS ACCOUNT_NAME
--	FROM WORK_EFFORT_MEASURE WEM 
--	JOIN ACCTG_TRANS AT ON AT.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID AND AT.TRANSACTION_DATE = ? 
--	JOIN ACCTG_TRANS_ENTRY ATE ON ATE.VOUCHER_REF = AT.VOUCHER_REF AND ATE.AMOUNT = '100'
--	JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID AND GL.GL_RESOURCE_TYPE_ID = 'RISF'
--	GROUP BY WEM.WORK_EFFORT_ID
-- GN-5408
	select
		wem.work_effort_id,
		string_agg(concat(gl.account_name, ' - ', wemrs2.uom_code), '
') as account_name
	from work_effort_measure wem
	join acctg_trans at on at.voucher_ref = wem.work_effort_measure_id and at.transaction_date = @date3112
	join acctg_trans_entry ate on ate.voucher_ref = at.voucher_ref
	join work_effort_purpose_account wepa on wepa.gl_account_id = wem.gl_account_id and wepa.work_effort_purpose_type_id = 'CORFAT'
	join gl_account gl on gl.gl_account_id = wem.gl_account_id
	join work_effort_meas_rat_sc wemrs2 on wemrs2.work_effort_measure_id = wem.work_effort_measure_id and wemrs2.uom_rating_value = ate.amount
	group by wem.work_effort_id
) FATT ON FATT.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
-- ULTETRIORI EVENTI RISCHIOSI
LEFT JOIN (
	SELECT 
	    W.WORK_EFFORT_ID,
		STRING_AGG(N.NOTE_INFO, '
') AS ULTERIORI_EVENTI_RISC
   FROM WORK_EFFORT_NOTE W
   INNER JOIN NOTE_DATA N ON N.NOTE_ID = W.NOTE_ID
   WHERE N.NOTE_DATE_TIME >= @date3112 AND N.NOTE_DATE_TIME <= @date3112
   AND W.SEQUENCE_ID = 100
   GROUP BY W.WORK_EFFORT_ID
) UI ON UI.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
-- INDICATORI DI RISCHIO
LEFT JOIN(
	SELECT
		GL.ACCOUNT_NAME,
		WEM.WORK_EFFORT_ID,
		WEMRS.UOM_DESCR,
		GL.GL_ACCOUNT_ID,
		AT.DESCRIPTION
	FROM WORK_EFFORT_MEASURE WEM
	JOIN ACCTG_TRANS AT ON AT.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID AND AT.TRANSACTION_DATE = @date3112
	JOIN ACCTG_TRANS_ENTRY ATE ON ATE.ACCTG_TRANS_ID = AT.ACCTG_TRANS_ID
	JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID
	JOIN UOM U ON U.UOM_ID = GL.DEFAULT_UOM_ID
	JOIN WORK_EFFORT_MEAS_RAT_SC WEMRS ON WEMRS.WORK_EFFORT_MEASURE_ID = ATE.VOUCHER_REF 
		AND ATE.AMOUNT <= WEMRS.UOM_RATING_VALUE AND ATE.AMOUNT >= WEMRS.UOM_RATING_VALUE
) INDIC ON INDIC.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
-- MISURA
LEFT JOIN WORK_EFFORT_ASSOC WEA5 ON WEA5.WORK_EFFORT_ID_FROM = FIL_W.WORK_EFFORT_ID AND WEA5.WORK_EFFORT_ASSOC_TYPE_ID = '15APPRO'
LEFT JOIN WORK_EFFORT MIS ON MIS.WORK_EFFORT_ID = WEA5.WORK_EFFORT_ID_TO AND MIS.WORK_EFFORT_TYPE_ID = '15AP5M1' AND MIS.WORK_EFFORT_REVISION_ID IS NULL
	AND MIS.ESTIMATED_START_DATE <= @date3112 AND (MIS.ESTIMATED_COMPLETION_DATE >= @date3112 OR MIS.ESTIMATED_COMPLETION_DATE IS NULL)	

-- FINALITA' MISURA
LEFT JOIN WORK_EFFORT_PURPOSE_TYPE WEP ON WEP.WORK_EFFORT_PURPOSE_TYPE_ID = MIS.WORK_EFFORT_PURPOSE_TYPE_ID 

-- NOTE DELLA MISURA
LEFT JOIN (
	SELECT NOTE_NAME, NOTE_INFO, WEN.WORK_EFFORT_ID, WEN.SEQUENCE_ID 
	FROM WORK_EFFORT_NOTE WEN 
	JOIN NOTE_DATA ND ON ND.NOTE_ID = WEN.NOTE_ID -- (GN-5408) AND ND.NOTE_DATE_TIME = ?
) NOTE_MIS ON NOTE_MIS.WORK_EFFORT_ID = MIS.WORK_EFFORT_ID
-- INDICATORI MONITORAGGIO MISURA
LEFT JOIN (
	SELECT WEM.WORK_EFFORT_ID, WEM.UOM_DESCR AS DESCRIZIONE, ATE.AMOUNT, WEMRS.UOM_DESCR, ATE.GL_FISCAL_TYPE_ID, U.UOM_TYPE_ID, U.ABBREVIATION 
	FROM WORK_EFFORT_MEASURE WEM
	JOIN ACCTG_TRANS AT ON AT.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID AND AT.TRANSACTION_DATE = @date3112
	JOIN ACCTG_TRANS_ENTRY ATE ON ATE.ACCTG_TRANS_ID = AT.ACCTG_TRANS_ID AND ATE.GL_ACCOUNT_TYPE_ID = 'CORMIS'
	JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = ATE.GL_ACCOUNT_ID
	LEFT JOIN WORK_EFFORT_MEAS_RAT_SC WEMRS ON WEMRS.WORK_EFFORT_MEASURE_ID = ATE.VOUCHER_REF 
		AND ATE.AMOUNT <= WEMRS.UOM_RATING_VALUE AND ATE.AMOUNT >= WEMRS.UOM_RATING_VALUE
	JOIN UOM U ON U.UOM_ID = GL.DEFAULT_UOM_ID
) INDIC_MIS ON INDIC_MIS.WORK_EFFORT_ID = MIS.WORK_EFFORT_ID

WHERE PTPC.WORK_EFFORT_TYPE_ID = '15AP0PPC' AND PTPC.WORK_EFFORT_REVISION_ID IS NULL
AND PTPC.ESTIMATED_START_DATE <= @date3112  AND (PTPC.ESTIMATED_COMPLETION_DATE >= @date3112 OR PTPC.ESTIMATED_COMPLETION_DATE IS NULL)

@orgUnitId
@filterWhere


GROUP BY
	CONCAT(AR.ETCH, ' - ', AR.WORK_EFFORT_NAME),
	CONCAT(PRO.ETCH, ' - ', PRO.WORK_EFFORT_NAME),
	CONCAT(PPR.PARENT_ROLE_CODE, ' - ', P.PARTY_NAME),
	CONCAT(FIL_W.ETCH, ' - ', FIL_W.WORK_EFFORT_NAME),
	RI.LISTA_RISCHI,
	FATT.ACCOUNT_NAME,
	UI.ULTERIORI_EVENTI_RISC,
	MIS.WORK_EFFORT_NAME,
	INDIC_MIS.DESCRIZIONE,
	INDIC_MIS.ABBREVIATION,
	WEP.DESCRIPTION
]]></xml-property>
            <xml-property name="designerValues"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
