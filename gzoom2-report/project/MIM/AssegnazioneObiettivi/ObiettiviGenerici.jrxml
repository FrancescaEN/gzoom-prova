	<parameter name="cf" class="java.lang.String"/>
	<queryString>
		<![CDATA[WITH RECURSIVE work_effort_hierarchy AS (
        SELECT
        we.work_effort_id,
        we.work_effort_name,
        we.work_effort_name_lang,
        we.source_reference_id,
        we.etch,
        we.estimated_start_date,
        we.estimated_completion_date,
        wet.weight_kpi,
        wet.total_enum_id_kpi,
        wet.weight_kpi_control_sum,
        wet.weight_sons,
        wet.total_enum_id_sons,
        wet.weight_control_sum,
        wet.work_effort_type_id,
        wet.description as type_description, wet.description_lang as type_description_lang,
        wet.hierarchy_assoc_type_id AS work_effort_assoc_type_id,
        (null::timestamptz) as work_effort_assoc_from_date,
        (null::timestamptz) as work_effort_assoc_thru_date,
        0::numeric as sequence_num,
        (null::varchar) as work_effort_id_from,
        0 AS tree_level,
        d.object_info as icon_path,
        wem.uom_descr,
        wem.uom_descr_lang,
        wem."comments" ,
        wem.comments_lang ,
        wem.comments2 ,
        wem.comments2_lang ,
        wem.kpi_score_weight ,
        wem.kpi_other_weight ,
        gl.account_name,
        gl.account_name_lang,
        gl.account_code,
        um.abbreviation,
        um.abbreviation_lang,
        ct.from_date as ct_from_date,
        ct.thru_date as ct_thru_date,
        (null::double precision) as obj_weight
        FROM work_effort we
        INNER JOIN work_effort_type wet ON wet.work_effort_type_id = we.work_effort_type_id
        left outer join work_effort_type_period wetp on wetp.work_effort_type_period_id = we.work_effort_type_period_id
        left outer join custom_time_period ct on ct.custom_time_period_id = wetp.custom_time_period_id
        LEFT OUTER JOIN content c ON c.content_id = wet.icon_content_id
        LEFT OUTER JOIN data_resource d ON d.data_resource_id = c.data_resource_id
        LEFT OUTER join WORK_EFFORT_MEASURE wem on wem.work_effort_id = we.work_effort_id
        LEFT OUTER join gl_account gl on gl.gl_account_id = wem.gl_account_id
        LEFT OUTER join uom um on um.uom_id = gl.default_uom_id
        inner join work_effort_party_assignment wepa on wepa.work_effort_id = we.work_effort_id and wepa.role_type_id = 'WEM_EVAL_IN_CHARGE'
        inner join user_login ul on ul.party_id = wepa.party_id
        WHERE ul.user_login_id =  $P{cf} 
        and we.work_effort_revision_id is null
          and wet.is_root = 'Y'
          and (ct.thru_date is null or (we.estimated_start_date <= ct.thru_date and we.estimated_completion_date >= ct.thru_date and wepa.from_date <= ct.thru_date and wepa.thru_date >= ct.thru_date))
        UNION ALL
 
        SELECT
        wea.work_effort_id_to as work_effort_id,
        wec.work_effort_name,
        wec.work_effort_name_lang,
        wec.source_reference_id,
        wec.etch,
        wec.estimated_start_date,
        wec.estimated_completion_date,
        wet.weight_kpi,
        wet.total_enum_id_kpi,
        wet.weight_kpi_control_sum,
        wet.weight_sons,
        wet.total_enum_id_sons,
        wet.weight_control_sum,
        wet.work_effort_type_id,
        wet.description as type_description, wet.description_lang as type_description_lang,
        wea.work_effort_assoc_type_id,
        wea.from_date as work_effort_assoc_from_date,
        wea.thru_date as work_effort_assoc_thru_date,
        wea.sequence_num,
        wea.work_effort_id_from,
        weh.tree_level + 1 AS tree_level,
        d.object_info as icon_path,
        wem.uom_descr,
        wem.uom_descr_lang,
        wem."comments" ,
        wem.comments_lang ,
        wem.comments2 ,
        wem.comments2_lang ,
        wem.kpi_score_weight ,
        wem.kpi_other_weight ,
        gl.account_name,
        gl.account_name_lang,
        gl.account_code,
        um.abbreviation,
        um.abbreviation_lang,
        weh.ct_from_date,
        weh.ct_thru_date,
		wea.assoc_weight as obj_weight
        FROM work_effort_hierarchy weh
        INNER JOIN work_effort_assoc wea ON weh.work_effort_id = wea.work_effort_id_from and wea.work_effort_assoc_type_id = weh.work_effort_assoc_type_id
        INNER JOIN work_effort wec ON wec.work_effort_id = wea.work_effort_id_to
        INNER JOIN work_effort_type wet ON wet.work_effort_type_id = wec.work_effort_type_id
        LEFT OUTER JOIN content c ON c.content_id = wet.icon_content_id
        LEFT OUTER JOIN data_resource d ON d.data_resource_id = c.data_resource_id
        LEFT OUTER join WORK_EFFORT_MEASURE wem on wem.work_effort_id = wea.work_effort_id_to and (weh.ct_thru_date is null or (wea.from_date <= weh.ct_thru_date and wea.thru_date >= weh.ct_thru_date))
        LEFT OUTER join gl_account gl on gl.gl_account_id = wem.gl_account_id
        LEFT OUTER join uom um on um.uom_id = gl.default_uom_id
        WHERE wec.work_effort_revision_id  is null  
        )
        SELECT work_effort_id, work_effort_id_from, work_effort_name, work_effort_name_lang, work_effort_type_id,
               estimated_start_date, estimated_completion_date,weight_kpi,
        total_enum_id_kpi,
        weight_kpi_control_sum,
        weight_sons,
        total_enum_id_sons,
        weight_control_sum, type_description, type_description_lang,
              tree_level, work_effort_assoc_type_id,
               work_effort_assoc_from_date, work_effort_assoc_thru_date,
               sequence_num, icon_path,uom_descr,uom_descr_lang,"comments",
               comments_lang,comments2,comments2_lang,kpi_score_weight,kpi_other_weight,
               account_name,account_name_lang,account_code,abbreviation,abbreviation_lang,obj_weight
        FROM work_effort_hierarchy
        WHERE tree_level<=2
        ORDER BY tree_level, sequence_num, work_effort_id]]>
	</queryString>
