	<parameter name="cf" class="java.lang.String"/>
	<queryString>
		<![CDATA[with recursive work_effort_hierarchy as (
select
	we.work_effort_id,
	we.work_effort_name,
	we.work_effort_name_lang,
	we.current_status_id as work_effort_current_status_id,
	we.source_reference_id,
	we.etch,
	we.estimated_start_date,
	we.estimated_completion_date,
	wet.work_effort_type_id,
	wet.description as type_description,
	wet.description_lang as type_description_lang,
	wet.hierarchy_assoc_type_id as work_effort_assoc_type_id,
	wet.weight_kpi,
	wet.weight_sons,
	wet.weight_assoc_work_effort,
	wet.weight_control_sum,
	wet.weight_kpi_control_sum,
	wet.total_enum_id_kpi,
	wet.total_enum_id_sons,
	wet.total_enum_id_assoc,
	(null::timestamptz) as work_effort_assoc_from_date,
	(null::timestamptz) as work_effort_assoc_thru_date,
	0::numeric as sequence_num,
	(null::varchar) as work_effort_id_from,
	0 as tree_level,
	d.object_info as icon_path,
	wem_gl.uom_descr,
	wem_gl.uom_descr_lang,
	wem_gl.comments ,
	wem_gl.comments_lang ,
	wem_gl.comments2 ,
	wem_gl.comments2_lang ,
	wem_gl.kpi_score_weight ,
	wem_gl.kpi_other_weight ,
	wem_gl.work_effort_measure_id,
	wem_gl.account_name,
	wem_gl.account_name_lang,
	wem_gl.account_code,
	wem_gl.source as account_source,
	wem_gl.source_lang as account_source_lang,
	um.abbreviation,
	um.abbreviation_lang,
	ct.from_date as ct_from_date,
	ct.thru_date as ct_thru_date,
	(null::double precision) as obj_weight,
	(null::varchar) as note_info,
	(null::varchar) as note_info_lang,
	(null::varchar) as note_id,
	(null::varchar) as note_name,
	at.gl_fiscal_type_id,
	ate.amount,
	ate.orig_amount,
	ate.amount_locked,
	ate.currency_uom_id as value_uom_id,
	ate.description as reference,
	ate.description_lang as reference_lang,
	ate.acctg_trans_entry_seq_id,
	mrs.uom_rating_value,
	mrs.uom_code as value_code,
	mrs.uom_code_lang as value_code_lang,
	mrs.uom_descr as value_desc,
	mrs.uom_descr_lang as value_desc_lang,
	case
		when ate.gl_account_id = 'SCOREKPI' then 'Y'
		else 'N'
	end as is_scorekpi,
	case
		when wet.work_effort_type_id = '25IN1DSA2' and wem_gl.account_code ='SCORE' then 1
		when wet.work_effort_type_id = '25IN1DSA2' and wem_gl.account_code <>'SCORE' then 2
		else 0
	end as ordinamento
from
	work_effort we
inner join work_effort_type wet on
	wet.work_effort_type_id = we.work_effort_type_id
left outer join work_effort_type_period wetp on
	wetp.work_effort_type_period_id = we.work_effort_type_period_id
left outer join custom_time_period ct on
	ct.custom_time_period_id = wetp.custom_time_period_id
left outer join content c on
	c.content_id = wet.icon_content_id
left outer join data_resource d on
	d.data_resource_id = c.data_resource_id
left outer join (
select wem.uom_descr,
	wem.uom_descr_lang,
	wem.comments ,
	wem.comments_lang ,
	wem.comments2 ,
	wem.comments2_lang ,
	wem.kpi_score_weight ,
	wem.kpi_other_weight ,
	wem.work_effort_measure_id,
	wem.work_effort_id,
	gl.gl_account_id,
	gl.gl_account_type_id,
	gl.default_uom_id,
	gl.account_name,
	gl.account_name_lang,
	gl.account_code,
	gl.source,
	gl.source_lang
from work_effort_measure wem
inner join gl_account gl on
	gl.gl_account_id = wem.gl_account_id
where gl.account_code not in ('ESITO_CONCI','ESITO_CONTR')) wem_gl on wem_gl.work_effort_id = we.work_effort_id
left join gl_account_type_gl_fiscal_type atft on
	atft.gl_account_type_id = wem_gl.gl_account_type_id
	and atft.gl_fiscal_type_id = 'ACTUAL'
left join acctg_trans_entry ate on
	(ate.gl_account_id = wem_gl.gl_account_id
		or ate.gl_account_id = 'SCOREKPI')
	and ate.voucher_ref = wem_gl.work_effort_measure_id
	and atft.gl_fiscal_type_id = ate.gl_fiscal_type_id
left join acctg_trans at on
	at.acctg_trans_id = ate.acctg_trans_id
left join gl_fiscal_type gft on
	gft.gl_fiscal_type_id = ate.gl_fiscal_type_id
left outer join work_effort_meas_rat_sc mrs on
	mrs.work_effort_measure_id = wem_gl.work_effort_measure_id
	and mrs.uom_id = ate.currency_uom_id
	and mrs.uom_rating_value = ate.amount
left outer join uom um on
	um.uom_id = wem_gl.default_uom_id
inner join work_effort_party_assignment wepa on
	wepa.work_effort_id = we.work_effort_id
	and wepa.role_type_id = 'WEM_EVAL_IN_CHARGE'
inner join user_login ul on
	ul.party_id = wepa.party_id
where
	ul.user_login_id =  $P{cf} 
	and we.work_effort_revision_id is null
	and wet.is_root = 'Y'
	and (ct.thru_date is null
		or (we.estimated_start_date <= ct.thru_date
			and we.estimated_completion_date >= ct.thru_date
			and wepa.from_date <= ct.thru_date
			and wepa.thru_date >= ct.thru_date))
union all
select
	wea.work_effort_id_to as work_effort_id,
	wec.work_effort_name,
	wec.work_effort_name_lang,
	wec.current_status_id as work_effort_current_status_id,
	wec.source_reference_id,
	wec.etch,
	wec.estimated_start_date,
	wec.estimated_completion_date,
	wet.work_effort_type_id,
	wet.description as type_description,
	wet.description_lang as type_description_lang,
	wea.work_effort_assoc_type_id,
	wet.weight_kpi,
	wet.weight_sons,
	wet.weight_assoc_work_effort,
	wet.weight_control_sum,
	wet.weight_kpi_control_sum,
	wet.total_enum_id_kpi,
	wet.total_enum_id_sons,
	wet.total_enum_id_assoc,
	wea.from_date as work_effort_assoc_from_date,
	wea.thru_date as work_effort_assoc_thru_date,
	wea.sequence_num,
	wea.work_effort_id_from,
	weh.tree_level + 1 as tree_level,
	d.object_info as icon_path,
	wem_gl.uom_descr,
	wem_gl.uom_descr_lang,
	wem_gl.comments ,
	wem_gl.comments_lang ,
	wem_gl.comments2 ,
	wem_gl.comments2_lang ,
	wem_gl.kpi_score_weight ,
	wem_gl.kpi_other_weight ,
	wem_gl.work_effort_measure_id,
	wem_gl.account_name,
	wem_gl.account_name_lang,
	wem_gl.account_code,
	wem_gl.source as account_source,
	wem_gl.source_lang as account_source_lang,
	um.abbreviation,
	um.abbreviation_lang,
	weh.ct_from_date,
	weh.ct_thru_date,
	wea.assoc_weight as obj_weight,
	nd.note_info,
	nd.note_info_lang,
	nd.note_id,
	nd.note_name,
	at.gl_fiscal_type_id,
	ate.amount,
	ate.orig_amount,
	ate.amount_locked,
	ate.currency_uom_id as value_uom_id,
	ate.description as reference,
	ate.description_lang as reference_lang,
	ate.acctg_trans_entry_seq_id,
	mrs.uom_rating_value,
	mrs.uom_code as value_code,
	mrs.uom_code_lang as value_code_lang,
	mrs.uom_descr as value_desc,
	mrs.uom_descr_lang as value_desc_lang,
	case
		when ate.gl_account_id = 'SCOREKPI' then 'Y'
		else 'N'
	end as is_scorekpi,
	case
		when wet.work_effort_type_id = '25IN1DSA2' and wem_gl.account_code ='SCORE' then 1
		when wet.work_effort_type_id = '25IN1DSA2' and wem_gl.account_code <>'SCORE' then 2
		else 0
	end as ordinamento
from
	work_effort_hierarchy weh
inner join work_effort_assoc wea on
	weh.work_effort_id = wea.work_effort_id_from
	and wea.work_effort_assoc_type_id = weh.work_effort_assoc_type_id
inner join work_effort wec on
	wec.work_effort_id = wea.work_effort_id_to
inner join work_effort_type wet on
	wet.work_effort_type_id = wec.work_effort_type_id
left outer join (
	select
		wen.work_effort_id,
		nd.note_info,
		nd.note_info_lang,
		nd.note_id,
		nd.note_name
	from
		note_data nd
	inner join work_effort_note wen on
		wen.note_id = nd.note_id
	where
		nd.note_name = 'Obiettivo specifico' ) nd on
	nd.work_effort_id = wec.work_effort_id
left outer join content c on
	c.content_id = wet.icon_content_id
left outer join data_resource d on
	d.data_resource_id = c.data_resource_id
left outer join (
select wem.uom_descr,
	wem.uom_descr_lang,
	wem.comments ,
	wem.comments_lang ,
	wem.comments2 ,
	wem.comments2_lang ,
	wem.kpi_score_weight ,
	wem.kpi_other_weight ,
	wem.work_effort_measure_id,
	wem.work_effort_id,
	gl.gl_account_id,
	gl.gl_account_type_id,
	gl.default_uom_id,
	gl.account_name,
	gl.account_name_lang,
	gl.account_code,
	gl.source,
	gl.source_lang
from work_effort_measure wem
inner join gl_account gl on
	gl.gl_account_id = wem.gl_account_id
where gl.account_code not in ('ESITO_CONCI','ESITO_CONTR')) wem_gl on	
	wem_gl.work_effort_id = wea.work_effort_id_to
	and (weh.ct_thru_date is null
		or (wea.from_date <= weh.ct_thru_date
			and wea.thru_date >= weh.ct_thru_date))
left outer join gl_account gl on
	gl.gl_account_id = wem_gl.gl_account_id
	and gl.account_code not in ('ESITO_CONCI','ESITO_CONTR')
left join gl_account_type_gl_fiscal_type atft on
	atft.gl_account_type_id = gl.gl_account_type_id
	and atft.gl_fiscal_type_id = 'ACTUAL'
left join acctg_trans_entry ate on
	(ate.gl_account_id = wem_gl.gl_account_id
		or ate.gl_account_id = 'SCOREKPI')
	and ate.voucher_ref = wem_gl.work_effort_measure_id
	and atft.gl_fiscal_type_id = ate.gl_fiscal_type_id
left join acctg_trans at on
	at.acctg_trans_id = ate.acctg_trans_id
left join gl_fiscal_type gft on
	gft.gl_fiscal_type_id = ate.gl_fiscal_type_id
	and gft.gl_fiscal_type_id = 'ACTUAL'
left outer join work_effort_meas_rat_sc mrs on
	mrs.work_effort_measure_id = wem_gl.work_effort_measure_id
	and mrs.uom_id = ate.currency_uom_id
	and mrs.uom_rating_value = ate.amount
left outer join uom um on
	um.uom_id = gl.default_uom_id
where
	wec.work_effort_revision_id is null )
select
	work_effort_id,
	work_effort_id_from,
	work_effort_name,
	work_effort_name_lang,
	work_effort_current_status_id,
	note_info,
	note_info_lang,
	note_id,
	note_name,
	obj_weight,
	work_effort_type_id,
	estimated_start_date,
	estimated_completion_date,
	type_description,
	type_description_lang,
	tree_level,
	work_effort_assoc_type_id,
	work_effort_assoc_from_date,
	work_effort_assoc_thru_date,
	sequence_num,
	icon_path,
	uom_descr,
	uom_descr_lang,
	comments,
	comments_lang,
	comments2,
	comments2_lang,
	kpi_score_weight,
	kpi_other_weight,
	account_name,
	account_name_lang,
	account_code,
	account_source,
	account_source_lang,
	abbreviation,
	abbreviation_lang,
	work_effort_measure_id,
	amount,
	orig_amount,
	amount_locked,
	value_uom_id,
	uom_rating_value,
	value_code,
	value_code_lang,
	value_desc,
	value_desc_lang,
	reference,
	reference_lang,
	gl_fiscal_type_id,
	is_scorekpi,
	weight_kpi,
	weight_sons,
	weight_assoc_work_effort,
	total_enum_id_kpi,
	total_enum_id_sons,
	total_enum_id_assoc,
	weight_control_sum,
	weight_kpi_control_sum
        FROM work_effort_hierarchy
        WHERE tree_level<=2
        ORDER BY ordinamento,tree_level, sequence_num, work_effort_id,account_code]]>
	</queryString>
	<field name="work_effort_id" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="work_effort_id"/>
		<property name="com.jaspersoft.studio.field.label" value="work_effort_id"/>
	</field>
	<field name="work_effort_id_from" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="work_effort_id_from"/>
		<property name="com.jaspersoft.studio.field.label" value="work_effort_id_from"/>
	</field>
