		UtilDateTime.numberConvertToDate(row["budget_dato_3112"], reportContext.getLocale());&#13;
	} else{&#13;
		row["budget_dato_3112"]!= null ? UtilNumber.getValueFormatted(row["budget_dato_3112"], row["FORMAT"]) : '';&#13;
	}&#13;
}</expression>
