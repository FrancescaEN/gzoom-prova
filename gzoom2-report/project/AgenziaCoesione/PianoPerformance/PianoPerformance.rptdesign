            <method name="beforeOpen"><![CDATA[/**/
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value );
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );																
this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value ); 

/*
this.queryText = this.queryText.replace("@date0101",  "'2020-01-01'" );
this.queryText = this.queryText.replace("@date3112",  "'2020-12-31'" );
this.queryText = this.queryText.replace("@monitoringDate",  "'2020-12-31'");*/

//@workEffortName
var workEffortName = '';
if(params["workEffortName"].value!=null &amp;&amp; params["workEffortName"].value!= '') {
 	workEffortName = " and (ot.work_effort_name like '%"+params["workEffortName"].value+"%'  or (oo.work_effort_id is not null and oo.work_effort_name like '%"+params["workEffortName"].value+"%' ))";
}
this.queryText = this.queryText.replace("@workEffortName",  workEffortName );

//@orgUnitId
var orgUnitIdString = '';
if (params["orgUnitId"].value != null &amp;&amp; params["orgUnitId"].value != '') {
	orgUnitIdString = " and (spl.org_unit_id = '"+ params["orgUnitId"].value + "' or ssl.org_unit_id = '"+ params["orgUnitId"].value + "' or (stl.org_unit_id is not null and stl.org_unit_id = '"+ params["orgUnitId"].value + "')) ";
}
this.queryText = this.queryText.replace("@orgUnitId",  orgUnitIdString );

//ReportLog.info("workEffortID prima: "+params["workEffortIdParametric"].value);
//WorkEffortId->WorkEffortIdChild
var workEffortId = '';
if (params["workEffortIdParametric"].value != null &amp;&amp; params["workEffortIdParametric"].value != '') {

	workEffortId = " and (os.work_effort_id IN ("+params["workEffortIdParametric"].value+") or ot.work_effort_id IN ("+params["workEffortIdParametric"].value+") or (oo.work_effort_id is not null and oo.work_effort_id IN ("+params["workEffortIdParametric"].value+")))";
} 
this.queryText = this.queryText.replace("@workEffortId",  workEffortId );

//ReportLog.info("assessori "+params["assessors"].value);
var revision = '';
if(params["workEffortRevision"].value != null &amp;&amp; params["workEffortRevision"].value != '') {
	revision = " and ot.work_effort_revision_id = '"+params["workEffortRevision"].value+"' and (oo.work_effort_id is null or oo.WORK_EFFORT_REVISION_ID = '"+params["workEffortRevision"].value+"')";
}
else {
	revision = " and ot.work_effort_revision_id is null and (oo.work_effort_id is null or oo.WORK_EFFORT_REVISION_ID is null) ";
}
this.queryText = this.queryText.replace("@revision",  revision );

var score = '';
if(params["scorePreview"].value != null &amp;&amp; params["scorePreview"].value != '') {

	if (params["scorePreview"].value == 'SCOREPREVIEW_CRI'){
		score = "and (otrv.alert = 'Y' or (oo.work_effort_id is not null and oorv.alert = 'Y'))";
	} else if (params["scorePreview"].value == 'SCOREPREVIEW_NOT'){
		score = "and (otae.amount is null or (oo.work_effort_id is not null and ooae.amount is null))";
	}
}
this.queryText = this.queryText.replace("@score",  score );


//GESTIRE PERMESSI
/**/
filter = new com.mapsengineering.base.birt.util.UtilFilter(params["userLoginId"].value, params["localDispatcherName"].value);
var filterInnerJoin = filter.getWorkEffortFilterInner();
var filterLeftJoin = filter.getWorkEffortFilterLeftJoin();
var filterWhere = filter.getWorkEffortFilterWhere();
 
/* 
var filterInnerJoin = "";
var filterLeftJoin = "";
var filterWhere = ""; */


this.queryText = this.queryText.replace("@filterInnerJoin",  filterInnerJoin );
this.queryText = this.queryText.replace("@filterLeftJoin",  filterLeftJoin );
this.queryText = this.queryText.replace("@filterWhere",  filterWhere );
 
//ReportLog.info("query PEG "+this.queryText); 
 ]]></method>
