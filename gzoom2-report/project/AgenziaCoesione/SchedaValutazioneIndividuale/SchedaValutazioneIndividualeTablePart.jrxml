	<parameter name="personIdString" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$P{personId}  != null && $P{personId}  != "" ? " AND (EMPL.ID_SOGGETTO = '"+ $P{personId} + "')" : " AND EMPL.ID_SOGGETTO like '%%'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select * from empl_sch_view EMPL
inner join work_effort FIL_W
on FIL_W.work_effort_id = EMPL.ID_SCHEDA
/* START filterInnerJoin */
   $P!{filterInnerJoinString} 
/* END filterInnerJoin */
/* START filterLeftJoin */
  $P!{filterLeftJoinString} 
/* END filterLeftJoin */
where EMPL.DATA_INIZIO <= CAST($P{date3112sql} AS TIMESTAMP) AND EMPL.DATA_FINE >= CAST($P{date0101sql} AS TIMESTAMP) 
and (EMPL.ID_SOGGETTO = $P{personId} or $P{personId} is null or $P{personId} = '')
and ( EMPL.VALUTATORE is null or 
 ((EMPL.DATA_INIZIO_VALUTATORE <= CAST($P{date3112sql} AS TIMESTAMP) AND (EMPL.DATA_FINE_VALUTATORE >= CAST($P{date3112sql} AS TIMESTAMP) OR EMPL.DATA_FINE_VALUTATORE is NULL )))
)
  /* START filterWhere */
 $P!{filterWhereString} 
   /* END filterWhere */  
 /* START orgUnitIdString */
 $P!{orgUnitIdString}
 /* END orgUnitIdString */
 order by EMPL.COGNOME, EMPL.NOME, EMPL.MATRICOLA]]>
	</queryString>
