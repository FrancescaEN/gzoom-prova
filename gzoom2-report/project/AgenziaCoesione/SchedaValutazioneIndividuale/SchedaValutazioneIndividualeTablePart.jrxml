		<parameter name="ValutazioneObiettivi" class="java.lang.Double"/>
		<parameter name="PesoObiettivi" class="java.lang.Double"/>
		<queryString>
			<![CDATA[select * from EMPL_ORG_VIEW
where ID_SCHEDA = $P{workEffortId}
and (DATA = CAST($P{date3112sql} AS TIMESTAMP) or DATA is null)]]>
		</queryString>
