            <xml-property name="queryText"><![CDATA[SELECT 
  V.M_SEQUENCE_ID AS SEQUENZA, V.M_WORK_EFFORT_MEASURE_ID as IDENTIFICATIVO, V.G_INPUT_ENUM_ID AS TIPO_ODELLO,
  V.G_ACCOUNT_CODE AS CODICE_INDIC, V.G_ACCOUNT_NAME AS TITOLO_INDIC, 
  V.G_DESCRIPTION AS DESCRIZIONE_INDIC, V.G_UOM_ABBREVIATION AS UOM_ETCH, 
  V.M_UOM_DESCR AS TITOLO_MISURA, V.M_COMMENTS AS DESCRIZIONE_MISURA, 
  V.G_DETAIL_ENUM_ID, -- GESTITO SOLO ACCDET_NULL
  V.G_UOM_TYPE_ID AS TIPO_UOM,
  V.G_UOM_DECIMAL_SCALE AS SCALA_UOM,
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date1231menotre THEN TM_AMOUNT ELSE NULL END) ACTUAL_DATO_3112_MENO_TRE,  
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date1231menodue THEN TM_AMOUNT ELSE NULL END) ACTUAL_DATO_3112_MENO_DUE,  
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date1231menouno THEN TM_AMOUNT ELSE NULL END) ACTUAL_DATO_3112_MENO_UNO,  
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3006 THEN TM_AMOUNT ELSE NULL END) ACTUAL_DATO_3006,  
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112 THEN TM_AMOUNT ELSE NULL END) ACTUAL_DATO_3112,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date1231menotre THEN R_UOM_CODE ELSE NULL END) ACTUAL_COD_3112_MENO_TRE,  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date1231menodue THEN R_UOM_CODE ELSE NULL END) ACTUAL_COD_3112_MENO_DUE,  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date1231menouno THEN R_UOM_CODE ELSE NULL END) ACTUAL_COD_3112_MENO_UNO,  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3006 THEN R_UOM_CODE ELSE NULL END) ACTUAL_COD_3006,  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112 THEN R_UOM_CODE ELSE NULL END) ACTUAL_COD_3112,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3006 THEN TT_DESCRIPTION ELSE NULL END) ACTUAL_COMM_3006,  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112 THEN TT_DESCRIPTION ELSE NULL END) ACTUAL_COMM_3112,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3006 THEN TM_DESCRIPTION ELSE NULL END) ACTUAL_RIF_3006,  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112 THEN TM_DESCRIPTION ELSE NULL END) ACTUAL_RIF_3112,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date1231menotre THEN R_UOM_CODE ELSE NULL END) BUDGET_COD_3112_MENO_TRE,  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date1231menodue THEN R_UOM_CODE ELSE NULL END) BUDGET_COD_3112_MENO_DUE,  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date1231menouno THEN R_UOM_CODE ELSE NULL END) BUDGET_COD_3112_MENO_UNO,  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3006 THEN R_UOM_CODE ELSE NULL END) BUDGET_COD_3006,  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112 THEN R_UOM_CODE ELSE NULL END) BUDGET_COD_3112,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @fineannosuccessivo THEN R_UOM_CODE ELSE NULL END) BUDGET_COD_3112_PIU_UNO,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @finedueannisuccessivi THEN R_UOM_CODE ELSE NULL END) BUDGET_COD_3112_PIU_DUE,
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date1231menotre THEN TM_AMOUNT ELSE NULL END) BUDGET_DATO_3112_MENO_TRE,  
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date1231menodue THEN TM_AMOUNT ELSE NULL END) BUDGET_DATO_3112_MENO_DUE,  
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date1231menouno THEN TM_AMOUNT ELSE NULL END) BUDGET_DATO_3112_MENO_UNO,  
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3006 THEN TM_AMOUNT ELSE NULL END) BUDGET_DATO_3006,  
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112 THEN TM_AMOUNT ELSE NULL END) BUDGET_DATO_3112,
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @fineannosuccessivo THEN TM_AMOUNT ELSE NULL END) BUDGET_DATO_3112_PIU_UNO,
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @finedueannisuccessivi THEN TM_AMOUNT ELSE NULL END) BUDGET_DATO_3112_PIU_DUE,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3006 THEN TT_DESCRIPTION ELSE NULL END) BUDGET_COMM_3006,  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112 THEN TT_DESCRIPTION ELSE NULL END) BUDGET_COMM_3112,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @fineannosuccessivo THEN TT_DESCRIPTION ELSE NULL END) BUDGET_COMM_3112_PIU_UNO,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @finedueannisuccessivi THEN TT_DESCRIPTION ELSE NULL END) BUDGET_COMM_3112_PIU_DUE,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3006 THEN TM_DESCRIPTION ELSE NULL END) BUDGET_RIF_3006,  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112 THEN TM_DESCRIPTION ELSE NULL END) BUDGET_RIF_3112,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @fineannosuccessivo THEN TM_DESCRIPTION ELSE NULL END) BUDGET_RIF_3112_PIU_UNO,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @finedueannisuccessivi THEN TM_DESCRIPTION ELSE NULL END) BUDGET_RIF_3112_PIU_DUE,
SUM(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3006 THEN TR.B_AMOUNT ELSE NULL END) SCORE_DATO_3006,  
SUM(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3112 THEN TR.B_AMOUNT ELSE NULL END) SCORE_DATO_3112,  
MAX(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3112 THEN TR.A_DESCRIPTION ELSE NULL END) SCORE_COMM_3112,  
MAX(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3006 THEN TR.A_DESCRIPTION ELSE NULL END) SCORE_COMM_3006,  
MAX(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3006 THEN TR.B_DESCRIPTION ELSE NULL END) SCORE_RIF_3006,  
MAX(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3112 THEN TR.B_DESCRIPTION ELSE NULL END) SCORE_RIF_3112,  
MAX(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3006 THEN RV.COMMENTS ELSE NULL END) SCORE_DESC_3006,  
MAX(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3112 THEN RV.COMMENTS ELSE NULL END) SCORE_DESC_3112,  
MAX(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3006 THEN DR.OBJECT_INFO ELSE NULL END) SCORE_EMOTICON_3006,  
MAX(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3112 THEN DR.OBJECT_INFO ELSE NULL END) SCORE_EMOTICON_3112
FROM     WORK_EFFORT_TRANS_ALL_VIEW V      
inner join work_effort_type wet on wet.work_effort_type_id = v.w_work_effort_TYPE_id
LEFT JOIN ACCTG_TRANS_VIEW TR ON TR.B_GL_ACCOUNT_ID ='SCOREKPI'
  AND TR.B_VOUCHER_REF = V.M_WORK_EFFORT_MEASURE_ID
  AND TR.A_TRANSACTION_DATE = V.TT_TRANSACTION_DATE
  AND TR.B_GL_FISCAL_TYPE_ID = V.TT_GL_FISCAL_TYPE_ID
left join uom_range_values rv on tr.b_amount is not null
  and rv.uom_range_id = 'PERFORM'
  and rv.from_value <= tr.b_amount and rv.thru_value >= tr.b_amount
left join content co on rv.icon_content_id is not null
  and co.content_id = rv.icon_content_id
left join data_resource dr on co.data_resource_id is not null
  and dr.data_resource_id = co.data_resource_id
WHERE V.G_ACCOUNT_CODE <> 'SCORE'
  AND V.M_WORK_EFFORT_ID = ?  -- main.identificativo_OBST / OBO
  AND V.M_THRU_DATE >= @date0101  -- 'AAAA(input.ref_date)-01-01'
  AND V.M_FROM_DATE <= @date3112  -- 'AAAA(input.ref_date)-12-31'
GROUP BY V.M_SEQUENCE_ID, V.M_WORK_EFFORT_MEASURE_ID, V.G_INPUT_ENUM_ID,
  V.G_ACCOUNT_CODE, V.G_ACCOUNT_NAME, V.G_DESCRIPTION, V.G_UOM_ABBREVIATION, 
  V.M_UOM_DESCR, V.M_COMMENTS, 
  V.G_DETAIL_ENUM_ID, -- GESTITO SOLO ACCDET_NULL
  V.G_UOM_TYPE_ID,
  V.G_UOM_DECIMAL_SCALE
ORDER BY V.M_SEQUENCE_ID, V.G_ACCOUNT_CODE, V.M_WORK_EFFORT_MEASURE_ID
]]></xml-property>
