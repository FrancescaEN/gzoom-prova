            <xml-property name="queryText"><![CDATA[select 
orgspl.sequence_num as "ordinamento_SPL", spl.source_reference_id as "codice_SPL",
spl.work_effort_name as "titolo_SPL",
splssl.sequence_num as "ordinamento_SSL", ssl.source_reference_id as "codice_SSL",
ssl.work_effort_name as "titolo_SSL",
os.work_effort_name as "titolo_OBS", 
ot.work_effort_name as "titolo_OBST", 
sslot.assoc_weight as "peso_OBST",
otae.amount as "score_valore_OBST", otrv.comments as "score_descrizione_OBST", otdr.object_info as "score_emoticon_OBST",
otae.description as "score_rif_OBST", otat.description as "score_comment_OBST",
sslstl.sequence_num as "ordinamento_STL", stl.source_reference_id as "codice_STL",
stl.work_effort_name as "titolo_STL",
oo.work_effort_name as "titolo_OBO",  
stloo.assoc_weight as "peso_OBO",
ooae.amount as "score_valore_OBO", oorv.comments as "score_descrizione_OBO", oodr.object_info as "score_emoticon_OBO",
ooae.description as "score_rif_OBO", ooat.description as "score_comment_OBO",
ot.work_effort_id as "identificativo_OBST", oo.work_effort_id as "identificativo_OBO"
from work_effort pm
inner join work_effort_type pmt on pmt.work_effort_type_id = pm.work_effort_type_id
inner join work_effort_assoc pmos on pmos.work_effort_id_from = pm.work_effort_id
  and pmos.work_effort_assoc_type_id = '20D60PPE'
inner join work_effort os on os.work_effort_id = pmos.work_effort_id_to
inner join work_effort_assoc osot on osot.work_effort_id_from = os.work_effort_id
  and osot.work_effort_assoc_type_id = '20D62OBSEC'
inner join work_effort ot on ot.work_effort_id = osot.work_effort_id_to
  and ot.estimated_start_date <= @date3112     -- 'AAAA(input.ref_date)-12-31'
  and ot.estimated_completion_date >= @date0101 -- 'AAAA(input.ref_date)-01-01'
inner join work_effort_type ott on ott.work_effort_type_id = ot.work_effort_type_id
inner join work_effort_assoc sslot on sslot.work_effort_id_to = ot.work_effort_id
  and sslot.work_effort_assoc_type_id = '20P24SSL'
inner join work_effort ssl on ssl.work_effort_id = sslot.work_effort_id_from
inner join work_effort_assoc splssl on splssl.work_effort_id_to = ssl.work_effort_id
  and splssl.work_effort_assoc_type_id = '20P20ORG'
inner join work_effort spl on spl.work_effort_id = splssl.work_effort_id_from
inner join work_effort_assoc orgspl on orgspl.work_effort_id_to = spl.work_effort_id
  and orgspl.work_effort_assoc_type_id = '20P20ORG'
@filterInnerJoin
@filterLeftJoin
left join work_effort_assoc otoo on otoo.work_effort_id_from = ot.work_effort_id
  and otoo.work_effort_assoc_type_id = '20D64OBST'
left join work_effort oo on otoo.work_effort_id_to is not null
  and oo.work_effort_id = otoo.work_effort_id_to
  and oo.estimated_start_date <= @date3112      -- 'AAAA(input.ref_date)-12-31'
  and oo.estimated_completion_date >= @date0101 -- 'AAAA(input.ref_date)-01-01'
left join work_effort_type oot on oo.work_effort_id is not null
  and oot.work_effort_type_id = oo.work_effort_type_id
left join work_effort_assoc stloo on oo.work_effort_id is not null
 and stloo.work_effort_id_to = oo.work_effort_id
 and stloo.work_effort_assoc_type_id = '20P26STL'
left join work_effort stl on stloo.work_effort_id_from is not null
 and stl.work_effort_id = stloo.work_effort_id_from
left join work_effort_assoc sslstl on stl.work_effort_id is not null
 and sslstl.work_effort_id_to = stl.work_effort_id
 and sslstl.work_effort_assoc_type_id = '20P24SSLC'
left join work_effort_measure otm on otm.work_effort_id = ot.work_effort_id
  and otm.gl_account_id = 'SCORE'
left join acctg_trans otat on otm.work_effort_measure_id is not null
  and otat.voucher_ref = otm.work_effort_measure_id
  and otat.transaction_date = @date3112 -- 'AAAA(input.ref_date)-12-31'
left join acctg_trans_entry otae on otat.acctg_trans_id is not null
  and otae.acctg_trans_id = otat.acctg_trans_id
left join uom_range_values otrv on otae.amount is not null
  and otrv.uom_range_id = ott.uom_range_score_id
  and otrv.from_value <= otae.amount and otrv.thru_value >= otae.amount
left join content otco on otrv.icon_content_id is not null
  and otco.content_id = otrv.icon_content_id
left join data_resource otdr on otco.data_resource_id is not null
  and otdr.data_resource_id = otco.data_resource_id
left join work_effort_measure oom on oo.work_effort_id is not null
  and oom.work_effort_id = oo.work_effort_id
  and oom.gl_account_id = 'SCORE'
left join acctg_trans ooat on oom.work_effort_measure_id is not null
  and ooat.voucher_ref = oom.work_effort_measure_id
  and ooat.transaction_date = @date3112 -- 'AAAA(input.ref_date)-12-31'
left join acctg_trans_entry ooae on ooat.acctg_trans_id is not null
  and ooae.acctg_trans_id = ooat.acctg_trans_id
left join uom_range_values oorv on ooae.amount is not null
  and oorv.uom_range_id = oot.uom_range_score_id
  and oorv.from_value <= ooae.amount and oorv.thru_value >= ooae.amount
left join content ooco on oorv.icon_content_id is not null
  and ooco.content_id = oorv.icon_content_id
left join data_resource oodr on ooco.data_resource_id is not null
  and oodr.data_resource_id = ooco.data_resource_id
where 
@revision
-- ot.work_effort_revision_id is null -- se input.work_effort_revision_id is null
-- and (oo.work_effort_id is null or oo.work_effort_revision_id is null) -- se input.work_effort_revision_id is null
-- where ot.work_effort_revision_id = input.work_effort_revision_id -- se input.work_effort_revision_id is not null
--  and (oo.work_effort_id is null or oo.work_effort_revision_id = input.work_effort_revision_id) -- se input.work_effort_revision_id is not null
--  and (spl.org_unit_id = '98765' or ssl.org_unit_id ='98765' or (stl.org_unit_id is not null and stl.org_unit_id = '98765')) -- se input.org_unit_id è valorizzato
@orgUnitId
--  and (os.work_effort_id IN ('10670', '123456') or ot.work_effort_id IN ('10670', '123456') or (oo.work_effort_id is not null and oo.work_effort_id IN ('10670', '123456')))   -- lista input.work_effort_id (se valorizzato)
@workEffortId
--  and (os.work_effort_id = '10670' or ot.work_effort_id = '10670' or (oo.work_effort_id is not null and oo.work_effort_id = '10670') -- se input.work_effort_id valorizzato (esecuzione stampa da scheda)
--    or spl.work_effort_id = '10670' or ssl.work_effort_id = '10670' or (stl.work_effort_id is not null and stl.work_effort_id = '10670'))   -- se input.work_effort_id valorizzato (esecuzione stampa da scheda)
--  and (ot.work_effort_name like '%ABCDE%'  or (oo.work_effort_id is not null and oo.work_effort_name like '%ABCDE%' )) -- se input.work_effort_name valorizzato
@workEffortName
-- and (otrv.alert = 'Y' or (oo.work_effort_id is not null and oorv.alert = 'Y')) -- se input.previsione_amount = critico
-- and (otae.amount is null or (oo.work_effort_id is not null and ooae.amount is null)) -- se input.score_amount = non_rilevato
@score
@filterWhere
order by
orgspl.sequence_num, spl.source_reference_id,
splssl.sequence_num, ssl.source_reference_id,
sslstl.sequence_num, stl.source_reference_id
]]></xml-property>
