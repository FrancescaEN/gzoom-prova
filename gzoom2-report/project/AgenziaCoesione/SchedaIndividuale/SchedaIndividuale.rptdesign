            <xml-property name="queryText"><![CDATA[select 
sc.work_effort_id as identificativo_scheda,
am.work_effort_id as identificativo_ambito,
pe.party_name as valut_denominazione,
uo.party_name as orgunit_denominazione,
scae.amount as valut_score,
am.work_effort_name as ambi_titolo,
amae.amount as ambi_score,
scam.assoc_weight as ambi_weight,
amae.amount * scam.assoc_weight / 100 as ambi_score_weight,
na.description as elem_natura,
el.account_name as elem_titolo,
elco.uom_code as elem_codice
from work_effort sc
inner join work_effort_party_assignment wp on wp.work_effort_id = sc.work_effort_id
  and wp.role_type_id = 'WEM_EVAL_IN_CHARGE'
inner join party pe on pe.party_id = wp.party_id
inner join party uo on uo.party_id = sc.org_unit_id
left join work_effort_measure scm on scm.work_effort_id = sc.work_effort_id
  and scm.gl_account_id = 'SCORE'
left join acctg_trans scat on scm.work_effort_measure_id is not null
  and scat.voucher_ref = scm.work_effort_measure_id
  and scat.transaction_date = @date3112 -- 'AAAA(input.ref_date)-12-31'
left join acctg_trans_entry scae on scat.acctg_trans_id is not null
  and scae.acctg_trans_id = scat.acctg_trans_id
inner join work_effort_assoc scam on scam.work_effort_id_from = sc.work_effort_id
  and scam.work_effort_assoc_type_id = '20C20SCH'
inner join work_effort am on am.work_effort_id = scam.work_effort_id_to
@filterInnerJoin
@filterLeftJoin
left join work_effort_measure amm on amm.work_effort_id = am.work_effort_id
  and amm.gl_account_id = 'SCORE'
left join acctg_trans amat on amm.work_effort_measure_id is not null
  and amat.voucher_ref = amm.work_effort_measure_id
  and amat.transaction_date = @date3112 -- 'AAAA(input.ref_date)-12-31'
left join acctg_trans_entry amae on amat.acctg_trans_id is not null
  and amae.acctg_trans_id = amat.acctg_trans_id
left join work_effort_measure elm on elm.work_effort_id = am.work_effort_id
  and elm.gl_account_id <> 'SCORE'
left join gl_account el on elm.gl_account_id is not null
  and el.gl_account_id = elm.gl_account_id 
left join gl_resource_type na on el.gl_account_type_id is not null
  and na.gl_resource_type_id = el.gl_resource_type_id 
left join acctg_trans elat on elm.work_effort_measure_id is not null
  and elat.voucher_ref = elm.work_effort_measure_id
  and elat.transaction_date = @date3112 -- 'AAAA(input.ref_date)-12-31'
left join acctg_trans_entry elae on elat.acctg_trans_id is not null
  and elae.acctg_trans_id = elat.acctg_trans_id
  and elae.gl_account_id <> 'SCOREKPI'
left join work_effort_meas_rat_sc elco on elm.work_effort_measure_id is not null
  and elae.amount is not null
  and elco.work_effort_measure_id = elm.work_effort_measure_id
  and elco.uom_rating_value = elae.amount
where sc.estimated_start_date <= @date3112     -- 'AAAA(input.ref_date)-12-31'
  and sc.estimated_completion_date >= @date0101 -- 'AAAA(input.ref_date)-01-01'
  and ((el.account_name is null and elco.uom_code is null)
    or (el.account_name is not null and elco.uom_code is not null))
	@workEffortId
--  and sc.work_effort_id = '10415'  -- se lanciato da scheda
--  and sc.org_unit_id = '98765'  -- se input.org_unit_id è valorizzato
@orgUnitId
--  and sc.work_effort_name like '%ABCDE%'   -- se input.work_effort_name valorizzato
@workEffortName
@filterWhere
order by pe.party_name, scam.sequence_num,elem_natura,elm.sequence_id
]]></xml-property>
