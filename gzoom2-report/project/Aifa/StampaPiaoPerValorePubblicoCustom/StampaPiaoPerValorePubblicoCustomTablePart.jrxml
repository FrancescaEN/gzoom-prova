		<queryString language="SQL">
			<![CDATA[select SCORE.ID_SCHEDA,
SCORE.PUNTEGGIO,
SCORE.EMOTICON,
SCORE.COMMENTO$P!{langLocale} as COMMENTO,
SCORE.NOTA$P!{langLocale} as NOTA
