	</field>
	<field name="nome1" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="nome1"/>
		<property name="com.jaspersoft.studio.field.label" value="nome1"/>
	</field>
	<field name="info1" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="info1"/>
		<property name="com.jaspersoft.studio.field.label" value="info1"/>
	</field>
	<field name="nome2" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="nome2"/>
		<property name="com.jaspersoft.studio.field.label" value="nome2"/>
	</field>
	<field name="info2" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="info2"/>
		<property name="com.jaspersoft.studio.field.label" value="info2"/>
	</field>
	<field name="nome3" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="nome3"/>
		<property name="com.jaspersoft.studio.field.label" value="nome3"/>
	</field>
	<field name="info3" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="info3"/>
		<property name="com.jaspersoft.studio.field.label" value="info3"/>
	</field>
	<field name="nome4" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="nome4"/>
		<property name="com.jaspersoft.studio.field.label" value="nome4"/>
	</field>
	<field name="info4" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="info4"/>
		<property name="com.jaspersoft.studio.field.label" value="info4"/>
	</field>
	<field name="nome5" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="nome5"/>
		<property name="com.jaspersoft.studio.field.label" value="nome5"/>
	</field>
