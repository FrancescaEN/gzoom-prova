	</parameter>
	<parameter name="filterLeftJoin" class="java.lang.String">
		<defaultValueExpression><![CDATA[new com.mapsengineering.base.birt.util.UtilFilter($P{userLoginId}, $P{localDispatcherName}).getWorkEffortFilterLeftJoin()]]></defaultValueExpression>
	</parameter>
	<parameter name="filterInnerJoin" class="java.lang.String">
		<defaultValueExpression><![CDATA[new com.mapsengineering.base.birt.util.UtilFilter($P{userLoginId}, $P{localDispatcherName}).getWorkEffortFilterInner()]]></defaultValueExpression>
	</parameter>
	<parameter name="filterWhereString" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$P{filterWhere} != null ? $P{filterWhere} : ""]]></defaultValueExpression>
	</parameter>
	<parameter name="filterLeftJoinString" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$P{filterLeftJoin} != null ? $P{filterLeftJoin} : ""]]></defaultValueExpression>
	</parameter>
	<parameter name="filterInnerJoinString" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$P{filterInnerJoin} != null ? $P{filterInnerJoin} : ""]]></defaultValueExpression>
	</parameter>
	<parameter name="onlyManagers" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select 
	wet.etch as TIPOLOGIA_TRATTAMENTO,
	wet.work_effort_type_id as CODICE_TIPOLOGIA_TRATTAMENTO,
	FIL_W.work_effort_name as NOME_TRATTAMENTO,
	FIL_W.etch as ETCH_TRATTAMENTO,
	FIL_W.estimated_start_date as DATA_INIZIO_TRATTAMENTO,
	FIL_W.estimated_completion_date as DATA_FINE_TRATTAMENTO,
	rl.description as TIPOLOGIA_UNITA_RESPONSABILE,
	strutt.party_name as UNITA_RESPONSABILE,
	/*BODY QUERY*/
	/* 1 - Categorie trattamenti */
	note.nome_categorie_trattamenti as NOME1,
	note.categorie_trattamenti as INFO1,
	/* 2 - Titolari */
	folder.nome_titolari as NOME2,
	tit.lista as INFO2,
	/* 3 - Responsabili */
	note.nome_responsabili as NOME3,
	note.responsabili as INFO3,
	/* 4 - Categorie dati personali */
	note.nome_dati_personali as NOME4,
	note.dati_personali as INFO4,
	/* OLD5 - Asset utilizzati */
	/* folder.nome_asset as NOME5,
	ass.lista as INFO5, */
	/* 5 - Trasferimento dati */
	note.nome_trasferimento_dati as NOME5,
	note.trasferimento_dati as INFO5,
	/* 6 - Termini di cancellazione */
	note.nome_termini_cancellazione as NOME6,
	note.termini_cancellazione as INFO6,
	/* 7 - Gestione sicurezza */
	note.nome_gestione_sicurezza as NOME7,
	note.gestione_sicurezza as INFO7,
	/* 8 - Amministratore di sistema DEVE RIMANERE COSI */
	folder.nome_ruoli as NOME8,
	ruoli.lista as INFO8,
	null as NOME9,
	null as INFO9,
	null as NOME10,
	null as INFO10,
	null as NOME11,
	null as INFO11,
	null as NOME12,
	null as INFO12,
	null as NOME13,
	null as INFO13,
	null as NOME14,
	null as INFO14,
	null as NOME15,
	null as INFO15,
	null as NOME16,
	null as INFO16,
	null as NOME17,
	null as INFO17,
	null as NOME18,
	null as INFO18,
	null as NOME19,
	null as INFO19,
	null as NOME20,
	null as INFO20
/* TRATTAMENTO */
from work_effort FIL_W
join work_effort_type wet on wet.work_effort_type_id = FIL_W.work_effort_type_id
/* UNITA' RESPONSABILE */
join party strutt on strutt.party_id = FIL_W.org_unit_id
join party_parent_role pprstrutt on pprstrutt.party_id = strutt.party_id
join party_role prstrutt on prstrutt.party_id = strutt.party_id
join role_type rl on rl.role_type_id = prstrutt.role_type_id and rl.role_type_id = 'UO'
join party org on org.party_id = FIL_W.organization_id
/* START filterInnerJoin */
   $P!{filterInnerJoinString} 
/* END filterInnerJoin */
/* START filterLeftJoin */
  $P!{filterLeftJoinString} 
/* END filterLeftJoin */
/* NOMI DEI FOLDER */
left join (
	select 
		WETC.WORK_EFFORT_TYPE_ID,
		MAX(case when WETC.CONTENT_ID = 'WEFLD_ORGUNIT' then WETC.ETCH else null END) as NOME_TITOLARI,
		MAX(case when WETC.CONTENT_ID = 'WEFLD_WEFROM' then WETC.ETCH else null END) as NOME_ASSET,
		MAX(case when WETC.CONTENT_ID = 'WEFLD_WROLE' then WETC.ETCH else null END) as NOME_RUOLI
	from WORK_EFFORT_TYPE_CONTENT WETC
	group by
		WETC.WORK_EFFORT_TYPE_ID
) FOLDER on FOLDER.WORK_EFFORT_TYPE_ID = WET.WORK_EFFORT_TYPE_ID
/* NOTE */
left join (
	select 
		wen.work_effort_id,
		max(case when wen.sequence_id = 100 then nd.note_name else null end) as NOME_RESPONSABILI,
		max(case when wen.sequence_id = 100 then nd.note_info else null end) as RESPONSABILI,
		max(case when wen.sequence_id = 110 then nd.note_name else null end) as NOME_CATEGORIE_TRATTAMENTI,
		max(case when wen.sequence_id = 110 then nd.note_info else null end) as CATEGORIE_TRATTAMENTI,
		max(case when wen.sequence_id = 130 then nd.note_name else null end) as NOME_DATI_PERSONALI,
		max(case when wen.sequence_id = 130 then nd.note_info else null end) as DATI_PERSONALI,
		max(case when wen.sequence_id = 150 then nd.note_name else null end) as NOME_TRASFERIMENTO_DATI,
		max(case when wen.sequence_id = 150 then nd.note_info else null end) as TRASFERIMENTO_DATI,
		max(case when wen.sequence_id = 330 then nd.note_name else null end) as NOME_TERMINI_CANCELLAZIONE,
		max(case when wen.sequence_id = 330 then nd.note_info else null end) as TERMINI_CANCELLAZIONE,
		max(case when wen.sequence_id = 340 then nd.note_name else null end) as NOME_GESTIONE_SICUREZZA,
		max(case when wen.sequence_id = 340 then nd.note_info else null end) as GESTIONE_SICUREZZA
	from work_effort_note wen
	join note_data nd on nd.note_id = wen.note_id 
	group by
		wen.work_effort_id 
) note on note.work_effort_id = FIL_W.work_effort_id 
/* 2 - Titolari */
left join (
	select 
		wepa.work_effort_id,
		string_agg(concat(ppr.parent_role_code, ' - ', p.party_name), ';
' order by ppr.parent_role_code) as lista
	from work_effort_party_assignment wepa 
	join party p on p.party_id = wepa.party_id 
	join party_parent_role ppr on ppr.party_id = p.party_id 
	where wepa.role_type_id = 'WEM_GDPR_TRATTIT' and wepa.from_date <= $P{thruDate} and wepa.thru_date >= $P{fromDate}
	group by
		wepa.work_effort_id 
) tit on tit.work_effort_id = FIL_W.work_effort_id 
/* OLD5 - Asset utilizzati */
/* left join (
	select 
		wea.work_effort_id_from,
		string_agg(concat(asset.etch, ' - ', asset.work_effort_name), ';
' order by asset.etch) as lista
	from work_effort_assoc wea
	join work_effort asset on asset.work_effort_id = wea.work_effort_id_to 
	where wea.work_effort_assoc_type_id = '18PRTRTRAC'
	group by
		wea.work_effort_id_from
) ass on ass.work_effort_id_from = FIL_W.work_effort_id */
/* 8 - Amministratore di sistema */
left join (
	select 
		wepa.work_effort_id,
		string_agg(p.party_name, ';
' order by p.party_name) as lista
	from work_effort_party_assignment wepa 
	join party p on p.party_id = wepa.party_id 
	join party_parent_role ppr on ppr.party_id = p.party_id 
	where wepa.role_type_id = 'WEM_AMM_SIST' and wepa.from_date <= $P{thruDate} and wepa.thru_date >= $P{fromDate}
	group by
		wepa.work_effort_id 
) ruoli on ruoli.work_effort_id = FIL_W.work_effort_id 
where FIL_W.work_effort_type_id = '18PRTR0TRR' and FIL_W.work_effort_revision_id is null
	and FIL_W.estimated_start_date <= $P{thruDate}  and FIL_W.estimated_completion_date >= $P{fromDate}
	$P!{retrieveTrTitolare}
	$P!{orgUnitIdString}
	$P!{retrieveWorkEffortId}
	/* START filterWhere */
 	$P!{filterWhereString} 
   /* END filterWhere */	
union all
select 
	wet.etch as TIPOLOGIA_TRATTAMENTO,
	wet.work_effort_type_id as CODICE_TIPOLOGIA_TRATTAMENTO,
	FIL_W.work_effort_name as NOME_TRATTAMENTO,
	FIL_W.etch as ETCH_TRATTAMENTO,
	FIL_W.estimated_start_date as DATA_INIZIO_TRATTAMENTO,
	FIL_W.estimated_completion_date as DATA_FINE_TRATTAMENTO,
	rl.description as TIPOLOGIA_UNITA_RESPONSABILE,
	strutt.party_name as UNITA_RESPONSABILE,
	/* 1 - Descrizione trattamento */
	note.nome_descrizione as NOME1,
	note.descrizione as INFO1,
	/* 2 - Finalità trattamento */
	note.nome_finalita as NOME2,
	note.finalita as INFO2,
	/* 3 - Base giuridica di legittimità */
	note.nome_base_giuridica as NOME3,
	note.base_giuridica as INFO3,
	/* 4 - Contitolari */
	note.nome_contitolari as NOME4,
	note.contitolari as INFO4,
	/* 5 - Categorie interessate */
	note.nome_categorie_interessati as NOME5,
	note.categorie_interessati as INFO5,
	/* 6 - Categorie dati personali */
	note.nome_categorie_dati_personali as NOME6,
	note.categorie_dati_personali as INFO6,
	/* 7 - Categorie destinatari */
	note.nome_categorie_destinatari as NOME7,
	note.categorie_destinatari as INFO7,
	/* OLD8 - Asset utilizzati */
	/* folder.nome_asset as NOME8,
	ass.lista as INFO8, */
	/* 8 - Amministratore di sistema DEVE RIMANERE COSI */
	folder.nome_ruoli as NOME8,
	ruoli.lista as INFO8,
	/* 9 - Trasferimento dati */
	note.nome_trasferimenti as NOME9,
	note.trasferimenti as INFO9,
	/* 10 - Termini di cancellazione */
	note.nome_termini_cancellazione as NOME10,
	note.termini_cancellazione as INFO10,
	/* 11 - Gestione sicurezza */
	note.nome_gestione_sicurezza as NOME11,
	note.gestione_sicurezza as INFO11,
	/* 12 - Valutazione Necessità DPIA */
	'Valutazione Necessità DPIA' as NOME12,
	valdpia.lista as INFO12,
	/* 13 - Necessità DPIA */
	folder.nome_dpia as NOME13,
	dpia.uom_code as INFO13,
	null as NOME14,
	null as INFO14,
	null as NOME15,
	null as INFO15,
	null as NOME16,
	null as INFO16,
	null as NOME17,
	null as INFO17,
	null as NOME18,
	null as INFO18,
	null as NOME19,
	null as INFO19,
	null as NOME20,
	null as INFO20
/* TRATTAMENTO */
from work_effort FIL_W
join work_effort_type wet on wet.work_effort_type_id = FIL_W.work_effort_type_id
/* UNITA' RESPONSABILE */
join party strutt on strutt.party_id = FIL_W.org_unit_id
join party_parent_role pprstrutt on pprstrutt.party_id = strutt.party_id
join party_role prstrutt on prstrutt.party_id = strutt.party_id
join role_type rl on rl.role_type_id = prstrutt.role_type_id
join party org on org.party_id = FIL_W.organization_id
/* START filterInnerJoin */
   $P!{filterInnerJoinString} 
/* END filterInnerJoin */
/* START filterLeftJoin */
  $P!{filterLeftJoinString} 
/* END filterLeftJoin */
/* NOMI DEI FOLDER */
left join (
	select 
		WETC.WORK_EFFORT_TYPE_ID,
		MAX(case when WETC.CONTENT_ID = 'WEFLD_AIND2' then WETC.ETCH else null END) as NOME_DPIA,
		MAX(case when WETC.CONTENT_ID = 'WEFLD_WEFROM' then WETC.ETCH else null END) as NOME_ASSET,
		MAX(case when WETC.CONTENT_ID = 'WEFLD_WROLE' then WETC.ETCH else null END) as NOME_RUOLI
	from WORK_EFFORT_TYPE_CONTENT WETC
	group by
		WETC.WORK_EFFORT_TYPE_ID
) FOLDER on FOLDER.WORK_EFFORT_TYPE_ID = WET.WORK_EFFORT_TYPE_ID
/* NOTE */
left join (
	select 
		wen.work_effort_id,
		max(case when wen.sequence_id = 130 then nd.note_name else null end) as NOME_FINALITA,
		max(case when wen.sequence_id = 130 then nd.note_info else null end) as FINALITA,
		max(case when wen.sequence_id = 150 then nd.note_name else null end) as NOME_CATEGORIE_INTERESSATI,
		max(case when wen.sequence_id = 150 then nd.note_info else null end) as CATEGORIE_INTERESSATI,
		max(case when wen.sequence_id = 155 then nd.note_name else null end) as NOME_CATEGORIE_DATI_PERSONALI,
		max(case when wen.sequence_id = 155 then nd.note_info else null end) as CATEGORIE_DATI_PERSONALI,
		max(case when wen.sequence_id = 160 then nd.note_name else null end) as NOME_CATEGORIE_DESTINATARI,
		max(case when wen.sequence_id = 160 then nd.note_info else null end) as CATEGORIE_DESTINATARI,
		max(case when wen.sequence_id = 210 then nd.note_name else null end) as NOME_DESCRIZIONE,
		max(case when wen.sequence_id = 210 then nd.note_info else null end) as DESCRIZIONE,
		max(case when wen.sequence_id = 220 then nd.note_name else null end) as NOME_BASE_GIURIDICA,
		max(case when wen.sequence_id = 220 then nd.note_info else null end) as BASE_GIURIDICA,
		max(case when wen.sequence_id = 240 then nd.note_name else null end) as NOME_CONTITOLARI,
		max(case when wen.sequence_id = 240 then nd.note_info else null end) as CONTITOLARI,
		max(case when wen.sequence_id = 320 then nd.note_name else null end) as NOME_TRASFERIMENTI,
		max(case when wen.sequence_id = 320 then nd.note_info else null end) as TRASFERIMENTI,
		max(case when wen.sequence_id = 330 then nd.note_name else null end) as NOME_TERMINI_CANCELLAZIONE,
		max(case when wen.sequence_id = 330 then nd.note_info else null end) as TERMINI_CANCELLAZIONE,
		max(case when wen.sequence_id = 340 then nd.note_name else null end) as NOME_GESTIONE_SICUREZZA,
		max(case when wen.sequence_id = 340 then nd.note_info else null end) as GESTIONE_SICUREZZA
	from work_effort_note wen
	join note_data nd on nd.note_id = wen.note_id 
	group by
		wen.work_effort_id 
) note on note.work_effort_id = FIL_W.work_effort_id 
/* OLD8 - Asset utilizzati */
/* left join (
	select 
		wea.work_effort_id_from,
		string_agg(concat(asset.etch, ' - ', asset.work_effort_name), ';
' order by asset.etch) as lista
	from work_effort_assoc wea
	join work_effort asset on asset.work_effort_id = wea.work_effort_id_to 
	where wea.work_effort_assoc_type_id = '18PRTRTRAC'
	group by
		wea.work_effort_id_from
) ass on ass.work_effort_id_from = FIL_W.work_effort_id */
/* 8 - Amministratore di sistema */
left join (
	select 
		wepa.work_effort_id,
		string_agg(p.party_name, ';
' order by p.party_name) as lista
	from work_effort_party_assignment wepa 
	join party p on p.party_id = wepa.party_id 
	join party_parent_role ppr on ppr.party_id = p.party_id 
	where wepa.role_type_id = 'WEM_AMM_SIST' and wepa.from_date <= $P{thruDate} and wepa.thru_date >= $P{fromDate}
	group by
		wepa.work_effort_id 
) ruoli on ruoli.work_effort_id = FIL_W.work_effort_id 
/* 10 - Valutazione Necessità DPIA */
left join (
	select 
		wem.work_effort_id,
		string_agg(gl.account_name, ';
' order by gl.account_code) as lista
	from work_effort_measure wem
	join work_effort_purpose_account wepa on wepa.gl_account_id = wem.gl_account_id and wepa.work_effort_purpose_type_id = 'TRAVIP'
	join gl_account gl on gl.gl_account_id = wem.gl_account_id and gl.gl_account_id <> '10018'
	join acctg_trans act on act.voucher_ref = wem.work_effort_measure_id and act.transaction_date = $P{date3112}
	join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id and ate.amount = 100
	group by
		wem.work_effort_id 
) valdpia on valdpia.work_effort_id = FIL_W.work_effort_id 
/* 11 - Necessità DPIA */
left join (
	select 
		wem.work_effort_id,
		gamrs.uom_code 
	from work_effort_measure wem
	join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id and ate.gl_account_id = '10018'
	join acctg_trans act on act.acctg_trans_id = ate.acctg_trans_id and act.transaction_date = $P{date3112}
	left join gl_account_meas_rat_sc gamrs on gamrs.gl_account_id = wem.gl_account_id 
		and gamrs.uom_rating_value = ate.amount 
) dpia on dpia.work_effort_id = FIL_W.work_effort_id 
where FIL_W.work_effort_type_id = '18PRTR0TRA' and FIL_W.work_effort_revision_id is null
	and FIL_W.estimated_start_date <= $P{thruDate} and FIL_W.estimated_completion_date >= $P{fromDate} 
	$P!{retrieveTrResponsabile}
	$P!{orgUnitIdString}
	$P!{retrieveWorkEffortId}
	/* START filterWhere */
 	$P!{filterWhereString} 
   /* END filterWhere */	
order by
	UNITA_RESPONSABILE,
	ETCH_TRATTAMENTO]]>
	</queryString>
	<field name="tipologia_trattamento" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="tipologia_trattamento"/>
		<property name="com.jaspersoft.studio.field.label" value="tipologia_trattamento"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="work_effort_type"/>
	</field>
	<field name="codice_tipologia_trattamento" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="codice_tipologia_trattamento"/>
		<property name="com.jaspersoft.studio.field.label" value="codice_tipologia_trattamento"/>
	</field>
	<field name="nome_trattamento" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="nome_trattamento"/>
		<property name="com.jaspersoft.studio.field.label" value="nome_trattamento"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="work_effort"/>
	</field>
	<field name="etch_trattamento" class="java.lang.String">
