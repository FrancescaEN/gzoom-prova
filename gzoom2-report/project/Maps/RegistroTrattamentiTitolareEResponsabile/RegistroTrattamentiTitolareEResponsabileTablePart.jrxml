		<property name="com.jaspersoft.studio.field.label" value="etch_trattamento"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="work_effort"/>
	</field>
	<field name="data_inizio_trattamento" class="java.sql.Timestamp">
		<property name="com.jaspersoft.studio.field.name" value="data_inizio_trattamento"/>
		<property name="com.jaspersoft.studio.field.label" value="data_inizio_trattamento"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="work_effort"/>
	</field>
	<field name="data_fine_trattamento" class="java.sql.Timestamp">
		<property name="com.jaspersoft.studio.field.name" value="data_fine_trattamento"/>
		<property name="com.jaspersoft.studio.field.label" value="data_fine_trattamento"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="work_effort"/>
	</field>
	<field name="tipologia_unita_responsabile" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="tipologia_unita_responsabile"/>
		<property name="com.jaspersoft.studio.field.label" value="tipologia_unita_responsabile"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="role_type"/>
	</field>
	<field name="unita_responsabile" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="unita_responsabile"/>
