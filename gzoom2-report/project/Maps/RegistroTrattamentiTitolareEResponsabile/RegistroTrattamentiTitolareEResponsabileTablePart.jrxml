	<parameter name="retrieveTrTitolare" class="java.lang.String">
		<defaultValueExpression><![CDATA[$P{enumeration} != null && $P{enumeration}.equals( "18PRTR0TRA" ) ? "AND false" : ""]]></defaultValueExpression>
