	?	(row["RISCHIO_ETCH"] != null &amp;&amp; row["RISCHIO_ETCH"]) ? row["RISCHIO_ETCH"] + " - " +  row["RISCHIO_NAME"] :  row["RISCHIO_NAME"] &#13;
	: 	(row["RISCHIO_ETCH"] != null &amp;&amp; row["RISCHIO_ETCH"]) ? row["RISCHIO_ETCH"] + " - " +  row["RISCHIO_DESCRI"] :  row["RISCHIO_DESCRI"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">INDICATORI</property>
                    <expression name="expression">(row["M_UOM_DESCR"] != null &amp;&amp; row["M_UOM_DESCR"] != "" ? row["M_UOM_DESCR"]  : row["G_ACCOUNT_NAME"])</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">MISURA</property>
                    <expression name="expression">row["MISURA_DESCRI"] == null || row["MISURA_DESCRI"] == '' &#13;
? (row["MISURA_ETCH"] != null &amp;&amp; row["MISURA_ETCH"]) ? row["MISURA_ETCH"] + " - "  +row["MISURA_NAME"] : row["MISURA_NAME"]&#13;
:  (row["MISURA_ETCH"] != null &amp;&amp; row["MISURA_ETCH"]) ? row["MISURA_ETCH"] + " - "  +row["MISURA_DESCRI"] : row["MISURA_DESCRI"]</expression>
                    <property name="dataType">string</property>
                </structure>
