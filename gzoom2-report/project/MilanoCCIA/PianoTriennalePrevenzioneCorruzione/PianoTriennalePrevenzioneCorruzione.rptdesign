            <method name="beforeOpen"><![CDATA[var organizationIdString = "";
if (params["organizationId"].value != null &amp;&amp; params["organizationId"].value != '') {
    organizationIdString = "AND RA.ORGANIZATION_ID = '" + params["organizationId"].value + "'";
}
this.queryText = this.queryText.replace("@organizationId", organizationIdString);

var orgUnitIdString = "";
if (params["orgUnitId"].value != null &amp;&amp; params["orgUnitId"].value != '') {
	orgUnitIdString = " AND ('" + params["orgUnitId"].value + "' IS NULL OR '" + params["orgUnitId"].value + "' = '' OR '" + params["orgUnitId"].value + "' = FIL_W.ORG_UNIT_ID) ";
}
this.queryText = this.queryText.replace("@orgUnitId", orgUnitIdString);


this.queryText = this.queryText.replace("@reportContentId", "'" + params["reportContentId"].value  + "'");
this.queryText = this.queryText.replace("@excludeValidity", "'" + params["excludeValidity"].value  + "'");
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value );
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );																
this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );

/*
this.queryText = this.queryText.replace("@date0101",  "'2021-01-01 00:00:00.000'" );
this.queryText = this.queryText.replace("@date3112",  "'2021-12-31 00:00:00.000'" );
this.queryText = this.queryText.replace("@monitoringDate",  "'2021-12-31 00:00:00.000'"); 
this.queryText = this.queryText.replace("@excludeValidity", "'N'");
this.queryText = this.queryText.replace("@reportContentId",  "'REPORT_PTPC_NO_NOTE'" );   
*/
var workEffortIdString = "";
/* */ 
if (params["workEffortId"].value != null &amp;&amp; params["workEffortId"].value != '' &amp;&amp; params["workEffortIdChild"].value != null &amp;&amp; params["workEffortIdChild"].value != '') {
	workEffortIdString = " AND ( RA.WORK_EFFORT_ID = '" + params["workEffortId"].value + "' OR AR.WORK_EFFORT_ID = '" + params["workEffortIdChild"].value + "' OR PR.WORK_EFFORT_ID = '" + params["workEffortIdChild"].value + "' OR FIL_W.WORK_EFFORT_ID = '" + params["workEffortIdChild"].value + "' OR RI.WORK_EFFORT_ID = '" + params["workEffortIdChild"].value + "') ";
} else if (params["workEffortId"].value != null &amp;&amp; params["workEffortId"].value != '') {
	workEffortIdString = " AND ( RA.WORK_EFFORT_ID = '" + params["workEffortId"].value + "' ) ";
} else if (params["workEffortIdChild"].value != null &amp;&amp; params["workEffortIdChild"].value != '') {
	workEffortIdString = " AND ( AR.WORK_EFFORT_ID = '" + params["workEffortIdChild"].value + "' OR PR.WORK_EFFORT_ID = '" + params["workEffortIdChild"].value + "' OR FIL_W.WORK_EFFORT_ID = '" + params["workEffortIdChild"].value + "' OR RI.WORK_EFFORT_ID = '" + params["workEffortIdChild"].value + "') ";
} 
this.queryText = this.queryText.replace("@workEffortId", workEffortIdString);

//GESTIRE PERMESSI
/*  */
filter = new com.mapsengineering.base.birt.util.UtilFilter(params["userLoginId"].value, params["localDispatcherName"].value);
var filterInnerJoin = filter.getWorkEffortFilterInner();
var filterLeftJoin = filter.getWorkEffortFilterLeftJoin();
var filterWhere = filter.getWorkEffortFilterWhere();

/*
var filterInnerJoin = "";
var filterLeftJoin = "";
var filterWhere = "";  
*/
this.queryText = this.queryText.replace("@filterInnerJoin",  filterInnerJoin );
this.queryText = this.queryText.replace("@filterLeftJoin",  filterLeftJoin );
this.queryText = this.queryText.replace("@filterWhere",  filterWhere );

ReportLog.info("......this.queryText HeaderMeasureDS: "+this.queryText);]]></method>
