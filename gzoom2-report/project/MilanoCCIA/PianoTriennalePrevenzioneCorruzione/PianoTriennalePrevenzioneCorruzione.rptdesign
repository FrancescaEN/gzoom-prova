        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="AreaScoreDS" id="58167">
            <list-property name="columnHints"/>
            <list-property name="parameters">
                <structure>
                    <property name="name">workEffortId</property>
                    <property name="nativeName"></property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">0</property>
                    <property name="position">1</property>
                    <expression name="defaultValue" type="constant">N/A</expression>
                    <property name="isOptional">false</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">WORK_EFFORT_NAME</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">NUM_PROC</property>
                        <property name="dataType">decimal</property>
                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">ETHC_PROC</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">4</property>
                        <property name="name">CINQUE_COLONNE</property>
                        <property name="dataType">integer</property>
                    </structure>
                    <structure>
                        <property name="position">5</property>
                        <property name="name">LIV_BASSO</property>
                        <property name="dataType">decimal</property>
                    </structure>
                    <structure>
                        <property name="position">6</property>
                        <property name="name">LIV_MEDIO</property>
                        <property name="dataType">decimal</property>
                    </structure>
                    <structure>
                        <property name="position">7</property>
                        <property name="name">LIV_MINIMO</property>
                        <property name="dataType">decimal</property>
                    </structure>
                    <structure>
                        <property name="position">8</property>
                        <property name="name">LIV_CRITICO</property>
                        <property name="dataType">decimal</property>
                    </structure>
                    <structure>
                        <property name="position">9</property>
                        <property name="name">LIV_ALTO</property>
                        <property name="dataType">decimal</property>
                    </structure>
                </list-property>
            </structure>
            <method name="beforeOpen"><![CDATA[//
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );				

//this.queryText = this.queryText.replace("@date3112",  "'2021-12-31 00:00:00.000'" );

var orgUnitIdString = "";
if (params["orgUnitId"].value != null &amp;&amp; params["orgUnitId"].value != '') {
	orgUnitIdString = " AND ('" + params["orgUnitId"].value + "' IS NULL OR '" + params["orgUnitId"].value + "' = '' OR '" + params["orgUnitId"].value + "' = FIL_W.ORG_UNIT_ID) ";
}
this.queryText = this.queryText.replace("@orgUnitId", orgUnitIdString);

var workEffortIdString = ""; 
if (params["workEffortIdChild"].value != null &amp;&amp; params["workEffortIdChild"].value != '') {
	workEffortIdString = " AND ( FIL_W.WORK_EFFORT_ID = '" + params["workEffortIdChild"].value + "' OR WE_SUB.WORK_EFFORT_ID = '" + params["workEffortIdChild"].value + "' OR WE_AREA.WORK_EFFORT_ID = '" + params["workEffortIdChild"].value + "') ";
} 
this.queryText = this.queryText.replace("@workEffortId", workEffortIdString);

//GESTIRE PERMESSI
/*  */
filter = new com.mapsengineering.base.birt.util.UtilFilter(params["userLoginId"].value, params["localDispatcherName"].value);
var filterInnerJoin = filter.getWorkEffortFilterInner();
var filterLeftJoin = filter.getWorkEffortFilterLeftJoin();
var filterWhere = filter.getWorkEffortFilterWhere();

/*  
var filterInnerJoin = "";
var filterLeftJoin = "";
var filterWhere = ""; 
*/
this.queryText = this.queryText.replace("@filterInnerJoin",  filterInnerJoin );
this.queryText = this.queryText.replace("@filterLeftJoin",  filterLeftJoin );
this.queryText = this.queryText.replace("@filterWhere",  filterWhere ); 

ReportLog.info("......AreaScoreDS query: "+this.queryText);]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">WORK_EFFORT_NAME</property>
                    <property name="nativeName">WORK_EFFORT_NAME</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">NUM_PROC</property>
                    <property name="nativeName">NUM_PROC</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">ETHC_PROC</property>
                    <property name="nativeName">ETHC_PROC</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">CINQUE_COLONNE</property>
                    <property name="nativeName">CINQUE_COLONNE</property>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">LIV_BASSO</property>
                    <property name="nativeName">LIV_BASSO</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">LIV_MEDIO</property>
                    <property name="nativeName">LIV_MEDIO</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">LIV_MINIMO</property>
                    <property name="nativeName">LIV_MINIMO</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">LIV_CRITICO</property>
                    <property name="nativeName">LIV_CRITICO</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">9</property>
                    <property name="name">LIV_ALTO</property>
                    <property name="nativeName">LIV_ALTO</property>
                    <property name="dataType">decimal</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT WE_AREA.WORK_EFFORT_NAME AS "WORK_EFFORT_NAME",
COUNT(*) AS "NUM_PROC",
WT.ETCH AS "ETHC_PROC",
MAX(CASE WHEN UR.DESCRIPTION LIKE '%CINQUE%' THEN 1 ELSE NULL END) AS "CINQUE_COLONNE",
SUM(CASE WHEN VP.COMMENTS='Basso' THEN 1 ELSE 0 END) AS "LIV_BASSO",
SUM(CASE WHEN VP.COMMENTS='Medio' THEN 1 ELSE 0 END) AS "LIV_MEDIO",
SUM(CASE WHEN VP.COMMENTS='Minimo' THEN 1 ELSE 0 END) AS "LIV_MINIMO",
SUM(CASE WHEN VP.COMMENTS='Critico' THEN 1 ELSE 0 END) AS "LIV_CRITICO",
SUM(CASE WHEN VP.COMMENTS='Alto' THEN 1 ELSE 0 END) AS "LIV_ALTO"
FROM WORK_EFFORT FIL_W
@filterInnerJoin
@filterLeftJoin	
INNER JOIN WORK_EFFORT_ASSOC WEA ON FIL_W.WORK_EFFORT_ID=WEA.WORK_EFFORT_ID_TO
INNER JOIN WORK_EFFORT WE_SUB ON WEA.WORK_EFFORT_ID_FROM=WE_SUB.WORK_EFFORT_ID
INNER JOIN WORK_EFFORT_ASSOC WEA_2 ON WEA_2.WORK_EFFORT_ID_TO = WE_SUB.WORK_EFFORT_ID
INNER JOIN WORK_EFFORT WE_AREA ON WEA_2.WORK_EFFORT_ID_FROM = WE_AREA.WORK_EFFORT_ID
INNER JOIN WORK_EFFORT_MEASURE WM ON WM.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID AND WM.GL_ACCOUNT_ID = 'SCORE'
INNER JOIN WORK_EFFORT_TYPE WT ON WT.WORK_EFFORT_TYPE_ID = FIL_W.WORK_EFFORT_TYPE_ID
	
INNER JOIN ACCTG_TRANS_ENTRY EP ON EP.VOUCHER_REF = WM.WORK_EFFORT_MEASURE_ID AND EP.GL_FISCAL_TYPE_ID = 'CORRIS'
INNER JOIN ACCTG_TRANS TP ON TP.ACCTG_TRANS_ID = EP.ACCTG_TRANS_ID AND TP.TRANSACTION_DATE = @date3112																						
INNER JOIN UOM_RANGE_VALUES VP ON VP.UOM_RANGE_ID = WT.UOM_RANGE_SCORE_ID																											
		AND VP.FROM_VALUE <= EP.AMOUNT AND VP.THRU_VALUE >= EP.AMOUNT	
INNER JOIN UOM_RANGE UR ON VP.UOM_RANGE_ID = UR.UOM_RANGE_ID		
WHERE FIL_W.WORK_EFFORT_TYPE_ID='15AP3PRO' AND WE_SUB.WORK_EFFORT_TYPE_ID='15AP2SAR' AND WE_AREA.WORK_EFFORT_TYPE_ID='15AP1ARE'
AND FIL_W.WORK_EFFORT_REVISION_ID IS NULL AND WE_SUB.WORK_EFFORT_REVISION_ID IS NULL AND WE_AREA.WORK_EFFORT_REVISION_ID IS NULL 
AND EXISTS (SELECT 1 FROM WORK_EFFORT_ASSOC WA INNER JOIN WORK_EFFORT RIS ON RIS.WORK_EFFORT_ID = WA.WORK_EFFORT_ID_TO 
				INNER JOIN WORK_EFFORT_ASSOC WAM ON WAM.WORK_EFFORT_ID_FROM = RIS.WORK_EFFORT_ID 
				INNER JOIN WORK_EFFORT MIS ON MIS.WORK_EFFORT_ID = WAM.WORK_EFFORT_ID_TO 
				WHERE WA.WORK_EFFORT_ID_FROM = FIL_W.WORK_EFFORT_ID AND RIS.WORK_EFFORT_TYPE_ID = '15AP4RIS'
				AND MIS.WORK_EFFORT_TYPE_ID LIKE '15AP5M%') 
@filterWhere
@orgUnitId
@workEffortId
AND WE_AREA.WORK_EFFORT_ID = ?
GROUP BY  WE_AREA.WORK_EFFORT_NAME,WT.ETCH

]]></xml-property>
