            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">CONTENT_ID</property>
                    <property name="nativeName">CONTENT_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">ETCH</property>
                    <property name="nativeName">ETCH</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">FROM_ETCH</property>
                    <property name="nativeName">FROM_ETCH</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">FROM_NAME</property>
                    <property name="nativeName">FROM_NAME</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
     WC.CONTENT_ID AS "CONTENT_ID", WC.ETCH AS "ETCH", WEA.WE_FROM_ETCH AS "FROM_ETCH", WEA.WE_FROM_NAME AS "FROM_NAME"
FROM WORK_EFFORT WE
INNER JOIN work_effort_type_content WC ON WC.WORK_EFFORT_TYPE_ID = WE.WORK_EFFORT_TYPE_ID AND WC.WE_TYPE_CONTENT_TYPE_ID = 'FOLDER' AND WC.CONTENT_ID LIKE 'WEFLD_WET%'
INNER JOIN work_effort_type_assoc WA ON WA.WORK_EFFORT_TYPE_ID = WC.WORK_EFFORT_TYPE_ID AND WA.CONTENT_ID = WC.CONTENT_ID
LEFT JOIN WORK_EFFORT_ASSOC_VIEW WEA ON WEA.WE_TO_ID = WE.WORK_EFFORT_ID AND WEA.WE_FROM_TYPE_ID = WA.WORK_EFFORT_TYPE_ID_REF
INNER JOIN WORK_EFFORT_TYPE WT ON WT.WORK_EFFORT_TYPE_ID = WEA.WE_FROM_TYPE_ID
WHERE WE.WORK_EFFORT_ID = ? AND WT.PARENT_TYPE_ID = 'CTX_PR'
]]></xml-property>
