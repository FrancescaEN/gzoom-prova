            <xml-property name="queryText"><![CDATA[SELECT 
	   RAD.WORK_EFFORT_NAME AS "TITLE", RAD.ETCH AS "ETCH", RAT.ETCH AS "RAD_TITOLO_ETCH", RAD.WORK_EFFORT_ID AS "ID_RAD", RADTC.ETCH AS "RAD_TITOLO",
	   B0.ETCH AS "ETICHETTA0", A0.ETCH AS "ETCH0", A0.WORK_EFFORT_NAME AS "NAME0", Z0.SEQUENCE_NUM AS "SEQ0", A0.WORK_EFFORT_ID AS "ID0", A0.DESCRIPTION AS "DESCRIPTION0", Z0.ASSOC_WEIGHT AS "ASSOC_WEIGHT0", A0.SOURCE_REFERENCE_ID AS "CODE0",
	   B1.ETCH AS "ETICHETTA1", FIL_W.ETCH AS "ETCH1", FIL_W.WORK_EFFORT_NAME AS "NAME1", Z1.SEQUENCE_NUM AS "SEQ1", FIL_W.WORK_EFFORT_ID AS "ID1", FIL_W.DESCRIPTION AS "DESCRIPTION1", Z1.ASSOC_WEIGHT AS "ASSOC_WEIGHT1", FIL_W.SOURCE_REFERENCE_ID AS "CODE1",
       B2.ETCH AS "ETICHETTA2", A2.ETCH AS "ETCH2", A2.WORK_EFFORT_NAME AS "NAME2", Z2.SEQUENCE_NUM AS "SEQ2", A2.WORK_EFFORT_ID AS "ID2", A2.DESCRIPTION AS "DESCRIPTION2", Z2.ASSOC_WEIGHT AS "ASSOC_WEIGHT2", A2.SOURCE_REFERENCE_ID AS "CODE2", A2.ESTIMATED_START_DATE AS "START_DATE2", A2.ESTIMATED_COMPLETION_DATE AS "COMPLETION_DATE2", A2.WORK_EFFORT_TYPE_ID AS "WORK_EFFORT_TYPE_ID2",
       P_A1.PARTY_NAME AS "RESPONSABILE1",
	   P_A2.PARTY_NAME AS "RESPONSABILE2",
	   ND1.NOTE_NAME AS "ND1_NOTE_NAME", ND1.NOTE_INFO AS "ND1_NOTE_INFO", ND2.NOTE_NAME AS "ND2_NOTE_NAME", ND2.NOTE_INFO AS "ND2_NOTE_INFO", W.WORK_EFFORT_TYPE_ID AS "WORK_EFFORT_TYPE_ID_CHILD"
	     
FROM WORK_EFFORT RAD
	 INNER JOIN WORK_EFFORT_TYPE RAT ON RAT.WORK_EFFORT_TYPE_ID = RAD.WORK_EFFORT_TYPE_ID	
	 INNER JOIN WORK_EFFORT_TYPE_CONTENT RADTC ON RADTC.WORK_EFFORT_TYPE_ID = RAD.WORK_EFFORT_TYPE_ID
		AND RADTC.CONTENT_ID = ?
	
	 -- settore
	 INNER JOIN WORK_EFFORT_ASSOC Z0 ON Z0.WORK_EFFORT_ID_FROM = RAD.WORK_EFFORT_ID
	 	AND Z0.WORK_EFFORT_ASSOC_TYPE_ID = RAT.HIERARCHY_ASSOC_TYPE_ID
	 	AND ( @excludeValidity = 'Y' OR  (@excludeValidity = 'N' AND ( Z0.FROM_DATE <= @monitoringDate AND (Z0.THRU_DATE >= @monitoringDate OR Z0.THRU_DATE IS NULL )))) 			
     INNER JOIN WORK_EFFORT A0 ON A0.WORK_EFFORT_ID = Z0.WORK_EFFORT_ID_TO
     INNER JOIN WORK_EFFORT_ASSOC_TYPE D0 ON D0.WORK_EFFORT_ASSOC_TYPE_ID = Z0.WORK_EFFORT_ASSOC_TYPE_ID     
     INNER JOIN WORK_EFFORT_TYPE B0 ON B0.WORK_EFFORT_TYPE_ID = A0.WORK_EFFORT_TYPE_ID 
       AND B0.WORK_EFFORT_TYPE_ID = '19PEG11SET' 
     
	 -- servizio
     INNER JOIN WORK_EFFORT_ASSOC Z1 ON Z1.WORK_EFFORT_ID_FROM = A0.WORK_EFFORT_ID
     	AND Z1.WORK_EFFORT_ASSOC_TYPE_ID = '19PEG'
    	AND ( @excludeValidity = 'Y' OR  (@excludeValidity = 'N' AND ( Z1.FROM_DATE <= @monitoringDate AND (Z1.THRU_DATE >= @monitoringDate OR Z1.THRU_DATE IS NULL ))))
     INNER JOIN WORK_EFFORT FIL_W ON FIL_W.WORK_EFFORT_ID = Z1.WORK_EFFORT_ID_TO
     INNER JOIN WORK_EFFORT_ASSOC_TYPE D1 ON D1.WORK_EFFORT_ASSOC_TYPE_ID = Z1.WORK_EFFORT_ASSOC_TYPE_ID     
     INNER JOIN WORK_EFFORT_TYPE B1 ON B1.WORK_EFFORT_TYPE_ID = FIL_W.WORK_EFFORT_TYPE_ID   
     
	 -- processo
     INNER JOIN WORK_EFFORT_ASSOC Z2 ON Z2.WORK_EFFORT_ID_FROM = FIL_W.WORK_EFFORT_ID
     	AND Z2.WORK_EFFORT_ASSOC_TYPE_ID = '19SER'
    	AND ( @excludeValidity = 'Y' OR  (@excludeValidity = 'N' AND ( Z2.FROM_DATE <= @monitoringDate AND (Z2.THRU_DATE >= @monitoringDate OR Z2.THRU_DATE IS NULL ))))
     INNER JOIN WORK_EFFORT A2 ON A2.WORK_EFFORT_ID = Z2.WORK_EFFORT_ID_TO
     INNER JOIN WORK_EFFORT_ASSOC_TYPE D2 ON D2.WORK_EFFORT_ASSOC_TYPE_ID = Z2.WORK_EFFORT_ASSOC_TYPE_ID     
     INNER JOIN WORK_EFFORT_TYPE B2 ON B2.WORK_EFFORT_TYPE_ID = A2.WORK_EFFORT_TYPE_ID
     
    @filterInnerJoin
    @filterLeftJoin
    
     -- descrizione
     LEFT OUTER JOIN WORK_EFFORT_NOTE WN1 ON WN1.WORK_EFFORT_ID = A2.WORK_EFFORT_ID AND WN1.IS_MAIN = 'Y' AND WN1.SEQUENCE_ID = 10 
     LEFT OUTER JOIN NOTE_DATA ND1 ON ND1.NOTE_ID = WN1.NOTE_ID  
     
     -- finalita
     LEFT OUTER JOIN WORK_EFFORT_NOTE WN2 ON WN2.WORK_EFFORT_ID = A2.WORK_EFFORT_ID AND WN2.IS_MAIN = 'Y' AND WN2.SEQUENCE_ID = 20 
     LEFT OUTER JOIN NOTE_DATA ND2 ON ND2.NOTE_ID = WN2.NOTE_ID            
	 	        
      -- responsabile settore
  	 LEFT OUTER JOIN PARTY_RELATIONSHIP P_RESP_A1 ON  P_RESP_A1.PARTY_ID_FROM = A0.ORG_UNIT_ID
     	AND P_RESP_A1.ROLE_TYPE_ID_FROM = A0.ORG_UNIT_ROLE_TYPE_ID
     	AND P_RESP_A1.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
     	AND (@excludeValidity = 'N' OR (@excludeValidity = 'Y' AND P_RESP_A1.THRU_DATE IS NULL))     
     	AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND P_RESP_A1.FROM_DATE <= @monitoringDate AND (P_RESP_A1.THRU_DATE >= @monitoringDate OR P_RESP_A1.THRU_DATE IS NULL) ))
     	LEFT OUTER JOIN PARTY P_A1 ON P_A1.PARTY_ID = P_RESP_A1.PARTY_ID_TO 
     	
      -- responsabile servizio
  	 LEFT OUTER JOIN PARTY_RELATIONSHIP P_RESP_A2 ON  P_RESP_A2.PARTY_ID_FROM = FIL_W.ORG_UNIT_ID
     	AND P_RESP_A2.ROLE_TYPE_ID_FROM = FIL_W.ORG_UNIT_ROLE_TYPE_ID
     	AND P_RESP_A2.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
     	AND (@excludeValidity = 'N' OR (@excludeValidity = 'Y' AND P_RESP_A2.THRU_DATE IS NULL))     
     	AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND P_RESP_A2.FROM_DATE <= @monitoringDate AND (P_RESP_A2.THRU_DATE >= @monitoringDate OR P_RESP_A2.THRU_DATE IS NULL) ))      	

	LEFT OUTER JOIN PARTY P_A2 ON P_A2.PARTY_ID = P_RESP_A2.PARTY_ID_TO
	
	@workEffortChild
	
	
WHERE 0=0
    
  -- valorizzati solo se esistenti
  @workEffortIdPrinc	 
  @workEffortIdChild
  @orgUnitId
  @excludeProcesses
  AND RAD.WORK_EFFORT_REVISION_ID IS NULL
  AND A0.WORK_EFFORT_REVISION_ID IS NULL
  AND FIL_W.WORK_EFFORT_REVISION_ID IS NULL
  AND A2.WORK_EFFORT_REVISION_ID IS NULL
  
  @filterWhere
  ORDER BY Z0.SEQUENCE_NUM

	]]></xml-property>
        </oda-data-set>
