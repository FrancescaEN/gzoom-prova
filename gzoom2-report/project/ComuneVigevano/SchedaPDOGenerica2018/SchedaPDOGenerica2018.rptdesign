                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">PROG_BIL_ETCH</property>
                    <property name="nativeName">PROG_BIL_ETCH</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">MIS_BIL_ETCH</property>
                    <property name="nativeName">MIS_BIL_ETCH</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT
  B.WORK_EFFORT_NAME AS "OB_OP_NAME",
  D.WORK_EFFORT_NAME AS "PROG_BIL_NAME",
  F.WORK_EFFORT_NAME AS "MIS_BIL_NAME",
  G.ETCH AS "OB_OP_ETCH",
  H.ETCH AS "PROG_BIL_ETCH",
  I.ETCH AS "MIS_BIL_ETCH"

FROM WORK_EFFORT_ASSOC A
INNER JOIN WORK_EFFORT B ON B.WORK_EFFORT_ID = A.WORK_EFFORT_ID_FROM
INNER JOIN WORK_EFFORT_ASSOC C ON C.WORK_EFFORT_ID_TO = B.WORK_EFFORT_ID
INNER JOIN WORK_EFFORT D ON D.WORK_EFFORT_ID = C.WORK_EFFORT_ID_FROM
INNER JOIN WORK_EFFORT_ASSOC E ON E.WORK_EFFORT_ID_TO = D.WORK_EFFORT_ID
INNER JOIN WORK_EFFORT F ON F.WORK_EFFORT_ID = E.WORK_EFFORT_ID_FROM
INNER JOIN WORK_EFFORT_TYPE G ON G.WORK_EFFORT_TYPE_ID = B.WORK_EFFORT_TYPE_ID
INNER JOIN WORK_EFFORT_TYPE H ON H.WORK_EFFORT_TYPE_ID = D.WORK_EFFORT_TYPE_ID
INNER JOIN WORK_EFFORT_TYPE I ON I.WORK_EFFORT_TYPE_ID = F.WORK_EFFORT_TYPE_ID
WHERE A.WORK_EFFORT_ID_TO = ?
AND A.WORK_EFFORT_ASSOC_TYPE_ID = '19OBO'
AND C.WORK_EFFORT_ASSOC_TYPE_ID = '19PROC'
AND E.WORK_EFFORT_ASSOC_TYPE_ID = '19BIL'
 ]]></xml-property>
