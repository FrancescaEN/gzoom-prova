            <xml-property name="queryText"><![CDATA[SELECT
  WT.ETCH AS "ETCH_TYPE",
  WE.WORK_EFFORT_ID AS "WORK_EFFORT_ID",
  WE.ETCH AS "ETCH",
  WE.WORK_EFFORT_NAME AS "WORK_EFFORT_NAME",
  WE.ESTIMATED_START_DATE AS "ESTIMATED_START_DATE",
  WE.ESTIMATED_COMPLETION_DATE AS "ESTIMATED_COMPLETION_DATE",
  WE.DESCRIPTION AS "DESCRIPTION",
  ND1.NOTE_NAME AS "ND1_NOTE_NAME",
  ND1.NOTE_INFO AS "ND1_NOTE_INFO",
  ND2.NOTE_NAME AS "ND2_NOTE_NAME",
  ND2.NOTE_INFO AS "ND2_NOTE_INFO"

FROM WORK_EFFORT_ASSOC WA
INNER JOIN WORK_EFFORT WE ON WE.WORK_EFFORT_ID = WA.WORK_EFFORT_ID_TO
INNER JOIN WORK_EFFORT_TYPE WT ON WT.WORK_EFFORT_TYPE_ID = WE.WORK_EFFORT_TYPE_ID
LEFT JOIN WORK_EFFORT_NOTE WN1 ON WN1.WORK_EFFORT_ID = WE.WORK_EFFORT_ID AND WN1.IS_MAIN = 'Y' AND WN1.SEQUENCE_ID = 10
LEFT JOIN NOTE_DATA ND1 ON ND1.NOTE_ID = WN1.NOTE_ID
LEFT JOIN WORK_EFFORT_NOTE WN2 ON WN2.WORK_EFFORT_ID = WE.WORK_EFFORT_ID AND WN2.IS_MAIN = 'Y' AND WN2.SEQUENCE_ID = 20
LEFT JOIN NOTE_DATA ND2 ON ND2.NOTE_ID = WN2.NOTE_ID
WHERE WA.WORK_EFFORT_ID_FROM = ?
AND WA.FROM_DATE <= @monitoringDate AND (WA.THRU_DATE IS NULL OR WA.THRU_DATE >= @monitoringDate)
AND WA.WORK_EFFORT_ASSOC_TYPE_ID = '19SET']]></xml-property>
