            <method name="beforeOpen"><![CDATA[this.queryText = this.queryText.replace("@excludeValidity", "'" + params["excludeValidity"].value+ "'");

this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );

//this.queryText = this.queryText.replace("@monitoringDate",  "'2021-12-31 00:00:00.000'");]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">WORK_EFFORT_ID</property>
                    <property name="nativeName">WORK_EFFORT_ID</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">ETCH</property>
                    <property name="nativeName">ETCH</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">WORK_EFFORT_NAME</property>
                    <property name="nativeName">WORK_EFFORT_NAME</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">PARTY_NAME</property>
                    <property name="nativeName">PARTY_NAME</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
  WE.WORK_EFFORT_ID AS "WORK_EFFORT_ID",
  WE.ETCH AS "ETCH", 
  WE.WORK_EFFORT_NAME AS "WORK_EFFORT_NAME",
  P_RES_A.PARTY_NAME AS "PARTY_NAME"

FROM WORK_EFFORT_ASSOC WA
INNER JOIN WORK_EFFORT WE ON WE.WORK_EFFORT_ID = WA.WORK_EFFORT_ID_TO
LEFT OUTER JOIN PARTY_RELATIONSHIP PR_RES_A
     ON  PR_RES_A.PARTY_ID_FROM  = WE.ORG_UNIT_ID
     AND PR_RES_A.ROLE_TYPE_ID_FROM  = WE.ORG_UNIT_ROLE_TYPE_ID
     AND PR_RES_A.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
	AND (@excludeValidity = 'N' OR (@excludeValidity = 'Y' AND PR_RES_A.THRU_DATE IS NULL))
	AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND(PR_RES_A.FROM_DATE   <= @monitoringDate AND (PR_RES_A.THRU_DATE  >= @monitoringDate OR PR_RES_A.THRU_DATE IS NULL)  )))
LEFT OUTER JOIN PARTY P_RES_A ON P_RES_A.PARTY_ID = PR_RES_A.PARTY_ID_TO
WHERE WA.WORK_EFFORT_ID_FROM = ?
AND WA.WORK_EFFORT_ASSOC_TYPE_ID = '19PEG'
AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND WA.FROM_DATE <= @monitoringDate AND (WA.THRU_DATE >= @monitoringDate OR WA.THRU_DATE IS NULL)))]]></xml-property>
