                        <property name="dataType">integer</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">DESCRIPTION</property>
                    <property name="nativeName">DESCRIPTION</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">PARTY_NAME</property>
                    <property name="nativeName">PARTY_NAME</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT
  R.DESCRIPTION AS "DESCRIPTION",
  P.PARTY_NAME AS "PARTY_NAME"
FROM WORK_EFFORT_PARTY_ASSIGNMENT WP
INNER JOIN PARTY P ON P.PARTY_ID = WP. PARTY_ID
INNER JOIN ROLE_TYPE R ON R.ROLE_TYPE_ID = WP.ROLE_TYPE_ID
WHERE WORK_EFFORT_ID = ? 
	AND R.PARENT_TYPE_ID = 'ORGANIZATION_UNIT'
	AND (WP.FROM_DATE <= ? AND (WP.THRU_DATE >= ? OR WP.THRU_DATE IS NULL))
]]></xml-property>
