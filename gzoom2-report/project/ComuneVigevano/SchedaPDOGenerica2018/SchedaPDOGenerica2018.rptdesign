            <method name="beforeOpen"><![CDATA[this.queryText = this.queryText.replace("@excludeValidity", "'" + params["excludeValidity"].value+ "'");
this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );
//this.queryText = this.queryText.replace("@monitoringDate", "'2021-12-31 00:00:00.000'");

//@workEffortIdChild
var workEffortIdChildString = '';
if (params["workEffortIdChild"].value != null &amp;&amp; params["workEffortIdChild"].value != '') {
	workEffortIdChildString = "AND (A0.WORK_EFFORT_ID = '"+ params["workEffortIdChild"].value + "'";
	workEffortIdChildString += " OR A2.WORK_EFFORT_ID = '"+ params["workEffortIdChild"].value + "'";	
	workEffortIdChildString += " OR FIL_W.WORK_EFFORT_ID = '"+ params["workEffortIdChild"].value + "')";
}
this.queryText = this.queryText.replace("@workEffortIdChild",  workEffortIdChildString );

var workEffortChildString = "LEFT OUTER JOIN WORK_EFFORT W ON W.WORK_EFFORT_ID = ''";
if (params["workEffortIdChild"].value != null &amp;&amp; params["workEffortIdChild"].value != '') {
    workEffortChildString = "LEFT OUTER JOIN WORK_EFFORT W ON W.WORK_EFFORT_ID = '" + params["workEffortIdChild"].value + "'";
}
this.queryText = this.queryText.replace("@workEffortChild",  workEffortChildString );

//@workEffortId
var workEffortIdString = '';
if (params["workEffortId"].value != null &amp;&amp; params["workEffortId"].value != '' &amp;&amp; (params["workEffortIdChild"].value == null &amp;&amp; params["workEffortIdChild"].value == '')) {
	workEffortIdString = "AND RAD.WORK_EFFORT_ID = '"+ params["workEffortId"].value + "'";
}
this.queryText = this.queryText.replace("@workEffortIdPrinc",  workEffortIdString );

//@orgUnitId
var orgUnitIdString = '';
if (params["orgUnitId"].value != null &amp;&amp; params["orgUnitId"].value != '') {
	orgUnitIdString = "AND FIL_W.ORG_UNIT_ID = '"+ params["orgUnitId"].value + "'";
}
this.queryText = this.queryText.replace("@orgUnitId",  orgUnitIdString );

var excludeProcesses = "";
if (params["excludeProcesses"].value == 'Y') {
    excludeProcesses = "AND B2.WORK_EFFORT_TYPE_ID <> '19ORG2DIP'";
}
this.queryText = this.queryText.replace("@excludeProcesses", excludeProcesses);



filter = new com.mapsengineering.base.birt.util.UtilFilter(params["userLoginId"].value, params["localDispatcherName"].value);
var filterInnerJoin = filter.getWorkEffortFilterInner();
var filterLeftJoin = filter.getWorkEffortFilterLeftJoin();
var filterWhere = filter.getWorkEffortFilterWhere();

/*
var filterInnerJoin = "";
var filterLeftJoin = "";
var filterWhere = "";
*/

this.queryText = this.queryText.replace("@filterInnerJoin",  filterInnerJoin );
this.queryText = this.queryText.replace("@filterLeftJoin",  filterLeftJoin );
this.queryText = this.queryText.replace("@filterWhere",  filterWhere );

ReportLog.info("INDEXDS:"+this.queryText);
ReportLog.info("INDEXDS PARAMS :"+this.getInputParameters());]]></method>
