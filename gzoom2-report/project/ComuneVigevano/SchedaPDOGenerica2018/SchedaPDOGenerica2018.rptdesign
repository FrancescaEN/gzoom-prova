            <xml-property name="queryText"><![CDATA[SELECT 
  M_WORK_EFFORT_MEASURE_ID AS "M_WORK_EFFORT_MEASURE_ID", 
  GT.DESCRIPTION AS "DESCRIPTION", 
  G_ACCOUNT_NAME AS "G_ACCOUNT_NAME",
  G_DESCRIPTION AS "G_DESCRIPTION", 
  G_UOM_ABBREVIATION AS "G_UOM_ABBREVIATION", 
  G_DETAIL_ENUM_ID AS "G_DETAIL_ENUM_ID", 
  G_INPUT_ENUM_ID AS "G_INPUT_ENUM_ID", 
  WP.UOM_DESCR AS "UOM_DESCR", 
  WP.COMMENTS AS "COMMENTS", 
  M_UOM_DESCR AS "M_UOM_DESCR", 
  M_COMMENTS AS "M_COMMENTS", 
  V.M_SEQUENCE_ID AS "M_SEQUENCE_ID",
  M_PARTY_NAME AS "DESCRIZIONE_CENTRO_COSTO",  
  M_PARENT_ROLE_CODE AS "CODICE_CENTRO_COSTO",
  V.M_WE_MEASURE_TYPE_ENUM_ID AS "M_WE_MEASURE_TYPE_ENUM_ID",
  V.G_ACCOUNT_CODE AS "G_ACCOUNT_CODE",
  V.G_GL_ACCOUNT_ID AS "G_GL_ACCOUNT_ID",
  V.G_GL_ACCOUNT_TYPE_ID AS "G_GL_ACCOUNT_TYPE_ID",
  V.G_UOM_TYPE_ID AS "G_UOM_TYPE_ID",
  V.W_WORK_EFFORT_TYPE_ID AS "W_WORK_EFFORT_TYPE_ID",
  G_UOM_DECIMAL_SCALE AS "G_UOM_DECIMAL_SCALE",
  WTIC.CONTENT_ID AS "CONTENT_FOLDER_IND",
  WTIC.ETCH AS "ETCH_FOLDER_IND",
  RP.AMOUNT AS "RP_AMOUNT",
  RP2.AMOUNT AS "RP2_AMOUNT",
  COUNT(*) AS "COUNTER",
  MAX(DR.OBJECT_INFO) AS "OBJECT_INFO",
  MAX(DR2.OBJECT_INFO) AS "OBJECT_INFO2",

  MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3103  THEN TT_DESCRIPTION ELSE NULL END)  AS "ACTUAL_ACC_TRN_ABB_3103",
  MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3006  THEN TT_DESCRIPTION ELSE NULL END)  AS "ACTUAL_ACC_TRN_ABB_3006",
  MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3009  THEN TT_DESCRIPTION ELSE NULL END)  AS "ACTUAL_ACC_TRN_ABB_3009",  
  MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112  THEN TT_DESCRIPTION ELSE NULL END)  AS "ACTUAL_ACC_TRN_ABB_3112",
  MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3103  THEN TM_DESCRIPTION ELSE NULL END)  AS "ACTUAL_ACC_TRN_ENTRY_ABB_3103",
  MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3006  THEN TM_DESCRIPTION ELSE NULL END)  AS "ACTUAL_ACC_TRN_ENTRY_ABB_3006",
  MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3009  THEN TM_DESCRIPTION ELSE NULL END)  AS "ACTUAL_ACC_TRN_ENTRY_ABB_3009",  
  MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112  THEN TM_DESCRIPTION ELSE NULL END)  AS "ACTUAL_ACC_TRN_ENTRY_ABB_3112",
  MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112M1  THEN TM_DESCRIPTION ELSE NULL END)  AS "ACTUAL_ACC_TRN_ENTRY_ABB_MENO_UNO",
  MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112M2  THEN TM_DESCRIPTION ELSE NULL END)  AS "ACTUAL_ACC_TRN_ENTRY_ABB_MENO_DUE",

  MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3103  THEN TT_DESCRIPTION ELSE NULL END)  AS "BUDGET_ACC_TRN_ABB_3103",
  MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3006  THEN TT_DESCRIPTION ELSE NULL END)  AS "BUDGET_ACC_TRN_ABB_3006",
  MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3009  THEN TT_DESCRIPTION ELSE NULL END)  AS "BUDGET_ACC_TRN_ABB_3009",  
  MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112  THEN TT_DESCRIPTION ELSE NULL END)  AS "BUDGET_ACC_TRN_ABB_3112",
  MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112P1  THEN TT_DESCRIPTION ELSE NULL END)  AS "BUDGET_ACC_TRN_ABB_3112_PIU_UNO",  
  MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112P2  THEN TT_DESCRIPTION ELSE NULL END)  AS "BUDGET_ACC_TRN_ABB_3112_PIU_DUE",
  MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3103  THEN TM_DESCRIPTION ELSE NULL END)  AS "BUDGET_ACC_TRN_ENTRY_ABB_3103",
  MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3006  THEN TM_DESCRIPTION ELSE NULL END)  AS "BUDGET_ACC_TRN_ENTRY_ABB_3006",
  MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3009  THEN TM_DESCRIPTION ELSE NULL END)  AS "BUDGET_ACC_TRN_ENTRY_ABB_3009",  
  MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112  THEN TM_DESCRIPTION ELSE NULL END)  AS "BUDGET_ACC_TRN_ENTRY_ABB_3112",
  MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112P1  THEN TM_DESCRIPTION ELSE NULL END)  AS "BUDGET_ACC_TRN_ENTRY_ABB_3112_PIU_UNO",
  MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112P2  THEN TM_DESCRIPTION ELSE NULL END)  AS "BUDGET_ACC_TRN_ENTRY_ABB_3112_PIU_DUE",
  MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112M1  THEN TM_DESCRIPTION ELSE NULL END)  AS "BUDGET_ACC_TRN_ENTRY_ABB_3112_MENO_UNO",
  MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112M2  THEN TM_DESCRIPTION ELSE NULL END)  AS "BUDGET_ACC_TRN_ENTRY_ABB_3112_MENO_DUE",

SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112M3  THEN TM_AMOUNT ELSE NULL END)  "ACTUAL_DATO_3112_MENO_TRE",  
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112M2  THEN TM_AMOUNT ELSE NULL END)  "ACTUAL_DATO_3112_MENO_DUE",  
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112M1  THEN TM_AMOUNT ELSE NULL END)  "ACTUAL_DATO_3112_MENO_UNO",
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3103  THEN TM_AMOUNT ELSE NULL END)  "ACTUAL_DATO_3103",
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3006  THEN TM_AMOUNT ELSE NULL END)  "ACTUAL_DATO_3006",   
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3009  THEN TM_AMOUNT ELSE NULL END)  "ACTUAL_DATO_3009",  
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112  THEN TM_AMOUNT ELSE NULL END)  "ACTUAL_DATO_3112",

MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112M3  THEN R_UOM_CODE ELSE NULL END)  "ACTUAL_COD_3112_MENO_TRE",  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112M2  THEN R_UOM_CODE ELSE NULL END)  "ACTUAL_COD_3112_MENO_DUE",  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112M1  THEN R_UOM_CODE ELSE NULL END)  "ACTUAL_COD_3112_MENO_UNO",
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3103  THEN R_UOM_CODE ELSE NULL END)  "ACTUAL_COD_3103",   
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3006  THEN R_UOM_CODE ELSE NULL END)  "ACTUAL_COD_3006", 
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3009  THEN R_UOM_CODE ELSE NULL END)  "ACTUAL_COD_3009",  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112  THEN R_UOM_CODE ELSE NULL END)  "ACTUAL_COD_3112",

MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112M3  THEN R_UOM_CODE ELSE NULL END) "BUDGET_COD_3112_MENO_TRE",  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112M2  THEN R_UOM_CODE ELSE NULL END) "BUDGET_COD_3112_MENO_DUE",  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112M1  THEN R_UOM_CODE ELSE NULL END) "BUDGET_COD_3112_MENO_UNO",
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3103  THEN R_UOM_CODE ELSE NULL END) "BUDGET_COD_3103",  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3006  THEN R_UOM_CODE ELSE NULL END) "BUDGET_COD_3006",    
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3009  THEN R_UOM_CODE ELSE NULL END) "BUDGET_COD_3009",  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112  THEN R_UOM_CODE ELSE NULL END) "BUDGET_COD_3112",
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112P1  THEN R_UOM_CODE ELSE NULL END)  "BUDGET_COD_3112_PIU_UNO",
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112P2  THEN R_UOM_CODE ELSE NULL END)  "BUDGET_COD_3112_PIU_DUE",
 
    SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112M3  THEN TM_AMOUNT ELSE NULL END)  AS "BUDGET_DATO_3112_MENO_TRE",  
    SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112M2  THEN TM_AMOUNT ELSE NULL END)  AS "BUDGET_DATO_3112_MENO_DUE",  
    SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112M1  THEN TM_AMOUNT ELSE NULL END)  AS "BUDGET_DATO_3112_MENO_UNO",
    SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3103  THEN TM_AMOUNT ELSE NULL END)  AS "BUDGET_DATO_3103",
    SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3006  THEN TM_AMOUNT ELSE NULL END)  AS "BUDGET_DATO_3006",  
    SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3009  THEN TM_AMOUNT ELSE NULL END)  AS "BUDGET_DATO_3009",  
    SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112  THEN TM_AMOUNT ELSE NULL END)  AS "BUDGET_DATO_3112",
    SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112P1  THEN TM_AMOUNT ELSE NULL END)  AS "BUDGET_DATO_3112_PIU_UNO",  
    SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112P2  THEN TM_AMOUNT ELSE NULL END)  AS "BUDGET_DATO_3112_PIU_DUE"

FROM     WORK_EFFORT_TRANS_INDIC_VIEW V
INNER JOIN ENUMERATION E ON V.M_WE_MEASURE_TYPE_ENUM_ID = E.ENUM_ID        
INNER JOIN WORK_EFFORT_TYPE WT ON WT.WORK_EFFORT_TYPE_ID = V.W_WORK_EFFORT_TYPE_ID
INNER JOIN WORK_EFFORT_TYPE_CONTENT WTIC ON WTIC.WORK_EFFORT_TYPE_ID = WT.WORK_EFFORT_TYPE_ID
INNER JOIN WORK_EFFORT_PURPOSE_ACCOUNT WA ON WA.GL_ACCOUNT_ID = V.G_GL_ACCOUNT_ID
	AND WA.WORK_EFFORT_PURPOSE_TYPE_ID =  WTIC.WORK_EFFORT_PURPOSE_TYPE_ID
INNER JOIN GL_ACCOUNT_TYPE GT ON GT.GL_ACCOUNT_TYPE_ID = V.G_GL_ACCOUNT_TYPE_ID   

LEFT OUTER JOIN 
	( SELECT WM.GL_ACCOUNT_ID, PR.INTERNAL_NAME, PR.PRODUCT_ID, WM.UOM_DESCR, WM.COMMENTS
	FROM WORK_EFFORT_MEASURE WM
	INNER JOIN PRODUCT PR ON PR.PRODUCT_ID = WM.PRODUCT_ID
	WHERE WM.WORK_EFFORT_ID IS NULL) WP
	ON WP.GL_ACCOUNT_ID = M_GL_ACCOUNT_ID AND WP.PRODUCT_ID = M_PRODUCT_ID
	
LEFT JOIN (																											
	SELECT TP.VOUCHER_REF, TP.TRANSACTION_DATE, EP.AMOUNT																										
	FROM ACCTG_TRANS TP																										
		INNER JOIN ACCTG_TRANS_ENTRY EP ON EP.ACCTG_TRANS_ID = TP.ACCTG_TRANS_ID																									
	WHERE EP.GL_ACCOUNT_ID = 'SCOREKPI'  AND EP.GL_FISCAL_TYPE_ID = 'ACTUAL'																									
	) RP ON RP.VOUCHER_REF = M_WORK_EFFORT_MEASURE_ID  AND RP.TRANSACTION_DATE = @monitoringDate
	
LEFT JOIN (																											
	SELECT TP2.WORK_EFFORT_ID, TP2.VOUCHER_REF, TP2.TRANSACTION_DATE, EP2.AMOUNT																										
	FROM ACCTG_TRANS TP2																										
		INNER JOIN ACCTG_TRANS_ENTRY EP2 ON EP2.ACCTG_TRANS_ID = TP2.ACCTG_TRANS_ID																									
	WHERE EP2.GL_ACCOUNT_ID = 'SCORE'																									
	) RP2 ON RP2.WORK_EFFORT_ID = M_WORK_EFFORT_ID  AND RP2.TRANSACtION_DATE = @monitoringDate
	
LEFT OUTER JOIN UOM_RANGE_VALUES VP ON VP.FROM_VALUE <= RP.AMOUNT AND VP.THRU_VALUE >= RP.AMOUNT and VP.UOM_RANGE_ID = WT.UOM_RANGE_SCORE_ID
LEFT OUTER JOIN ENUMERATION CP ON CP.ENUM_ID = VP.COLOR_ENUM_ID
LEFT OUTER JOIN CONTENT IP ON IP.CONTENT_ID = VP.ICON_CONTENT_ID
LEFT OUTER JOIN DATA_RESOURCE DR ON DR.DATA_RESOURCE_ID = IP.DATA_RESOURCE_ID

LEFT OUTER JOIN UOM_RANGE_VALUES VP2 ON VP2.FROM_VALUE <= RP2.AMOUNT AND VP2.THRU_VALUE >= RP2.AMOUNT and VP2.UOM_RANGE_ID = WT.UOM_RANGE_SCORE_ID
LEFT OUTER JOIN ENUMERATION CP2 ON CP2.ENUM_ID = VP2.COLOR_ENUM_ID
LEFT OUTER JOIN CONTENT IP2 ON IP2.CONTENT_ID = VP2.ICON_CONTENT_ID
LEFT OUTER JOIN DATA_RESOURCE DR2 ON DR2.DATA_RESOURCE_ID = IP2.DATA_RESOURCE_ID		
	
WHERE M_WORK_EFFORT_ID = ? AND  (V.M_THRU_DATE >= @date0101 AND V.M_FROM_DATE <= @date3112) 
	  AND G_WORK_EFFORT_SNAPSHOT_ID IS NULL 
	  AND WA.WORK_EFFORT_PURPOSE_TYPE_ID not in ('CA_TOT','CA_ID','CA_DET')
	  AND V.G_GL_ACCOUNT_TYPE_ID <> 'PESOBI'
GROUP BY  GT.DESCRIPTION, G_ACCOUNT_NAME, G_DESCRIPTION, G_UOM_ABBREVIATION, V.M_WE_MEASURE_TYPE_ENUM_ID,V.G_ACCOUNT_CODE, V.G_GL_ACCOUNT_ID ,
M_WORK_EFFORT_MEASURE_ID,G_DETAIL_ENUM_ID,G_INPUT_ENUM_ID, WP.UOM_DESCR, WP.COMMENTS, M_UOM_DESCR, M_COMMENTS, V.M_SEQUENCE_ID,
M_PARTY_NAME,  M_PARENT_ROLE_CODE, V.G_ACCOUNT_CODE, V.W_WORK_EFFORT_TYPE_ID, V.G_GL_ACCOUNT_ID , V.G_UOM_TYPE_ID, G_UOM_DECIMAL_SCALE,
WTIC.CONTENT_ID, WTIC.ETCH, V.G_GL_ACCOUNT_TYPE_ID, RP.AMOUNT, RP2.AMOUNT

ORDER BY    
 V.M_WE_MEASURE_TYPE_ENUM_ID,
  V.G_ACCOUNT_CODE,
  V.G_GL_ACCOUNT_ID ,
  V.M_WORK_EFFORT_MEASURE_ID]]></xml-property>
