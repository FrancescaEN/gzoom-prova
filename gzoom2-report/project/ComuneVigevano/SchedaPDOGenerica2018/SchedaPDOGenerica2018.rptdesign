                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">WORK_EFFORT_NAME</property>
                    <property name="nativeName">WORK_EFFORT_NAME</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">COMMENTS</property>
                    <property name="nativeName">COMMENTS</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">W2_WORK_EFFORT_NAME</property>
                    <property name="nativeName">W2_WORK_EFFORT_NAME</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">WT_ETCH</property>
                    <property name="nativeName">WT_ETCH</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT
  WA.WORK_EFFORT_ID_TO AS "WORK_EFFORT_ID_TO",
  W.ETCH AS "ETCH",
  W.WORK_EFFORT_NAME AS "WORK_EFFORT_NAME",
  WTA.COMMENTS AS "COMMENTS",
  W2.WORK_EFFORT_NAME AS "W2_WORK_EFFORT_NAME",
  WT.ETCH AS "WT_ETCH"

FROM WORK_EFFORT_ASSOC WA
INNER JOIN WORK_EFFORT_ASSOC_TYPE WET ON WET.WORK_EFFORT_ASSOC_TYPE_ID = WA.WORK_EFFORT_ASSOC_TYPE_ID
		 -- AND ((WET.PARENT_TYPE_ID <> 'HIE'  AND WET.PARENT_TYPE_ID <> 'TECHNICAL' ) OR WET.PARENT_TYPE_ID IS NULL)
INNER JOIN WORK_EFFORT W ON W.WORK_EFFORT_ID = WA. WORK_EFFORT_ID_FROM
INNER JOIN WORK_EFFORT_TYPE_ASSOC WTA ON WTA.WORK_EFFORT_ASSOC_TYPE_ID = WA.WORK_EFFORT_ASSOC_TYPE_ID
INNER JOIN WORK_EFFORT_ASSOC WA2 ON WA2.WORK_EFFORT_ID_TO = W.WORK_EFFORT_ID
INNER JOIN WORK_EFFORT W2 ON W2.WORK_EFFORT_ID = WA2.WORK_EFFORT_ID_FROM
INNER JOIN WORK_EFFORT_TYPE WT ON WT.WORK_EFFORT_TYPE_ID = W2.WORK_EFFORT_TYPE_ID
	
WHERE WA.WORK_EFFORT_ID_TO = ?
	AND WTA.WEFROM_WETO_ENUM_ID = 'WETATO' 
	AND WTA.WORK_EFFORT_TYPE_ID = ?
	AND WT.IS_ROOT = 'N'
	AND (WA.FROM_DATE <= ? AND (WA.THRU_DATE >= ? OR WA.THRU_DATE IS NULL))
	AND WA.WORK_EFFORT_ASSOC_TYPE_ID = ?]]></xml-property>
        </oda-data-set>
