        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="LineaGuidaWithAssocTypeDS" id="56645">
            <list-property name="computedColumns">
                <structure>
                    <property name="name">TITLE</property>
                    <expression name="expression">row["ETCH"] != null &amp;&amp; row["ETCH"] != '' ? row["ETCH"] + " - " + row["WORK_EFFORT_NAME"] : row["WORK_EFFORT_NAME"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">COUNTER</property>
                    <property name="dataType">integer</property>
                    <property name="aggregateFunction">COUNT</property>
                    <list-property name="arguments">
                        <structure>
                            <property name="name">Expression</property>
                            <expression name="value">row["WORK_EFFORT_NAME"]</expression>
                        </structure>
                    </list-property>
                </structure>
            </list-property>
            <list-property name="columnHints">
                <structure>
                    <property name="columnName">WORK_EFFORT_ID_TO</property>
                    <property name="analysis">dimension</property>
                    <text-property name="displayName">WORK_EFFORT_ID_TO</text-property>
                    <text-property name="heading">WORK_EFFORT_ID_TO</text-property>
                </structure>
