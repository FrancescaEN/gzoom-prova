            <xml-property name="queryText"><![CDATA[SELECT
	MAX( WS.STATUS_DATETIME ) AS "STATUS_DATE"
FROM
	WORK_EFFORT_STATUS WS
INNER JOIN STATUS_ITEM WSI ON
	WSI.STATUS_ID = WS.STATUS_ID
WHERE
	WSI.SEQUENCE_ID = '40'
	AND WS.WORK_EFFORT_ID =?
GROUP BY
	WS.WORK_EFFORT_ID
]]></xml-property>
        </oda-data-set>
