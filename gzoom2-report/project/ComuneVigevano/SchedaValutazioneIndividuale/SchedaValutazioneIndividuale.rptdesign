                    <expression name="valueExpr">if (BirtComp.equalTo(params["monitoringDate"].value, params["date0101"].value )) {&#13;
    reportContext.getMessage('DUP', reportContext.getLocale()) + " "&#13;
    +BirtDateTime.year(params["monitoringDate"].value) + " - "&#13;
    +(BirtDateTime.year(params["monitoringDate"].value) + 2)&#13;
} else {&#13;
    reportContext.getMessage('Monitoraggio', reportContext.getLocale()) + " "&#13;
    +reportContext.getMessage('al', reportContext.getLocale()) + "  "&#13;
    +Formatter.format(params["monitoringDate"].value, reportContext.getMessage('date_pattern', reportContext.getLocale())) + " "&#13;
    + reportContext.getMessage('DUP', reportContext.getLocale()) + " "&#13;
