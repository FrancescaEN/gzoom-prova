            <xml-property name="queryText"><![CDATA[SELECT 
PE.PARTY_NAME AS "VALUT_DENOMINAZIONE", 
AM.WORK_EFFORT_ID AS "WORK_EFFORT_ID",
ET.DESCRIPTION AS "VALUT_CATEGORIA",
PR.PARTY_NAME AS "VALUT_PROFILO",
STAT.SEQUENCE_ID AS "STATO_SEQUENZA",
SU.PARTY_NAME AS "SUPORG_DENOMINAZIONE",
DI.PARTY_NAME AS "SUPORG_RESPONSABILE",
UO.PARTY_NAME AS "ORGUNIT_DENOMINAZIONE",
RE.PARTY_NAME AS "ORGUNIT_RESPONSABILE",
SCAE.AMOUNT AS "VALUT_SCORE", 
MOS.COMMENTS AS "VALUT_GIUDIZIO",
GGAE.AMOUNT AS "GIORNI_PRESENZA",
AM.WORK_EFFORT_NAME AS "AMBI_TITOLO",
NA.DESCRIPTION AS "ELEM_NATURA",
EL.ACCOUNT_NAME AS "ELEM_TITOLO",
ELM.KPI_SCORE_WEIGHT AS "ELEM_PESO",
ELCO.UOM_CODE AS "ELEM_CODICE",
ELAE.AMOUNT AS "ELEM_VALORE",
ELM.SEQUENCE_ID AS "SEQUENCE_ID", 
UOM.UOM_TYPE_ID AS "ELEM_UOMTYPE",
FIL_W.WORK_EFFORT_ID AS "WORK_EFFORT_ID_PRINC",
ELAE.AMOUNT * ELM.KPI_SCORE_WEIGHT / 100 AS "ELEM_TOTALE"
FROM WORK_EFFORT FIL_W
INNER JOIN STATUS_ITEM STAT ON STAT.STATUS_ID = FIL_W.CURRENT_STATUS_ID
INNER JOIN WORK_EFFORT_TYPE ST ON ST.WORK_EFFORT_TYPE_ID = FIL_W.WORK_EFFORT_TYPE_ID
INNER JOIN WORK_EFFORT_PARTY_ASSIGNMENT WP ON WP.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
  AND WP.ROLE_TYPE_ID = 'WEM_EVAL_IN_CHARGE'
INNER JOIN PARTY PE ON PE.PARTY_ID = WP.PARTY_ID
LEFT JOIN PARTY_RELATIONSHIP PEPR ON PEPR.PARTY_ID_FROM = PE.PARTY_ID
  AND PEPR.PARTY_RELATIONSHIP_TYPE_ID = 'QUALIF'
  AND PEPR.FROM_DATE <= FIL_W.ESTIMATED_COMPLETION_DATE
  AND (PEPR.THRU_DATE IS NULL OR PEPR.THRU_DATE >= FIL_W.ESTIMATED_COMPLETION_DATE)
LEFT JOIN PARTY PR ON PEPR.PARTY_ID_TO IS NOT NULL
 AND PR.PARTY_ID = PEPR.PARTY_ID_TO
INNER JOIN PERSON PN ON PN.PARTY_ID = PE.PARTY_ID
INNER JOIN EMPL_POSITION_TYPE ET ON ET.EMPL_POSITION_TYPE_ID = PN.EMPL_POSITION_TYPE_ID
INNER JOIN PARTY UO ON UO.PARTY_ID = FIL_W.ORG_UNIT_ID
LEFT JOIN PARTY_RELATIONSHIP UORE ON UORE.PARTY_ID_FROM = UO.PARTY_ID
  AND UORE.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
  AND UORE.FROM_DATE <= FIL_W.ESTIMATED_COMPLETION_DATE
  AND (UORE.THRU_DATE IS NULL OR UORE.THRU_DATE >= FIL_W.ESTIMATED_COMPLETION_DATE)
LEFT JOIN PARTY RE ON UORE.PARTY_ID_TO IS NOT NULL
 AND RE.PARTY_ID = UORE.PARTY_ID_TO
INNER JOIN PARTY_RELATIONSHIP SUUO ON SUUO.PARTY_ID_TO = UO.PARTY_ID
  AND SUUO.PARTY_RELATIONSHIP_TYPE_ID = 'GROUP_ROLLUP'
  AND SUUO.FROM_DATE <= FIL_W.ESTIMATED_COMPLETION_DATE
  AND (SUUO.THRU_DATE IS NULL OR SUUO.THRU_DATE >= FIL_W.ESTIMATED_COMPLETION_DATE)
INNER JOIN PARTY SU ON SU.PARTY_ID = SUUO.PARTY_ID_FROM
LEFT JOIN PARTY_RELATIONSHIP SUDI ON SUDI.PARTY_ID_FROM = SU.PARTY_ID
  AND SUDI.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
  AND SUDI.FROM_DATE <= FIL_W.ESTIMATED_COMPLETION_DATE
  AND (SUDI.THRU_DATE IS NULL OR SUDI.THRU_DATE >= FIL_W.ESTIMATED_COMPLETION_DATE)
LEFT JOIN PARTY DI ON SUDI.PARTY_ID_TO IS NOT NULL
 AND DI.PARTY_ID = SUDI.PARTY_ID_TO
LEFT JOIN WORK_EFFORT_MEASURE SCM ON SCM.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
  AND SCM.GL_ACCOUNT_ID = 'SCORE'
LEFT JOIN ACCTG_TRANS SCAT ON SCM.WORK_EFFORT_MEASURE_ID IS NOT NULL
  AND SCAT.VOUCHER_REF = SCM.WORK_EFFORT_MEASURE_ID
  AND SCAT.TRANSACTION_DATE = @date3112
LEFT JOIN ACCTG_TRANS_ENTRY SCAE ON SCAT.ACCTG_TRANS_ID IS NOT NULL
  AND SCAE.ACCTG_TRANS_ID = SCAT.ACCTG_TRANS_ID
LEFT JOIN UOM_RANGE_VALUES MOS ON SCAE.AMOUNT IS NOT NULL
  AND MOS.UOM_RANGE_ID = ST.UOM_RANGE_SCORE_ID
  AND MOS.FROM_VALUE <= SCAE.AMOUNT
  AND MOS.THRU_VALUE >= SCAE.AMOUNT
LEFT JOIN CONTENT COS ON MOS.ICON_CONTENT_ID IS NOT NULL
  AND COS.CONTENT_ID = MOS.ICON_CONTENT_ID
LEFT JOIN DATA_RESOURCE DRS ON COS.DATA_RESOURCE_ID IS NOT NULL
  AND DRS.DATA_RESOURCE_ID = COS.DATA_RESOURCE_ID
INNER JOIN WORK_EFFORT_ASSOC SCAM ON SCAM.WORK_EFFORT_ID_FROM = FIL_W.WORK_EFFORT_ID
  AND SCAM.WORK_EFFORT_ASSOC_TYPE_ID = '20C20SCH'
INNER JOIN WORK_EFFORT AM ON AM.WORK_EFFORT_ID = SCAM.WORK_EFFORT_ID_TO
@filterInnerJoin
@filterLeftJoin
LEFT JOIN WORK_EFFORT_MEASURE WMG ON WMG.WORK_EFFORT_ID = AM.WORK_EFFORT_ID
  AND WMG.WE_MEASURE_TYPE_ENUM_ID = 'WEMT_OUTPUT'
LEFT JOIN ACCTG_TRANS_ENTRY GGAE ON WMG.WORK_EFFORT_MEASURE_ID IS NOT NULL
  AND GGAE.VOUCHER_REF = WMG.WORK_EFFORT_MEASURE_ID
LEFT JOIN ACCTG_TRANS GGAT ON GGAE.ACCTG_TRANS_ID IS NOT NULL
  AND GGAT.ACCTG_TRANS_ID = GGAE.ACCTG_TRANS_ID
  AND GGAT.TRANSACTION_DATE = @date3112 
LEFT JOIN WORK_EFFORT_MEASURE ELM ON ELM.WORK_EFFORT_ID = AM.WORK_EFFORT_ID
  AND ELM.WE_MEASURE_TYPE_ENUM_ID = 'WEMT_PERF'
LEFT JOIN GL_ACCOUNT EL ON ELM.GL_ACCOUNT_ID IS NOT NULL
  AND EL.GL_ACCOUNT_ID = ELM.GL_ACCOUNT_ID 
LEFT JOIN UOM ON  EL.DEFAULT_UOM_ID IS NOT NULL
  AND UOM.UOM_ID = EL.DEFAULT_UOM_ID
LEFT JOIN GL_RESOURCE_TYPE NA ON EL.GL_ACCOUNT_TYPE_ID IS NOT NULL
  AND NA.GL_RESOURCE_TYPE_ID = EL.GL_RESOURCE_TYPE_ID 
LEFT JOIN ACCTG_TRANS_ENTRY ELAE ON ELM.WORK_EFFORT_MEASURE_ID IS NOT NULL
  AND ELAE.VOUCHER_REF = ELM.WORK_EFFORT_MEASURE_ID
  AND ELAE.GL_ACCOUNT_ID <> 'SCOREKPI'
LEFT JOIN ACCTG_TRANS ELAT ON ELAE.ACCTG_TRANS_ID IS NOT NULL
  AND ELAT.ACCTG_TRANS_ID = ELAE.ACCTG_TRANS_ID
  AND ELAT.TRANSACTION_DATE = @date3112 
LEFT JOIN WORK_EFFORT_MEAS_RAT_SC ELCO ON ELM.WORK_EFFORT_MEASURE_ID IS NOT NULL
  AND ELAE.AMOUNT IS NOT NULL
  AND UOM.UOM_TYPE_ID = 'RATING_SCALE'
  AND ELCO.WORK_EFFORT_MEASURE_ID = ELM.WORK_EFFORT_MEASURE_ID
  AND ELCO.UOM_RATING_VALUE = ELAE.AMOUNT
WHERE FIL_W.ESTIMATED_START_DATE <= @date3112 
  AND FIL_W.ESTIMATED_COMPLETION_DATE >= @date0101 
  AND (UOM.UOM_TYPE_ID IS NULL OR UOM.UOM_TYPE_ID <> 'RATING_SCALE'
    OR (UOM.UOM_TYPE_ID IS NOT NULL AND UOM.UOM_TYPE_ID = 'RATING_SCALE' AND ELCO.UOM_CODE IS NOT NULL))
    @workEffortTypeId
    @workEffortId
    @orgUnitId
    @filterWhere 
ORDER BY ELM.SEQUENCE_ID, PE.PARTY_NAME, SCAM.SEQUENCE_NUM]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="DataPresaVisioneDS" id="57167">
