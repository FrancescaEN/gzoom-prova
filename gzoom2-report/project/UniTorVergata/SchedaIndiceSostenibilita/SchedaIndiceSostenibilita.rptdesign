                                                            <expression name="valueExpr">importPackage(Packages.com.mapsengineering.base.birt.util);&#13;
if (row["UOM_TYPE_ID"] == 'RATING_SCALE') {&#13;
	row["ACTUAL_DATE"]&#13;
} else if (row["UOM_TYPE_ID"] == 'DATE_MEASURE') {&#13;
	UtilDateTime.numberConvertToDate(row["ACTUAL_DATE"], reportContext.getLocale());&#13;
} else {&#13;
	row["ACTUAL_DATE"] != null ? Formatter.format(BirtStr.indexOf("%",row["FORMAT"],0) != -1 ? row["ACTUAL_DATE"]/100 : row["ACTUAL_DATE"], row["FORMAT"]) : '';&#13;
}</expression>
