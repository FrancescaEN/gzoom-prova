            <xml-property name="queryText"><![CDATA[SELECT
   WM.WORK_EFFORT_MEASURE_ID AS "WORK_EFFORT_MEASURE_ID",
   WM.GL_ACCOUNT_ID AS "GL_ACCOUNT_ID",
   GL.ACCOUNT_NAME AS "ACCOUNT_NAME",
   WM.KPI_SCORE_WEIGHT AS "KPI_SCORE_WEIGHT",
   U.ABBREVIATION AS "ABBREVIATION",
   GL.INPUT_ENUM_ID AS "INPUT_ENUM_ID",
   WM.UOM_DESCR AS "UOM_DESCR",
   U.UOM_TYPE_ID AS "UOM_TYPE_ID",
   U.DECIMAL_SCALE AS "DECIMAL_SCALE",
   SUM(CASE WHEN AT.GL_FISCAL_TYPE_ID = 'BUDGET' AND GL.GL_ACCOUNT_ID <> 'SCOREKPI' AND AT.TRANSACTION_DATE = @monitoringDate THEN AE.AMOUNT ELSE NULL END) AS "BUDGET_DATE",
   SUM(CASE WHEN AT.GL_FISCAL_TYPE_ID = 'ACTUAL_SOST' AND GL.GL_ACCOUNT_ID <> 'SCOREKPI' AND AT.TRANSACTION_DATE = @monitoringDate THEN AE.AMOUNT ELSE NULL END) AS "ACTUAL_DATE",
   MAX(AE2.AMOUNT) AS "VALUTAZIONE_DATE",
   MAX(EP.OBJECT_INFO) AS "OBJECT_INFO"
FROM WORK_EFFORT_MEASURE WM
LEFT OUTER JOIN WORK_EFFORT W ON W.WORK_EFFORT_ID = WM.WORK_EFFORT_ID
LEFT OUTER JOIN WORK_EFFORT_TYPE WT ON WT.WORK_EFFORT_TYPE_ID = W.WORK_EFFORT_TYPE_ID
LEFT OUTER JOIN ACCTG_TRANS_ENTRY AE ON AE.GL_ACCOUNT_ID = WM.GL_ACCOUNT_ID
LEFT OUTER JOIN ACCTG_TRANS AT ON AT.ACCTG_TRANS_ID = AE.ACCTG_TRANS_ID
LEFT OUTER JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = WM.GL_ACCOUNT_ID AND GL.GL_ACCOUNT_ID <> 'SCOREKPI'
LEFT OUTER JOIN UOM U ON U.UOM_ID = GL.DEFAULT_UOM_ID
LEFT OUTER JOIN ACCTG_TRANS AT2 ON AT2.TRANSACTION_DATE = @monitoringDate 
AND AT2.VOUCHER_REF = WM.WORK_EFFORT_MEASURE_ID 
AND AT2.ACCTG_TRANS_TYPE_ID = 'SCOREKPI' 
AND AT2.GL_FISCAL_TYPE_ID = 'ACTUAL_SOST'
LEFT OUTER JOIN ACCTG_TRANS_ENTRY AE2 ON AE2.ACCTG_TRANS_ID = AT2.ACCTG_TRANS_ID
LEFT OUTER JOIN UOM_RANGE_VALUES VP ON VP.FROM_VALUE <= AE2.AMOUNT AND VP.THRU_VALUE >= AE2.AMOUNT and VP.UOM_RANGE_ID = WT.UOM_RANGE_SCORE_ID
LEFT OUTER JOIN ENUMERATION CP ON CP.ENUM_ID = VP.COLOR_ENUM_ID
LEFT OUTER JOIN CONTENT IP ON IP.CONTENT_ID = VP.ICON_CONTENT_ID
LEFT OUTER JOIN DATA_RESOURCE EP ON EP.DATA_RESOURCE_ID = IP.DATA_RESOURCE_ID
WHERE WM.WORK_EFFORT_ID = ?
AND GL.GL_ACCOUNT_ID <> 'SCORE'
GROUP BY
   WM.WORK_EFFORT_MEASURE_ID,
   WM.GL_ACCOUNT_ID,
   GL.ACCOUNT_NAME,
   WM.KPI_SCORE_WEIGHT,
   U.ABBREVIATION,
   GL.INPUT_ENUM_ID,
   WM.UOM_DESCR,
   U.UOM_TYPE_ID,
   U.DECIMAL_SCALE
ORDER BY GL.ACCOUNT_NAME

]]></xml-property>
