            <xml-property name="queryText"><![CDATA[SELECT 
	   RAD.WORK_EFFORT_NAME AS "TITLE", 
	   RAD.ETCH AS "ETCH", 
	   RAT.ETCH AS "RAD_TITOLO_ETCH", 
	   RAD.WORK_EFFORT_ID AS "ID_RAD", 
	   RADTC.ETCH AS "RAD_TITOLO",
	   B0.ETCH AS "ETICHETTA0", 
	   FIL_W.ETCH AS "ETCH0", 
	   FIL_W.WORK_EFFORT_NAME AS "NAME0", 
	   Z0.SEQUENCE_NUM AS "SEQ0", 
	   FIL_W.WORK_EFFORT_ID AS "ID0", 
	   FIL_W.DESCRIPTION AS "DESCRIPTION0", 
	   Z0.ASSOC_WEIGHT AS "ASSOC_WEIGHT0", 
	   FIL_W.SOURCE_REFERENCE_ID AS "CODE0", 
       P_A1.PARTY_NAME AS "RESPONSABILE1",
	   P_STRUT.PARTY_NAME AS "STRUTTURA",
	   R_STRUT.DESCRIPTION AS "TIPO_STRUTTURA",
	   PPR3.PARENT_ROLE_CODE AS "CODICE_STRUTTURA",
	   IRAD.AMOUNT AS "AMOUNT_RAD",
	   I0.AMOUNT AS "AMOUNT0",
	   ND.NOTE_INFO AS "NOTE_INFO"
	   
	     
FROM WORK_EFFORT RAD
	 INNER JOIN WORK_EFFORT_TYPE RAT ON RAT.WORK_EFFORT_TYPE_ID = RAD.WORK_EFFORT_TYPE_ID	
	 INNER JOIN WORK_EFFORT_TYPE_CONTENT RADTC ON RADTC.WORK_EFFORT_TYPE_ID = RAD.WORK_EFFORT_TYPE_ID
		AND RADTC.CONTENT_ID = ?
	
	 -- aree strategiche
	 INNER JOIN WORK_EFFORT_ASSOC Z0 ON Z0.WORK_EFFORT_ID_FROM = RAD.WORK_EFFORT_ID
	 	AND Z0.WORK_EFFORT_ASSOC_TYPE_ID = RAT.HIERARCHY_ASSOC_TYPE_ID
	 	AND ( @excludeValidity = 'Y' OR  (@excludeValidity = 'N' AND ( Z0.FROM_DATE <= @monitoringDate AND (Z0.THRU_DATE >= @monitoringDate OR Z0.THRU_DATE IS NULL ))))	 			
     INNER JOIN WORK_EFFORT FIL_W ON FIL_W.WORK_EFFORT_ID = Z0.WORK_EFFORT_ID_TO
     INNER JOIN WORK_EFFORT_ASSOC_TYPE D0 ON D0.WORK_EFFORT_ASSOC_TYPE_ID = Z0.WORK_EFFORT_ASSOC_TYPE_ID     
     INNER JOIN WORK_EFFORT_TYPE B0 ON B0.WORK_EFFORT_TYPE_ID = FIL_W.WORK_EFFORT_TYPE_ID     

@filterInnerJoin
@filterLeftJoin
	 	        
      -- responsabile
  	 LEFT OUTER JOIN PARTY_RELATIONSHIP P_RESP_A1 ON  P_RESP_A1.PARTY_ID_FROM = FIL_W.ORG_UNIT_ID
     	AND P_RESP_A1.ROLE_TYPE_ID_FROM = FIL_W.ORG_UNIT_ROLE_TYPE_ID
     	AND P_RESP_A1.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
     	AND (@excludeValidity = 'N' OR (@excludeValidity = 'Y' AND P_RESP_A1.THRU_DATE IS NULL))     
     	AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND P_RESP_A1.FROM_DATE <= @monitoringDate AND (P_RESP_A1.THRU_DATE >= @monitoringDate OR P_RESP_A1.THRU_DATE IS NULL) )) 

	LEFT OUTER JOIN PARTY P_A1 ON P_A1.PARTY_ID = P_RESP_A1.PARTY_ID_TO
	
	-- STRUTTURA
	LEFT OUTER JOIN PARTY P_STRUT ON P_STRUT.PARTY_ID = FIL_W.ORG_UNIT_ID
	LEFT OUTER JOIN ROLE_TYPE R_STRUT ON R_STRUT.ROLE_TYPE_ID = FIL_W.ORG_UNIT_ROLE_TYPE_ID
	LEFT OUTER JOIN PARTY_PARENT_ROLE PPR3 ON PPR3.PARTY_ID = P_STRUT.PARTY_ID
	  AND PPR3.ROLE_TYPE_ID = 'ORGANIZATION_UNIT'
	  
	LEFT OUTER JOIN (
      SELECT Q.WORK_EFFORT_ID, Q.TRANSACTION_DATE, R.AMOUNT
      FROM ACCTG_TRANS Q 
      INNER JOIN ACCTG_TRANS_ENTRY R ON Q.ACCTG_TRANS_ID = R.ACCTG_TRANS_ID
      WHERE R.GL_ACCOUNT_ID = 'SCORE' AND R.GL_FISCAL_TYPE_ID = 'ACTUAL'
    ) IRAD ON IRAD.WORK_EFFORT_ID = RAD.WORK_EFFORT_ID AND IRAD.TRANSACTION_DATE = @monitoringDate	  
	  
	LEFT OUTER JOIN (
      SELECT Q.WORK_EFFORT_ID, Q.TRANSACTION_DATE, R.AMOUNT
      FROM ACCTG_TRANS Q 
      INNER JOIN ACCTG_TRANS_ENTRY R ON Q.ACCTG_TRANS_ID = R.ACCTG_TRANS_ID
      WHERE R.GL_ACCOUNT_ID = 'SCORE' AND R.GL_FISCAL_TYPE_ID = 'ACTUAL'
    ) I0 ON I0.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID AND I0.TRANSACTION_DATE = @monitoringDate
    
    LEFT OUTER JOIN WORK_EFFORT_NOTE WN ON WN.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID AND WN.IS_MAIN = 'Y'
    LEFT OUTER JOIN NOTE_DATA ND ON ND.NOTE_ID = WN.NOTE_ID 
	
WHERE 0=0
    
  -- valorizzati solo se esistenti
  @workEffortIdChild
  @workEffortId	 
  
  @filterWhere
  
  AND RAD.WORK_EFFORT_REVISION_ID IS NULL
  AND FIL_W.WORK_EFFORT_REVISION_ID IS NULL
  ORDER BY Z0.SEQUENCE_NUM
]]></xml-property>
        </oda-data-set>
