                                                        <text-data id="57256">
                                                            <property name="textAlign">center</property>
                                                            <expression name="valueExpr">importPackage(Packages.com.mapsengineering.base.birt.util);&#13;
if (row["UOM_TYPE_ID"] == 'RATING_SCALE') {&#13;
	row["BUDGET_DATE"]&#13;
} else if (row["UOM_TYPE_ID"] == 'DATE_MEASURE') {&#13;
	UtilDateTime.numberConvertToDate(row["BUDGET_DATE"], reportContext.getLocale());&#13;
} else {&#13;
	row["BUDGET_DATE"] != null ? Formatter.format(BirtStr.indexOf("%",row["FORMAT"],0) != -1 ? row["BUDGET_DATE"]/100 : row["BUDGET_DATE"], row["FORMAT"]) : '';&#13;
}</expression>
