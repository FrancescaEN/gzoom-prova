            <method name="beforeOpen"><![CDATA[
//this.queryText = this.queryText.replace("@monitoringDate",  "and w.data_valutazione = '2019-06-30 00:00:00+02'" );
var monitoringDateStr = "and w.data_valutazione = " +params["monitoringDateSql"].value;
this.queryText = this.queryText.replace("@monitoringDate",  monitoringDateStr);

var workEffortIdStr = "";
if (params["workEffortId"].value != null &amp;&amp; params["workEffortId"].value != "") {
    workEffortIdStr = "and fil_w.work_effort_id = '" +params["workEffortId"].value + "'";
}
this.queryText = this.queryText.replace("@workEffortId", workEffortIdStr);

var currentStatusIdStr = "";
if (params["currentStatusId"].value != null &amp;&amp; params["currentStatusId"].value != "") {
    currentStatusIdStr = "and fil_w.current_status_id = '" + params["currentStatusId"].value + "'";
}
this.queryText = this.queryText.replace("@currentStatusId", currentStatusIdStr);

var orgUnitIdStr = "";
if (params["orgUnitId"].value != null &amp;&amp; params["orgUnitId"].value != "") {
    orgUnitIdStr = "and fil_w.org_unit_id = '" + params["orgUnitId"].value + "'";
}
this.queryText = this.queryText.replace("@orgUnitId", orgUnitIdStr);

//GESTIRE PERMESSI
/* */
filter = new com.mapsengineering.base.birt.util.UtilFilter(params["userLoginId"].value, params["localDispatcherName"].value);
var filterInnerJoin = filter.getWorkEffortFilterInner();
var filterLeftJoin = filter.getWorkEffortFilterLeftJoin();
var filterWhere = filter.getWorkEffortFilterWhere();

/*   
var filterInnerJoin = "";
var filterLeftJoin = "";
var filterWhere = "";
*/
this.queryText = this.queryText.replace("@filterInnerJoin",  filterInnerJoin );
this.queryText = this.queryText.replace("@filterLeftJoin",  filterLeftJoin );
this.queryText = this.queryText.replace("@filterWhere",  filterWhere );

ReportLog.info("query SchedeInd = " +this.queryText);]]></method>
