            <xml-property name="queryText"><![CDATA[select 
  w.work_effort_id,
  w.data_valutazione,
  w.periodo_valutazione,
  w.tipo_scheda,
  w.titolo_scheda,
  w.matricola_valutato,
  w.nome_valutato,
  w.cognome_valutato,
  w.profilo_valutato,
  w.struttura_afferenza,
  w.etichetta_valutatore,
  w.nome_valutatore,
  w.etichetta_intermedio,
  w.nome_intermedio,
  w.note_valutato,
  w.note_valutatore,
  w.note_colloquio,
  w.note_contestazione,
  w.titolo_stampa,
  w.punteggio_scheda
from
  vista_schede_ind w 
inner join work_effort fil_w on fil_w.work_effort_id = w.work_effort_id
@filterInnerJoin
@filterLeftJoin
where 0 = 0
 @monitoringDate
 @workEffortId
 @currentStatusId
 @orgUnitId
 @filterWhere]]></xml-property>
