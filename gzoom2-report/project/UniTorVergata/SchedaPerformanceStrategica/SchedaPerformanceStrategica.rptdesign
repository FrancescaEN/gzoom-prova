            <xml-property name="queryText"><![CDATA[SELECT
WM.WORK_EFFORT_ID AS "WORK_EFFORT_ID",
WM.SEQUENCE_ID AS "SEQUENCE_ID",
  WM.WORK_EFFORT_MEASURE_ID AS "WORK_EFFORT_MEASURE_ID",
  WM.GL_ACCOUNT_ID AS "GL_ACCOUNT_ID",
  GL.ACCOUNT_CODE AS "ACCOUNT_CODE",
  GL.ACCOUNT_NAME AS "ACCOUNT_NAME",
  WM.KPI_SCORE_WEIGHT AS "KPI_SCORE_WEIGHT",
  U.ABBREVIATION AS "ABBREVIATION",
  GL.INPUT_ENUM_ID AS "INPUT_ENUM_ID",
  WM.UOM_DESCR AS "UOM_DESCR",
  U.UOM_TYPE_ID AS "UOM_TYPE_ID",
  U.DECIMAL_SCALE AS "DECIMAL_SCALE",
MAX(CASE WHEN AT.GL_FISCAL_TYPE_ID = 'ACTUAL' AND GL.GL_ACCOUNT_ID <> 'SCORE' AND AT.TRANSACTION_DATE = @monitoringDateMenoTre THEN AE.AMOUNT ELSE NULL END) AS "ACTUAL_DATE_MENO_TRE",
MAX(CASE WHEN AT.GL_FISCAL_TYPE_ID = 'ACTUAL' AND GL.GL_ACCOUNT_ID <> 'SCORE' AND AT.TRANSACTION_DATE = @monitoringDateMenoDue THEN AE.AMOUNT ELSE NULL END) AS "ACTUAL_DATE_MENO_DUE",  
MAX(CASE WHEN AT.GL_FISCAL_TYPE_ID = 'ACTUAL' AND GL.GL_ACCOUNT_ID <> 'SCORE' AND AT.TRANSACTION_DATE = @monitoringDateMenoUno THEN AE.AMOUNT ELSE NULL END) AS "ACTUAL_DATE_MENO_UNO",
MAX(CASE WHEN AT.GL_FISCAL_TYPE_ID = 'ACTUAL' AND GL.GL_ACCOUNT_ID <> 'SCORE' AND AT.TRANSACTION_DATE = TO_DATE(@monitoringDate, 'yyyy-mm-dd') THEN AE.AMOUNT ELSE NULL END) AS "ACTUAL_DATE",
MAX(CASE WHEN AT.GL_FISCAL_TYPE_ID = 'ACTUAL' AND GL.GL_ACCOUNT_ID <> 'SCORE' AND AT.TRANSACTION_DATE = @monitoringDatePiuUno THEN AE.AMOUNT ELSE NULL END) AS "ACTUAL_DATE_PIU_UNO",
MAX(CASE WHEN AT.GL_FISCAL_TYPE_ID = 'BUDGET' AND GL.GL_ACCOUNT_ID <> 'SCORE' AND AT.TRANSACTION_DATE = @monitoringDateMenoTre THEN AE.AMOUNT ELSE NULL END) AS "BUDGET_DATE_MENO_TRE",
MAX(CASE WHEN AT.GL_FISCAL_TYPE_ID = 'BUDGET' AND GL.GL_ACCOUNT_ID <> 'SCORE' AND AT.TRANSACTION_DATE = @monitoringDateMenoDue THEN AE.AMOUNT ELSE NULL END) AS "BUDGET_DATE_MENO_DUE",
MAX(CASE WHEN AT.GL_FISCAL_TYPE_ID = 'BUDGET' AND GL.GL_ACCOUNT_ID <> 'SCORE' AND AT.TRANSACTION_DATE = @monitoringDateMenoUno THEN AE.AMOUNT ELSE NULL END) AS "BUDGET_DATE_MENO_UNO",
MAX(CASE WHEN AT.GL_FISCAL_TYPE_ID = 'BUDGET' AND GL.GL_ACCOUNT_ID <> 'SCORE' AND AT.TRANSACTION_DATE = TO_DATE(@monitoringDate, 'yyyy-mm-dd') THEN AE.AMOUNT ELSE NULL END) AS "BUDGET_DATE",
MAX(CASE WHEN AT.GL_FISCAL_TYPE_ID = 'BUDGET' AND GL.GL_ACCOUNT_ID <> 'SCORE' AND AT.TRANSACTION_DATE = @monitoringDatePiuUno THEN AE.AMOUNT ELSE NULL END) AS "BUDGET_DATE_PIU_UNO",
-- MAX(CASE WHEN  AT2.TRANSACTION_DATE = TO_DATE(@monitoringDate, 'yyyy-mm-dd') then AE2.AMOUNT ELSE NULL END) AS "VALUTAZIONE_DATE",
MAX(AE2.AMOUNT) AS "VALUTAZIONE_DATE",
MAX(EP.OBJECT_INFO) AS "OBJECT_INFO",
MAX(EP2.OBJECT_INFO) AS "OBJECT_INFO2"
FROM WORK_EFFORT_MEASURE WM
LEFT OUTER JOIN ACCTG_TRANS_ENTRY AE ON AE.GL_ACCOUNT_ID = WM.GL_ACCOUNT_ID
LEFT OUTER JOIN ACCTG_TRANS AT ON AT.ACCTG_TRANS_ID = AE.ACCTG_TRANS_ID
LEFT OUTER JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = WM.GL_ACCOUNT_ID AND GL.GL_ACCOUNT_ID <> 'SCORE' AND GL.GL_ACCOUNT_TYPE_ID = 'RIS'
LEFT OUTER JOIN UOM U ON U.UOM_ID = GL.DEFAULT_UOM_ID
LEFT OUTER JOIN ACCTG_TRANS AT2 ON AT2.TRANSACTION_DATE = @monitoringDate AND
-- AT2.TRANSACTION_DATE = TO_DATE(@monitoringDate, 'yyyy-mm-dd') AND
  AT2.VOUCHER_REF = WM.WORK_EFFORT_MEASURE_ID 
  AND AT2.ACCTG_TRANS_TYPE_ID = 'SCOREKPI' 
  AND AT2.GL_FISCAL_TYPE_ID = 'ACTUAL'
LEFT OUTER JOIN ACCTG_TRANS_ENTRY AE2 ON AE2.ACCTG_TRANS_ID = AT2.ACCTG_TRANS_ID
LEFT OUTER JOIN UOM_RANGE_VALUES VP ON VP.FROM_VALUE <= AE2.AMOUNT AND VP.THRU_VALUE >= AE2.AMOUNT		
LEFT OUTER JOIN ENUMERATION CP ON CP.ENUM_ID = VP.COLOR_ENUM_ID																											
LEFT OUTER JOIN CONTENT IP ON IP.CONTENT_ID = VP.ICON_CONTENT_ID																											
LEFT OUTER JOIN DATA_RESOURCE EP ON EP.DATA_RESOURCE_ID = IP.DATA_RESOURCE_ID
LEFT OUTER JOIN UOM_RANGE UR2 ON UR2.UOM_RANGE_ID = 'RISULTATI'
LEFT OUTER JOIN UOM_RANGE_VALUES URV2 ON URV2.UOM_RANGE_ID = UR2.UOM_RANGE_ID 
 AND URV2.FROM_VALUE <= AE2.AMOUNT AND URV2.THRU_VALUE >= AE2.AMOUNT
LEFT JOIN ENUMERATION CP2 ON CP2.ENUM_ID = URV2.COLOR_ENUM_ID																											
LEFT JOIN CONTENT IP2 ON IP2.CONTENT_ID = URV2.ICON_CONTENT_ID																											
LEFT JOIN DATA_RESOURCE EP2 ON EP2.DATA_RESOURCE_ID = IP2.DATA_RESOURCE_ID 
WHERE WM.WORK_EFFORT_ID = ?
AND ( WM.FROM_DATE < @date3112-1 AND WM.THRU_DATE >= @date3112 ) -- GN-5427
AND GL.GL_ACCOUNT_ID <> 'SCORE'
AND GL.GL_ACCOUNT_TYPE_ID = 'RIS'
GROUP BY
WM.WORK_EFFORT_ID,
WM.SEQUENCE_ID,
 WM.WORK_EFFORT_MEASURE_ID,
 WM.GL_ACCOUNT_ID,
 GL.ACCOUNT_CODE,
 GL.ACCOUNT_NAME,
 WM.KPI_SCORE_WEIGHT,
 U.ABBREVIATION,
 GL.INPUT_ENUM_ID,
 WM.UOM_DESCR,
 U.UOM_TYPE_ID,
 U.DECIMAL_SCALE
 ORDER BY WM.SEQUENCE_ID, WM.WORK_EFFORT_ID]]></xml-property>
