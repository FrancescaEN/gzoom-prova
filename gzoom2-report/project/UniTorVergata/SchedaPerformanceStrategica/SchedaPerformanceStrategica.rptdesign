            <method name="beforeOpen"><![CDATA[/**/
ReportLog.info(" *** INIZIO QUERY INDICATORIMONIT *** ");
ReportLog.info(" - monitoringDateSql: "+params["monitoringDateSql"].value);
ReportLog.info(" - monitoringDate: "+params["monitoringDate"].value);
ReportLog.info(" - monitoringDateMenoTre: "+params["monitoringDateMenoTre"].value);
ReportLog.info(" - monitoringDateMenoTreSql: "+params["monitoringDateMenoTreSql"].value);
ReportLog.info(" - monitoringDateMenoDue: "+params["monitoringDateMenoDue"].value);
ReportLog.info(" - monitoringDateMenoDueSql: "+params["monitoringDateMenoDueSql"].value);
ReportLog.info(" - monitoringDateMenoUno: "+params["monitoringDateMenoUno"].value);
ReportLog.info(" - monitoringDateMenoUnoSql: "+params["monitoringDateMenoUnoSql"].value);
ReportLog.info(" - date3112Sql: "+params["date3112Sql"].value);
ReportLog.info(" - date0101Sql: "+params["date0101Sql"].value);
ReportLog.info(" - workEffortId: "+params["workEffortId"].value);

/**/
this.queryText = this.queryText.replace("@monitoringDateMenoTre",  params["monitoringDateMenoTreSql"].value );
this.queryText = this.queryText.replace("@monitoringDateMenoDue",  params["monitoringDateMenoDueSql"].value );
this.queryText = this.queryText.replace("@monitoringDateMenoUno",  params["monitoringDateMenoUnoSql"].value );
this.queryText = this.queryText.replace("@monitoringDatePiuUno",  params["monitoringDatePiuUnoSql"].value );
this.queryText = this.queryText.replace("@date3112-1",  params["date3112-1Sql"].value );
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );
//this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );

//se la monitoringDate è al 30/06 devo aggiungere l'ora , altrimenti non funziona
/**/
var monitoringDateString = '';
if (com.mapsengineering.base.birt.util.UtilStrings.substring((params["monitoringDateSql"].value),6,11) == '06-30') {
	monitoringDateString = "'" + params["date3006"].value +  " 00:00:00.19+02'";
	this.queryText = this.queryText.replace("@monitoringDate",  monitoringDateString );
} else {
	this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );
}

/*
this.queryText = this.queryText.replace("@date3112-1", "'2018-10-23  00:00:00.000'");
this.queryText = this.queryText.replace("@monitoringDateMenoTre", "'2018-10-23  00:00:00.000'");
this.queryText = this.queryText.replace("@monitoringDateMenoDue", "'2018-10-23  00:00:00.000'");
this.queryText = this.queryText.replace("@monitoringDateMenoUno", "'2018-10-23  00:00:00.000'");
this.queryText = this.queryText.replace("@monitoringDatePiuUno", "'2018-10-23  00:00:00.000'");
this.queryText = this.queryText.replace("@monitoringDate", "'2018-10-23 00:00:00.19+02'");
this.queryText = this.queryText.replace("@date3112",  "'2021-12-31 00:00:00.000'" );
*/]]></method>
