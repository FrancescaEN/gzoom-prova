                                        <expression name="valueExpr">var titolo = '';&#13;
if (BirtComp.equalTo(params["monitoringDate"].value, params["date3112"].value) || BirtComp.equalTo(params["monitoringDate"].value, params["date3006"].value)) {&#13;
    titolo = reportContext.getMessage('Monitoraggio', reportContext.getLocale());&#13;
    titolo += ' ';&#13;
    titolo += (row["RAD_TITOLO"] != '' &amp;&amp; row["RAD_TITOLO"] != null ) ? row["RAD_TITOLO"] : title;&#13;
    titolo += ' ';&#13;
    titolo += reportContext.getMessage('al', reportContext.getLocale());&#13;
    titolo += ' ';&#13;
    titolo += Formatter.format(params["monitoringDate"].value,'dd/MM/yyyy');&#13;
} else {&#13;
    titolo += (row["RAD_TITOLO"] != '' &amp;&amp; row["RAD_TITOLO"] != null ) ? row["RAD_TITOLO"] : title;&#13;
    titolo += ' ';&#13;
    titolo += reportContext.getMessage('del', reportContext.getLocale());&#13;
    titolo += ' ';&#13;
    titolo += BirtDateTime.year(params["monitoringDate"].value);&#13;
}&#13;
titolo</expression>
