                    </structure>
                </list-property>
            </structure>
            <method name="beforeOpen"><![CDATA[//
this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );

//this.queryText = this.queryText.replace("@monitoringDate", "'2022-06-30'");

//ReportLog.info("query IndicatoriValutazioneDS: " +this.queryText);]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">WORK_EFFORT_MEASURE_ID</property>
                    <property name="nativeName">WORK_EFFORT_MEASURE_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">TRANSACTION_DATE</property>
                    <property name="nativeName">TRANSACTION_DATE</property>
                    <property name="dataType">date</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">VALUTAZIONE_DATE</property>
                    <property name="nativeName">VALUTAZIONE_DATE</property>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">OBJECT_INFO</property>
                    <property name="nativeName">OBJECT_INFO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">OBJECT_INFO2</property>
                    <property name="nativeName">OBJECT_INFO2</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT
  AT2.VOUCHER_REF AS "WORK_EFFORT_MEASURE_ID",  
  DATE(AT2.TRANSACTION_DATE) AS "TRANSACTION_DATE",
MAX(AE2.AMOUNT) AS "VALUTAZIONE_DATE",
MAX(EP.OBJECT_INFO) AS "OBJECT_INFO",
MAX(EP2.OBJECT_INFO) AS "OBJECT_INFO2"
from ACCTG_TRANS AT2 
LEFT OUTER JOIN ACCTG_TRANS_ENTRY AE2 ON AE2.ACCTG_TRANS_ID = AT2.ACCTG_TRANS_ID
LEFT OUTER JOIN UOM_RANGE_VALUES VP ON VP.FROM_VALUE <= AE2.AMOUNT AND VP.THRU_VALUE >= AE2.AMOUNT		
LEFT OUTER JOIN ENUMERATION CP ON CP.ENUM_ID = VP.COLOR_ENUM_ID																											
LEFT OUTER JOIN CONTENT IP ON IP.CONTENT_ID = VP.ICON_CONTENT_ID																											
LEFT OUTER JOIN DATA_RESOURCE EP ON EP.DATA_RESOURCE_ID = IP.DATA_RESOURCE_ID
LEFT OUTER JOIN UOM_RANGE UR2 ON UR2.UOM_RANGE_ID = 'RISULTATI'
LEFT OUTER JOIN UOM_RANGE_VALUES URV2 ON URV2.UOM_RANGE_ID = UR2.UOM_RANGE_ID 
 AND URV2.FROM_VALUE <= AE2.AMOUNT AND URV2.THRU_VALUE >= AE2.AMOUNT
LEFT JOIN ENUMERATION CP2 ON CP2.ENUM_ID = URV2.COLOR_ENUM_ID																											
LEFT JOIN CONTENT IP2 ON IP2.CONTENT_ID = URV2.ICON_CONTENT_ID																											
LEFT JOIN DATA_RESOURCE EP2 ON EP2.DATA_RESOURCE_ID = IP2.DATA_RESOURCE_ID 
where  AT2.VOUCHER_REF = ?
and DATE(AT2.TRANSACTION_DATE) = @monitoringDate 
  AND AT2.ACCTG_TRANS_TYPE_ID = 'SCOREKPI' 
  AND AT2.GL_FISCAL_TYPE_ID = 'ACTUAL'
GROUP BY
 AT2.VOUCHER_REF , DATE(AT2.TRANSACTION_DATE)]]></xml-property>
