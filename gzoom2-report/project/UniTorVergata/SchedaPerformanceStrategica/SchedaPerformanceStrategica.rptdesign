            <property name="nullsOrdering">nulls lowest</property>
            <list-property name="computedColumns">
                <structure>
                    <property name="name">INDICATORE</property>
                    <expression name="expression">if(row["INPUT_ENUM_ID"] == "ACCINP_UO"){&#13;
	 row["ACCOUNT_NAME"];&#13;
} else if(row["INPUT_ENUM_ID"] == "ACCINP_PRD"){&#13;
	 (row["UOM_DESCR"] != null &amp;&amp; row["UOM_DESCR"] != "" ? row["UOM_DESCR"]  :  row["ACCOUNT_NAME"])&#13;
} else if(row["INPUT_ENUM_ID"] == "ACCINP_OBJ"){&#13;
	(row["UOM_DESCR"] != null &amp;&amp; row["UOM_DESCR"] != "" ? row["UOM_DESCR"]  : row["ACCOUNT_NAME"])&#13;
} else {&#13;
	row["ACCOUNT_NAME"];&#13;
}</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">COUNT</property>
                    <property name="dataType">integer</property>
                    <property name="aggregateFunction">COUNT</property>
                </structure>
                <structure>
                    <property name="name">ObjectInfo2</property>
                    <expression name="expression">var ObjectInfo2 = '';&#13;
if (row["OBJECT_INFO2"] != null &amp;&amp; row["OBJECT_INFO2"] != '') {&#13;
    var l1 = row["OBJECT_INFO2"].length();&#13;
    var s1 = row["OBJECT_INFO2"].substring(11, l1);&#13;
    ObjectInfo2 = 'hot-deploy' + s1;&#13;
}&#13;
ObjectInfo2</expression>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
