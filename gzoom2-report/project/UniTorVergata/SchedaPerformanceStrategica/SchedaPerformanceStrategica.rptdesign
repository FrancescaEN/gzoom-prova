            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">a_work_effort_id</property>
                    <property name="nativeName">a_work_effort_id</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">a_transaction_date</property>
                    <property name="nativeName">a_transaction_date</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">SPESO</property>
                    <property name="nativeName">SPESO</property>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">STANZIATO</property>
                    <property name="nativeName">STANZIATO</property>
                    <property name="dataType">float</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT Q.A_WORK_EFFORT_ID,
Q.A_TRANSACTION_DATE,
MAX(CASE WHEN Q.B_GL_FISCAL_TYPE_ID = 'SPENT' THEN Q.B_AMOUNT ELSE NULL END) AS "SPESO",
MAX(CASE WHEN Q.B_GL_FISCAL_TYPE_ID = 'ALLOCATED' THEN Q.B_AMOUNT ELSE NULL END) AS "STANZIATO"
FROM ACCTG_TRANS_VIEW Q 
WHERE Q.A_WORK_EFFORT_ID = ?
AND Q.B_GL_ACCOUNT_ID = 'ECO' 
AND Q.A_TRANSACTION_DATE = @monitoringDate
group by 
Q.A_WORK_EFFORT_ID,
Q.A_TRANSACTION_DATE	 ]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="IndicatoriValutazioneDS" id="58954">
            <property name="nullsOrdering">nulls lowest</property>
            <list-property name="columnHints"/>
            <list-property name="parameters">
                <structure>
                    <property name="name">workEffortId</property>
                    <property name="nativeName"></property>
                    <property name="dataType">string</property>
