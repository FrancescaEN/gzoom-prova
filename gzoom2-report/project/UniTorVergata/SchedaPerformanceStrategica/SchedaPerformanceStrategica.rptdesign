            <xml-property name="queryText"><![CDATA[SELECT
WM.WORK_EFFORT_ID AS "WORK_EFFORT_ID",
WM.SEQUENCE_ID AS "SEQUENCE_ID",
  WM.WORK_EFFORT_MEASURE_ID AS "WORK_EFFORT_MEASURE_ID",
  WM.GL_ACCOUNT_ID AS "GL_ACCOUNT_ID",
  GL.ACCOUNT_CODE AS "ACCOUNT_CODE",
  GL.ACCOUNT_NAME AS "ACCOUNT_NAME",
  WM.KPI_SCORE_WEIGHT AS "KPI_SCORE_WEIGHT",
  U.ABBREVIATION AS "ABBREVIATION",
  GL.INPUT_ENUM_ID AS "INPUT_ENUM_ID",
  WM.UOM_DESCR AS "UOM_DESCR",
  U.UOM_TYPE_ID AS "UOM_TYPE_ID",
  U.DECIMAL_SCALE AS "DECIMAL_SCALE",
MAX(CASE WHEN AT.GL_FISCAL_TYPE_ID = 'ACTUAL' AND GL.GL_ACCOUNT_ID <> 'SCORE' AND DATE(AT.TRANSACTION_DATE) = @date3112-3 THEN AE.AMOUNT ELSE NULL END) AS "ACTUAL_DATE_MENO_TRE",
MAX(CASE WHEN AT.GL_FISCAL_TYPE_ID = 'ACTUAL' AND GL.GL_ACCOUNT_ID <> 'SCORE' AND DATE(AT.TRANSACTION_DATE) = @date3112-2 THEN AE.AMOUNT ELSE NULL END) AS "ACTUAL_DATE_MENO_DUE",  
MAX(CASE WHEN AT.GL_FISCAL_TYPE_ID = 'ACTUAL' AND GL.GL_ACCOUNT_ID <> 'SCORE' AND DATE(AT.TRANSACTION_DATE) = @date3112-1 THEN AE.AMOUNT ELSE NULL END) AS "ACTUAL_DATE_MENO_UNO",
MAX(CASE WHEN AT.GL_FISCAL_TYPE_ID = 'ACTUAL' AND GL.GL_ACCOUNT_ID <> 'SCORE' AND DATE(AT.TRANSACTION_DATE) = @date3112 THEN AE.AMOUNT ELSE NULL END) AS "ACTUAL_DATE",
MAX(CASE WHEN AT.GL_FISCAL_TYPE_ID = 'ACTUAL' AND GL.GL_ACCOUNT_ID <> 'SCORE' AND DATE(AT.TRANSACTION_DATE) = @date3112+1 THEN AE.AMOUNT ELSE NULL END) AS "ACTUAL_DATE_PIU_UNO",
MAX(CASE WHEN AT.GL_FISCAL_TYPE_ID = 'BUDGET' AND GL.GL_ACCOUNT_ID <> 'SCORE' AND DATE(AT.TRANSACTION_DATE) = @date3112-3 THEN AE.AMOUNT ELSE NULL END) AS "BUDGET_DATE_MENO_TRE",
MAX(CASE WHEN AT.GL_FISCAL_TYPE_ID = 'BUDGET' AND GL.GL_ACCOUNT_ID <> 'SCORE' AND DATE(AT.TRANSACTION_DATE) = @date3112-2 THEN AE.AMOUNT ELSE NULL END) AS "BUDGET_DATE_MENO_DUE",
MAX(CASE WHEN AT.GL_FISCAL_TYPE_ID = 'BUDGET' AND GL.GL_ACCOUNT_ID <> 'SCORE' AND DATE(AT.TRANSACTION_DATE) = @date3112-1 THEN AE.AMOUNT ELSE NULL END) AS "BUDGET_DATE_MENO_UNO",
MAX(CASE WHEN AT.GL_FISCAL_TYPE_ID = 'BUDGET' AND GL.GL_ACCOUNT_ID <> 'SCORE' AND DATE(AT.TRANSACTION_DATE) = @date3112 THEN AE.AMOUNT ELSE NULL END) AS "BUDGET_DATE",
MAX(CASE WHEN AT.GL_FISCAL_TYPE_ID = 'BUDGET' AND GL.GL_ACCOUNT_ID <> 'SCORE' AND DATE(AT.TRANSACTION_DATE) = @date3112+1 THEN AE.AMOUNT ELSE NULL END) AS "BUDGET_DATE_PIU_UNO"
FROM WORK_EFFORT_MEASURE WM
LEFT OUTER JOIN ACCTG_TRANS_ENTRY AE ON AE.GL_ACCOUNT_ID = WM.GL_ACCOUNT_ID
LEFT OUTER JOIN ACCTG_TRANS AT ON AT.ACCTG_TRANS_ID = AE.ACCTG_TRANS_ID
LEFT OUTER JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = WM.GL_ACCOUNT_ID AND GL.GL_ACCOUNT_ID <> 'SCORE' AND GL.GL_ACCOUNT_TYPE_ID = 'RIS'
LEFT OUTER JOIN UOM U ON U.UOM_ID = GL.DEFAULT_UOM_ID
WHERE WM.WORK_EFFORT_ID = ?
AND ( WM.FROM_DATE < @date3112-1 AND WM.THRU_DATE >= @date3112 ) -- GN-5427
AND GL.GL_ACCOUNT_ID <> 'SCORE'
AND GL.GL_ACCOUNT_TYPE_ID = 'RIS'
GROUP BY
WM.WORK_EFFORT_ID,
WM.SEQUENCE_ID,
 WM.WORK_EFFORT_MEASURE_ID,
 WM.GL_ACCOUNT_ID,
 GL.ACCOUNT_CODE,
 GL.ACCOUNT_NAME,
 WM.KPI_SCORE_WEIGHT,
 U.ABBREVIATION,
 GL.INPUT_ENUM_ID,
 WM.UOM_DESCR,
 U.UOM_TYPE_ID,
 U.DECIMAL_SCALE
 ORDER BY WM.SEQUENCE_ID, WM.WORK_EFFORT_ID]]></xml-property>
