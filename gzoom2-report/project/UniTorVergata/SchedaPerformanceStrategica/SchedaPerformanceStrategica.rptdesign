            <method name="beforeOpen"><![CDATA[/*
ReportLog.info(" *** INIZIO QUERY INDEXDS *** ");
ReportLog.info(" - excludeValidity: "+params["excludeValidity"].value);
ReportLog.info(" - reportContentId: "+params["reportContentId"].value);
ReportLog.info(" - date3112Sql: "+params["date3112Sql"].value);
ReportLog.info(" - date0101Sql: "+params["date0101Sql"].value);
ReportLog.info(" - monitoringDateSql: "+params["monitoringDateSql"].value);
ReportLog.info(" - monitoringDate: "+params["monitoringDate"].value);
ReportLog.info(" - date3006: "+params["date3006"].value);
ReportLog.info(" - date3112: "+params["date3112"].value);
ReportLog.info(" - workEffortId: "+params["workEffortId"].value);
*/
/**/
this.queryText = this.queryText.replace("@excludeValidity", "'" + params["excludeValidity"].value+ "'");
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );
//this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );

/*
this.queryText = this.queryText.replace("@monitoringDate", "'2021-12-31 00:00:00.000+01'");
this.queryText = this.queryText.replace("@date3112", "'2021-12-31 00:00:00.000+01'");

this.queryText = this.queryText.replace("@excludeValidity", "'N'");
*/

//se la monitoringDate è al 30/06 devo aggiungere l'ora , altrimenti non funziona
/**/
var monitoringDateString = '';

if (com.mapsengineering.base.birt.util.UtilStrings.substring((params["monitoringDateSql"].value),6,11) == '06-30') {

	monitoringDateString = "'" + params["date3006"].value +  " 00:00:00.19+02'";
	this.queryText = this.queryText.replace("@monitoringDate",  monitoringDateString );
	
}else if (com.mapsengineering.base.birt.util.UtilStrings.substring((params["monitoringDateSql"].value),6,11) == '12-31') {
	
	monitoringDateString = "'" + params["date3112"].value +  " 00:00:00.000+01'";
	this.queryText = this.queryText.replace("@monitoringDate",  monitoringDateString );

}else if (com.mapsengineering.base.birt.util.UtilStrings.substring((params["monitoringDateSql"].value),6,11) == '01-01') {
	monitoringDateString = "'" + params["date0101"].value +  " 00:00:00.000+01'";
	this.queryText = this.queryText.replace("@monitoringDate",  monitoringDateString );

}else {

	this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );
}

//ReportLog.info(" - monitoringDate3006String: "+monitoringDate3006String);

//@workEffortIdChild
var workEffortIdChildString = '';
if (params["workEffortIdChild"].value != null &amp;&amp; params["workEffortIdChild"].value != '') {
	workEffortIdChildString = "AND A1.WORK_EFFORT_ID = '"+ params["workEffortIdChild"].value + "'";	
}
this.queryText = this.queryText.replace("@workEffortIdChild",  workEffortIdChildString );

//@workEffortId
var workEffortIdString = '';
if (params["workEffortId"].value != null &amp;&amp; params["workEffortId"].value != '') {
	workEffortIdString = "AND RAD.WORK_EFFORT_ID = '"+ params["workEffortId"].value + "'";
}
this.queryText = this.queryText.replace("@workEffortId",  workEffortIdString );

//@orgUnitId
var orgUnitIdString = '';
if (params["orgUnitId"].value != null &amp;&amp; params["orgUnitId"].value != '') {
	orgUnitIdString = "AND FIL_W.ORG_UNIT_ID = '"+ params["orgUnitId"].value + "'";
}
this.queryText = this.queryText.replace("@orgUnitId",  orgUnitIdString );

//@workEffortAssocTypeId1
var workEffortAssocTypeId1 = '';
if (params["reportContentId"].value == 'REPORT_PIA_SVIL') {
    workEffortAssocTypeId1 = "AND Z1.WORK_EFFORT_ASSOC_TYPE_ID = '19SVI'";
} else if (params["reportContentId"].value == 'REPORT_BAL_SCO') {
    workEffortAssocTypeId1 = "AND Z1.WORK_EFFORT_ASSOC_TYPE_ID = '19BSC'";
} else {
    workEffortAssocTypeId1 = "AND Z1.WORK_EFFORT_ASSOC_TYPE_ID = '19SOS'";
}
this.queryText = this.queryText.replace("@workEffortAssocTypeId1",  workEffortAssocTypeId1);

//@workEffortAssocTypeId2
var workEffortAssocTypeId2 = '';
if (params["reportContentId"].value == 'REPORT_PIA_SVIL') {
    workEffortAssocTypeId2 = "AND Z2.WORK_EFFORT_ASSOC_TYPE_ID = '19OBS'";
} else if (params["reportContentId"].value == 'REPORT_BAL_SCO') {
    workEffortAssocTypeId2 = "AND Z2.WORK_EFFORT_ASSOC_TYPE_ID = '19BSC'";
} else {
    workEffortAssocTypeId2 = "AND Z2.WORK_EFFORT_ASSOC_TYPE_ID = '19OBS'";
}
this.queryText = this.queryText.replace("@workEffortAssocTypeId2",  workEffortAssocTypeId2);

//GESTIRE PERMESSI
/* 
filter = new com.mapsengineering.base.birt.util.UtilFilter(params["userLoginId"].value, params["localDispatcherName"].value);
var filterInnerJoin = filter.getWorkEffortFilterInner();
var filterLeftJoin = filter.getWorkEffortFilterLeftJoin();
var filterWhere = filter.getWorkEffortFilterWhere();
*/
/*   */
var filterInnerJoin = "";
var filterLeftJoin = "";
var filterWhere = "";

this.queryText = this.queryText.replace("@filterInnerJoin",  filterInnerJoin );
this.queryText = this.queryText.replace("@filterLeftJoin",  filterLeftJoin );
this.queryText = this.queryText.replace("@filterWhere",  filterWhere );


ReportLog.info("......this.queryText IndexDS: "+this.queryText);]]></method>
