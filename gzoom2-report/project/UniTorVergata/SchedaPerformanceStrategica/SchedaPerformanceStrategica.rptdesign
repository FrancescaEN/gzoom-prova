            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">STANZIATO</property>
                    <property name="nativeName">STANZIATO</property>
                    <property name="dataType">float</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT Q.B_AMOUNT  AS "STANZIATO"
FROM ACCTG_TRANS_VIEW Q 
WHERE Q.A_WORK_EFFORT_ID = ?
AND Q.B_GL_ACCOUNT_ID = 'ECO' AND Q.B_GL_FISCAL_TYPE_ID = 'ALLOCATED'
AND Q.A_TRANSACTION_DATE = @monitoringDate	 ]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="SpesoDS" id="58871">
            <list-property name="columnHints"/>
            <list-property name="parameters">
                <structure>
                    <property name="name">workEffortId</property>
                    <property name="nativeName"></property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">0</property>
                    <property name="position">1</property>
                    <expression name="defaultValue" type="constant">N/A</expression>
                    <property name="isOptional">false</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">SPESO</property>
                        <property name="dataType">float</property>
                    </structure>
                </list-property>
            </structure>
            <method name="beforeOpen"><![CDATA[//
this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );
//this.queryText = this.queryText.replace("@monitoringDate", "'2018-10-23 14:30:57.19+02'");

ReportLog.info("......this.queryText SpesoDS: "+this.queryText);]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">SPESO</property>
                    <property name="nativeName">SPESO</property>
                    <property name="dataType">float</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT Q.B_AMOUNT  AS "SPESO"
FROM ACCTG_TRANS_VIEW Q 
WHERE Q.A_WORK_EFFORT_ID = ?
AND Q.B_GL_ACCOUNT_ID = 'ECO' AND Q.B_GL_FISCAL_TYPE_ID = 'SPENT'
AND Q.A_TRANSACTION_DATE = @monitoringDate	 ]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="DiffDS" id="58903">
            <list-property name="computedColumns">
                <structure>
                    <property name="name">Diff</property>
                    <expression name="expression">if(row["SPESO"]!=null &amp;&amp; row["STANZIATO"]!=null){&#13;
	row["SPESO"]-row["STANZIATO"]&#13;
}</expression>
                    <property name="dataType">float</property>
                </structure>
            </list-property>
            <list-property name="columnHints"/>
            <list-property name="parameters">
                <structure>
                    <property name="name">workEffortId</property>
