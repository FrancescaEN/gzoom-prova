            <method name="beforeOpen"><![CDATA[
/**/
this.queryText = this.queryText.replace("@date3112-3",  params["date3112-3Sql"].value );
this.queryText = this.queryText.replace("@date3112-2",  params["date3112-2Sql"].value );
this.queryText = this.queryText.replace("@date3112-1",  params["date3112-1Sql"].value );

//this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );
this.queryText = this.queryText.replace("@date3112+1",  params["date3112+1Sql"].value );
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );

//se la monitoringDate è al 30/06 devo aggiungere l'ora , altrimenti non funziona
/**/
var monitoringDateString = '';
if (com.mapsengineering.base.birt.util.UtilStrings.substring((params["monitoringDateSql"].value),6,11) == '06-30') {

	monitoringDateString = "'" + params["date3006"].value +  " 00:00:00.19+02'";
	this.queryText = this.queryText.replace("@monitoringDate",  monitoringDateString );
	
}else if (com.mapsengineering.base.birt.util.UtilStrings.substring((params["monitoringDateSql"].value),6,11) == '12-31') {
	
	monitoringDateString = "'" + params["date3112"].value +  " 00:00:00.000+01'";
	this.queryText = this.queryText.replace("@monitoringDate",  monitoringDateString );

}else if (com.mapsengineering.base.birt.util.UtilStrings.substring((params["monitoringDateSql"].value),6,11) == '01-01') {
	monitoringDateString = "'" + params["date0101"].value +  " 00:00:00.000+01'";
	this.queryText = this.queryText.replace("@monitoringDate",  monitoringDateString );

}else {

	this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );
}

/*
this.queryText = this.queryText.replace("@date3112-2", "'2018-10-23 2:30:57.19+02'");
this.queryText = this.queryText.replace("@date3112-3", "'2018-10-23 2:30:57.19+02'");
this.queryText = this.queryText.replace("@date3112-1", "'2018-10-23 2:30:57.19+02'");
this.queryText = this.queryText.replace("@monitoringDate", "'2018-10-23 2:30:57.19+02'");
this.queryText = this.queryText.replace("@date3112+1", "'2018-10-23 2:30:57.19+02'");
this.queryText = this.queryText.replace("@date3112",  "'2021-12-31 00:00:00.000'" );
*/]]></method>
