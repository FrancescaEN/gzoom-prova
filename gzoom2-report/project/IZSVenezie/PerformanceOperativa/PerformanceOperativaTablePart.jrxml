	<parameter name="ReportTitle" class="java.lang.String" isForPrompting="false"/>
	<parameter name="langLocale" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="defaultOrganizationPartyId" class="java.lang.String">
		<defaultValueExpression><![CDATA["Company"]]></defaultValueExpression>
	</parameter>
	<parameter name="orgUnitId" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="orgUnitIdString" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$P{orgUnitId}  != null && $P{orgUnitId}  != "" ? " AND FIL_W.ORG_UNIT_ID = '"+ $P{orgUnitId} + "'" : " AND FIL_W.ORG_UNIT_ID like '%%'"]]></defaultValueExpression>
	</parameter>
	<parameter name="localDispatcherName" class="java.lang.String">
		<defaultValueExpression><![CDATA["ORGPERF"]]></defaultValueExpression>
	</parameter>
	<parameter name="userLoginId" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["admin"]]></defaultValueExpression>
	</parameter>
	<parameter name="monitoringDate" class="java.util.Date" isForPrompting="false">
		<defaultValueExpression><![CDATA[TODAY( )]]></defaultValueExpression>
	</parameter>
	<parameter name="filterWhere" class="java.lang.String">
		<defaultValueExpression><![CDATA[new com.mapsengineering.base.birt.util.UtilFilter($P{userLoginId}, $P{localDispatcherName}).getWorkEffortFilterWhere()]]></defaultValueExpression>
	</parameter>
	<parameter name="filterLeftJoin" class="java.lang.String">
		<defaultValueExpression><![CDATA[new com.mapsengineering.base.birt.util.UtilFilter($P{userLoginId}, $P{localDispatcherName}).getWorkEffortFilterLeftJoin()]]></defaultValueExpression>
	</parameter>
	<parameter name="filterInnerJoin" class="java.lang.String">
		<defaultValueExpression><![CDATA[new com.mapsengineering.base.birt.util.UtilFilter($P{userLoginId}, $P{localDispatcherName}).getWorkEffortFilterInner()]]></defaultValueExpression>
	</parameter>
	<parameter name="date3112" class="java.util.Date" isForPrompting="false">
		<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilDateTime.getMonthEndFromDatetime("12",$P{REPORT_TIME_ZONE}.getID(),YEAR($P{monitoringDate}), $P{REPORT_LOCALE}.getDefault())]]></defaultValueExpression>
	</parameter>
	<parameter name="date3112sql" class="java.lang.String">
		<defaultValueExpression><![CDATA[SUBSTITUTE(com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc($P{date3112}, $P{odaDialect}),"'","")]]></defaultValueExpression>
	</parameter>
	<parameter name="odaDialect" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="date0101" class="java.util.Date" isForPrompting="false">
		<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilDateTime.getMonthStartFromDatetime("1",$P{REPORT_TIME_ZONE}.getID(),YEAR($P{monitoringDate}), $P{REPORT_LOCALE}.getDefault())]]></defaultValueExpression>
	</parameter>
	<parameter name="date0101sql" class="java.lang.String">
		<defaultValueExpression><![CDATA[SUBSTITUTE(com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc($P{date0101}, $P{odaDialect}),"'","")]]></defaultValueExpression>
	</parameter>
	<parameter name="Company" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.AppHeaderLogo.getCompany($P{userLoginId})]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportSmallPath" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.AppHeaderLogo.getReportContentUrl("REPORT_SMALL",$P{defaultOrganizationPartyId})]]></defaultValueExpression>
	</parameter>
	<parameter name="IconNavPath" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.AppHeaderLogo.getReportContentUrl("ICON_NAV",$P{defaultOrganizationPartyId})]]></defaultValueExpression>
	</parameter>
	<parameter name="workEffortTypeId" class="java.lang.String">
		<defaultValueExpression><![CDATA["20D20IST"]]></defaultValueExpression>
	</parameter>
	<parameter name="reportContentId" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="filterWhereString" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$P{filterWhere} != null ? $P{filterWhere} : ""]]></defaultValueExpression>
	</parameter>
	<parameter name="filterLeftJoinString" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$P{filterLeftJoin} != null ? $P{filterLeftJoin} : ""]]></defaultValueExpression>
	</parameter>
	<parameter name="filterInnerJoinString" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$P{filterInnerJoin} != null ? $P{filterInnerJoin} : ""]]></defaultValueExpression>
	</parameter>
	<parameter name="monitoringDateString" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc($P{monitoringDate}, $P{odaDialect});]]></defaultValueExpression>
	</parameter>
	<parameter name="personId" class="java.lang.String" isForPrompting="false"/>
	<parameter name="workEffortId" class="java.lang.String" isForPrompting="false"/>
	<parameter name="date3004" class="java.util.Date" isForPrompting="false">
		<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilDateTime.getMonthEndFromDatetime("4",$P{REPORT_TIME_ZONE}.getID(),YEAR($P{monitoringDate}), $P{REPORT_LOCALE}.getDefault())]]></defaultValueExpression>
	</parameter>
	<parameter name="date3004sql" class="java.lang.String">
		<defaultValueExpression><![CDATA[SUBSTITUTE(com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc($P{date3004}, $P{odaDialect}),"'","")]]></defaultValueExpression>
	</parameter>
	<parameter name="date3108" class="java.util.Date" isForPrompting="false">
		<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilDateTime.getMonthEndFromDatetime("8",$P{REPORT_TIME_ZONE}.getID(),YEAR($P{monitoringDate}), $P{REPORT_LOCALE}.getDefault())]]></defaultValueExpression>
	</parameter>
	<parameter name="date3108sql" class="java.lang.String">
		<defaultValueExpression><![CDATA[SUBSTITUTE(com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc($P{date3108}, $P{odaDialect}),"'","")]]></defaultValueExpression>
	</parameter>
	<parameter name="enumeration" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="enumerationString" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[($P{enumeration}  != null && $P{enumeration} != ""  && $P{enumeration}.equals( "SCOREMON_CRI" )) ? ("and (mon.transaction_date = " +$P{monitoringDateString} + " and  mon.amount = '33' )" ):
($P{enumeration}  != null && $P{enumeration} != ""  && $P{enumeration}.equals( "SCOREMON_INLINE" )) ? ("and (mon.transaction_date = " +$P{monitoringDateString} + " and  mon.amount = '66' )" ):
($P{enumeration}  != null && $P{enumeration} != ""  && $P{enumeration}.equals( "SCOREMON_RAGG" )) ? ("and (mon.transaction_date = " +$P{monitoringDateString} + " and  mon.amount = '100' )" ):
($P{enumeration}  != null && $P{enumeration} != ""  && $P{enumeration}.equals( "SCOREMON_RIN" )) ? ("and (mon.transaction_date = " +$P{monitoringDateString} + " and  mon.amount = '0' )" ): ""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select 
	YEAR($P{date3112sql}) as "Anno",
	areao.WORK_EFFORT_NAME as "Area organizzativa",
	FIL_W.nome_struttura as "Nome struttura",
	FIL_W.WORK_EFFORT_ID,
	concat(FIL_W.etch_struttura, ' - ', FIL_W.nome_struttura) as "Struttura organizzativa",
	concat(FIL_W.etch, ' - ', FIL_W.WORK_EFFORT_NAME) as "Obiettivo operativo di struttura",
	resp.party_name as "Nome Responsabile di struttura",
	FIL_W.DESCRIPTION as "Partecipazione/Responsabilità",
	FIL_W.peso as "Peso",
	FIL_W.raggiungimento as "Raggiungimento",
	max(case when note.SEQUENCE_ID = 100 then note.nota else null end) as "Referenti",
	indic.g_account_code as "Codice Indicatore",
	indic.g_account_name as "Descrizione Indicatore",
	indic.g_account_name as "Indicatore",
	indic.tt_description  as "Valore atteso",
	indic.M_KPI_SCORE_WEIGHT as "Peso indicatore",
	max(case when indic.tt_gl_fiscal_type_id = 'BUDGET' and indic.tt_transaction_date = $P{date3112sql} then
		(case when indic.g_uom_type_id = 'RATING_SCALE' then indic.uom_code when indic.g_uom_type_id = 'DATE_MEASURE'
			then DATE_FORMAT(FROM_UNIXTIME((INDIC.TM_AMOUNT-25568)*86400),'%d/%m/%Y') else indic.tm_amount end) else null end) as "Target",
	max(case when indic.tt_gl_fiscal_type_id = 'ACTUAL' and indic.tt_transaction_date = $P{date3112sql} then 
		(case when indic.g_uom_type_id = 'RATING_SCALE' then indic.uom_code when indic.g_uom_type_id = 'DATE_MEASURE'
			then DATE_FORMAT(FROM_UNIXTIME((INDIC.TM_AMOUNT-25568)*86400),'%d/%m/%Y') else indic.tm_amount end) else null end) as "Consuntivo",
	max(case when note.SEQUENCE_ID = 110 then note.nota else null end) as "Relazione",
	score.amount as "Risultato",
	max(case when note.SEQUENCE_ID = 150 and year(note.note_date_time) = YEAR($P{date3112sql}) then note.nota else null end) as "Analisi risultato",
	max(case when mon.transaction_date = $P{date3004sql} then mon.uom_code else null end) as "Monitoraggio 1° quadrimestre",
	max(case when note.SEQUENCE_ID = 130 and year(note.note_date_time) =YEAR($P{date3112sql}) then note.nota else null end) as "Nota Monitoraggio 1° quadrimestre",
	max(case when mon.transaction_date = $P{date3108sql} then mon.uom_code else null end) as "Monitoraggio 2° quadrimestre",
	max(case when note.SEQUENCE_ID = 140 and year(note.note_date_time) = YEAR($P{date3112sql}) then note.nota else null end) as "Nota Monitoraggio 2° quadrimestre",
	obo.etch as "Codice obiettivo operativo di ente",
	obo.WORK_EFFORT_NAME as "Descrizione obiettivo operativo di ente",
	concat(obo.etch, ' - ', obo.WORK_EFFORT_NAME) as "Obiettivo operativo di ente"
from work_effort perf
/* AREA ORGANIZZATIVA */
join work_effort_assoc wea on wea.WORK_EFFORT_ID_FROM = perf.WORK_EFFORT_ID and wea.WORK_EFFORT_ASSOC_TYPE_ID = '20S2ORG'
join work_effort areao on areao.WORK_EFFORT_ID = wea.WORK_EFFORT_ID_TO and areao.WORK_EFFORT_TYPE_ID = '20S22ARE' and areao.WORK_EFFORT_REVISION_ID is null
	and areao.ESTIMATED_START_DATE <= $P{date3112sql} and (areao.ESTIMATED_COMPLETION_DATE >= $P{date0101sql} or areao.ESTIMATED_COMPLETION_DATE is null)
/* STRUTTURA ORGANIZZATIVA E OBIETTIVO OPERATIVO DI STRUTTURA */
join (
	select 
		obos.ORGANIZATION_ID,
		obos.CURRENT_STATUS_ID,
		obos.ORG_UNIT_ROLE_TYPE_ID,
		obos.ESTIMATED_COMPLETION_DATE,
		obos.ESTIMATED_START_DATE,
		wea.WORK_EFFORT_ID_FROM,
		wea.ASSOC_WEIGHT as peso,
		obos.WORK_EFFORT_ID,
		obos.WORK_EFFORT_TYPE_ID,
		wept.description,
		obos.ETCH,
		obos.ORG_UNIT_ID,
		obos.WORK_EFFORT_NAME,
		null as etch_struttura,
		null as nome_struttura,
		null as raggiungimento
	from work_effort_assoc wea
	join work_effort obos on obos.WORK_EFFORT_ID = wea.WORK_EFFORT_ID_TO and obos.WORK_EFFORT_TYPE_ID in ('20S26OOP', '20S26OOR') and obos.WORK_EFFORT_REVISION_ID is null
		and obos.ESTIMATED_START_DATE <= $P{date3112sql} and (obos.ESTIMATED_COMPLETION_DATE >= $P{date0101sql} or obos.ESTIMATED_COMPLETION_DATE is null)
	join work_effort_purpose_type wept on wept.WORK_EFFORT_PURPOSE_TYPE_ID = obos.WORK_EFFORT_PURPOSE_TYPE_ID 
	where wea.WORK_EFFORT_ASSOC_TYPE_ID = '20S2ORG'
	union all
	select 
		obos.ORGANIZATION_ID,
		obos.CURRENT_STATUS_ID,
		obos.ORG_UNIT_ROLE_TYPE_ID,
		obos.ESTIMATED_COMPLETION_DATE,
		obos.ESTIMATED_START_DATE,
		wea.WORK_EFFORT_ID_FROM,
		wea2.ASSOC_WEIGHT as peso,
		obos.WORK_EFFORT_ID,
		strutt.WORK_EFFORT_TYPE_ID,
		wept.description,
		obos.ETCH,
		obos.ORG_UNIT_ID,
		obos.WORK_EFFORT_NAME,
		strutt.etch as etch_struttura,
		strutt.work_effort_name as nome_struttura,
		scorestr.raggiungimento as raggiungimento
	from work_effort_assoc wea
	join work_effort strutt on strutt.WORK_EFFORT_ID = wea.WORK_EFFORT_ID_TO and strutt.WORK_EFFORT_TYPE_ID = '20S24STR' and strutt.WORK_EFFORT_REVISION_ID is null
		and strutt.ESTIMATED_START_DATE <= $P{date3112sql} and (strutt.ESTIMATED_COMPLETION_DATE >= $P{date0101sql} or strutt.ESTIMATED_COMPLETION_DATE is null)
	left join work_effort_assoc wea2 on wea2.WORK_EFFORT_ID_FROM = strutt.WORK_EFFORT_ID and wea2.WORK_EFFORT_ASSOC_TYPE_ID = '20S2STR'
	left join work_effort obos on obos.WORK_EFFORT_ID = wea2.WORK_EFFORT_ID_TO and obos.WORK_EFFORT_TYPE_ID in ('20S26OOP', '20S26OOR') and obos.WORK_EFFORT_REVISION_ID is null
		and obos.ESTIMATED_START_DATE <= $P{date3112sql} and (obos.ESTIMATED_COMPLETION_DATE >= $P{date0101sql} or obos.ESTIMATED_COMPLETION_DATE is null)
	join work_effort_purpose_type wept on wept.WORK_EFFORT_PURPOSE_TYPE_ID = obos.WORK_EFFORT_PURPOSE_TYPE_ID 
	/* RISULTATO STRUTTURA */
	left join (
			select 
				wem.work_effort_id,
				ate.amount as raggiungimento
			from work_effort_measure wem 
			left join acctg_trans act on act.voucher_ref = wem.work_effort_measure_id and act.transaction_date = $P{date3112sql}
			left join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id 
			where wem.gl_account_id = 'SCORE'
		) scorestr on scorestr.work_effort_id = strutt.WORK_EFFORT_ID 	
		where wea.WORK_EFFORT_ASSOC_TYPE_ID = '20S2ORG'
) FIL_W on FIL_W.work_effort_id_from = areao.WORK_EFFORT_ID
/* PRENDO IL RESPONSABILE DELLA STRUTTURA ORGANIZZATIVA */
join 
	(select p.party_name, p2.party_id from party p	
		inner join party_relationship pr on pr.PARTY_ID_to = p.PARTY_ID
		inner join party p2 on p2.party_id = pr.party_id_from 
		where pr.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE' and pr.thru_date is null) as resp on resp.PARTY_ID = FIL_W.ORG_UNIT_ID
		
/* START filterInnerJoin */
   $P!{filterInnerJoinString} 
/* END filterInnerJoin */
/* START filterLeftJoin */
  $P!{filterLeftJoinString} 
/* END filterLeftJoin */		
		
/* OBIETTIVO OPERATIVO DI ENTE */
left join work_effort_assoc wea2 on wea2.WORK_EFFORT_ID_TO = FIL_W.WORK_EFFORT_ID and wea2.WORK_EFFORT_ASSOC_TYPE_ID = '20D2OBO'
left join work_effort obo on obo.WORK_EFFORT_ID = wea2.WORK_EFFORT_ID_FROM and obo.WORK_EFFORT_TYPE_ID = '20D26OBO' and obo.WORK_EFFORT_REVISION_ID is null
	and obo.ESTIMATED_START_DATE <= $P{date3112sql} and (obo.ESTIMATED_COMPLETION_DATE >= $P{date0101sql} or obo.ESTIMATED_COMPLETION_DATE is null)
/* NOTE */
left join (
	select 
		wen.WORK_EFFORT_ID,
		cast(nd.NOTE_INFO as char) as nota,
		wen.SEQUENCE_ID,
		nd.NOTE_DATE_TIME 
	from work_effort_note wen
	join note_data nd on nd.NOTE_ID = wen.NOTE_ID
) note on note.work_effort_id = FIL_W.WORK_EFFORT_ID
/* INDICATORI */
left join (
	select 
		wetav.M_WORK_EFFORT_ID,
		wetav.G_ACCOUNT_NAME,
		wetav.G_UOM_TYPE_ID,
		wetav.G_ACCOUNT_CODE,
		wetav.tt_description,
		wetav.TM_AMOUNT,
		wetav.TT_GL_FISCAL_TYPE_ID,
		wetav.M_KPI_SCORE_WEIGHT,
		wetav.TT_TRANSACTION_DATE,
		gamrs.UOM_CODE 
	from work_effort_trans_all_view wetav
	join work_effort_purpose_account wepa on wepa.GL_ACCOUNT_ID = wetav.G_GL_ACCOUNT_ID and wepa.WORK_EFFORT_PURPOSE_TYPE_ID = 'ORGOOP'
	left join gl_account_meas_rat_sc gamrs on gamrs.GL_ACCOUNT_ID = wetav.M_GL_ACCOUNT_ID 
		and gamrs.UOM_RATING_VALUE <= wetav.TM_AMOUNT and gamrs.UOM_RATING_VALUE >= wetav.TM_AMOUNT
	where (wetav.G_GL_ACCOUNT_ID <> 'SCORE' or wetav.G_GL_ACCOUNT_ID is null)
		and wetav.G_ACCOUNT_TYPE_ENUM_ID = 'INDICATOR'
		and wetav.M_FROM_DATE <= $P{date3112sql}
		and (wetav.M_THRU_DATE >= $P{date0101sql} or wetav.M_THRU_DATE is null) and wetav.TT_TRANSACTION_DATE = $P{date3112sql}
) indic on indic.m_work_effort_id = FIL_W.WORK_EFFORT_ID
/* MONITORAGGIO */
left join (
	select
		wem.WORK_EFFORT_ID,
		act.TRANSACTION_DATE,
		gamrs.UOM_CODE ,
		ate.AMOUNT
	from work_effort_measure wem 
	join acctg_trans act on act.VOUCHER_REF = wem.WORK_EFFORT_MEASURE_ID
	join acctg_trans_entry ate on ate.ACCTG_TRANS_ID = act.ACCTG_TRANS_ID and ate.GL_ACCOUNT_ID = '10023'
	left join gl_account_meas_rat_sc gamrs on gamrs.GL_ACCOUNT_ID = ate.GL_ACCOUNT_ID 
		and gamrs.UOM_RATING_VALUE <= ate.AMOUNT and gamrs.UOM_RATING_VALUE >= ate.AMOUNT
) mon on mon.work_effort_id = FIL_W.WORK_EFFORT_ID
/* RISULTATO */
left join (
	select
		wem.work_effort_id,
		ate.amount
	from work_effort_measure wem 
	join acctg_trans act on act.voucher_ref = wem.WORK_EFFORT_MEASURE_ID and act.TRANSACTION_DATE = $P{date3112sql}
	join acctg_trans_entry ate on ate.acctg_trans_id = act.ACCTG_TRANS_ID and ate.GL_FISCAL_TYPE_ID = 'ACTUAL' and ate.GL_ACCOUNT_ID = 'SCORE'
) score on score.work_effort_id = FIL_W.WORK_EFFORT_ID
where perf.WORK_EFFORT_TYPE_ID = '20S20ORG' and perf.WORK_EFFORT_REVISION_ID is null
	and perf.ESTIMATED_START_DATE <= $P{date3112sql} and (perf.ESTIMATED_COMPLETION_DATE >= $P{date0101sql} or perf.ESTIMATED_COMPLETION_DATE is null)
	and (perf.org_unit_id = $P{orgUnitId} or $P{orgUnitId} is null or $P{orgUnitId} = '')
	and (perf.work_effort_id = $P{workEffortId} or $P{workEffortId} is null or $P{workEffortId} = '')
	$P!{enumerationString} 
/* START filterWhere */
 $P!{filterWhereString} 
/* END filterWhere */	
group by
	areao.WORK_EFFORT_NAME,
	FIL_W.nome_struttura,
	FIL_W.WORK_EFFORT_ID,
	concat(FIL_W.etch_struttura, ' - ', FIL_W.nome_struttura),
	concat(FIL_W.etch, ' - ', FIL_W.WORK_EFFORT_NAME),
	FIL_W.DESCRIPTION,
	FIL_W.ORG_UNIT_ID,
	indic.g_account_code,
	indic.g_account_name,
	indic.tt_description,
	indic.M_KPI_SCORE_WEIGHT,
	resp.party_name,
	FIL_W.peso,
	FIL_W.raggiungimento,
	concat(obo.etch, ' - ', obo.WORK_EFFORT_NAME),
	indic.g_account_name,
	score.amount,
	obo.etch,
	obo.WORK_EFFORT_NAME
order by
	areao.WORK_EFFORT_NAME,
	concat(FIL_W.etch_struttura, ' - ', FIL_W.nome_struttura),
	concat(FIL_W.etch, ' - ', FIL_W.WORK_EFFORT_NAME)]]>
	</queryString>
