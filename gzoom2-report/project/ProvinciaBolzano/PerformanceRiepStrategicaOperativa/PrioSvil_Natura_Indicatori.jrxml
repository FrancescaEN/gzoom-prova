	<parameter name="work_effort_id_ob" class="java.lang.String" isForPrompting="false"/>
	<parameter name="customTimePeriod" class="java.lang.String" isForPrompting="false"/>
	<parameter name="langLocale" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[select INDIC.ETICHETTA_INDICATORE,
	INDIC.NOME_INDICATORE_IT,
	INDIC.NOME_INDICATORE_DE,
	INDIC.ID_INDICATORE,
	IND.UDM_IT,
	IND.UDM_DE,
	IND.NATURA_IT,
	IND.NATURA_DE,
	MAX(CASE WHEN INDIC.ANNO_RIFERIMENTO = EXTRACT(YEAR FROM TO_DATE('$P!{customTimePeriod}','YYYY-MM-DD')) THEN INDIC.TARGET_INDICATORE_IT ELSE NULL END)  TARGET_IT,
	MAX(CASE WHEN INDIC.ANNO_RIFERIMENTO = EXTRACT(YEAR FROM TO_DATE('$P!{customTimePeriod}','YYYY-MM-DD')) THEN INDIC.TARGET_INDICATORE_DE ELSE NULL END)  TARGET_DE, 	
	
	MAX(CASE WHEN INDIC.ANNO_RIFERIMENTO = EXTRACT(YEAR FROM TO_DATE('$P!{customTimePeriod}','YYYY-MM-DD'))+1 THEN INDIC.TARGET_INDICATORE_IT ELSE NULL END)  TARGET_IT_P1,
	MAX(CASE WHEN INDIC.ANNO_RIFERIMENTO = EXTRACT(YEAR FROM TO_DATE('$P!{customTimePeriod}','YYYY-MM-DD'))+1 THEN INDIC.TARGET_INDICATORE_DE ELSE NULL END)  TARGET_DE_P1,  
	
	MAX(CASE WHEN INDIC.ANNO_RIFERIMENTO = EXTRACT(YEAR FROM TO_DATE('$P!{customTimePeriod}','YYYY-MM-DD'))+2 THEN INDIC.TARGET_INDICATORE_IT ELSE NULL END)  TARGET_IT_P2,
	MAX(CASE WHEN INDIC.ANNO_RIFERIMENTO = EXTRACT(YEAR FROM TO_DATE('$P!{customTimePeriod}','YYYY-MM-DD'))+2 THEN INDIC.TARGET_INDICATORE_DE ELSE NULL END)  TARGET_DE_P2,	
	
	MAX(CASE WHEN INDIC.ANNO_RIFERIMENTO = EXTRACT(YEAR FROM TO_DATE('$P!{customTimePeriod}','YYYY-MM-DD'))-2 THEN INDIC.CONSUNTIVO_INDICATORE_IT ELSE NULL END)  CONSUNTIVO_IT_M2,
	MAX(CASE WHEN INDIC.ANNO_RIFERIMENTO = EXTRACT(YEAR FROM TO_DATE('$P!{customTimePeriod}','YYYY-MM-DD'))-2 THEN INDIC.CONSUNTIVO_INDICATORE_DE ELSE NULL END)  CONSUNTIVO_DE_M2, 
	MAX(CASE WHEN INDIC.ANNO_RIFERIMENTO = EXTRACT(YEAR FROM TO_DATE('$P!{customTimePeriod}','YYYY-MM-DD'))-1 THEN INDIC.CONSUNTIVO_INDICATORE_IT ELSE NULL END)  CONSUNTIVO_IT_M1,
	MAX(CASE WHEN INDIC.ANNO_RIFERIMENTO = EXTRACT(YEAR FROM TO_DATE('$P!{customTimePeriod}','YYYY-MM-DD'))-1 THEN INDIC.CONSUNTIVO_INDICATORE_DE ELSE NULL END)  CONSUNTIVO_DE_M1, 
	MAX(CASE WHEN INDIC.ANNO_RIFERIMENTO = EXTRACT(YEAR FROM TO_DATE('$P!{customTimePeriod}','YYYY-MM-DD')) THEN INDIC.CONSUNTIVO_INDICATORE_IT ELSE NULL END)  CONSUNTIVO_IT,
	MAX(CASE WHEN INDIC.ANNO_RIFERIMENTO = EXTRACT(YEAR FROM TO_DATE('$P!{customTimePeriod}','YYYY-MM-DD')) THEN INDIC.CONSUNTIVO_INDICATORE_DE ELSE NULL END)  CONSUNTIVO_DE
from VW_PRESTAZIONI_INDIC INDIC
JOIN VW_INDICATORI IND ON IND.ID_INDICATORE = INDIC.ID_INDICATORE
where INDIC.ID_PRESTAZIONE = $P{work_effort_id_ob}
GROUP BY INDIC.ETICHETTA_INDICATORE,
	INDIC.NOME_INDICATORE_IT,
	INDIC.NOME_INDICATORE_DE,
	INDIC.ID_INDICATORE,
	IND.UDM_IT,
	IND.UDM_DE,
	IND.NATURA_IT,
	IND.NATURA_DE
ORDER BY INDIC.ETICHETTA_INDICATORE]]>
	</queryString>
