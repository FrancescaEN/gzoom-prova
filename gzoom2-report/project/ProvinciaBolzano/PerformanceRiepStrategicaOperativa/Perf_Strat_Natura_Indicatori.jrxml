	<queryString>
		<![CDATA[select
	WEM.SEQUENCE_ID AS ETICHETTA_INDICATORE,
	GL.ACCOUNT_NAME_LANG AS NOME_INDICATORE_IT,
	GL.ACCOUNT_NAME AS NOME_INDICATORE_DE,
	GL.GL_ACCOUNT_ID AS ID_INDICATORE,
	U.ABBREVIATION_LANG AS UDM_IT,
	U.ABBREVIATION AS UDM_DE,
	GRT.DESCRIPTION_LANG AS NATURA_IT,
	GRT.DESCRIPTION AS NATURA_DE,
	U.UOM_TYPE_ID AS TIPO_INDICATORE,
	GL.SOURCE_LANG AS STANDARD_QUALITA_IT,
	GL.SOURCE AS STANDARD_QUALITA_DE,
	TARGET_IT,
	TARGET_DE,
	TARGET_NUMERO,
	TARGET_IT_P1,
	TARGET_DE_P1,
	TARGET_NUMERO_P1,
	TARGET_IT_P2,
	TARGET_DE_P2,
	TARGET_NUMERO_P2,
	CONSUNTIVO_IT_M3,
	CONSUNTIVO_DE_M3,
	CONSUNTIVO_NUMERO_M3,
	CONSUNTIVO_IT_M2,
	CONSUNTIVO_DE_M2,
	CONSUNTIVO_NUMERO_M2,
	CONSUNTIVO_IT_M1,
	CONSUNTIVO_DE_M1,
	CONSUNTIVO_NUMERO_M1
/* OBIETTIVO STRATEGICO */
FROM WORK_EFFORT OBS
/* INDICATORI */
JOIN WORK_EFFORT_MEASURE WEM ON WEM.WORK_EFFORT_ID = OBS.WORK_EFFORT_ID AND wem.FROM_DATE<=TO_DATE($P{customTimePeriodNatura3112},'YYYY-MM-DD') AND wem.THRU_DATE >=TO_DATE($P{customTimePeriodNatura0101},'YYYY-MM-DD')
JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID
JOIN UOM U ON U.UOM_ID = GL.DEFAULT_UOM_ID
LEFT JOIN GL_RESOURCE_TYPE GRT ON GRT.GL_RESOURCE_TYPE_ID = GL.GL_RESOURCE_TYPE_ID
JOIN WORK_EFFORT_PURPOSE_ACCOUNT WEPA ON WEPA.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID AND WEPA.WORK_EFFORT_PURPOSE_TYPE_ID IN ('PRFPREFTE', 'PRFKPI')
LEFT JOIN (
	SELECT
		ATE.GL_ACCOUNT_ID,
		ATE.VOUCHER_REF,
		MAX(CASE WHEN ACT.TRANSACTION_DATE = TO_DATE($P{customTimePeriod},'YYYY-MM-DD') AND ATE.GL_FISCAL_TYPE_ID = 'BUDGET' THEN GAMRS.UOM_DESCR_LANG ELSE NULL END) AS TARGET_IT,
		MAX(CASE WHEN ACT.TRANSACTION_DATE = TO_DATE($P{customTimePeriod},'YYYY-MM-DD') AND ATE.GL_FISCAL_TYPE_ID = 'BUDGET' THEN GAMRS.UOM_DESCR ELSE NULL END) AS TARGET_DE,
		MAX(CASE WHEN ACT.TRANSACTION_DATE = TO_DATE($P{customTimePeriod},'YYYY-MM-DD') AND ATE.GL_FISCAL_TYPE_ID = 'BUDGET' THEN ATE.AMOUNT ELSE NULL END) AS TARGET_NUMERO,
		MAX(CASE WHEN ACT.TRANSACTION_DATE = TO_DATE($P{customTimePeriodP1},'YYYY-MM-DD') AND ATE.GL_FISCAL_TYPE_ID = 'BUDGET' THEN GAMRS.UOM_DESCR_LANG ELSE NULL END) AS TARGET_IT_P1,
		MAX(CASE WHEN ACT.TRANSACTION_DATE = TO_DATE($P{customTimePeriodP1},'YYYY-MM-DD') AND ATE.GL_FISCAL_TYPE_ID = 'BUDGET' THEN GAMRS.UOM_DESCR ELSE NULL END) AS TARGET_DE_P1,
		MAX(CASE WHEN ACT.TRANSACTION_DATE = TO_DATE($P{customTimePeriodP1},'YYYY-MM-DD') AND ATE.GL_FISCAL_TYPE_ID = 'BUDGET' THEN ATE.AMOUNT ELSE NULL END) AS TARGET_NUMERO_P1,
		MAX(CASE WHEN ACT.TRANSACTION_DATE = TO_DATE($P{customTimePeriodP2},'YYYY-MM-DD') AND ATE.GL_FISCAL_TYPE_ID = 'BUDGET' THEN GAMRS.UOM_DESCR_LANG ELSE NULL END) AS TARGET_IT_P2,
		MAX(CASE WHEN ACT.TRANSACTION_DATE = TO_DATE($P{customTimePeriodP2},'YYYY-MM-DD') AND ATE.GL_FISCAL_TYPE_ID = 'BUDGET' THEN GAMRS.UOM_DESCR ELSE NULL END) AS TARGET_DE_P2,
		MAX(CASE WHEN ACT.TRANSACTION_DATE = TO_DATE($P{customTimePeriodP2},'YYYY-MM-DD') AND ATE.GL_FISCAL_TYPE_ID = 'BUDGET' THEN ATE.AMOUNT ELSE NULL END) AS TARGET_NUMERO_P2,
		MAX(CASE WHEN ACT.TRANSACTION_DATE = TO_DATE($P{customTimePeriodM3},'YYYY-MM-DD') AND ATE.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN GAMRS.UOM_DESCR_LANG ELSE NULL END) AS CONSUNTIVO_IT_M3,
		MAX(CASE WHEN ACT.TRANSACTION_DATE = TO_DATE($P{customTimePeriodM3},'YYYY-MM-DD') AND ATE.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN GAMRS.UOM_DESCR ELSE NULL END) AS CONSUNTIVO_DE_M3,
		MAX(CASE WHEN ACT.TRANSACTION_DATE = TO_DATE($P{customTimePeriodM3},'YYYY-MM-DD') AND ATE.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN ATE.AMOUNT ELSE NULL END) AS CONSUNTIVO_NUMERO_M3,
		MAX(CASE WHEN ACT.TRANSACTION_DATE = TO_DATE($P{customTimePeriodM2},'YYYY-MM-DD') AND ATE.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN GAMRS.UOM_DESCR_LANG ELSE NULL END) AS CONSUNTIVO_IT_M2,
		MAX(CASE WHEN ACT.TRANSACTION_DATE = TO_DATE($P{customTimePeriodM2},'YYYY-MM-DD') AND ATE.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN GAMRS.UOM_DESCR ELSE NULL END) AS CONSUNTIVO_DE_M2,
		MAX(CASE WHEN ACT.TRANSACTION_DATE = TO_DATE($P{customTimePeriodM2},'YYYY-MM-DD') AND ATE.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN ATE.AMOUNT ELSE NULL END) AS CONSUNTIVO_NUMERO_M2,
		MAX(CASE WHEN ACT.TRANSACTION_DATE = TO_DATE($P{customTimePeriodM1},'YYYY-MM-DD') AND ATE.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN GAMRS.UOM_DESCR_LANG ELSE NULL END) AS CONSUNTIVO_IT_M1,
		MAX(CASE WHEN ACT.TRANSACTION_DATE = TO_DATE($P{customTimePeriodM1},'YYYY-MM-DD') AND ATE.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN GAMRS.UOM_DESCR ELSE NULL END) AS CONSUNTIVO_DE_M1,
		MAX(CASE WHEN ACT.TRANSACTION_DATE = TO_DATE($P{customTimePeriodM1},'YYYY-MM-DD') AND ATE.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN ATE.AMOUNT ELSE NULL END) AS CONSUNTIVO_NUMERO_M1
	FROM ACCTG_TRANS_ENTRY ATE
	JOIN ACCTG_TRANS ACT ON ACT.ACCTG_TRANS_ID = ATE.ACCTG_TRANS_ID
	LEFT JOIN GL_ACCOUNT_MEAS_RAT_SC GAMRS ON GAMRS.GL_ACCOUNT_ID = ATE.GL_ACCOUNT_ID
		AND GAMRS.UOM_RATING_VALUE = ATE.AMOUNT
	GROUP BY
		ATE.GL_ACCOUNT_ID,
		ATE.VOUCHER_REF
) INDIC ON INDIC.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID AND GL.INPUT_ENUM_ID = 'ACCINP_UO'
	OR (GL.INPUT_ENUM_ID = 'ACCINP_OBJ' AND INDIC.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID)
where OBS.WORK_EFFORT_ID = $P{work_effort_id_ob}
order by WEM.SEQUENCE_ID]]>
	</queryString>
