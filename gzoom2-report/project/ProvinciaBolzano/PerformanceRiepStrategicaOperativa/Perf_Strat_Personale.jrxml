	<queryString language="SQL">
		<![CDATA[SELECT
	OBO.WORK_EFFORT_ID AS ID_OBIETTIVO_OPERATIVO,
	PERS.NOME AS NOME_PERSONA_ASSEGNATA
/* OBIETTIVO OPERATIVO */
FROM WORK_EFFORT OBO
/* PERSONALE ASSEGNATO */
LEFT JOIN (
	SELECT 
		PE.PARTY_ID, WEPA.WORK_EFFORT_ID, PPRSOGG.PARENT_ROLE_CODE, SOGG.PARTY_NAME AS NOME, PE.EMPL_POSITION_TYPE_ID, QUAL.PARTY_NAME_LANG, QUAL.PARTY_NAME, PE.EMPLOYMENT_AMOUNT
	FROM WORK_EFFORT_PARTY_ASSIGNMENT WEPA
	JOIN PARTY SOGG ON SOGG.PARTY_ID = WEPA.PARTY_ID
	JOIN PARTY_PARENT_ROLE PPRSOGG ON PPRSOGG.PARTY_ID = SOGG.PARTY_ID
	JOIN PERSON PE ON PE.PARTY_ID = SOGG.PARTY_ID
	LEFT JOIN PARTY_RELATIONSHIP PR ON PR.PARTY_ID_FROM = SOGG.PARTY_ID AND PR.PARTY_RELATIONSHIP_TYPE_ID = 'QUALIF' AND PR.THRU_DATE IS NULL
	LEFT JOIN PARTY QUAL ON QUAL.PARTY_ID = PR.PARTY_ID_TO 
) PERS ON PERS.WORK_EFFORT_ID = OBO.WORK_EFFORT_ID 
WHERE OBO.WORK_EFFORT_TYPE_ID = '20P46' AND OBO.WORK_EFFORT_REVISION_ID IS NULL 
AND OBO.WORK_EFFORT_ID = $P{work_effort_id_ob}/* PASSATO DA SOPRA */
GROUP BY OBO.WORK_EFFORT_ID,PERS.NOME
ORDER BY PERS.NOME]]>
	</queryString>
