""]]></defaultValueExpression>
	</parameter>
	<parameter name="customTimePeriodNatura3112" class="java.lang.String">
		<defaultValueExpression><![CDATA[$P{customTimePeriodFormatted3112} != null ?
 ( ""+(INTEGER_VALUE($P{customTimePeriodFormatted3112}.substring(6, 10) ))  + "-"+  $P{customTimePeriodFormatted3112}.substring(3, 5) + "-" + $P{customTimePeriodFormatted3112}.substring(0, 2) ): 
""]]></defaultValueExpression>
	</parameter>
	<parameter name="workEffortTypeId" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
MAX(CASE WHEN ATE.GL_ACCOUNT_ID = '10101' AND AT.TRANSACTION_DATE = TO_DATE($P{customTimePeriod},'YYYY-MM-DD') AND ATE.GL_FISCAL_TYPE_ID = 'BUDGET' THEN ATE.AMOUNT ELSE NULL END) AS TARGET_ANNO,
MAX(CASE WHEN ATE.GL_ACCOUNT_ID = '10101' AND AT.TRANSACTION_DATE = TO_DATE($P{customTimePeriod},'YYYY-MM-DD') AND ATE.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN ATE.AMOUNT ELSE NULL END) AS CONSUNTIVO_ANNO,
MAX(CASE WHEN ATE.GL_ACCOUNT_ID = '10101' AND AT.TRANSACTION_DATE = TO_DATE($P{customTimePeriodP1},'YYYY-MM-DD') AND ATE.GL_FISCAL_TYPE_ID = 'BUDGET' THEN ATE.AMOUNT ELSE NULL END) AS TARGET_ANNO_1,
MAX(CASE WHEN ATE.GL_ACCOUNT_ID = '10101' AND AT.TRANSACTION_DATE = TO_DATE($P{customTimePeriodP2},'YYYY-MM-DD') AND ATE.GL_FISCAL_TYPE_ID = 'BUDGET' THEN ATE.AMOUNT ELSE NULL END) AS TARGET_ANNO_2,
MAX(CASE WHEN ATE.GL_ACCOUNT_ID = '10101' AND AT.TRANSACTION_DATE = TO_DATE($P{customTimePeriodM1},'YYYY-MM-DD') AND ATE.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN ATE.AMOUNT ELSE NULL END) AS CONSUNTIVO_ANNO_1,
MAX(CASE WHEN ATE.GL_ACCOUNT_ID = '10101' AND AT.TRANSACTION_DATE = TO_DATE($P{customTimePeriodM2},'YYYY-MM-DD') AND ATE.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN ATE.AMOUNT ELSE NULL END) AS CONSUNTIVO_ANNO_2,
MAX(CASE WHEN ATE.GL_ACCOUNT_ID = '10101' AND AT.TRANSACTION_DATE = TO_DATE($P{customTimePeriodM3},'YYYY-MM-DD') AND ATE.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN ATE.AMOUNT ELSE NULL END) AS CONSUNTIVO_ANNO_3,
GL.ACCOUNT_NAME$P!{langLocale} AS PERSONALE,
U.ABBREVIATION$P!{langLocale} AS UNITA_MISURA
FROM WORK_EFFORT_MEASURE WEM
JOIN ACCTG_TRANS AT ON AT.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID
JOIN ACCTG_TRANS_ENTRY ATE ON ATE.ACCTG_TRANS_ID = AT.ACCTG_TRANS_ID
JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID AND GL.GL_ACCOUNT_ID = '10101'
JOIN UOM U ON U.UOM_ID = GL.DEFAULT_UOM_ID
LEFT JOIN WORK_EFFORT OBS ON OBS.WORK_EFFORT_ID = WEM.WORK_EFFORT_ID

WHERE  
OBS.WORK_EFFORT_TYPE_ID = $P{workEffortTypeId}
AND 
OBS.WORK_EFFORT_REVISION_ID IS NULL
AND WEM.FROM_DATE <= TO_DATE( $P{customTimePeriodNatura3112} ,'YYYY-MM-DD') AND (WEM.THRU_DATE IS NULL OR WEM.THRU_DATE >= TO_DATE( $P{customTimePeriodNatura0101} ,'YYYY-MM-DD'))
AND OBS.WORK_EFFORT_ID = $P{work_effort_id_ob} 
GROUP BY
GL.ACCOUNT_NAME$P!{langLocale},
U.ABBREVIATION$P!{langLocale}]]>
	</queryString>
