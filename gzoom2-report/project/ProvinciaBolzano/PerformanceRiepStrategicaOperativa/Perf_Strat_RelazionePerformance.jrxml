	<queryString language="SQL">
		<![CDATA[select CONTENUTO_NOTA_IT,CONTENUTO_NOTA_DE from VW_OB_STRATEGICO_NOTE 
where ID_OBIETTIVO_STRATEGICO = $P{work_effort_id_ob}
and SEQUENZA_NOTA = 120
$P!{filterCustomTimePeriod_NoteRel}]]>
	</queryString>
