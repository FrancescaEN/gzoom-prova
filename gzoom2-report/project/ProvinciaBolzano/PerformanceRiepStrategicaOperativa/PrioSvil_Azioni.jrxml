	</parameter>
	<queryString>
		<![CDATA[SELECT
	AZI.WORK_EFFORT_NAME_LANG AS NOME_AZIONE_IT,
	AZI.WORK_EFFORT_NAME AS NOME_AZIONE_DE,
	TO_CHAR(AZI.ESTIMATED_START_DATE, 'DD/MM/YYYY') AS DATA_INIZIO_AZIONE,
	TO_CHAR(AZI.ESTIMATED_COMPLETION_DATE, 'DD/MM/YYYY') AS DATA_FINE_AZIONE,
	AZI.WORK_EFFORT_ID AS ID_AZIONE
/* PRIORITA DI SVILUPPO */
FROM WORK_EFFORT PRIO
/* AZIONI */
JOIN WORK_EFFORT_ASSOC WEA ON WEA.WORK_EFFORT_ID_FROM = PRIO.WORK_EFFORT_ID AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '20D64'
JOIN WORK_EFFORT AZI ON	AZI.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_TO AND AZI.WORK_EFFORT_TYPE_ID = '20D66' AND AZI.WORK_EFFORT_REVISION_ID IS NULL
WHERE PRIO.WORK_EFFORT_TYPE_ID = '20D64' AND PRIO.WORK_EFFORT_REVISION_ID IS NULL AND PRIO.WORK_EFFORT_ID = $P{work_effort_id_ob}
	AND AZI.ESTIMATED_START_DATE <= TO_DATE($P{customTimePeriodFormattedP2},'DD/MM/YYYY')
	AND AZI.ESTIMATED_COMPLETION_DATE >= TO_DATE($P{customTimePeriodFormatted0101M4},'DD/MM/YYYY')
ORDER BY
	PRIO.SOURCE_REFERENCE_ID,
	AZI.SOURCE_REFERENCE_ID]]>
	</queryString>
