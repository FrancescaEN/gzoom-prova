("AND TO_DATE(DATA_INIZIO_AZIONE,'DD/MM/YYYY') <= TO_DATE('" + $P{customTimePeriodFormattedP2} + "','DD/MM/YYYY') AND TO_DATE(DATA_FINE_AZIONE,'DD/MM/YYYY') >= TO_DATE('" + $P{customTimePeriodFormatted0101M4} + "','DD/MM/YYYY')" ) : ""]]></defaultValueExpression>
