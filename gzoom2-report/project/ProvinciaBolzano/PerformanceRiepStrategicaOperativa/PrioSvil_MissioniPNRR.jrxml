		<property name="com.jaspersoft.studio.field.label" value="NOME_MISSIONE_PNRR_IT"/>
	</field>
	<field name="NOME_MISSIONE_PNRR_DE" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="NOME_MISSIONE_PNRR_DE"/>
		<property name="com.jaspersoft.studio.field.label" value="NOME_MISSIONE_PNRR_DE"/>
	</field>
	<variable name="AGGREGATION" class="java.lang.String" resetType="Group" resetGroup="Gruppo1">
		<variableExpression><![CDATA[$V{AGGREGATION} 
+ ($V{AGGREGATION}.isEmpty() ? "<html>" : "<br/>") 
+ (
    $P{langLocale}.equals("_LANG")
        ? (
            $F{NOME_MISSIONE_PNRR_IT} != null && !$F{NOME_MISSIONE_PNRR_IT}.isEmpty()
                ? $F{NOME_MISSIONE_PNRR_IT}
                : ""
        )
        : (
            $F{NOME_MISSIONE_PNRR_DE} != null && !$F{NOME_MISSIONE_PNRR_DE}.isEmpty()
                ? $F{NOME_MISSIONE_PNRR_DE}
                : ""
        )
)
+ "&nbsp;&nbsp;&nbsp;"]]></variableExpression>
		<initialValueExpression><![CDATA[""]]></initialValueExpression>
	</variable>
