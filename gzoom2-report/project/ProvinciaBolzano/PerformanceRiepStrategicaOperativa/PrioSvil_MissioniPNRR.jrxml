	<parameter name="langLocale" class="java.lang.String" isForPrompting="false"/>
	<parameter name="work_effort_id_ob" class="java.lang.String" isForPrompting="false"/>
	<queryString language="SQL">
		<![CDATA[SELECT
PRIO.WORK_EFFORT_ID AS ID_PRIORITA_SVILUPPO,
MISS.WORK_EFFORT_NAME_LANG AS NOME_MISSIONE_PNRR_IT,
MISS.WORK_EFFORT_NAME AS NOME_MISSIONE_PNRR_DE
FROM WORK_EFFORT PRIO
LEFT JOIN WORK_EFFORT_ASSOC WEA ON WEA.WORK_EFFORT_ID_TO = PRIO.WORK_EFFORT_ID AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '20R10C'
LEFT JOIN WORK_EFFORT MISS ON MISS.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_FROM AND MISS.WORK_EFFORT_TYPE_ID = '20R104' AND MISS.WORK_EFFORT_REVISION_ID IS NULL
WHERE PRIO.WORK_EFFORT_TYPE_ID = '20D64' AND PRIO.WORK_EFFORT_REVISION_ID IS NULL AND PRIO.WORK_EFFORT_ID = $P{work_effort_id_ob}
GROUP BY 	PRIO.WORK_EFFORT_ID,MISS.ETCH,MISS.WORK_EFFORT_NAME_LANG,MISS.WORK_EFFORT_NAME
ORDER BY MISS.ETCH]]>
	</queryString>
	<field name="ID_PRIORITA_SVILUPPO" class="java.lang.String">
