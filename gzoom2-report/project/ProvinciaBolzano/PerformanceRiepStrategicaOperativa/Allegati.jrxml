	<parameter name="langLocale" class="java.lang.String" isForPrompting="false"/>
	<parameter name="id_scheda" class="java.lang.String" isForPrompting="false"/>
	<parameter name="date3112sql" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
	C.DESCRIPTION_LANG AS ALLEGATO_IT,
	C.DESCRIPTION AS ALLEGATO_DE,
	SCHEDA.WORK_EFFORT_ID AS ID_SCHEDA
FROM WORK_EFFORT SCHEDA
JOIN WORK_EFFORT_CONTENT WEC ON WEC.WORK_EFFORT_ID = SCHEDA.WORK_EFFORT_ID 
JOIN CONTENT C ON C.CONTENT_ID = WEC.CONTENT_ID 
WHERE SCHEDA.WORK_EFFORT_REVISION_ID IS NULL 
	AND SCHEDA.WORK_EFFORT_ID = $P{id_scheda}
GROUP BY SCHEDA.WORK_EFFORT_ID,WEC.CONTENT_ID,C.DESCRIPTION_LANG,C.DESCRIPTION
ORDER BY WEC.CONTENT_ID]]>
	</queryString>
	<field name="ALLEGATO_IT" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="ALLEGATO_IT"/>
		<property name="com.jaspersoft.studio.field.label" value="ALLEGATO_IT"/>
	</field>
	<field name="ALLEGATO_DE" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="ALLEGATO_DE"/>
		<property name="com.jaspersoft.studio.field.label" value="ALLEGATO_DE"/>
	</field>
	<field name="ID_SCHEDA" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="ID_SCHEDA"/>
		<property name="com.jaspersoft.studio.field.label" value="ID_SCHEDA"/>
	</field>
	<variable name="AGGREGATION" class="java.lang.String" resetType="Group" resetGroup="Gruppo1">
		<variableExpression><![CDATA[$V{AGGREGATION} 
+ ($V{AGGREGATION}.isEmpty() ? "<html>" : ", ") 
+ (
    $P{langLocale}.equals("_LANG")
        ? (
            $F{ALLEGATO_IT} != null && !$F{ALLEGATO_IT}.isEmpty()
                ? $F{ALLEGATO_IT}
                : ""
        )
        : (
            $F{ALLEGATO_DE} != null && !$F{ALLEGATO_DE}.isEmpty()
                ? $F{ALLEGATO_DE}
                : ""
        )
)]]></variableExpression>
		<initialValueExpression><![CDATA[""]]></initialValueExpression>
	</variable>
	<group name="Gruppo1">
		<groupExpression><![CDATA[$F{ID_SCHEDA}]]></groupExpression>
