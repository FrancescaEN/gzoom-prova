	<queryString>
		<![CDATA[SELECT DISTINCT
	OBS.WORK_EFFORT_ID AS ID_OBIETTIVO_STRATEGICO,
	OBS.SOURCE_REFERENCE_ID AS CODICE_OBIETTIVO_STRATEGICO,
	OBS.ETCH AS ETICHETTA_OBIETTIVO_STRATEGICO,
	OBS.WORK_EFFORT_NAME_LANG AS NOME_OBIETTIVO_STRATEGICO_IT,
	OBS.WORK_EFFORT_NAME AS NOME_OBIETTIVO_STRATEGICO_DE,
	GOV.WORK_EFFORT_ID AS ID_PROGRAMMA_GOVERNO,
	GOV.WORK_EFFORT_NAME_LANG AS NOME_PROGRAMMA_GOVERNO_IT,
	GOV.WORK_EFFORT_NAME AS NOME_PROGRAMMA_GOVERNO_DE,
	CAR.PARIOPP_LANG AS VALORE_FLAG_PARIOPPORTUNITA,
	CAR.QUALITA_LANG AS VALORE_FLAG_STRUMENTI_QUALITA,
	CAR.PNC_LANG AS VALORE_FLAG_PNC,
	CAR.PARIOPP AS VALORE_FLAG_PARIOPPORTUNITA_DE,
	CAR.QUALITA AS VALORE_FLAG_STRUMENTI_QUALITA_DE,
	CAR.PNC AS VALORE_FLAG_PNC_DE,
	CAR.DEFP_LANG AS VALORE_FLAG_DEFP,
	CAR.SOST_LANG AS VALORE_FLAG_SOST,
	CAR.PNRR_LANG AS VALORE_FLAG_PNRR,
	CAR.VALP_LANG AS VALORE_FLAG_VALP,
	CAR.DEFP AS VALORE_FLAG_DEFP_DE,
	CAR.SOST AS VALORE_FLAG_SOST_DE,
	CAR.PNRR AS VALORE_FLAG_PNRR_DE,
	CAR.VALP AS VALORE_FLAG_VALP_DE,
	GRADO.VALORE_DE AS GRADO_DE,
	GRADO.VALORE_IT AS GRADO_IT,
	(SELECT COUNT(*)
		FROM WORK_EFFORT_MEASURE INDIC
		JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = INDIC.GL_ACCOUNT_ID
		WHERE INDIC.WORK_EFFORT_ID = OBS.WORK_EFFORT_ID AND GL.SOURCE_LANG = 'S'
			AND INDIC.FROM_DATE<=TO_DATE($P{date3112String},'YYYY-MM-DD') AND INDIC.THRU_DATE>=TO_DATE($P{date0101String},'YYYY-MM-DD')
	) AS CONTA_STANDARD_QUALITA,
	(SELECT COUNT(*)
		FROM WORK_EFFORT OBSTRA
		JOIN WORK_EFFORT_ASSOC WEA ON WEA.WORK_EFFORT_ID_TO = OBSTRA.WORK_EFFORT_ID AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '20R8C'
		JOIN WORK_EFFORT OBSOST ON OBSOST.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_FROM	AND OBSOST.WORK_EFFORT_TYPE_ID = '20R84' AND OBSOST.WORK_EFFORT_REVISION_ID IS NULL
		WHERE OBSTRA.WORK_EFFORT_TYPE_ID = '20D62' AND OBSTRA.WORK_EFFORT_REVISION_ID IS NULL AND OBSTRA.WORK_EFFORT_ID = OBS.WORK_EFFORT_ID
	) AS CONTA_OBIETTIVI2030
/* OBIETTIVO STRATEGICO */
FROM WORK_EFFORT OBS
/* STRUTTURA */
JOIN PARTY P ON	P.PARTY_ID = OBS.ORG_UNIT_ID
JOIN PARTY_PARENT_ROLE PPR ON PPR.PARTY_ID = P.PARTY_ID
/* COLLEGAMENTO A PROGRAMMA DI GOVERNO */
LEFT JOIN WORK_EFFORT_ASSOC WEA2 ON	WEA2.WORK_EFFORT_ID_TO = OBS.WORK_EFFORT_ID	AND WEA2.WORK_EFFORT_ASSOC_TYPE_ID = '20R14C'
LEFT JOIN WORK_EFFORT GOV ON GOV.WORK_EFFORT_ID = WEA2.WORK_EFFORT_ID_FROM AND GOV.WORK_EFFORT_TYPE_ID = '20R144' AND GOV.WORK_EFFORT_REVISION_ID IS NULL
/*GRADO DI RAGGIUNGIMENTO */
LEFT JOIN(
	SELECT
WEM.WORK_EFFORT_ID,
	GAMRS.UOM_CODE AS VALORE_DE,
	GAMRS.UOM_CODE_LANG AS VALORE_IT
FROM WORK_EFFORT_MEASURE WEM
JOIN ACCTG_TRANS ACT ON ACT.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID AND ACT.TRANSACTION_DATE = TO_DATE($P{date3112String},'YYYY-MM-DD')
JOIN ACCTG_TRANS_ENTRY ATE ON ATE.ACCTG_TRANS_ID = ACT.ACCTG_TRANS_ID AND ATE.GL_ACCOUNT_ID = '10096'
JOIN GL_ACCOUNT_MEAS_RAT_SC GAMRS ON GAMRS.GL_ACCOUNT_ID = ATE.GL_ACCOUNT_ID AND GAMRS.UOM_RATING_VALUE = ATE.AMOUNT
)GRADO ON GRADO.WORK_EFFORT_ID=OBS.WORK_EFFORT_ID
/* CARATTERISTICHE OBIETTIVO STRATEGICO */
LEFT JOIN (
	SELECT
		WEM.WORK_EFFORT_ID,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10090' THEN GAMRS.UOM_CODE_LANG ELSE NULL END) AS DEFP_LANG,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10091' THEN GAMRS.UOM_CODE_LANG ELSE NULL END) AS PARIOPP_LANG,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10092' THEN GAMRS.UOM_CODE_LANG ELSE NULL END) AS SOST_LANG,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10093' THEN GAMRS.UOM_CODE_LANG ELSE NULL END) AS QUALITA_LANG,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '11140' THEN GAMRS.UOM_CODE_LANG ELSE NULL END) AS PNRR_LANG,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '11141' THEN GAMRS.UOM_CODE_LANG ELSE NULL END) AS PNC_LANG,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '11549' THEN GAMRS.UOM_CODE_LANG ELSE NULL END) AS VALP_LANG,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10090' THEN GAMRS.UOM_CODE ELSE NULL END) AS DEFP,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10091' THEN GAMRS.UOM_CODE ELSE NULL END) AS PARIOPP,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10092' THEN GAMRS.UOM_CODE ELSE NULL END) AS SOST,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10093' THEN GAMRS.UOM_CODE ELSE NULL END) AS QUALITA,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '11140' THEN GAMRS.UOM_CODE ELSE NULL END) AS PNRR,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '11141' THEN GAMRS.UOM_CODE ELSE NULL END) AS PNC,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '11549' THEN GAMRS.UOM_CODE ELSE NULL END) AS VALP
	FROM WORK_EFFORT_MEASURE WEM
	JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID
	JOIN WORK_EFFORT_PURPOSE_ACCOUNT WEPA ON WEPA.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID	AND WEPA.WORK_EFFORT_PURPOSE_TYPE_ID = 'PRFOBSCAR'
	LEFT JOIN ACCTG_TRANS_ENTRY ATE ON ATE.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID
	LEFT JOIN GL_ACCOUNT_MEAS_RAT_SC GAMRS ON GAMRS.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID
		AND GAMRS.UOM_RATING_VALUE <= ATE.AMOUNT AND GAMRS.UOM_RATING_VALUE >= ATE.AMOUNT
	GROUP BY
		WEM.WORK_EFFORT_ID
) CAR ON CAR.WORK_EFFORT_ID = OBS.WORK_EFFORT_ID
/* OBIETTIVI DI SOSTENIBILITA */
LEFT JOIN WORK_EFFORT_ASSOC WEA ON WEA.WORK_EFFORT_ID_TO = OBS.WORK_EFFORT_ID AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '20R8C'
WHERE OBS.WORK_EFFORT_TYPE_ID = '20D62' AND OBS.WORK_EFFORT_REVISION_ID IS NULL AND OBS.ORG_UNIT_ID = $P{orgUnitId}
	AND OBS.ESTIMATED_START_DATE <= TO_DATE($P{customTimePeriodFormatted},'DD/MM/YYYY')
	AND OBS.ESTIMATED_COMPLETION_DATE >= TO_DATE($P{customTimePeriodFormatted0101},'DD/MM/YYYY')
	 $P!{workEffortIdStringStrat} 
ORDER BY CAST(REGEXP_REPLACE(OBS.ETCH, '[^0-9]', '') AS INTEGER)]]>
	</queryString>
	<field name="ID_OBIETTIVO_STRATEGICO" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="ID_OBIETTIVO_STRATEGICO"/>
		<property name="com.jaspersoft.studio.field.label" value="ID_OBIETTIVO_STRATEGICO"/>
