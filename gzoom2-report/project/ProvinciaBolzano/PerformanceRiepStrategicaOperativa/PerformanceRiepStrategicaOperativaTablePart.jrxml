	<group name="CodiceUfficioGruppo">
		<groupExpression><![CDATA[$F{CODICE_ESTERNO_UFFICIO}]]></groupExpression>
		<groupHeader>
			<band height="36">
				<property name="com.jaspersoft.studio.unit.height" value="px"/>
				<printWhenExpression><![CDATA[// Verifica che CODICE_ESTERNO_UFFICIO non sia nullo o vuoto
($F{CODICE_ESTERNO_UFFICIO} != null && LEN(TRIM($F{CODICE_ESTERNO_UFFICIO})) > 0)

&& (  // Almeno uno dei seguenti gruppi di condizioni deve essere vero:

    // 1. Report PPAP strategico + tipo CTX_BS o 20C42 + almeno una scheda prestazione
    (
        ($P{reportContentId}.equals("REP_RIESTR_PPAP_JR") || 
         $P{reportContentId}.equals("REP_RIERSTR_PPAP_JR"))
        &&
        ($P{workEffortTypeId}.equals("CTX_BS") || 
         $P{workEffortTypeId}.equals("20C42"))
        &&
        $F{CONTA_SCHEDE_PREST} > 0
    )

    ||

    // 2. Report PPAP strategico + tipo CTX_BS o 20D62 + almeno una scheda strategica
    (
        ($P{reportContentId}.equals("REP_RIESTR_PPAP_JR") || 
         $P{reportContentId}.equals("REP_RIERSTR_PPAP_JR"))
        &&
        ($P{workEffortTypeId}.equals("CTX_BS") || 
         $P{workEffortTypeId}.equals("20D62"))
        &&
        $F{CONTA_SCHEDE_STRAT} > 0
    )

    ||

    // 3. Report PPAP strategico + tipo CTX_BS o 20D64 + almeno una scheda priorità sviluppo
    (
        ($P{reportContentId}.equals("REP_RIESTR_PPAP_JR") || 
         $P{reportContentId}.equals("REP_RIERSTR_PPAP_JR"))
        &&
        ($P{workEffortTypeId}.equals("CTX_BS") || 
         $P{workEffortTypeId}.equals("20D64"))
        &&
        $F{CONTA_SCHEDE_PRIOSVIL} > 0
    )

    ||

    // 4. Report PPAP strategico + tipo CTX_BS o 20P46 + almeno una scheda operativa
    (
        ($P{reportContentId}.equals("REP_RIESTR_PPAP_JR") || 
         $P{reportContentId}.equals("REP_RIERSTR_PPAP_JR"))
        &&
        ($P{workEffortTypeId}.equals("CTX_BS") || 
         $P{workEffortTypeId}.equals("20P46"))
        &&
        $F{CONTA_SCHEDE_OPE} > 0
    )

)]]></printWhenExpression>
