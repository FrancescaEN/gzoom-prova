 ( ""+(INTEGER_VALUE($P{customTimePeriodFormatted3112}.substring(6, 10) ))  + "-"+  $P{customTimePeriodFormatted3112}.substring(3, 5) + "-" + $P{customTimePeriodFormatted3112}.substring(0, 2) ): 
""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT P.ID_INDICATORE,P.ETICHETTA_INDICATORE,
       P.COMMENTO_TARGET_IT,
       P.COMMENTO_TARGET_DE,
       P.COMMENTO_TARGET_IT_P1,
       P.COMMENTO_TARGET_DE_P1,
       P.COMMENTO_TARGET_IT_P2,
       P.COMMENTO_TARGET_DE_P2,
       P.COMMENTO_CONSUNTIVO_IT,
       P.COMMENTO_CONSUNTIVO_DE
FROM
(
SELECT
    WEM.GL_ACCOUNT_ID AS ID_INDICATORE,
	WEM.SEQUENCE_ID AS ETICHETTA_INDICATORE,
	MAX(CASE WHEN ACT.TRANSACTION_DATE = TO_DATE($P{customTimePeriod},'YYYY-MM-DD') AND ATE.GL_FISCAL_TYPE_ID = 'BUDGET' THEN ACT.DESCRIPTION_LANG ELSE NULL END)  COMMENTO_TARGET_IT,
	MAX(CASE WHEN ACT.TRANSACTION_DATE = TO_DATE($P{customTimePeriod},'YYYY-MM-DD') AND ATE.GL_FISCAL_TYPE_ID = 'BUDGET' THEN ACT.DESCRIPTION ELSE NULL END)  COMMENTO_TARGET_DE,
	MAX(CASE WHEN ACT.TRANSACTION_DATE = TO_DATE($P{customTimePeriodP1},'YYYY-MM-DD') AND ATE.GL_FISCAL_TYPE_ID = 'BUDGET' THEN ACT.DESCRIPTION_LANG ELSE NULL END)  COMMENTO_TARGET_IT_P1,
	MAX(CASE WHEN ACT.TRANSACTION_DATE = TO_DATE($P{customTimePeriodP1},'YYYY-MM-DD') AND ATE.GL_FISCAL_TYPE_ID = 'BUDGET' THEN ACT.DESCRIPTION ELSE NULL END)  COMMENTO_TARGET_DE_P1,
	MAX(CASE WHEN ACT.TRANSACTION_DATE = TO_DATE($P{customTimePeriodP2},'YYYY-MM-DD') AND ATE.GL_FISCAL_TYPE_ID = 'BUDGET' THEN ACT.DESCRIPTION_LANG ELSE NULL END)  COMMENTO_TARGET_IT_P2,
	MAX(CASE WHEN ACT.TRANSACTION_DATE = TO_DATE($P{customTimePeriodP2},'YYYY-MM-DD') AND ATE.GL_FISCAL_TYPE_ID = 'BUDGET' THEN ACT.DESCRIPTION ELSE NULL END)  COMMENTO_TARGET_DE_P2,
	MAX(CASE WHEN ACT.TRANSACTION_DATE = TO_DATE($P{customTimePeriod},'YYYY-MM-DD') AND ATE.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN ACT.DESCRIPTION_LANG ELSE NULL END)  COMMENTO_CONSUNTIVO_IT,
	MAX(CASE WHEN ACT.TRANSACTION_DATE = TO_DATE($P{customTimePeriod},'YYYY-MM-DD') AND ATE.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN ACT.DESCRIPTION ELSE NULL END)  COMMENTO_CONSUNTIVO_DE
/* PRESTAZIONE */
FROM WORK_EFFORT PRE
/* INDICATORI */
JOIN WORK_EFFORT_MEASURE WEM ON WEM.WORK_EFFORT_ID = PRE.WORK_EFFORT_ID   AND wem.from_date<=TO_DATE( $P{customTimePeriodCommenti3112} ,'YYYY-MM-DD') AND wem.THRU_DATE >=TO_DATE( $P{customTimePeriodCommenti0101} ,'YYYY-MM-DD')
JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID
JOIN WORK_EFFORT_PURPOSE_ACCOUNT WEPA ON WEPA.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID
JOIN ACCTG_TRANS_ENTRY ATE ON ATE.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID AND (GL.INPUT_ENUM_ID = 'ACCINP_UO' OR (GL.INPUT_ENUM_ID = 'ACCINP_OBJ' AND ATE.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID))
JOIN ACCTG_TRANS ACT ON ACT.ACCTG_TRANS_ID = ATE.ACCTG_TRANS_ID
where PRE.WORK_EFFORT_ID = $P{work_effort_id_ob}  AND PRE.WORK_EFFORT_TYPE_ID = '20C42' AND PRE.WORK_EFFORT_REVISION_ID IS NULL AND PRE.ORGANIZATION_ID = 'Company'
AND WEPA.WORK_EFFORT_PURPOSE_TYPE_ID IN ('PRFPREFTE', 'PRFKPI')
GROUP BY WEM.GL_ACCOUNT_ID, WEM.SEQUENCE_ID) P
WHERE P.COMMENTO_TARGET_IT IS NOT NULL
   OR P.COMMENTO_TARGET_DE IS NOT NULL
   OR P.COMMENTO_TARGET_IT_P1 IS NOT NULL
   OR P.COMMENTO_TARGET_DE_P1 IS NOT NULL
   OR P.COMMENTO_TARGET_IT_P2 IS NOT NULL
   OR P.COMMENTO_TARGET_DE_P2 IS NOT NULL
   OR P.COMMENTO_CONSUNTIVO_IT IS NOT NULL
   OR P.COMMENTO_CONSUNTIVO_DE IS NOT NULL
ORDER BY P.ETICHETTA_INDICATORE]]>
	</queryString>
