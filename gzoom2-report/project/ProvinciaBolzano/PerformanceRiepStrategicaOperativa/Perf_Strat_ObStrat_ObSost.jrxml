+ ($V{AGGREGATION}.isEmpty() ? "<html>" : "<br/>") 
+ (
    $P{langLocale}.equals("_LANG")
        ? (
            $F{NOME_OBIETTIVO_SOSTENIBILITA_IT} != null && !$F{NOME_OBIETTIVO_SOSTENIBILITA_IT}.isEmpty()
