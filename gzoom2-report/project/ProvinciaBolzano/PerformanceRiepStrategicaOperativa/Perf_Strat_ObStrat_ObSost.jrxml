	<queryString language="SQL">
		<![CDATA[SELECT 
	OBO.WORK_EFFORT_ID AS ID_OBIETTIVO_OPERATIVO,
	OBSOST.WORK_EFFORT_NAME_LANG AS NOME_OBIETTIVO_SOSTENIBILITA_IT,
	OBSOST.WORK_EFFORT_NAME AS NOME_OBIETTIVO_SOSTENIBILITA_DE
/* OBIETTIVO OPERATIVO */
FROM WORK_EFFORT OBO
/* COLLEGAMENTO A OBIETTIVI DI SOSTENIBILITA' */
LEFT JOIN WORK_EFFORT_ASSOC WEA5 ON WEA5.WORK_EFFORT_ID_TO = OBO.WORK_EFFORT_ID AND WEA5.WORK_EFFORT_ASSOC_TYPE_ID = '20R8C'
LEFT JOIN WORK_EFFORT OBSOST ON OBSOST.WORK_EFFORT_ID = WEA5.WORK_EFFORT_ID_FROM AND OBSOST.WORK_EFFORT_TYPE_ID = '20R84' AND OBSOST.WORK_EFFORT_REVISION_ID IS NULL
WHERE OBO.WORK_EFFORT_TYPE_ID = '20D62' AND OBO.WORK_EFFORT_REVISION_ID IS NULL
	AND OBO.WORK_EFFORT_ID = $P{work_effort_id_ob}/* PASSATO DA SOPRA */
GROUP BY 	OBO.WORK_EFFORT_ID,OBSOST.ETCH,OBSOST.WORK_EFFORT_NAME_LANG,OBSOST.WORK_EFFORT_NAME
ORDER BY OBSOST.ETCH]]>
	</queryString>
