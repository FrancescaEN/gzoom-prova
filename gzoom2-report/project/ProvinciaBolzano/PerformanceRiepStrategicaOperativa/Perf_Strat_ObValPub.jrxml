	</field>
	<field name="NOME_OBIETTIVO_VALORE_PUBBLICO_DE" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="NOME_OBIETTIVO_VALORE_PUBBLICO_DE"/>
		<property name="com.jaspersoft.studio.field.label" value="NOME_OBIETTIVO_VALORE_PUBBLICO_DE"/>
	</field>
