	<parameter name="workEffortTypeId" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
	DETT.WORK_EFFORT_NAME,
	DETT.WORK_EFFORT_NAME_LANG,
	DETT.ETCH,
	INDIC.LISTA_ITA,
	INDIC.LISTA_DE
/* PRESTAZIONE */
FROM WORK_EFFORT PRE
/* COLLEGAMENTO CON DETTAGLIO PRESTAZIONE */
JOIN WORK_EFFORT_ASSOC WEA ON WEA.WORK_EFFORT_ID_FROM = PRE.WORK_EFFORT_ID AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '20D8C'
	AND WEA.FROM_DATE <= TO_DATE($P{customTimePeriodNatura3112}, 'YYYY-MM-DD') AND WEA.THRU_DATE >= TO_DATE($P{customTimePeriodNatura0101}, 'YYYY-MM-DD') /* 3112 E 0101 ANNO */
JOIN WORK_EFFORT DETT ON DETT.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_TO AND DETT.WORK_EFFORT_TYPE_ID = '20D84'
/* INDICATORI COLLEGATI AL DETTAGLIO PRESTAZIONE */
/* 
LEFT JOIN (
	SELECT
		WEM.WORK_EFFORT_ID,
		LISTAGG(CONCAT(GL.ACCOUNT_CODE, CONCAT(' - ', CONCAT(GL.ACCOUNT_NAME_LANG, ',
')))) WITHIN GROUP (ORDER BY GL.ACCOUNT_CODE) AS LISTA_ITA,
		LISTAGG(CONCAT(GL.ACCOUNT_CODE, CONCAT(' - ', CONCAT(GL.ACCOUNT_NAME, ',
')))) WITHIN GROUP (ORDER BY GL.ACCOUNT_CODE) AS LISTA_DE
	FROM WORK_EFFORT_MEASURE WEM
	JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID
	GROUP BY WEM.WORK_EFFORT_ID
) INDIC ON INDIC.WORK_EFFORT_ID = DETT.WORK_EFFORT_ID
* */
LEFT JOIN (
  SELECT
    WEM.WORK_EFFORT_ID,
    RTRIM(
      XMLCAST(
        XMLAGG(
          XMLELEMENT(e, GL.ACCOUNT_CODE || ' - ' || GL.ACCOUNT_NAME_LANG || CHR(10))
          ORDER BY GL.ACCOUNT_CODE
        ) AS CLOB
      ),
      CHR(10)
    ) AS LISTA_ITA,
    RTRIM(
      XMLCAST(
        XMLAGG(
          XMLELEMENT(e, GL.ACCOUNT_CODE || ' - ' || GL.ACCOUNT_NAME || CHR(10))
          ORDER BY GL.ACCOUNT_CODE
        ) AS CLOB
      ),
      CHR(10)
    ) AS LISTA_DE
  FROM WORK_EFFORT_MEASURE WEM
  JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID
  GROUP BY WEM.WORK_EFFORT_ID
) INDIC
ON INDIC.WORK_EFFORT_ID = DETT.WORK_EFFORT_ID
WHERE PRE.WORK_EFFORT_ID = $P{work_effort_id_ob} ]]>
	</queryString>
