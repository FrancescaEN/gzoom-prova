	<queryString>
		<![CDATA[SELECT DISTINCT
	OBO.WORK_EFFORT_ID AS ID_OBIETTIVO_OPERATIVO,
	OBO.SOURCE_REFERENCE_ID AS CODICE_OBIETTIVO_OPERATIVO,
	OBO.ETCH AS ETICHETTA_OBIETTIVO_OPERATIVO,
	OBO.WORK_EFFORT_NAME_LANG AS NOME_OBIETTIVO_OPERATIVO_IT,
	OBO.WORK_EFFORT_NAME AS NOME_OBIETTIVO_OPERATIVO_DE,
	OBS.WORK_EFFORT_ID AS ID_OBIETTIVO_STRATEGICO,
	OBS.WORK_EFFORT_NAME_LANG AS NOME_OBIETTIVO_STRATEGICO_IT,
	OBS.WORK_EFFORT_NAME AS NOME_OBIETTIVO_STRATEGICO_DE,
	PRE.WORK_EFFORT_ID AS ID_PRESTAZIONE,
	PRE.WORK_EFFORT_NAME_LANG AS NOME_PRESTAZIONE_IT,
	PRE.WORK_EFFORT_NAME AS NOME_PRESTAZIONE_DE,
	PRIO.WORK_EFFORT_ID AS ID_PRIORITA,
	PRIO.WORK_EFFORT_NAME_LANG AS NOME_PRIORITA_IT,
	PRIO.WORK_EFFORT_NAME AS NOME_PRIORITA_DE,
	PROC.WORK_EFFORT_ID AS ID_PROCEDIMENTO,
	PROC.WORK_EFFORT_NAME_LANG AS NOME_PROCEDIMENTO_IT,
	PROC.WORK_EFFORT_NAME AS NOME_PROCEDIMENTO_DE,
	GRADO.VALORE_DE AS GRADO_DE,
	GRADO.VALORE_IT AS GRADO_IT,
	CAR.TRASVERSALE_LANG AS VALORE_FLAG_OBIETTIVO_TRASVERSALE,
	CAR.TRASVERSALE AS VALORE_FLAG_OBIETTIVO_TRASVERSALE_DE,
	CAR.PARIOPP_LANG AS VALORE_FLAG_PARIOPPORTUNITA,
	CAR.PARIOPP AS VALORE_FLAG_PARIOPPORTUNITA_DE,
	CAR.OBS_LANG AS VALORE_FLAG_COLLEGAMENTO_OBS,
	CAR.OBS AS VALORE_FLAG_COLLEGAMENTO_OBS_DE,
	CAR.PRESTAZIONE_LANG AS VALORE_FLAG_COLLEGAMENTO_PRESTAZIONE,
	CAR.PRESTAZIONE AS VALORE_FLAG_COLLEGAMENTO_PRESTAZIONE_DE,
	CAR.PRIORITA_LANG AS VALORE_FLAG_COLLEGAMENTO_PRIORITA,
	CAR.PRIORITA AS VALORE_FLAG_COLLEGAMENTO_PRIORITA_DE,
	CAR.PROCEDIMENTO_LANG AS VALORE_FLAG_COLLEGAMENTO_PROCEDIMENTO,
	CAR.PROCEDIMENTO AS VALORE_FLAG_COLLEGAMENTO_PROCEDIMENTO_DE,
	CAR.SOST_LANG AS VALORE_FLAG_SOSTENIBILITA,
	CAR.SOST AS VALORE_FLAG_SOSTENIBILITA_DE,
	CAR.STRUMENTI_LANG AS VALORE_FLAG_STRUMENTI,
	CAR.STRUMENTI AS VALORE_FLAG_STRUMENTI_DE,
	P.PARTY_NAME AS DIRIGENTE
/* OBIETTIVO OPERATIVO */
FROM WORK_EFFORT OBO
/* STRUTTURA OBIETTIVO OPERATIVO */
JOIN PARTY STRUTT ON STRUTT.PARTY_ID = OBO.ORG_UNIT_ID
JOIN PARTY_PARENT_ROLE PPRSTRUTT ON PPRSTRUTT.PARTY_ID = STRUTT.PARTY_ID
/* DIRIGENTE */
LEFT JOIN PARTY_RELATIONSHIP PR ON PR.PARTY_ID_FROM = STRUTT.PARTY_ID AND PR.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
	AND PR.FROM_DATE <= OBO.ESTIMATED_COMPLETION_DATE 
	AND (PR.THRU_DATE >= OBO.ESTIMATED_COMPLETION_DATE OR PR.THRU_DATE IS NULL)
LEFT JOIN PARTY P ON P.PARTY_ID = PR.PARTY_ID_TO 
/* COLLEGAMENTO A OBIETTIVO STRATEGICO */
LEFT JOIN WORK_EFFORT_ASSOC WEA ON WEA.WORK_EFFORT_ID_TO = OBO.WORK_EFFORT_ID AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '20D62'
LEFT JOIN WORK_EFFORT OBS ON OBS.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_FROM AND OBS.WORK_EFFORT_TYPE_ID = '20D62' AND OBS.WORK_EFFORT_REVISION_ID IS NULL
/* COLLEGAMENTO A PRESTAZIONE */
LEFT JOIN WORK_EFFORT_ASSOC WEA2 ON WEA2.WORK_EFFORT_ID_TO = OBO.WORK_EFFORT_ID AND WEA2.WORK_EFFORT_ASSOC_TYPE_ID = '20C42C'
LEFT JOIN WORK_EFFORT PRE ON PRE.WORK_EFFORT_ID = WEA2.WORK_EFFORT_ID_FROM AND PRE.WORK_EFFORT_TYPE_ID = '20C42' AND PRE.WORK_EFFORT_REVISION_ID IS NULL
/* COLLEGAMENTO A PRIORITA' DI SVILUPPO */
LEFT JOIN WORK_EFFORT_ASSOC WEA3 ON WEA3.WORK_EFFORT_ID_TO = OBO.WORK_EFFORT_ID AND WEA3.WORK_EFFORT_ASSOC_TYPE_ID = '20D64'
LEFT JOIN WORK_EFFORT PRIO ON PRIO.WORK_EFFORT_ID = WEA3.WORK_EFFORT_ID_FROM AND PRIO.WORK_EFFORT_TYPE_ID = '20D64' AND PRIO.WORK_EFFORT_REVISION_ID IS NULL
/* COLLEGAMENTO A PROCEDIMENTO */
LEFT JOIN WORK_EFFORT_ASSOC WEA4 ON WEA4.WORK_EFFORT_ID_TO = OBO.WORK_EFFORT_ID AND WEA4.WORK_EFFORT_ASSOC_TYPE_ID = '20C44C'
LEFT JOIN WORK_EFFORT PROC ON PROC.WORK_EFFORT_ID = WEA4.WORK_EFFORT_ID_FROM AND PROC.WORK_EFFORT_TYPE_ID = '20C44' AND PROC.WORK_EFFORT_REVISION_ID IS NULL
/*GRADO DI RAGGIUNGIMENTO */
LEFT JOIN(
	SELECT
WEM.WORK_EFFORT_ID,
	GAMRS.UOM_CODE AS VALORE_DE,
	GAMRS.UOM_CODE_LANG AS VALORE_IT
FROM WORK_EFFORT_MEASURE WEM
JOIN ACCTG_TRANS ACT ON ACT.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID AND ACT.TRANSACTION_DATE = TO_DATE($P{date3112String},'YYYY-MM-DD')
JOIN ACCTG_TRANS_ENTRY ATE ON ATE.ACCTG_TRANS_ID = ACT.ACCTG_TRANS_ID AND ATE.GL_ACCOUNT_ID = '10096'
JOIN GL_ACCOUNT_MEAS_RAT_SC GAMRS ON GAMRS.GL_ACCOUNT_ID = ATE.GL_ACCOUNT_ID AND GAMRS.UOM_RATING_VALUE = ATE.AMOUNT
)GRADO ON GRADO.WORK_EFFORT_ID=OBO.WORK_EFFORT_ID
/* CARATTERISTICHE OBIETTIVO OPERATIVO */
LEFT JOIN (
	SELECT 
		WEM.WORK_EFFORT_ID,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10091' THEN GAMRS.UOM_CODE_LANG ELSE NULL END) AS PARIOPP_LANG,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10091' THEN GAMRS.UOM_CODE ELSE NULL END) AS PARIOPP,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10091' THEN GL.ACCOUNT_NAME_LANG ELSE NULL END) AS NOME_PARIOPP_LANG,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10091' THEN GL.ACCOUNT_NAME ELSE NULL END) AS NOME_PARIOPP,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10092' THEN GAMRS.UOM_CODE_LANG ELSE NULL END) AS SOST_LANG,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10092' THEN GAMRS.UOM_CODE ELSE NULL END) AS SOST,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10092' THEN GL.ACCOUNT_NAME_LANG ELSE NULL END) AS NOME_SOST_LANG,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10092' THEN GL.ACCOUNT_NAME ELSE NULL END) AS NOME_SOST,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10093' THEN GAMRS.UOM_CODE_LANG ELSE NULL END) AS STRUMENTI_LANG,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10093' THEN GAMRS.UOM_CODE ELSE NULL END) AS STRUMENTI,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10093' THEN GL.ACCOUNT_NAME_LANG ELSE NULL END) AS NOME_STRUMENTI_LANG,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10093' THEN GL.ACCOUNT_NAME ELSE NULL END) AS NOME_STRUMENTI,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10824' THEN GAMRS.UOM_CODE_LANG ELSE NULL END) AS PROCEDIMENTO_LANG,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10824' THEN GAMRS.UOM_CODE ELSE NULL END) AS PROCEDIMENTO,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10824' THEN GL.ACCOUNT_NAME_LANG ELSE NULL END) AS NOME_PROCEDIMENTO_LANG,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10824' THEN GL.ACCOUNT_NAME ELSE NULL END) AS NOME_PROCEDIMENTO,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10821' THEN GAMRS.UOM_CODE_LANG ELSE NULL END) AS OBS_LANG,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10821' THEN GAMRS.UOM_CODE ELSE NULL END) AS OBS,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10821' THEN GL.ACCOUNT_NAME_LANG ELSE NULL END) AS NOME_OBS_LANG,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10821' THEN GL.ACCOUNT_NAME ELSE NULL END) AS NOME_OBS,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10822' THEN GAMRS.UOM_CODE_LANG ELSE NULL END) AS PRESTAZIONE_LANG,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10822' THEN GAMRS.UOM_CODE ELSE NULL END) AS PRESTAZIONE,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10822' THEN GL.ACCOUNT_NAME_LANG ELSE NULL END) AS NOME_PRESTAZIONE_LANG,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10822' THEN GL.ACCOUNT_NAME ELSE NULL END) AS NOME_PRESTAZIONE,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10823' THEN GAMRS.UOM_CODE_LANG ELSE NULL END) AS PRIORITA_LANG,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10823' THEN GAMRS.UOM_CODE ELSE NULL END) AS PRIORITA,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10823' THEN GL.ACCOUNT_NAME_LANG ELSE NULL END) AS NOME_PRIORITA_LANG,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10823' THEN GL.ACCOUNT_NAME ELSE NULL END) AS NOME_PRIORITA,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10105' THEN GAMRS.UOM_CODE_LANG ELSE NULL END) AS TRASVERSALE_LANG,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10105' THEN GAMRS.UOM_CODE ELSE NULL END) AS TRASVERSALE,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10105' THEN GL.ACCOUNT_NAME_LANG ELSE NULL END) AS NOME_TRASVERSALE_LANG,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10105' THEN GL.ACCOUNT_NAME ELSE NULL END) AS NOME_TRASVERSALE 
	FROM WORK_EFFORT_MEASURE WEM
	JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID
	JOIN WORK_EFFORT_PURPOSE_ACCOUNT WEPA ON WEPA.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID AND WEPA.WORK_EFFORT_PURPOSE_TYPE_ID = 'PRFOBOCAR'
	LEFT JOIN ACCTG_TRANS_ENTRY ATE ON ATE.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID 
	LEFT JOIN GL_ACCOUNT_MEAS_RAT_SC GAMRS ON GAMRS.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID
		AND GAMRS.UOM_RATING_VALUE <= ATE.AMOUNT AND GAMRS.UOM_RATING_VALUE >= ATE.AMOUNT
	GROUP BY WEM.WORK_EFFORT_ID
) CAR ON CAR.WORK_EFFORT_ID = OBO.WORK_EFFORT_ID
/* OBIETTIVI DI SOSTENIBILITA */
LEFT JOIN WORK_EFFORT_ASSOC WEA ON WEA.WORK_EFFORT_ID_TO = OBS.WORK_EFFORT_ID AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '20R8C'
WHERE OBO.WORK_EFFORT_TYPE_ID = '20P46' AND OBO.WORK_EFFORT_REVISION_ID IS NULL AND OBO.ORG_UNIT_ID = $P{orgUnitId}
	AND OBO.ESTIMATED_START_DATE <= TO_DATE($P{customTimePeriodFormatted},'DD/MM/YYYY')
	AND OBO.ESTIMATED_COMPLETION_DATE >= TO_DATE($P{customTimePeriodFormatted0101},'DD/MM/YYYY')
	$P!{workEffortIdStringObo} 
ORDER BY CAST(REGEXP_REPLACE(OBO.ETCH, '[^0-9]', '') AS INTEGER)]]>
	</queryString>
