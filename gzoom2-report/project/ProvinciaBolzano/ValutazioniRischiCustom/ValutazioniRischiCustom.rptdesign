                <structure>
                    <property name="name">TITOLO1</property>
                    <expression name="expression">titolo = row["ETCH1"] != null &amp;&amp; row["ETCH1"] ? row["ETCH1"] + " - "  : "" ;&#13;
if (row["DESCRIPTION1"] != null &amp;&amp; row["DESCRIPTION1"] != '' ) {&#13;
	titolo += row["DESCRIPTION1"];&#13;
} else {&#13;
	titolo += row["WORK_EFFORT_NAME1"];&#13;
}&#13;
titolo;</expression>
