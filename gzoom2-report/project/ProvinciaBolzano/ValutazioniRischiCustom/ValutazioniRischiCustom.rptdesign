                    <structure>
                        <property name="position">3</property>
                        <property name="name">DECIMAL_SCALE</property>
                        <property name="dataType">integer</property>
                    </structure>
                    <structure>
                        <property name="position">4</property>
                        <property name="name">ABBREVIATION</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <method name="beforeOpen"><![CDATA[this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value);
//this.queryText = this.queryText.replace("@date3112",  "''");
this.queryText = this.queryText.replace("@langLocale",  params["langLocale"].value);]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">AMOUNT</property>
                    <property name="nativeName">AMOUNT</property>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">UOM_CODE</property>
                    <property name="nativeName">UOM_CODE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">DECIMAL_SCALE</property>
                    <property name="nativeName">DECIMAL_SCALE</property>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">ABBREVIATION</property>
                    <property name="nativeName">ABBREVIATION</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT
  A.TM_AMOUNT AS AMOUNT,
  A.R_UOM_CODE@langLocale AS UOM_CODE,
  U.DECIMAL_SCALE AS DECIMAL_SCALE,
  U.ABBREVIATION@langLocale AS ABBREVIATION
FROM WORK_EFFORT_TRANS_ALL_VIEW A
INNER JOIN GL_ACCOUNT G ON G.GL_ACCOUNT_ID = A.M_GL_ACCOUNT_ID
INNER JOIN UOM U ON U.UOM_ID = G.DEFAULT_UOM_ID
WHERE A.M_WORK_EFFORT_ID = ?
AND A.M_GL_ACCOUNT_ID = '10069'
AND A.TT_TRANSACTION_DATE = @date3112]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="MotivazioneGiudizioSinteticoDS" id="55726">
            <list-property name="computedColumns">
                <structure>
                    <property name="name">COUNT</property>
                    <property name="dataType">integer</property>
                    <property name="aggregateFunction">COUNT</property>
                </structure>
            </list-property>
            <list-property name="parameters">
                <structure>
                    <property name="name">workEffortId</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">NOTE_ID</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">NOTE_NAME</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">NOTE_INFO</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">4</property>
                        <property name="name">COUNT</property>
                        <property name="dataType">integer</property>
                    </structure>
                </list-property>
            </structure>
            <method name="beforeOpen"><![CDATA[this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value);
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value);
/*this.queryText = this.queryText.replace("@date0101",  "''");
this.queryText = this.queryText.replace("@date3112", "''");*/
this.queryText = this.queryText.replace("@langLocale",  params["langLocale"].value);

//Debug.log("query = " + this.queryText);]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">NOTE_ID</property>
                    <property name="nativeName">NOTE_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">NOTE_NAME</property>
                    <property name="nativeName">NOTE_NAME</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">NOTE_INFO</property>
                    <property name="nativeName">NOTE_INFO</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT
  A.NOTE_ID,
  B.NOTE_NAME@langLocale AS NOTE_NAME,
  B.NOTE_INFO@langLocale AS NOTE_INFO
FROM WORK_EFFORT_NOTE A
INNER JOIN NOTE_DATA B ON A.NOTE_ID = B.NOTE_ID
WHERE A.WORK_EFFORT_ID = ?
AND A.SEQUENCE_ID = 120
AND B.NOTE_DATE_TIME >= @date0101 AND B.NOTE_DATE_TIME <= @date3112
  ]]></xml-property>
        </oda-data-set>
    </data-sets>
