	<queryString language="SQL">
		<![CDATA[SELECT
	NOTE.NOTE_INFO_LANG AS CONTENUTO_NOTA_IT,
	NOTE.NOTE_INFO AS CONTENUTO_NOTA_DE
FROM WORK_EFFORT OBS
/* NOTE */
LEFT JOIN (
	SELECT
		WEN.WORK_EFFORT_ID,
		ND.NOTE_DATE_TIME AS DATA_NOTA,
		ND.NOTE_INFO_LANG AS NOTE_INFO_LANG,
		ND.NOTE_INFO AS NOTE_INFO
	FROM WORK_EFFORT_NOTE WEN
	LEFT JOIN NOTE_DATA ND ON ND.NOTE_ID = WEN.NOTE_ID
	WHERE WEN.SEQUENCE_ID = 120
) NOTE ON NOTE.WORK_EFFORT_ID = OBS.WORK_EFFORT_ID
WHERE OBS.WORK_EFFORT_TYPE_ID = '20D62' AND OBS.WORK_EFFORT_REVISION_ID IS NULL AND OBS.WORK_EFFORT_ID = $P{work_effort_id_ob}
	AND (NOTE.NOTE_INFO_LANG IS NOT NULL OR NOTE.NOTE_INFO IS NOT NULL)
	AND NOTE.DATA_NOTA = TO_DATE($P{customTimePeriodFormatted3112},'DD/MM/YYYY')]]>
	</queryString>
