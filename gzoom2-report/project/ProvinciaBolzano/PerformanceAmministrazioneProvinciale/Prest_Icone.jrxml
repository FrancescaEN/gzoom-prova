	<parameter name="langLocale" class="java.lang.String" isForPrompting="false"/>
	<parameter name="id_prestazione" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select
	PRE.WORK_EFFORT_ID AS ID_PRESTAZIONE,
	MAX(CASE WHEN (OBSOST.SOURCE_REFERENCE_ID = 'SDG.01' AND WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_IT') THEN DR.OBJECT_INFO ELSE NULL END) AS ICO1_IT,
	MAX(CASE WHEN (OBSOST.SOURCE_REFERENCE_ID = 'SDG.01' AND WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_DE') THEN DR.OBJECT_INFO ELSE NULL END) AS ICO1_DE,
	
	MAX(CASE WHEN (OBSOST.SOURCE_REFERENCE_ID = 'SDG.02' AND WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_IT') THEN DR.OBJECT_INFO ELSE NULL END) AS ICO2_IT,
	MAX(CASE WHEN (OBSOST.SOURCE_REFERENCE_ID = 'SDG.02' AND WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_DE') THEN DR.OBJECT_INFO ELSE NULL END) AS ICO2_DE,
	
	MAX(CASE WHEN (OBSOST.SOURCE_REFERENCE_ID = 'SDG.03' AND WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_IT') THEN DR.OBJECT_INFO ELSE NULL END) AS ICO3_IT,
	MAX(CASE WHEN (OBSOST.SOURCE_REFERENCE_ID = 'SDG.03' AND WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_DE') THEN DR.OBJECT_INFO ELSE NULL END) AS ICO3_DE,
	
	MAX(CASE WHEN (OBSOST.SOURCE_REFERENCE_ID = 'SDG.04' AND WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_IT') THEN DR.OBJECT_INFO ELSE NULL END) AS ICO4_IT,
	MAX(CASE WHEN (OBSOST.SOURCE_REFERENCE_ID = 'SDG.04' AND WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_DE') THEN DR.OBJECT_INFO ELSE NULL END) AS ICO4_DE,
	
	MAX(CASE WHEN (OBSOST.SOURCE_REFERENCE_ID = 'SDG.05' AND WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_IT') THEN DR.OBJECT_INFO ELSE NULL END) AS ICO5_IT,
	MAX(CASE WHEN (OBSOST.SOURCE_REFERENCE_ID = 'SDG.05' AND WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_DE') THEN DR.OBJECT_INFO ELSE NULL END) AS ICO5_DE,
	
	MAX(CASE WHEN (OBSOST.SOURCE_REFERENCE_ID = 'SDG.06' AND WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_IT') THEN DR.OBJECT_INFO ELSE NULL END) AS ICO6_IT,
	MAX(CASE WHEN (OBSOST.SOURCE_REFERENCE_ID = 'SDG.06' AND WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_DE') THEN DR.OBJECT_INFO ELSE NULL END) AS ICO6_DE,
	
	MAX(CASE WHEN (OBSOST.SOURCE_REFERENCE_ID = 'SDG.07' AND WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_IT') THEN DR.OBJECT_INFO ELSE NULL END) AS ICO7_IT,
	MAX(CASE WHEN (OBSOST.SOURCE_REFERENCE_ID = 'SDG.07' AND WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_DE') THEN DR.OBJECT_INFO ELSE NULL END) AS ICO7_DE,
	
	MAX(CASE WHEN (OBSOST.SOURCE_REFERENCE_ID = 'SDG.08' AND WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_IT') THEN DR.OBJECT_INFO ELSE NULL END) AS ICO8_IT,
	MAX(CASE WHEN (OBSOST.SOURCE_REFERENCE_ID = 'SDG.08' AND WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_DE') THEN DR.OBJECT_INFO ELSE NULL END) AS ICO8_DE,
	
	MAX(CASE WHEN (OBSOST.SOURCE_REFERENCE_ID = 'SDG.09' AND WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_IT') THEN DR.OBJECT_INFO ELSE NULL END) AS ICO9_IT,
	MAX(CASE WHEN (OBSOST.SOURCE_REFERENCE_ID = 'SDG.09' AND WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_DE') THEN DR.OBJECT_INFO ELSE NULL END) AS ICO9_DE,
	
	MAX(CASE WHEN (OBSOST.SOURCE_REFERENCE_ID = 'SDG.10' AND WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_IT') THEN DR.OBJECT_INFO ELSE NULL END) AS ICO10_IT,
	MAX(CASE WHEN (OBSOST.SOURCE_REFERENCE_ID = 'SDG.10' AND WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_DE') THEN DR.OBJECT_INFO ELSE NULL END) AS ICO10_DE,
	
	MAX(CASE WHEN (OBSOST.SOURCE_REFERENCE_ID = 'SDG.11' AND WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_IT') THEN DR.OBJECT_INFO ELSE NULL END) AS ICO11_IT,
	MAX(CASE WHEN (OBSOST.SOURCE_REFERENCE_ID = 'SDG.11' AND WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_DE') THEN DR.OBJECT_INFO ELSE NULL END) AS ICO11_DE,
	
	MAX(CASE WHEN (OBSOST.SOURCE_REFERENCE_ID = 'SDG.12' AND WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_IT') THEN DR.OBJECT_INFO ELSE NULL END) AS ICO12_IT,
	MAX(CASE WHEN (OBSOST.SOURCE_REFERENCE_ID = 'SDG.12' AND WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_DE') THEN DR.OBJECT_INFO ELSE NULL END) AS ICO12_DE,
	
	MAX(CASE WHEN (OBSOST.SOURCE_REFERENCE_ID = 'SDG.13' AND WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_IT') THEN DR.OBJECT_INFO ELSE NULL END) AS ICO13_IT,
	MAX(CASE WHEN (OBSOST.SOURCE_REFERENCE_ID = 'SDG.13' AND WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_DE') THEN DR.OBJECT_INFO ELSE NULL END) AS ICO13_DE,
	
	MAX(CASE WHEN (OBSOST.SOURCE_REFERENCE_ID = 'SDG.14' AND WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_IT') THEN DR.OBJECT_INFO ELSE NULL END) AS ICO14_IT,
	MAX(CASE WHEN (OBSOST.SOURCE_REFERENCE_ID = 'SDG.14' AND WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_DE') THEN DR.OBJECT_INFO ELSE NULL END) AS ICO14_DE,
	
	MAX(CASE WHEN (OBSOST.SOURCE_REFERENCE_ID = 'SDG.15' AND WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_IT') THEN DR.OBJECT_INFO ELSE NULL END) AS ICO15_IT,
	MAX(CASE WHEN (OBSOST.SOURCE_REFERENCE_ID = 'SDG.15' AND WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_DE') THEN DR.OBJECT_INFO ELSE NULL END) AS ICO15_DE,
	
	MAX(CASE WHEN (OBSOST.SOURCE_REFERENCE_ID = 'SDG.16' AND WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_IT') THEN DR.OBJECT_INFO ELSE NULL END) AS ICO16_IT,
	MAX(CASE WHEN (OBSOST.SOURCE_REFERENCE_ID = 'SDG.16' AND WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_DE') THEN DR.OBJECT_INFO ELSE NULL END) AS ICO16_DE,
	
	MAX(CASE WHEN (OBSOST.SOURCE_REFERENCE_ID = 'SDG.17' AND WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_IT') THEN DR.OBJECT_INFO ELSE NULL END) AS ICO17_IT,
	MAX(CASE WHEN (OBSOST.SOURCE_REFERENCE_ID = 'SDG.17' AND WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_DE') THEN DR.OBJECT_INFO ELSE NULL END) AS ICO17_DE
FROM WORK_EFFORT PRE
JOIN WORK_EFFORT_ASSOC WEA ON WEA.WORK_EFFORT_ID_TO = PRE.WORK_EFFORT_ID AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '20R8C'
JOIN WORK_EFFORT OBSOST ON OBSOST.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_FROM	AND OBSOST.WORK_EFFORT_TYPE_ID = '20R84' AND OBSOST.WORK_EFFORT_REVISION_ID IS NULL
LEFT JOIN WORK_EFFORT_CONTENT WEC ON WEC.WORK_EFFORT_ID = OBSOST.WORK_EFFORT_ID
LEFT JOIN CONTENT C ON C.CONTENT_ID = WEC.CONTENT_ID
LEFT JOIN DATA_RESOURCE DR ON DR.DATA_RESOURCE_ID = C.DATA_RESOURCE_ID
WHERE PRE.WORK_EFFORT_TYPE_ID = '20C42' AND PRE.WORK_EFFORT_REVISION_ID IS NULL AND PRE.WORK_EFFORT_ID = $P{id_prestazione}
GROUP BY
	PRE.WORK_EFFORT_ID]]>
	</queryString>
