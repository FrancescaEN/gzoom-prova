	<queryString>
		<![CDATA[SELECT DISTINCT
	PRIO.WORK_EFFORT_ID AS ID_PRIORITA_SVILUPPO,
	PRIO.SOURCE_REFERENCE_ID AS CODICE_PRIORITA_SVILUPPO,
	PRIO.ETCH AS ETICHETTA_PRIORITA_SVILUPPO,
	PRIO.WORK_EFFORT_NAME_LANG AS NOME_PRIORITA_SVILUPPO_IT,
	PRIO.WORK_EFFORT_NAME AS NOME_PRIORITA_SVILUPPO_DE,
	GOV.WORK_EFFORT_ID AS ID_PROGRAMMA_GOVERNO,
	GOV.WORK_EFFORT_NAME_LANG AS NOME_PROGRAMMA_GOVERNO_IT,
	GOV.WORK_EFFORT_NAME AS NOME_PROGRAMMA_GOVERNO_DE,
	CAR.PARIOPP_LANG AS VALORE_FLAG_PARIOPPORTUNITA,
	CAR.QUALITA_LANG AS VALORE_FLAG_STRUMENTI_QUALITA,
	CAR.PNC_LANG AS VALORE_FLAG_PNC,
	CAR.PARIOPP AS VALORE_FLAG_PARIOPPORTUNITA_DE,
	CAR.QUALITA AS VALORE_FLAG_STRUMENTI_QUALITA_DE,
	CAR.PNC AS VALORE_FLAG_PNC_DE,
	OBS.WORK_EFFORT_ID AS ID_OBS,
	GRADO.UOM_CODE AS GRADO_RAGGIUNGIMENTO_DE,
	GRADO.UOM_CODE_LANG AS GRADO_RAGGIUNGIMENTO_IT,
	(SELECT COUNT(*)
		FROM WORK_EFFORT PRISV
		JOIN WORK_EFFORT_ASSOC WEA ON WEA.WORK_EFFORT_ID_TO = PRISV.WORK_EFFORT_ID AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '20R8C'
		JOIN WORK_EFFORT OBSOST ON OBSOST.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_FROM	AND OBSOST.WORK_EFFORT_TYPE_ID = '20R84' AND OBSOST.WORK_EFFORT_REVISION_ID IS NULL
		WHERE PRISV.WORK_EFFORT_TYPE_ID = '20D64' AND PRISV.WORK_EFFORT_REVISION_ID IS NULL AND PRISV.WORK_EFFORT_ID = PRIO.WORK_EFFORT_ID
	) AS CONTA_OBIETTIVI2030
/* PRIORITA' DI SVILUPPO */
FROM WORK_EFFORT PRIO
/* STRUTTURA */
JOIN PARTY P ON	P.PARTY_ID = PRIO.ORG_UNIT_ID
JOIN PARTY_PARENT_ROLE PPR ON PPR.PARTY_ID = P.PARTY_ID
/* COLLEGAMENTO A PROGRAMMA DI GOVERNO */
LEFT JOIN WORK_EFFORT_ASSOC WEA2 ON	WEA2.WORK_EFFORT_ID_TO = PRIO.WORK_EFFORT_ID AND WEA2.WORK_EFFORT_ASSOC_TYPE_ID = '20R14C'
LEFT JOIN WORK_EFFORT GOV ON GOV.WORK_EFFORT_ID = WEA2.WORK_EFFORT_ID_FROM AND GOV.WORK_EFFORT_TYPE_ID = '20R144' AND GOV.WORK_EFFORT_REVISION_ID IS NULL
/* OBIETTIVO STRATEGICO */
LEFT JOIN WORK_EFFORT_ASSOC WEA ON WEA.WORK_EFFORT_ID_TO = PRIO.WORK_EFFORT_ID AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '20D62C'
LEFT JOIN WORK_EFFORT OBS ON OBS.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_FROM AND OBS.WORK_EFFORT_TYPE_ID = '20D62' AND OBS.WORK_EFFORT_REVISION_ID IS NULL
/* CARATTERISTICHE PRIORITA DI SVILUPPO */
LEFT JOIN (
	SELECT
		WEM.WORK_EFFORT_ID,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10091' THEN GAMRS.UOM_CODE_LANG ELSE NULL END) AS PARIOPP_LANG,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10093' THEN GAMRS.UOM_CODE_LANG ELSE NULL END) AS QUALITA_LANG,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '11141' THEN GAMRS.UOM_CODE_LANG ELSE NULL END) AS PNC_LANG,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10091' THEN GAMRS.UOM_CODE ELSE NULL END) AS PARIOPP,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '10093' THEN GAMRS.UOM_CODE ELSE NULL END) AS QUALITA,
		MAX(CASE WHEN GL.GL_ACCOUNT_ID = '11141' THEN GAMRS.UOM_CODE ELSE NULL END) AS PNC
	FROM WORK_EFFORT_MEASURE WEM	
	JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID
	JOIN WORK_EFFORT_PURPOSE_ACCOUNT WEPA ON WEPA.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID	AND WEPA.WORK_EFFORT_PURPOSE_TYPE_ID = 'PRFPRICAR'
	LEFT JOIN ACCTG_TRANS_ENTRY ATE ON ATE.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID
	LEFT JOIN GL_ACCOUNT_MEAS_RAT_SC GAMRS ON GAMRS.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID
		AND GAMRS.UOM_RATING_VALUE <= ATE.AMOUNT AND GAMRS.UOM_RATING_VALUE >= ATE.AMOUNT
	GROUP BY
		WEM.WORK_EFFORT_ID
) CAR ON CAR.WORK_EFFORT_ID = PRIO.WORK_EFFORT_ID
JOIN WORK_EFFORT FIL_W ON FIL_W.WORK_EFFORT_ID =  PRIO.WORK_EFFORT_ID
/*GRADO DI RAGGIUNGIMENTO*/
LEFT JOIN (
	SELECT WEM.WORK_EFFORT_ID, 
	GAMRS.UOM_CODE,
	GAMRS.UOM_CODE_LANG
	FROM WORK_EFFORT_MEASURE wem 
	JOIN ACCTG_TRANS_ENTRY ate ON ATE.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID
	JOIN ACCTG_TRANS at ON AT.ACCTG_TRANS_ID = ATE.ACCTG_TRANS_ID
	AND AT.TRANSACTION_DATE = TO_DATE($P{date3112String},'YYYY-MM-DD')
	JOIN GL_ACCOUNT_MEAS_RAT_SC gamrs ON GAMRS.GL_ACCOUNT_ID = ATE.GL_ACCOUNT_ID AND ATE.AMOUNT = GAMRS.UOM_RATING_VALUE 
	WHERE WEM.GL_ACCOUNT_ID = '10096' AND ATE.GL_ACCOUNT_ID NOT LIKE 'SCORE%' 
	) GRADO ON GRADO.WORK_EFFORT_ID=PRIO.WORK_EFFORT_ID
/* START filterInnerJoin */
   $P!{filterInnerJoinString}
/* END filterInnerJoin */
/* START filterLeftJoin */
  $P!{filterLeftJoinString}
WHERE PRIO.WORK_EFFORT_TYPE_ID = '20D64' AND PRIO.WORK_EFFORT_REVISION_ID IS NULL AND PRIO.ORG_UNIT_ID = $P{id_scheda}
	AND PRIO.ESTIMATED_START_DATE <= TO_DATE($P{customTimePeriodFormatted},'DD/MM/YYYY')
	AND PRIO.ESTIMATED_COMPLETION_DATE >= TO_DATE($P{customTimePeriodFormatted0101},'DD/MM/YYYY')
ORDER BY CAST(REGEXP_REPLACE(PRIO.ETCH, '[^0-9]', '') AS INTEGER)]]>
	</queryString>
	<field name="CODICE_PRIORITA_SVILUPPO" class="java.lang.String">
