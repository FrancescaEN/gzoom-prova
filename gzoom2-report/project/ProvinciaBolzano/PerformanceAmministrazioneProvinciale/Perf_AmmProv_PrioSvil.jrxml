						<reportElement style="TextFieldStyle" stretchType="ContainerHeight" mode="Opaque" x="218" y="0" width="584" height="15" backcolor="#EBEBEB" uuid="8c200a9b-05f3-44fa-8f87-7505de0650d8">
							<property name="com.jaspersoft.studio.unit.y" value="px"/>
							<property name="com.jaspersoft.studio.unit.height" value="px"/>
							<property name="com.jaspersoft.studio.element.name" value="Nome Priorità Sviluppo"/>
							<property name="com.jaspersoft.studio.unit.width" value="px"/>
