	<field name="GRADO_RAGGIUNGIMENTO_IT" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="GRADO_RAGGIUNGIMENTO_IT"/>
		<property name="com.jaspersoft.studio.field.name" value="GRADO_RAGGIUNGIMENTO_IT"/>
	</field>
	<field name="GRADO_RAGGIUNGIMENTO_DE" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="GRADO_RAGGIUNGIMENTO_DE"/>
		<property name="com.jaspersoft.studio.field.name" value="GRADO_RAGGIUNGIMENTO_DE"/>
