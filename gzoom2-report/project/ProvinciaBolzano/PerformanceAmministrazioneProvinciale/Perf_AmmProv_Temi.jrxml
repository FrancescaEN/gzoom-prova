	<parameter name="langLocale" class="java.lang.String" isForPrompting="false"/>
	<parameter name="id_struttura" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["10086"]]></defaultValueExpression>
	</parameter>
	<parameter name="date3112sql" class="java.lang.String"/>
	<parameter name="date0101sql" class="java.lang.String"/>
	<parameter name="date3112String" class="java.lang.String" isForPrompting="false">
