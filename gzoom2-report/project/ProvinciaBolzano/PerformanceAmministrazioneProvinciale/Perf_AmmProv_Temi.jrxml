	<queryString language="SQL">
		<![CDATA[SELECT DISTINCT 
ETCH, 
TEMA_IT,
TEMA_DE,
LINK_IT,
LINK_DE
FROM
(SELECT 
	TEMA.ETCH AS ETCH,
	TEMA.WORK_EFFORT_NAME_LANG AS TEMA_IT,
	TEMA.WORK_EFFORT_NAME AS TEMA_DE,
	TEMA.DESCRIPTION_LANG AS LINK_IT,
	TEMA.DESCRIPTION AS LINK_DE
/* OBIETTIVO STRATEGICO */
FROM WORK_EFFORT OBS
/* TEMA */
JOIN WORK_EFFORT_ASSOC WEA ON WEA.WORK_EFFORT_ID_TO = OBS.WORK_EFFORT_ID AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '20R4C'
JOIN WORK_EFFORT TEMA ON TEMA.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_FROM 
WHERE OBS.WORK_EFFORT_TYPE_ID = '20D62' 
AND OBS.ORG_UNIT_ID=  $P{id_struttura} 
AND OBS.ESTIMATED_START_DATE <=  TO_DATE( $P{date3112String} ,'YYYY-MM-DD')
AND OBS.ESTIMATED_COMPLETION_DATE >=  TO_DATE( $P{date0101String} ,'YYYY-MM-DD')
UNION ALL
SELECT 
	TEMA.ETCH AS ETCH,
	TEMA.WORK_EFFORT_NAME_LANG AS TEMA_IT,
	TEMA.WORK_EFFORT_NAME AS TEMA_DE,
	TEMA.DESCRIPTION_LANG AS LINK_IT,
	TEMA.DESCRIPTION AS LINK_DE
/* PRIORITA' SVILUPPO */
FROM WORK_EFFORT PRIO
/* TEMA */
JOIN WORK_EFFORT_ASSOC WEA ON WEA.WORK_EFFORT_ID_TO = PRIO.WORK_EFFORT_ID AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '20R4C'
JOIN WORK_EFFORT TEMA ON TEMA.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_FROM 
WHERE PRIO.WORK_EFFORT_TYPE_ID = '20D64' 
AND PRIO.ORG_UNIT_ID= $P{id_struttura}
AND PRIO.ESTIMATED_START_DATE <= TO_DATE( $P{date3112String} ,'YYYY-MM-DD') 
AND PRIO.ESTIMATED_COMPLETION_DATE >=   TO_DATE( $P{date0101String} ,'YYYY-MM-DD')  )
ORDER BY ETCH]]>
	</queryString>
	<field name="TEMA_IT" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="NOME_TEMA_IT"/>
		<property name="com.jaspersoft.studio.field.label" value="NOME_TEMA_IT"/>
