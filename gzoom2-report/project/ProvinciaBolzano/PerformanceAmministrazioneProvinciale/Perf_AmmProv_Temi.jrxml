	</field>
	<field name="ETCH" class="java.lang.String"/>
	<variable name="AGGREGATION" class="java.lang.String">
		<variableExpression><![CDATA[$V{AGGREGATION}+($V{AGGREGATION}.isEmpty()? "<html>":"")+" <a href='"+( $P{langLocale}.equals("_LANG")?$F{LINK_IT}:$F{LINK_DE})+"'><u>"+( $P{langLocale}.equals("_LANG")?$F{TEMA_IT}:$F{TEMA_DE})+"</u></a>&nbsp;&nbsp;&nbsp;"]]></variableExpression>
		<initialValueExpression><![CDATA[""]]></initialValueExpression>
	</variable>
