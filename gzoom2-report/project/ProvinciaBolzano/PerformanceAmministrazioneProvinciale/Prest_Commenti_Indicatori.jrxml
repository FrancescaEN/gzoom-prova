	<parameter name="customTimePeriodCommenti3112" class="java.lang.String">
		<defaultValueExpression><![CDATA[$P{customTimePeriodFormatted3112} != null ?
 ( ""+(INTEGER_VALUE($P{customTimePeriodFormatted3112}.substring(6, 10) ))  + "-"+  $P{customTimePeriodFormatted3112}.substring(3, 5) + "-" + $P{customTimePeriodFormatted3112}.substring(0, 2) ): 
""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
	WEM.GL_ACCOUNT_ID AS ID_INDICATORE,
	WEM.SEQUENCE_ID AS ETICHETTA_INDICATORE,
	WEM.COMMENTS_LANG COMMENTO_INDICATORE_IT,
	WEM.COMMENTS COMMENTO_INDICATORE_DE
/* PRESTAZIONE */
FROM WORK_EFFORT PRE
/* INDICATORI */
JOIN WORK_EFFORT_MEASURE WEM ON WEM.WORK_EFFORT_ID = PRE.WORK_EFFORT_ID  AND wem.from_date<=TO_DATE( $P{customTimePeriodCommenti3112} ,'YYYY-MM-DD') AND wem.THRU_DATE >=TO_DATE( $P{customTimePeriodCommenti0101} ,'YYYY-MM-DD')
JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID
JOIN WORK_EFFORT_PURPOSE_ACCOUNT WEPA ON WEPA.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID
JOIN ACCTG_TRANS_ENTRY ATE ON ATE.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID AND (GL.INPUT_ENUM_ID = 'ACCINP_UO' OR (GL.INPUT_ENUM_ID = 'ACCINP_OBJ' AND ATE.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID))
JOIN ACCTG_TRANS ACT ON ACT.ACCTG_TRANS_ID = ATE.ACCTG_TRANS_ID
where PRE.WORK_EFFORT_ID = $P{work_effort_id_ob} 
AND PRE.WORK_EFFORT_TYPE_ID = '20C42' 
AND PRE.WORK_EFFORT_REVISION_ID IS NULL 
AND PRE.ORGANIZATION_ID = 'Company'
AND (WEM.COMMENTS_LANG IS NOT NULL OR WEM.COMMENTS IS NOT null)
AND WEPA.WORK_EFFORT_PURPOSE_TYPE_ID IN ('PRFPREFTE', 'PRFKPI')
AND ACT.transaction_date = TO_DATE($P{customTimePeriod},'YYYY-MM-DD')
--GROUP BY WEM.SEQUENCE_ID
order by WEM.SEQUENCE_ID]]>
	</queryString>
