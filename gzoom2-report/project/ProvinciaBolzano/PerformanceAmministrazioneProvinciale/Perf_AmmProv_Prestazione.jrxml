""]]></defaultValueExpression>
	</parameter>
	<parameter name="customTimePeriodPrest3112" class="java.lang.String">
		<defaultValueExpression><![CDATA[$P{customTimePeriodFormatted0101} != null ?
 ( ""+(INTEGER_VALUE($P{customTimePeriodFormatted0101}.substring(6, 10) ))  + "-"+  $P{customTimePeriodFormatted0101}.substring(3, 5) + "-" + $P{customTimePeriodFormatted0101}.substring(0, 2) ): 
""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT DISTINCT
	PRE.SOURCE_REFERENCE_ID AS CODICE_PRESTAZIONE,
	PRE.WORK_EFFORT_ID AS ID_PRESTAZIONE,
	PRE.ETCH AS ETICHETTA_PRESTAZIONE,
	PRE.WORK_EFFORT_NAME_LANG NOME_PRESTAZIONE_IT,
	PRE.WORK_EFFORT_NAME AS NOME_PRESTAZIONE_DE,
	GRADO.UOM_CODE AS GRADO_RAGGIUNGIMENTO_DE,
	GRADO.UOM_CODE_LANG AS GRADO_RAGGIUNGIMENTO_IT,
	(SELECT COUNT(*)
		FROM WORK_EFFORT_MEASURE INDIC
		JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = INDIC.GL_ACCOUNT_ID
		WHERE INDIC.WORK_EFFORT_ID = PRE.WORK_EFFORT_ID AND GL.SOURCE_LANG = 'S'
		AND INDIC.FROM_DATE<=TO_DATE( $P{customTimePeriodFormatted3112} ,'DD/MM/YYYY') AND INDIC.THRU_DATE>=TO_DATE( $P{customTimePeriodFormatted0101} ,'DD/MM/YYYY')
	) AS CONTA_STANDARD_QUALITA
/* PRESTAZIONI */
FROM WORK_EFFORT PRE
JOIN WORK_EFFORT FIL_W ON FIL_W.WORK_EFFORT_ID = PRE.WORK_EFFORT_ID
LEFT JOIN (
	SELECT WEM.WORK_EFFORT_ID, 
	GAMRS.UOM_CODE,
	GAMRS.UOM_CODE_LANG
	FROM WORK_EFFORT_MEASURE wem 
	JOIN ACCTG_TRANS_ENTRY ate ON ATE.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID
	JOIN ACCTG_TRANS at ON AT.ACCTG_TRANS_ID = ATE.ACCTG_TRANS_ID
	AND AT.TRANSACTION_DATE = TO_DATE( $P{customTimePeriodFormatted3112} ,'DD/MM/YYYY')
	JOIN GL_ACCOUNT_MEAS_RAT_SC gamrs ON GAMRS.GL_ACCOUNT_ID = ATE.GL_ACCOUNT_ID AND ATE.AMOUNT = GAMRS.UOM_RATING_VALUE 
	WHERE WEM.GL_ACCOUNT_ID = '10096' AND ATE.GL_ACCOUNT_ID NOT LIKE 'SCORE%' 
	) GRADO ON GRADO.WORK_EFFORT_ID=PRE.WORK_EFFORT_ID
$P!{filterInnerJoinString}
$P!{filterLeftJoinString}
WHERE PRE.WORK_EFFORT_TYPE_ID = '20C42' AND PRE.WORK_EFFORT_REVISION_ID IS NULL AND PRE.ORG_UNIT_ID = $P{orgUnitId}
	AND PRE.ESTIMATED_START_DATE <= TO_DATE($P{customTimePeriodFormatted},'DD/MM/YYYY')
	AND PRE.ESTIMATED_COMPLETION_DATE >= TO_DATE($P{customTimePeriodFormatted0101},'DD/MM/YYYY')
	$P!{filterWhereString}
ORDER BY CAST(REGEXP_REPLACE(PRE.ETCH, '[^0-9]', '') AS INTEGER)]]>
	</queryString>
