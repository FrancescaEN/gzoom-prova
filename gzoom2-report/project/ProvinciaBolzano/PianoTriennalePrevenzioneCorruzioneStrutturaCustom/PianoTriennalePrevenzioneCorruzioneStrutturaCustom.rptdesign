            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
	RADTC.ETCH@langLocale AS RAD_TITOLO,
	RA.WORK_EFFORT_ID AS RA_WORK_EFFORT_ID,
	RR.SEQUENCE_NUM AS AREA_SEQUENCE,
	ART.ETCH@langLocale AS AREA_ETCH_TYPE, 
	AR.ETCH AS AREA_ETCH, 
	AR.WORK_EFFORT_NAME@langLocale AS AREA_NAME,
	AR.WORK_EFFORT_ID AS AREA_ID,
	AR.DESCRIPTION@langLocale AS AREA_DESC,																											
	PR.ETCH AS PROCESSO_ETCH, 
	PRT.ETCH@langLocale AS PROCESSO_ETCH_TYPE, 
	PR.WORK_EFFORT_NAME@langLocale AS PROCESSO_NAME,	
	PR.WORK_EFFORT_ID AS PROCESSO_ID,
	PR.DESCRIPTION@langLocale AS PROCESSO_DESC,	
	AP.SEQUENCE_NUM AS PROCESSO_SEQUENCE,																								
	SP.ETCH AS SOTTOPROC_ETCH, 
	SPT.ETCH@langLocale AS SOTTOPROC_ETCH_TYPE,
	SP.WORK_EFFORT_NAME@langLocale AS SOTTOPROC_NAME,
	SP.WORK_EFFORT_ID AS SOTTOPROC_ID,
	SP.DESCRIPTION@langLocale AS SOTTOPROC_DESC,
	SP.ESTIMATED_START_DATE AS SOT_ESTI_START_DATE,
	PP.SEQUENCE_NUM AS SOTTOPROC_SEQUENCE,			
	SC.PARENT_ROLE_CODE AS SC_PARENT_ROLE_CODE, 
	ST.PARTY_NAME@langLocale AS ST_PARTY_NAME,	
	ST.PARTY_ID AS ST_PARTY_ID,																									
	RI.ETCH AS RISCHIO_ETCH, 
	RIT.ETCH@langLocale AS RISCHIO_ETCH_TYPE,
	RI.WORK_EFFORT_NAME@langLocale AS RISCHIO_NAME,
	RI.WORK_EFFORT_ID AS RISCHIO_ID,
	RI.DESCRIPTION@langLocale AS RISCHIO_DESCRI,
	AK.SEQUENCE_NUM	as RISCHIO_SEQUENCE_NUM,	
	OB.ETCH AS OBIETTIVO_ETCH,
	OBT.ETCH@langLocale AS OBIETTIVO_ETCH_TYPE,
	OB.WORK_EFFORT_NAME@langLocale AS OBIETTIVO_NAME,	
	OB.WORK_EFFORT_ID AS OBIETTIVO_ID,																									
	MIT.ETCH@langLocale AS TIPO_MISURA_ETCH, 
	MI.ETCH AS MISURA_ETCH, 
	MI.WORK_EFFORT_ID AS MISURA_ID,
	MI.WORK_EFFORT_NAME@langLocale AS MISURA_NAME,
	MI.DESCRIPTION@langLocale AS MISURA_DESCRI,
	RM.SEQUENCE_NUM AS MISURE_SEQUENCE_NUM,																									
	P_RES.PARTY_NAME AS RESPONSABILE, 																					
	ST.EXTERNAL_ID AS CODICE_ESTERNO,
	AC.ACCOUNT_NAME@langLocale AS ACCOUNT_NAME, 
    WI.UOM_DESCR@langLocale AS UOM_DESCR,
    AC.GL_ACCOUNT_ID,
    AC.GL_ACCOUNT_TYPE_ID,
    AC.ACCOUNT_CODE,
    UOM2.ABBREVIATION@langLocale AS ABBREVIATION,
    MAX(CASE WHEN RI2.TRANSACTION_DATE = @monitoringDate AND RI2.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN RI2.AMOUNT ELSE NULL END)  "ACTUAL_AMOUNT",	
    MAX(CASE WHEN RI2.TRANSACTION_DATE = @date3112 AND RI2.GL_FISCAL_TYPE_ID = 'BUDGET' THEN RI2.AMOUNT ELSE NULL END)  "BUDGET_AMOUNT",
    MAX(CASE WHEN RI2.TRANSACTION_DATE = @monitoringDate AND RI2.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN RI2.UOM_CODE ELSE NULL END)  "ACTUAL_CODE",
    MAX(CASE WHEN RI2.TRANSACTION_DATE = @date3112 AND RI2.GL_FISCAL_TYPE_ID = 'BUDGET' THEN RI2.UOM_CODE ELSE NULL END)  "BUDGET_CODE",
    MAX(RI2.UOM_TYPE_ID) "UOM_TYPE_ID"
																										
FROM WORK_EFFORT RA																											
INNER JOIN WORK_EFFORT_TYPE RAT ON RAT.WORK_EFFORT_TYPE_ID = RA.WORK_EFFORT_TYPE_ID	
INNER JOIN WORK_EFFORT_TYPE_CONTENT RADTC ON RADTC.WORK_EFFORT_TYPE_ID = RAT.WORK_EFFORT_TYPE_ID
	AND RADTC.CONTENT_ID = ?
	
-- area																										
INNER JOIN WORK_EFFORT_ASSOC RR ON RR.WORK_EFFORT_ID_FROM = RA.WORK_EFFORT_ID																											
	AND RR.WORK_EFFORT_ASSOC_TYPE_ID = RAT.HIERARCHY_ASSOC_TYPE_ID																										
INNER JOIN WORK_EFFORT AR ON AR.WORK_EFFORT_ID = RR.WORK_EFFORT_ID_TO
		AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND AR.ESTIMATED_START_DATE <= @date3112 AND AR.ESTIMATED_COMPLETION_DATE >= @date0101))	
        AND AR.WORK_EFFORT_REVISION_ID IS NULL	
INNER JOIN WORK_EFFORT_TYPE ART ON ART.WORK_EFFORT_TYPE_ID = AR.WORK_EFFORT_TYPE_ID	

-- Processo
INNER JOIN WORK_EFFORT_ASSOC AP ON AP.WORK_EFFORT_ID_FROM = AR.WORK_EFFORT_ID																											
	AND AP.WORK_EFFORT_ASSOC_TYPE_ID = ART.WORK_EFFORT_ASSOC_TYPE_ID		
INNER JOIN WORK_EFFORT PR ON PR.WORK_EFFORT_ID = AP.WORK_EFFORT_ID_TO
		AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND PR.ESTIMATED_START_DATE <= @date3112 AND PR.ESTIMATED_COMPLETION_DATE >= @date0101))																													
        AND PR.WORK_EFFORT_REVISION_ID IS NULL	
INNER JOIN WORK_EFFORT_TYPE PRT ON PRT.WORK_EFFORT_TYPE_ID = PR.WORK_EFFORT_TYPE_ID

-- Sottoprocesso																										
INNER JOIN WORK_EFFORT_ASSOC PP ON PP.WORK_EFFORT_ID_FROM = PR.WORK_EFFORT_ID																											
	AND PP.WORK_EFFORT_ASSOC_TYPE_ID = PRT.WORK_EFFORT_ASSOC_TYPE_ID
INNER JOIN WORK_EFFORT SP ON SP.WORK_EFFORT_ID = PP.WORK_EFFORT_ID_TO	
		AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND SP.ESTIMATED_START_DATE <= @date3112 AND SP.ESTIMATED_COMPLETION_DATE >= @date0101))																												
        AND SP.WORK_EFFORT_REVISION_ID IS NULL	
INNER JOIN WORK_EFFORT_TYPE SPT ON SPT.WORK_EFFORT_TYPE_ID = SP.WORK_EFFORT_TYPE_ID																										

INNER JOIN PARTY ST ON  ST.PARTY_ID = SP.ORG_UNIT_ID 
INNER JOIN PARTY_PARENT_ROLE SC ON SC.PARTY_ID = ST.PARTY_ID  AND SC.ROLE_TYPE_ID = 'ORGANIZATION_UNIT'

																			
-- 	rischio
INNER JOIN WORK_EFFORT_ASSOC AK ON AK.WORK_EFFORT_ID_FROM = SP.WORK_EFFORT_ID																											
	AND AK.WORK_EFFORT_ASSOC_TYPE_ID = SPT.HIERARCHY_ASSOC_TYPE_ID											
INNER JOIN WORK_EFFORT RI ON RI.WORK_EFFORT_ID = AK.WORK_EFFORT_ID_TO
		AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND RI.ESTIMATED_START_DATE <= @date3112 AND RI.ESTIMATED_COMPLETION_DATE >= @date0101))		
        AND RI.WORK_EFFORT_REVISION_ID IS NULL	
INNER JOIN WORK_EFFORT_TYPE RIT ON RIT.WORK_EFFORT_TYPE_ID = RI.WORK_EFFORT_TYPE_ID		

																											
--  RESPONSABILE
LEFT OUTER JOIN PARTY_RELATIONSHIP PR_RES ON  PR_RES.PARTY_ID_FROM = SP.ORG_UNIT_ID
     AND PR_RES.ROLE_TYPE_ID_FROM = SP.ORG_UNIT_ROLE_TYPE_ID
     AND PR_RES.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
AND (@excludeValidity = 'N' OR (@excludeValidity = 'Y' AND PR_RES.THRU_DATE IS NULL))
AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND(PR_RES.FROM_DATE   <= @monitoringDate AND (PR_RES.THRU_DATE  >= @monitoringDate OR PR_RES.THRU_DATE IS NULL)  )))

LEFT OUTER JOIN PARTY P_RES ON P_RES.PARTY_ID = PR_RES.PARTY_ID_TO

-- misure																											
LEFT OUTER JOIN WORK_EFFORT_ASSOC RM ON RM.WORK_EFFORT_ID_FROM = RI.WORK_EFFORT_ID																											
	AND RM.WORK_EFFORT_ASSOC_TYPE_ID = SPT.HIERARCHY_ASSOC_TYPE_ID	
	AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND RM.FROM_DATE <= @date3112 AND (RM.THRU_DATE IS NULL OR RM.THRU_DATE >= @date0101)))								
LEFT OUTER JOIN WORK_EFFORT MI ON MI.WORK_EFFORT_ID = RM.WORK_EFFORT_ID_TO
		AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND MI.ESTIMATED_START_DATE <= @date3112 AND MI.ESTIMATED_COMPLETION_DATE >= @date0101))																											
        AND MI.WORK_EFFORT_REVISION_ID IS NULL	
LEFT OUTER JOIN WORK_EFFORT_TYPE MIT ON MIT.WORK_EFFORT_TYPE_ID = MI.WORK_EFFORT_TYPE_ID	

-- obiettivo																										
LEFT OUTER JOIN WORK_EFFORT_ASSOC MO ON MO.WORK_EFFORT_ID_TO = MI.WORK_EFFORT_ID																											
	AND MO.WORK_EFFORT_ASSOC_TYPE_ID LIKE '%AZI'	
	AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND MO.FROM_DATE <= @date3112 AND (MO.THRU_DATE IS NULL OR MO.THRU_DATE >= @date0101)))																						
LEFT OUTER JOIN WORK_EFFORT OB ON OB.WORK_EFFORT_ID = MO.WORK_EFFORT_ID_FROM
		AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND OB.ESTIMATED_START_DATE <= @date3112 AND OB.ESTIMATED_COMPLETION_DATE >= @date0101))																												
        AND OB.WORK_EFFORT_REVISION_ID IS NULL	
LEFT OUTER JOIN WORK_EFFORT_TYPE OBT ON OBT.WORK_EFFORT_TYPE_ID = OB.WORK_EFFORT_TYPE_ID	
	
LEFT JOIN WORK_EFFORT_MEASURE WI ON WI.WORK_EFFORT_ID = MI.WORK_EFFORT_ID
AND WI.WE_MEASURE_TYPE_ENUM_ID <> 'WEMT_SCORE'
AND WI.GL_ACCOUNT_ID NOT IN (SELECT GL_ACCOUNT_ID FROM GL_ACCOUNT WHERE GL_ACCOUNT_TYPE_ID = 'CORCAR' OR GL_ACCOUNT_TYPE_ID = 'CORMON')
AND WI.FROM_DATE <= @date3112 AND WI.THRU_DATE  >= @date0101
LEFT JOIN GL_ACCOUNT AC ON AC.GL_ACCOUNT_ID = WI.GL_ACCOUNT_ID
LEFT JOIN UOM UOM2 ON AC.DEFAULT_UOM_ID = UOM2.UOM_ID																						
LEFT JOIN (																																				
	SELECT TP.VOUCHER_REF, TP.TRANSACTION_DATE, EP.AMOUNT, TP.GL_FISCAL_TYPE_ID, TP.DESCRIPTION AS AT_DESCRIPTION,
		EP.DESCRIPTION AS ATE_DESCRIPTION, WEM.UOM_CODE@langLocale AS UOM_CODE,
		U.UOM_TYPE_ID AS UOM_TYPE_ID, GL.GL_ACCOUNT_ID, GL.GL_ACCOUNT_TYPE_ID																																		
	FROM ACCTG_TRANS TP																																			
	INNER JOIN ACCTG_TRANS_ENTRY EP ON EP.ACCTG_TRANS_ID = TP.ACCTG_TRANS_ID
	LEFT JOIN WORK_EFFORT_MEAS_RAT_SC WEM 
	ON WEM.UOM_RATING_VALUE = EP.AMOUNT
	AND WEM.WORK_EFFORT_MEASURE_ID = TP.VOUCHER_REF
	INNER JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = EP.GL_ACCOUNT_ID
	INNER JOIN UOM U ON U.UOM_ID = GL.DEFAULT_UOM_ID																															
	WHERE EP.GL_ACCOUNT_ID <> 'SCOREKPI'																																	
) RI2 ON RI2.VOUCHER_REF = WI.WORK_EFFORT_MEASURE_ID    
																											
WHERE ( RA.WORK_EFFORT_ID = ? OR AR.WORK_EFFORT_ID = ? OR PR.WORK_EFFORT_ID = ? OR SP.WORK_EFFORT_ID = ? OR RI.WORK_EFFORT_ID = ?)
	AND (? IS NULL OR ? = '' OR ? = SP.ORG_UNIT_ID)
	-- AND (? = 'Y' OR (? = 'N' AND PP.ASSOC_WEIGHT <> -1))
	@organizationId
	AND RA.WORK_EFFORT_REVISION_ID IS NULL	
	
-- FILTRO PERMESSI
		AND( @userLoginId = 'admin' 
		 OR ( @userProfile = 'MGR_ADMIN' OR (   
			(( @userProfile = 'ORG_ROLE_ADMIN' 
				AND (EXISTS (SELECT 1 
					FROM PARTY_ROLE PT
					INNER JOIN PARTY_RELATIONSHIP PR ON PR.PARTY_ID_FROM = PT.PARTY_ID AND PR.ROLE_TYPE_ID_FROM = PT.ROLE_TYPE_ID
					INNER JOIN USER_LOGIN UL ON UL.PARTY_ID = PR.PARTY_ID_TO
					WHERE PT.PARTY_ID = SP.ORG_UNIT_ID AND PT.ROLE_TYPE_ID = SP.ORG_UNIT_ROLE_TYPE_ID
					AND PR.PARTY_RELATIONSHIP_TYPE_ID IN ('ORG_RESPONSIBLE', 'ORG_DELEGATE')
					AND (PR.THRU_DATE IS NULL OR PR.THRU_DATE >= SP.ESTIMATED_COMPLETION_DATE)
					AND UL.USER_LOGIN_ID = @userLoginId
					) OR EXISTS (SELECT 1      
					  FROM WORK_EFFORT_PARTY_ASSIGNMENT WA
						INNER JOIN USER_LOGIN UL ON UL.PARTY_ID = WA.PARTY_ID
					  WHERE WA.WORK_EFFORT_ID = SP.WORK_EFFORT_ID
						AND WA.ROLE_TYPE_ID LIKE 'WEM%'
						AND UL.USER_LOGIN_ID = @userLoginId
				)))
			 OR
			( @userProfile = 'ORG_ADMIN' 
				AND EXISTS (SELECT 1 
					FROM PARTY_ROLE PT
					INNER JOIN PARTY_RELATIONSHIP PR ON PR.PARTY_ID_FROM = PT.PARTY_ID AND PR.ROLE_TYPE_ID_FROM = PT.ROLE_TYPE_ID
					INNER JOIN USER_LOGIN UL ON UL.PARTY_ID = PR.PARTY_ID_TO
					WHERE PT.PARTY_ID = SP.ORG_UNIT_ID AND PT.ROLE_TYPE_ID = SP.ORG_UNIT_ROLE_TYPE_ID
					AND PR.PARTY_RELATIONSHIP_TYPE_ID IN ('ORG_RESPONSIBLE', 'ORG_DELEGATE')
					AND (PR.THRU_DATE IS NULL OR PR.THRU_DATE >= SP.ESTIMATED_COMPLETION_DATE)
					AND UL.USER_LOGIN_ID = @userLoginId
					)
		   )) -- chiude primo blocco OR
		   
		   OR( (
				@userProfile = 'ROLE_ADMIN' 
				AND EXISTS (SELECT 1      -- filtro role
				  FROM WORK_EFFORT_PARTY_ASSIGNMENT WA
					INNER JOIN USER_LOGIN UL ON UL.PARTY_ID = WA.PARTY_ID
				  WHERE WA.WORK_EFFORT_ID = SP.WORK_EFFORT_ID
					AND WA.ROLE_TYPE_ID LIKE 'WEM%'
						AND UL.USER_LOGIN_ID = @userLoginId
						)
			   ) OR ( 1=2 ))-- chiude secondo blocco or
		  ) -- chiude or iniziale 
		  )) -- chiude l'AND iniziale del controllo utente 	
		  
GROUP BY
	RADTC.ETCH@langLocale,
	RA.WORK_EFFORT_ID,
	RR.SEQUENCE_NUM,
	ART.ETCH@langLocale, 
	AR.ETCH, 
	AR.WORK_EFFORT_NAME@langLocale,
	AR.WORK_EFFORT_ID,
	AR.DESCRIPTION@langLocale,																											
	PR.ETCH, 
	PRT.ETCH@langLocale, 
	PR.WORK_EFFORT_NAME@langLocale,	
	PR.WORK_EFFORT_ID,
	PR.DESCRIPTION@langLocale,	
	AP.SEQUENCE_NUM,																								
	SP.ETCH, 
	SPT.ETCH@langLocale,
	SP.WORK_EFFORT_NAME@langLocale,
	SP.WORK_EFFORT_ID,
	SP.DESCRIPTION@langLocale,
	SP.ESTIMATED_START_DATE,
	PP.SEQUENCE_NUM,			
	SC.PARENT_ROLE_CODE, 
	ST.PARTY_NAME@langLocale,	
	ST.PARTY_ID,																									
	RI.ETCH, 
	RIT.ETCH@langLocale,
	RI.WORK_EFFORT_NAME@langLocale,
	RI.WORK_EFFORT_ID,
	RI.DESCRIPTION@langLocale,
	AK.SEQUENCE_NUM,	
	OB.ETCH,
	OBT.ETCH@langLocale,
	OB.WORK_EFFORT_NAME@langLocale,	
	OB.WORK_EFFORT_ID,																									
	MIT.ETCH@langLocale, 
	MI.ETCH, 
	MI.WORK_EFFORT_ID,
	MI.WORK_EFFORT_NAME@langLocale,
	MI.DESCRIPTION@langLocale,
	RM.SEQUENCE_NUM,																									
	P_RES.PARTY_NAME, 																					
	ST.EXTERNAL_ID ,
	AC.ACCOUNT_NAME@langLocale, 
    WI.UOM_DESCR@langLocale,
    AC.GL_ACCOUNT_ID,
    AC.GL_ACCOUNT_TYPE_ID,
    AC.ACCOUNT_CODE,
    UOM2.ABBREVIATION@langLocale	  		  	         
ORDER BY ST.EXTERNAL_ID, PR.ETCH, SP.ETCH, AC.GL_ACCOUNT_TYPE_ID, AC.ACCOUNT_CODE
																						
]]></xml-property>
            <xml-property name="designerValues"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<model:DesignValues xmlns:design="http://www.eclipse.org/datatools/connectivity/oda/design" xmlns:model="http://www.eclipse.org/birt/report/model/adapter/odaModel">
