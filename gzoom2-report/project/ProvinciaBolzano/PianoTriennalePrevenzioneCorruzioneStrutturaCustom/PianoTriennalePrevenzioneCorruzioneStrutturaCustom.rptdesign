            <method name="beforeOpen"><![CDATA[this.queryText = this.queryText.replace("@langLocale",  params["langLocale"].value);

var organizationIdString = "";
if (params["organizationId"].value != null &amp;&amp; params["organizationId"].value != '') {
    organizationIdString = "AND RA.ORGANIZATION_ID = '" + params["organizationId"].value + "'";
}
this.queryText = this.queryText.replace("@organizationId", organizationIdString);


//GESTIRE PERMESSI

 /*
var filterInnerJoin = "";
var filterLeftJoin = "";
var filterWhere = ""; */
 
/* */
filter = new com.mapsengineering.base.birt.util.UtilFilter(params["userLoginId"].value, params["localDispatcherName"].value);
filterInnerJoin = filter.getWorkEffortFilterInner();
filterLeftJoin = filter.getWorkEffortFilterLeftJoin();
filterWhere = filter.getWorkEffortFilterWhere();

this.queryText = this.queryText.replace("@filterInnerJoin",  filterInnerJoin );
this.queryText = this.queryText.replace("@filterLeftJoin",  filterLeftJoin );
this.queryText = this.queryText.replace("@filterWhere",  filterWhere );
 

]]></method>
