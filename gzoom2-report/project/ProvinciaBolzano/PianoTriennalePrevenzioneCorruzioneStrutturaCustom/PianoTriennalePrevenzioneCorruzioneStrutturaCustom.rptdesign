                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT
  A.SEQUENCE_NUM,
  B.WORK_EFFORT_ID,
  B.ETCH, 
  B.WORK_EFFORT_NAME@langLocale AS WORK_EFFORT_NAME,
  B.DESCRIPTION@langLocale AS DESCRIPTION, 
  C.R_UOM_CODE@langLocale AS UOM_CODE,
  AC.ACCOUNT_NAME@langLocale AS ACCOUNT_NAME, 
  WI.UOM_DESCR@langLocale AS UOM_DESCR,
  AC.GL_ACCOUNT_ID,
  AC.GL_ACCOUNT_TYPE_ID,
  AC.ACCOUNT_CODE,
  UOM.ABBREVIATION@langLocale AS ABBREVIATION,
  MAX(CASE WHEN RI.TRANSACTION_DATE = @monitoringDate AND RI.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN RI.AMOUNT ELSE NULL END)  "ACTUAL_AMOUNT",	
  MAX(CASE WHEN RI.TRANSACTION_DATE = @date3112 AND RI.GL_FISCAL_TYPE_ID = 'BUDGET' THEN RI.AMOUNT ELSE NULL END)  "BUDGET_AMOUNT",
  MAX(CASE WHEN RI.TRANSACTION_DATE = @monitoringDate AND RI.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN RI.UOM_CODE ELSE NULL END)  "ACTUAL_CODE",
  MAX(CASE WHEN RI.TRANSACTION_DATE = @date3112 AND RI.GL_FISCAL_TYPE_ID = 'BUDGET' THEN RI.UOM_CODE ELSE NULL END)  "BUDGET_CODE",
  MAX(RI.UOM_TYPE_ID) "UOM_TYPE_ID"
FROM WORK_EFFORT_ASSOC A
INNER JOIN WORK_EFFORT B ON B.WORK_EFFORT_ID = A.WORK_EFFORT_ID_TO
LEFT JOIN WORK_EFFORT_TRANS_ALL_VIEW C ON C.M_WORK_EFFORT_ID = B.WORK_EFFORT_ID
AND C.G_GL_ACCOUNT_TYPE_ID = 'CORCAR' AND C.TT_TRANSACTION_DATE = @date3112
LEFT JOIN WORK_EFFORT_MEASURE WI ON WI.WORK_EFFORT_ID = B.WORK_EFFORT_ID
AND WI.WE_MEASURE_TYPE_ENUM_ID <> 'WEMT_SCORE'
AND WI.GL_ACCOUNT_ID NOT IN (SELECT GL_ACCOUNT_ID FROM GL_ACCOUNT WHERE GL_ACCOUNT_TYPE_ID = 'CORCAR' OR GL_ACCOUNT_TYPE_ID = 'CORMON')
AND WI.FROM_DATE <= @date3112 AND WI.THRU_DATE  >= @date0101
LEFT JOIN GL_ACCOUNT AC ON AC.GL_ACCOUNT_ID = WI.GL_ACCOUNT_ID
LEFT JOIN UOM UOM ON AC.DEFAULT_UOM_ID = UOM.UOM_ID																						
LEFT JOIN (																																				
	SELECT TP.VOUCHER_REF, TP.TRANSACTION_DATE, EP.AMOUNT, TP.GL_FISCAL_TYPE_ID, TP.DESCRIPTION AS AT_DESCRIPTION,
		EP.DESCRIPTION AS ATE_DESCRIPTION, WEM.UOM_CODE@langLocale AS UOM_CODE,
		U.UOM_TYPE_ID AS UOM_TYPE_ID, GL.GL_ACCOUNT_ID, GL.GL_ACCOUNT_TYPE_ID																																		
	FROM ACCTG_TRANS TP																																			
	INNER JOIN ACCTG_TRANS_ENTRY EP ON EP.ACCTG_TRANS_ID = TP.ACCTG_TRANS_ID
	LEFT JOIN WORK_EFFORT_MEAS_RAT_SC WEM 
	ON WEM.UOM_RATING_VALUE = EP.AMOUNT
	AND WEM.WORK_EFFORT_MEASURE_ID = TP.VOUCHER_REF
	INNER JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = EP.GL_ACCOUNT_ID
	INNER JOIN UOM U ON U.UOM_ID = GL.DEFAULT_UOM_ID																															
	WHERE EP.GL_ACCOUNT_ID <> 'SCOREKPI'																																	
) RI ON RI.VOUCHER_REF = WI.WORK_EFFORT_MEASURE_ID
WHERE A.WORK_EFFORT_ID_FROM = ?
AND A.WORK_EFFORT_ASSOC_TYPE_ID = '15APPRO'
AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND B.ESTIMATED_START_DATE <= @date3112 AND B.ESTIMATED_COMPLETION_DATE >= @date0101))
GROUP BY A.SEQUENCE_NUM, B.WORK_EFFORT_ID, B.ETCH, B.WORK_EFFORT_NAME@langLocale, 
B.DESCRIPTION@langLocale, C.R_UOM_CODE@langLocale, AC.ACCOUNT_NAME@langLocale, 
WI.UOM_DESCR@langLocale, AC.GL_ACCOUNT_ID, AC.GL_ACCOUNT_TYPE_ID, AC.ACCOUNT_CODE, UOM.ABBREVIATION@langLocale]]></xml-property>
            <xml-property name="designerValues"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<model:DesignValues xmlns:design="http://www.eclipse.org/datatools/connectivity/oda/design" xmlns:model="http://www.eclipse.org/birt/report/model/adapter/odaModel">
  <Version>2.0</Version>
  <DataSetParameters>
    <parameter>
      <design:ParameterDefinition>
        <design:inOutMode>In</design:inOutMode>
        <design:attributes>
          <design:identifier>
            <design:name></design:name>
            <design:position>1</design:position>
          </design:identifier>
          <design:nativeDataTypeCode>12</design:nativeDataTypeCode>
          <design:precision>20</design:precision>
          <design:scale>0</design:scale>
          <design:nullability>Nullable</design:nullability>
        </design:attributes>
        <design:inputAttributes>
          <design:elementAttributes>
            <design:optional>true</design:optional>
          </design:elementAttributes>
        </design:inputAttributes>
      </design:ParameterDefinition>
    </parameter>
  </DataSetParameters>
</model:DesignValues>]]></xml-property>
