                                                                                        <property name="borderRightWidth">thin</property>
                                                                                        <text-data id="58582">
                                                                                            <property name="fontSize">9pt</property>
                                                                                            <expression name="valueExpr">importPackage(Packages.com.mapsengineering.base.birt.util);&#13;
if (row["UOM_TYPE_ID"] == 'RATING_SCALE') {&#13;
	row["BUDGET_CODE"];&#13;
} else if (row["UOM_TYPE_ID"] == 'DATE_MEASURE') {&#13;
	UtilDateTime.numberConvertToDate(row["BUDGET_AMOUNT"], reportContext.getLocale());&#13;
} else {&#13;
	row["BUDGET_AMOUNT"];&#13;
}</expression>
                                                                                            <property name="contentType">html</property>
                                                                                        </text-data>
                                                                                    </cell>
                                                                                    <cell id="58583">
                                                                                        <property name="borderBottomColor">#C0C0C0</property>
