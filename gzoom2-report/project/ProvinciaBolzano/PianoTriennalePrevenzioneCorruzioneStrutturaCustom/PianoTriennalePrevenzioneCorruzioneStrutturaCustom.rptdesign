                                                                                        <property name="borderRightWidth">thin</property>
                                                                                        <text-data id="58584">
                                                                                            <property name="fontSize">9pt</property>
                                                                                            <expression name="valueExpr">importPackage(Packages.com.mapsengineering.base.birt.util);&#13;
if (row["UOM_TYPE_ID"] == 'RATING_SCALE') {&#13;
	row["ACTUAL_CODE"];&#13;
} else if (row["UOM_TYPE_ID"] == 'DATE_MEASURE') {&#13;
	UtilDateTime.numberConvertToDate(row["ACTUAL_AMOUNT"], reportContext.getLocale());&#13;
} else {&#13;
	row["ACTUAL_AMOUNT"];&#13;
