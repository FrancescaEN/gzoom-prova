                    <property name="isOutput">false</property>
                </structure>
                <structure>
                    <property name="name">sequenceId</property>
                    <property name="dataType">string</property>
                    <property name="position">3</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">NOTE_NAME</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">NOTE_INFO</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">SEQUENCE_ID</property>
                        <property name="dataType">integer</property>
                    </structure>
                </list-property>
            </structure>
            <property name="rowFetchLimit">1</property>
            <method name="beforeOpen"><![CDATA[this.queryText = this.queryText.replace("@langLocale", params["langLocale"].value);]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">NOTE_NAME</property>
                    <property name="nativeName">NOTE_NAME</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">NOTE_INFO</property>
                    <property name="nativeName">NOTE_INFO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">SEQUENCE_ID</property>
                    <property name="nativeName">SEQUENCE_ID</property>
                    <property name="dataType">integer</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
 ND.NOTE_NAME@langLocale AS NOTE_NAME,
 ND.NOTE_INFO@langLocale AS NOTE_INFO,
 N.SEQUENCE_ID
FROM    WORK_EFFORT_NOTE N
INNER JOIN NOTE_DATA ND ON ND.NOTE_ID = N.NOTE_ID
WHERE N.WORK_EFFORT_ID = ? 
	AND ( N.IS_MAIN = 'Y' OR (N.IS_MAIN <> 'Y' AND ND.NOTE_DATE_TIME <= ?)	)
	AND N.SEQUENCE_ID = ?
ORDER BY ND.NOTE_DATE_TIME DESC]]></xml-property>
