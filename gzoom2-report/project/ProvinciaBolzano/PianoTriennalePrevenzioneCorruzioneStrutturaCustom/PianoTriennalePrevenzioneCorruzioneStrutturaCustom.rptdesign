            <method name="beforeOpen"><![CDATA[this.queryText = this.queryText.replace("@langLocale", params["langLocale"].value);
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value);
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value);

/*
this.queryText = this.queryText.replace("@date3112", "'2021-01-01 00:00:00.000'" );
this.queryText = this.queryText.replace("@date0101", "'2021-01-01 00:00:00.000'" );*/]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">AMOUNT</property>
                    <property name="nativeName">AMOUNT</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">COMMENTS</property>
                    <property name="nativeName">COMMENTS</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">OBJECT_INFO</property>
                    <property name="nativeName">OBJECT_INFO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">DECIMAL_SCALE</property>
                    <property name="nativeName">DECIMAL_SCALE</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">ABBREVIATION</property>
                    <property name="nativeName">ABBREVIATION</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
	
	RP.AMOUNT AS AMOUNT,		
	VP.COMMENTS@langLocale AS COMMENTS,
	EP.OBJECT_INFO AS OBJECT_INFO,
	UOM.DECIMAL_SCALE,
	UOM.ABBREVIATION
	
	
FROM WORK_EFFORT SP
INNER JOIN WORK_EFFORT_TYPE SPT ON SPT.WORK_EFFORT_TYPE_ID = SP.WORK_EFFORT_TYPE_ID
LEFT JOIN WORK_EFFORT_MEASURE WM																											
	ON WM.WORK_EFFORT_ID = SP.WORK_EFFORT_ID AND WM.WE_MEASURE_TYPE_ENUM_ID = 'WEMT_SCORE'
LEFT JOIN GL_ACCOUNT AC ON AC.GL_ACCOUNT_ID = WM.GL_ACCOUNT_ID 	
LEFT JOIN UOM UOM ON AC.DEFAULT_UOM_ID = UOM.UOM_ID	


-- score
LEFT JOIN (																											
	SELECT TP.VOUCHER_REF, TP.TRANSACTION_DATE, EP.AMOUNT																										
	FROM ACCTG_TRANS TP																										
		INNER JOIN ACCTG_TRANS_ENTRY EP ON EP.ACCTG_TRANS_ID = TP.ACCTG_TRANS_ID																									
	WHERE EP.GL_ACCOUNT_ID = 'SCORE'  AND EP.GL_FISCAL_TYPE_ID = ?																										
	) RP ON RP.VOUCHER_REF = WM.WORK_EFFORT_MEASURE_ID  AND RP.TRANSACTION_DATE = @date3112																									
LEFT JOIN UOM_RANGE_VALUES VP ON VP.UOM_RANGE_ID = SPT.UOM_RANGE_SCORE_ID																											
		AND VP.FROM_VALUE <= RP.AMOUNT AND VP.THRU_VALUE >= RP.AMOUNT		
LEFT JOIN ENUMERATION CP ON CP.ENUM_ID = VP.COLOR_ENUM_ID																											
LEFT JOIN CONTENT IP ON IP.CONTENT_ID = VP.ICON_CONTENT_ID																											
LEFT JOIN DATA_RESOURCE EP ON EP.DATA_RESOURCE_ID = IP.DATA_RESOURCE_ID	


WHERE SP.WORK_EFFORT_ID = ?]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="FattoriRischioDS" id="17187">
