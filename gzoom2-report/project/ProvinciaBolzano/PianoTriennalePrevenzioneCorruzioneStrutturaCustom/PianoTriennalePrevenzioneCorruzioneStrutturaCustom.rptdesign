            <xml-property name="queryText"><![CDATA[SELECT ND.NOTE_NAME, ND.NOTE_INFO, ND.NOTE_ID
FROM WORK_EFFORT_NOTE WN
INNER JOIN NOTE_DATA ND ON ND.NOTE_ID = WN.NOTE_ID
WHERE WN.WORK_EFFORT_ID = ? -- MAPPA.SCHEDA_ID
AND (? = 'I' AND (WN.SEQUENCE_ID >= 100 AND WN.SEQUENCE_ID < 200)  OR (? = 'F' AND (WN.SEQUENCE_ID >= 200)) OR ? = 'ALL')
AND ND.NOTE_DATE_TIME = ?  -- MAPPA.REF_DATE
ORDER BY WN.SEQUENCE_ID
]]></xml-property>
