        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="RischiDS" id="55926">
            <list-property name="computedColumns">
                <structure>
                    <property name="name">RISCHIO</property>
                    <expression name="expression">titolo = row["ETCH"] != null &amp;&amp; row["ETCH"] ? row["ETCH"] + " - "  : "" ;&#13;
if (row["DESCRIPTION"] != null &amp;&amp; row["DESCRIPTION"] != '' ) {&#13;
	titolo += row["DESCRIPTION"];&#13;
} else {&#13;
	titolo += row["WORK_EFFORT_NAME"];&#13;
}&#13;
titolo;</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">COUNT</property>
                    <property name="dataType">integer</property>
                    <property name="aggregateFunction">COUNT</property>
                </structure>
                <structure>
                    <property name="name">RISCHIO2</property>
                    <expression name="expression">row["ETCH"] != null &amp;&amp; row["ETCH"] != '' ? row["ETCH"] + ' - ' + row["WORK_EFFORT_NAME"] : row["WORK_EFFORT_NAME"]</expression>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <list-property name="parameters">
                <structure>
                    <property name="name">workEffortId</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">SEQUENCE_NUM</property>
                        <property name="dataType">integer</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">WORK_EFFORT_ID</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">ETCH</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">4</property>
                        <property name="name">WORK_EFFORT_NAME</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">5</property>
                        <property name="name">DESCRIPTION</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">6</property>
                        <property name="name">RISCHIO</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">7</property>
                        <property name="name">COUNT</property>
                        <property name="dataType">integer</property>
                    </structure>
                    <structure>
                        <property name="position">8</property>
                        <property name="name">RISCHIO2</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <method name="beforeOpen"><![CDATA[this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value);
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value);
/*this.queryText = this.queryText.replace("@date0101",  "''");
this.queryText = this.queryText.replace("@date3112",  "''");*/

this.queryText = this.queryText.replace("@excludeValidity",  "'" + params["excludeValidity"].value+ "'");
this.queryText = this.queryText.replace("@langLocale",  params["langLocale"].value);

//Debug.log("query = " + this.queryText);]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">SEQUENCE_NUM</property>
                    <property name="nativeName">SEQUENCE_NUM</property>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">WORK_EFFORT_ID</property>
                    <property name="nativeName">WORK_EFFORT_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">ETCH</property>
                    <property name="nativeName">ETCH</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">WORK_EFFORT_NAME</property>
                    <property name="nativeName">WORK_EFFORT_NAME</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">DESCRIPTION</property>
                    <property name="nativeName">DESCRIPTION</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
  A.SEQUENCE_NUM, 
  B.WORK_EFFORT_ID,
  B.ETCH, 
  B.WORK_EFFORT_NAME@langLocale AS WORK_EFFORT_NAME, 
  B.DESCRIPTION@langLocale AS DESCRIPTION
FROM WORK_EFFORT_ASSOC A
INNER JOIN WORK_EFFORT B ON B.WORK_EFFORT_ID = A.WORK_EFFORT_ID_TO
WHERE A.WORK_EFFORT_ID_FROM = ?
AND A.WORK_EFFORT_ASSOC_TYPE_ID = '15APPRO'
AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND B.ESTIMATED_START_DATE <= @date3112 AND B.ESTIMATED_COMPLETION_DATE >= @date0101))
ORDER BY A.SEQUENCE_NUM, B.ETCH, B.WORK_EFFORT_ID]]></xml-property>
        </oda-data-set>
    </data-sets>
