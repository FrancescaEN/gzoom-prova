                    <expression name="expression">titolo = row["AREA_ETCH"] != null &amp;&amp; row["AREA_ETCH"] ? row["AREA_ETCH"] + " - "  : "" ;&#13;
if (row["AREA_DESC"] != null &amp;&amp; row["AREA_DESC"] != '' ) {&#13;
	titolo += row["AREA_DESC"];&#13;
} else {&#13;
	titolo += row["AREA_NAME"];&#13;
}&#13;
titolo;</expression>
