            <xml-property name="queryText"><![CDATA[SELECT 
	RADTC.ETCH@langLocale AS RAD_TITOLO,
	RA.WORK_EFFORT_ID AS RA_WORK_EFFORT_ID,
	RR.SEQUENCE_NUM AS AREA_SEQUENCE,
	ART.ETCH@langLocale AS AREA_ETCH_TYPE, 
	AR.ETCH AS AREA_ETCH, 
	AR.WORK_EFFORT_NAME@langLocale AS AREA_NAME,
	AR.WORK_EFFORT_ID AS AREA_ID,
	AR.DESCRIPTION@langLocale AS AREA_DESC,																											
	PR.ETCH AS PROCESSO_ETCH, 
	PRT.ETCH@langLocale AS PROCESSO_ETCH_TYPE, 
	PR.WORK_EFFORT_NAME@langLocale AS PROCESSO_NAME,	
	PR.WORK_EFFORT_ID AS PROCESSO_ID,
	PR.DESCRIPTION@langLocale AS PROCESSO_DESC,	
	AP.SEQUENCE_NUM AS PROCESSO_SEQUENCE,																								
	SP.ETCH AS SOTTOPROC_ETCH, 
	SPT.ETCH@langLocale AS SOTTOPROC_ETCH_TYPE,
	SP.WORK_EFFORT_NAME@langLocale AS SOTTOPROC_NAME,
	SP.WORK_EFFORT_ID AS SOTTOPROC_ID,
	SP.DESCRIPTION@langLocale AS SOTTOPROC_DESC,
	SP.ESTIMATED_START_DATE AS SOT_ESTI_START_DATE,
	PP.SEQUENCE_NUM AS SOTTOPROC_SEQUENCE,			
	SC.PARENT_ROLE_CODE AS SC_PARENT_ROLE_CODE, 
	ST.PARTY_NAME@langLocale AS ST_PARTY_NAME,	
	ST.PARTY_ID AS ST_PARTY_ID,																									
	FIL_W.ETCH AS RISCHIO_ETCH, 
	RIT.ETCH@langLocale AS RISCHIO_ETCH_TYPE,
	FIL_W.WORK_EFFORT_NAME@langLocale AS RISCHIO_NAME,
	FIL_W.WORK_EFFORT_ID AS RISCHIO_ID,
	FIL_W.DESCRIPTION@langLocale AS RISCHIO_DESCRI,
	AK.SEQUENCE_NUM	as RISCHIO_SEQUENCE_NUM,	
	P_RES.PARTY_NAME AS RESPONSABILE, 																					
	SPND.NOTE_NAME@langLocale AS SOTTOPRO_NOTE_NAME,
	SPND.NOTE_INFO@langLocale AS SOTTOPRO_NOTE_INFO,
	ST.EXTERNAL_ID AS CODICE_ESTERNO
																										
FROM WORK_EFFORT RA																											
INNER JOIN WORK_EFFORT_TYPE RAT ON RAT.WORK_EFFORT_TYPE_ID = RA.WORK_EFFORT_TYPE_ID	
INNER JOIN WORK_EFFORT_TYPE_CONTENT RADTC ON RADTC.WORK_EFFORT_TYPE_ID = RAT.WORK_EFFORT_TYPE_ID
	AND RADTC.CONTENT_ID = ?
	
-- area																										
INNER JOIN WORK_EFFORT_ASSOC RR ON RR.WORK_EFFORT_ID_FROM = RA.WORK_EFFORT_ID																											
	AND RR.WORK_EFFORT_ASSOC_TYPE_ID = RAT.HIERARCHY_ASSOC_TYPE_ID																										
INNER JOIN WORK_EFFORT AR ON AR.WORK_EFFORT_ID = RR.WORK_EFFORT_ID_TO
		AND (? = 'Y' OR (? = 'N' AND AR.ESTIMATED_START_DATE <= ? AND AR.ESTIMATED_COMPLETION_DATE >= ?))
		AND AR.WORK_EFFORT_REVISION_ID IS NULL		
INNER JOIN WORK_EFFORT_TYPE ART ON ART.WORK_EFFORT_TYPE_ID = AR.WORK_EFFORT_TYPE_ID	

-- Processo
INNER JOIN WORK_EFFORT_ASSOC AP ON AP.WORK_EFFORT_ID_FROM = AR.WORK_EFFORT_ID																											
	AND AP.WORK_EFFORT_ASSOC_TYPE_ID = ART.WORK_EFFORT_ASSOC_TYPE_ID		
INNER JOIN WORK_EFFORT PR ON PR.WORK_EFFORT_ID = AP.WORK_EFFORT_ID_TO
		AND (? = 'Y' OR (? = 'N' AND PR.ESTIMATED_START_DATE <= ? AND PR.ESTIMATED_COMPLETION_DATE >= ?))
		AND PR.WORK_EFFORT_REVISION_ID IS NULL																													
INNER JOIN WORK_EFFORT_TYPE PRT ON PRT.WORK_EFFORT_TYPE_ID = PR.WORK_EFFORT_TYPE_ID

-- Sottoprocesso																										
INNER JOIN WORK_EFFORT_ASSOC PP ON PP.WORK_EFFORT_ID_FROM = PR.WORK_EFFORT_ID																											
	AND PP.WORK_EFFORT_ASSOC_TYPE_ID = PRT.WORK_EFFORT_ASSOC_TYPE_ID
INNER JOIN WORK_EFFORT SP ON SP.WORK_EFFORT_ID = PP.WORK_EFFORT_ID_TO	
		AND (? = 'Y' OR (? = 'N' AND SP.ESTIMATED_START_DATE <= ? AND SP.ESTIMATED_COMPLETION_DATE >= ?))
		AND SP.WORK_EFFORT_REVISION_ID IS NULL																												
INNER JOIN WORK_EFFORT_TYPE SPT ON SPT.WORK_EFFORT_TYPE_ID = SP.WORK_EFFORT_TYPE_ID																										

INNER JOIN PARTY ST ON  ST.PARTY_ID = SP.ORG_UNIT_ID 
INNER JOIN PARTY_PARENT_ROLE SC ON SC.PARTY_ID = ST.PARTY_ID  AND SC.ROLE_TYPE_ID = 'ORGANIZATION_UNIT'

																			
-- 	rischio
INNER JOIN WORK_EFFORT_ASSOC AK ON AK.WORK_EFFORT_ID_FROM = SP.WORK_EFFORT_ID																											
	AND AK.WORK_EFFORT_ASSOC_TYPE_ID = SPT.HIERARCHY_ASSOC_TYPE_ID											
INNER JOIN WORK_EFFORT FIL_W ON FIL_W.WORK_EFFORT_ID = AK.WORK_EFFORT_ID_TO
		AND (? = 'Y' OR (? = 'N' AND FIL_W.ESTIMATED_START_DATE <= ? AND FIL_W.ESTIMATED_COMPLETION_DATE >= ?))
		AND FIL_W.WORK_EFFORT_REVISION_ID IS NULL		
INNER JOIN WORK_EFFORT_TYPE RIT ON RIT.WORK_EFFORT_TYPE_ID = FIL_W.WORK_EFFORT_TYPE_ID		

@filterInnerJoin
@filterLeftJoin
																											
--  RESPONSABILE
LEFT OUTER JOIN PARTY_RELATIONSHIP PR_RES ON  PR_RES.PARTY_ID_FROM = SP.ORG_UNIT_ID
     AND PR_RES.ROLE_TYPE_ID_FROM = SP.ORG_UNIT_ROLE_TYPE_ID
     AND PR_RES.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
AND (? = 'N' OR (? = 'Y' AND PR_RES.THRU_DATE IS NULL))
AND (? = 'Y' OR (? = 'N' AND(PR_RES.FROM_DATE   <= ? AND (PR_RES.THRU_DATE  >= ? OR PR_RES.THRU_DATE IS NULL)  )))

LEFT OUTER JOIN PARTY P_RES ON P_RES.PARTY_ID = PR_RES.PARTY_ID_TO


LEFT OUTER JOIN WORK_EFFORT_NOTE MN3 ON  MN3.WORK_EFFORT_ID = SP.WORK_EFFORT_ID
	AND MN3.SEQUENCE_ID = '10'
LEFT OUTER JOIN NOTE_DATA SPND ON SPND.NOTE_ID = MN3.NOTE_ID
	AND ( MN3.IS_MAIN = 'Y' OR (MN3.IS_MAIN <> 'Y' AND SPND.NOTE_DATE_TIME = ?)	)


																											
WHERE ( RA.WORK_EFFORT_ID = ? OR AR.WORK_EFFORT_ID = ? OR PR.WORK_EFFORT_ID = ? OR SP.WORK_EFFORT_ID = ? OR FIL_W.WORK_EFFORT_ID = ?)
	AND (? IS NULL OR ? = '' OR ? = SP.ORG_UNIT_ID)
	-- AND (? = 'Y' OR (? = 'N' AND PP.ASSOC_WEIGHT <> -1))
	AND RA.WORK_EFFORT_REVISION_ID IS NULL	
	@organizationId
	@filterWhere	         
ORDER BY RR.SEQUENCE_NUM, AR.SOURCE_REFERENCE_ID, AP.SEQUENCE_NUM, PR.SOURCE_REFERENCE_ID,																											
		 PP.SEQUENCE_NUM, SP.SOURCE_REFERENCE_ID, 																									
		AK.SEQUENCE_NUM, FIL_W.SOURCE_REFERENCE_ID																							
]]></xml-property>
