                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">ACCOUNT_NAME</property>
                    <property name="nativeName">ACCOUNT_NAME</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">UOM_DESCR</property>
                    <property name="nativeName">UOM_DESCR</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">NOTE_INFO</property>
                    <property name="nativeName">NOTE_INFO</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT AC.ACCOUNT_NAME, WI.UOM_DESCR, NDR.NOTE_INFO
FROM  WORK_EFFORT_MEASURE WI 	
INNER JOIN GL_ACCOUNT AC ON AC.GL_ACCOUNT_ID = WI.GL_ACCOUNT_ID
INNER JOIN UOM UOM ON AC.DEFAULT_UOM_ID = UOM.UOM_ID
INNER JOIN WORK_EFFORT_PURPOSE_ACCOUNT WPA ON WPA.GL_ACCOUNT_ID = AC.GL_ACCOUNT_ID
	AND WPA.WORK_EFFORT_PURPOSE_TYPE_ID = 'CORFAT'
INNER JOIN ACCTG_TRANS TP ON TP.VOUCHER_REF = WI.WORK_EFFORT_MEASURE_ID
INNER JOIN ACCTG_TRANS_ENTRY EP ON EP.ACCTG_TRANS_ID = TP.ACCTG_TRANS_ID
	AND EP.GL_ACCOUNT_ID <> 'SCOREKPI'
	
-- BEGIN NOTA 
LEFT OUTER JOIN WORK_EFFORT_NOTE MN ON MN.WORK_EFFORT_ID = WI.WORK_EFFORT_ID
	AND MN.SEQUENCE_ID = '2' 
LEFT OUTER JOIN NOTE_DATA NDR ON NDR.NOTE_ID = MN.NOTE_ID
   AND NDR.NOTE_DATE_TIME = ?
-- END		
	
WHERE WI.WE_MEASURE_TYPE_ENUM_ID <> 'WEMT_SCORE'
	AND TP.VOUCHER_REF = WI.WORK_EFFORT_MEASURE_ID 
	AND TP.TRANSACTION_DATE = ?
	AND EP.AMOUNT = 100
	AND WI.WORK_EFFORT_ID = ?
]]></xml-property>
