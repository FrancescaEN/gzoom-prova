                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT
FIL_W.SOURCE_REFERENCE_ID AS "CODICE_OBIETTIVO_STRATEGICO",
FIL_W.WORK_EFFORT_NAME@langLocale AS "TITOLO_OBOSTRAT",
FIL_W.ETCH AS "ETICHETTA_OBIETTIVO_STRATEGICO",
PA.EXTERNAL_ID AS "CODICE_ESTERNO",
PPR.PARENT_ROLE_CODE  AS "CODICE_STRUTTURA",
PA.PARTY_NAME@langLocale AS "NOME_STRUTTURA",
PAPA.EXTERNAL_ID AS "CODICE_ESTERNO_PADRE",
PPRPA.PARENT_ROLE_CODE AS "CODICE_STRUTTURA_PADRE",
PAPA.PARTY_NAME@langLocale AS "NOME_STRUTTURA_PADRE",
TEM.WORK_EFFORT_NAME@langLocale AS "DESCRIZIONE_TEMA",
RS10.UOM_CODE@langLocale AS "FLAG_DEFP",
RS20.UOM_CODE@langLocale AS "FLAG_PARIOPP",
RS30.UOM_CODE@langLocale AS "FLAG_SOSTENIBILITA",
RS40.UOM_CODE@langLocale AS "FLAG_QUALITA",
--INDMON.UOM_DESCR@langLocale AS "MONITORAGGIO_RAGGIUNGIMENTO_OBIETTIVO",
INDMON.UOM_CODE@langLocale_3006 AS "MONITORAGGIO_RAGGIUNGIMENTO_OBIETTIVO_3006",
INDMON.UOM_CODE@langLocale_3112 AS "MONITORAGGIO_RAGGIUNGIMENTO_OBIETTIVO_3112",
NOTEPRE.NOTE_INFO AS "PREVISIONE_SULLA_PERFORMANCE",
NOTEMON.NOTE_INFO AS "MONITORAGGIO_PERFORMANCE",
NOTEREL.NOTE_INFO AS "RELAZIONE_SULLA_PERFORMANCE",
FIL_W.WORK_EFFORT_ID AS "WORK_EFFORT_ID",
RS50.UOM_CODE@langLocale AS "FLAG_PNRR",
RS55.UOM_CODE@langLocale AS "FLAG_PNC"
FROM WORK_EFFORT FIL_W
LEFT JOIN WORK_EFFORT_ASSOC TEMOBS ON TEMOBS.WORK_EFFORT_ID_TO = FIL_W.WORK_EFFORT_ID AND TEMOBS.WORK_EFFORT_ASSOC_TYPE_ID = '20R4C'
AND TEMOBS.FROM_DATE <= @date3112 AND (TEMOBS.THRU_DATE IS NULL OR TEMOBS.THRU_DATE >= @date0101)
LEFT JOIN WORK_EFFORT TEM ON TEMOBS.WORK_EFFORT_ID_FROM IS NOT NULL AND TEM.WORK_EFFORT_ID = TEMOBS.WORK_EFFORT_ID_FROM
INNER JOIN PARTY_PARENT_ROLE PPR ON PPR.PARTY_ID = FIL_W.ORG_UNIT_ID AND PPR.ROLE_TYPE_ID = 'ORGANIZATION_UNIT'
INNER JOIN PARTY PA ON PA.PARTY_ID = FIL_W.ORG_UNIT_ID
LEFT JOIN PARTY_RELATIONSHIP PREL ON PREL.PARTY_ID_TO = PA.PARTY_ID AND PREL.THRU_DATE IS NULL AND PREL.PARTY_RELATIONSHIP_TYPE_ID = 'GROUP_ROLLUP' 
LEFT JOIN PARTY_PARENT_ROLE PPRPA ON PPRPA.PARTY_ID = PREL.PARTY_ID_FROM
LEFT JOIN PARTY PAPA ON PAPA.PARTY_ID = PPRPA.PARTY_ID
LEFT JOIN(
	SELECT
		ND.NOTE_INFO@langLocale AS "NOTE_INFO",
		WEN.WORK_EFFORT_ID
	FROM WORK_EFFORT_NOTE WEN
	JOIN NOTE_DATA ND ON ND.NOTE_ID = WEN.NOTE_ID AND ND.NOTE_DATE_TIME = @date0101
	WHERE WEN.SEQUENCE_ID = '110'
) NOTEPRE ON NOTEPRE.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
LEFT JOIN(
	SELECT
		NOTE_INFO@langLocale AS "NOTE_INFO",
		WEN.WORK_EFFORT_ID
	FROM WORK_EFFORT_NOTE WEN
	JOIN NOTE_DATA ND ON ND.NOTE_ID = WEN.NOTE_ID AND ND.NOTE_DATE_TIME = @date3006
	WHERE WEN.SEQUENCE_ID = '115'
) NOTEMON ON NOTEMON.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
LEFT JOIN(
	SELECT
		NOTE_INFO@langLocale AS "NOTE_INFO",
		WEN.WORK_EFFORT_ID
	FROM WORK_EFFORT_NOTE WEN
	JOIN NOTE_DATA ND ON ND.NOTE_ID = WEN.NOTE_ID AND ND.NOTE_DATE_TIME = @date3112
	WHERE WEN.SEQUENCE_ID = '120'
) NOTEREL ON NOTEREL.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
LEFT JOIN WORK_EFFORT_MEASURE WM10 ON WM10.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID AND WM10.GL_ACCOUNT_ID = '10090'
LEFT JOIN ACCTG_TRANS_ENTRY TE10 ON TE10.VOUCHER_REF = WM10.WORK_EFFORT_MEASURE_ID
LEFT JOIN WORK_EFFORT_MEAS_RAT_SC RS10 ON RS10.WORK_EFFORT_MEASURE_ID = WM10.WORK_EFFORT_MEASURE_ID 
   AND RS10.UOM_ID = TE10.CURRENCY_UOM_ID AND RS10.UOM_RATING_VALUE = TE10.AMOUNT
LEFT JOIN WORK_EFFORT_MEASURE WM20 ON WM20.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID AND WM20.GL_ACCOUNT_ID = '10091'
LEFT JOIN ACCTG_TRANS_ENTRY TE20 ON TE20.VOUCHER_REF = WM20.WORK_EFFORT_MEASURE_ID
LEFT JOIN WORK_EFFORT_MEAS_RAT_SC RS20 ON RS20.WORK_EFFORT_MEASURE_ID = WM20.WORK_EFFORT_MEASURE_ID 
   AND RS20.UOM_ID = TE20.CURRENCY_UOM_ID AND RS20.UOM_RATING_VALUE = TE20.AMOUNT
LEFT JOIN WORK_EFFORT_MEASURE WM30 ON WM30.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID AND WM30.GL_ACCOUNT_ID = '10092'
LEFT JOIN ACCTG_TRANS_ENTRY TE30 ON TE30.VOUCHER_REF = WM30.WORK_EFFORT_MEASURE_ID
LEFT JOIN WORK_EFFORT_MEAS_RAT_SC RS30 ON RS30.WORK_EFFORT_MEASURE_ID = WM30.WORK_EFFORT_MEASURE_ID 
   AND RS30.UOM_ID = TE30.CURRENCY_UOM_ID AND RS30.UOM_RATING_VALUE = TE30.AMOUNT
LEFT JOIN WORK_EFFORT_MEASURE WM40 ON WM40.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID AND WM40.GL_ACCOUNT_ID = '10093'
LEFT JOIN ACCTG_TRANS_ENTRY TE40 ON TE40.VOUCHER_REF = WM40.WORK_EFFORT_MEASURE_ID
LEFT JOIN WORK_EFFORT_MEAS_RAT_SC RS40 ON RS40.WORK_EFFORT_MEASURE_ID = WM40.WORK_EFFORT_MEASURE_ID 
   AND RS40.UOM_ID = TE40.CURRENCY_UOM_ID AND RS40.UOM_RATING_VALUE = TE40.AMOUNT

LEFT JOIN WORK_EFFORT_MEASURE WM50 ON WM50.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID AND WM50.GL_ACCOUNT_ID = '11140'
LEFT JOIN ACCTG_TRANS_ENTRY TE50 ON TE50.VOUCHER_REF = WM50.WORK_EFFORT_MEASURE_ID
LEFT JOIN WORK_EFFORT_MEAS_RAT_SC RS50 ON RS50.WORK_EFFORT_MEASURE_ID = WM50.WORK_EFFORT_MEASURE_ID
	AND RS50.UOM_ID = TE50.CURRENCY_UOM_ID AND RS50.UOM_RATING_VALUE = TE50.AMOUNT
LEFT JOIN WORK_EFFORT_MEASURE WM55 ON WM55.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID AND WM55.GL_ACCOUNT_ID = '11141'
LEFT JOIN ACCTG_TRANS_ENTRY TE55 ON TE55.VOUCHER_REF = WM55.WORK_EFFORT_MEASURE_ID
LEFT JOIN WORK_EFFORT_MEAS_RAT_SC RS55 ON RS55.WORK_EFFORT_MEASURE_ID = WM55.WORK_EFFORT_MEASURE_ID
	AND RS55.UOM_ID = TE55.CURRENCY_UOM_ID AND RS55.UOM_RATING_VALUE = TE55.AMOUNT
  
@filterInnerJoin
@filterLeftJoin
LEFT JOIN (
	SELECT WEM.WORK_EFFORT_ID, 
	--WEMRS.UOM_DESCR_LANG, WEMRS.UOM_DESCR 
	
	MAX(CASE WHEN ACT.TRANSACTION_DATE = @date3006 THEN WEMRS.UOM_CODE@langLocale ELSE NULL END) AS UOM_CODE@langLocale_3006,
	MAX(CASE WHEN ACT.TRANSACTION_DATE = @date3112 THEN WEMRS.UOM_CODE@langLocale ELSE NULL END) AS UOM_CODE@langLocale_3112
	
	FROM WORK_EFFORT_MEASURE WEM
	JOIN ACCTG_TRANS ACT ON ACT.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID AND ACT.TRANSACTION_DATE = @date3112
	JOIN ACCTG_TRANS_ENTRY ATE ON ATE.ACCTG_TRANS_ID = ACT.ACCTG_TRANS_ID AND ATE.GL_ACCOUNT_ID = '10126'
	LEFT JOIN WORK_EFFORT_MEAS_RAT_SC WEMRS ON WEMRS.WORK_EFFORT_MEASURE_ID = ATE.VOUCHER_REF 
		AND WEMRS.UOM_RATING_VALUE <= ATE.AMOUNT AND WEMRS.UOM_RATING_VALUE >= ATE.AMOUNT
		
	GROUP BY WEM.WORK_EFFORT_ID	
	
) INDMON ON INDMON.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID

WHERE FIL_W.ORGANIZATION_ID=@defaultOrganizationId
  and FIL_W.WORK_EFFORT_TYPE_ID = @workEffortTypeId AND 
  FIL_W.ESTIMATED_START_DATE <= @date3112 AND FIL_W.ESTIMATED_COMPLETION_DATE >= @date0101
  @orgUnitId
  @filterWhere
ORDER BY FIL_W.SOURCE_REFERENCE_ID]]></xml-property>
        </oda-data-set>
