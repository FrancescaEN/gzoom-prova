            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">CODICE_OBIETTIVO_STRATEGICO</property>
                    <property name="nativeName">CODICE_OBIETTIVO_STRATEGICO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">OBIETTIVI_SOSTENIBILITA</property>
                    <property name="nativeName">OBIETTIVI_SOSTENIBILITA</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
FIL_W.SOURCE_REFERENCE_ID AS "CODICE_OBIETTIVO_STRATEGICO",
SOSTOBS.LISTASOST AS "OBIETTIVI_SOSTENIBILITA"
FROM WORK_EFFORT FIL_W
LEFT JOIN(
	SELECT 
	--CONCAT(CONCAT(SOST.ETCH, CONCAT(' - ', CONCAT(SOST.WORK_EFFORT_NAME@langLocale, CONCAT('; ', SOST.WORK_EFFORT_NAME)))), '')
	--CONCAT(CONCAT(SOST.WORK_EFFORT_NAME@langLocale, CONCAT('; ', SOST.WORK_EFFORT_NAME)), '')
	SOST.WORK_EFFORT_NAME@langLocale
AS LISTASOST,
	SOSTOBS.WORK_EFFORT_ID_TO
	FROM WORK_EFFORT_ASSOC SOSTOBS
	LEFT JOIN WORK_EFFORT SOST ON SOST.WORK_EFFORT_ID = SOSTOBS.WORK_EFFORT_ID_FROM AND SOST.WORK_EFFORT_TYPE_ID = '20R84' AND SOST.WORK_EFFORT_REVISION_ID IS NULL
		AND SOST.ESTIMATED_START_DATE <= @date3112 AND (SOST.ESTIMATED_COMPLETION_DATE >= @date0101 OR SOST.ESTIMATED_COMPLETION_DATE IS NULL)
	WHERE SOSTOBS.WORK_EFFORT_ASSOC_TYPE_ID = '20R8C'
	AND SOSTOBS.FROM_DATE <= @date3112 AND (SOSTOBS.THRU_DATE IS NULL OR SOSTOBS.THRU_DATE >= @date0101)
) SOSTOBS ON SOSTOBS.WORK_EFFORT_ID_TO = FIL_W.WORK_EFFORT_ID


WHERE 
  FIL_W.WORK_EFFORT_TYPE_ID = '20D62' AND 
  FIL_W.ESTIMATED_START_DATE <= @date3112 AND FIL_W.ESTIMATED_COMPLETION_DATE >= @date0101
   --AND (@orgUnitId IS NULL OR @orgUnitId = '' OR @orgUnitId = FIL_W.ORG_UNIT_ID)
   --@orgUnitId
   AND FIL_W.WORK_EFFORT_ID = ? 
   
ORDER BY "CODICE_OBIETTIVO_STRATEGICO"
]]></xml-property>
        </oda-data-set>
