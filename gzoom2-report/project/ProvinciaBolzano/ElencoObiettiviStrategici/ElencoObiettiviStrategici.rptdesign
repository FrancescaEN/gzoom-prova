]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">DESC_ALLEGATI</property>
                    <property name="nativeName">DESC_ALLEGATI</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT
--    CONCAT(C.DESCRIPTION@langLocale, CONCAT('; ', C.CONTENT_NAME)) AS "DESC_ALLEGATI"
    C.DESCRIPTION@langLocale AS "DESC_ALLEGATI"
FROM
    WORK_EFFORT_CONTENT   WEC
    LEFT JOIN CONTENT C ON C.CONTENT_ID = WEC.CONTENT_ID
WHERE
    WEC.WORK_EFFORT_ID = ?
GROUP BY
--    CONCAT(C.DESCRIPTION@langLocale, CONCAT('; ', C.CONTENT_NAME))
    C.DESCRIPTION@langLocale 
ORDER BY
--    CONCAT(C.DESCRIPTION@langLocale, CONCAT('; ', C.CONTENT_NAME))
    C.DESCRIPTION@langLocale 
   ]]></xml-property>
        </oda-data-set>
