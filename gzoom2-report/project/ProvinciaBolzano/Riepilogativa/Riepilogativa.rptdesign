                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">22</property>
                    <property name="name">MONITORAGGIO_RAGGIUNGIMENTO_OBIETTIVO_3112</property>
                    <property name="nativeName">MONITORAGGIO_RAGGIUNGIMENTO_OBIETTIVO_3112</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">23</property>
                    <property name="name">PRIORITA_SVILUPPO_OBIETTIVO_STRATEGICO</property>
                    <property name="nativeName">PRIORITA_SVILUPPO_OBIETTIVO_STRATEGICO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">24</property>
                    <property name="name">GRADO_RAGGIUNGIMENTO_OBIETTIVI</property>
                    <property name="nativeName">GRADO_RAGGIUNGIMENTO_OBIETTIVI</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">25</property>
                    <property name="name">OBIETTIVI_SOSTENIBILITA</property>
                    <property name="nativeName">OBIETTIVI_SOSTENIBILITA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">26</property>
                    <property name="name">PREVISIONE_PERFORMANCE</property>
                    <property name="nativeName">PREVISIONE_PERFORMANCE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">27</property>
                    <property name="name">MONITORAGGIO_PERFORMANCE</property>
                    <property name="nativeName">MONITORAGGIO_PERFORMANCE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">28</property>
                    <property name="name">RELAZIONE_PERFORMANCE</property>
                    <property name="nativeName">RELAZIONE_PERFORMANCE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">29</property>
                    <property name="name">WORK_EFFORT_ID</property>
                    <property name="nativeName">WORK_EFFORT_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">30</property>
                    <property name="name">FLAG_PNRR</property>
                    <property name="nativeName">FLAG_PNRR</property>
