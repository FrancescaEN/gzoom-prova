            <xml-property name="queryText"><![CDATA[SELECT
	P.EXTERNAL_ID AS "Dipartimento - Abteilung",
	P.PARTY_NAME@langLocale AS "Nome dipartimento",
	P.PARTY_NAME AS "Abteilungsname",
	NULL AS "Ripartizione - Sektion",
	NULL AS "Nome ripartizione",
	NULL AS "Sektioname",
	NULL AS "Ufficio - Büro",
	NULL AS "Nome ufficio",
	NULL AS "Büroname",
	'1' AS "Sequenza",
	WET.DESCRIPTION@langLocale AS "Tipologia - Typologie",
	FIL_W.SOURCE_REFERENCE_ID AS "Codice",
	FIL_W.WORK_EFFORT_NAME@langLocale AS "Denominazione",
	FIL_W.WORK_EFFORT_NAME AS "Bezeichnung",
	FIL_W.WORK_EFFORT_ID AS "ID",
	P.PARTY_ID AS "depOrgUnitId",
	NULL AS "repOrgUnitId",
	NULL AS "uffOrgUnitId"
/* PRIORITA' SVILUPPO */
FROM WORK_EFFORT FIL_W
JOIN WORK_EFFORT_TYPE WET ON WET.WORK_EFFORT_TYPE_ID = FIL_W.WORK_EFFORT_TYPE_ID
/* STRUTTURA */
JOIN PARTY P ON P.PARTY_ID = FIL_W.ORG_UNIT_ID AND P.VAT_CODE = 2
/* START filterInnerJoin */
@filterInnerJoin
/* END filterInnerJoin */
/* START filterLeftJoin */
@filterLeftJoin
/* END filterLeftJoin */
WHERE FIL_W.WORK_EFFORT_TYPE_ID = '20D64' AND FIL_W.WORK_EFFORT_REVISION_ID IS NULL
AND FIL_W.ESTIMATED_START_DATE <= @date3112 AND (FIL_W.ESTIMATED_COMPLETION_DATE >= @date0101 OR FIL_W.ESTIMATED_COMPLETION_DATE IS NULL)
@depOrgUnitId

/* START filterWhere */
@filterWhere
/* END filterWhere */
UNION ALL

SELECT
	P.EXTERNAL_ID AS "Dipartimento - Abteilung",
	P.PARTY_NAME@langLocale AS "Nome dipartimento",
	P.PARTY_NAME AS "Abteilungsname",
	NULL AS "Ripartizione - Sektion",
	NULL AS "Nome ripartizione",
	NULL AS "Sektioname",
	NULL AS "Ufficio - Büro",
	NULL AS "Nome ufficio",
	NULL AS "Büroname",
	'2' AS "Sequenza",
	WET.DESCRIPTION@langLocale AS "Tipologia - Typologie",
	FIL_W.SOURCE_REFERENCE_ID AS "Codice",
	FIL_W.WORK_EFFORT_NAME@langLocale AS "Denominazione",
	FIL_W.WORK_EFFORT_NAME AS "Bezeichnung",
	FIL_W.WORK_EFFORT_ID AS "ID",
	P.PARTY_ID AS "depOrgUnitId",
	NULL AS "repOrgUnitId",
	NULL AS "uffOrgUnitId"
/* PRESTAZIONE */
FROM WORK_EFFORT FIL_W
JOIN WORK_EFFORT_TYPE WET ON WET.WORK_EFFORT_TYPE_ID = FIL_W.WORK_EFFORT_TYPE_ID
/* STRUTTURA */
JOIN PARTY P ON P.PARTY_ID = FIL_W.ORG_UNIT_ID AND P.VAT_CODE = 2
/* START filterInnerJoin */
@filterInnerJoin
/* END filterInnerJoin */
/* START filterLeftJoin */
@filterLeftJoin
/* END filterLeftJoin */
WHERE FIL_W.WORK_EFFORT_TYPE_ID = '20C42' AND FIL_W.WORK_EFFORT_REVISION_ID IS NULL
AND FIL_W.ESTIMATED_START_DATE <= @date3112 AND (FIL_W.ESTIMATED_COMPLETION_DATE >= @date0101 OR FIL_W.ESTIMATED_COMPLETION_DATE IS NULL)
@depOrgUnitId

/* START filterWhere */
@filterWhere
/* END filterWhere */
UNION ALL

SELECT
	PAPA.EXTERNAL_ID AS "Dipartimento - Abteilung",
	PAPA.PARTY_NAME@langLocale AS "Nome dipartimento",
	PAPA.PARTY_NAME AS "Abteilungsname",
	P.EXTERNAL_ID AS "Ripartizione - Sektion",
	P.PARTY_NAME@langLocale AS "Nome ripartizione",
	P.PARTY_NAME AS "Sektioname",
	NULL AS "Ufficio - Büro",
	NULL AS "Nome ufficio",
	NULL AS "Büroname",
	'3' AS "Sequenza",
	WET.DESCRIPTION@langLocale AS "Tipologia - Typologie",
	FIL_W.SOURCE_REFERENCE_ID AS "Codice",
	FIL_W.WORK_EFFORT_NAME@langLocale AS "Denominazione",
	FIL_W.WORK_EFFORT_NAME AS "Bezeichnung",
	FIL_W.WORK_EFFORT_ID AS "ID",
	NULL AS "depOrgUnitId",
	P.PARTY_ID AS "repOrgUnitId",
	NULL AS "uffOrgUnitId"
/* OBIETTIVO STRATEGICO */
FROM WORK_EFFORT FIL_W
JOIN WORK_EFFORT_TYPE WET ON WET.WORK_EFFORT_TYPE_ID = FIL_W.WORK_EFFORT_TYPE_ID
/* STRUTTURA */
JOIN PARTY P ON P.PARTY_ID = FIL_W.ORG_UNIT_ID AND P.VAT_CODE = 3
JOIN PARTY_PARENT_ROLE PPR ON PPR.PARTY_ID = P.PARTY_ID 
/* STRUTTURA PADRE */
JOIN PARTY_RELATIONSHIP PR ON PR.PARTY_ID_TO = P.PARTY_ID AND PR.PARTY_RELATIONSHIP_TYPE_ID = 'GROUP_ROLLUP' AND PR.THRU_DATE IS NULL
JOIN PARTY PAPA ON PAPA.PARTY_ID = PR.PARTY_ID_FROM 
JOIN PARTY_PARENT_ROLE PPRPA ON PPRPA.PARTY_ID = PAPA.PARTY_ID

/* START filterInnerJoin */
@filterInnerJoin
/* END filterInnerJoin */
/* START filterLeftJoin */
@filterLeftJoin
/* END filterLeftJoin */
WHERE FIL_W.WORK_EFFORT_TYPE_ID = '20D62' AND FIL_W.WORK_EFFORT_REVISION_ID IS NULL
	AND FIL_W.ESTIMATED_START_DATE <= @date3112 AND (FIL_W.ESTIMATED_COMPLETION_DATE >= @date0101 OR FIL_W.ESTIMATED_COMPLETION_DATE IS NULL)

@repOrgUnitId
/* START filterWhere */
@filterWhere
/* END filterWhere */
	
UNION ALL
