            <method name="beforeOpen"><![CDATA[
//non mettere questa riga di codice sotto perchè il replace di @date0101 disturberebbe il replace di @date0101meno4
this.queryText = this.queryText.replace("@date0101meno4",  params["date0101-4Sql"].value);
this.queryText = this.queryText.replace("@date3112piu2",  params["date3112+2Sql"].value);

this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value);
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value);	
this.queryText = this.queryText.replace("@langLocale",  params["langLocale"].value);
this.queryText = this.queryText.replace("@date3006",  params["date3006Sql"].value);
this.queryText = this.queryText.replace("@workEffortTypeId",  "'" + params["workEffortTypeId"].value + "'");


/*
this.queryText = this.queryText.replace("@date0101",  "'2019-01-01 00:00:00.000'" );
this.queryText = this.queryText.replace("@date3112",  "'2019-12-31 00:00:00.000'" );
this.queryText = this.queryText.replace("@date3006",  "'2019-06-30 00:00:00.000'" );
this.queryText = this.queryText.replace("@langLocale", "");
this.queryText = this.queryText.replace("@workEffortTypeId", "''");
*/

if(params["odaDialect"].value == 'oracle')
 this.queryText = this.queryText.replace("YEAR(",  "EXTRACT(YEAR FROM ");
 


/*ReportLog.info("AzioniDS : ");
ReportLog.info(this.queryText);*/]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">CODICE_PRIORITA</property>
                    <property name="nativeName">CODICE_PRIORITA</property>
