this.queryText = this.queryText.replace("@date1231-2", "TO_DATE('12/31/2022','MM/DD/YYYY')");
this.queryText = this.queryText.replace("@date1231-3", "TO_DATE('12/31/2022','MM/DD/YYYY')");

this.queryText = this.queryText.replace("@date3006",  "TO_DATE('12/31/2022','MM/DD/YYYY')");
this.queryText = this.queryText.replace("@workEffortTypeId",  "''");

this.queryText = this.queryText.replace("@langLocale",  "_LANG");
