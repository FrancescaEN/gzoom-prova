                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">ETICHETTA_PRESTAZIONE</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">4</property>
                        <property name="name">TITOLO_PRESTAZIONE</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">5</property>
                        <property name="name">CODICE_ESTERNO</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">6</property>
                        <property name="name">CODICE STRUTTURA</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">7</property>
                        <property name="name">NOME_STRUTTURA</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">8</property>
                        <property name="name">UNITA_RESPONSABILE</property>
                        <property name="dataType">string</property>
