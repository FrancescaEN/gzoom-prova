        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="ProcessiAnticorruzioneDS" id="59851">
            <list-property name="columnHints"/>
            <list-property name="parameters">
                <structure>
                    <property name="name">work_effort_id</property>
                    <property name="nativeName"></property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">0</property>
                    <property name="position">1</property>
                    <expression name="defaultValue" type="constant">N/A</expression>
                    <property name="isOptional">false</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">CODICE_OBIETTIVO_STRATEGICO</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">PROCESSI_ANTICORRUZIONE</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <method name="beforeOpen"><![CDATA[/* */
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value);
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value);	
this.queryText = this.queryText.replace("@langLocale",  params["langLocale"].value);
this.queryText = this.queryText.replace("@workEffortTypeId",  "'" + params["workEffortTypeId"].value + "'");

/*
this.queryText = this.queryText.replace("@date0101",  "'2019-01-01 00:00:00.000'" );
this.queryText = this.queryText.replace("@date3112",  "'2019-12-31 00:00:00.000'" );
this.queryText = this.queryText.replace("@langLocale", "");
this.queryText = this.queryText.replace("@workEffortTypeId", "''");
*/

/*
ReportLog.info("ProcessiAnticorruzionePNRRDS :");
ReportLog.info(this.queryText);
*/]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">CODICE_OBIETTIVO_STRATEGICO</property>
                    <property name="nativeName">CODICE_OBIETTIVO_STRATEGICO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">PROCESSI_ANTICORRUZIONE</property>
                    <property name="nativeName">PROCESSI_ANTICORRUZIONE</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
FIL_W.SOURCE_REFERENCE_ID AS "CODICE_OBIETTIVO_STRATEGICO",
PROCESSI.LISTAPROC AS "PROCESSI_ANTICORRUZIONE"
FROM WORK_EFFORT FIL_W
LEFT JOIN(
	SELECT PROC.WORK_EFFORT_NAME@langLocale AS LISTAPROC,
	WEA.WORK_EFFORT_ID_TO
	FROM WORK_EFFORT_ASSOC WEA
	LEFT JOIN WORK_EFFORT PROC ON PROC.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_FROM AND PROC.WORK_EFFORT_TYPE_ID = '15AP2SAR' AND PROC.WORK_EFFORT_REVISION_ID IS NULL
		AND PROC.ESTIMATED_START_DATE <= @date3112 AND (PROC.ESTIMATED_COMPLETION_DATE >= @date0101 OR PROC.ESTIMATED_COMPLETION_DATE IS NULL)
	WHERE WEA.WORK_EFFORT_ASSOC_TYPE_ID = '15APSAR2'
	AND WEA.FROM_DATE <= @date3112 AND (WEA.THRU_DATE IS NULL OR WEA.THRU_DATE >= @date0101)
) PROCESSI ON PROCESSI.WORK_EFFORT_ID_TO = FIL_W.WORK_EFFORT_ID

WHERE 
  FIL_W.WORK_EFFORT_TYPE_ID = '20C42' AND 
  FIL_W.ESTIMATED_START_DATE <= @date3112 AND FIL_W.ESTIMATED_COMPLETION_DATE >= @date0101

   AND FIL_W.WORK_EFFORT_ID = ? 
   
ORDER BY "CODICE_OBIETTIVO_STRATEGICO"


]]></xml-property>
        </oda-data-set>
    </data-sets>
