                    <method name="onPrepare"><![CDATA[importPackage(Packages.java.util);
importPackage(Packages.java.lang);
importPackage(Packages.javolution.util);
importPackage(Packages.org.ofbiz.base.util);
importPackage(Packages.com.mapsengineering.base.appheader);

var logo_header = AppHeaderLogo.getReportContentUrl(delegator, "REPORT_HEADER", params["defaultOrganizationPartyId"].value);
var icon_nav   = AppHeaderLogo.getReportContentUrl(delegator, "ICON_NAV", params["defaultOrganizationPartyId"].value);

reportContext.setPersistentGlobalVariable("logo_header", logo_header);
reportContext.setPersistentGlobalVariable("logo_footer", icon_nav);]]></method>
