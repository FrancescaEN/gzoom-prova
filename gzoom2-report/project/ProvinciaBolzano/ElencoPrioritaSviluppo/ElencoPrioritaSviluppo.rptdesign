                    <property name="nativeName">ESTIMATED_START_DATE</property>
                    <property name="dataType">date-time</property>
                    <property name="nativeDataType">93</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">ESTIMATED_COMPLETION_DATE</property>
                    <property name="nativeName">ESTIMATED_COMPLETION_DATE</property>
                    <property name="dataType">date-time</property>
                    <property name="nativeDataType">93</property>
                </structure>
