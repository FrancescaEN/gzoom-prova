            <method name="onPageEnd"><![CDATA[importPackage(Packages.java.util);
importPackage(Packages.com.mapsengineering.base.birt.util);

var NPage = reportContext.getGlobalVariable("nPagina");
NPage= parseInt(NPage) + 1;
reportContext.setGlobalVariable("nPagina", NPage);
reportContext.setPageVariable("NpageNumber", NPage-1);


var NPageIndex = reportContext.getGlobalVariable("NpageIndex");
NPageIndex= parseInt(NPage) + 1;
reportContext.setGlobalVariable("NpageIndex", NPageIndex);
reportContext.setPageVariable("NpageIndexRoman", com.mapsengineering.base.birt.util.UtilNumber.convertNumberToRomanNumeral(NPageIndex) );]]></method>
        </simple-master-page>
        <simple-master-page name="MasterPageLSConTitoloFooterCustomTramiteVariabile" id="59487">
            <property name="type">a4</property>
            <property name="orientation">landscape</property>
            <method name="onPageEnd"><![CDATA[importPackage(Packages.java.util);
importPackage(Packages.com.mapsengineering.base.birt.util);

//Questa master page funziona utilizzando (creandosi) una variabile globale intitolata "titleMasterPage"
//dove all'interno va inserita la stringa che si desidera visualizzare nel footer della masterPage
//
//nello script globale impostare (sostituire STRINGA_DA_VISUALIZZARE)
//reportContext.setPersistentGlobalVariable("titleMasterPage",STRINGA_DA_VISUALIZZARE);

var NPage = reportContext.getGlobalVariable("nPagina");
NPage= parseInt(NPage) + 1;
reportContext.setGlobalVariable("nPagina", NPage);
reportContext.setPageVariable("NpageNumber", NPage-1);


var NPageIndex = reportContext.getGlobalVariable("NpageIndex");
NPageIndex= parseInt(NPage) + 1;
reportContext.setGlobalVariable("NpageIndex", NPageIndex);
reportContext.setPageVariable("NpageIndexRoman", com.mapsengineering.base.birt.util.UtilNumber.convertNumberToRomanNumeral(NPageIndex) );]]></method>
