<?xml version="1.0" encoding="UTF-8"?>
<report xmlns="http://www.eclipse.org/birt/2005/design" version="3.2.23" id="1">
    <property name="createdBy">Eclipse BIRT Designer Version 4.8.0.v201806261756</property>
    <simple-property-list name="includeResource">
        <value>custom/Riepilogativa/Riepilogativa</value>
    </simple-property-list>
    <property name="units">in</property>
    <method name="initialize"><![CDATA[importPackage(Packages.java.util);
importPackage(Packages.java.lang);
importPackage(Packages.javolution.util);
importPackage(Packages.org.ofbiz.base.util);
importPackage(Packages.com.mapsengineering.base.appheader);
importPackage(Packages.it.mapsgroup.gzoom);
importPackage(Packages.com.mapsengineering.base.birt.util);

var vectorPageNumber = new Vector();
reportContext.setGlobalVariable("vectorPageNumber", vectorPageNumber);
reportContext.setGlobalVariable("nPagina", 1);
reportContext.setGlobalVariable("NpageIndex", 0 );
reportContext.setGlobalVariable("nPageEmpty", 0 );



var mapRealPageNumber = reportContext.getPersistentGlobalVariable("mapRealPageNumber");
if (mapRealPageNumber == null ) {
	mapRealPageNumber = new java.util.HashMap();
	reportContext.setPersistentGlobalVariable("mapRealPageNumber", mapRealPageNumber);
}


//var logo_login = AppHeaderLogo.getReportContentUrl("REPORT_LARGE", "Company");
//var logo_login = AppHeaderLogo.getReportContentUrl("REPORT_MEDIUM",  params["defaultOrganizationPartyId"].value);
var logo_login = AppHeaderLogo.getReportContentUrl("REPORT_LARGE",  params["defaultOrganizationPartyId"].value);
reportContext.setPersistentGlobalVariable("logo_login", logo_login);
var logo_large = AppHeaderLogo.getReportContentUrl("REPORT_LARGE", params["defaultOrganizationPartyId"].value);
reportContext.setPersistentGlobalVariable("logo_large", logo_large);
var logo_header = AppHeaderLogo.getReportContentUrl("REPORT_HEADER", params["defaultOrganizationPartyId"].value);
reportContext.setPersistentGlobalVariable("logo_header", logo_header);


var title_custom='';
if(params["reportContentId"].value == 'REPORT_PREV_PRISVIL')
{
	if(params["langLocale"].value != '')
		title_custom = 'Previsione Priorità Sviluppo';
	else
		title_custom = 'Entwicklungsprioritätsprognose';
}
else if(params["reportContentId"].value == 'REPORT_MON_PRISVIL')
{
	if(params["langLocale"].value != '')
		title_custom = 'Monitoraggio Priorità Sviluppo';
	else
		title_custom = 'Überwachung der Entwicklungspriorität';
}
else
{
	if(params["langLocale"].value != '')
		title_custom = 'Valutazione Priorità Sviluppo';
	else
		title_custom = 'Bewertung der Entwicklungspriorität';
}
title_custom = title_custom + ' - ' + BirtDateTime.year(params["customTimePeriod"].value);

reportContext.setPersistentGlobalVariable("title_custom",title_custom);


//setting della variabile titolo da mostrare nella masterPage 
var title_footer_master_page = ''
var yearMoreYear2 = " "+BirtDateTime.year(params["customTimePeriod"].value) + " - "+ (BirtDateTime.year(params["customTimePeriod"].value) +2)+" ";
if(params["reportContentId"].value == 'REPORT_PREV_PRISVIL')
{
//durante l'inizializzazione
//params["langLocale"].value == "" quando è la prima lingua
//params["langLocale"].value == "_LANG" quando è la seconda lingua
	if(params["langLocale"].value != "")
		title_footer_master_page = "Piano della performance"+yearMoreYear2+"- Priorità di sviluppo";
	else
		title_footer_master_page = "Performance-Plan"+yearMoreYear2+"- Entwicklungsschwerpunkte";
}
else if(params["reportContentId"].value == 'REPORT_MON_PRISVIL')
{
	if(params["langLocale"].value != "")
		title_footer_master_page = "Monitoraggio"+yearMoreYear2+"- Priorità di sviluppo";
	else
		title_footer_master_page = "Monitoring"+yearMoreYear2+"- Entwicklungsschwerpunkte";
}
else
{
	if(params["langLocale"].value != "")
		title_footer_master_page = "Relazione sulla performance"+ " "+BirtDateTime.year(params["customTimePeriod"].value)+" - Priorità di sviluppo";
	else
		title_footer_master_page = "Performance-Bericht"+ " "+BirtDateTime.year(params["customTimePeriod"].value)+" - Entwicklungsschwerpunkte";
}
reportContext.setPersistentGlobalVariable("titleMasterPage",title_footer_master_page);]]></method>
