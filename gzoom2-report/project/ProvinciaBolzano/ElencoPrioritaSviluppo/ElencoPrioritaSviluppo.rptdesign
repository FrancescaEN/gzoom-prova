            <xml-property name="queryText"><![CDATA[SELECT 
	PRIO.SOURCE_REFERENCE_ID AS "CODICE_PRIORITA",
	AZ.WORK_EFFORT_NAME@langLocale AS "TITOLO_AZIONE",
	YEAR(AZ.ESTIMATED_START_DATE) AS "ANNO_INIZIO",
	YEAR(AZ.ESTIMATED_COMPLETION_DATE) AS "ANNO_FINE",
	PRIO.ESTIMATED_START_DATE,
	PRIO.ESTIMATED_COMPLETION_DATE
FROM WORK_EFFORT PRIO
JOIN WORK_EFFORT_ASSOC WEA ON WEA.WORK_EFFORT_ID_FROM = PRIO.WORK_EFFORT_ID AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '20D64'
JOIN WORK_EFFORT AZ ON AZ.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_TO AND AZ.WORK_EFFORT_TYPE_ID = '20D66'
WHERE 
	PRIO.WORK_EFFORT_TYPE_ID = '20D64'
	AND PRIO.ESTIMATED_START_DATE <= @date3112 AND PRIO.ESTIMATED_COMPLETION_DATE >= @date0101
	--AND WEA.FROM_DATE <= @date3112 AND (WEA.THRU_DATE IS NULL OR WEA.THRU_DATE >= @date0101)
	AND AZ.ESTIMATED_START_DATE <= @date3112piu2 AND AZ.ESTIMATED_COMPLETION_DATE >= @date0101meno4
    --AND (EXISTS (SELECT 1 FROM USER_LOGIN_SECURITY_GROUP ULSG 
    --          INNER JOIN SECURITY_GROUP_PERMISSION SP ON SP.GROUP_ID = ULSG.GROUP_ID AND SP.PERMISSION_ID = 'BSCPERFMGR_ADMIN'
    --          WHERE ULSG.USER_LOGIN_ID = '#USERID#')  -- #USERID# = ADMIN / PB13757
    --OR EXISTS (SELECT 1 FROM USER_LOGIN_SECURITY_GROUP ULSG 
    --           INNER JOIN SECURITY_GROUP_PERMISSION SP ON SP.GROUP_ID = ULSG.GROUP_ID AND SP.PERMISSION_ID = 'BSCPERFORG_ADMIN'
    --           INNER JOIN USER_LOGIN UL ON UL.USER_LOGIN_ID = ULSG.USER_LOGIN_ID 
    --           INNER JOIN PARTY_RELATIONSHIP PR ON PR.PARTY_ID_TO = UL.PARTY_ID
    --           AND PR.PARTY_ID_FROM = PRIO.ORG_UNIT_ID AND PR.PARTY_RELATIONSHIP_TYPE_ID IN ('ORG_RESPONSIBLE', 'ORG_DELEGATE')
    --           AND (PR.THRU_DATE IS NULL OR PR.THRU_DATE >= @date0101)))
	 		   AND PRIO.WORK_EFFORT_TYPE_ID = @workEffortTypeId
			   AND PRIO.WORK_EFFORT_ID = ?
	
ORDER BY
AZ.SOURCE_REFERENCE_ID,
AZ.WORK_EFFORT_NAME@langLocale]]></xml-property>
