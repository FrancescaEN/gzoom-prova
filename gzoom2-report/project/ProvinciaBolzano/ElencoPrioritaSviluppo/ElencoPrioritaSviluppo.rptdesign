            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT
	FIL_W.ETCH AS "ETICHETTA_PRIORITA_SVILUPPO",
	FIL_W.WORK_EFFORT_NAME@langLocale AS "TITOLO_PRIORITA_SVILUPPO",
	FIL_W.SOURCE_REFERENCE_ID AS "CODICE",
	FIL_W.WORK_EFFORT_NAME@langLocale AS "DENOMINAZIONE",
	FIL_W.ETCH AS "NR",
	PA.EXTERNAL_ID AS "CODICE_ESTERNO",
	PPR.PARENT_ROLE_CODE AS "CODICE_STRUTTURA",
	PA.PARTY_NAME@langLocale AS "NOME_STRUTTURA",
	PAPA.EXTERNAL_ID AS "CODICE_ESTERNO_PADRE",
	PPRPA.PARENT_ROLE_CODE AS "CODICE_STRUTTURA_PADRE",
	PAPA.PARTY_NAME@langLocale AS "NOME_STRUTTURA_PADRE",
	OBS.SOURCE_REFERENCE_ID AS "CODICE_OBIETTIVO_STRATEGICO",
	OBS.WORK_EFFORT_NAME@langLocale AS "NOME_OBIETTIVO_STRATEGICO",
	TEM.SOURCE_REFERENCE_ID AS "CODICE_TEMA",
	TEM.WORK_EFFORT_NAME@langLocale AS "TEMA",
	MAX(CASE WHEN INDFLAG.GL_ACCOUNT_ID = '10090' THEN INDFLAG.UOM_CODE@langLocale ELSE NULL END) AS "FLAG_DEFP",
	MAX(CASE WHEN INDFLAG.GL_ACCOUNT_ID = '10091' THEN INDFLAG.UOM_CODE@langLocale ELSE NULL END) AS "FLAG_PARIOPP",
	MAX(CASE WHEN INDFLAG.GL_ACCOUNT_ID = '10092' THEN INDFLAG.UOM_CODE@langLocale ELSE NULL END) AS "PROMOZIONE_SOSTENIBILITA",
	MAX(CASE WHEN INDFLAG.GL_ACCOUNT_ID = '10093' THEN INDFLAG.UOM_CODE@langLocale ELSE NULL END) AS "FLAG_QUALITA",
	MAX(CASE WHEN IND.GL_ACCOUNT_ID = '10126' THEN IND.UOM_DESCR@langLocale ELSE NULL END) AS "MONITORAGGIO RAGGIUNGIMENTO_OBIETTIVO",
	MAX(CASE WHEN IND.TRANSACTION_DATE = @date3006 AND IND.GL_ACCOUNT_ID = '10126' THEN IND.UOM_DESCR@langLocale ELSE NULL END) AS "MONITORAGGIO_RAGGIUNGIMENTO_OBIETTIVO_3006",
	MAX(CASE WHEN IND.TRANSACTION_DATE = @date3112 AND IND.GL_ACCOUNT_ID = '10126' THEN IND.UOM_DESCR@langLocale ELSE NULL END) AS "MONITORAGGIO_RAGGIUNGIMENTO_OBIETTIVO_3112",
	
	MAX(CASE WHEN INDFLAG.GL_ACCOUNT_ID = '10820' THEN INDFLAG.UOM_CODE@langLocale ELSE NULL END) AS "PRIORITA_SVILUPPO_OBIETTIVO_STRATEGICO",
	
	MAX(CASE WHEN IND.GL_ACCOUNT_ID = '10096' THEN IND.UOM_DESCR@langLocale ELSE NULL END) AS "GRADO_RAGGIUNGIMENTO_OBIETTIVI",
	SOSTOBS.LISTASOST AS "OBIETTIVI_SOSTENIBILITA",
	--CAST(NOTEPRE.NOTE_INFO@langLocale AS VARCHAR(4000)) AS "PREVISIONE_PERFORMANCE",
	--CAST(NOTEMON.NOTE_INFO@langLocale AS VARCHAR(4000)) AS "MONITORAGGIO_PERFORMANCE",
	--CAST(NOTEREL.NOTE_INFO@langLocale AS VARCHAR(4000)) AS "RELAZIONE_PERFORMANCE",
	--dbms_lob.substr(NOTEPRE.NOTE_INFO@langLocale,3980,0) AS "PREVISIONE_PERFORMANCE",
	case when NOTEPRE.NOTE_INFO@langLocale is not null then dbms_lob.substr(NOTEPRE.NOTE_INFO@langLocale,3980,1) else null end "PREVISIONE_PERFORMANCE",
	--dbms_lob.substr(NOTEMON.NOTE_INFO@langLocale,3980,0) AS "MONITORAGGIO_PERFORMANCE",
	case when NOTEMON.NOTE_INFO@langLocale is not null then dbms_lob.substr(NOTEMON.NOTE_INFO@langLocale,3980,1) else null end "MONITORAGGIO_PERFORMANCE",
	--dbms_lob.substr(NOTEREL.NOTE_INFO@langLocale,3980,0) AS "RELAZIONE_PERFORMANCE",
	case when NOTEREL.NOTE_INFO@langLocale is not null then dbms_lob.substr(NOTEREL.NOTE_INFO@langLocale,3980,1) else null end "RELAZIONE_PERFORMANCE",
	FIL_W.WORK_EFFORT_ID AS "WORK_EFFORT_ID",
	MAX(CASE WHEN INDFLAG.GL_ACCOUNT_ID = '11140' THEN INDFLAG.UOM_CODE@langLocale ELSE NULL END) AS "FLAG_PNRR",
	MAX(CASE WHEN INDFLAG.GL_ACCOUNT_ID = '11141' THEN INDFLAG.UOM_CODE@langLocale ELSE NULL END) AS "FLAG_PNC"
	
/* PRIORITA' DI SVILUPPO */
FROM WORK_EFFORT FIL_W
/* TEMA */
JOIN WORK_EFFORT_ASSOC WEATEM ON WEATEM.WORK_EFFORT_ID_TO = FIL_W.WORK_EFFORT_ID AND WEATEM.WORK_EFFORT_ASSOC_TYPE_ID = '20R4C'
JOIN WORK_EFFORT TEM ON TEM.WORK_EFFORT_ID = WEATEM.WORK_EFFORT_ID_FROM AND TEM.WORK_EFFORT_TYPE_ID = '20R44'
/* OBIETTIVO STRATEGICO */
LEFT JOIN WORK_EFFORT_ASSOC WEA ON WEA.WORK_EFFORT_ID_TO = FIL_W.WORK_EFFORT_ID AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '20D62C'
AND WEA.FROM_DATE <= @date3112 AND (WEA.THRU_DATE IS NULL OR WEA.THRU_DATE >= @date0101)
LEFT JOIN WORK_EFFORT OBS ON OBS.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_FROM AND OBS.WORK_EFFORT_TYPE_ID = '20D62'
/* OBIETTIVO DI SOSTENIBILITA' */
LEFT JOIN(
	SELECT 
	SOST.ETCH,
	SOST.WORK_EFFORT_NAME_LANG

AS LISTASOST,
	SOSTOBS.WORK_EFFORT_ID_TO
	FROM WORK_EFFORT_ASSOC SOSTOBS
	LEFT JOIN WORK_EFFORT SOST ON SOST.WORK_EFFORT_ID = SOSTOBS.WORK_EFFORT_ID_FROM AND SOST.WORK_EFFORT_TYPE_ID = '20R84' AND SOST.WORK_EFFORT_REVISION_ID IS NULL
		AND SOST.ESTIMATED_START_DATE <= @date3112 AND (SOST.ESTIMATED_COMPLETION_DATE >= @date0101 OR SOST.ESTIMATED_COMPLETION_DATE IS NULL)
	WHERE SOSTOBS.WORK_EFFORT_ASSOC_TYPE_ID = '20R8C'
	AND SOSTOBS.FROM_DATE <= @date3112 AND (SOSTOBS.THRU_DATE IS NULL OR SOSTOBS.THRU_DATE >= @date0101)
	GROUP BY SOSTOBS.WORK_EFFORT_ID_TO,SOST.ETCH,SOST.WORK_EFFORT_NAME_LANG
) SOSTOBS ON SOSTOBS.WORK_EFFORT_ID_TO = FIL_W.WORK_EFFORT_ID

/* STRUTTURA*/
JOIN PARTY PA ON PA.PARTY_ID = FIL_W.ORG_UNIT_ID
JOIN PARTY_PARENT_ROLE PPR ON PPR.PARTY_ID = PA.PARTY_ID
/* STRUTTURA PADRE */
LEFT JOIN PARTY_RELATIONSHIP PRPA ON PRPA.PARTY_ID_TO = PA.PARTY_ID AND PRPA.THRU_DATE IS NULL AND PRPA.PARTY_RELATIONSHIP_TYPE_ID = 'GROUP_ROLLUP' 
LEFT JOIN PARTY_PARENT_ROLE PPRPA ON PPRPA.PARTY_ID = PRPA.PARTY_ID_FROM
LEFT JOIN PARTY PAPA ON PAPA.PARTY_ID = PRPA.PARTY_ID_FROM
/* FLAG CARATTERISTICHE  */
LEFT JOIN (
	SELECT
		RS.UOM_CODE,
		RS.UOM_CODE_LANG,
		WEM.WORK_EFFORT_ID,
		WEM.GL_ACCOUNT_ID		
	FROM WORK_EFFORT_MEASURE WEM 
	INNER JOIN ACCTG_TRANS_ENTRY ATE ON ATE.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID
	INNER JOIN WORK_EFFORT_MEAS_RAT_SC RS ON RS.WORK_EFFORT_MEASURE_ID = WEM.WORK_EFFORT_MEASURE_ID
		AND RS.UOM_ID = ATE.CURRENCY_UOM_ID AND RS.UOM_RATING_VALUE = ATE.AMOUNT
) INDFLAG ON INDFLAG.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
/* INDICATORI PRIORITÀ DI SVILUPPO */
LEFT JOIN(
	SELECT WEM.WORK_EFFORT_ID, WEMRS.UOM_DESCR, WEMRS.UOM_DESCR_LANG, ATE.GL_ACCOUNT_ID, ACT.TRANSACTION_DATE
	FROM WORK_EFFORT_MEASURE WEM 
	JOIN ACCTG_TRANS ACT ON ACT.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID AND ACT.TRANSACTION_DATE = @date3112
	JOIN ACCTG_TRANS_ENTRY ATE ON ATE.ACCTG_TRANS_ID = ACT.ACCTG_TRANS_ID
	LEFT JOIN WORK_EFFORT_MEAS_RAT_SC WEMRS ON WEMRS.WORK_EFFORT_MEASURE_ID = ATE.VOUCHER_REF 
		AND WEMRS.UOM_RATING_VALUE <= ATE.AMOUNT AND WEMRS.UOM_RATING_VALUE >= ATE.AMOUNT
) IND ON IND.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
/* NOTE DELLA PRIORITÀ DI SVILUPPO */
LEFT JOIN(
	SELECT WEN.WORK_EFFORT_ID, ND.NOTE_INFO_LANG, ND.NOTE_INFO
	FROM WORK_EFFORT_NOTE WEN 
	JOIN NOTE_DATA ND ON ND.NOTE_ID = WEN.NOTE_ID AND ND.NOTE_DATE_TIME = @date0101
	WHERE WEN.SEQUENCE_ID = '110'
) NOTEPRE ON NOTEPRE.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
LEFT JOIN(
	SELECT WEN.WORK_EFFORT_ID, ND.NOTE_INFO_LANG, ND.NOTE_INFO
	FROM WORK_EFFORT_NOTE WEN 
	JOIN NOTE_DATA ND ON ND.NOTE_ID = WEN.NOTE_ID AND ND.NOTE_DATE_TIME = @date3006
	WHERE WEN.SEQUENCE_ID = '115'
) NOTEMON ON NOTEMON.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
LEFT JOIN(
	SELECT WEN.WORK_EFFORT_ID, ND.NOTE_INFO_LANG, ND.NOTE_INFO
	FROM WORK_EFFORT_NOTE WEN 
	JOIN NOTE_DATA ND ON ND.NOTE_ID = WEN.NOTE_ID AND ND.NOTE_DATE_TIME = @date3112
	WHERE WEN.SEQUENCE_ID = '120'
) NOTEREL ON NOTEREL.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID

	@filterInnerJoin
	@filterLeftJoin

WHERE fil_w.organization_id=@defaultOrganizationId
	and FIL_W.WORK_EFFORT_TYPE_ID = @workEffortTypeId
	AND FIL_W.ESTIMATED_START_DATE <= @date3112 AND FIL_W.ESTIMATED_COMPLETION_DATE >= @date0101
	AND WEATEM.FROM_DATE <= @date3112 AND (WEATEM.THRU_DATE IS NULL OR WEATEM.THRU_DATE >= @date0101)
    @orgUnitId
	@filterWhere
GROUP BY
	FIL_W.SOURCE_REFERENCE_ID,
	FIL_W.WORK_EFFORT_NAME@langLocale,
	FIL_W.WORK_EFFORT_NAME,
	PA.EXTERNAL_ID,
	PPR.PARENT_ROLE_CODE,
	PA.PARTY_NAME@langLocale,
	PA.PARTY_NAME,
	PAPA.EXTERNAL_ID,
	PPRPA.PARENT_ROLE_CODE,
	PAPA.PARTY_NAME@langLocale,
	PAPA.PARTY_NAME,
	OBS.SOURCE_REFERENCE_ID,
	OBS.WORK_EFFORT_NAME,
	OBS.WORK_EFFORT_NAME@langLocale,
	TEM.SOURCE_REFERENCE_ID,
	TEM.WORK_EFFORT_NAME,
	TEM.WORK_EFFORT_NAME@langLocale,
	FIL_W.ETCH,
	SOSTOBS.LISTASOST,
	--CAST(NOTEPRE.NOTE_INFO@langLocale AS VARCHAR(4000)),
	--CAST(NOTEMON.NOTE_INFO@langLocale AS VARCHAR(4000)),
	--CAST(NOTEREL.NOTE_INFO@langLocale AS VARCHAR(4000)),
	--dbms_lob.substr(NOTEPRE.NOTE_INFO@langLocale,3980,0),
	CASE WHEN NOTEPRE.NOTE_INFO@langLocale is not NULL THEN dbms_lob.substr(NOTEPRE.NOTE_INFO@langLocale,3980,1) ELSE null END ,
	--dbms_lob.substr(NOTEMON.NOTE_INFO@langLocale,3980,0),
	CASE WHEN NOTEMON.NOTE_INFO@langLocale is not NULL THEN dbms_lob.substr(NOTEMON.NOTE_INFO@langLocale,3980,1) ELSE null END ,
	--dbms_lob.substr(NOTEREL.NOTE_INFO@langLocale,3980,0),
	CASE WHEN NOTEREL.NOTE_INFO@langLocale is not NULL THEN dbms_lob.substr(NOTEREL.NOTE_INFO@langLocale,3980,1) ELSE null END ,
	FIL_W.WORK_EFFORT_ID
ORDER BY
	FIL_W.SOURCE_REFERENCE_ID,
	PAPA.EXTERNAL_ID]]></xml-property>
            <xml-property name="designerValues"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
