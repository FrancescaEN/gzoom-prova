            <xml-property name="queryText"><![CDATA[SELECT 
SOST.ETCH, 
SOST.WORK_EFFORT_NAME@langLocale AS "TITOLO",
SOSTOBS.WORK_EFFORT_ID_TO
FROM WORK_EFFORT_ASSOC SOSTOBS
LEFT JOIN WORK_EFFORT SOST ON SOST.WORK_EFFORT_ID = SOSTOBS.WORK_EFFORT_ID_FROM AND SOST.WORK_EFFORT_TYPE_ID = '20R84' AND SOST.WORK_EFFORT_REVISION_ID IS NULL
AND SOST.ESTIMATED_START_DATE <= @date0101
AND (SOST.ESTIMATED_COMPLETION_DATE >= @date0101 OR SOST.ESTIMATED_COMPLETION_DATE IS NULL)
WHERE SOSTOBS.WORK_EFFORT_ID_TO = ?
AND SOSTOBS.WORK_EFFORT_ASSOC_TYPE_ID = '20R8C'
GROUP BY SOST.ETCH, SOST.WORK_EFFORT_NAME@langLocale,SOSTOBS.WORK_EFFORT_ID_TO]]></xml-property>
