    <data-sets>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="MasterDS" id="55937">
            <property name="nullsOrdering">nulls lowest</property>
            <list-property name="computedColumns">
                <structure>
                    <property name="name">ETICHETTA_TITOLO</property>
                    <expression name="expression">row["ETICHETTA"]+" - "+row["TITOLO_OBIETTIVO_OPERATIVO"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">NOME_STRUTTURA_1_LIV</property>
                    <expression name="expression">row["UNITA_RESPONSABILE_PADRE"]+" - "+row["UNITA_RESPONSABILE"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">ETICHETTA_NUM</property>
                    <expression name="expression">importPackage(Packages.com.mapsengineering.base.birt.util);&#13;
&#13;
UtilStrings.convertStringToNumber(row["ETICHETTA"])</expression>
                    <property name="dataType">integer</property>
                </structure>
            </list-property>
            <list-property name="columnHints"/>
            <list-property name="parameters"/>
            <structure name="cachedMetaData"/>
            <method name="beforeOpen"><![CDATA[/**/
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value);
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value);	
this.queryText = this.queryText.replace("@langLocale",  params["langLocale"].value);
this.queryText = this.queryText.replace("@date3006",  params["date3006Sql"].value);
this.queryText = this.queryText.replace("@workEffortTypeId",  "'" + params["workEffortTypeId"].value + "'");
this.queryText = this.queryText.replace("@defaultOrganizationId",  "'" + params["defaultOrganizationPartyId"].value + "'");

/*
this.queryText = this.queryText.replace("@date0101",  "TO_DATE('01/01/2022','MM/DD/YYYY')" );
this.queryText = this.queryText.replace("@date3112",  "TO_DATE('12/31/2022','MM/DD/YYYY')" );
this.queryText = this.queryText.replace("@date3006",  "TO_DATE('06/30/2022','MM/DD/YYYY')" );
this.queryText = this.queryText.replace("@workEffortTypeId", "'20P46'");

this.queryText = this.queryText.replace("@langLocale", "_LANG");
*/

var orgUnitIdString = "";
if (params["orgUnitId"].value != null &amp;&amp; params["orgUnitId"].value != '') {
	orgUnitIdString = " AND ('" + params["orgUnitId"].value + "' IS NULL OR '" + params["orgUnitId"].value + "' = '' OR '" + params["orgUnitId"].value + "' = FIL_W.ORG_UNIT_ID) ";
}
this.queryText = this.queryText.replace("@orgUnitId", orgUnitIdString);

//GESTIRE PERMESSI
/**/
filter = new com.mapsengineering.base.birt.util.UtilFilter(params["userLoginId"].value, params["localDispatcherName"].value);
var filterInnerJoin = filter.getWorkEffortFilterInner();
var filterLeftJoin = filter.getWorkEffortFilterLeftJoin();
var filterWhere = filter.getWorkEffortFilterWhere(); 

/* 
var filterInnerJoin = "";
var filterLeftJoin = "";
var filterWhere = "";
*/
this.queryText = this.queryText.replace("@filterInnerJoin",  filterInnerJoin );
this.queryText = this.queryText.replace("@filterLeftJoin",  filterLeftJoin );
this.queryText = this.queryText.replace("@filterWhere",  filterWhere );

//ReportLog.info("......this.queryText Obiettivi Operativi: "+this.queryText);]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet"/>
            <xml-property name="queryText"><![CDATA[SELECT 
	FIL_W.WORK_EFFORT_ID, 
	FIL_W.SOURCE_REFERENCE_ID AS "CODICE_OBIETTIVO_OPERATIVO",
	FIL_W.WORK_EFFORT_NAME@langLocale AS "TITOLO_OBIETTIVO_OPERATIVO",
	FIL_W.ETCH AS "ETICHETTA",
	P.EXTERNAL_ID AS "CODICE_ESTERNO",
	PPR.PARENT_ROLE_CODE AS "CODICE_STRUTTURA",
	P.PARTY_NAME@langLocale AS "UNITA_RESPONSABILE",	
	PAPA.EXTERNAL_ID AS "CODICE_ESTERNO_PADRE",
	PPRPA.PARENT_ROLE_CODE AS "CODICE_STRUTTURA_PADRE",
	PAPA.PARTY_NAME@langLocale AS "UNITA_RESPONSABILE_PADRE",
	WE02.SOURCE_REFERENCE_ID AS "CODICE_OBIETTIVO_STRATEGICO",
	WE02.WORK_EFFORT_NAME@langLocale AS "NOME_OBIETTIVO_STRATEGICO",
	WE04.SOURCE_REFERENCE_ID AS "CODICE_PRESTAZIONE",
	WE04.WORK_EFFORT_NAME@langLocale AS "NOME_PRESTAZIONE",
	WE03.SOURCE_REFERENCE_ID AS "CODICE_PRIORITA_SVILUPPO",
	WE03.WORK_EFFORT_NAME@langLocale AS "NOME_PRIORITA",
	WE01.SOURCE_REFERENCE_ID AS "CODICE_PROCEDIMENTO",
	WE01.WORK_EFFORT_NAME@langLocale AS "NOME_PROCEDIMENTO",
	MAX(CASE WHEN IND.GL_ACCOUNT_ID = '10105' THEN IND.UOM_CODE@langLocale ELSE NULL END) AS "OBIETTIVO_UNITA_ORG",
	MAX(CASE WHEN IND.GL_ACCOUNT_ID = '10091' THEN IND.UOM_CODE@langLocale ELSE NULL END) AS "PROMOZIONI_PARI_OPORTUNITA",
	MAX(CASE WHEN IND.GL_ACCOUNT_ID = '10092' THEN IND.UOM_CODE@langLocale ELSE NULL END) AS "PROMOZIONE_SOSTENIBILITA",
	MAX(CASE WHEN IND.GL_ACCOUNT_ID = '10093' THEN IND.UOM_CODE@langLocale ELSE NULL END) AS "STRUMENTI_QUALITA",
	MAX(CASE WHEN IND.GL_ACCOUNT_ID = '10821' THEN IND.UOM_CODE@langLocale ELSE NULL END) AS "OBIETTIVO_STRATEGICO",
	MAX(CASE WHEN IND.GL_ACCOUNT_ID = '10822' THEN IND.UOM_CODE@langLocale ELSE NULL END) AS "OBIETTIVO_PRESTAZIONE",
	MAX(CASE WHEN IND.GL_ACCOUNT_ID = '10823' THEN IND.UOM_CODE@langLocale ELSE NULL END) AS "OBIETTIVO_PRIORITA_SVILUPPO",
	MAX(CASE WHEN IND.GL_ACCOUNT_ID = '10824' THEN IND.UOM_CODE@langLocale ELSE NULL END) AS "OBIETTIVO_PROCEDIMENTO",
	
	COD_ASS.PARENT_ROLE_CODE AS "CODICE_PERS_ASSEGNATA",
	ASS.PARTY_NAME AS "PERSONALE_ASSEGNATO",
	ALLEGATO.WORK_EFFORT_ID AS "ALLEGATO",
	GRADO.UOM_DESCR@langLocale AS "GRADO_RAGGIUNGIMENTO",
	NOTEPRE.WORK_EFFORT_ID AS "NOTE_PREV",
	NOTEREL.WORK_EFFORT_ID AS "NOTE_REL",
	RESP.PARTY_NAME AS "DIRIGENTE"
FROM WORK_EFFORT FIL_W
/* RELAZIONI */
LEFT JOIN WORK_EFFORT_ASSOC WEA01 ON WEA01.WORK_EFFORT_ID_TO = FIL_W.WORK_EFFORT_ID AND WEA01.WORK_EFFORT_ASSOC_TYPE_ID = '20C44C'
LEFT JOIN WORK_EFFORT_ASSOC WEA02 ON WEA02.WORK_EFFORT_ID_TO = FIL_W.WORK_EFFORT_ID AND WEA02.WORK_EFFORT_ASSOC_TYPE_ID = '20D62'
LEFT JOIN WORK_EFFORT_ASSOC WEA03 ON WEA03.WORK_EFFORT_ID_TO = FIL_W.WORK_EFFORT_ID AND WEA03.WORK_EFFORT_ASSOC_TYPE_ID = '20D64'
LEFT JOIN WORK_EFFORT_ASSOC WEA04 ON WEA04.WORK_EFFORT_ID_TO = FIL_W.WORK_EFFORT_ID AND WEA04.WORK_EFFORT_ASSOC_TYPE_ID = '20C42C'
LEFT JOIN WORK_EFFORT WE01 ON WE01.WORK_EFFORT_ID = WEA01.WORK_EFFORT_ID_FROM
LEFT JOIN WORK_EFFORT WE02 ON WE02.WORK_EFFORT_ID = WEA02.WORK_EFFORT_ID_FROM
LEFT JOIN WORK_EFFORT WE03 ON WE03.WORK_EFFORT_ID = WEA03.WORK_EFFORT_ID_FROM
LEFT JOIN WORK_EFFORT WE04 ON WE04.WORK_EFFORT_ID = WEA04.WORK_EFFORT_ID_FROM
-- STRUTTURA E STRUTTURA PADRE
INNER JOIN PARTY P ON P.PARTY_ID = FIL_W.ORG_UNIT_ID
INNER JOIN PARTY_PARENT_ROLE PPR ON PPR.PARTY_ID = P.PARTY_ID
LEFT JOIN PARTY_RELATIONSHIP PRESP ON PRESP.PARTY_ID_FROM = P.PARTY_ID AND PRESP.PARTY_RELATIONSHIP_TYPE_ID='ORG_RESPONSIBLE' AND PRESP.THRU_DATE IS NULL
LEFT JOIN PARTY RESP ON RESP.PARTY_ID = PRESP.PARTY_ID_TO
LEFT JOIN PARTY_RELATIONSHIP PRPA ON PRPA.PARTY_ID_TO = P.PARTY_ID AND PRPA.THRU_DATE IS NULL AND PRPA.PARTY_RELATIONSHIP_TYPE_ID = 'GROUP_ROLLUP'
LEFT JOIN PARTY PAPA ON PAPA.PARTY_ID = PRPA.PARTY_ID_FROM 
LEFT JOIN PARTY_PARENT_ROLE PPRPA ON PPRPA.PARTY_ID = PAPA.PARTY_ID 
LEFT JOIN WORK_EFFORT_PARTY_ASSIGNMENT WEPA ON WEPA.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID AND WEPA.ROLE_TYPE_ID = 'WE_ASSIGNMENT'
	AND WEPA.FROM_DATE <= @date3112 AND (WEPA.THRU_DATE >= @date0101 OR WEPA.THRU_DATE IS NULL)
LEFT JOIN PARTY ASS ON ASS.PARTY_ID = WEPA.PARTY_ID
LEFT JOIN PARTY_PARENT_ROLE COD_ASS ON COD_ASS.PARTY_ID = ASS.PARTY_ID
-- FLAG OBIETTIVO OPERATIVO
LEFT JOIN (
	SELECT
		RS.UOM_CODE@langLocale,
		WEM.WORK_EFFORT_ID,
		WEM.GL_ACCOUNT_ID
	FROM WORK_EFFORT_MEASURE WEM 
	INNER JOIN ACCTG_TRANS_ENTRY ATE ON ATE.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID
	INNER JOIN WORK_EFFORT_MEAS_RAT_SC RS ON RS.WORK_EFFORT_MEASURE_ID = WEM.WORK_EFFORT_MEASURE_ID
		AND RS.UOM_ID = ATE.CURRENCY_UOM_ID AND RS.UOM_RATING_VALUE = ATE.AMOUNT
) IND ON IND.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
LEFT JOIN WORK_EFFORT_PARTY_ASSIGNMENT WEPA2 ON WEPA2.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID AND WEPA2.ROLE_TYPE_ID = 'WE_ASSIGNMENT'
	AND WEPA2.THRU_DATE >= @date0101
LEFT JOIN PARTY P2 ON P2.PARTY_ID = WEPA2.PARTY_ID
LEFT JOIN PARTY_PARENT_ROLE PPR2 ON PPR2.PARTY_ID = P2.PARTY_ID
-- ALLEGATI
LEFT JOIN (
	SELECT 
		WEC.WORK_EFFORT_ID
	FROM WORK_EFFORT_CONTENT WEC
	LEFT JOIN CONTENT C ON C.CONTENT_ID = WEC.CONTENT_ID
GROUP BY WEC.WORK_EFFORT_ID
) ALLEGATO ON ALLEGATO.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
-- GRADO RAGGIUNGIMENTO OBIETTIVO
LEFT JOIN (
    SELECT
        WEM.WORK_EFFORT_ID,
        GAMRS.UOM_DESCR@langLocale
    FROM WORK_EFFORT_MEASURE WEM
    JOIN ACCTG_TRANS ACT ON ACT.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID AND ACT.TRANSACTION_DATE = @date3112
    JOIN ACCTG_TRANS_ENTRY ATE ON ATE.ACCTG_TRANS_ID = ACT.ACCTG_TRANS_ID AND ATE.GL_ACCOUNT_ID = '10096'
    LEFT JOIN GL_ACCOUNT_MEAS_RAT_SC GAMRS ON GAMRS.GL_ACCOUNT_ID = ATE.GL_ACCOUNT_ID
        AND GAMRS.UOM_RATING_VALUE <= ATE.AMOUNT AND GAMRS.UOM_RATING_VALUE >= ATE.AMOUNT
) GRADO ON GRADO.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
-- NOTE OBIETTIVO OPERATIVO
LEFT JOIN(
	SELECT WEN.WORK_EFFORT_ID, ND.NOTE_INFO@langLocale
	FROM WORK_EFFORT_NOTE WEN 
	JOIN NOTE_DATA ND ON ND.NOTE_ID = WEN.NOTE_ID AND ND.NOTE_DATE_TIME = @date0101
	WHERE WEN.SEQUENCE_ID = '110'
) NOTEPRE ON NOTEPRE.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
LEFT JOIN (
	SELECT WEN.WORK_EFFORT_ID, ND.NOTE_INFO@langLocale
	FROM WORK_EFFORT_NOTE WEN 
	JOIN NOTE_DATA ND ON ND.NOTE_ID = WEN.NOTE_ID AND ND.NOTE_DATE_TIME = @date3112
	WHERE WEN.SEQUENCE_ID = '120'
) NOTEREL ON NOTEREL.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID

@filterInnerJoin
@filterLeftJoin

WHERE FIL_W.ORGANIZATION_ID=@defaultOrganizationId AND
FIL_W.WORK_EFFORT_TYPE_ID = @workEffortTypeId
AND FIL_W.ESTIMATED_START_DATE <= @date3112 AND FIL_W.ESTIMATED_COMPLETION_DATE >= @date0101 

@orgUnitId
@filterWhere

GROUP BY
	FIL_W.WORK_EFFORT_ID,
	FIL_W.SOURCE_REFERENCE_ID,
	FIL_W.WORK_EFFORT_NAME@langLocale,
	FIL_W.ETCH,
	P.EXTERNAL_ID,
	PPR.PARENT_ROLE_CODE,
	P.PARTY_NAME@langLocale,
	PAPA.EXTERNAL_ID,
	PPRPA.PARENT_ROLE_CODE,
	PAPA.PARTY_NAME@langLocale,
	WE01.SOURCE_REFERENCE_ID,
	WE01.WORK_EFFORT_NAME@langLocale,
	WE02.SOURCE_REFERENCE_ID,
	WE02.WORK_EFFORT_NAME@langLocale,
	WE03.SOURCE_REFERENCE_ID,
	WE03.WORK_EFFORT_NAME@langLocale,
	WE04.SOURCE_REFERENCE_ID,
	WE04.WORK_EFFORT_NAME@langLocale,
	COD_ASS.PARENT_ROLE_CODE,
	ASS.PARTY_NAME,
	ALLEGATO.WORK_EFFORT_ID,
	GRADO.UOM_DESCR@langLocale,
	NOTEPRE.WORK_EFFORT_ID,
	NOTEREL.WORK_EFFORT_ID,
	RESP.PARTY_NAME
ORDER BY 
	FIL_W.SOURCE_REFERENCE_ID,
	P.EXTERNAL_ID]]></xml-property>
        </oda-data-set>
