    <property name="units">in</property>
    <method name="initialize"><![CDATA[importPackage(Packages.java.util);
importPackage(Packages.java.lang);
importPackage(Packages.javolution.util);
importPackage(Packages.org.ofbiz.base.util);
importPackage(Packages.com.mapsengineering.base.appheader);
importPackage(Packages.it.mapsgroup.gzoom);
importPackage(Packages.com.mapsengineering.base.birt.util);

var vectorPageNumber = new Vector();
reportContext.setGlobalVariable("vectorPageNumber", vectorPageNumber);
reportContext.setGlobalVariable("nPagina", 1);
reportContext.setGlobalVariable("NpageIndex", 0 );
reportContext.setGlobalVariable("nPageEmpty", 0 );



var mapRealPageNumber = reportContext.getPersistentGlobalVariable("mapRealPageNumber");
if (mapRealPageNumber == null ) {
	mapRealPageNumber = new java.util.HashMap();
	reportContext.setPersistentGlobalVariable("mapRealPageNumber", mapRealPageNumber);
}


//var logo_login = AppHeaderLogo.getReportContentUrl("REPORT_LARGE", "Company");
//var logo_login = AppHeaderLogo.getReportContentUrl("REPORT_MEDIUM",  params["defaultOrganizationPartyId"].value);
var logo_login = AppHeaderLogo.getReportContentUrl("REPORT_LARGE",  params["defaultOrganizationPartyId"].value);
reportContext.setPersistentGlobalVariable("logo_login", logo_login);
var logo_large = AppHeaderLogo.getReportContentUrl("REPORT_LARGE", params["defaultOrganizationPartyId"].value);
reportContext.setPersistentGlobalVariable("logo_large", logo_large);

var logo_header = AppHeaderLogo.getReportContentUrl("REPORT_HEADER", params["defaultOrganizationPartyId"].value);
//var icon_nav   = AppHeaderLogo.getReportContentUrl(delegator, "ICON_NAV", params["organizationId"].value);
reportContext.setPersistentGlobalVariable("logo_header", logo_header);
//reportContext.setPersistentGlobalVariable("logo_footer", icon_nav);

var title_custom = '';

var yearMoreYear2 = " "+BirtDateTime.year(params["customTimePeriod"].value) + " - "+ (BirtDateTime.year(params["customTimePeriod"].value) +2)+" ";

var title_custom_piano = reportContext.getMessage('titlePie1', reportContext.getLocale()) + yearMoreYear2 + " - " + reportContext.getMessage('titlePie2', reportContext.getLocale());
var title_custom_relazione = reportContext.getMessage('RelazionePerformance', reportContext.getLocale()) +  " " +BirtDateTime.year(params["customTimePeriod"].value) + " - " + reportContext.getMessage('titlePie2', reportContext.getLocale());

if(params["reportContentId"].value == 'REPORT_PREV_OB_OPER'){
	title_custom = title_custom_piano;
}

if(params["reportContentId"].value == 'REPORT_VAL_OB_OPER'){
	title_custom = title_custom_relazione;
}

reportContext.setPersistentGlobalVariable("title_custom",title_custom);

reportContext.setPersistentGlobalVariable("titleMasterPage",title_custom);
]]></method>
