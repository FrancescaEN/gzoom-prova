            <xml-property name="queryText"><![CDATA[
SELECT 
WEM.UOM_DESCR@langLocale AS "UOM_DESCR", 
GL.ACCOUNT_NAME@langLocale AS "ACCOUNT_NAME", 
WEM.SEQUENCE_ID AS "ETICHETTA",
WEM.WORK_EFFORT_ID,
UOM.UOM_TYPE_ID AS "TIPO_MISURA",

MAX(CASE WHEN ACT.TRANSACTION_DATE = @date3112 AND ATE.GL_FISCAL_TYPE_ID = 'BUDGET' AND UOM.UOM_TYPE_ID = 'RATING_SCALE' THEN MEAS.UOM_CODE@langLocale ELSE NULL END) AS "TARGET_ANNO_CHECK",
MAX(CASE WHEN ACT.TRANSACTION_DATE = @date3112 AND ATE.GL_FISCAL_TYPE_ID = 'BUDGET' AND UOM.UOM_TYPE_ID != 'RATING_SCALE' THEN ATE.AMOUNT ELSE NULL END) AS "TARGET_ANNO_AMOUNT",

MAX(CASE WHEN ACT.TRANSACTION_DATE = @date3112 AND ATE.GL_FISCAL_TYPE_ID = 'ACTUAL' AND UOM.UOM_TYPE_ID = 'RATING_SCALE' THEN MEAS.UOM_CODE@langLocale ELSE NULL END) AS "CONSUNTIVO_ANNO_CHECK",
MAX(CASE WHEN ACT.TRANSACTION_DATE = @date3112 AND ATE.GL_FISCAL_TYPE_ID = 'ACTUAL' AND UOM.UOM_TYPE_ID != 'RATING_SCALE' THEN ATE.AMOUNT ELSE NULL END) AS "CONSUNTIVO_ANNO_AMOUNT",

MAX(CASE WHEN ACT.TRANSACTION_DATE = @date3112 AND ATE.GL_FISCAL_TYPE_ID = 'BUDGET' THEN ACT.DESCRIPTION@langLocale ELSE NULL END) AS "COMMENTO_TARGET_ANNO",
MAX(CASE WHEN ACT.TRANSACTION_DATE = @date3112 AND ATE.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN ACT.DESCRIPTION@langLocale ELSE NULL END) AS "COMMENTO_CONSUNTIVO_ANNO",

UOM.ABBREVIATION@langLocale AS "DESCRIZIONE",
GRT.DESCRIPTION@langLocale AS "GOVERNABILITA",
WEM.COMMENTS@langLocale AS "COMMENTO_INDICATORE"
FROM WORK_EFFORT_MEASURE WEM
JOIN ACCTG_TRANS ACT ON ACT.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID
JOIN ACCTG_TRANS_ENTRY ATE ON ATE.ACCTG_TRANS_ID = ACT.ACCTG_TRANS_ID AND ATE.GL_ACCOUNT_TYPE_ID = 'PRFKPI'
JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID
JOIN UOM ON UOM.UOM_ID = GL.DEFAULT_UOM_ID
LEFT JOIN GL_ACCOUNT_MEAS_RAT_SC MEAS ON MEAS.GL_ACCOUNT_ID = ATE.GL_ACCOUNT_ID AND MEAS.UOM_RATING_VALUE <= ATE.AMOUNT AND MEAS.UOM_RATING_VALUE >=ATE.AMOUNT
LEFT JOIN GL_RESOURCE_TYPE GRT ON GRT.GL_RESOURCE_TYPE_ID = GL.GL_RESOURCE_TYPE_ID
WHERE WEM.WORK_EFFORT_ID = ?
GROUP BY 
WEM.UOM_DESCR@langLocale, GL.ACCOUNT_NAME@langLocale, 
WEM.SEQUENCE_ID, WEM.WORK_EFFORT_ID,UOM.ABBREVIATION@langLocale,
GRT.DESCRIPTION@langLocale,UOM.UOM_TYPE_ID,
WEM.COMMENTS@langLocale]]></xml-property>
        </oda-data-set>
