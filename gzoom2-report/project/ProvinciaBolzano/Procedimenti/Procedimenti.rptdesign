            <xml-property name="queryText"><![CDATA[SELECT 
	PROC.SOURCE_REFERENCE_ID AS "Codice - Code",
	PROC.WORK_EFFORT_NAME@langLocale AS "Denominazione",
	PROC.WORK_EFFORT_NAME AS "Bezeichnung",
	P.EXTERNAL_ID AS "Codice esterno - Externer Code",
	PPR.PARENT_ROLE_CODE AS "Codice struttura - Strukturcode",
	P.PARTY_NAME_LANG AS "Unità Responsabile",
	P.PARTY_NAME@langLocale AS "Organisationseinheit",
	PPRESP.PARENT_ROLE_CODE AS "Codice responsabile - Führungskraft Code",
	RESP.PARTY_NAME AS "Responsabile - Führungskraft",
	PAPA.EXTERNAL_ID AS "Codice esterno padre - Externer Vaterncode",
	PPRPA.PARENT_ROLE_CODE AS "Codice struttura padre - Übergeordneter Strukturcode",
	PAPA.PARTY_NAME_LANG AS "Unità Responsabile padre",
	PAPA.PARTY_NAME AS "Organisationseinheit Vater",
	GAMRS.UOM_DESCR_LANG AS "Durata procedimento - Verfahrensdauer",
	ACT.DESCRIPTION_LANG AS "Commento",
	ACT.DESCRIPTION AS "Kommentar",
	MAX(CASE WHEN NOTE.SEQUENCE_ID = 120 THEN NOTE.NOTE_INFO@langLocale ELSE NULL END) AS "Normativa di riferimento",
	MAX(CASE WHEN NOTE.SEQUENCE_ID = 120 THEN NOTE.NOTE_INFO ELSE NULL END) AS "Normative Grundlage",
	MAX(CASE WHEN CAR.GL_ACCOUNT_ID = '10113' THEN CAR.UOM_DESCR_LANG ELSE NULL END) AS "Avvio del procedimento",
	MAX(CASE WHEN CAR.GL_ACCOUNT_ID = '10113' THEN CAR.UOM_DESCR@langLocale ELSE NULL END) AS "Einleitung des Verfahrens",
	MAX(CASE WHEN CAR.GL_ACCOUNT_ID = '10116' THEN CAR.UOM_DESCR_LANG ELSE NULL END) AS "Decorrenza del termine",
	MAX(CASE WHEN CAR.GL_ACCOUNT_ID = '10116' THEN CAR.UOM_DESCR@langLocale ELSE NULL END) AS "Beginn des Fristenlaufes"
/* PROCEDIMENTO */
FROM WORK_EFFORT PROC
/* STRUTTURA */
JOIN PARTY P ON P.PARTY_ID = PROC.ORG_UNIT_ID
JOIN PARTY_PARENT_ROLE PPR ON PPR.PARTY_ID = P.PARTY_ID
/* RESPONSABILE */
LEFT JOIN PARTY_RELATIONSHIP PR ON PR.PARTY_ID_FROM = P.PARTY_ID AND PR.THRU_DATE IS NULL AND PR.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
LEFT JOIN PARTY RESP ON RESP.PARTY_ID = PR.PARTY_ID_TO
LEFT JOIN PARTY_PARENT_ROLE PPRESP ON PPRESP.PARTY_ID = RESP.PARTY_ID
/* STRUTTURA PADRE */ 
LEFT JOIN PARTY_RELATIONSHIP PRPA ON PRPA.PARTY_ID_TO = P.PARTY_ID AND PRPA.THRU_DATE IS NULL
LEFT JOIN PARTY PAPA ON PAPA.PARTY_ID = PRPA.PARTY_ID_FROM
LEFT JOIN PARTY_PARENT_ROLE PPRPA ON PPRPA.PARTY_ID = PAPA.PARTY_ID
/* DURATA DEL PROCEDIMENTO */
JOIN WORK_EFFORT_MEASURE WEM ON WEM.WORK_EFFORT_ID = PROC.WORK_EFFORT_ID AND WEM.GL_ACCOUNT_ID = '10115'
JOIN ACCTG_TRANS_ENTRY ATE ON ATE.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID
JOIN ACCTG_TRANS ACT ON ACT.ACCTG_TRANS_ID = ATE.ACCTG_TRANS_ID
JOIN GL_ACCOUNT_MEAS_RAT_SC GAMRS ON GAMRS.GL_ACCOUNT_ID = ATE.GL_ACCOUNT_ID 
	AND GAMRS.UOM_RATING_VALUE <= ATE.AMOUNT AND GAMRS.UOM_RATING_VALUE >= ATE.AMOUNT
/* CARATTERISTICHE */
LEFT JOIN (
	SELECT 
		GL.GL_ACCOUNT_ID,
		GAMRS.UOM_DESCR,
		GAMRS.UOM_DESCR_LANG,
		ATE.AMOUNT,
		WEM.WORK_EFFORT_ID
	FROM WORK_EFFORT_MEASURE WEM 
	JOIN ACCTG_TRANS ACT ON ACT.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID 
	JOIN ACCTG_TRANS_ENTRY ATE ON ATE.ACCTG_TRANS_ID = ACT.ACCTG_TRANS_ID 
	JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID 
	JOIN GL_ACCOUNT_MEAS_RAT_SC GAMRS ON GAMRS.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID 
		AND GAMRS.UOM_RATING_VALUE <= ATE.AMOUNT AND GAMRS.UOM_RATING_VALUE >= ATE.AMOUNT
) CAR ON CAR.WORK_EFFORT_ID = PROC.WORK_EFFORT_ID 
/* NOTE */
LEFT JOIN (
	SELECT 
		WEN.WORK_EFFORT_ID,
		WEN.SEQUENCE_ID,
		TO_CHAR(ND.NOTE_INFO) AS NOTE_INFO,
		TO_CHAR(ND.NOTE_INFO_LANG) AS NOTE_INFO_LANG
	FROM WORK_EFFORT_NOTE WEN 
	JOIN NOTE_DATA ND ON ND.NOTE_ID = WEN.NOTE_ID
) NOTE ON NOTE.WORK_EFFORT_ID = PROC.WORK_EFFORT_ID 

@filterInnerJoin
@filterLeftJoin

WHERE PROC.WORK_EFFORT_TYPE_ID = '20C44' AND PROC.WORK_EFFORT_REVISION_ID IS NULL
	AND PROC.ESTIMATED_START_DATE <= @date3112 AND (PROC.ESTIMATED_COMPLETION_DATE >= @date0101 OR PROC.ESTIMATED_COMPLETION_DATE IS NULL)
	AND ATE.AMOUNT > 30
@filterWhere

GROUP BY
	PROC.SOURCE_REFERENCE_ID,
	PROC.WORK_EFFORT_NAME_LANG,
	PROC.WORK_EFFORT_NAME,
	P.EXTERNAL_ID,
	PPR.PARENT_ROLE_CODE,
	P.PARTY_NAME_LANG,
	P.PARTY_NAME,
