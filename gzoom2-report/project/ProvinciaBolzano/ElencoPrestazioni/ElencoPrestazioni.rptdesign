this.queryText = this.queryText.replace("@date3006",  "TO_DATE('12/31/2022','MM/DD/YYYY')");
this.queryText = this.queryText.replace("@langLocale",  "");
this.queryText = this.queryText.replace("@workEffortTypeId",  "''");
*/


//ReportLog.info("PersonaleImpiegatoDS : ");
//ReportLog.info(this.queryText);]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">TARGET_ANNO</property>
                    <property name="nativeName">TARGET_ANNO</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">CONSUNTIVO_ANNO</property>
                    <property name="nativeName">CONSUNTIVO_ANNO</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">TARGET_ANNO_1</property>
                    <property name="nativeName">TARGET_ANNO_1</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">TARGET_ANNO_2</property>
                    <property name="nativeName">TARGET_ANNO_2</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">CONSUNTIVO_ANNO_1</property>
                    <property name="nativeName">CONSUNTIVO_ANNO_1</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">CONSUNTIVO_ANNO_2</property>
                    <property name="nativeName">CONSUNTIVO_ANNO_2</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">CONSUNTIVO_ANNO_3</property>
                    <property name="nativeName">CONSUNTIVO_ANNO_3</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">PERSONALE</property>
                    <property name="nativeName">PERSONALE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">9</property>
                    <property name="name">UNITA_MISURA</property>
                    <property name="nativeName">UNITA_MISURA</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
MAX(CASE WHEN ATE.GL_ACCOUNT_ID = '10101' AND AT.TRANSACTION_DATE = @date3112 AND ATE.GL_FISCAL_TYPE_ID = 'BUDGET' THEN ATE.AMOUNT ELSE NULL END) AS "TARGET_ANNO",
MAX(CASE WHEN ATE.GL_ACCOUNT_ID = '10101' AND AT.TRANSACTION_DATE = @date3112 AND ATE.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN ATE.AMOUNT ELSE NULL END) AS "CONSUNTIVO_ANNO",
MAX(CASE WHEN ATE.GL_ACCOUNT_ID = '10101' AND AT.TRANSACTION_DATE = @date3112+1 AND ATE.GL_FISCAL_TYPE_ID = 'BUDGET' THEN ATE.AMOUNT ELSE NULL END) AS "TARGET_ANNO_1",
MAX(CASE WHEN ATE.GL_ACCOUNT_ID = '10101' AND AT.TRANSACTION_DATE = @date3112+2 AND ATE.GL_FISCAL_TYPE_ID = 'BUDGET' THEN ATE.AMOUNT ELSE NULL END) AS "TARGET_ANNO_2",
MAX(CASE WHEN ATE.GL_ACCOUNT_ID = '10101' AND AT.TRANSACTION_DATE = @date1231-1 AND ATE.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN ATE.AMOUNT ELSE NULL END) AS "CONSUNTIVO_ANNO_1",
MAX(CASE WHEN ATE.GL_ACCOUNT_ID = '10101' AND AT.TRANSACTION_DATE = @date1231-2 AND ATE.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN ATE.AMOUNT ELSE NULL END) AS "CONSUNTIVO_ANNO_2",
MAX(CASE WHEN ATE.GL_ACCOUNT_ID = '10101' AND AT.TRANSACTION_DATE = @date1231-3 AND ATE.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN ATE.AMOUNT ELSE NULL END) AS "CONSUNTIVO_ANNO_3",
GL.ACCOUNT_NAME@langLocale AS "PERSONALE",
U.ABBREVIATION@langLocale AS "UNITA_MISURA"
FROM WORK_EFFORT_MEASURE WEM
JOIN ACCTG_TRANS AT ON AT.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID
JOIN ACCTG_TRANS_ENTRY ATE ON ATE.ACCTG_TRANS_ID = AT.ACCTG_TRANS_ID
JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID AND GL.GL_ACCOUNT_ID = '10101'
JOIN UOM U ON U.UOM_ID = GL.DEFAULT_UOM_ID
LEFT JOIN WORK_EFFORT OBS ON OBS.WORK_EFFORT_ID = WEM.WORK_EFFORT_ID

WHERE  
OBS.WORK_EFFORT_TYPE_ID = @workEffortTypeId
AND 
OBS.WORK_EFFORT_REVISION_ID IS NULL
AND WEM.FROM_DATE <= @date3112 AND (WEM.THRU_DATE IS NULL OR WEM.THRU_DATE >= @date0101)
AND OBS.WORK_EFFORT_ID = ? 
GROUP BY
GL.ACCOUNT_NAME@langLocale,
U.ABBREVIATION@langLocale
]]></xml-property>
