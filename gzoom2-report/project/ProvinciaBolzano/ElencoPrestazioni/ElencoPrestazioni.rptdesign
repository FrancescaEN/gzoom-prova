                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">MISSIONI_PNRR</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <method name="beforeOpen"><![CDATA[/* */
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value);
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value);	
this.queryText = this.queryText.replace("@langLocale",  params["langLocale"].value);
this.queryText = this.queryText.replace("@workEffortTypeId",  "'" + params["workEffortTypeId"].value + "'");

/*
this.queryText = this.queryText.replace("@date0101",  "'2019-01-01 00:00:00.000'" );
this.queryText = this.queryText.replace("@date3112",  "'2019-12-31 00:00:00.000'" );
this.queryText = this.queryText.replace("@langLocale", "");
this.queryText = this.queryText.replace("@workEffortTypeId", "''");
*/

/*ReportLog.info("MissioniPNRRDS :");
ReportLog.info(this.queryText);
*/]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">CODICE_OBIETTIVO_STRATEGICO</property>
                    <property name="nativeName">CODICE_OBIETTIVO_STRATEGICO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">MISSIONI_PNRR</property>
                    <property name="nativeName">MISSIONI_PNRR</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[
SELECT 
FIL_W.SOURCE_REFERENCE_ID AS "CODICE_OBIETTIVO_STRATEGICO",
MISS.LISTAMISS AS "MISSIONI_PNRR"
FROM WORK_EFFORT FIL_W
LEFT JOIN(
	SELECT 
	MISS.WORK_EFFORT_NAME@langLocale AS LISTAMISS,
	WEA.WORK_EFFORT_ID_TO
	FROM WORK_EFFORT_ASSOC WEA
	LEFT JOIN WORK_EFFORT MISS ON MISS.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_FROM AND MISS.WORK_EFFORT_TYPE_ID = '20R104'
		AND MISS.WORK_EFFORT_REVISION_ID IS NULL
		AND MISS.ESTIMATED_START_DATE <= @date3112 AND (MISS.ESTIMATED_COMPLETION_DATE >= @date0101 OR MISS.ESTIMATED_COMPLETION_DATE IS NULL)
	WHERE WEA.WORK_EFFORT_ASSOC_TYPE_ID = '20R10C'
	AND WEA.FROM_DATE <= @date3112 AND (WEA.THRU_DATE IS NULL OR WEA.THRU_DATE >= @date0101)
) MISS ON MISS.WORK_EFFORT_ID_TO = FIL_W.WORK_EFFORT_ID

WHERE 
  FIL_W.WORK_EFFORT_TYPE_ID = '20C42' AND 
  FIL_W.ESTIMATED_START_DATE <= @date3112 AND FIL_W.ESTIMATED_COMPLETION_DATE >= @date0101 AND 
  FIL_W.WORK_EFFORT_ID = ? 
   
ORDER BY "CODICE_OBIETTIVO_STRATEGICO"
]]></xml-property>
