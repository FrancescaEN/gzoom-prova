                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[
SELECT
	OBS.SOURCE_REFERENCE_ID AS "CODICE_OBIETTIVO_STRATEGICO",
	OBS.WORK_EFFORT_NAME@langLocale AS "NOME_OBIETTIVO",
	GL.ACCOUNT_CODE AS "CODICE_INDICATORE",
	WEM.SEQUENCE_ID AS "ETICHETTA",
	--GL.DESCRIPTION_LANG AS "ETICHETTA",
	GL.ACCOUNT_NAME@langLocale AS "TITOLO_INDICATORE",
	GRT.DESCRIPTION@langLocale AS "GOVERNABILITA",
	U.ABBREVIATION@langLocale AS "UNITA_DI_MISURA",
	GAT.DESCRIPTION@langLocale AS "TIPOLOGIA_INDICATORE",
	GL.SOURCE@langLocale AS "STANDARD_DI_QUALITA",
	E.DESCRIPTION AS "SEGNO_MIGLIORAMENTO",
	MAX(CASE WHEN AT.TRANSACTION_DATE = @date1231-3 AND ATE.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN ATE.AMOUNT ELSE NULL END) AS "CONSUNTIVO_ANNO_MENO_3",
	MAX(CASE WHEN AT.TRANSACTION_DATE = @date1231-2 AND ATE.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN ATE.AMOUNT ELSE NULL END) AS "CONSUNTIVO_ANNO_MENO_2",
	MAX(CASE WHEN AT.TRANSACTION_DATE = @date1231-2 AND ATE.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN AT.DESCRIPTION@langLocale ELSE NULL END) AS "COMMENTO_CONSUNTIVO_ANNO_MENO_2",
	MAX(CASE WHEN AT.TRANSACTION_DATE = @date1231-1 AND ATE.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN ATE.AMOUNT ELSE NULL END) AS "CONSUNTIVO ANNO-1",
	MAX(CASE WHEN AT.TRANSACTION_DATE = @date1231-1 AND ATE.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN AT.DESCRIPTION@langLocale ELSE NULL END) AS "COMMENTO_CONSUNTIVO_ANNO_MENO_1",
	MAX(CASE WHEN AT.TRANSACTION_DATE = @date1231-2 AND ATE.GL_FISCAL_TYPE_ID = 'BUDGET' THEN ATE.AMOUNT ELSE NULL END) AS "TARGET_ANNO_MENO_2",
	
	MAX(CASE WHEN AT.TRANSACTION_DATE = @date3112 AND ATE.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN ATE.AMOUNT ELSE NULL END) AS "CONSUNTIVO_ANNO",
	MAX(CASE WHEN AT.TRANSACTION_DATE = @date3112 AND ATE.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN AT.DESCRIPTION@langLocale ELSE NULL END) AS "COMMENTO_CONSUNTIVO_ANNO",
	
	
	MAX(CASE WHEN AT.TRANSACTION_DATE = @date1231-2 AND ATE.GL_FISCAL_TYPE_ID = 'BUDGET' THEN AT.DESCRIPTION@langLocale ELSE NULL END) AS "COMMENTO_TARGET_ANNO_MENO_2",
	MAX(CASE WHEN AT.TRANSACTION_DATE = @date1231-1 AND ATE.GL_FISCAL_TYPE_ID = 'BUDGET' THEN ATE.AMOUNT ELSE NULL END) AS "TARGET_ANNO_MENO_1",
	MAX(CASE WHEN AT.TRANSACTION_DATE = @date1231-1 AND ATE.GL_FISCAL_TYPE_ID = 'BUDGET' THEN AT.DESCRIPTION@langLocale ELSE NULL END) AS "COMMENTO_TARGET_ANNO_MENO_1",
	MAX(CASE WHEN AT.TRANSACTION_DATE = @date3112 AND ATE.GL_FISCAL_TYPE_ID = 'BUDGET' THEN ATE.AMOUNT ELSE NULL END) AS "TARGET_ANNO",
	MAX(CASE WHEN AT.TRANSACTION_DATE = @date3112 AND ATE.GL_FISCAL_TYPE_ID = 'BUDGET' THEN AT.DESCRIPTION@langLocale ELSE NULL END) AS "COMMENTO_TARGET_ANNO",
	MAX(CASE WHEN AT.TRANSACTION_DATE = @fineannosuccessivo AND ATE.GL_FISCAL_TYPE_ID = 'BUDGET' THEN ATE.AMOUNT ELSE NULL END) AS "TARGET_ANNO_PIU_1",
	MAX(CASE WHEN AT.TRANSACTION_DATE = @fineannosuccessivo AND ATE.GL_FISCAL_TYPE_ID = 'BUDGET' THEN AT.DESCRIPTION@langLocale ELSE NULL END) AS "COMMENTO_TARGET_ANNO_PIU_1",
	MAX(CASE WHEN AT.TRANSACTION_DATE = @finedueannisuccessivi AND ATE.GL_FISCAL_TYPE_ID = 'BUDGET' THEN ATE.AMOUNT ELSE NULL END) AS "TARGET_ANNO_PIU_2",
	MAX(CASE WHEN AT.TRANSACTION_DATE = @finedueannisuccessivi AND ATE.GL_FISCAL_TYPE_ID = 'BUDGET' THEN AT.DESCRIPTION@langLocale ELSE NULL END) AS "COMMENTO_TARGET_ANNO_PIU_2",
	WEM.COMMENTS@langLocale as "COMMENTO_INDICATORE"	
FROM
	WORK_EFFORT OBS
JOIN WORK_EFFORT_MEASURE WEM ON
	WEM.WORK_EFFORT_ID = OBS.WORK_EFFORT_ID
JOIN GL_ACCOUNT GL ON
	GL.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID
JOIN GL_ACCOUNT_TYPE GAT ON
	GAT.GL_ACCOUNT_TYPE_ID = GL.GL_ACCOUNT_TYPE_ID
JOIN GL_RESOURCE_TYPE GRT ON
	GRT.GL_RESOURCE_TYPE_ID = GL.GL_RESOURCE_TYPE_ID
JOIN WORK_EFFORT_PURPOSE_ACCOUNT WEPA ON
	WEPA.GL_ACCOUNT_ID = GL.GL_ACCOUNT_ID
	AND WEPA.WORK_EFFORT_PURPOSE_TYPE_ID = 'PRFKPI'	
JOIN UOM U ON
	U.UOM_ID = GL.DEFAULT_UOM_ID
JOIN ENUMERATION E ON
	E.ENUM_ID = GL.DEBIT_CREDIT_DEFAULT
LEFT JOIN ACCTG_TRANS_ENTRY ATE ON
	ATE.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID
	AND GL.INPUT_ENUM_ID = 'ACCINP_UO'
	OR (GL.INPUT_ENUM_ID = 'ACCINP_OBJ'
		AND ATE.VOUCHER_REF IS NOT NULL
		AND ATE.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID)
LEFT JOIN ACCTG_TRANS AT ON
	AT.ACCTG_TRANS_ID = ATE.ACCTG_TRANS_ID
WHERE 
	OBS.WORK_EFFORT_TYPE_ID = @workEffortTypeId
	AND OBS.WORK_EFFORT_REVISION_ID IS NULL
	AND OBS.ESTIMATED_START_DATE <= @date3112
	AND OBS.ESTIMATED_COMPLETION_DATE >= @date0101
	AND WEM.FROM_DATE <= @date3112 AND (WEM.THRU_DATE IS NULL OR WEM.THRU_DATE >= @date0101)
	AND OBS.WORK_EFFORT_ID = ?
GROUP BY
	OBS.SOURCE_REFERENCE_ID,
	GL.ACCOUNT_CODE,
	WEM.SEQUENCE_ID,
	GL.ACCOUNT_NAME@langLocale,
	GAT.DESCRIPTION@langLocale,
	GRT.DESCRIPTION@langLocale,
	U.ABBREVIATION@langLocale,
	GL.SOURCE@langLocale,
	E.DESCRIPTION,
	OBS.WORK_EFFORT_NAME@langLocale,
	GL.DESCRIPTION_LANG,
	WEM.COMMENTS@langLocale
ORDER BY
	SOURCE_REFERENCE_ID,
	"ETICHETTA"
	--GL.ACCOUNT_CODE]]></xml-property>
        </oda-data-set>
