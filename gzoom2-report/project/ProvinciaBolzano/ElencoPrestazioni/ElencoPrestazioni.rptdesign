            <xml-property name="queryText"><![CDATA[SELECT
	WEPT.DESCRIPTION@langLocale AS "DESCR_TIPOLOGIA_PRESTAZIONE",
	FIL_W.SOURCE_REFERENCE_ID AS "CODICE_CODE",
	FIL_W.ETCH AS "ETICHETTA_PRESTAZIONE",
	FIL_W.WORK_EFFORT_NAME@langLocale AS "TITOLO_PRESTAZIONE",
	PA.EXTERNAL_ID AS "CODICE_ESTERNO",
	PPR.PARENT_ROLE_CODE AS "CODICE STRUTTURA",
	PA.PARTY_NAME@langLocale AS "NOME_STRUTTURA",
	PA.PARTY_NAME_LANG AS "UNITA_RESPONSABILE",
	RESP.PARTY_NAME AS "RESPONSABILE",
	PAPA.EXTERNAL_ID AS "CODICE_ESTERNO_PADRE",
	PPRPA.PARENT_ROLE_CODE AS "CODICE_STRUTTURA_PADRE",
	PAPA.PARTY_NAME AS "NOME_STRUTTURA_PADRE",
	PAPA.PARTY_NAME@langLocale AS "UNITA_RESPONSABILE_PADRE",
	OBS.SOURCE_REFERENCE_ID AS "CODICE_OBIETTIVO_STRATEGICO",
	OBS.WORK_EFFORT_NAME@langLocale AS "NOME_OBIETTIVO_STRATEGICO",
	
	MAX(CASE WHEN NOTE.SEQUENCE_ID = 15 THEN NOTE.NOTE_INFO@langLocale ELSE NULL END) AS "DESCRIZIONE_BREVE",
	MAX(CASE WHEN NOTE.SEQUENCE_ID = 20 THEN NOTE.NOTE_INFO@langLocale ELSE NULL END) AS "FONTE_NORMATIVA",
	MAX(CASE WHEN NOTE.SEQUENCE_ID = 10 THEN NOTE.NOTE_INFO@langLocale ELSE NULL END) AS "FINALITA",
	
	MAX(CASE WHEN INDFLAG.GL_ACCOUNT_ID = '10820' THEN INDFLAG.UOM_CODE@langLocale ELSE NULL END) AS "PRIORITA_SVILUPPO_OBIETTIVO_STRATEGICO",
	
	SOST.UOM_CODE@langLocale AS "SOSTENIBILITA",
	FIL_W.WORK_EFFORT_ID AS "WORK_EFFORT_ID",
	
	FLAG.UOM_CODE@langLocale AS "PROCESSO_ANTICORRUZIONE",
	MAX(CASE WHEN INDFLAG.GL_ACCOUNT_ID = '11140' THEN INDFLAG.UOM_CODE@langLocale ELSE NULL END) AS "FLAG_PNRR",
	MAX(CASE WHEN INDFLAG.GL_ACCOUNT_ID = '11141' THEN INDFLAG.UOM_CODE@langLocale ELSE NULL END) AS "FLAG_PNC"
	
FROM WORK_EFFORT FIL_W
LEFT JOIN WORK_EFFORT_PURPOSE_TYPE WEPT ON WEPT.WORK_EFFORT_PURPOSE_TYPE_ID = FIL_W.WORK_EFFORT_PURPOSE_TYPE_ID
/* STRUTTURA */
JOIN PARTY PA ON PA.PARTY_ID = FIL_W.ORG_UNIT_ID
JOIN PARTY_PARENT_ROLE PPR ON PPR.PARTY_ID = PA.PARTY_ID
/* RESPONSABILE */
LEFT JOIN PARTY_RELATIONSHIP PRESP ON PRESP.PARTY_ID_FROM = PA.PARTY_ID AND PRESP.THRU_DATE IS NULL AND PRESP.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
LEFT JOIN PARTY RESP ON RESP.PARTY_ID = PRESP.PARTY_ID_TO
/* STRUTTURA PADRE */
LEFT JOIN PARTY_RELATIONSHIP PRPA ON PRPA.PARTY_ID_TO = PA.PARTY_ID AND PRPA.THRU_DATE IS NULL
LEFT JOIN PARTY_PARENT_ROLE PPRPA ON PPRPA.PARTY_ID = PRPA.PARTY_ID_FROM
LEFT JOIN PARTY PAPA ON PAPA.PARTY_ID = PRPA.PARTY_ID_FROM
/* OBIETTIVO STRATEGICO */
LEFT JOIN WORK_EFFORT_ASSOC WEA ON WEA.WORK_EFFORT_ID_TO = FIL_W.WORK_EFFORT_ID AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '20D62C'
AND WEA.FROM_DATE <= @date3112 AND (WEA.THRU_DATE IS NULL OR WEA.THRU_DATE >= @date0101)
LEFT JOIN WORK_EFFORT OBS ON OBS.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_FROM AND OBS.WORK_EFFORT_TYPE_ID = '20D62' AND OBS.WORK_EFFORT_REVISION_ID IS NULL
	AND OBS.ESTIMATED_START_DATE <= @date3112 AND (OBS.ESTIMATED_COMPLETION_DATE >= @date0101 OR OBS.ESTIMATED_COMPLETION_DATE IS NULL)
/* FLAG SOSTENIBILITA'*/
LEFT JOIN (
	SELECT WEMRS.UOM_CODE, WEMRS.UOM_CODE_LANG, WEM.WORK_EFFORT_ID
	FROM WORK_EFFORT_MEASURE WEM
	JOIN ACCTG_TRANS_ENTRY ATE ON ATE.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID
	JOIN WORK_EFFORT_MEAS_RAT_SC WEMRS ON WEMRS.WORK_EFFORT_MEASURE_ID = WEM.WORK_EFFORT_MEASURE_ID 
		AND WEMRS.UOM_ID = ATE.CURRENCY_UOM_ID AND WEMRS.UOM_RATING_VALUE = ATE.AMOUNT
        WHERE ATE.GL_ACCOUNT_ID = '10106'
) SOST ON SOST.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
/* NOTE */
LEFT JOIN (
	SELECT
		--CAST(ND.NOTE_INFO_LANG AS VARCHAR(4000)) AS NOTE_INFO_LANG,
		--CAST(ND.NOTE_INFO AS VARCHAR(4000)) AS NOTE_INFO,
		--dbms_lob.substr(ND.NOTE_INFO_LANG,3980,0) AS NOTE_INFO_LANG,
		case when ND.NOTE_INFO_LANG is not null then dbms_lob.substr(ND.NOTE_INFO_LANG,3880,1) else null end "NOTE_INFO_LANG",
		--dbms_lob.substr(ND.NOTE_INFO,3980,0) AS NOTE_INFO,
		case when ND.NOTE_INFO is not null then dbms_lob.substr(ND.NOTE_INFO,3880,1) else null end "NOTE_INFO",
		ND.NOTE_NAME,
		WEN.WORK_EFFORT_ID,
		WEN.SEQUENCE_ID
	FROM WORK_EFFORT_NOTE WEN 
	JOIN NOTE_DATA ND ON ND.NOTE_ID = WEN.NOTE_ID
) NOTE ON NOTE.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID



/* FLAG PROCESSO ANTICORRUZIONE */
LEFT JOIN (
	SELECT WEMRS.UOM_CODE, WEMRS.UOM_CODE_LANG, WEM.WORK_EFFORT_ID
	FROM WORK_EFFORT_MEASURE WEM
	JOIN ACCTG_TRANS_ENTRY ATE ON ATE.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID
	JOIN WORK_EFFORT_MEAS_RAT_SC WEMRS ON WEMRS.WORK_EFFORT_MEASURE_ID = WEM.WORK_EFFORT_MEASURE_ID 
		AND WEMRS.UOM_ID = ATE.CURRENCY_UOM_ID AND WEMRS.UOM_RATING_VALUE = ATE.AMOUNT
    WHERE ATE.GL_ACCOUNT_ID = '10825'
) FLAG ON FLAG.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID

/* FLAG CARATTERISTICHE  */
LEFT JOIN (
	SELECT
		RS.UOM_CODE,
		RS.UOM_CODE_LANG,
		WEM.WORK_EFFORT_ID,
		WEM.GL_ACCOUNT_ID
	FROM WORK_EFFORT_MEASURE WEM 
	INNER JOIN ACCTG_TRANS_ENTRY ATE ON ATE.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID
	INNER JOIN WORK_EFFORT_MEAS_RAT_SC RS ON RS.WORK_EFFORT_MEASURE_ID = WEM.WORK_EFFORT_MEASURE_ID
		AND RS.UOM_ID = ATE.CURRENCY_UOM_ID AND RS.UOM_RATING_VALUE = ATE.AMOUNT
) INDFLAG ON INDFLAG.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID

@filterInnerJoin
@filterLeftJoin

WHERE FIL_W.ORGANIZATION_ID=@defaultOrganizationId
  AND FIL_W.WORK_EFFORT_TYPE_ID = @workEffortTypeId AND 
  FIL_W.ESTIMATED_START_DATE <= @date3112 AND FIL_W.ESTIMATED_COMPLETION_DATE >= @date0101
  @orgUnitId
  @filterWhere

GROUP BY
	WEPT.DESCRIPTION_LANG,
	WEPT.DESCRIPTION,
	FIL_W.SOURCE_REFERENCE_ID,
	FIL_W.ETCH,
	FIL_W.WORK_EFFORT_NAME_LANG,
	FIL_W.WORK_EFFORT_NAME,
	PPR.PARENT_ROLE_CODE,
	PA.PARTY_NAME_LANG,
	PA.PARTY_NAME,
	OBS.SOURCE_REFERENCE_ID,
	SOST.UOM_CODE_LANG,
	SOST.UOM_CODE,
	PAPA.EXTERNAL_ID,
	PPRPA.PARENT_ROLE_CODE,
	PAPA.PARTY_NAME_LANG,
	PAPA.PARTY_NAME,
	PA.EXTERNAL_ID,
	OBS.WORK_EFFORT_NAME_LANG,
	OBS.WORK_EFFORT_NAME,
	RESP.PARTY_NAME,
	FIL_W.WORK_EFFORT_ID,
	FLAG.UOM_CODE@langLocale
ORDER BY FIL_W.SOURCE_REFERENCE_ID

]]></xml-property>
