            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">WORK_EFFORT_ID_TO</property>
                    <property name="nativeName">WORK_EFFORT_ID_TO</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">DESTNATARIO</property>
                    <property name="nativeName">DESTNATARIO</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">COMMENTI</property>
                    <property name="nativeName">COMMENTI</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT WORK_EFFORT_ID_TO AS "WORK_EFFORT_ID_TO",
DEST.WORK_EFFORT_NAME@langLocale AS "DESTNATARIO",
COMMENTS@langLocale AS "COMMENTI"
FROM WORK_EFFORT_ASSOC WEA3
LEFT JOIN WORK_EFFORT DEST ON DEST.WORK_EFFORT_ID = WEA3.WORK_EFFORT_ID_FROM AND DEST.WORK_EFFORT_TYPE_ID = '20R24' AND DEST.WORK_EFFORT_REVISION_ID IS NULL
AND DEST.ESTIMATED_START_DATE <= @date3112 AND (DEST.ESTIMATED_COMPLETION_DATE >= @date0101 OR DEST.ESTIMATED_COMPLETION_DATE IS NULL)
LEFT JOIN WORK_EFFORT OBS ON OBS.WORK_EFFORT_ID = WEA3.WORK_EFFORT_ID_TO
WHERE 
WEA3.WORK_EFFORT_ASSOC_TYPE_ID = '20R2C'
AND OBS.WORK_EFFORT_TYPE_ID = @workEffortTypeId
AND OBS.WORK_EFFORT_REVISION_ID IS NULL
AND WEA3.FROM_DATE <= @date3112 AND (WEA3.THRU_DATE IS NULL OR WEA3.THRU_DATE >= @date0101)
AND OBS.WORK_EFFORT_ID = ?
]]></xml-property>
