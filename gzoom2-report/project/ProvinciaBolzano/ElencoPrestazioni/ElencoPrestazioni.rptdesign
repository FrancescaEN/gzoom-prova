            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT
--    CONCAT(C.DESCRIPTION@langLocale, CONCAT('; ', C.CONTENT_NAME)) AS "DESC_ALLEGATI"
    C.DESCRIPTION@langLocale AS "DESC_ALLEGATI"
FROM
    WORK_EFFORT_CONTENT   WEC
    LEFT JOIN CONTENT C ON C.CONTENT_ID = WEC.CONTENT_ID
WHERE
    WEC.WORK_EFFORT_ID = ?
GROUP BY
--    CONCAT(C.DESCRIPTION@langLocale, CONCAT('; ', C.CONTENT_NAME))
    C.DESCRIPTION@langLocale 
ORDER BY
--    CONCAT(C.DESCRIPTION@langLocale, CONCAT('; ', C.CONTENT_NAME))
    C.DESCRIPTION@langLocale 
   ]]></xml-property>
        </oda-data-set>
