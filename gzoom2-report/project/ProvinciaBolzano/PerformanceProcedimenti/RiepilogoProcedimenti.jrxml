	</parameter>
	<parameter name="id_procedimento" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
	VP.ID_PROCEDIMENTO,
 	VP.CODICE_PROCEDIMENTO,
	VP.NOME_PROCEDIMENTO_IT,
	VP.NOME_PROCEDIMENTO_DE,
	VP.ID_STRUTTURA,
	VP.CODICE_STRUTTURA,
	VP.NOME_STRUTTURA_IT,
	VP.NOME_STRUTTURA_DE,
	VIC.CODICE_INDICE_CLASS,
	VIC.NOME_INDICE_CLASS_IT,
	VIC.NOME_INDICE_CLASS_DE,
	VPRE.NOME_PRESTAZIONE_IT,
	VPRE.NOME_PRESTAZIONE_DE,
	VPRO.NOME_PROCESSO_IT,
	VPRO.NOME_PROCESSO_DE,
	VP.SERVIZI_ONLINE_IT,
	VP.SERVIZI_ONLINE_DE,
	VP.AVVIO_PROC_IT,
	VP.AVVIO_PROC_DE,
	VP.SILENZIO_ASSENSO_IT,
	VP.SILENZIO_ASSENSO_DE,
	VP.DECORRENZA_IT,
	VP.DECORRENZA_DE,
	VP.TEMPI_CONSERVAZIONE_IT,
	VP.TEMPI_CONSERVAZIONE_DE,
	GL1.ACCOUNT_NAME_LANG AS NOME_TERMINE_ORDINARIO_IT,
	GL1.ACCOUNT_NAME AS NOME_TERMINE_ORDINARIO_DE,
	VP.TERMINE_ORDINARIO,
	VP.NOTA_TERMINE_ORDINARIO_IT,
	VP.NOTA_TERMINE_ORDINARIO_DE,
	GL2.ACCOUNT_NAME_LANG AS NOME_TERMINE_FISSATO_IT,
	GL2.ACCOUNT_NAME AS NOME_TERMINE_FISSATO_DE,
	VP.TERMINE_FISSATO,
	VP.NOTA_TERMINE_FISSATO_IT,
	VP.NOTA_TERMINE_FISSATO_DE,
	GL3.ACCOUNT_NAME_LANG AS NOME_TERMINE_STABILITO_IT,
	GL3.ACCOUNT_NAME AS NOME_TERMINE_STABILITO_DE,
	VP.TERMINE_STABILITO_IT,
	VP.TERMINE_STABILITO_DE,
	VP.NOTA_TERMINE_STABILITO_IT,
	VP.NOTA_TERMINE_STABILITO_DE,
	VP.NOTA_SERVIZI_ONLINE_IT,
	VP.NOTA_SERVIZI_ONLINE_DE,
	VP.NOTA_AVVIO_PROC_IT,
	VP.NOTA_AVVIO_PROC_DE,
	VP.NOTA_SILENZIO_ASSENSO_IT,
	VP.NOTA_SILENZIO_ASSENSO_DE,
	VP.NOTA_DECORRENZA_IT,
	VP.NOTA_DECORRENZA_DE,
	VP.NOTA_TEMPI_CONSERVAZIONE_IT,
	VP.NOTA_TEMPI_CONSERVAZIONE_DE,
	P.PARTY_NAME  
FROM VW_PROCEDIMENTI VP
LEFT JOIN VW_IND_CLASS VIC ON VIC.ID_INDICE_CLASS = VP.ID_INDICE_CLASSIFICAZIONE 
LEFT JOIN VW_PRESTAZIONI VPRE ON VPRE.ID_PRESTAZIONE = VP.ID_PRESTAZIONE 
LEFT JOIN VW_PROCESSI VPRO ON VPRO.ID_PROCESSO = VP.ID_PROCESSO_ANTICORRUZIONE
LEFT JOIN GL_ACCOUNT GL1 ON GL1.GL_ACCOUNT_ID = '12014'
LEFT JOIN GL_ACCOUNT GL2 ON GL2.GL_ACCOUNT_ID = '12015'
LEFT JOIN GL_ACCOUNT GL3 ON GL3.GL_ACCOUNT_ID = '12016'
LEFT JOIN PARTY_RELATIONSHIP PR ON PR.PARTY_ID_FROM = VP.ID_STRUTTURA AND PR.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE' AND PR.FROM_DATE <= to_date( $P{customTimePeriodFormatted3112}  , 'YYYY-MM-DD')  AND PR.THRU_DATE IS NULL
LEFT JOIN PARTY P ON P.PARTY_ID = PR.PARTY_ID_TO 
WHERE VP.ID_PROCEDIMENTO =  $P{id_procedimento}]]>
	</queryString>
