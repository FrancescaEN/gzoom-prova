	<queryString>
		<![CDATA[SELECT * 
FROM (
	select 
		VW.* ,
		VW.NOME_DIPARTIMENTO$P!{langLocale}  as nomeDipartimento, 
		VW.NOME_RIPARTIZIONE$P!{langLocale}  as nomeRipartizione, 
		VW.NOME_UFFICIO$P!{langLocale} as nomeUfficio,
		(
			SELECT COUNT(*)
			FROM WORK_EFFORT WE
			WHERE (WE.ORG_UNIT_ID = VW.ID_STRUTTURA_DIPARTIMENTO OR WE.ORG_UNIT_ID = VW.ID_STRUTTURA_RIPARTIZIONE OR WE.ORG_UNIT_ID = VW.ID_STRUTTURA_UFFICIO)
				AND WE.ESTIMATED_START_DATE <= TO_DATE($P{customTimePeriodFormatted3112} , 'DD/MM/YYYY') AND WE.ESTIMATED_COMPLETION_DATE >= TO_DATE($P{customTimePeriodFormatted0101}, 'DD/MM/YYYY')
		) AS CONTA_SCHEDE_DIPARTIMENTO,
		(
			SELECT COUNT(*)
			FROM WORK_EFFORT WE
			WHERE (WE.ORG_UNIT_ID = VW.ID_STRUTTURA_RIPARTIZIONE OR WE.ORG_UNIT_ID = VW.ID_STRUTTURA_UFFICIO)
				AND WE.ESTIMATED_START_DATE <= TO_DATE(   $P{customTimePeriodFormatted3112}  , 'DD/MM/YYYY') AND WE.ESTIMATED_COMPLETION_DATE >= TO_DATE(  $P{customTimePeriodFormatted0101}  , 'DD/MM/YYYY')
		) AS CONTA_SCHEDE_RIPARTIZIONE,
		(
			SELECT COUNT(*)
			FROM WORK_EFFORT WE
			WHERE WE.ORG_UNIT_ID = VW.ID_STRUTTURA_UFFICIO 
				AND WE.ESTIMATED_START_DATE <= TO_DATE($P{customTimePeriodFormatted3112} , 'DD/MM/YYYY') AND WE.ESTIMATED_COMPLETION_DATE >= TO_DATE($P{customTimePeriodFormatted0101}, 'DD/MM/YYYY')
		) AS CONTA_SCHEDE_UFFICIO
	/*QUERY OSSATURA PROCEDIMENTI */
	from VW_OSSATURA_PROCEDIMENTI VW
	inner join work_effort FIL_W on FIL_W.work_effort_id = VW.id_scheda
	/* START filterInnerJoin */
	   $P!{filterInnerJoinString} 
	/* END filterInnerJoin */
	/* START filterLeftJoin */
	  $P!{filterLeftJoinString} 
	/* END filterLeftJoin */
	where $P!{filterCustomTimePeriod} 
	/* START filterWhere */
	$P!{filterWhereString} 
	   /* END filterWhere */
	$P!{orgUnitIdString}
	and FIL_W.ESTIMATED_START_DATE <= TO_DATE($P{customTimePeriodFormatted3112} , 'DD/MM/YYYY') AND FIL_W.ESTIMATED_COMPLETION_DATE >= TO_DATE($P{customTimePeriodFormatted0101}, 'DD/MM/YYYY')
	ORDER BY 
		CODICE_ESTERNO_DIPARTIMENTO, CODICE_ESTERNO_RIPARTIZIONE, CODICE_ESTERNO_UFFICIO,cast(REGEXP_REPLACE(fil_w.etch, '[^0-9]', '')as integer)
)
WHERE $P{reportContentId} = 'REPORT_PROC_RIE_JR'
    AND (CONTA_SCHEDE_DIPARTIMENTO > 0 
    OR CONTA_SCHEDE_RIPARTIZIONE > 0 
    OR CONTA_SCHEDE_UFFICIO > 0)
UNION ALL
SELECT * 
FROM (
	select 
		VW.* ,
		VW.NOME_DIPARTIMENTO$P!{langLocale}  as nomeDipartimento, 
		VW.NOME_RIPARTIZIONE$P!{langLocale}  as nomeRipartizione, 
		VW.NOME_UFFICIO$P!{langLocale} as nomeUfficio,
		(
			SELECT COUNT(*)
			FROM WORK_EFFORT WE
			JOIN WORK_EFFORT_MEASURE WEM ON WEM.WORK_EFFORT_ID = WE.WORK_EFFORT_ID AND WEM.GL_ACCOUNT_ID = '12015'
			JOIN ACCTG_TRANS ACT ON ACT.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID 
			WHERE (WE.ORG_UNIT_ID = VW.ID_STRUTTURA_DIPARTIMENTO OR WE.ORG_UNIT_ID = VW.ID_STRUTTURA_RIPARTIZIONE OR WE.ORG_UNIT_ID = VW.ID_STRUTTURA_UFFICIO)
				AND WE.ESTIMATED_START_DATE <= TO_DATE($P{customTimePeriodFormatted3112} , 'DD/MM/YYYY') AND WE.ESTIMATED_COMPLETION_DATE >= TO_DATE($P{customTimePeriodFormatted0101}, 'DD/MM/YYYY')
		) AS CONTA_SCHEDE_DIPARTIMENTO,
		(
			SELECT COUNT(*)
			FROM WORK_EFFORT WE
			JOIN WORK_EFFORT_MEASURE WEM ON WEM.WORK_EFFORT_ID = WE.WORK_EFFORT_ID AND WEM.GL_ACCOUNT_ID = '12015'
			JOIN ACCTG_TRANS ACT ON ACT.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID 
			WHERE (WE.ORG_UNIT_ID = VW.ID_STRUTTURA_RIPARTIZIONE OR WE.ORG_UNIT_ID = VW.ID_STRUTTURA_UFFICIO)
				AND WE.ESTIMATED_START_DATE <= TO_DATE(   $P{customTimePeriodFormatted3112}  , 'DD/MM/YYYY') AND WE.ESTIMATED_COMPLETION_DATE >= TO_DATE(  $P{customTimePeriodFormatted0101}  , 'DD/MM/YYYY')
		) AS CONTA_SCHEDE_RIPARTIZIONE,
		(
			SELECT COUNT(*)
			FROM WORK_EFFORT WE
			JOIN WORK_EFFORT_MEASURE WEM ON WEM.WORK_EFFORT_ID = WE.WORK_EFFORT_ID AND WEM.GL_ACCOUNT_ID = '12015'
			JOIN ACCTG_TRANS ACT ON ACT.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID 
			WHERE WE.ORG_UNIT_ID = VW.ID_STRUTTURA_UFFICIO 
				AND WE.ESTIMATED_START_DATE <= TO_DATE($P{customTimePeriodFormatted3112} , 'DD/MM/YYYY') AND WE.ESTIMATED_COMPLETION_DATE >= TO_DATE($P{customTimePeriodFormatted0101}, 'DD/MM/YYYY')
		) AS CONTA_SCHEDE_UFFICIO
		/*QUERY OSSATURA PROCEDIMENTI */
	from VW_OSSATURA_PROCEDIMENTI VW
	inner join work_effort FIL_W on FIL_W.work_effort_id = VW.id_scheda
	JOIN WORK_EFFORT_MEASURE WEM ON WEM.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID AND WEM.GL_ACCOUNT_ID = '12015'
	JOIN ACCTG_TRANS ACT ON ACT.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID
	/* START filterInnerJoin */
	   $P!{filterInnerJoinString} 
	/* END filterInnerJoin */
	/* START filterLeftJoin */
	  $P!{filterLeftJoinString} 
	/* END filterLeftJoin */
	where $P!{filterCustomTimePeriod} 
	/* START filterWhere */
	$P!{filterWhereString} 
	   /* END filterWhere */
	$P!{orgUnitIdString}
	and FIL_W.ESTIMATED_START_DATE <= TO_DATE($P{customTimePeriodFormatted3112} , 'DD/MM/YYYY') AND FIL_W.ESTIMATED_COMPLETION_DATE >= TO_DATE($P{customTimePeriodFormatted0101}, 'DD/MM/YYYY')
	ORDER BY CODICE_ESTERNO_DIPARTIMENTO, CODICE_ESTERNO_RIPARTIZIONE, CODICE_ESTERNO_UFFICIO,cast(REGEXP_REPLACE(fil_w.etch, '[^0-9]', '')as integer)
)
WHERE $P{reportContentId} = 'REPORT_PROC_IST_JR'
	AND (CONTA_SCHEDE_DIPARTIMENTO > 0 
    OR CONTA_SCHEDE_RIPARTIZIONE > 0 
    OR CONTA_SCHEDE_UFFICIO > 0)]]>
	</queryString>
