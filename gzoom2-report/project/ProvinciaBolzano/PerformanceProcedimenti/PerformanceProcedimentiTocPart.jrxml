		<queryString language="SQL">
			<![CDATA[select INTESTAZIONE_Q1,INTESTAZIONE_Q2, INTESTAZIONE_REND,INTESTAZIONE_PREV from exp_str EXP
inner join work_effort FIL_W
on FIL_W.work_effort_id = EXP.work_effort_id_str
where EXP.anno = TO_CHAR($P{monitoringDateString}::date, 'YYYY')
and work_Effort_Type_Id = $P{workEffortTypeId}
 /* START orgUnitIdString */
 $P!{orgUnitIdString}
 /* END orgUnitIdString */
 limit 1]]>
		</queryString>
