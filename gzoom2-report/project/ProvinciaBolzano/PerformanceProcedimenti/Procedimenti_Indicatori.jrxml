	<parameter name="id_procedimento" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT * FROM (
SELECT 
	VPI.ID_PROCEDIMENTO AS ID_PROCEDIMENTO ,
	MAX(CASE WHEN ID_INDICATORE = 10117 THEN NOME_INDICATORE_IT ELSE NULL END) AS NOME_ISTANZE_IT,
	MAX(CASE WHEN ID_INDICATORE = 10117 THEN NOME_INDICATORE_DE ELSE NULL END) AS NOME_ISTANZE_DE,
	MAX(CASE WHEN ID_INDICATORE = 10117 AND ANNO_RIFERIMENTO =  $P{year}  THEN TARGET_INDICATORE ELSE NULL END) AS TARGET_ANNO_ISTANZE,
	MAX(CASE WHEN ID_INDICATORE = 10117 AND ANNO_RIFERIMENTO =  $P{yearP1}  THEN TARGET_INDICATORE ELSE NULL END) AS TARGET_ANNO_ISTANZE1,
	MAX(CASE WHEN ID_INDICATORE = 10117 AND ANNO_RIFERIMENTO =  $P{yearP2}  THEN TARGET_INDICATORE ELSE NULL END) AS TARGET_ANNO_ISTANZE2,
	MAX(CASE WHEN ID_INDICATORE = 10117 AND ANNO_RIFERIMENTO =  $P{yearM1}  THEN CONSUNTIVO_INDICATORE ELSE NULL END) AS CONSUNTIVO_ANNO_ISTANZE1,
	MAX(CASE WHEN ID_INDICATORE = 10117 AND ANNO_RIFERIMENTO =  $P{yearM2} THEN CONSUNTIVO_INDICATORE ELSE NULL END) AS CONSUNTIVO_ANNO_ISTANZE2,
	MAX(CASE WHEN ID_INDICATORE = 10117 AND ANNO_RIFERIMENTO =  $P{yearM3}  THEN CONSUNTIVO_INDICATORE ELSE NULL END) AS CONSUNTIVO_ANNO_ISTANZE3,
	MAX(CASE WHEN ID_INDICATORE = 10125 THEN NOME_INDICATORE_IT ELSE NULL END) AS NOME_DURATA_IT,
	MAX(CASE WHEN ID_INDICATORE = 10125 THEN NOME_INDICATORE_DE ELSE NULL END) AS NOME_DURATA_DE,
	MAX(CASE WHEN ID_INDICATORE = 10125 AND ANNO_RIFERIMENTO =  $P{year}  THEN TARGET_INDICATORE ELSE NULL END) AS TARGET_ANNO_DURATA,
	MAX(CASE WHEN ID_INDICATORE = 10125 AND ANNO_RIFERIMENTO = $P{yearP1}  THEN TARGET_INDICATORE ELSE NULL END) AS TARGET_ANNO_DURATA1,
	MAX(CASE WHEN ID_INDICATORE = 10125 AND ANNO_RIFERIMENTO = $P{yearP2}  THEN TARGET_INDICATORE ELSE NULL END) AS TARGET_ANNO_DURATA2,
	MAX(CASE WHEN ID_INDICATORE = 10125 AND ANNO_RIFERIMENTO =  $P{yearM1} THEN CONSUNTIVO_INDICATORE ELSE NULL END) AS CONSUNTIVO_ANNO_DURATA1,
	MAX(CASE WHEN ID_INDICATORE = 10125 AND ANNO_RIFERIMENTO =  $P{yearM2} THEN CONSUNTIVO_INDICATORE ELSE NULL END) AS CONSUNTIVO_ANNO_DURATA2,
	MAX(CASE WHEN ID_INDICATORE = 10125 AND ANNO_RIFERIMENTO =  $P{yearM3}  THEN CONSUNTIVO_INDICATORE ELSE NULL END) AS CONSUNTIVO_ANNO_DURATA3
FROM VW_PROCEDIMENTI_INDIC VPI 
GROUP BY VPI.ID_PROCEDIMENTO) 
WHERE ID_PROCEDIMENTO = $P{id_procedimento}]]>
	</queryString>
