		<queryString language="SQL">
			<![CDATA[SELECT 
	VP.ID_PROCEDIMENTO,
	VP.NOME_PROCEDIMENTO_IT,
	VP.NOME_PROCEDIMENTO_DE,
	VPN.CONTENUTO_NOTA_IT,
	VPN.CONTENUTO_NOTA_DE,
	VP.TERMINE_FISSATO,
	VP.DECORRENZA_IT,
	VP.DECORRENZA_DE,
	VP.AVVIO_PROC_IT,
	VP.AVVIO_PROC_DE, 
	VP.ID_STRUTTURA
FROM VW_PROCEDIMENTI VP
JOIN VW_PROCEDIMENTI_NOTE VPN ON VPN.ID_PROCEDIMENTO = VP.ID_PROCEDIMENTO AND VPN.SEQUENZA_NOTA = 120
WHERE VP.TERMINE_FISSATO IS NOT NULL AND VP.TERMINE_ORDINARIO IS NULL AND VP.TERMINE_STABILITO_IT IS NULL]]>
		</queryString>
