	<parameter name="id_procedimento" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT * FROM ( 
SELECT 
	VPN.ID_PROCEDIMENTO AS ID_PROCEDIMENTO,
	MAX(CASE WHEN VPN.SEQUENZA_NOTA = 110 THEN TO_CHAR(VPN.CONTENUTO_NOTA_IT) ELSE NULL END) AS SERVIZIO_IT,
	MAX(CASE WHEN VPN.SEQUENZA_NOTA = 110 THEN TO_CHAR(VPN.CONTENUTO_NOTA_DE) ELSE NULL END) AS SERVIZIO_DE,
	MAX(CASE WHEN VPN.SEQUENZA_NOTA = 120 THEN TO_CHAR(VPN.CONTENUTO_NOTA_IT) ELSE NULL END) AS NORMATIVA_IT,
	MAX(CASE WHEN VPN.SEQUENZA_NOTA = 120 THEN TO_CHAR(VPN.CONTENUTO_NOTA_DE) ELSE NULL END) AS NORMATIVA_DE
FROM 
	VW_PROCEDIMENTI_NOTE VPN 
GROUP BY 
    VPN.ID_PROCEDIMENTO)
WHERE ID_PROCEDIMENTO = $P{id_procedimento}]]>
	</queryString>
