	<queryString language="SQL">
		<![CDATA[SELECT
	NOTE.NOTE_INFO_LANG AS CONTENUTO_NOTA_IT,
	NOTE.NOTE_INFO AS CONTENUTO_NOTA_DE
/* PRIORITA SVILUPPO */
FROM
	WORK_EFFORT PRIO
/* NOTE */
LEFT JOIN (
	SELECT
		WEN.WORK_EFFORT_ID,
		WEN.SEQUENCE_ID,
		ND.NOTE_DATE_TIME AS DATA_NOTA,
		ND.NOTE_INFO_LANG AS NOTE_INFO_LANG,
		ND.NOTE_INFO AS NOTE_INFO
	FROM WORK_EFFORT_NOTE WEN
	LEFT JOIN NOTE_DATA ND ON ND.NOTE_ID = WEN.NOTE_ID
) NOTE ON NOTE.WORK_EFFORT_ID = PRIO.WORK_EFFORT_ID
WHERE PRIO.WORK_EFFORT_TYPE_ID = '20D64' AND PRIO.WORK_EFFORT_REVISION_ID IS NULL AND PRIO.WORK_EFFORT_ID = $P{work_effort_id_ob}
	AND NOTE.SEQUENCE_ID = 110
	AND (NOTE.NOTE_INFO_LANG IS NOT NULL OR NOTE.NOTE_INFO IS NOT NULL)
	AND NOTE.DATA_NOTA = TO_DATE($P{customTimePeriodFormatted0101}, 'DD-MM-YYYY')
ORDER BY
	PRIO.SOURCE_REFERENCE_ID,
	NOTE.DATA_NOTA]]>
	</queryString>
