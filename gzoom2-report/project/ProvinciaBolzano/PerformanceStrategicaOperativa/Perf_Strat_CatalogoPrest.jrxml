	<field name="NOME_PRESTAZIONE_DE" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="NOME_OBIETTIVO_STRATEGICO_DE"/>
		<property name="com.jaspersoft.studio.field.label" value="NOME_OBIETTIVO_STRATEGICO_DE"/>
	</field>
	<field name="FINALITA_IT" class="java.lang.String"/>
	<field name="FINALITA_DE" class="java.lang.String"/>
	<field name="DESCRIZIONE_IT" class="java.lang.String"/>
	<field name="DESCRIZIONE_DE" class="java.lang.String"/>
	<field name="FONTE_IT" class="java.lang.String"/>
	<field name="FONTE_DE" class="java.lang.String"/>
	<field name="VALORE_FLAG_PARI_OPPORTUNITA" class="java.lang.String"/>
