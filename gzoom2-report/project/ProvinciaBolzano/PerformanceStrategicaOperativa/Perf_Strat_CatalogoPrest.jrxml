	<group name="CodiceObStratGruppo">
		<groupExpression><![CDATA[$F{CODICE_PRESTAZIONE}]]></groupExpression>
		<groupHeader>
			<band height="15">
				<property name="com.jaspersoft.studio.unit.height" value="px"/>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement style="TextFieldStyle" stretchType="ContainerHeight" mode="Opaque" x="0" y="0" width="200" height="15" forecolor="#767171" backcolor="#EBEBEB" uuid="13a594c4-c4e2-43bf-b2c9-e14c77e0017a">
						<property name="com.jaspersoft.studio.unit.x" value="px"/>
						<property name="com.jaspersoft.studio.unit.y" value="px"/>
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
					</reportElement>
					<box>
						<pen lineWidth="0.1" lineColor="#808080"/>
						<topPen lineWidth="0.1" lineStyle="Solid" lineColor="#808080"/>
						<leftPen lineWidth="0.1" lineStyle="Solid" lineColor="#808080"/>
						<bottomPen lineWidth="0.1" lineStyle="Solid" lineColor="#808080"/>
						<rightPen lineWidth="0.1" lineStyle="Solid" lineColor="#808080"/>
					</box>
					<textElement verticalAlignment="Middle">
