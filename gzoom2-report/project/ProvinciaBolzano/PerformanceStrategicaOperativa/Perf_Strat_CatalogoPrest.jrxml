	</parameter>
	<parameter name="id_prestazione" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
	PRE.SOURCE_REFERENCE_ID AS CODICE_PRESTAZIONE,
	PRE.ETCH AS ETICHETTA_PRESTAZIONE,
	PRE.WORK_EFFORT_NAME_LANG AS NOME_PRESTAZIONE_IT,
	PRE.WORK_EFFORT_NAME AS NOME_PRESTAZIONE_DE,
	NOTE.FINALITA_IT,
	NOTE.FINALITA_DE,
	NOTE.DESCRIZIONE_IT,
	NOTE.DESCRIZIONE_DE,
	NOTE.FONTE_IT,
	NOTE.FONTE_DE,
	CAR.VALORE_FLAG_PARIOPP_IT AS VALORE_FLAG_PARI_OPPORTUNITA,
	CAR.VALORE_FLAG_PARIOPP AS VALORE_FLAG_PARI_OPPORTUNITA_DE,
	CAR.VALORE_FLAG_PNC_IT AS VALORE_FLAG_PNC,
	CAR.VALORE_FLAG_PNC AS VALORE_FLAG_PNC_DE,
	PRE.WORK_EFFORT_ID AS ID_PRESTAZIONE,
	OBS.WORK_EFFORT_ID AS ID_OBIETTIVO_STRATEGICO,
	(SELECT COUNT(*)
		FROM WORK_EFFORT PREST
		JOIN WORK_EFFORT_ASSOC WEA ON WEA.WORK_EFFORT_ID_TO = PREST.WORK_EFFORT_ID AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '20R8C'
		JOIN WORK_EFFORT OBSOST ON OBSOST.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_FROM	AND OBSOST.WORK_EFFORT_TYPE_ID = '20R84' AND OBSOST.WORK_EFFORT_REVISION_ID IS NULL
		WHERE PREST.WORK_EFFORT_TYPE_ID = '20C42' AND PREST.WORK_EFFORT_REVISION_ID IS NULL AND PREST.WORK_EFFORT_ID = PRE.WORK_EFFORT_ID
	) AS CONTA_OBIETTIVI2030
/* PRESTAZIONI */
FROM WORK_EFFORT PRE
/* TIPO PRESTAZIONE */
LEFT JOIN WORK_EFFORT_PURPOSE_TYPE WEPT ON	WEPT.WORK_EFFORT_PURPOSE_TYPE_ID = PRE.WORK_EFFORT_PURPOSE_TYPE_ID
/* STRUTTURA */
JOIN PARTY STRUTT ON STRUTT.PARTY_ID = PRE.ORG_UNIT_ID
JOIN PARTY_PARENT_ROLE PPRSTRUTT ON	PPRSTRUTT.PARTY_ID = STRUTT.PARTY_ID AND PPRSTRUTT.ROLE_TYPE_ID <> 'INTERNAL_ORGANIZATIO'
/* COLLEGAMENTO A OBIETTIVO STRATEGICO */
LEFT JOIN WORK_EFFORT_ASSOC WEA ON WEA.WORK_EFFORT_ID_TO = PRE.WORK_EFFORT_ID AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '20D62C'
LEFT JOIN WORK_EFFORT OBS ON OBS.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_FROM AND OBS.WORK_EFFORT_TYPE_ID = '20D62'	AND OBS.WORK_EFFORT_REVISION_ID IS NULL
/* NOTE */
LEFT JOIN (
	SELECT
		WEN.WORK_EFFORT_ID,
		MAX(CASE WHEN WEN.SEQUENCE_ID = 10 THEN TO_CHAR(ND.NOTE_INFO_LANG) ELSE NULL END) AS FINALITA_IT,
		MAX(CASE WHEN WEN.SEQUENCE_ID = 10 THEN TO_CHAR(ND.NOTE_INFO) ELSE NULL END) AS FINALITA_DE,
		MAX(CASE WHEN WEN.SEQUENCE_ID = 10 THEN ND.NOTE_NAME_LANG ELSE NULL END) AS NOME_FINALITA_IT,
		MAX(CASE WHEN WEN.SEQUENCE_ID = 10 THEN ND.NOTE_NAME ELSE NULL END) AS NOME_FINALITA_DE,
		MAX(CASE WHEN WEN.SEQUENCE_ID = 15 THEN TO_CHAR(ND.NOTE_INFO_LANG) ELSE NULL END) AS DESCRIZIONE_IT,
		MAX(CASE WHEN WEN.SEQUENCE_ID = 15 THEN TO_CHAR(ND.NOTE_INFO) ELSE NULL END) AS DESCRIZIONE_DE,
		MAX(CASE WHEN WEN.SEQUENCE_ID = 15 THEN ND.NOTE_NAME_LANG ELSE NULL END) AS NOME_DESCRIZIONE_IT,
		MAX(CASE WHEN WEN.SEQUENCE_ID = 15 THEN ND.NOTE_NAME ELSE NULL END) AS NOME_DESCRIZIONE_DE,
		MAX(CASE WHEN WEN.SEQUENCE_ID = 20 THEN TO_CHAR(ND.NOTE_INFO_LANG) ELSE NULL END) AS FONTE_IT,
		MAX(CASE WHEN WEN.SEQUENCE_ID = 20 THEN TO_CHAR(ND.NOTE_INFO) ELSE NULL END) AS FONTE_DE,
		MAX(CASE WHEN WEN.SEQUENCE_ID = 20 THEN ND.NOTE_NAME_LANG ELSE NULL END) AS NOME_FONTE_IT,
		MAX(CASE WHEN WEN.SEQUENCE_ID = 20 THEN ND.NOTE_NAME ELSE NULL END) AS NOME_FONTE_DE
	FROM WORK_EFFORT_NOTE WEN
	LEFT JOIN NOTE_DATA ND ON ND.NOTE_ID = WEN.NOTE_ID
	GROUP BY
		WEN.WORK_EFFORT_ID
) NOTE ON NOTE.WORK_EFFORT_ID = PRE.WORK_EFFORT_ID
/* CARATTERISTICHE */
LEFT JOIN (
	SELECT
		WEM.WORK_EFFORT_ID,
		MAX(CASE WHEN WEM.GL_ACCOUNT_ID = '10825' THEN GAMRS.UOM_CODE_LANG ELSE NULL END) AS VALORE_FLAG_PROCESSO_IT,
		MAX(CASE WHEN WEM.GL_ACCOUNT_ID = '10825' THEN GAMRS.UOM_CODE ELSE NULL END) AS VALORE_FLAG_PROCESSO,
		MAX(CASE WHEN WEM.GL_ACCOUNT_ID = '10825' THEN GL.ACCOUNT_NAME_LANG ELSE NULL END) AS NOME_FLAG_PROCESSO_IT,
		MAX(CASE WHEN WEM.GL_ACCOUNT_ID = '10825' THEN GL.ACCOUNT_NAME ELSE NULL END) AS NOME_FLAG_PROCESSO,
		MAX(CASE WHEN WEM.GL_ACCOUNT_ID = '10106' THEN GAMRS.UOM_CODE_LANG ELSE NULL END) AS VALORE_FLAG_SOSTENIBILITA_IT,
		MAX(CASE WHEN WEM.GL_ACCOUNT_ID = '10106' THEN GAMRS.UOM_CODE ELSE NULL END) AS VALORE_FLAG_SOSTENIBILITA,
		MAX(CASE WHEN WEM.GL_ACCOUNT_ID = '10106' THEN GL.ACCOUNT_NAME_LANG ELSE NULL END) AS NOME_FLAG_SOSTENIBILITA_IT,
		MAX(CASE WHEN WEM.GL_ACCOUNT_ID = '10106' THEN GL.ACCOUNT_NAME ELSE NULL END) AS NOME_FLAG_SOSTENIBILITA,
		MAX(CASE WHEN WEM.GL_ACCOUNT_ID = '11140' THEN GAMRS.UOM_CODE_LANG ELSE NULL END) AS VALORE_FLAG_PNRR_IT,
		MAX(CASE WHEN WEM.GL_ACCOUNT_ID = '11140' THEN GAMRS.UOM_CODE ELSE NULL END) AS VALORE_FLAG_PNRR,
		MAX(CASE WHEN WEM.GL_ACCOUNT_ID = '11141' THEN GAMRS.UOM_CODE_LANG ELSE NULL END) AS VALORE_FLAG_PNC_IT,
		MAX(CASE WHEN WEM.GL_ACCOUNT_ID = '11141' THEN GAMRS.UOM_CODE ELSE NULL END) AS VALORE_FLAG_PNC,
		MAX(CASE WHEN WEM.GL_ACCOUNT_ID = '10091' THEN GAMRS.UOM_CODE_LANG ELSE NULL END) AS VALORE_FLAG_PARIOPP_IT,
		MAX(CASE WHEN WEM.GL_ACCOUNT_ID = '10091' THEN GAMRS.UOM_CODE ELSE NULL END) AS VALORE_FLAG_PARIOPP
	FROM WORK_EFFORT_MEASURE WEM
	JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID
	LEFT JOIN ACCTG_TRANS_ENTRY ATE ON ATE.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID
	LEFT JOIN GL_ACCOUNT_MEAS_RAT_SC GAMRS ON GAMRS.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID
		AND GAMRS.UOM_RATING_VALUE <= ATE.AMOUNT AND GAMRS.UOM_RATING_VALUE >= ATE.AMOUNT
	GROUP BY
		WEM.WORK_EFFORT_ID
) CAR ON CAR.WORK_EFFORT_ID = PRE.WORK_EFFORT_ID
JOIN WORK_EFFORT FIL_W ON FIL_W.WORK_EFFORT_ID = PRE.WORK_EFFORT_ID
$P!{filterInnerJoinString}
$P!{filterLeftJoinString}
WHERE PRE.WORK_EFFORT_TYPE_ID = '20C42' AND PRE.WORK_EFFORT_REVISION_ID IS NULL AND PRE.WORK_EFFORT_ID = $P{id_prestazione} 
$P!{filterWhereString}]]>
	</queryString>
	<field name="CODICE_PRESTAZIONE" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="CODICE_OBIETTIVO_STRATEGICO"/>
