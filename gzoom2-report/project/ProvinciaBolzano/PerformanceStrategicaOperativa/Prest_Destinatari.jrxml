	<parameter name="work_effort_id_ob" class="java.lang.String"/>
	<parameter name="monitoringDateString" class="java.lang.String"/>
	<parameter name="langLocale" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT DISTINCT
	DEST.SOURCE_REFERENCE_ID AS CODICE_DESTINATARIO,
	WEA.COMMENTS_LANG AS COMMENTO_DESTINATARIO_IT,
	WEA.COMMENTS AS COMMENTO_DESTINATARIO_DE,
	DEST.WORK_EFFORT_NAME_LANG AS NOME_DESTINATARIO_IT,
	DEST.WORK_EFFORT_NAME AS NOME_DESTINATARIO_DE
FROM WORK_EFFORT PRE
JOIN WORK_EFFORT_ASSOC WEA ON WEA.WORK_EFFORT_ID_TO = PRE.WORK_EFFORT_ID AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '20R2C'
JOIN WORK_EFFORT DEST ON DEST.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_FROM AND DEST.WORK_EFFORT_TYPE_ID = '20R24' AND DEST.WORK_EFFORT_REVISION_ID IS NULL
WHERE PRE.WORK_EFFORT_TYPE_ID = '20C42' AND PRE.WORK_EFFORT_REVISION_ID IS NULL AND PRE.WORK_EFFORT_ID = $P{work_effort_id_ob}
ORDER BY DEST.SOURCE_REFERENCE_ID]]>
	</queryString>
