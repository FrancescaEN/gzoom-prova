	<parameter name="langLocale" class="java.lang.String" isForPrompting="false"/>
	<parameter name="work_effort_id_ob" class="java.lang.String" isForPrompting="false"/>
	<queryString language="SQL">
		<![CDATA[SELECT
	LISTAGG(MISS.WORK_EFFORT_NAME_LANG, '
')WITHIN GROUP(ORDER BY MISS.ETCH) AS NOME_MISSIONE_PNRR_IT,
	LISTAGG(MISS.WORK_EFFORT_NAME, '
')WITHIN GROUP(ORDER BY MISS.ETCH) AS NOME_MISSIONE_PNRR_DE
FROM WORK_EFFORT PRE
JOIN WORK_EFFORT_ASSOC WEA ON WEA.WORK_EFFORT_ID_TO = PRE.WORK_EFFORT_ID AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '20R10C'
JOIN WORK_EFFORT MISS ON MISS.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_FROM AND MISS.WORK_EFFORT_TYPE_ID = '20R104' AND MISS.WORK_EFFORT_REVISION_ID IS NULL
WHERE PRE.WORK_EFFORT_TYPE_ID = '20C42' AND PRE.WORK_EFFORT_REVISION_ID IS NULL AND PRE.WORK_EFFORT_ID = $P{work_effort_id_ob}]]>
	</queryString>
	<field name="NOME_MISSIONE_PNRR_IT" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="NOME_MISSIONE_PNRR_IT"/>
