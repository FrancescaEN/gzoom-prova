	<parameter name="langLocale" class="java.lang.String" isForPrompting="false"/>
	<parameter name="id_scheda_orig" class="java.lang.String" isForPrompting="false"/>
	<parameter name="date3112sql" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select LISTAGG(DESCRIZIONE_ALLEGATO_IT, '
')WITHIN GROUP(ORDER BY DESCRIZIONE_ALLEGATO_IT) AS DESCRIZIONE_ALLEGATO_IT,
LISTAGG(DESCRIZIONE_ALLEGATO_DE, '
')WITHIN GROUP(ORDER BY DESCRIZIONE_ALLEGATO_DE) AS DESCRIZIONE_ALLEGATO_DE
from VW_ALLEGATI
where ID_SCHEDA= $P{id_scheda_orig}
AND DATA_INIZIO_VALIDITA <= $P{date3112sql}]]>
	</queryString>
