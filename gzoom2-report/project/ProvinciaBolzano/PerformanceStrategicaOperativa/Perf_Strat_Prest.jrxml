join VW_OB_SOSTENIBILITA SOST on SOST.ID_OB_SOSTENIBILITA = STRAT.ID_OBIETTIVO_SOSTENIBILITA 
where STRAT.ID_OBIETTIVO_STRATEGICO  = $P{work_effort_id_ob}]]>
