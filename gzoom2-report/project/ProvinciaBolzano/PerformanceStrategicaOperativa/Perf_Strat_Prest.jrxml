	<parameter name="customTimePeriodFormatted3112" class="java.lang.String">
		<defaultValueExpression><![CDATA[$P{customTimePeriod} != null ?
 ( ""+(INTEGER_VALUE($P{customTimePeriod}.substring(0, 4) )+2)  + "-"+  $P{customTimePeriod}.substring(5, 7) + "-" + $P{customTimePeriod}.substring(8, 10) ): 
""]]></defaultValueExpression>
	</parameter>
	<parameter name="date3112P1sql" class="java.lang.String">
		<defaultValueExpression><![CDATA[$P{customTimePeriod} != null ?
 ( ""+(INTEGER_VALUE($P{customTimePeriod}.substring(0, 4) )+1)  + "-"+  $P{customTimePeriod}.substring(5, 7) + "-" + $P{customTimePeriod}.substring(8, 10) ): 
""]]></defaultValueExpression>
	</parameter>
	<parameter name="workEffortIdString" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$P{workEffortId}  != null && $P{workEffortId}  != "" ? 
	"AND OB_STRAT.ID_OBIETTIVO_STRATEGICO= '" + $P{workEffortId}+"'"
: " "]]></defaultValueExpression>
	</parameter>
	<parameter name="filterCustomTimePeriod_Prest" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$P{customTimePeriod} != null ? 
("TO_DATE(DATA_INIZIO_PRESTAZIONE,'DD/MM/YYYY') <= TO_DATE('" + $P{customTimePeriodFormatted} + "','DD/MM/YYYY') AND TO_DATE(DATA_FINE_PRESTAZIONE,'DD/MM/YYYY') >= TO_DATE('" + $P{customTimePeriodFormatted0101} + "','DD/MM/YYYY')" ) : ""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select distinct PRESTAZIONI.*,
(SELECT COUNT(*)
FROM VW_ALLEGATI VA
WHERE VA.ID_SCHEDA=PRESTAZIONI.ID_PRESTAZIONE AND
VA.DATA_INIZIO_VALIDITA <=$P{date3112sql}
)AS CONTA_ALLEGATI from VW_PRESTAZIONI PRESTAZIONI
inner join work_effort FIL_W on FIL_W.work_effort_id = PRESTAZIONI.ID_PRESTAZIONE
/* START filterInnerJoin */
   $P!{filterInnerJoinString} 
/* END filterInnerJoin */
/* START filterLeftJoin */
  $P!{filterLeftJoinString} 
/* END filterLeftJoin */
where PRESTAZIONI.ID_STRUTTURA = $P{id_scheda}
AND $P!{filterCustomTimePeriod_Prest}
  /* START filterWhere */
 $P!{filterWhereString} 
   /* END filterWhere */
  order by ETICHETTA_PRESTAZIONE]]>
	</queryString>
