	<parameter name="work_effort_id_ob" class="java.lang.String" isForPrompting="false"/>
	<parameter name="langLocale" class="java.lang.String" isForPrompting="false"/>
	<queryString language="SQL">
		<![CDATA[SELECT
	LISTAGG(VALP.WORK_EFFORT_NAME_LANG, '
') WITHIN GROUP(ORDER BY VALP.ETCH) AS NOME_OBIETTIVO_VALORE_PUBBLICO_IT,
	LISTAGG(VALP.WORK_EFFORT_NAME, '
') WITHIN GROUP(ORDER BY VALP.ETCH) AS NOME_OBIETTIVO_VALORE_PUBBLICO_DE
FROM WORK_EFFORT OBS
/* OBIETTIVO DI VALORE PUBBLICO */
JOIN WORK_EFFORT_ASSOC WEA ON WEA.WORK_EFFORT_ID_TO = OBS.WORK_EFFORT_ID AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '20R12C'
JOIN WORK_EFFORT VALP ON VALP.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_FROM AND VALP.WORK_EFFORT_TYPE_ID = '20R124' AND VALP.WORK_EFFORT_REVISION_ID IS NULL
WHERE OBS.WORK_EFFORT_TYPE_ID = '20D62' AND OBS.WORK_EFFORT_REVISION_ID IS NULL AND OBS.WORK_EFFORT_ID = $P{work_effort_id_ob}]]>
	</queryString>
	<field name="NOME_OBIETTIVO_VALORE_PUBBLICO_IT" class="java.lang.String">
