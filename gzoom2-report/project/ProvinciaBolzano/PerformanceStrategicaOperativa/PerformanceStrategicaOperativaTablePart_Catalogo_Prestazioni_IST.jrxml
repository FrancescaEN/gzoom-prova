	<queryString>
		<![CDATA[select VW.* ,
VW.NOME_DIPARTIMENTO$P!{langLocale} as nomeDipartimento, 
VW.NOME_RIPARTIZIONE$P!{langLocale} as nomeRipartizione, 
VW.NOME_UFFICIO$P!{langLocale} as nomeUfficio,
(SELECT COUNT(*) FROM WORK_EFFORT we
WHERE WE.ORG_UNIT_ID=VW.ID_STRUTTURA_UFFICIO AND WE.WORK_EFFORT_TYPE_ID IN ('20C42')
AND we.estimated_start_date<=TO_DATE( $P{customTimePeriodFormatted3112} ,'DD/MM/YYYY') AND we.estimated_completion_date>=TO_DATE( $P{customTimePeriodFormatted0101} ,'DD/MM/YYYY')
)AS CONTA_SCHEDE_PREST
/*QUERY OSSATURA PRESTAZIONI */
from VW_OSSATURA VW
inner join work_effort FIL_W on FIL_W.work_effort_id = VW.id_scheda
/* START filterInnerJoin */
   $P!{filterInnerJoinString} 
/* END filterInnerJoin */
/* START filterLeftJoin */
  $P!{filterLeftJoinString} 
/* END filterLeftJoin */
where $P!{filterCustomTimePeriod} 
and VW.ORGANIZATION_ID= $P{defaultOrganizationPartyId}
/* START filterWhere */
 $P!{filterWhereString} 
   /* END filterWhere */
 $P!{orgUnitIdString}
 ORDER BY CODICE_ESTERNO_DIPARTIMENTO, CODICE_ESTERNO_RIPARTIZIONE, CODICE_ESTERNO_UFFICIO,cast(REGEXP_REPLACE(fil_w.etch, '[^0-9]', '')as integer)]]>
	</queryString>
