	titolo += row["DESCRIPTION1"];&#13;
} else {&#13;
	titolo += row["WORK_EFFORT_NAME1"] != null &amp;&amp;  row["WORK_EFFORT_NAME1"] != '' ? row["WORK_EFFORT_NAME1"] : "";&#13;
	&#13;
}&#13;
