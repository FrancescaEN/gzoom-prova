            <xml-property name="queryText"><![CDATA[SELECT  
	RADTC.ETCH@langLocale AS "RAD_TITOLO",
	
	OB1.WORK_EFFORT_ID AS "WORK_EFFORT_ID1",
	OB1.ETCH AS "ETCH1",
	OB1A.SEQUENCE_NUM AS "SEQUENCE_NUM1",
	OB1A.ASSOC_WEIGHT AS "ASSOC_WEIGHT1", 
	OB1.SOURCE_REFERENCE_ID AS "SOURCE_REFERENCE_ID1",	  
	-- ELEMENTI DIFFERENTI X IL BILINGUISMO
	OB1T.ETCH@langLocale AS "ETCH_TYPE1", 
	OB1.WORK_EFFORT_NAME@langLocale AS "WORK_EFFORT_NAME1",
	OB1.DESCRIPTION@langLocale AS "DESCRIPTION1",
	      
	OB2.WORK_EFFORT_ID AS "WORK_EFFORT_ID2",
	OB2.ETCH AS "ETCH2",
	OB2A.SEQUENCE_NUM AS "SEQUENCE_NUM2",
	OB2A.ASSOC_WEIGHT AS "ASSOC_WEIGHT2", 
	OB2.SOURCE_REFERENCE_ID AS "SOURCE_REFERENCE_ID2",	
	-- ELEMENTI DIFFERENTI X IL BILINGUISMO
	OB2T.ETCH@langLocale AS "ETCH_TYPE2", 
	OB2.WORK_EFFORT_NAME@langLocale AS "WORK_EFFORT_NAME2",
	OB2.DESCRIPTION@langLocale AS "DESCRIPTION2",  
	
	OB3.WORK_EFFORT_ID AS "WORK_EFFORT_ID3",
	OB3.ETCH AS "ETCH3",
	OB3A.SEQUENCE_NUM AS "SEQUENCE_NUM3",
	OB3A.ASSOC_WEIGHT AS "ASSOC_WEIGHT3", 
	OB3.SOURCE_REFERENCE_ID AS "SOURCE_REFERENCE_ID3",
	-- ELEMENTI DIFFERENTI X IL BILINGUISMO
	OB3T.ETCH@langLocale AS "ETCH_TYPE3", 
	OB3.WORK_EFFORT_NAME@langLocale AS "WORK_EFFORT_NAME3",
	OB3.DESCRIPTION@langLocale AS "DESCRIPTION3", 
	
	FIL_W.WORK_EFFORT_ID4 AS "WORK_EFFORT_ID4", 
	FIL_W.ETCH_TYPE4 AS "ETCH_TYPE4", 
	FIL_W.ETCH4 AS "ETCH4", 
	FIL_W.WORK_EFFORT_NAME4 AS "WORK_EFFORT_NAME4", 
	FIL_W.SEQUENCE_NUM4 AS "SEQUENCE_NUM4", 
	FIL_W.DESCRIPTION4 AS "DESCRIPTION4", 
	FIL_W.ASSOC_WEIGHT4 AS "ASSOC_WEIGHT4", 
	FIL_W.SOURCE_REFERENCE_ID4 AS "SOURCE_REFERENCE_ID4",	
	
	SC.PARENT_ROLE_CODE AS "SC_PARENT_ROLE_CODE", 
	ST.PARTY_NAME@langLocale AS "ST_PARTY_NAME",
	
	NDR.NOTE_INFO@langLocale AS "OB3_NOTE_INFO", 
	NDR.NOTE_NAME@langLocale AS "OB3_NOTE_NAME",
	
	-- INDICATORI
	INDIC.ACCOUNT_NAME AS "ACCOUNT_NAME", 
	INDIC.UOM_DESCR AS "UOM_DESCR"
		
FROM WORK_EFFORT RAD		

INNER JOIN WORK_EFFORT_TYPE RADT ON RADT.WORK_EFFORT_TYPE_ID = RAD.WORK_EFFORT_TYPE_ID
INNER JOIN WORK_EFFORT_TYPE_CONTENT RADTC ON RADTC.WORK_EFFORT_TYPE_ID = RAD.WORK_EFFORT_TYPE_ID
	AND RADTC.CONTENT_ID = @reportContentId

-- area																									
INNER JOIN WORK_EFFORT_ASSOC OB1A ON OB1A.WORK_EFFORT_ID_FROM = RAD.WORK_EFFORT_ID																											
	AND OB1A.WORK_EFFORT_ASSOC_TYPE_ID = RADT.HIERARCHY_ASSOC_TYPE_ID																										
INNER JOIN WORK_EFFORT OB1 ON OB1.WORK_EFFORT_ID = OB1A.WORK_EFFORT_ID_TO
	AND (@excludeValidity  = 'Y' OR (@excludeValidity  = 'N' AND OB1.ESTIMATED_START_DATE <= @date3112 AND OB1.ESTIMATED_COMPLETION_DATE >= @date0101))
	AND OB1.WORK_EFFORT_REVISION_ID IS NULL	
INNER JOIN WORK_EFFORT_TYPE OB1T ON OB1T.WORK_EFFORT_TYPE_ID = OB1.WORK_EFFORT_TYPE_ID		

-- sottoarea
INNER JOIN WORK_EFFORT_ASSOC OB2A ON OB2A.WORK_EFFORT_ID_FROM = OB1.WORK_EFFORT_ID																											
	AND OB2A.WORK_EFFORT_ASSOC_TYPE_ID = OB1T.WORK_EFFORT_ASSOC_TYPE_ID
INNER JOIN WORK_EFFORT OB2 ON OB2.WORK_EFFORT_ID = OB2A.WORK_EFFORT_ID_TO
	AND (@excludeValidity  = 'Y' OR (@excludeValidity  = 'N' AND OB2.ESTIMATED_START_DATE <= @date3112 AND OB2.ESTIMATED_COMPLETION_DATE >= @date0101))	
	AND OB2.WORK_EFFORT_REVISION_ID IS NULL																											
INNER JOIN WORK_EFFORT_TYPE OB2T ON OB2T.WORK_EFFORT_TYPE_ID = OB2.WORK_EFFORT_TYPE_ID

-- processo																										
INNER JOIN WORK_EFFORT_ASSOC OB3A ON OB3A.WORK_EFFORT_ID_FROM = OB2.WORK_EFFORT_ID																											
	AND OB3A.WORK_EFFORT_ASSOC_TYPE_ID = OB2T.WORK_EFFORT_ASSOC_TYPE_ID	
INNER JOIN WORK_EFFORT OB3 ON OB3.WORK_EFFORT_ID = OB3A.WORK_EFFORT_ID_TO
	AND (@excludeValidity = 'Y' OR (@excludeValidity  = 'N' AND OB3.ESTIMATED_START_DATE <= @date3112 AND OB3.ESTIMATED_COMPLETION_DATE >= @date0101))
	AND OB3.WORK_EFFORT_REVISION_ID IS NULL																												
INNER JOIN WORK_EFFORT_TYPE OB3T ON OB3T.WORK_EFFORT_TYPE_ID = OB3.WORK_EFFORT_TYPE_ID																										

INNER JOIN PARTY ST ON  ST.PARTY_ID = OB3.ORG_UNIT_ID 
INNER JOIN PARTY_PARENT_ROLE SC ON SC.PARTY_ID = ST.PARTY_ID  AND SC.ROLE_TYPE_ID = 'ORGANIZATION_UNIT'


-- rischi
LEFT OUTER JOIN (
	SELECT FIL_WA.WORK_EFFORT_ID_FROM, FIL_W.*,
		FIL_W.WORK_EFFORT_ID AS WORK_EFFORT_ID4,
		FIL_W.ETCH AS ETCH4,
		FIL_WA.SEQUENCE_NUM AS SEQUENCE_NUM4,
		FIL_WA.ASSOC_WEIGHT AS ASSOC_WEIGHT4, 
		FIL_W.SOURCE_REFERENCE_ID AS SOURCE_REFERENCE_ID4,
		
		FIL_W.WORK_EFFORT_NAME@langLocale AS WORK_EFFORT_NAME4, 
		FIL_WT.ETCH@langLocale AS ETCH_TYPE4, 
		FIL_W.DESCRIPTION@langLocale AS DESCRIPTION4
		
	FROM WORK_EFFORT_ASSOC FIL_WA																																																		
	INNER JOIN WORK_EFFORT FIL_W ON FIL_W.WORK_EFFORT_ID = FIL_WA.WORK_EFFORT_ID_TO
		AND (@excludeValidity  = 'Y' OR (@excludeValidity  = 'N' AND FIL_W.ESTIMATED_START_DATE <= @date3112 AND FIL_W.ESTIMATED_COMPLETION_DATE >= @date0101))																											
	INNER JOIN WORK_EFFORT_TYPE FIL_WT ON FIL_WT.WORK_EFFORT_TYPE_ID = FIL_W.WORK_EFFORT_TYPE_ID	
	WHERE FIL_WA.WORK_EFFORT_ASSOC_TYPE_ID <> 'ROOT'
		AND FIL_W.WORK_EFFORT_REVISION_ID IS NULL -- STORICIZZAZIONE
		
) FIL_W ON FIL_W.WORK_EFFORT_ID_FROM = OB3.WORK_EFFORT_ID	


-- VADO A PRENDERE GLI INDICATORI
LEFT OUTER JOIN (
	SELECT WI.WORK_EFFORT_ID, AC.ACCOUNT_NAME@langLocale AS ACCOUNT_NAME, WI.UOM_DESCR@langLocale AS UOM_DESCR
	FROM  WORK_EFFORT_MEASURE WI 	
	INNER JOIN GL_ACCOUNT AC ON AC.GL_ACCOUNT_ID = WI.GL_ACCOUNT_ID
	INNER JOIN UOM UOM ON AC.DEFAULT_UOM_ID = UOM.UOM_ID
	INNER JOIN WORK_EFFORT_PURPOSE_ACCOUNT WPA ON WPA.GL_ACCOUNT_ID = AC.GL_ACCOUNT_ID
		AND WPA.WORK_EFFORT_PURPOSE_TYPE_ID = 'CORFAT'
	INNER JOIN ACCTG_TRANS TP ON TP.VOUCHER_REF = WI.WORK_EFFORT_MEASURE_ID
	INNER JOIN ACCTG_TRANS_ENTRY EP ON EP.ACCTG_TRANS_ID = TP.ACCTG_TRANS_ID
		AND EP.GL_ACCOUNT_ID <> 'SCOREKPI'
		
	WHERE WI.WE_MEASURE_TYPE_ENUM_ID <> 'WEMT_SCORE'
		AND TP.VOUCHER_REF = WI.WORK_EFFORT_MEASURE_ID 
		AND TP.TRANSACTION_DATE = @date3112
		AND EP.AMOUNT = 100

) INDIC ON INDIC.WORK_EFFORT_ID = OB3.WORK_EFFORT_ID 

																						
-- BEGIN NOTA 
LEFT OUTER JOIN WORK_EFFORT_NOTE MN ON MN.WORK_EFFORT_ID = OB3.WORK_EFFORT_ID
	AND MN.SEQUENCE_ID = '2' 
LEFT OUTER JOIN NOTE_DATA NDR ON NDR.NOTE_ID = MN.NOTE_ID
   AND NDR.NOTE_DATE_TIME = @monitoringDate
-- END	

@filterInnerJoin
@filterLeftJoin
																											
WHERE 0=0
	 @workEffortIdChild
	 @workEffortId
	 @orgUnitId
	 @organizationId
	 AND RAD.WORK_EFFORT_REVISION_ID IS NULL	
	 @filterWhere
																						
ORDER BY OB1A.SEQUENCE_NUM, OB1.SOURCE_REFERENCE_ID, OB1.WORK_EFFORT_ID,
OB2A.SEQUENCE_NUM, OB2.SOURCE_REFERENCE_ID, OB2.WORK_EFFORT_ID,
OB3A.SEQUENCE_NUM, OB3.SOURCE_REFERENCE_ID, OB3.WORK_EFFORT_ID]]></xml-property>
