            <xml-property name="queryText"><![CDATA[SELECT  
	RADTC.ETCH@langLocale AS "RAD_TITOLO",
	
	OB1.WORK_EFFORT_ID AS "WORK_EFFORT_ID1",
	OB1.ETCH AS "ETCH1",
	OB1A.SEQUENCE_NUM AS "SEQUENCE_NUM1",
	OB1A.ASSOC_WEIGHT AS "ASSOC_WEIGHT1", 
	OB1.SOURCE_REFERENCE_ID AS "SOURCE_REFERENCE_ID1",
	  
	-- ELEMENTI DIFFERENTI X IL BILINGUISMO
	OB1T.ETCH@langLocale AS "ETCH_TYPE1", 
	OB1.WORK_EFFORT_NAME@langLocale AS "WORK_EFFORT_NAME1",
	OB1.DESCRIPTION@langLocale AS "DESCRIPTION1",
	      
	OB2.WORK_EFFORT_ID AS "WORK_EFFORT_ID2",
	OB2.ETCH AS "ETCH2",
	OB2A.SEQUENCE_NUM AS "SEQUENCE_NUM2",
	OB2A.ASSOC_WEIGHT AS "ASSOC_WEIGHT2", 
	OB2.SOURCE_REFERENCE_ID AS "SOURCE_REFERENCE_ID2",
	
	-- ELEMENTI DIFFERENTI X IL BILINGUISMO
	OB2T.ETCH@langLocale AS "ETCH_TYPE2", 
	OB2.WORK_EFFORT_NAME@langLocale AS "WORK_EFFORT_NAME2",
	OB2.DESCRIPTION@langLocale AS "DESCRIPTION2",  
	
	FIL_W.WORK_EFFORT_ID AS "WORK_EFFORT_ID3", 
	FIL_W.ETCH_TYPE3 AS "ETCH_TYPE3", 
	FIL_W.ETCH3 AS "ETCH3", 
	FIL_W.WORK_EFFORT_NAME3 AS "WORK_EFFORT_NAME3", 
	FIL_W.SEQUENCE_NUM3 AS "SEQUENCE_NUM3", 
	FIL_W.DESCRIPTION3 AS "DESCRIPTION3", 
	FIL_W.ASSOC_WEIGHT3 AS "ASSOC_WEIGHT3", 
	FIL_W.SOURCE_REFERENCE_ID3 AS "SOURCE_REFERENCE_ID3",
	
	SC.PARENT_ROLE_CODE AS "SC_PARENT_ROLE_CODE", 
	ST.PARTY_NAME@langLocale AS "ST_PARTY_NAME",
	NDR.OB3_NOTE_INFO AS "OB3_NOTE_INFO", 
	NDR.OB3_NOTE_NAME AS "OB3_NOTE_NAME"
		
FROM WORK_EFFORT RAD		

INNER JOIN WORK_EFFORT_TYPE RADT ON RADT.WORK_EFFORT_TYPE_ID = RAD.WORK_EFFORT_TYPE_ID
INNER JOIN WORK_EFFORT_TYPE_CONTENT RADTC ON RADTC.WORK_EFFORT_TYPE_ID = RAD.WORK_EFFORT_TYPE_ID
	AND RADTC.CONTENT_ID = @reportContentId

-- area																									
INNER JOIN WORK_EFFORT_ASSOC OB1A ON OB1A.WORK_EFFORT_ID_FROM = RAD.WORK_EFFORT_ID																											
	AND OB1A.WORK_EFFORT_ASSOC_TYPE_ID = RADT.HIERARCHY_ASSOC_TYPE_ID																										
INNER JOIN WORK_EFFORT OB1 ON OB1.WORK_EFFORT_ID = OB1A.WORK_EFFORT_ID_TO
	AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND OB1.ESTIMATED_START_DATE <= @date3112 AND OB1.ESTIMATED_COMPLETION_DATE >=  @date0101))	
	AND OB1.WORK_EFFORT_REVISION_ID IS NULL
INNER JOIN WORK_EFFORT_TYPE OB1T ON OB1T.WORK_EFFORT_TYPE_ID = OB1.WORK_EFFORT_TYPE_ID		

-- sottoarea
INNER JOIN WORK_EFFORT_ASSOC OB2A ON OB2A.WORK_EFFORT_ID_FROM = OB1.WORK_EFFORT_ID																											
	AND OB2A.WORK_EFFORT_ASSOC_TYPE_ID = OB1T.WORK_EFFORT_ASSOC_TYPE_ID
INNER JOIN WORK_EFFORT OB2 ON OB2.WORK_EFFORT_ID = OB2A.WORK_EFFORT_ID_TO
	AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND OB2.ESTIMATED_START_DATE <=  @date3112 AND OB2.ESTIMATED_COMPLETION_DATE >= @date0101))	
	AND OB2.WORK_EFFORT_REVISION_ID IS NULL																										
INNER JOIN WORK_EFFORT_TYPE OB2T ON OB2T.WORK_EFFORT_TYPE_ID = OB2.WORK_EFFORT_TYPE_ID

-- processo
LEFT OUTER JOIN (
	SELECT 
		OB3A.WORK_EFFORT_ID_FROM AS WORK_EFFORT_ID_FROM3, 
		OB3A.WORK_EFFORT_ASSOC_TYPE_ID AS OB3A_WORK_EFFORT_ASSOC_TYPE_ID,
		FIL_W.WORK_EFFORT_ID AS WORK_EFFORT_ID,
		FIL_W.ETCH AS ETCH3, 
		OB3A.SEQUENCE_NUM AS SEQUENCE_NUM3,
		OB3A.ASSOC_WEIGHT AS ASSOC_WEIGHT3, 
		FIL_W.SOURCE_REFERENCE_ID AS SOURCE_REFERENCE_ID3,
		FIL_W.ORG_UNIT_ID AS ORG_UNIT_ID,
		FIL_W.ORG_UNIT_ROLE_TYPE_ID AS ORG_UNIT_ROLE_TYPE_ID,
		FIL_W.ESTIMATED_START_DATE AS ESTIMATED_START_DATE,
		FIL_W.ESTIMATED_COMPLETION_DATE AS ESTIMATED_COMPLETION_DATE,
		FIL_W.ORGANIZATION_ID,
		FIL_W.WORK_EFFORT_TYPE_ID,
		-- ELEMENTI DIFFERENTI X IL BILINGUISMO
		OB3T.ETCH@langLocale AS ETCH_TYPE3,
		FIL_W.DESCRIPTION@langLocale AS DESCRIPTION3,
		FIL_W.WORK_EFFORT_NAME@langLocale AS WORK_EFFORT_NAME3
			
	FROM WORK_EFFORT_ASSOC OB3A																																																		
	INNER JOIN WORK_EFFORT FIL_W ON FIL_W.WORK_EFFORT_ID = OB3A.WORK_EFFORT_ID_TO
		AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND FIL_W.ESTIMATED_START_DATE <=  @date3112 AND FIL_W.ESTIMATED_COMPLETION_DATE >= @date0101))	
		AND FIL_W.WORK_EFFORT_REVISION_ID IS NULL																										
	INNER JOIN WORK_EFFORT_TYPE OB3T ON OB3T.WORK_EFFORT_TYPE_ID = FIL_W.WORK_EFFORT_TYPE_ID	
	
) FIL_W ON FIL_W.WORK_EFFORT_ID_FROM3 = OB2.WORK_EFFORT_ID	
	AND FIL_W.OB3A_WORK_EFFORT_ASSOC_TYPE_ID = OB2T.WORK_EFFORT_ASSOC_TYPE_ID	


LEFT OUTER JOIN PARTY ST ON  ST.PARTY_ID = FIL_W.ORG_UNIT_ID
LEFT OUTER JOIN PARTY_PARENT_ROLE SC ON SC.PARTY_ID = ST.PARTY_ID  AND SC.ROLE_TYPE_ID = 'ORGANIZATION_UNIT'
																					
-- BEGIN NOTA 
LEFT JOIN (
  SELECT ND.NOTE_ID, ND.NOTE_DATE_TIME, MN.WORK_EFFORT_ID,
  	--  ELEMENTI DIFFERENTI X IL BILINGUISMO
  	ND.NOTE_INFO@langLocale AS OB3_NOTE_INFO, 
	ND.NOTE_NAME@langLocale AS OB3_NOTE_NAME
	
  FROM WORK_EFFORT_NOTE MN
  INNER JOIN NOTE_DATA ND ON ND.NOTE_ID = MN.NOTE_ID
  WHERE MN.SEQUENCE_ID = '1'     
) NDR ON NDR.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
		AND NDR.NOTE_DATE_TIME = FIL_W.ESTIMATED_START_DATE
-- END	


@filterInnerJoin
@filterLeftJoin

																											
WHERE 0=0
	 @workEffortIdChild
	 @workEffortId
	 @orgUnitId
	 @organizationId
	 AND RAD.WORK_EFFORT_REVISION_ID IS NULL
	 @filterWhere
ORDER BY OB1A.SEQUENCE_NUM, OB1.SOURCE_REFERENCE_ID, OB1.WORK_EFFORT_ID,
OB2A.SEQUENCE_NUM, OB2.SOURCE_REFERENCE_ID, OB2.WORK_EFFORT_ID,
FIL_W.SEQUENCE_NUM3, FIL_W.SOURCE_REFERENCE_ID3, FIL_W.WORK_EFFORT_ID]]></xml-property>
