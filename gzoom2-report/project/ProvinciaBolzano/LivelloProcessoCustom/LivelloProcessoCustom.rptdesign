                                        <expression name="valueExpr">var titolo = reportContext.getMessage('HeaderIndiceRischio', reportContext.getLocale());&#13;
if (row["RAD_TITOLO"] != '' &amp;&amp; row["RAD_TITOLO"] != null ) {&#13;
	 titolo = row["RAD_TITOLO"];&#13;
}&#13;
&#13;
titolo +=  " " + (BirtDateTime.year(params["monitoringDate"].value))+" - "+(BirtDateTime.year(params["monitoringDate"].value)+2);</expression>
