SOSTOBS.ICO16_IT AS "ICONA_SOST_ITA_16",
SOSTOBS.ICO16_DE AS "ICONA_SOST_DE_16",
SOSTOBS.OB17 AS "OBIETTIVI_SOSTENIBILITA_17",
SOSTOBS.ICO17_IT AS "ICONA_SOST_ITA_17",
SOSTOBS.ICO17_DE AS "ICONA_SOST_DE_17"
FROM WORK_EFFORT FIL_W
JOIN(
	SELECT 
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.01' THEN SOST.WORK_EFFORT_NAME@langLocale ELSE NULL END) AS OB1,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.01' THEN ICO.ICON_ITA ELSE NULL END) AS ICO1_IT,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.01' THEN ICO.ICON_DE ELSE NULL END) AS ICO1_DE,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.02' THEN SOST.WORK_EFFORT_NAME@langLocale ELSE NULL END) AS OB2,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.02' THEN ICO.ICON_ITA ELSE NULL END) AS ICO2_IT,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.02' THEN ICO.ICON_DE ELSE NULL END) AS ICO2_DE,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.03' THEN SOST.WORK_EFFORT_NAME@langLocale ELSE NULL END) AS OB3,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.03' THEN ICO.ICON_ITA ELSE NULL END) AS ICO3_IT,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.03' THEN ICO.ICON_DE ELSE NULL END) AS ICO3_DE,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.04' THEN SOST.WORK_EFFORT_NAME@langLocale ELSE NULL END) AS OB4,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.04' THEN ICO.ICON_ITA ELSE NULL END) AS ICO4_IT,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.04' THEN ICO.ICON_DE ELSE NULL END) AS ICO4_DE,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.05' THEN SOST.WORK_EFFORT_NAME@langLocale ELSE NULL END) AS OB5,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.05' THEN ICO.ICON_ITA ELSE NULL END) AS ICO5_IT,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.05' THEN ICO.ICON_DE ELSE NULL END) AS ICO5_DE,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.06' THEN SOST.WORK_EFFORT_NAME@langLocale ELSE NULL END) AS OB6,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.06' THEN ICO.ICON_ITA ELSE NULL END) AS ICO6_IT,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.06' THEN ICO.ICON_DE ELSE NULL END) AS ICO6_DE,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.07' THEN SOST.WORK_EFFORT_NAME@langLocale ELSE NULL END) AS OB7,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.07' THEN ICO.ICON_ITA ELSE NULL END) AS ICO7_IT,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.07' THEN ICO.ICON_DE ELSE NULL END) AS ICO7_DE,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.08' THEN SOST.WORK_EFFORT_NAME@langLocale ELSE NULL END) AS OB8,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.08' THEN ICO.ICON_ITA ELSE NULL END) AS ICO8_IT,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.08' THEN ICO.ICON_DE ELSE NULL END) AS ICO8_DE,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.09' THEN SOST.WORK_EFFORT_NAME@langLocale ELSE NULL END) AS OB9,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.09' THEN ICO.ICON_ITA ELSE NULL END) AS ICO9_IT,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.09' THEN ICO.ICON_DE ELSE NULL END) AS ICO9_DE,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.10' THEN SOST.WORK_EFFORT_NAME@langLocale ELSE NULL END) AS OB10,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.10' THEN ICO.ICON_ITA ELSE NULL END) AS ICO10_IT,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.10' THEN ICO.ICON_DE ELSE NULL END) AS ICO10_DE,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.11' THEN SOST.WORK_EFFORT_NAME@langLocale ELSE NULL END) AS OB11,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.11' THEN ICO.ICON_ITA ELSE NULL END) AS ICO11_IT,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.11' THEN ICO.ICON_DE ELSE NULL END) AS ICO11_DE,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.12' THEN SOST.WORK_EFFORT_NAME@langLocale ELSE NULL END) AS OB12,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.12' THEN ICO.ICON_ITA ELSE NULL END) AS ICO12_IT,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.12' THEN ICO.ICON_DE ELSE NULL END) AS ICO12_DE,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.13' THEN SOST.WORK_EFFORT_NAME@langLocale ELSE NULL END) AS OB13,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.13' THEN ICO.ICON_ITA ELSE NULL END) AS ICO13_IT,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.13' THEN ICO.ICON_DE ELSE NULL END) AS ICO13_DE,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.14' THEN SOST.WORK_EFFORT_NAME@langLocale ELSE NULL END) AS OB14,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.14' THEN ICO.ICON_ITA ELSE NULL END) AS ICO14_IT,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.14' THEN ICO.ICON_DE ELSE NULL END) AS ICO14_DE,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.15' THEN SOST.WORK_EFFORT_NAME@langLocale ELSE NULL END) AS OB15,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.15' THEN ICO.ICON_ITA ELSE NULL END) AS ICO15_IT,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.15' THEN ICO.ICON_DE ELSE NULL END) AS ICO15_DE,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.16' THEN SOST.WORK_EFFORT_NAME@langLocale ELSE NULL END) AS OB16,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.16' THEN ICO.ICON_ITA ELSE NULL END) AS ICO16_IT,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.16' THEN ICO.ICON_DE ELSE NULL END) AS ICO16_DE,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.17' THEN SOST.WORK_EFFORT_NAME@langLocale ELSE NULL END) AS OB17,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.17' THEN ICO.ICON_ITA ELSE NULL END) AS ICO17_IT,
		MAX(CASE WHEN SOST.SOURCE_REFERENCE_ID = 'SDG.17' THEN ICO.ICON_DE ELSE NULL END) AS ICO17_DE,
		SOSTOBS.WORK_EFFORT_ID_TO
	FROM WORK_EFFORT_ASSOC SOSTOBS
	LEFT JOIN WORK_EFFORT SOST ON SOST.WORK_EFFORT_ID = SOSTOBS.WORK_EFFORT_ID_FROM AND SOST.WORK_EFFORT_TYPE_ID = '20R84' AND SOST.WORK_EFFORT_REVISION_ID IS NULL
		AND SOST.ESTIMATED_START_DATE <= @date3112 AND (SOST.ESTIMATED_COMPLETION_DATE >= @date0101 OR SOST.ESTIMATED_COMPLETION_DATE IS NULL)
	LEFT JOIN (
		SELECT WEC.WORK_EFFORT_ID, C.CONTENT_NAME, C.DESCRIPTION, DR.OBJECT_INFO,
		MAX(CASE WHEN WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_IT' THEN DR.OBJECT_INFO ELSE NULL END) AS ICON_ITA,
		MAX(CASE WHEN WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'ICON_DE' THEN DR.OBJECT_INFO ELSE NULL END) AS ICON_DE
		FROM WORK_EFFORT_CONTENT WEC
		JOIN CONTENT C ON C.CONTENT_ID = WEC.CONTENT_ID
		JOIN DATA_RESOURCE DR ON DR.DATA_RESOURCE_ID = C.DATA_RESOURCE_ID
		GROUP BY WEC.WORK_EFFORT_ID, C.CONTENT_NAME, C.DESCRIPTION, DR.OBJECT_INFO
	) ICO ON ICO.WORK_EFFORT_ID = SOST.WORK_EFFORT_ID
	
	WHERE SOSTOBS.WORK_EFFORT_ASSOC_TYPE_ID = '20R8C'
		AND SOSTOBS.FROM_DATE <= @date3112 AND (SOSTOBS.THRU_DATE IS NULL OR SOSTOBS.THRU_DATE >= @date0101)
	GROUP BY
		SOSTOBS.WORK_EFFORT_ID_TO
) SOSTOBS ON SOSTOBS.WORK_EFFORT_ID_TO = FIL_W.WORK_EFFORT_ID


WHERE 
  FIL_W.WORK_EFFORT_TYPE_ID = '20D64' AND 
  FIL_W.ESTIMATED_START_DATE <= @date3112 AND FIL_W.ESTIMATED_COMPLETION_DATE >= @date0101
   --AND (@orgUnitId IS NULL OR @orgUnitId = '' OR @orgUnitId = FIL_W.ORG_UNIT_ID)
   --@orgUnitId
   AND FIL_W.WORK_EFFORT_ID = ?
   
ORDER BY "CODICE_OBIETTIVO_STRATEGICO"]]></xml-property>
        </oda-data-set>
