        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="TemiDS" id="62163">
            <list-property name="columnHints"/>
            <list-property name="parameters">
                <structure>
                    <property name="name">repOrgUnitId</property>
                    <property name="nativeName"></property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">0</property>
                    <property name="position">1</property>
                    <expression name="defaultValue" type="constant">N/A</expression>
                    <property name="isOptional">false</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <structure name="cachedMetaData"/>
            <method name="beforeOpen"><![CDATA[/**/
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value );
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );	
this.queryText = this.queryText.replace("@langLocale",  params["langLocale"].value);


/* 
this.queryText = this.queryText.replace("@date0101",  "'2021-01-01 00:00:00.000'" );
this.queryText = this.queryText.replace("@date3112",  "'2021-06-30 00:00:00.000'" );
*/
//this.queryText = this.queryText.replace("@langLocale",  "_LANG");

/*
ReportLog.info("TemiDS : ");
ReportLog.info(this.queryText);
*/]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet"/>
            <xml-property name="queryText"><![CDATA[SELECT 
TEM_STRAT.WORK_EFFORT_NAME@langLocale AS "TEMA_OBIETTIVO_STRATEGICO", 
TEM_SVIL.SOURCE_REFERENCE_ID AS "CODICE_TEMA",
TEM_SVIL.WORK_EFFORT_NAME@langLocale AS "TEMA"
FROM WORK_EFFORT FIL_W 

LEFT JOIN WORK_EFFORT_ASSOC TEMOBS ON TEMOBS.WORK_EFFORT_ID_TO = FIL_W.WORK_EFFORT_ID AND TEMOBS.WORK_EFFORT_ASSOC_TYPE_ID = '20R4C'
AND TEMOBS.FROM_DATE <= @date3112 AND (TEMOBS.THRU_DATE IS NULL OR TEMOBS.THRU_DATE >= @date0101)
LEFT JOIN WORK_EFFORT TEM_STRAT ON TEMOBS.WORK_EFFORT_ID_FROM IS NOT NULL AND TEM_STRAT.WORK_EFFORT_ID = TEMOBS.WORK_EFFORT_ID_FROM

JOIN WORK_EFFORT_ASSOC WEATEM ON WEATEM.WORK_EFFORT_ID_TO = FIL_W.WORK_EFFORT_ID AND WEATEM.WORK_EFFORT_ASSOC_TYPE_ID = '20R4C'
JOIN WORK_EFFORT TEM_SVIL ON TEM_SVIL.WORK_EFFORT_ID = WEATEM.WORK_EFFORT_ID_FROM AND TEM_SVIL.WORK_EFFORT_TYPE_ID = '20R44'

WHERE 
FIL_W.ORG_UNIT_ID = ?

GROUP BY 
TEM_STRAT.WORK_EFFORT_NAME@langLocale, 
TEM_SVIL.SOURCE_REFERENCE_ID,
TEM_SVIL.WORK_EFFORT_NAME@langLocale]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="Uff_PrestazioniDS" id="62566">
            <property name="nullsOrdering">nulls lowest</property>
            <list-property name="computedColumns">
                <structure>
                    <property name="name">NOME_STRUTTURA_1_LIV</property>
                    <expression name="expression">row["NOME_STRUTTURA"] + " - " + row["UNITA_RESPONSABILE"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">ETICHETTA_TITOLO_PRESTAZIONE</property>
                    <expression name="expression">row["ETICHETTA_PRESTAZIONE"] + " - " + row["TITOLO_PRESTAZIONE"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">ETICHETTA_PRESTAZIONE_NUM</property>
                    <expression name="expression">importPackage(Packages.com.mapsengineering.base.birt.util);&#13;
&#13;
UtilStrings.convertStringToNumber(row["ETICHETTA_PRESTAZIONE"])</expression>
                    <property name="dataType">integer</property>
                </structure>
            </list-property>
            <list-property name="columnHints"/>
            <list-property name="parameters">
                <structure>
                    <property name="name">uffOrgUnitId</property>
                    <property name="nativeName"></property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">0</property>
                    <property name="position">1</property>
                    <expression name="defaultValue" type="constant">N/A</expression>
