            <method name="beforeOpen"><![CDATA[/**/
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value);
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value);	
this.queryText = this.queryText.replace("@langLocale",  params["langLocale"].value);

/*
this.queryText = this.queryText.replace("@date0101",  "'2020-01-01 00:00:00.000'" );
this.queryText = this.queryText.replace("@date3112",  "'2020-12-31 00:00:00.000'" );
this.queryText = this.queryText.replace("@langLocale", "_LANG");
*/

var depOrgUnitIdString = "";
var repOrgUnitIdString = "";
var uffOrgUnitIdString = "";


if (params["orgUnitId"].value != null &amp;&amp; params["orgUnitId"].value != '') {
	depOrgUnitIdString = " AND ('" + params["orgUnitId"].value + "' IS NULL OR '" + params["orgUnitId"].value + "' = '' OR '" + params["orgUnitId"].value + "' = FIL_W.ORG_UNIT_ID) ";
}
if (params["orgUnitId"].value != null &amp;&amp; params["orgUnitId"].value != '') {
	repOrgUnitIdString = " AND ('" + params["orgUnitId"].value + "' IS NULL OR '" + params["orgUnitId"].value + "' = '' OR '" + params["orgUnitId"].value + "' = PAPA.PARTY_ID OR '" + params["orgUnitId"].value  + "' = FIL_W.ORG_UNIT_ID)";
}
if (params["orgUnitId"].value != null &amp;&amp; params["orgUnitId"].value != '') {
	uffOrgUnitIdString = " AND ('" + params["orgUnitId"].value + "' IS NULL OR '" + params["orgUnitId"].value + "' = '' OR '" + params["orgUnitId"].value + "' = NONNO.PARTY_ID OR '" + params["orgUnitId"].value  + "' = FIL_W.ORG_UNIT_ID OR '" + params["orgUnitId"].value  + "' = PAPA.PARTY_ID)";
}


var filterInnerJoin = "";
var filterLeftJoin = "";
var filterWhere = "";

/**/
filter = new com.mapsengineering.base.birt.util.UtilFilter(params["userLoginId"].value, params["localDispatcherName"].value);
filterInnerJoin = filter.getWorkEffortFilterInner();
filterLeftJoin = filter.getWorkEffortFilterLeftJoin();
filterWhere = filter.getWorkEffortFilterWhere(); 


this.queryText = this.queryText.replace("@filterInnerJoin",  filterInnerJoin );
this.queryText = this.queryText.replace("@filterLeftJoin",  filterLeftJoin );
this.queryText = this.queryText.replace("@filterWhere",  filterWhere );


this.queryText = this.queryText.replace("@depOrgUnitId", depOrgUnitIdString);
this.queryText = this.queryText.replace("@repOrgUnitId", repOrgUnitIdString);
this.queryText = this.queryText.replace("@uffOrgUnitId", uffOrgUnitIdString);


//ReportLog.info("IstituzionaleDS:  "+this.queryText);]]></method>
