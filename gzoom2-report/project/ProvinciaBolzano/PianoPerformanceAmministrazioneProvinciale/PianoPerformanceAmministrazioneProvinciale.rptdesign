                    <property name="nativeName">PROCESSO_ANTICORRUZIONE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">14</property>
                    <property name="name">OBJECT_INFO</property>
                    <property name="nativeName">OBJECT_INFO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">15</property>
                    <property name="name">FLAG_PNRR</property>
                    <property name="nativeName">FLAG_PNRR</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">16</property>
                    <property name="name">FLAG_PNC</property>
                    <property name="nativeName">FLAG_PNC</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">17</property>
                    <property name="name">COUNT_PROCESSI_ANTICORRUZIONE</property>
                    <property name="nativeName">COUNT_PROCESSI_ANTICORRUZIONE</property>
                    <property name="dataType">decimal</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
	PRE.ORG_UNIT_ID,
	PRE.WORK_EFFORT_ID,
	PRE.ETCH AS "ETCH_PRESTAZIONE",
	PRE.WORK_EFFORT_NAME@langLocale AS "PRESTAZIONE",									
	PPR.PARENT_ROLE_CODE AS "CODICE_STRUTTURA",
	P.PARTY_NAME@langLocale AS "STRUTTURA",
	P.PARTY_NAME AS "NOME_STRUTTURA",
	P.PARTY_NAME@langLocale AS "UNITA_RESPONSABILE",
	OBS.WORK_EFFORT_NAME@langLocale AS "OBIETTIVO_STRATEGICO", 
	NOTE.FINALITA AS "FINALITA",
	NOTE.DESCRIZIONE AS "BREVE_DESCRIZIONE",
	NOTE.FONTE "FONTE_NORMATIVA",
	PROC.WORK_EFFORT_NAME@langLocale AS "PROCESSO_ANTICORRUZIONE",
	SOST.OBJECT_INFO,
	MAX(CASE WHEN INDFLAG.GL_ACCOUNT_ID = '11140' THEN INDFLAG.UOM_CODE@langLocale ELSE NULL END) AS "FLAG_PNRR",
	MAX(CASE WHEN INDFLAG.GL_ACCOUNT_ID = '11141' THEN INDFLAG.UOM_CODE@langLocale ELSE NULL END) AS "FLAG_PNC",
(	
SELECT
COUNT(PROCESSI.LISTAPROC) AS "CPA"
FROM WORK_EFFORT FIL_W
INNER JOIN(
	SELECT PROC.WORK_EFFORT_NAME@langLocale AS LISTAPROC,
	WEA.WORK_EFFORT_ID_TO
	FROM WORK_EFFORT_ASSOC WEA
	LEFT JOIN WORK_EFFORT PROC ON PROC.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_FROM AND PROC.WORK_EFFORT_TYPE_ID = '15AP2SAR' AND PROC.WORK_EFFORT_REVISION_ID IS NULL
		AND PROC.ESTIMATED_START_DATE <= @date3112 AND (PROC.ESTIMATED_COMPLETION_DATE >= @date0101 OR PROC.ESTIMATED_COMPLETION_DATE IS NULL)
	WHERE WEA.WORK_EFFORT_ASSOC_TYPE_ID = '15APSAR2'
	AND WEA.FROM_DATE <= @date3112 AND (WEA.THRU_DATE IS NULL OR WEA.THRU_DATE >= @date0101)
) PROCESSI ON PROCESSI.WORK_EFFORT_ID_TO = FIL_W.WORK_EFFORT_ID
WHERE 
  FIL_W.WORK_EFFORT_TYPE_ID = '20C42' AND 
  FIL_W.ESTIMATED_START_DATE <= @date3112 AND FIL_W.ESTIMATED_COMPLETION_DATE >= @date0101
  AND FIL_W.WORK_EFFORT_ID = PRE.WORK_EFFORT_ID 
) AS "COUNT_PROCESSI_ANTICORRUZIONE"

	
/* PRESTAZIONE */
FROM WORK_EFFORT PRE	

/* STRUTTURA RESPONSABILE */
JOIN PARTY P ON P.PARTY_ID = PRE.ORG_UNIT_ID
JOIN PARTY_PARENT_ROLE PPR ON PPR.PARTY_ID = P.PARTY_ID		

/* OBIETTIVO STRATEGICO */
LEFT JOIN WORK_EFFORT_ASSOC WEA ON WEA.WORK_EFFORT_ID_TO = PRE.WORK_EFFORT_ID AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '20D62C'
																						
LEFT JOIN WORK_EFFORT OBS ON OBS.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_FROM AND OBS.WORK_EFFORT_TYPE_ID = '20D62' AND OBS.WORK_EFFORT_REVISION_ID IS NULL
	AND OBS.ESTIMATED_START_DATE <= @date3112 AND (OBS.ESTIMATED_COMPLETION_DATE >= @date0101 OR OBS.ESTIMATED_COMPLETION_DATE IS NULL)	
	
/* PROCESSO ANTICORRUZIONE */
LEFT JOIN WORK_EFFORT_ASSOC WEA2 ON WEA2.WORK_EFFORT_ID_TO = PRE.WORK_EFFORT_ID AND WEA2.WORK_EFFORT_ASSOC_TYPE_ID = '15APSAR2'
LEFT JOIN WORK_EFFORT PROC ON PROC.WORK_EFFORT_ID = WEA2.WORK_EFFORT_ID_FROM AND PROC.WORK_EFFORT_TYPE_ID = '15AP2SAR' AND PROC.WORK_EFFORT_REVISION_ID IS NULL
	AND PROC.ESTIMATED_START_DATE <= @date3112 AND (PROC.ESTIMATED_COMPLETION_DATE >= @date0101 OR PROC.ESTIMATED_COMPLETION_DATE IS NULL)
	
/* OBIETTIVI DI SOSTENIBILITA' */
LEFT JOIN (
	SELECT 
		WEA.WORK_EFFORT_ID_TO,
		DR.OBJECT_INFO /* SONO LE ICONE DEGLI OBIETTIVI DI SOSTENIBILITA' */
	FROM WORK_EFFORT_ASSOC WEA
	JOIN WORK_EFFORT SOST ON SOST.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_FROM AND SOST.WORK_EFFORT_TYPE_ID = '' AND SOST.WORK_EFFORT_REVISION_ID IS NULL
		AND SOST.ESTIMATED_START_DATE <= @date3112 AND (SOST.ESTIMATED_COMPLETION_DATE >= @date0101 OR SOST.ESTIMATED_COMPLETION_DATE IS NULL)			
	JOIN WORK_EFFORT_CONTENT WEC ON WEC.WORK_EFFORT_ID = SOST.WORK_EFFORT_ID 
	JOIN CONTENT C ON C.CONTENT_ID = WEC.CONTENT_ID
	JOIN DATA_RESOURCE DR ON DR.DATA_RESOURCE_ID = C.DATA_RESOURCE_ID 
	WHERE WEA.WORK_EFFORT_ASSOC_TYPE_ID = '20R8C' 
) SOST ON SOST.WORK_EFFORT_ID_TO = PRE.WORK_EFFORT_ID 

/* NOTE PRESTAZIONE */
LEFT JOIN (
	SELECT 
		WEN.WORK_EFFORT_ID,
		MAX(CASE WHEN WEN.SEQUENCE_ID = '10' THEN TO_CHAR(ND.NOTE_INFO@langLocale) ELSE NULL END) AS "FINALITA",
		MAX(CASE WHEN WEN.SEQUENCE_ID = '15' THEN TO_CHAR(ND.NOTE_INFO@langLocale) ELSE NULL END) AS "DESCRIZIONE",
		MAX(CASE WHEN WEN.SEQUENCE_ID = '20' THEN TO_CHAR(ND.NOTE_INFO@langLocale) ELSE NULL END) AS "FONTE"
	FROM WORK_EFFORT_NOTE WEN 
	JOIN NOTE_DATA ND ON ND.NOTE_ID = WEN.NOTE_ID	   
	GROUP BY WEN.WORK_EFFORT_ID 							 
) NOTE ON NOTE.WORK_EFFORT_ID = PRE.WORK_EFFORT_ID

/* FLAG CARATTERISTICHE  */
LEFT JOIN (
	SELECT
	--	RS.UOM_CODE,
		RS.UOM_CODE@langLocale,
		WEM.WORK_EFFORT_ID,
		WEM.GL_ACCOUNT_ID
	FROM WORK_EFFORT_MEASURE WEM 
	INNER JOIN ACCTG_TRANS_ENTRY ATE ON ATE.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID
	INNER JOIN WORK_EFFORT_MEAS_RAT_SC RS ON RS.WORK_EFFORT_MEASURE_ID = WEM.WORK_EFFORT_MEASURE_ID
		AND RS.UOM_ID = ATE.CURRENCY_UOM_ID AND RS.UOM_RATING_VALUE = ATE.AMOUNT
) INDFLAG ON INDFLAG.WORK_EFFORT_ID = PRE.WORK_EFFORT_ID

WHERE PRE.WORK_EFFORT_TYPE_ID = '20C42' AND PRE.WORK_EFFORT_REVISION_ID IS NULL
	AND PRE.ESTIMATED_START_DATE <= @date3112 AND (PRE.ESTIMATED_COMPLETION_DATE >= @date0101 OR PRE.ESTIMATED_COMPLETION_DATE IS NULL)
	AND PRE.ORG_UNIT_ID = ?
			  
																				
GROUP BY 
	PRE.ORG_UNIT_ID,
	PRE.WORK_EFFORT_ID,
	PRE.ETCH ,
	PRE.WORK_EFFORT_NAME@langLocale,									
	PPR.PARENT_ROLE_CODE,
	P.PARTY_NAME@langLocale,
	P.PARTY_NAME,
	P.PARTY_NAME@langLocale,
	OBS.WORK_EFFORT_NAME@langLocale, 
	NOTE.FINALITA,
	NOTE.DESCRIZIONE,
	NOTE.FONTE,
	PROC.WORK_EFFORT_NAME@langLocale,
	SOST.OBJECT_INFO]]></xml-property>
        </oda-data-set>
