                    <property name="name">workEffortId</property>
                    <property name="nativeName"></property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">0</property>
                    <property name="position">1</property>
                    <expression name="defaultValue" type="constant">N/A</expression>
                    <property name="isOptional">false</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">WORK_EFFORT_ID</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">Tipo indicatore</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">Denominazione indicatore</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">4</property>
                        <property name="name">UDM - Einheit</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">5</property>
                        <property name="name">Valutazione - Bewertung</property>
                        <property name="dataType">decimal</property>
                    </structure>
                    <structure>
                        <property name="position">6</property>
                        <property name="name">Commento</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <method name="beforeOpen"><![CDATA[/**/this.queryText = this.queryText.replace("@langLocale",  params["langLocale"].value);
this.queryText = this.queryText.replace("@year", "'" + BirtDateTime.year(params["customTimePeriod"].value) + "'");


/*
this.queryText = this.queryText.replace("@langLocale", "");
this.queryText = this.queryText.replace("@year", "'2021'");*/


/*ReportLog.info("ObiettiviTrasversaliDS :");
ReportLog.info(this.queryText);*/]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">WORK_EFFORT_ID</property>
                    <property name="nativeName">WORK_EFFORT_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">Tipo indicatore</property>
                    <property name="nativeName">Tipo indicatore</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">Denominazione indicatore</property>
                    <property name="nativeName">Denominazione indicatore</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">UDM - Einheit</property>
                    <property name="nativeName">UDM - Einheit</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">Valutazione - Bewertung</property>
                    <property name="nativeName">Valutazione - Bewertung</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">Commento</property>
                    <property name="nativeName">Commento</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
		WEM.WORK_EFFORT_ID,
		GL.ACCOUNT_NAME@langLocale "Tipo indicatore",
		WEM.UOM_DESCR@langLocale "Denominazione indicatore",
		U.ABBREVIATION@langLocale "UDM - Einheit",
		ATE.AMOUNT "Valutazione - Bewertung",
		ACT.DESCRIPTION@langLocale "Commento"
	FROM WORK_EFFORT_MEASURE WEM
	JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID
	JOIN WORK_EFFORT_PURPOSE_ACCOUNT WEPA ON WEPA.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID AND WEPA.WORK_EFFORT_PURPOSE_TYPE_ID IN ('VDIPRE')
	JOIN UOM U ON U.UOM_ID = GL.DEFAULT_UOM_ID
	LEFT JOIN ACCTG_TRANS_ENTRY ATE ON ATE.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID
	LEFT JOIN ACCTG_TRANS ACT ON ACT.ACCTG_TRANS_ID = ATE.ACCTG_TRANS_ID AND EXTRACT(YEAR FROM ACT.TRANSACTION_DATE) = @year
	WHERE WEM.WORK_EFFORT_ID = ?
	AND ((GL.ACCOUNT_NAME_LANG = 'Prestazione' OR GL.ACCOUNT_NAME_LANG = 'Obiettivo operativo') OR (GL.ACCOUNT_NAME = 'Leistung' OR GL.ACCOUNT_NAME = 'Operatives Jahresziel'))
	AND WEM.COMMENTS IS NOT NULL
--	AND ATE.AMOUNT IS NOT NULL
ORDER BY WEM.UOM_DESCR@langLocale
]]></xml-property>
        </oda-data-set>
