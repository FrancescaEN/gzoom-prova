            <method name="beforeOpen"><![CDATA[/**/
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value);
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value);	
this.queryText = this.queryText.replace("@langLocale",  params["langLocale"].value);
this.queryText = this.queryText.replace("@year", "'" + BirtDateTime.year(params["customTimePeriod"].value) + "'");


/*
this.queryText = this.queryText.replace("@date0101",  "TO_DATE('2021-01-01','YYYY-MM-DD')");
this.queryText = this.queryText.replace("@date3112",  "TO_DATE('2021-12-31','YYYY-MM-DD')");
this.queryText = this.queryText.replace("@langLocale", "");
this.queryText = this.queryText.replace("@year", "'2021'");
*/

var orgUnitIdString = "";
if (params["orgUnitId"].value != null &amp;&amp; params["orgUnitId"].value != '') {
	orgUnitIdString = " AND ('" + params["orgUnitId"].value + "' IS NULL OR '" + params["orgUnitId"].value + "' = '' OR '" + params["orgUnitId"].value + "' = FIL_W.ORG_UNIT_ID) ";
}
this.queryText = this.queryText.replace("@orgUnitId", orgUnitIdString);

var personIdString = "";

if (params["personId"].value != null &amp;&amp; params["personId"].value != '') {
	//personIdString = "AND ( EXISTS (SELECT 1 from USER_LOGIN_SECURITY_GROUP ULSG INNER JOIN SECURITY_GROUP_PERMISSION SP ON SP.GROUP_ID = ULSG.GROUP_ID AND SP.PERMISSION_ID = 'DIRIGPERFMGR_ADMIN' WHERE ULSG.USER_LOGIN_ID = '" + params["personId"].value + "') OR EXISTS (SELECT 1 from USER_LOGIN_SECURITY_GROUP ULSG INNER JOIN SECURITY_GROUP_PERMISSION SP ON SP.GROUP_ID = ULSG.GROUP_ID AND SP.PERMISSION_ID = 'DIRIGPERFORG_ADMIN' INNER JOIN USER_LOGIN UL ON UL.USER_LOGIN_ID = ULSG.USER_LOGIN_ID INNER JOIN PARTY_RELATIONSHIP PRO ON PRO.PARTY_ID_TO = UL.PARTY_ID AND PRO.PARTY_ID_FROM = FIL_W.ORG_UNIT_ID AND PRO.PARTY_RELATIONSHIP_TYPE_ID IN ('ORG_RESPONSIBLE', 'ORG_DELEGATE') AND (PRO.THRU_DATE IS NULL OR PRO.THRU_DATE >= TO_DATE(concat('01/01/', substr('2021', -4, 4)), 'DD/MM/YYYY')) WHERE ULSG.USER_LOGIN_ID = '" + params["personId"].value + "'))";
	personIdString=" AND sogg.PARTY_ID = '" + params["personId"].value + "'";
}
this.queryText = this.queryText.replace("@personId", personIdString);

var workEffortIdString = "";

if (params["workEffortId"].value != null &amp;&amp; params["workEffortId"].value != '') {
	workEffortIdString = " AND FIL_W.work_effort_id = '" + params["workEffortId"].value + "'";
}
this.queryText = this.queryText.replace("@workEffortId", workEffortIdString);


//GESTIRE PERMESSI

/**/
filter = new com.mapsengineering.base.birt.util.UtilFilter(params["userLoginId"].value, params["localDispatcherName"].value);
var filterInnerJoin = filter.getWorkEffortFilterInner();
var filterLeftJoin = filter.getWorkEffortFilterLeftJoin();
var filterWhere = filter.getWorkEffortFilterWhere(); 


/*
var filterInnerJoin = "";
var filterLeftJoin = "";
var filterWhere = "";
*/
 
this.queryText = this.queryText.replace("@filterInnerJoin",  filterInnerJoin );
this.queryText = this.queryText.replace("@filterLeftJoin",  filterLeftJoin );
this.queryText = this.queryText.replace("@filterWhere",  filterWhere );
 


//ReportLog.info("MainDS :");
//ReportLog.info(this.queryText);
]]></method>
