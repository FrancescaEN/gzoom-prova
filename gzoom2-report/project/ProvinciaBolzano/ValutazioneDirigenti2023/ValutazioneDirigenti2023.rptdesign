            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
	sogg.PARTY_NAME AS "Valutato",
	P.PARTY_NAME@langLocale AS "Struttura",
	@year AS "Anno - Jahr",
	FIL_W.WORK_EFFORT_NAME@langLocale AS "Denominazione",
	RESP.PARTY_NAME AS "Valutatore",
	TO_CHAR(FIL_W.ESTIMATED_START_DATE, 'DD/MM/YYYY') AS "Data inizio",
	TO_CHAR(FIL_W.ESTIMATED_COMPLETION_DATE, 'DD/MM/YYYY') AS "Data fine",
	CONCAT(PPR.PARENT_ROLE_CODE, CONCAT(' - ', P.PARTY_NAME@langLocale)) AS "Unità Responsabile",
	INDIC.NOME1 AS "Nome indicatore 1",
	INDIC.IND1 AS "Indicatore 1",
	INDIC.COMM1 AS "Commento 1",
	INDIC.NOME2 AS "Nome indicatore 2",
	INDIC.IND2 AS "Indicatore 2",
	INDIC.COMM2 AS "Commento 2",
	INDIC.NOME3 AS "Nome indicatore 3",
	INDIC.IND3 AS "Indicatore 3",
	INDIC.COMM3 AS "Commento 3",
	INDIC.NOME4 AS "Nome indicatore 4",
	INDIC.IND4 AS "Indicatore 4",
	INDIC.COMM4 AS "Commento 4",
	INDIC.NOME5 AS "Nome indicatore 5",
	INDIC.IND5 AS "Indicatore 5",
	INDIC.COMM5 AS "Commento 5",
	STATO.DATA AS "Data compilazione",
	FIL_W.WORK_EFFORT_ID 
/* SCHEDA VALUTAZIONE INDIVIDUALE */
FROM WORK_EFFORT FIL_W
JOIN PARTY P ON P.PARTY_ID = FIL_W.ORG_UNIT_ID
JOIN PARTY_PARENT_ROLE PPR ON PPR.PARTY_ID = P.PARTY_ID
/*VALUTATO */
JOIN WORK_EFFORT_PARTY_ASSIGNMENT wepa2 ON wepa2.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID 
JOIN PARTY sogg ON sogg.PARTY_ID = WEPA2.PARTY_ID @personId
/* DATA DI COMPILAZIONE */
LEFT JOIN (
	SELECT WES.WORK_EFFORT_ID, MAX(TO_CHAR(WES.STATUS_DATETIME, 'DD/MM/YYYY')) AS DATA
	FROM WORK_EFFORT_STATUS WES
	WHERE WES.STATUS_ID = 'BZVDI_EXEC_APP'
	GROUP BY WES.WORK_EFFORT_ID 
) STATO ON STATO.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
/* VALUTATORE */
LEFT JOIN (
	SELECT PRST.PARTY_ID_TO, P.PARTY_NAME, PRPER.THRU_DATE, PRPER.FROM_DATE
	FROM PARTY_RELATIONSHIP PRST
	JOIN PARTY_RELATIONSHIP PRPER ON PRPER.PARTY_ID_FROM = PRST.PARTY_ID_FROM AND PRPER.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
	JOIN PARTY P ON P.PARTY_ID = PRPER.PARTY_ID_TO 
	WHERE PRST.PARTY_RELATIONSHIP_TYPE_ID = 'GROUP_ROLLUP' AND PRST.THRU_DATE IS NULL
) RESP ON RESP.PARTY_ID_TO = FIL_W.ORG_UNIT_ID AND (RESP.FROM_DATE <= FIL_W.ESTIMATED_COMPLETION_DATE AND (RESP.THRU_DATE IS NULL OR RESP.THRU_DATE >= FIL_W.ESTIMATED_COMPLETION_DATE))
/* INDICATORI */
LEFT JOIN (
	SELECT
		WEM.WORK_EFFORT_ID,
		MAX(CASE WHEN WEM.GL_ACCOUNT_ID = '11088' THEN GL.ACCOUNT_NAME@langLocale ELSE NULL END) AS NOME1,
		MAX(CASE WHEN WEM.GL_ACCOUNT_ID = '11830' THEN GL.ACCOUNT_NAME@langLocale ELSE NULL END) AS NOME2,
		MAX(CASE WHEN WEM.GL_ACCOUNT_ID = '11831' THEN GL.ACCOUNT_NAME@langLocale ELSE NULL END) AS NOME3,
		MAX(CASE WHEN WEM.GL_ACCOUNT_ID = '11832' THEN GL.ACCOUNT_NAME@langLocale ELSE NULL END) AS NOME4,
		MAX(CASE WHEN WEM.GL_ACCOUNT_ID = '11090' THEN GL.ACCOUNT_NAME@langLocale ELSE NULL END) AS NOME5,
		MAX(CASE WHEN WEM.GL_ACCOUNT_ID = '11088' THEN GAMRS.UOM_DESCR@langLocale ELSE NULL END) AS IND1,
		MAX(CASE WHEN WEM.GL_ACCOUNT_ID = '11830' THEN GAMRS.UOM_DESCR@langLocale ELSE NULL END) AS IND2,
		MAX(CASE WHEN WEM.GL_ACCOUNT_ID = '11831' THEN GAMRS.UOM_DESCR@langLocale ELSE NULL END) AS IND3,
		MAX(CASE WHEN WEM.GL_ACCOUNT_ID = '11832' THEN GAMRS.UOM_DESCR@langLocale ELSE NULL END) AS IND4,
		MAX(CASE WHEN WEM.GL_ACCOUNT_ID = '11090' THEN GAMRS.UOM_DESCR@langLocale ELSE NULL END) AS IND5,
		MAX(CASE WHEN WEM.GL_ACCOUNT_ID = '11088' THEN ACT.DESCRIPTION@langLocale ELSE NULL END) AS COMM1,
		MAX(CASE WHEN WEM.GL_ACCOUNT_ID = '11830' THEN ACT.DESCRIPTION@langLocale ELSE NULL END) AS COMM2,
		MAX(CASE WHEN WEM.GL_ACCOUNT_ID = '11831' THEN ACT.DESCRIPTION@langLocale ELSE NULL END) AS COMM3,
		MAX(CASE WHEN WEM.GL_ACCOUNT_ID = '11832' THEN ACT.DESCRIPTION@langLocale ELSE NULL END) AS COMM4,
		MAX(CASE WHEN WEM.GL_ACCOUNT_ID = '11090' THEN ACT.DESCRIPTION@langLocale ELSE NULL END) AS COMM5
	FROM WORK_EFFORT_MEASURE WEM
	JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID
	JOIN WORK_EFFORT_PURPOSE_ACCOUNT WEPA ON WEPA.GL_ACCOUNT_ID = GL.GL_ACCOUNT_ID AND WEPA.WORK_EFFORT_PURPOSE_TYPE_ID = 'VDICOM'
	JOIN UOM U ON U.UOM_ID = GL.DEFAULT_UOM_ID
	LEFT JOIN ACCTG_TRANS ACT ON ACT.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID AND EXTRACT(YEAR FROM ACT.TRANSACTION_DATE) = @year
	LEFT JOIN ACCTG_TRANS_ENTRY ATE ON ATE.ACCTG_TRANS_ID = ACT.ACCTG_TRANS_ID AND ATE.GL_ACCOUNT_ID NOT LIKE 'SCORE%'
	LEFT JOIN GL_ACCOUNT_MEAS_RAT_SC GAMRS ON GAMRS.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID
		AND GAMRS.UOM_RATING_VALUE = ATE.AMOUNT
	GROUP BY
		WEM.WORK_EFFORT_ID
) INDIC ON INDIC.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
@filterInnerJoin
@filterLeftJoin
WHERE FIL_W.WORK_EFFORT_TYPE_ID = '21VDI' AND FIL_W.WORK_EFFORT_REVISION_ID IS NULL
	AND FIL_W.ESTIMATED_START_DATE <= @date3112 AND (FIL_W.ESTIMATED_COMPLETION_DATE >= @date0101 OR FIL_W.ESTIMATED_COMPLETION_DATE IS NULL)
	@orgUnitId
	@workEffortId
  	@filterWhere
ORDER BY
	FIL_W.SOURCE_REFERENCE_ID]]></xml-property>
        </oda-data-set>
