	<subDataset name="DatasetObiettiviStruttura" uuid="7185cb3a-eacf-417c-a4d2-e6b0254575cf">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.jrdax"/>
		<parameter name="idScheda" class="java.lang.String"/>
		<parameter name="langLocale" class="java.lang.String">
			<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
		</parameter>
		<queryString language="SQL">
			<![CDATA[select EMPL_OBSTR.*, 
EMPL_OBSTR.ID_SCHEDA AS OBSTR_ID_SCHEDA, 
EMPL_OBSTR.NOME_OBIETTIVO$P!{langLocale} AS OBSTR_NOME_OBIETTIVO,
EMPL_OBSTR.PESO_OBIETTIVO AS OBSTR_PESO_OBIETTIVO,
EMPL_OBSTR.PUNTEGGIO AS OBSTR_PUNTEGGIO
from EMPL_OBSTRUTT_VIEW EMPL_OBSTR
where ID_SCHEDA = $P{idScheda}]]>
		</queryString>
		<field name="ID_SCHEDA" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="ID_SCHEDA"/>
			<property name="com.jaspersoft.studio.field.label" value="ID_SCHEDA"/>
		</field>
		<field name="NOME_OBIETTIVO" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="NOME_OBIETTIVO"/>
			<property name="com.jaspersoft.studio.field.label" value="NOME_OBIETTIVO"/>
		</field>
		<field name="NOME_OBIETTIVO_LANG" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="NOME_OBIETTIVO_LANG"/>
			<property name="com.jaspersoft.studio.field.label" value="NOME_OBIETTIVO_LANG"/>
		</field>
		<field name="PESO_OBIETTIVO" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="PESO_OBIETTIVO"/>
			<property name="com.jaspersoft.studio.field.label" value="PESO_OBIETTIVO"/>
		</field>
		<field name="DATA_VALORE" class="java.sql.Timestamp">
			<property name="com.jaspersoft.studio.field.name" value="DATA_VALORE"/>
			<property name="com.jaspersoft.studio.field.label" value="DATA_VALORE"/>
		</field>
		<field name="PUNTEGGIO" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="PUNTEGGIO"/>
			<property name="com.jaspersoft.studio.field.label" value="PUNTEGGIO"/>
		</field>
		<field name="OBSTR_ID_SCHEDA" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="OBSTR_ID_SCHEDA"/>
			<property name="com.jaspersoft.studio.field.label" value="OBSTR_ID_SCHEDA"/>
		</field>
		<field name="OBSTR_NOME_OBIETTIVO" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="OBSTR_NOME_OBIETTIVO"/>
			<property name="com.jaspersoft.studio.field.label" value="OBSTR_NOME_OBIETTIVO"/>
		</field>
		<field name="OBSTR_PESO_OBIETTIVO" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="OBSTR_PESO_OBIETTIVO"/>
			<property name="com.jaspersoft.studio.field.label" value="OBSTR_PESO_OBIETTIVO"/>
		</field>
		<field name="OBSTR_PUNTEGGIO" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="OBSTR_PUNTEGGIO"/>
			<property name="com.jaspersoft.studio.field.label" value="OBSTR_PUNTEGGIO"/>
		</field>
		<variable name="SommaRisultatoPesatoObStrutt" class="java.lang.Double" calculation="Sum">
			<variableExpression><![CDATA[($F{PUNTEGGIO}*$F{PESO_OBIETTIVO})/100]]></variableExpression>
		</variable>
	</subDataset>
	<subDataset name="DatasetObiettiviIndividuali" uuid="89021e09-74a6-4636-b33e-78ccf6641e91">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.jrdax"/>
		<parameter name="idScheda" class="java.lang.String"/>
		<parameter name="langLocale" class="java.lang.String">
			<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
		</parameter>
		<queryString language="SQL">
			<![CDATA[select EMPL_OBIND.*, 
EMPL_OBIND.ID_OBIND AS ID_OBIND,
EMPL_OBIND.ID_SCHEDA AS OBIND_ID_SCHEDA, 
EMPL_OBIND.NOME_OBIETTIVO$P!{langLocale} AS OBIND_NOME_OBIETTIVO,
EMPL_OBIND.PESO_OBIETTIVO AS OBIND_PESO_OBIETTIVO,
EMPL_OBIND.PUNTEGGIO AS OBIND_PUNTEGGIO,
