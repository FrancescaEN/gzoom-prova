		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select EMPL.*, 
EMPL.NOME_STRUTTURA$P!{langLocale} as nomeStruttura, 
EMPL.NOTA_VALUTATORE$P!{langLocale} as notaValutatore,
EMPL.NOTA_VALUTATO$P!{langLocale} as notaValutato,
EMPL.NOTA_VALUTATORE_NAME$P!{langLocale},
EMPL.NOTA_VALUTATO_NAME$P!{langLocale},
to_char(EMPL.DATA_INIZIO, 'DD/MM/YYYY') as dataInizioFormattata,
to_char(EMPL.DATA_FINE, 'DD/MM/YYYY') as DataFineFormattata

from EMPL_SCH_VIEW EMPL
inner join work_effort FIL_W on FIL_W.work_effort_id = EMPL.ID_SCHEDA
/* START filterInnerJoin */
   $P!{filterInnerJoinString} 
/* END filterInnerJoin */
/* START filterLeftJoin */
  $P!{filterLeftJoinString} 
/* END filterLeftJoin */
where FIL_W.work_effort_type_id = '18DSL0DIP' and FIL_W.work_effort_revision_id is null
AND EXTRACT(YEAR FROM EMPL.DATA_INIZIO) = EXTRACT(YEAR FROM TO_DATE('$P!{customTimePeriod}','YYYY-MM-DD'))
  /* START filterWhere */
 $P!{filterWhereString} 
   /* END filterWhere */  
$P!{orgUnitIdString}
$P!{personIdString}
 order by EMPL.COGNOME_VALUTATO]]>
	</queryString>
	<field name="ID_SCHEDA" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="ID_SCHEDA"/>
		<property name="com.jaspersoft.studio.field.label" value="ID_SCHEDA"/>
	</field>
	<field name="CODICE_SCHEDA" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="CODICE_SCHEDA"/>
