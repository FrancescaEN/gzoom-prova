            <xml-property name="queryText"><![CDATA[SELECT
  w.work_effort_id as "WORK_EFFORT_ID",
  w.data_stampa as "DATA_STAMPA",
  w.intestazione_1 as "INTESTAZIONE_1",
  w.intestazione_2 as "INTESTAZIONE_2",
  w.intestazione_3 as "INTESTAZIONE_3",
  w.nominativo as "NOMINATIVO",
  w.incarico as "INCARICO",
  w.anno_riferimento as "ANNO_RIFERIMENTO",
  w.valutazione_conclusiva as "VALUTAZIONE_CONCLUSIVA",
  w.osservazioni_dipendente as "OSSERVAZIONI_DIPENDENTE",
  w.valutatore as "VALUTATORE"
from rep_19dirig w
where w.data_stampa = ?
@workEffortId]]></xml-property>
