            <method name="beforeOpen"><![CDATA[
//this.queryText = this.queryText.replace("@monitoringDate",  "AND W.DATA_STAMPA = '2019-31-12'" );
var monitoringDateStr = "AND W.DATA_STAMPA = " +params["monitoringDateSql"].value;
this.queryText = this.queryText.replace("@monitoringDate",  monitoringDateStr);

var workEffortIdStr = "";
if (params["workEffortId"].value != null &amp;&amp; params["workEffortId"].value != "") {
    workEffortIdStr = "AND W.WORK_EFFORT_ID = '" +params["workEffortId"].value + "'";
}
this.queryText = this.queryText.replace("@workEffortId", workEffortIdStr);

var currentStatusIdStr = "";
if (params["currentStatusId"].value != null &amp;&amp; params["currentStatusId"].value != "") {
    currentStatusIdStr = "AND W.CURRENT_STATUS_ID = '" + params["currentStatusId"].value + "'";
}
this.queryText = this.queryText.replace("@currentStatusId", currentStatusIdStr);

var orgUnitIdStr = "";
if (params["orgUnitId"].value != null &amp;&amp; params["orgUnitId"].value != "") {
    orgUnitIdStr = "AND W.ORG_UNIT_ID = '" + params["orgUnitId"].value + "'";
}
this.queryText = this.queryText.replace("@orgUnitId", orgUnitIdStr);

 
//Debug.log("quey = " + this.queryText);
]]></method>
