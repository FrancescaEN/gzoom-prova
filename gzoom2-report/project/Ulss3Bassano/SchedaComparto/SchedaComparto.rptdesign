            <xml-property name="queryText"><![CDATA[SELECT
  w.work_effort_id as "WORK_EFFORT_ID",
  w.data_stampa as "DATA_STAMPA",
  w.tipo_scheda as "TIPO_SCHEDA",
  w.anno as "ANNO",
  w.org_unit_id as "ORG_UNIT_ID",
  w.current_status_id as "CURRENT_STATUS_ID",
  w.valutato as "VALUTATO",
  w.matr_valutato as "MATR_VALUTATO",
  w.profilo as "PROFILO",
  w.struttura as "STRUTTURA",
  w.valutatore as "VALUTATORE",
  w.matr_valutatore as "MATR_VALUTATORE",
  w.coordinatore as "COORDINATORE",
  w.matr_coordinatore as "MATR_COORDINATORE",
  w.valutazione_conclusiva as "VALUTAZIONE_CONCLUSIVA",
  w.motivazione_valutazione_negativa as "MOTIVAZIONE_VALUTAZIONE_NEGATIVA",
  w.osservazioni_valutato as "OSSERVAZIONI_VALUTATO"
from rep_19comp w
where 0 = 0
@monitoringDate
@workEffortId
@currentStatusId
@orgUnitId]]></xml-property>
