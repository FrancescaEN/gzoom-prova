            <xml-property name="queryText"><![CDATA[SELECT
  A.SEQUENCE_NUM AS "SEQUENCE_NUM",
  W.SOURCE_REFERENCE_ID AS "SOURCE_REFERENCE_ID",
  W.ETCH AS "ETCH",
  W.WORK_EFFORT_ID AS "WORK_EFFORT_ID",
  W.WORK_EFFORT_NAME AS "WORK_EFFORT_NAME",
  WM.WORK_EFFORT_MEASURE_ID AS "WORK_EFFORT_MEASURE_ID",
  WM.GL_ACCOUNT_ID AS "GL_ACCOUNT_ID",
  GL.ACCOUNT_NAME AS "ACCOUNT_NAME",
  GL.ACCOUNT_CODE AS "ACCOUNT_CODE",
  A.ASSOC_WEIGHT AS "ASSOC_WEIGHT",
  U.ABBREVIATION AS "ABBREVIATION",
  GL.INPUT_ENUM_ID AS "INPUT_ENUM_ID",
  WM.UOM_DESCR AS "UOM_DESCR",
  U.UOM_TYPE_ID AS "UOM_TYPE_ID",
  U.DECIMAL_SCALE AS "DECIMAL_SCALE",
  W.ESTIMATED_COMPLETION_DATE AS "ESTIMATED_COMPLETION_DATE",
  CAP_FILA_P.PARTY_NAME AS "PARTY_NAME",
MAX(CASE WHEN AT.GL_FISCAL_TYPE_ID = 'ACTUAL' AND GL.GL_ACCOUNT_ID <> 'SCORE' AND AT.TRANSACTION_DATE = @monitoringDate THEN AE.AMOUNT ELSE NULL END) AS "ACTUAL_AMOUNT",
MAX(CASE WHEN AT.GL_FISCAL_TYPE_ID = 'BUDGET' AND GL.GL_ACCOUNT_ID <> 'SCORE' AND AT.TRANSACTION_DATE = @monitoringDate THEN AE.AMOUNT ELSE NULL END) AS "BUDGET_AMOUNT",

MAX(CASE WHEN AT.GL_FISCAL_TYPE_ID = 'ACTUAL' AND GL.GL_ACCOUNT_ID <> 'SCORE' AND AT.TRANSACTION_DATE = @monitoringDate THEN AE.DESCRIPTION ELSE NULL END) AS "ACTUAL_DESCR1",
MAX(CASE WHEN AT.GL_FISCAL_TYPE_ID = 'ACTUAL' AND GL.GL_ACCOUNT_ID <> 'SCORE' AND AT.TRANSACTION_DATE = @monitoringDate THEN AT.DESCRIPTION ELSE NULL END) AS "ACTUAL_DESCR2",

MAX(CASE WHEN AT.GL_FISCAL_TYPE_ID = 'BUDGET' AND GL.GL_ACCOUNT_ID <> 'SCORE' AND AT.TRANSACTION_DATE = @monitoringDate THEN AE.DESCRIPTION ELSE NULL END) AS "BUDGET_DESCR1",
MAX(CASE WHEN AT.GL_FISCAL_TYPE_ID = 'BUDGET' AND GL.GL_ACCOUNT_ID <> 'SCORE' AND AT.TRANSACTION_DATE = @monitoringDate THEN AT.DESCRIPTION ELSE NULL END) AS "BUDGET_DESCR2",

MAX(CASE WHEN AT.GL_FISCAL_TYPE_ID = 'ACTUAL' AND AE.GL_ACCOUNT_ID <> 'SCORE' AND AT.TRANSACTION_DATE = @monitoringDate THEN O.UOM_CODE ELSE NULL END) AS "ACTUAL_COD",
MAX(CASE WHEN AT.GL_FISCAL_TYPE_ID = 'BUDGET' AND AE.GL_ACCOUNT_ID <> 'SCORE' AND AT.TRANSACTION_DATE = @monitoringDate THEN O.UOM_CODE ELSE NULL END) AS "BUDGET_COD"
FROM WORK_EFFORT_ASSOC A
INNER JOIN WORK_EFFORT W ON W.WORK_EFFORT_ID = A.WORK_EFFORT_ID_TO
INNER JOIN WORK_EFFORT_MEASURE WM ON WM.WORK_EFFORT_ID = W.WORK_EFFORT_ID
LEFT OUTER JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = WM.GL_ACCOUNT_ID AND GL.GL_ACCOUNT_ID <> 'SCORE'
LEFT OUTER JOIN ACCTG_TRANS AT ON ((GL.INPUT_ENUM_ID = 'ACCINP_OBJ' AND AT.VOUCHER_REF = WM.WORK_EFFORT_MEASURE_ID) OR (GL.INPUT_ENUM_ID <> 'ACCINP_OBJ' AND AT.PARTY_ID = W.ORG_UNIT_ID))
LEFT OUTER JOIN ACCTG_TRANS_ENTRY AE ON AT.ACCTG_TRANS_ID = AE.ACCTG_TRANS_ID AND AE.GL_ACCOUNT_ID = WM.GL_ACCOUNT_ID
LEFT OUTER JOIN UOM U ON U.UOM_ID = GL.DEFAULT_UOM_ID
LEFT OUTER JOIN WORK_EFFORT_MEAS_RAT_SC O ON O.WORK_EFFORT_MEASURE_ID = WM.WORK_EFFORT_MEASURE_ID
   AND O.UOM_ID = U. UOM_ID AND O.UOM_RATING_VALUE = AE.AMOUNT
LEFT OUTER JOIN WORK_EFFORT_PARTY_ASSIGNMENT CAP_FILA ON CAP_FILA.WORK_EFFORT_ID = w.WORK_EFFORT_ID
  AND CAP_FILA.ROLE_TYPE_ID = 'WEM_CAPOFILA'
  AND CAP_FILA.FROM_DATE <= @monitoringDate
  AND CAP_FILA.THRU_DATE >= @monitoringDate
LEFT OUTER JOIN PARTY CAP_FILA_P ON CAP_FILA_P.PARTY_ID = CAP_FILA.PARTY_ID
WHERE A.WORK_EFFORT_ID_FROM = ?
AND GL.GL_ACCOUNT_ID <> 'SCORE'
AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND ( A.FROM_DATE <= @monitoringDate AND (A.THRU_DATE IS NULL OR A.THRU_DATE >= @monitoringDate) )))
AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND ( WM.FROM_DATE <= @monitoringDate AND (WM.THRU_DATE IS NULL OR WM.THRU_DATE >= @monitoringDate) )))
GROUP BY
  A.SEQUENCE_NUM,
  W.SOURCE_REFERENCE_ID,
  W.ETCH,
  W.WORK_EFFORT_ID,
  W.WORK_EFFORT_NAME,
  WM.WORK_EFFORT_MEASURE_ID,
  WM.GL_ACCOUNT_ID,
  GL.ACCOUNT_NAME,
  GL.ACCOUNT_CODE,
  A.ASSOC_WEIGHT,
  U.ABBREVIATION,
  GL.INPUT_ENUM_ID,
  WM.UOM_DESCR,
  U.UOM_TYPE_ID,
  U.DECIMAL_SCALE,
  W.ESTIMATED_COMPLETION_DATE,
  CAP_FILA_P.PARTY_NAME
 ORDER BY W.ETCH]]></xml-property>
