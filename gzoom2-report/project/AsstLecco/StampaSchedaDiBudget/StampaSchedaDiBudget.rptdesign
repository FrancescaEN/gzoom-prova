                                                <header>
                                                    <row id="58205">
                                                        <property name="pageBreakAfter">auto</property>
                                                        <list-property name="visibility">
                                                            <structure>
                                                                <property name="format">all</property>
                                                                <expression name="valueExpr" type="javascript">// GN-5330&#13;
// Cella trasparente (bianca) se punteggio non pesato = 100 (&#13;
// dato non stampato ma presente nella uery  SCORE dell'indicatore )&#13;
&#13;
var pesoObiettivoPercentualeAtteso = row["KPI_SCORE_WEIGHT"];&#13;
var consuntivo = row["AMOUNT1"];&#13;
var pesoObiettivoPercentualeEffettivo = pesoObiettivoPercentualeAtteso != null &amp;&amp; pesoObiettivoPercentualeAtteso > 0? consuntivo * pesoObiettivoPercentualeAtteso/100 : consuntivo;&#13;
&#13;
var nascosto = consuntivo != null &amp;&amp; pesoObiettivoPercentualeEffettivo != pesoObiettivoPercentualeAtteso;&#13;
&#13;
var debugEnabled = false; // metti a true per vedere il log&#13;
if (!nascosto &amp;&amp; debugEnabled)&#13;
 	java.lang.System.out.println("[BIRT::StampaSchedaDiBudget.rptdesign] atteso = " + pesoObiettivoPercentualeAtteso&#13;
 		+ ", effettivo (assoluto) = " + consuntivo&#13;
 		+ ", effettivo = " + pesoObiettivoPercentualeEffettivo&#13;
		+ " --> (trasparente)"&#13;
		);&#13;
	&#13;
&#13;
// Return "nascosto"&#13;
nascosto;</expression>
                                                            </structure>
                                                        </list-property>
                                                        <cell id="58206">
                                                            <property name="verticalAlign">middle</property>
                                                        </cell>
