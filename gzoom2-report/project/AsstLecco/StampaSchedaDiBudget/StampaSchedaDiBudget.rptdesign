            <method name="beforeOpen"><![CDATA[this.queryText = this.queryText.replace("@excludeValidity", "'" + params["excludeValidity"].value+ "'");
this.queryText = this.queryText.replace("@monitoringDate",params["monitoringDateSql"].value);
//this.queryText = this.queryText.replace("@monitoringDate", "''");

var workEffortIdStr = "";
if (params["workEffortId"].value != null &amp;&amp; params["workEffortId"].value != "" &amp;&amp; 
(params["workEffortIdChild"].value == null || params["workEffortIdChild"].value == "")) {
    workEffortIdStr = "AND RAD.WORK_EFFORT_ID = '" + params["workEffortId"].value + "'";
}
this.queryText = this.queryText.replace("@workEffortId", workEffortIdStr);

var workEffortIdChildStr = "";
if (params["workEffortIdChild"].value != null &amp;&amp; params["workEffortIdChild"].value != "") {
    workEffortIdChildStr = "AND A1.WORK_EFFORT_ID = '" + params["workEffortIdChild"].value + "'";
}
this.queryText = this.queryText.replace("@workEffortChild", workEffortIdChildStr);

var orgUnitIdStr = "";
if (params["orgUnitId"].value != null &amp;&amp; params["orgUnitId"].value != "") {
    orgUnitIdStr = "AND A1.ORG_UNIT_ID = '" + params["orgUnitId"].value + "'";
}
this.queryText = this.queryText.replace("@orgUnitId", orgUnitIdStr);

var workEffortTpeIdRefStr = "";
if (params["workEffortTypeIdParametric"].value != null &amp;&amp; params["workEffortTypeIdParametric"].value != "") {
    workEffortTpeIdRefStr = "AND (RAD.WORK_EFFORT_TYPE_ID = '" + params["workEffortTypeIdParametric"].value + "'" +
    " OR A0.WORK_EFFORT_TYPE_ID = '" + params["workEffortTypeIdParametric"].value + "'" +
    " OR A1.WORK_EFFORT_TYPE_ID = '" + params["workEffortTypeIdParametric"].value + "'" +
    " OR FIL_W.WORK_EFFORT_TYPE_ID = '" + params["workEffortTypeIdParametric"].value + "')";
}
this.queryText = this.queryText.replace("@workEffortTypeIdRef", workEffortTpeIdRefStr);


ReportLog.info("... this.queryText IndexDS: "+this.queryText);
ReportLog.info("... this.queryText PARAMS: "+this.getInputParameters());]]></method>
