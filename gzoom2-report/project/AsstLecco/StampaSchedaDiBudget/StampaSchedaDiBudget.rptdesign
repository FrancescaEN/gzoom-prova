            <list-property name="computedColumns">
                <structure>
                    <property name="name">INDICATORE</property>
                    <expression name="expression">if(row["INPUT_ENUM_ID"] == "ACCINP_UO"){&#13;
	 row["ACCOUNT_NAME"]&#13;
} else if(row["INPUT_ENUM_ID"] == "ACCINP_PRD"){&#13;
	 (row["UOM_DESCR"] != null &amp;&amp; row["UOM_DESCR"] != "" ? row["UOM_DESCR"]  :  row["ACCOUNT_NAME"])&#13;
} else if(row["INPUT_ENUM_ID"] == "ACCINP_OBJ"){&#13;
	(row["UOM_DESCR"] != null &amp;&amp; row["UOM_DESCR"] != "" ? row["UOM_DESCR"]  : row["ACCOUNT_NAME"])&#13;
} else {&#13;
	row["ACCOUNT_NAME"]&#13;
}</expression>
                    <property name="dataType">string</property>
