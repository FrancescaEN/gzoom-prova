            <xml-property name="queryText"><![CDATA[SELECT 
	   (SELECT PN1.group_name 
FROM PARTY_NAME_HISTORY PN1
WHERE  EXISTS
(SELECT PARTY_ID , CHANGE_DATE FROM 
(SELECT PARTY_ID , MIN(Change_date) CHANGE_DATE FROM PARTY_NAME_HISTORY PN3 where PN3.change_date >=  @monitoringDate   -- data di lacio stampa
GROUP BY PARTY_ID )  PN2
WHERE PN2.PARTY_ID    = PN1.PARTY_ID 
AND   PN2.CHANGE_DATE = PN1.CHANGE_DATE)
AND  PN1.PARTY_ID = A1.ORG_UNIT_ID) as "UO_HIST_DESC",
 (SELECT PN1.group_name 
FROM PARTY_NAME_HISTORY PN1
WHERE  EXISTS
(SELECT PARTY_ID , CHANGE_DATE FROM 
(SELECT PARTY_ID , MIN(Change_date) CHANGE_DATE FROM PARTY_NAME_HISTORY PN3 where PN3.change_date >=  @monitoringDate   -- data di lacio stampa
GROUP BY PARTY_ID )  PN2
WHERE PN2.PARTY_ID    = PN1.PARTY_ID 
AND   PN2.CHANGE_DATE = PN1.CHANGE_DATE)
AND  PN1.PARTY_ID = PP1.PARTY_ID) as "HIST_ORG_UNIT_NAME",
(select party_name from party where party_id = A1.ORG_UNIT_ID) AS "UO_DESC",
	   RAD.WORK_EFFORT_NAME AS "TITLE", RAD.ETCH AS "ETCH", RAD.WORK_EFFORT_ID AS "ID_RAD", RADTC.ETCH AS "RAD_TITOLO",
	   B0.ETCH AS "ETICHETTA0", A0.ETCH AS "ETCH0", A0.WORK_EFFORT_NAME AS "NAME0", Z0.SEQUENCE_NUM AS "SEQ0", A0.WORK_EFFORT_ID AS "ID0", A0.DESCRIPTION AS "DESCRIPTION0", Z0.ASSOC_WEIGHT AS "ASSOC_WEIGHT0", A0.SOURCE_REFERENCE_ID AS "CODE0",
	   B1.ETCH AS "ETICHETTA1", A1.ETCH AS "ETCH1", A1.WORK_EFFORT_NAME AS "NAME1", Z1.SEQUENCE_NUM AS "SEQ1", A1.WORK_EFFORT_ID AS "ID1", A1.DESCRIPTION AS "DESCRIPTION1", Z1.ASSOC_WEIGHT AS "ASSOC_WEIGHT1", A1.SOURCE_REFERENCE_ID AS "CODE1", A1.WORK_EFFORT_TYPE_ID AS "TYPE_ID1",              
       B2.ETCH AS "ETICHETTA2", FIL_W.ETCH AS "ETCH2", FIL_W.WORK_EFFORT_NAME AS "NAME2", Z2.SEQUENCE_NUM AS "SEQ2", FIL_W.WORK_EFFORT_ID AS "ID2", FIL_W.DESCRIPTION AS "DESCRIPTION2", Z2.ASSOC_WEIGHT AS "ASSOC_WEIGHT2", FIL_W.SOURCE_REFERENCE_ID AS "CODE2",
       PP1.PARTY_ID AS "ID_ORG_UNIT", PP1.PARENT_ROLE_CODE AS "ORG_UNIT_CODE", PP1.PARTY_NAME AS "ORG_UNIT_NAME", PP2.PARTY_NAME AS "RESP_NAME", PR1.PRIORITY_TYPE_ID AS "PRIORITY_TYPE_ID"      
FROM WORK_EFFORT RAD
	 INNER JOIN WORK_EFFORT_TYPE RAT ON RAT.WORK_EFFORT_TYPE_ID = RAD.WORK_EFFORT_TYPE_ID	
	 INNER JOIN WORK_EFFORT_TYPE_CONTENT RADTC ON RADTC.WORK_EFFORT_TYPE_ID = RAD.WORK_EFFORT_TYPE_ID
		AND RADTC.CONTENT_ID = ?
	
	 -- unita organizzativa
	 INNER JOIN WORK_EFFORT_ASSOC Z0 ON Z0.WORK_EFFORT_ID_FROM = RAD.WORK_EFFORT_ID
	 	AND Z0.WORK_EFFORT_ASSOC_TYPE_ID = RAT.HIERARCHY_ASSOC_TYPE_ID
	 	AND ( @excludeValidity = 'Y' OR  (@excludeValidity = 'N' AND ( Z0.FROM_DATE <= @monitoringDate AND (Z0.THRU_DATE >= @monitoringDate OR Z0.THRU_DATE IS NULL ))))	 			
     INNER JOIN WORK_EFFORT A0 ON A0.WORK_EFFORT_ID = Z0.WORK_EFFORT_ID_TO
     INNER JOIN WORK_EFFORT_ASSOC_TYPE D0 ON D0.WORK_EFFORT_ASSOC_TYPE_ID = Z0.WORK_EFFORT_ASSOC_TYPE_ID     
     INNER JOIN WORK_EFFORT_TYPE B0 ON B0.WORK_EFFORT_TYPE_ID = A0.WORK_EFFORT_TYPE_ID 
     
	 -- scheda budget
     INNER JOIN WORK_EFFORT_ASSOC Z1 ON Z1.WORK_EFFORT_ID_FROM = A0.WORK_EFFORT_ID
        AND Z1.WORK_EFFORT_ASSOC_TYPE_ID = '19ORGC'
    	AND ( @excludeValidity = 'Y' OR  (@excludeValidity = 'N' AND ( Z1.FROM_DATE <= @monitoringDate AND (Z1.THRU_DATE >= @monitoringDate OR Z1.THRU_DATE IS NULL ))))
     INNER JOIN WORK_EFFORT A1 ON A1.WORK_EFFORT_ID = Z1.WORK_EFFORT_ID_TO
     INNER JOIN WORK_EFFORT_ASSOC_TYPE D1 ON D1.WORK_EFFORT_ASSOC_TYPE_ID = Z1.WORK_EFFORT_ASSOC_TYPE_ID     
     INNER JOIN WORK_EFFORT_TYPE B1 ON B1.WORK_EFFORT_TYPE_ID = A1.WORK_EFFORT_TYPE_ID     	
     
      -- macroarea
     INNER JOIN WORK_EFFORT_ASSOC Z2 ON Z2.WORK_EFFORT_ID_FROM = A1.WORK_EFFORT_ID
        AND (Z2.WORK_EFFORT_ASSOC_TYPE_ID = '19OBD' OR Z2.WORK_EFFORT_ASSOC_TYPE_ID = '19OAS' OR Z2.WORK_EFFORT_ASSOC_TYPE_ID = '19OSR')
    	AND ( @excludeValidity = 'Y' OR  (@excludeValidity = 'N' AND ( Z2.FROM_DATE <= @monitoringDate AND (Z2.THRU_DATE >= @monitoringDate OR Z2.THRU_DATE IS NULL ))))
     INNER JOIN WORK_EFFORT FIL_W ON FIL_W.WORK_EFFORT_ID = Z2.WORK_EFFORT_ID_TO
     INNER JOIN WORK_EFFORT_ASSOC_TYPE D2 ON D2.WORK_EFFORT_ASSOC_TYPE_ID = Z2.WORK_EFFORT_ASSOC_TYPE_ID     
     INNER JOIN WORK_EFFORT_TYPE B2 ON B2.WORK_EFFORT_TYPE_ID = FIL_W.WORK_EFFORT_TYPE_ID 
     
     INNER JOIN PARTY_RELATIONSHIP PR1 ON PR1.PARTY_ID_TO = A1.ORG_UNIT_ID
        AND PR1.PARTY_RELATIONSHIP_TYPE_ID = 'GROUP_ROLLUP'
        AND PR1.FROM_DATE <= @monitoringDate AND (PR1.THRU_DATE IS NULL OR PR1.THRU_DATE >= @monitoringDate)
     INNER JOIN PARTY_ROLE_VIEW PP1 ON PP1.PARTY_ID = PR1.PARTY_ID_FROM
      AND PP1.PARENT_ROLE_TYPE_ID  = 'ORGANIZATION_UNIT'
     LEFT OUTER JOIN PARTY_RELATIONSHIP PR2 ON PR2.PARTY_ID_FROM = A1.ORG_UNIT_ID
        AND PR2.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
        AND PR2.FROM_DATE <= @monitoringDate AND (PR2.THRU_DATE IS NULL OR PR2.THRU_DATE >= @monitoringDate)
     LEFT OUTER JOIN PARTY_ROLE_VIEW PP2 ON PP2.PARTY_ID = PR2.PARTY_ID_TO
        AND PP2.ROLE_TYPE_ID = PR2.ROLE_TYPE_ID_TO
        AND PP2.PARENT_ROLE_TYPE_ID = 'EMPLOYEE'
         
     	 	         
WHERE 0=0
    
  -- valorizzati solo se esistenti

  AND RAD.WORK_EFFORT_REVISION_ID IS NULL
  AND A0.WORK_EFFORT_REVISION_ID IS NULL
  AND A1.WORK_EFFORT_REVISION_ID IS NULL
  AND FIL_W.WORK_EFFORT_REVISION_ID IS NULL  
  
   -- valorizzati solo se esistenti
   @workEffortId
   @workEffortChild
   @orgUnitId
   @workEffortTypeIdRef
]]></xml-property>
