                                                                <expression name="valueExpr">var v = row["KPI_SCORE_WEIGHT"] != null &amp;&amp; row["KPI_SCORE_WEIGHT"] > 0? row["AMOUNT1"] * row["KPI_SCORE_WEIGHT"]/100 : row["AMOUNT1"] ;&#13;
Formatter.format(v, "###,###.#")</expression>
