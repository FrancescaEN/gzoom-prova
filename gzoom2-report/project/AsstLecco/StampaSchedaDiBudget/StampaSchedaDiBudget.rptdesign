                                                    <property name="verticalAlign">bottom</property>
                                                </cell>
                                                <cell id="58612">
                                                    <property name="textAlign">right</property>
                                                    <property name="verticalAlign">bottom</property>
                                                    <label id="58613">
                                                        <property name="fontSize">6pt</property>
                                                        <property name="display">inline</property>
                                                        <text-property name="text" key="FirmaDirettoreSocioSanitario"></text-property>
                                                    </label>
                                                    <text id="58614">
                                                        <property name="fontSize">6pt</property>
                                                        <property name="display">inline</property>
                                                        <property name="contentType">auto</property>
                                                        <text-property name="content"><![CDATA[:]]></text-property>
                                                    </text>
                                                </cell>
                                                <cell id="58615">
                                                    <property name="borderBottomColor">#000000</property>
                                                    <property name="borderBottomStyle">solid</property>
                                                    <property name="borderBottomWidth">thin</property>
                                                    <property name="verticalAlign">bottom</property>
                                                </cell>
                                            </row>
                                        </grid>
                                    </cell>
                                </row>
                                <row id="58616">
                                    <property name="pageBreakBefore">avoid</property>
                                    <list-property name="visibility">
                                        <structure>
                                            <property name="format">all</property>
                                            <expression name="valueExpr" type="javascript">row["PRIORITY_TYPE_ID"] != null &amp;&amp; row["PRIORITY_TYPE_ID"] != ''</expression>
                                        </structure>
                                    </list-property>
                                    <cell id="58617">
                                        <property name="colSpan">2</property>
                                        <property name="rowSpan">1</property>
                                        <label id="58620">
                                            <property name="fontSize">6pt</property>
                                            <text-property name="text" key="FirmaMancante"></text-property>
                                        </label>
                                    </cell>
                                </row>
                            </header>
                        </group>
                    </table>
                </cell>
            </row>
        </grid>
    </body>
    <property name="pageVariables">
        <variable-element name="NpageNumber">
            <property name="type">page</property>
        </variable-element>
        <variable-element name="NpageIndexRoman">
            <property name="type">page</property>
        </variable-element>
        <variable-element name="NumberPageEmpty">
            <property name="type">report</property>
        </variable-element>
    </property>
</report>
