            <xml-property name="queryText"><![CDATA[SELECT
  W.SOURCE_REFERENCE_ID AS "SOURCE_REFERENCE_ID",
  A.SEQUENCE_NUM AS "SEQUENCE_NUM",
  W.ETCH AS "ETCH",
  W.WORK_EFFORT_ID AS "WORK_EFFORT_ID",
  W.WORK_EFFORT_NAME AS "WORK_EFFORT_NAME",
  W1.WORK_EFFORT_NAME AS "NAME_FROM",
  W1.WORK_EFFORT_ID AS "WORK_EFFORT_ID_FROM",
  W1.SOURCE_REFERENCE_ID AS "SOURCE_REFERENCE_ID_FROM",
  WM.WORK_EFFORT_MEASURE_ID AS "WORK_EFFORT_MEASURE_ID",
  WM.GL_ACCOUNT_ID AS "GL_ACCOUNT_ID",
  GL.ACCOUNT_NAME AS "ACCOUNT_NAME",
  GL.ACCOUNT_CODE AS "ACCOUNT_CODE",
  WM.KPI_SCORE_WEIGHT AS "KPI_SCORE_WEIGHT",
  U.ABBREVIATION AS "ABBREVIATION",
  GL.INPUT_ENUM_ID AS "INPUT_ENUM_ID",
  WM.UOM_DESCR AS "UOM_DESCR",
  U.UOM_TYPE_ID AS "UOM_TYPE_ID",
  U.DECIMAL_SCALE AS "DECIMAL_SCALE",
  W.ESTIMATED_COMPLETION_DATE AS "ESTIMATED_COMPLETION_DATE",
  P.EXTERNAL_ID AS "EXTERNAL_ID",
  PNH.SUFFIX AS "SIGLA_CAPO_FILA_HIST",
MAX(AE.AMOUNT) AS "AMOUNT1",
MAX(CASE WHEN AT2.GL_FISCAL_TYPE_ID = 'ACTUAL' AND AE2.GL_ACCOUNT_ID <> 'SCORE' AND AT2.TRANSACTION_DATE = @monitoringDate THEN AE2.DESCRIPTION ELSE NULL END) AS "ACTUAL_DESCR1",
MAX(CASE WHEN AT2.GL_FISCAL_TYPE_ID = 'BUDGET' AND AE2.GL_ACCOUNT_ID <> 'SCORE' AND AT2.TRANSACTION_DATE = @monitoringDate THEN AE2.DESCRIPTION ELSE NULL END) AS "BUDGET_DESCR1",
MAX(CASE WHEN AT2.GL_FISCAL_TYPE_ID = 'ACTUAL' AND AE2.GL_ACCOUNT_ID <> 'SCORE' AND AT2.TRANSACTION_DATE = @monitoringDate THEN AE2.AMOUNT ELSE NULL END) AS "ACTUAL_AMOUNT",
MAX(CASE WHEN AT2.GL_FISCAL_TYPE_ID = 'BUDGET' AND AE2.GL_ACCOUNT_ID <> 'SCORE' AND AT2.TRANSACTION_DATE = @monitoringDate THEN AE2.AMOUNT ELSE NULL END) AS "BUDGET_AMOUNT",
MAX(CASE WHEN AT2.GL_FISCAL_TYPE_ID = 'ACTUAL' AND AE2.GL_ACCOUNT_ID <> 'SCORE' AND AT2.TRANSACTION_DATE = @monitoringDate THEN O.UOM_CODE ELSE NULL END) AS "ACTUAL_COD",
MAX(CASE WHEN AT2.GL_FISCAL_TYPE_ID = 'BUDGET' AND AE2.GL_ACCOUNT_ID <> 'SCORE' AND AT2.TRANSACTION_DATE = @monitoringDate THEN O.UOM_CODE ELSE NULL END) AS "BUDGET_COD"
FROM WORK_EFFORT_ASSOC A
INNER JOIN WORK_EFFORT W1 ON W1.WORK_EFFORT_ID = A.WORK_EFFORT_ID_TO
INNER JOIN WORK_EFFORT_ASSOC A2 ON A2.WORK_EFFORT_ID_FROM = W1.WORK_EFFORT_ID
AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND ( A2.FROM_DATE <= @monitoringDate AND (A2.THRU_DATE IS NULL OR A2.THRU_DATE >= @monitoringDate) )))
INNER JOIN WORK_EFFORT W ON W.WORK_EFFORT_ID = A2.WORK_EFFORT_ID_TO
INNER JOIN WORK_EFFORT_MEASURE WM ON WM.WORK_EFFORT_ID = W.WORK_EFFORT_ID
LEFT OUTER JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = WM.GL_ACCOUNT_ID AND GL.GL_ACCOUNT_ID <> 'SCORE'
LEFT OUTER JOIN UOM U ON U.UOM_ID = GL.DEFAULT_UOM_ID

LEFT OUTER JOIN ACCTG_TRANS AT ON AT.TRANSACTION_DATE = @monitoringDate 
  AND AT.VOUCHER_REF = WM.WORK_EFFORT_MEASURE_ID 
  AND AT.ACCTG_TRANS_TYPE_ID = 'SCOREKPI' 
  AND AT.GL_FISCAL_TYPE_ID = 'ACTUAL'
LEFT OUTER JOIN ACCTG_TRANS_ENTRY AE ON AE.ACCTG_TRANS_ID = AT.ACCTG_TRANS_ID

LEFT OUTER JOIN WORK_EFFORT_TYPE WT ON WT.WORK_EFFORT_TYPE_ID = W.WORK_EFFORT_TYPE_ID
LEFT OUTER JOIN UOM_RANGE_VALUES VP ON VP.FROM_VALUE <= AE.AMOUNT AND VP.THRU_VALUE >= AE.AMOUNT and VP.UOM_RANGE_ID = WT.UOM_RANGE_SCORE_ID
LEFT OUTER JOIN ENUMERATION CP ON CP.ENUM_ID = VP.COLOR_ENUM_ID
LEFT OUTER JOIN CONTENT IP ON IP.CONTENT_ID = VP.ICON_CONTENT_ID
LEFT OUTER JOIN DATA_RESOURCE EP ON EP.DATA_RESOURCE_ID = IP.DATA_RESOURCE_ID

LEFT OUTER JOIN ACCTG_TRANS AT2 ON ((GL.INPUT_ENUM_ID = 'ACCINP_OBJ' AND AT2.VOUCHER_REF = WM.WORK_EFFORT_MEASURE_ID) OR (GL.INPUT_ENUM_ID <> 'ACCINP_OBJ' AND AT2.PARTY_ID = W.ORG_UNIT_ID))
LEFT OUTER JOIN ACCTG_TRANS_ENTRY AE2 ON AT2.ACCTG_TRANS_ID = AE2.ACCTG_TRANS_ID AND AE2.GL_ACCOUNT_ID = WM.GL_ACCOUNT_ID 

LEFT OUTER JOIN WORK_EFFORT_MEAS_RAT_SC O ON O.WORK_EFFORT_MEASURE_ID = WM.WORK_EFFORT_MEASURE_ID
   AND O.UOM_ID = U. UOM_ID AND O.UOM_RATING_VALUE = AE2.AMOUNT
   
LEFT OUTER JOIN WORK_EFFORT_ASSOC WA ON WA.WORK_EFFORT_ID_TO = W.WORK_EFFORT_ID
   AND WA.WORK_EFFORT_ASSOC_TYPE_ID in ('19SBDC','19SBD2')
LEFT OUTER JOIN WORK_EFFORT_PARTY_ASSIGNMENT WEPA ON WEPA.WORK_EFFORT_ID = WA.WORK_EFFORT_ID_FROM
  AND WEPA.FROM_DATE <= @monitoringDate AND (WEPA.THRU_DATE IS NULL OR WEPA.THRU_DATE >= @monitoringDate)
LEFT OUTER JOIN PARTY P ON P.PARTY_ID = WEPA.PARTY_ID

LEFT OUTER JOIN (
	SELECT PN1.PARTY_ID, PN1.SUFFIX 
	FROM PARTY_NAME_HISTORY PN1
	WHERE  EXISTS
	(
	 SELECT PARTY_ID, CHANGE_DATE FROM 
	    (
	     SELECT PARTY_ID, MIN(Change_date) CHANGE_DATE 
	     FROM PARTY_NAME_HISTORY PN3 
	     WHERE PN3.change_date >= @monitoringDate  -- data di lacio stampa
	     GROUP BY PN3.PARTY_ID
	      )  PN2
	  WHERE PN2.PARTY_ID = PN1.PARTY_ID 
	  AND PN2.CHANGE_DATE = PN1.CHANGE_DATE
  )
)PNH ON PNH.PARTY_ID = P.PARTY_ID 

WHERE A.WORK_EFFORT_ID_FROM = ?
AND A.WORK_EFFORT_ASSOC_TYPE_ID IN ('19OBD', '19OAS', '19OSR')
AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND ( A.FROM_DATE <= @monitoringDate AND (A.THRU_DATE IS NULL OR A.THRU_DATE >= @monitoringDate) )))
AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND ( WM.FROM_DATE <= @monitoringDate AND (WM.THRU_DATE IS NULL OR WM.THRU_DATE >= @monitoringDate) )))
AND GL.GL_ACCOUNT_ID <> 'SCORE'
GROUP BY
 W.SOURCE_REFERENCE_ID,
 A.SEQUENCE_NUM,
 W.ETCH,
 W.WORK_EFFORT_ID,
 W.WORK_EFFORT_NAME,
 W1.WORK_EFFORT_NAME,
 W1.WORK_EFFORT_ID,
 W1.SOURCE_REFERENCE_ID,
 WM.WORK_EFFORT_MEASURE_ID,
 WM.GL_ACCOUNT_ID,
 GL.ACCOUNT_NAME,
 GL.ACCOUNT_CODE,
 WM.KPI_SCORE_WEIGHT,
 U.ABBREVIATION,
 GL.INPUT_ENUM_ID,
 WM.UOM_DESCR,
 U.UOM_TYPE_ID,
 U.DECIMAL_SCALE,
 W.ESTIMATED_COMPLETION_DATE,
 P.EXTERNAL_ID,
 PNH.SUFFIX
 ORDER BY W.ETCH]]></xml-property>
