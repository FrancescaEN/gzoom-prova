                                            <group id="58204">
                                                <property name="groupName">INDICATORE7</property>
                                                <expression name="keyExpr" type="javascript">row["GL_ACCOUNT_ID"]</expression>
                                                <structure name="toc">
                                                    <expression name="expressionValue" type="javascript">row["GL_ACCOUNT_ID"]</expression>
                                                </structure>
                                                <property name="hideDetail">false</property>
                                                <list-property name="sort">
                                                    <structure>
                                                        <expression name="key" type="javascript">row["ACCOUNT_CODE"]</expression>
                                                        <property name="direction">asc</property>
