	<subDataset name="DatasetTabellaObiettivi" uuid="fc6e5483-83cf-4dcf-86c3-935f8de726dc">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ferrarasalute_TEST"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="idOb" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT distinct
    obibdg.work_effort_id as obiettivo_budget_id,
    indic.account_name AS indicatore,
    indk.kpi_score_weight as peso_indicatore,
        CASE
            WHEN indic.debit_credit_default = 'D' THEN '<='
            ELSE '>='
        END AS superiore_inferiore,
    udm.abbreviation AS unita_misura,
    indk.content_name as emoticon,
    indk.object_info,
    max(
        CASE
            WHEN trans.transaction_date = anno.thru_date AND trans.gl_fiscal_type_id = 'BUDGET' THEN trans.amount
            ELSE NULL
        END) AS target_anno,
 	max(CASE
            WHEN trans.description is not null THEN trans.description
            ELSE NULL
        END) AS nota_target,
    max(
        CASE
            WHEN trans.transaction_date = anno.thru_date AND trans.gl_fiscal_type_id = 'ACTUAL' THEN trans.amount
            ELSE NULL
        END) AS consuntivo_anno,
    max(
        CASE
            WHEN trans.transaction_date = anno.thru_date AND trans.gl_fiscal_type_id = 'ACTUAL' THEN trans.description
            ELSE NULL
        END) AS nota_consuntivo,
    max(
        CASE
            WHEN mon.transaction_date = anno.thru_date AND mon.gl_fiscal_type_id = 'ACTUAL' THEN mon.amount
            ELSE NULL
        END) AS monitoraggio_anno_code
   FROM custom_time_period anno
     LEFT JOIN custom_time_period q1 ON q1.period_type_id = 'QUARTER' AND q1.period_num = 1 AND q1.thru_date >= anno.from_date AND q1.thru_date <= anno.thru_date
     LEFT JOIN custom_time_period q2 ON q2.period_type_id = 'QUARTER' AND q2.period_num = 2 AND q2.thru_date >= anno.from_date AND q2.thru_date <= anno.thru_date
     LEFT JOIN custom_time_period q3 ON q3.period_type_id = 'QUARTER' AND q3.period_num = 3 AND q3.thru_date >= anno.from_date AND q3.thru_date <= anno.thru_date
     JOIN work_effort sbdg ON sbdg.work_effort_type_id = '20S28VAL' AND sbdg.estimated_start_date <= anno.thru_date AND sbdg.estimated_completion_date >= anno.thru_date
     JOIN party uobdg ON uobdg.party_id = sbdg.org_unit_id
     JOIN party_parent_role uobdgcod ON uobdgcod.party_id = uobdg.party_id AND uobdgcod.role_type_id = 'ORGANIZATION_UNIT'
     JOIN party_relationship org ON org.party_id_to = uobdg.party_id AND org.party_relationship_type_id = 'GROUP_ROLLUP' AND org.from_date <= anno.thru_date AND (org.thru_date IS NULL OR org.thru_date >= anno.thru_date)
     LEFT JOIN party uopar ON uopar.party_id = org.party_id_from AND uopar.party_id <> 'COMPANY'
     LEFT JOIN party_parent_role uoparcod ON uopar.party_id IS NOT NULL AND uoparcod.party_id = uopar.party_id AND uoparcod.role_type_id = 'ORGANIZATION_UNIT'
     LEFT JOIN ( SELECT meask.work_effort_id, atr.transaction_date, atr.description,
            ate.amount, ate.orig_amount, urvk.comments, urvk.color_enum_id, urvk.from_value, urvk.thru_value
           FROM work_effort_measure meask 
             JOIN acctg_trans_entry ate ON ate.voucher_ref = meask.work_effort_measure_id
             JOIN acctg_trans atr ON atr.acctg_trans_id = ate.acctg_trans_id
             join work_effort wek on wek.work_effort_id = meask.work_effort_id
             join work_effort_type wetk on wetk.work_effort_type_id = wek.work_effort_type_id
             join uom_range_values urvk on urvk.uom_range_id = wetk.uom_range_score_id and urvk.from_value <= ate.amount and urvk.thru_value >= ate.amount
            where meask.gl_account_id = 'SCORE') sbdgk ON sbdgk.work_effort_id = sbdg.work_effort_id AND sbdgk.transaction_date = anno.thru_date
     JOIN work_effort_assoc uoobibdg ON uoobibdg.work_effort_id_from = sbdg.work_effort_id AND uoobibdg.work_effort_assoc_type_id = '20S2VAL'
     JOIN work_effort obibdg ON obibdg.work_effort_id = uoobibdg.work_effort_id_to AND obibdg.estimated_start_date <= anno.thru_date AND obibdg.estimated_completion_date >= anno.thru_date
/* NOTE OBIETTIVO BUDGET */
     LEFT JOIN (SELECT WEN.WORK_EFFORT_ID, NDA.NOTE_DATE_TIME, NDA.NOTE_INFO
			   FROM WORK_EFFORT_NOTE WEN
			   INNER JOIN NOTE_DATA NDA ON NDA.NOTE_ID = WEN.NOTE_ID
			   WHERE WEN.SEQUENCE_ID = 210) N210 ON N210.WORK_EFFORT_ID = obibdg.WORK_EFFORT_ID
     LEFT JOIN ( SELECT measkob.work_effort_id, atrob.transaction_date,
            ateob.amount, ateob.orig_amount, atrob.description, urvkob.comments, urvkob.color_enum_id, urvkob.from_value, urvkob.thru_value
           FROM work_effort_measure measkob 
             JOIN acctg_trans_entry ateob ON ateob.voucher_ref = measkob.work_effort_measure_id
             JOIN acctg_trans atrob ON atrob.acctg_trans_id = ateob.acctg_trans_id
             join work_effort wekob on wekob.work_effort_id = measkob.work_effort_id
             join work_effort_type wetkob on wetkob.work_effort_type_id = wekob.work_effort_type_id
             join uom_range_values urvkob on urvkob.uom_range_id = wetkob.uom_range_score_id and urvkob.from_value <= ateob.amount and urvkob.thru_value >= ateob.amount
            where measkob.gl_account_id = 'SCORE') obgk ON obgk.work_effort_id = obibdg.work_effort_id AND obgk.transaction_date = anno.thru_date
     LEFT JOIN work_effort_assoc obipiao ON obipiao.work_effort_id_to = obibdg.work_effort_id AND obipiao.work_effort_assoc_type_id = '20R4C' --20R4
     LEFT JOIN work_effort sspiao ON obipiao.work_effort_id_from IS NOT NULL AND sspiao.work_effort_id = obipiao.work_effort_id_from
     JOIN work_effort_assoc asspiao ON asspiao.work_effort_id_to = sspiao.work_effort_id AND asspiao.work_effort_assoc_type_id = '20R4' 
     LEFT JOIN work_effort szpiao ON asspiao.work_effort_id_from IS NOT NULL AND szpiao.work_effort_id = asspiao.work_effort_id_from
     LEFT JOIN work_effort_assoc obistr ON obistr.work_effort_id_to = obibdg.work_effort_id AND obistr.work_effort_assoc_type_id = '20S2BUC'
     LEFT JOIN work_effort str ON obistr.work_effort_id_from IS NOT NULL AND str.work_effort_id = obistr.work_effort_id_from
     JOIN work_effort_measure obiind ON obiind.work_effort_id = obibdg.work_effort_id AND obiind.gl_account_id <> 'SCORE'
     JOIN gl_account indic ON indic.gl_account_id = obiind.gl_account_id
     JOIN uom udm ON udm.uom_id = indic.default_uom_id
     JOIN period_type pt ON pt.period_type_id = indic.period_type_id
     JOIN work_effort_measure fonind ON fonind.gl_account_id = obiind.gl_account_id
     JOIN work_effort sfon ON sfon.work_effort_id = fonind.work_effort_id AND sfon.work_effort_type_id = '20S23KPI' AND sfon.estimated_start_date <= anno.thru_date AND sfon.estimated_completion_date >= anno.thru_date
     LEFT JOIN ( SELECT dr.object_info, measkind.work_effort_id, atrind.transaction_date,
            ateind.amount, urvkind.comments, urvkind.color_enum_id, measkind.gl_account_id, measkind.kpi_score_weight, urvkind.from_value, urvkind.thru_value, c.content_name
           FROM work_effort_measure measkind
             JOIN acctg_trans_entry ateind ON ateind.voucher_ref = measkind.work_effort_measure_id and ateind.GL_ACCOUNT_ID = 'SCOREKPI'
             JOIN acctg_trans atrind ON atrind.acctg_trans_id = ateind.acctg_trans_id 
             join work_effort wekind on wekind.work_effort_id = measkind.work_effort_id
             join work_effort_type wetkind on wetkind.work_effort_type_id = wekind.work_effort_type_id
             join uom_range_values urvkind on urvkind.uom_range_id = wetkind.uom_range_score_id and urvkind.from_value <= ateind.amount and urvkind.thru_value >= ateind.amount
             join content c on c.content_id = urvkind.icon_content_id
             join data_resource dr on dr.data_resource_id = c.data_resource_id
			) indk ON indk.work_effort_id = obibdg.work_effort_id AND indk.transaction_date = anno.thru_date and indk.gl_account_id = obiind.gl_account_id
     JOIN work_effort ril ON sfon.work_effort_parent_id = ril.work_effort_id AND ril.work_effort_type_id = '20S22RIL' 
     JOIN party uofon ON uofon.party_id = sfon.org_unit_id
     JOIN party_parent_role uofoncod ON uofoncod.party_id = uofon.party_id AND uofoncod.role_type_id = 'ORGANIZATION_UNIT'
     LEFT JOIN ( SELECT atr.transaction_date,
     		atr.description,
            atr.party_id,
            ate.gl_fiscal_type_id,
            ate.gl_account_id,
            acrs.uom_code,
            ate.amount,
            um.uom_type_id
           FROM acctg_trans atr
             JOIN acctg_trans_entry ate ON ate.acctg_trans_id = atr.acctg_trans_id
             JOIN gl_account ac ON ac.gl_account_id = ate.gl_account_id
             JOIN uom um ON um.uom_id = ac.default_uom_id
             LEFT JOIN gl_account_meas_rat_sc acrs ON um.uom_type_id = 'RATING_SCALE'
                AND acrs.gl_account_id = ac.gl_account_id AND acrs.uom_id = ac.default_uom_id
		                AND acrs.uom_rating_value = ate.amount and acrs.uom_code is not null) trans ON trans.gl_account_id = indic.gl_account_id AND trans.party_id = uobdg.party_id
	 left join (select at2.transaction_date,
	 			at2.party_id,
	 			wem.work_effort_id, 
				att.amount, 
				gl.account_name, 
				gamrs.uom_descr, 
				uom.uom_type_id,
				att.gl_fiscal_type_id 
			from work_effort_measure wem
				inner join acctg_trans at2 on at2.voucher_ref = wem.work_Effort_measure_id 
				inner join acctg_trans_entry att on att.acctg_trans_id = at2.acctg_trans_id 
				inner join gl_account gl on gl.gl_account_id = wem.gl_account_id
				left join uom on uom.uom_id = gl.default_uom_id
				left join gl_account_meas_rat_sc gamrs on gamrs.gl_account_id = att.gl_account_id and gamrs.uom_rating_value <= att.amount 
				and gamrs.uom_rating_value >= att.amount
				where att.gl_account_id = 'SCORE')
					mon on mon.work_effort_id = obibdg.work_effort_id and mon.party_id = uobdg.party_id
  WHERE anno.period_type_id = 'FISCAL_YEAR'
  and obibdg.work_effort_id= $P{idOb} 
  GROUP BY obibdg.work_effort_id,
    indic.account_name,
    indk.kpi_score_weight,
    indic.debit_credit_default,
    udm.abbreviation,
    indk.content_name,
    indk.object_info]]>
		</queryString>
