	<subDataset name="DatasetObiettiviEsecutivi" uuid="917dffba-05a4-44b1-ae72-8696d23f4fd6">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.xml"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="personId" class="java.lang.String" isForPrompting="false"/>
		<parameter name="date3112" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilDateTime.getMonthEndFromDatetime("12",$P{REPORT_TIME_ZONE}.getID(),YEAR($P{monitoringDate}), $P{REPORT_LOCALE}.getDefault())]]></defaultValueExpression>
		</parameter>
		<parameter name="date0101" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilDateTime.getMonthStartFromDatetime("1",$P{REPORT_TIME_ZONE}.getID(),YEAR($P{monitoringDate}), $P{REPORT_LOCALE}.getDefault())]]></defaultValueExpression>
		</parameter>
		<parameter name="monitoringDate" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[TODAY( )]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select_UNUSED_1 * from (	
	select 
		wea.work_effort_id_from as work_effort,
		concat(we.source_reference_id, ' - ', we.work_effort_name) as nome,
		1 as sequenza,
		wea.assoc_weight,
		score.amount
	from work_effort_assoc wea
	join work_effort we on we.work_effort_id = wea.work_effort_id_to and we.work_effort_type_id = '20P44OPD' and we.work_effort_revision_id is null
		and we.estimated_start_date <= '31-12-2022' and (we.estimated_completion_date >= '01-01-2022' or we.estimated_completion_date is null)
	left join (
		select 
			wem.work_effort_id,
			ate.amount
		from work_effort_measure wem 
		join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id and ate.gl_account_id = 'SCORE'
	) score on score.work_effort_id = we.work_effort_id 
	where wea.work_effort_assoc_type_id = '20INC'
	union all
	select 
		wem.work_effort_id as work_effort,
		gl.account_name as nome,
		2 as sequenza,
		null,
		null
	from work_effort_measure wem 
	join gl_account gl on gl.gl_account_id = wem.gl_account_id 
	where wem.gl_account_id <> 'SCORE'
) as obiettivi_esecutivi
where obiettivi_esecutivi.work_effort = '12695_cc'
order by obiettivi_esecutivi.sequenza, obiettivi_esecutivi.nome]]>
		</queryString>
		<field name="work_effort" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="work_effort"/>
			<property name="com.jaspersoft.studio.field.label" value="work_effort"/>
		</field>
		<field name="nome" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="nome"/>
			<property name="com.jaspersoft.studio.field.label" value="nome"/>
		</field>
		<field name="sequenza" class="java.lang.Integer">
			<property name="com.jaspersoft.studio.field.name" value="sequenza"/>
			<property name="com.jaspersoft.studio.field.label" value="sequenza"/>
		</field>
		<field name="assoc_weight" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="assoc_weight"/>
			<property name="com.jaspersoft.studio.field.label" value="assoc_weight"/>
		</field>
		<field name="amount" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="amount"/>
			<property name="com.jaspersoft.studio.field.label" value="amount"/>
		</field>
		<group name="Raggiungimento tipologia obiettivo">
			<groupExpression><![CDATA[$F{work_effort}]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="Dataset_ObiettiviEOIndicatoriDiPerformance" uuid="010c3433-aff8-420f-9b8f-a5e44d92cde2">
