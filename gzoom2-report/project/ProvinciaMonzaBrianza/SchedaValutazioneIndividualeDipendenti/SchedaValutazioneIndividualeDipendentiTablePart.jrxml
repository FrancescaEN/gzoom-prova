	<subDataset name="Dataset_DettaglioObiettiviIndividuali" uuid="de7b37b3-f9a9-4d29-8444-754cfbc5eb95">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.xml"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="263"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="731"/>
		<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="806"/>
		<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="184"/>
		<parameter name="date0101_DettaglioObiettiviIndividuali" class="java.util.Date"/>
		<parameter name="date3112_DettaglioObiettiviIndividuali" class="java.util.Date"/>
		<parameter name="work_effort_id_DettaglioObiettiviIndividuali" class="java.lang.String"/>
		<parameter name="estAnte_DettaglioObiettiviIndividuali" class="java.lang.Boolean">
			<parameterDescription><![CDATA[(ereditato dal main)]]></parameterDescription>
		</parameter>
		<parameter name="_testMode" class="java.lang.Boolean">
			<defaultValueExpression><![CDATA[false]]></defaultValueExpression>
		</parameter>
		<queryString language="SQL">
			<![CDATA[select * from (
	select * from (
		select 
			wea.work_effort_id_from as work_effort,
			we.source_reference_id as codice_obiettivo_esecutivo,
			we.work_effort_name as obiettivo_performance,
			concat(we.source_reference_id, ' - ', we.work_effort_name) as nome,
			1 as sequenza,
			wea.assoc_weight,
			score.amount
			/* queryy */
		from work_effort_assoc wea
		join work_effort we on we.work_effort_id = wea.work_effort_id_to and we.work_effort_type_id = '20P44OPD' and we.work_effort_revision_id is null
			and we.estimated_start_date <= $P{date3112_DettaglioObiettiviIndividuali} and (we.estimated_completion_date >= $P{date0101_DettaglioObiettiviIndividuali} or we.estimated_completion_date is null)
		left join (
			select 
				wem.work_effort_id,
				ate.amount
			from work_effort_measure wem 
			join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id and ate.gl_account_id = 'SCORE'
			/* CONSTRAINT ANNO DI LANCIO */
			join acctg_trans act on act.acctg_trans_id = ate.acctg_trans_id and act.transaction_date = $P{date3112_DettaglioObiettiviIndividuali}
			/* FILTRO ESCLUSIONE VALUTAZIONE INDIVIDUALE - 1 */
			where wem.gl_account_id <> '10100'
		) score on score.work_effort_id = we.work_effort_id 
		where wea.work_effort_assoc_type_id = '20INC'
		union all
		select 
			--wem.work_effort_id as work_effort,
			--trim(split_part(gl.account_name, '-', 1)) as codice_obiettivo_esecutivo,
			--trim(split_part(gl.account_name, '-', 2)) as obiettivo_performance,
			--gl.account_name as nome,
			wem2.work_effort_id as work_effort,
			trim(split_part(ga.account_name, '-', 1)) as codice_obiettivo_esecutivo,
			trim(split_part(ga.account_name, '-', 2)) as obiettivo_performance,
			ga.account_name as nome,
			2 as sequenza,
			null,
			null
		--from work_effort_measure wem 
		--join gl_account gl on gl.gl_account_id = wem.gl_account_id 
		--where wem.gl_account_id <> 'SCORE'
		from gl_account ga
		
    	join work_effort_measure wem2 on ga.gl_account_id = wem2.gl_account_id
    		 and wem2.work_effort_measure_id <> '10100'
    	--where ga.gl_account_id <> 'SCORE'
    	/* PUNTEGGIO INDICATORI DI SERVIZIO - INIZIO */
		left join (
			select
				wem2.gl_account_id, we.work_effort_id, scorekpi.amount
			from work_effort we
			join work_effort_measure wem2 on wem2.work_effort_id = we.work_effort_id
			left join (
				select
					act.voucher_ref, ate.amount
				from acctg_trans act
				join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id and ate.gl_account_id = 'SCOREKPI'
				where act.transaction_date = $P{date3112_DettaglioObiettiviIndividuali}
				and ate.gl_fiscal_type_id = 'ACTUAL'
			) scorekpi on scorekpi.voucher_ref = wem2.work_effort_measure_id
			where we.work_effort_type_id = '20P44SER' and we.work_effort_revision_id is null
		) serv on serv.gl_account_id = ga.gl_account_id and serv.work_effort_id=wem2.work_effort_id
		/* PUNTEGGIO INDICATORI DI SERVIZIO - FINE */
    	where ga.gl_account_id not in ('SCORE', '10100','EVAL_IND') -- esclusione anche di 'Valutazione individuale'
	) as fighter
		left join (
		select 
			wea.work_effort_id_from,
			gamrs.uom_code as uom_code
		from work_effort_assoc wea
		join work_effort we on we.work_effort_id = wea.work_effort_id_to and we.work_effort_type_id in ('20IN22OB', '20IN46OBI') and we.work_effort_revision_id is null
			and we.estimated_start_date <= $P{date3112_DettaglioObiettiviIndividuali} and (we.estimated_completion_date >= $P{date0101_DettaglioObiettiviIndividuali} or we.estimated_completion_date is null)
		left join work_effort_measure wem on wem.work_effort_id = we.work_effort_id 
		left join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id 
		left join acctg_trans act on act.acctg_trans_id = ate.acctg_trans_id and act.transaction_date = $P{date3112_DettaglioObiettiviIndividuali}
		left join gl_account_meas_rat_sc gamrs on gamrs.gl_account_id = wem.gl_account_id 
			and gamrs.uom_rating_value = ate.amount 
		where wea.work_effort_assoc_type_id = '20I' and ate.gl_account_id = 'SCOREKPI'
	) as risob on risob.work_effort_id_from = fighter.work_effort
) as foo	
where foo.work_effort = $P{work_effort_id_DettaglioObiettiviIndividuali} 
	--or foo.work_effort in ('13387_DISABLED', '12695_DISABLED', '12649_DISABLED', '12663') -- cablation only 4 test purposes
order by foo.work_effort, foo.sequenza]]>
		</queryString>
		<field name="work_effort" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="work_effort"/>
			<property name="com.jaspersoft.studio.field.label" value="work_effort"/>
		</field>
