		<defaultValueExpression><![CDATA[DAY($P{monitoringDate}) == 31 && MONTH($P{monitoringDate}) == 12]]></defaultValueExpression>
	</parameter>
	<parameter name="workEffortId" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	p.party_id,
	FIL_W.work_effort_type_id,
	FIL_W.work_effort_id,
	FIL_W.work_effort_name as "Nome scheda",
	FIL_W.source_reference_id as "Codice scheda",
	FIL_W.etch as "Etichetta scheda",
	to_char(FIL_W.estimated_start_date, 'dd/mm/yyyy') as "Data inizio",
	to_char(FIL_W.estimated_completion_date, 'dd/mm/yyyy') as "Data fine",
	per.first_name as "Nome",
	per.last_name as "Cognome",
	p.party_name as "Valutato",
	ppr.parent_role_code as "Matricola",
	ept.description as "Categoria economica",
	concat(ppr2.parent_role_code, ' - ', strutt.party_name) as "Struttura",
	concat(ppr3.parent_role_code, ' - ', h_pa3.party_name) as "Settore",
	amb.peso_obes_comparto,
	amb.valore_obes_comparto,
	amb.peso_comport_comparto,
	amb.valore_comport_comparto,
	amb.peso_ris_ente_dirigenti,
	amb.valore_ris_ente_dirigenti,
	amb.peso_comp_org_dirigenti,
	amb.valore_comp_org_dirigenti,
	amb.peso_obes_dirigenti,
	amb.valore_obes_dirigenti,
	amb.peso_serv_dirigenti,
	amb.valore_serv_dirigenti,
	valut.amount as "Valutazione",
	note.note_valutatore as "Note valutatore",
	note.note_valutato as "Note valutato",
	note.note_stampa as "Note stampa sbajato",
	ndstampa.note_info as "Note stampa",
	note_999.note_info as "Note riferimenti", 
	risob.uom_code as "Valutazione obiettivi",
	-- campi gerarchia (inizio)
	h_pa.party_id "Id",
	h_pa.party_type_id "Tipo",
	h_pa.party_name as "Nome esteso", 
	h_p.first_name as "Nome", 
	h_p.last_name as "Cognome",
	h_pr.party_id_to || ' > ' || h_pr.party_id_from as "gradino 1",
	h_pa2.party_id "Id unità organizzativa 1° livello",
	h_pa2.party_type_id "Tipo u.o. 1° livello",
	h_pa2.party_name as "Nome esteso u.o. 1° livello", 
	h_pa2x.party_id "Id dirigente u.o. 1° livello",
	h_pa2x.party_type_id "Tipo dirigente u.o. 1° livello",
	h_pa2x.party_name as "Nome esteso dirigente u.o. 1° livello", 
	h_p2x.first_name as "Nome dirigente u.o. 1° livello", 
	h_p2x.last_name as "Cognome dirigente u.o. 1° livello",
	h_pr2.party_id_to || ' > ' || h_pr2.party_id_from || 
		' - ' || h_pr2x.party_id_to as "gradino 2 - 2x",
	h_pa3.party_id "Id unità organizzativa 2° livello",
	h_pa3.party_type_id "Tipo u.o. 2° livello",
	h_pa3.party_name as "Nome esteso u.o. 2° livello", 
	h_pa3x.party_id "Id dirigente u.o. 2° livello",
	h_pa3x.party_type_id "Tipo dirigente u.o. 2° livello",
	h_pa3x.party_name as "Nome esteso dirigente u.o. 2° livello", 
	h_p3x.first_name as "Nome dirigente u.o. 2° livello", 
	h_p3x.last_name as "Cognome dirigente u.o. 2° livello",
	h_pr3.party_id_to || ' > ' || h_pr3.party_id_from || 
		' - ' || h_pr3x.party_id_to as "gradino 3 - 3x"
	-- campi gerarchia (fine)
from work_effort FIL_W
join work_effort_party_assignment wepa on wepa.work_effort_id = FIL_W.work_effort_id and wepa.role_type_id = 'WEM_EVAL_IN_CHARGE'
join party p on p.party_id = wepa.party_id 
join person per on per.party_id = p.party_id 
join party_parent_role ppr on ppr.party_id = p.party_id 
join empl_position_type ept on ept.empl_position_type_id = per.empl_position_type_id 
join party strutt on strutt.party_id = FIL_W.org_unit_id 
join party_parent_role ppr2 on ppr2.party_id = strutt.party_id
join (
	select 
		wea.work_effort_id_from,
		max(case when amb.work_effort_type_id = '20IN22OB' then wea.assoc_weight else null end) as peso_obes_comparto,
		max(case when amb.work_effort_type_id = '20IN24COM' then wea.assoc_weight else null end) as peso_comport_comparto,
		max(case when amb.work_effort_type_id = '20IN42AMM' then wea.assoc_weight else null end) as peso_ris_ente_dirigenti,
		max(case when amb.work_effort_type_id = '20IN44COM' then wea.assoc_weight else null end) as peso_comp_org_dirigenti,
		max(case when amb.work_effort_type_id = '20IN46OBI' then wea.assoc_weight else null end) as peso_obes_dirigenti,
		max(case when amb.work_effort_type_id = '20IN60CPO' then wea.assoc_weight else null end) as peso_serv_dirigenti,
		max(case when amb.work_effort_type_id = '20IN22OB' then score.amount else null end) as valore_obes_comparto,
		max(case when amb.work_effort_type_id = '20IN24COM' then score.amount else null end) as valore_comport_comparto,
		max(case when amb.work_effort_type_id = '20IN42AMM' then score.amount else null end) as valore_ris_ente_dirigenti,
		max(case when amb.work_effort_type_id = '20IN44COM' then score.amount else null end) as valore_comp_org_dirigenti,
		max(case when amb.work_effort_type_id = '20IN46OBI' then score.amount else null end) as valore_obes_dirigenti,
		max(case when amb.work_effort_type_id = '20IN60CPO' then score.amount else null end) as valore_serv_dirigenti
	from work_effort_assoc wea
	join work_effort amb on amb.work_effort_id = wea.work_effort_id_to and amb.work_effort_revision_id is null
		and amb.estimated_start_date <= $P{date3112} and (amb.estimated_completion_date >= $P{date0101} or amb.estimated_completion_date is null)
	left join (
		select 
			wem.work_effort_id,
			ate.amount
		from work_effort_measure wem
		left join acctg_trans act on act.voucher_ref = wem.work_effort_measure_id and act.transaction_date = $P{date3112}
		left join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id 
		where wem.gl_account_id = 'SCORE'
	) score on score.work_effort_id = amb.work_effort_id
	where wea.work_effort_assoc_type_id = '20I'
	group by
		wea.work_effort_id_from 
) amb on amb.work_effort_id_from = FIL_W.work_effort_id 

/* START filterInnerJoin */
   $P!{filterInnerJoinString} 
/* END filterInnerJoin */
/* START filterLeftJoin */
  $P!{filterLeftJoinString} 
/* END filterLeftJoin */

left join (
	select 
		wem.work_effort_id,
		ate.amount 
	from work_effort_measure wem 
	left join acctg_trans act on act.voucher_ref = wem.work_effort_measure_id and act.transaction_date = $P{date3112}
	left join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id 
	where wem.gl_account_id = 'SCORE'
) valut on valut.work_effort_id = FIL_W.work_effort_id 
left join (
	select 
		wen.work_effort_id,
		max(case when wen.sequence_id = '100' then nd.note_info else null end) as note_valutatore,
		max(case when wen.sequence_id = '110' then nd.note_info else null end) as note_valutato,
		max(case when wen.sequence_id = '900' then nd.note_info else null end) as note_stampa
	from work_effort_note wen
	join note_data nd on nd.note_id = wen.note_id
	group by
		wen.work_effort_id 
) note on note.work_effort_id = FIL_W.work_effort_id 
left join (
	select ws.work_effort_id, nd.NOTE_INFO
	from WORK_EFFORT ws
	inner join WORK_EFFORT_ASSOC wea on wea.WORK_EFFORT_ID_FROM = ws.WORK_EFFORT_ID and wea.WORK_EFFORT_ASSOC_TYPE_ID = 'TEMPL'
	inner join WORK_EFFORT_NOTE wen on wen.WORK_EFFORT_ID = wea.WORK_EFFORT_ID_TO and wen.SEQUENCE_ID = '999'
	inner join NOTE_DATA nd on nd.NOTE_ID = wen.NOTE_ID
	and TO_CHAR(nd.NOTE_DATE_TIME,'YYYY') = TO_CHAR(ws.ESTIMATED_COMPLETION_DATE,'YYYY')
) note_999 on note_999.work_effort_id = FIL_W.work_effort_id 
left join (
	select 
		wea.work_effort_id_from,
		gamrs.uom_code 
	from work_effort_assoc wea
	join work_effort we on we.work_effort_id = wea.work_effort_id_to and we.work_effort_type_id in ('20IN22OB', '20IN46OBI') and we.work_effort_revision_id is null
		and we.estimated_start_date <= $P{date3112} and (we.estimated_completion_date >= $P{date0101} or we.estimated_completion_date is null)
	left join work_effort_measure wem on wem.work_effort_id = we.work_effort_id 
	left join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id 
	left join acctg_trans act on act.acctg_trans_id = ate.acctg_trans_id and act.transaction_date = $P{date3112}
	left join gl_account_meas_rat_sc gamrs on gamrs.gl_account_id = wem.gl_account_id 
		and gamrs.uom_rating_value = ate.amount 
	where wea.work_effort_assoc_type_id = '20I' and ate.gl_account_id = 'SCOREKPI'
) risob on risob.work_effort_id_from = FIL_W.work_effort_id
-- join gerarchia (inizio)
left join party_relationship h_pr
    on h_pr.party_id_to = p.party_id 
    and h_pr.party_relationship_type_id = 'ORG_EMPLOYMENT'
	and h_pr.from_date  <= $P{date3112} and (h_pr.thru_date >= $P{date0101} or h_pr.thru_date is null)
left join party h_pa on h_pa.party_id = h_pr.party_id_to
left join person h_p on h_p.party_id = h_pa.party_id 
left join party_relationship h_pr2 
	on h_pr.party_id_from = h_pr2.party_id_to -- constraint NECESSARIO, non ridondante
	and h_pr2.party_id_from in (
		select party_id_from from party_relationship h_pr2_nested
		where h_pr2_nested.party_id_to = h_pr.party_id_from
		and h_pr2_nested.party_relationship_type_id = 'GROUP_ROLLUP'
		and h_pr2_nested.from_date <= $P{date3112} and (h_pr2_nested.thru_date >= $P{date0101} or h_pr2_nested.thru_date is null)
		order by h_pr2_nested.thru_date NULLS first -- Se ho più assegnazioni devo prendere la più recente
		limit 1	
	)
left join party h_pa2 on h_pa2.party_id = h_pr2.party_id_to
left join person h_p2 on h_p2.party_id = h_pa2.party_id 
left join party_relationship h_pr2x 
	on h_pr.party_id_from = h_pr2x.party_id_from
	and p.party_id <> h_pr2x.party_id_to -- evita molteplicità non volute
	and h_pr2x.party_relationship_type_id = 'ORG_RESPONSIBLE'
left join party h_pa2x on h_pa2x.party_id = h_pr2x.party_id_to
left join person h_p2x on h_p2x.party_id = h_pa2x.party_id 
left join party_relationship h_pr3 on h_pr2.party_id_from = h_pr3.party_id_to
	and h_pr3.party_relationship_type_id = 'GROUP_ROLLUP'
left join party h_pa3 on h_pa3.party_id = h_pr3.party_id_to
left join party_parent_role ppr3 on ppr3.party_id = h_pa3.party_id  and ppr3.parent_role_code not in ('Company')
left join person h_p3 on h_p3.party_id = h_pa3.party_id 
left join party_relationship h_pr3x on h_pr2.party_id_from = h_pr3x.party_id_from
	and h_pr3x.party_relationship_type_id = 'ORG_RESPONSIBLE'
left join party h_pa3x on h_pa3x.party_id = h_pr3x.party_id_to
left join person h_p3x on h_p3x.party_id = h_pa3x.party_id
-- join gerarchia (fine)
-- note comuni
left join work_effort_type_attr weta on weta.work_effort_type_id = FIL_W.work_effort_type_id and weta.sequence_id = '900'
left join note_data ndstampa on ndstampa.note_id = weta.note_id 
-- note comuni (fine)
--where FIL_W.work_effort_type_id in ('20IN20CSR', '20IN20CST', '20IN40CPO', '20IN40DIR') and FIL_W.work_effort_revision_id is null
--where FIL_W.work_effort_type_id in ('20IN20CSR', '20IN20CST') and FIL_W.work_effort_revision_id is null
where FIL_W.work_effort_type_id= $P{workEffortTypeId}  and FIL_W.work_effort_revision_id is null
and FIL_W.estimated_start_date <= $P{date3112} and (FIL_W.estimated_completion_date >= $P{date0101} or FIL_W.estimated_completion_date is null) 
and (p.party_id = $P{personId} or $P{personId} is null or $P{personId} = '')
and (FIL_W.work_effort_id = $P{workEffortId} or $P{workEffortId} is null or $P{workEffortId} = '')
and (FIL_W.org_unit_id = $P{orgUnitId} or $P{orgUnitId} is null or $P{orgUnitId} = '')
/* START filterWhere*/
   $P!{filterWhereString} 
/* END filterWhere */


order by 
	FIL_W.work_effort_type_id,
	FIL_W.work_effort_name]]>
	</queryString>
