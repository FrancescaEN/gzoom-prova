	<subDataset name="Dataset_PerformanceOrganizzativaIndicatoriDiEnte" uuid="3216f888-fbbb-4af2-9d45-54162d18c88d">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="project\ProvinciaMonzaBrianza\SchedaValutazioneIndividualeDipendenti\DataAdapter.jrdax"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="192"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="803"/>
		<parameter name="date0101_PerformanceOrganizzativaIndicatoriDiEnte" class="java.util.Date"/>
		<parameter name="date3112_PerformanceOrganizzativaIndicatoriDiEnte" class="java.util.Date"/>
		<parameter name="work_effort_id_PerformanceOrganizzativaIndicatoriDiEnte" class="java.lang.String"/>
		<parameter name="valore_ris_ente_dirigenti" class="java.lang.Double"/>
		<parameter name="estAnte_PerformanceOrganizzativaIndicatoriDiEnte" class="java.lang.Boolean"/>
		<parameter name="_testMode" class="java.lang.String"/>
		<parameter name="parent_Valutazione_UNUSED" class="java.lang.String"/>
		<parameter name="_dataSelezionataEst3112" class="java.lang.Boolean"/>
		<queryString language="SQL">
			<![CDATA[select * from (
	select
		gl.gl_account_id as "ente_gl_account_id",
		gl.account_code as "ente_account_code",
		wea.work_effort_id_from,
		gl.account_name,
		trim(split_part(gl.account_name, '-', 1)) as "Codice indicatore",
		trim(split_part(gl.account_name, '-', 2)) as "Titolo indicatore",
		case 
			when $P{_dataSelezionataEst3112} then wetnv.tm_amount
			else scorekpi.amount
		end as amount
		/* TEST QUERY */
	from work_effort_assoc wea
	join work_effort we on we.work_effort_id = wea.work_effort_id_to and we.work_effort_type_id = '20IN42AMM' and we.work_effort_revision_id is null
		and we.estimated_start_date <= $P{date3112_PerformanceOrganizzativaIndicatoriDiEnte} and (we.estimated_completion_date >= $P{date0101_PerformanceOrganizzativaIndicatoriDiEnte} or we.estimated_completion_date is null)
	left join work_effort_trans_noobj_view wetnv on wetnv.m_work_effort_id = we.work_effort_id 
		and wetnv.tm_gl_fiscal_type_id = 'BUDGET' and wetnv.tt_transaction_date = $P{date3112_PerformanceOrganizzativaIndicatoriDiEnte}  and wetnv.tm_gl_account_id <> 'SCORE'
		and wetnv.tm_gl_account_id <> 'SCOREKPI'
	left join gl_account gl on gl.gl_account_id = wetnv.tm_gl_account_id
	/* PUNTEGGIO INDICATORI - INIZIO */
	left join (
		select
			wem.work_effort_id, wem.gl_account_id, ate.amount
		from work_effort_measure wem
		join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id and ate.gl_account_id = 'SCOREKPI'
		join acctg_trans act on act.acctg_trans_id = ate.acctg_trans_id and act.transaction_date = $P{date3112_PerformanceOrganizzativaIndicatoriDiEnte}
	) as scorekpi on (scorekpi.work_effort_id, scorekpi.gl_account_id) = (we.work_effort_id, gl.gl_account_id)
	/* PUNTEGGIO INDICATORI - FINE*/
	where 
		wea.work_effort_assoc_type_id = '20I'
union all		
	select
		gl.gl_account_id as "ente_gl_account_id",
		gl.account_code as "ente_account_code",
		we.work_effort_id as work_effort_id_from,
		gl.account_name,
		trim(split_part(gl.account_name, '-', 1)) as "Codice indicatore",
		trim(split_part(gl.account_name, '-', 2)) as "Titolo indicatore",
		max(wetnv.tm_amount) as amount
	from work_effort we
	--join gl_account gl on gl.gl_account_id in ('F909910.IP.01', 'F909910.IP.02', 'F909910.IP.03', 'F909910.IP.04', 'F909910.IP.05')
	join gl_account gl on gl.account_code like '909910.IP.%'
	join work_effort_measure wem on wem.gl_account_id = gl.gl_account_id and wem.from_date <= $P{date3112_PerformanceOrganizzativaIndicatoriDiEnte} and wem.thru_date >= $P{date0101_PerformanceOrganizzativaIndicatoriDiEnte}
	left join work_effort_trans_noobj_view wetnv on wetnv.g_gl_account_id = gl.gl_account_id 
		and wetnv.tm_gl_fiscal_type_id = 'BUDGET' and wetnv.tt_transaction_date = $P{date3112_PerformanceOrganizzativaIndicatoriDiEnte} and wetnv.tm_gl_account_id <> 'SCORE'
		and wetnv.tm_gl_account_id <> 'SCOREKPI'
	where we.work_effort_type_id in ('20IN20CSR', '20IN20CST')
	group by
		we.work_effort_id,
		gl.account_name,
		gl.gl_account_id
) as ente
where ente.work_effort_id_from = $P{work_effort_id_PerformanceOrganizzativaIndicatoriDiEnte}
order by ente.ente_account_code]]>
		</queryString>
		<field name="ente_gl_account_id" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="ente_gl_account_id"/>
			<property name="com.jaspersoft.studio.field.label" value="ente_gl_account_id"/>
		</field>
		<field name="ente_account_code" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="ente_account_code"/>
			<property name="com.jaspersoft.studio.field.label" value="ente_account_code"/>
		</field>
		<field name="work_effort_id_from" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="work_effort_id_from"/>
			<property name="com.jaspersoft.studio.field.label" value="work_effort_id_from"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort_assoc"/>
		</field>
		<field name="account_name" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="account_name"/>
			<property name="com.jaspersoft.studio.field.label" value="account_name"/>
		</field>
		<field name="Codice indicatore" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Codice indicatore"/>
			<property name="com.jaspersoft.studio.field.label" value="Codice indicatore"/>
		</field>
		<field name="Titolo indicatore" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Titolo indicatore"/>
			<property name="com.jaspersoft.studio.field.label" value="Titolo indicatore"/>
		</field>
		<field name="amount" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="amount"/>
			<property name="com.jaspersoft.studio.field.label" value="amount"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort_trans_noobj_view"/>
		</field>
	</subDataset>
	<subDataset name="Dataset_PerformanceOrganizzativaIndicatoriDiSettoreServizio" uuid="685379ec-af01-401f-8f2b-29a017d16974">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.xml"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="date0101_PerformanceOrganizzativaIndicatoriDiSettoreServizio" class="java.util.Date"/>
		<parameter name="date3112_PerformanceOrganizzativaIndicatoriDiSettoreServizio" class="java.util.Date"/>
		<parameter name="work_effort_id_PerformanceOrganizzativaIndicatoriDiSettoreServizio" class="java.lang.String"/>
		<parameter name="estAnte_DettaglioObiettiviIndividuali" class="java.lang.String"/>
		<parameter name="_testMode" class="java.lang.String"/>
		<parameter name="parent_Valutazione" class="java.lang.Double"/>
		<parameter name="estAnte_PerformanceOrganizzativaIndicatoriDiSettoreServizio" class="java.lang.Boolean"/>
		<queryString>
			<![CDATA[select_UNUSED_9 
	wea.work_effort_id_from,
	trim(split_part(gl.account_name, '-', 1)) as "Codice indicatore settore",
	trim(split_part(gl.account_name, '-', 2)) as "Titolo indicatore settore",
	case when wr1.UOM_DESCR is not null then wr1.UOM_DESCR else replace(cast(cast(av1.B_AMOUNT as decimal) as varchar),'.',',') end as "valore target",
	gl.account_name,
	scorekpi.amount
from work_effort_assoc wea
join work_effort we on we.work_effort_id = wea.work_effort_id_to and we.work_effort_type_id = '20IN60CPO' and we.work_effort_revision_id is null
	and we.estimated_start_date <= $P{date3112_PerformanceOrganizzativaIndicatoriDiSettoreServizio} 
	and (we.estimated_completion_date >= $P{date0101_PerformanceOrganizzativaIndicatoriDiSettoreServizio} or we.estimated_completion_date is null)
join work_effort_assoc wea2 on wea2.work_effort_id_from = we.work_effort_id and wea2.work_effort_assoc_type_id = '20INC'
join work_effort we2 on we2.work_effort_id = wea2.work_effort_id_to and we2.work_effort_type_id = '20P44SER' and we2.work_effort_revision_id is null
		and we2.estimated_start_date <= $P{date3112_PerformanceOrganizzativaIndicatoriDiSettoreServizio} 
		and (we2.estimated_completion_date >=$P{date0101_PerformanceOrganizzativaIndicatoriDiSettoreServizio}  or we2.estimated_completion_date is null)
join work_effort_measure wem on wem.work_effort_id = we2.work_effort_id and wem.gl_account_id <> 'SCORE'
join work_effort_purpose_account wepa on wepa.gl_account_id = wem.gl_account_id and wepa.work_effort_purpose_type_id = 'OBPINS'
join gl_account gl on gl.gl_account_id = wem.gl_account_id
left join (
	select 
		act.voucher_ref,
		ate.amount
	from acctg_trans act
	join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id and ate.gl_account_id = 'SCOREKPI'
	where act.transaction_date = $P{date3112_PerformanceOrganizzativaIndicatoriDiSettoreServizio}
) scorekpi on scorekpi.voucher_ref = wem.work_effort_measure_id 
left  join ACCTG_TRANS_VIEW av1 on av1.B_VOUCHER_REF = wem.WORK_EFFORT_MEASURE_ID 
	and av1.A_TRANSACTION_DATE >= $P{date0101_PerformanceOrganizzativaIndicatoriDiSettoreServizio} and av1.A_TRANSACTION_DATE <= $P{date3112_PerformanceOrganizzativaIndicatoriDiSettoreServizio}
	and av1.B_GL_FISCAL_TYPE_ID = 'BUDGET'
left  join WORK_EFFORT_MEAS_RAT_SC wr1 on wr1.WORK_EFFORT_MEASURE_ID = wem.WORK_EFFORT_MEASURE_ID --and wr1.UOM_RATING_VALUE = av1.B_AMOUNT
where 
		wea.work_effort_assoc_type_id = '20I'
		and wea.work_effort_id_from = $P{work_effort_id_PerformanceOrganizzativaIndicatoriDiSettoreServizio}
		-- and wea.work_effort_id_from = '12554' -- BARTOLONE, Gaetano 
order by
	we2.source_reference_id]]>
		</queryString>
		<field name="work_effort_id_from" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="work_effort_id_from"/>
			<property name="com.jaspersoft.studio.field.label" value="work_effort_id_from"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort_assoc"/>
		</field>
		<field name="Codice indicatore settore" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Codice indicatore settore"/>
			<property name="com.jaspersoft.studio.field.label" value="Codice indicatore settore"/>
		</field>
		<field name="Titolo indicatore settore" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Titolo indicatore settore"/>
			<property name="com.jaspersoft.studio.field.label" value="Titolo indicatore settore"/>
		</field>
		<field name="valore target" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="valore target"/>
			<property name="com.jaspersoft.studio.field.label" value="valore target"/>
		</field>
		<field name="account_name" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="account_name"/>
			<property name="com.jaspersoft.studio.field.label" value="account_name"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="gl_account"/>
		</field>
		<field name="amount" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="amount"/>
			<property name="com.jaspersoft.studio.field.label" value="amount"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="acctg_trans_entry"/>
		</field>
	</subDataset>
