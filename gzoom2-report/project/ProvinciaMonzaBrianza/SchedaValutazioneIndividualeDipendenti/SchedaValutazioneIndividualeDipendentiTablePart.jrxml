	<subDataset name="Dataset_ComportamentiOrganizzativiPerTipoRisorsa" uuid="4c7964c6-1bd4-44c7-87bd-d237cca3f636">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.xml"/>
		<parameter name="join_gl_resource_type_id" class="java.lang.String">
			<defaultValueExpression><![CDATA[$P{join_gl_resource_type_id}]]></defaultValueExpression>
		</parameter>
		<queryString language="SQL">
			<![CDATA[select_UNUSED_4 * from (
	select 
		wea.work_effort_id_from,
		gamrs.uom_code,
		gl.account_name,
		grt.description,
		grt.gl_resource_type_id 
	from work_effort_assoc wea
	join work_effort we on we.work_effort_id = wea.work_effort_id_to and we.work_effort_type_id in ('20IN24COM', '20IN44COM') and we.work_effort_revision_id is null
		and we.estimated_start_date <= '31-12-2022' and (we.estimated_completion_date >= '01-01-2022' or we.estimated_completion_date is null)
	join work_effort_measure wem on wem.work_effort_id = we.work_effort_id 
	join gl_account gl on gl.gl_account_id = wem.gl_account_id 
	join gl_resource_type grt on grt.gl_resource_type_id = gl.gl_resource_type_id 
	left join (
		select 
			ate.amount,
			act.voucher_ref
		from acctg_trans act 
		join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id and ate.gl_account_id = 'SCOREKPI'
		where act.transaction_date = '31-12-2022'
	) scorekpi on scorekpi.voucher_ref = wem.work_effort_measure_id 
	left join gl_account_meas_rat_sc gamrs on gamrs.gl_account_id = wem.gl_account_id 
		and gamrs.uom_rating_value = scorekpi.amount 
	where wea.work_effort_assoc_type_id = '20I' and wem.gl_account_id <> 'SCORE'
) as comportamenti_organizzativi
where comportamenti_organizzativi.work_effort_id_from = '12649'
and comportamenti_organizzativi.gl_resource_type_id = $P{join_gl_resource_type_id}
order by comportamenti_organizzativi.description]]>
		</queryString>
