		<property name="com.jaspersoft.studio.field.name" value="Data fine"/>
		<property name="com.jaspersoft.studio.field.label" value="Data fine"/>
	</field>
	<field name="Nome" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="Nome"/>
