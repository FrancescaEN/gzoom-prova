	<subDataset name="Dataset_PerformanceOrganizzativaIndicatoriDiSettoreServizio" uuid="685379ec-af01-401f-8f2b-29a017d16974">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="163"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="832"/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="NO_DATA_ADAPTER"/>
		<parameter name="date0101_PerformanceOrganizzativaIndicatoriDiSettoreServizio" class="java.util.Date"/>
		<parameter name="date3112_PerformanceOrganizzativaIndicatoriDiSettoreServizio" class="java.util.Date"/>
		<parameter name="work_effort_id_PerformanceOrganizzativaIndicatoriDiSettoreServizio" class="java.lang.String"/>
		<parameter name="estAnte_DettaglioObiettiviIndividuali" class="java.lang.String"/>
		<parameter name="_testMode" class="java.lang.String"/>
		<parameter name="parent_Valutazione" class="java.lang.Double"/>
		<parameter name="estAnte_PerformanceOrganizzativaIndicatoriDiSettoreServizio" class="java.lang.Boolean"/>
		<queryString>
			<![CDATA[select 
	wea.work_effort_id_from,
	trim(split_part(gl.account_name, '-', 1)) as "Codice indicatore settore",
	trim(split_part(gl.account_name, '-', 2)) as "Titolo indicatore settore",
	case when wr1.UOM_DESCR is not null then wr1.UOM_DESCR else replace(cast(cast(av1.B_AMOUNT as decimal) as varchar),'.',',') end as "valore target",
	gl.account_name,
	scorekpi.amount,
	score.amount as "misurazione",
	conta.totale,
	conta.somma
from work_effort_assoc wea
join work_effort we on we.work_effort_id = wea.work_effort_id_to and we.work_effort_type_id = '20IN60CPO' and we.work_effort_revision_id is null
	and we.estimated_start_date <= $P{date3112_PerformanceOrganizzativaIndicatoriDiSettoreServizio} 
	and (we.estimated_completion_date >= $P{date0101_PerformanceOrganizzativaIndicatoriDiSettoreServizio} or we.estimated_completion_date is null)
left join (
	select wem.work_effort_id,
		ate.amount
	from work_effort_measure wem 
	join acctg_trans act on act.voucher_ref = wem.work_effort_measure_id and act.transaction_date = $P{date3112_PerformanceOrganizzativaIndicatoriDiSettoreServizio}
	join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id and ate.gl_account_id = 'SCORE'
) score on score.work_effort_id = we.work_effort_id
join work_effort_assoc wea2 on wea2.work_effort_id_from = we.work_effort_id and wea2.work_effort_assoc_type_id = '20INC'
join work_effort we2 on we2.work_effort_id = wea2.work_effort_id_to and we2.work_effort_type_id = '20P44SER' and we2.work_effort_revision_id is null
		and we2.estimated_start_date <= $P{date3112_PerformanceOrganizzativaIndicatoriDiSettoreServizio} 
		and (we2.estimated_completion_date >=$P{date0101_PerformanceOrganizzativaIndicatoriDiSettoreServizio}  or we2.estimated_completion_date is null)
join work_effort_measure wem on wem.work_effort_id = we2.work_effort_id and wem.gl_account_id <> 'SCORE' and wem.thru_date >= we.estimated_start_date and wem.from_date <= we.estimated_completion_date 
join work_effort_purpose_account wepa on wepa.gl_account_id = wem.gl_account_id and wepa.work_effort_purpose_type_id = 'OBPINS'
join gl_account gl on gl.gl_account_id = wem.gl_account_id
left join (
	select 
	count(*) as totale, wea.work_effort_id_from,
		sum(ate.amount) as somma
	from work_effort_assoc wea
	join work_effort we on we.work_effort_id = wea.work_effort_id_to and we.work_effort_type_id = '20IN60CPO' and we.work_effort_revision_id is null
		and we.estimated_start_date <= $P{date3112_PerformanceOrganizzativaIndicatoriDiSettoreServizio} 
		and (we.estimated_completion_date >= $P{date0101_PerformanceOrganizzativaIndicatoriDiSettoreServizio} or we.estimated_completion_date is null)
	join work_effort_assoc wea2 on wea2.work_effort_id_from = we.work_effort_id and wea2.work_effort_assoc_type_id = '20INC'
	join work_effort we2 on we2.work_effort_id = wea2.work_effort_id_to and we2.work_effort_type_id = '20P44SER' and we2.work_effort_revision_id is null
		and we2.estimated_start_date <=  $P{date3112_PerformanceOrganizzativaIndicatoriDiSettoreServizio} 
		and (we2.estimated_completion_date >= $P{date0101_PerformanceOrganizzativaIndicatoriDiSettoreServizio} or we2.estimated_completion_date is null)
	join work_effort_measure wem on wem.work_effort_id = we2.work_effort_id and wem.gl_account_id not in ('SCORE', 'SCOREKPI')
	join work_effort_purpose_account wepa on wepa.gl_account_id = wem.gl_account_id and wepa.work_effort_purpose_type_id = 'OBPINS'
	join acctg_trans act on act.voucher_ref = wem.work_effort_measure_id 
	join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id and ate.gl_account_id = 'SCOREKPI'
	where act.transaction_date = $P{date3112_PerformanceOrganizzativaIndicatoriDiSettoreServizio}  and wea.work_effort_assoc_type_id = '20I'
	group by wea.work_effort_id_from
) conta on conta.work_effort_id_from = wea.work_effort_id_from

left join (
	select 
		act.voucher_ref,
		ate.amount
	from acctg_trans act
	join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id and ate.gl_account_id = 'SCOREKPI'
	where act.transaction_date = $P{date3112_PerformanceOrganizzativaIndicatoriDiSettoreServizio}
) scorekpi on scorekpi.voucher_ref = wem.work_effort_measure_id 
left  join ACCTG_TRANS_VIEW av1 on av1.B_VOUCHER_REF = wem.WORK_EFFORT_MEASURE_ID 
	and av1.A_TRANSACTION_DATE >= $P{date0101_PerformanceOrganizzativaIndicatoriDiSettoreServizio} and av1.A_TRANSACTION_DATE <= $P{date3112_PerformanceOrganizzativaIndicatoriDiSettoreServizio}
	and av1.B_GL_FISCAL_TYPE_ID = 'BUDGET'
left  join WORK_EFFORT_MEAS_RAT_SC wr1 on wr1.WORK_EFFORT_MEASURE_ID = wem.WORK_EFFORT_MEASURE_ID --and wr1.UOM_RATING_VALUE = av1.B_AMOUNT
where 
		wea.work_effort_assoc_type_id = '20I'
		and wea.work_effort_id_from = $P{work_effort_id_PerformanceOrganizzativaIndicatoriDiSettoreServizio}
group by wea.work_effort_id_from, gl.account_name, wr1.UOM_DESCR, av1.B_AMOUNT,scorekpi.amount,score.amount,we2.source_reference_id, conta.totale,conta.somma
order by
	we2.source_reference_id]]>
		</queryString>
		<field name="work_effort_id_from" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="work_effort_id_from"/>
			<property name="com.jaspersoft.studio.field.label" value="work_effort_id_from"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort_assoc"/>
		</field>
		<field name="Codice indicatore settore" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Codice indicatore settore"/>
			<property name="com.jaspersoft.studio.field.label" value="Codice indicatore settore"/>
		</field>
		<field name="Titolo indicatore settore" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Titolo indicatore settore"/>
			<property name="com.jaspersoft.studio.field.label" value="Titolo indicatore settore"/>
		</field>
		<field name="valore target" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="valore target"/>
			<property name="com.jaspersoft.studio.field.label" value="valore target"/>
		</field>
		<field name="account_name" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="account_name"/>
			<property name="com.jaspersoft.studio.field.label" value="account_name"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="gl_account"/>
		</field>
		<field name="amount" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="amount"/>
			<property name="com.jaspersoft.studio.field.label" value="amount"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="acctg_trans_entry"/>
		</field>
		<field name="misurazione" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="misurazione"/>
			<property name="com.jaspersoft.studio.field.label" value="misurazione"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="acctg_trans_entry"/>
		</field>
		<field name="totale" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="totale"/>
			<property name="com.jaspersoft.studio.field.label" value="totale"/>
		</field>
		<field name="somma" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="somma"/>
			<property name="com.jaspersoft.studio.field.label" value="somma"/>
		</field>
		<variable name="totale_indicatori" class="java.lang.Double">
			<variableExpression><![CDATA[$F{somma}/$F{totale}]]></variableExpression>
		</variable>
	</subDataset>
	<subDataset name="Dataset_PerformanceIndividualeObiettiviIndividuali" uuid="34f6cfd0-4bd8-4921-8352-deac286e3eef">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="NO_DATA_ADAPTER"/>
		<parameter name="work_effort_id_PerformanceIndividualeObiettiviIndividuali" class="java.lang.String">
			<defaultValueExpression><![CDATA[T(12218)]]></defaultValueExpression>
		</parameter>
		<parameter name="date0101_PerformanceIndividualeObiettiviIndividuali" class="java.util.Date">
			<defaultValueExpression><![CDATA[DATE(2022, 1, 1 )]]></defaultValueExpression>
		</parameter>
		<parameter name="date3112_PerformanceIndividualeObiettiviIndividuali" class="java.util.Date">
			<defaultValueExpression><![CDATA[DATE(2022, 12, 31 )]]></defaultValueExpression>
		</parameter>
		<parameter name="estAnte_PerformanceIndividualeObiettiviIndividuali" class="java.lang.Boolean"/>
		<parameter name="p_valutazione-obiettivi" class="java.lang.String"/>
		<parameter name="p_valore-obes-dirigenti" class="java.lang.Double"/>
		<queryString>
			<![CDATA[select 
		wea.work_effort_id_from,
		we2.source_reference_id,
		we2.work_effort_name,
		score.amount,
		conta.totale
	from work_effort_assoc wea
	join work_effort we on we.work_effort_id = wea.work_effort_id_to and we.work_effort_type_id = '20IN46OBI' and we.work_effort_revision_id is null
		and we.estimated_start_date <= $P{date3112_PerformanceIndividualeObiettiviIndividuali} and (we.estimated_completion_date >= $P{date0101_PerformanceIndividualeObiettiviIndividuali} or we.estimated_completion_date is null)
	join work_effort_assoc wea2 on wea2.work_effort_id_from = we.work_effort_id and wea2.work_effort_assoc_type_id = '20INC'
	join work_effort we2 on we2.work_effort_id = wea2.work_effort_id_to and we2.work_effort_type_id = '20P44OPD' and we2.work_effort_revision_id is null
		and we2.estimated_start_date <= $P{date3112_PerformanceIndividualeObiettiviIndividuali} and (we2.estimated_completion_date >= $P{date0101_PerformanceIndividualeObiettiviIndividuali}  or we2.estimated_completion_date is null)
		left join (
		select count(*) as totale, wea.work_effort_id_from
		from work_effort_assoc wea
		join work_effort we on we.work_effort_id = wea.work_effort_id_to and we.work_effort_type_id = '20IN46OBI' and we.work_effort_revision_id is null
			and we.estimated_start_date <= $P{date3112_PerformanceIndividualeObiettiviIndividuali} and (we.estimated_completion_date >= $P{date0101_PerformanceIndividualeObiettiviIndividuali} or we.estimated_completion_date is null)
		join work_effort_assoc wea2 on wea2.work_effort_id_from = we.work_effort_id and wea2.work_effort_assoc_type_id = '20INC'
		join work_effort we2 on we2.work_effort_id = wea2.work_effort_id_to and we2.work_effort_type_id = '20P44OPD' and we2.work_effort_revision_id is null
			and we2.estimated_start_date <= $P{date3112_PerformanceIndividualeObiettiviIndividuali} and (we2.estimated_completion_date >= $P{date0101_PerformanceIndividualeObiettiviIndividuali} or we2.estimated_completion_date is null)
		where wea.work_effort_assoc_type_id = '20I'
		group by wea.work_effort_id_from
	) conta on conta.work_effort_id_from = wea.work_effort_id_from 
	left join (
		select 
			wem.work_effort_id,
			ate.amount 
		from work_effort_measure wem
		join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id 
		join acctg_trans act on act.acctg_trans_id = ate.acctg_trans_id and act.transaction_date = $P{date3112_PerformanceIndividualeObiettiviIndividuali}
		where wem.gl_account_id = 'SCORE'
	) score on score.work_effort_id = we2.work_effort_id 
	where wea.work_effort_assoc_type_id = '20I'
	and wea.work_effort_id_from = $P{work_effort_id_PerformanceIndividualeObiettiviIndividuali}]]>
		</queryString>
		<field name="work_effort_id_from" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="work_effort_id_from"/>
			<property name="com.jaspersoft.studio.field.label" value="work_effort_id_from"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort_assoc"/>
		</field>
		<field name="source_reference_id" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="source_reference_id"/>
			<property name="com.jaspersoft.studio.field.label" value="source_reference_id"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort"/>
		</field>
		<field name="work_effort_name" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="work_effort_name"/>
			<property name="com.jaspersoft.studio.field.label" value="work_effort_name"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort"/>
		</field>
		<field name="amount" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="amount"/>
			<property name="com.jaspersoft.studio.field.label" value="amount"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="acctg_trans_entry"/>
