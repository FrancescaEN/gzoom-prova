	<subDataset name="Dataset_DettaglioObiettiviSettore" uuid="ed0314a9-68d5-43ca-90cc-20dc8a8fe83e">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="project\ProvinciaMonzaBrianza\SchedaValutazioneIndividualeDirigenti\MB_DataAdapter.xml"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="307"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="688"/>
		<parameter name="date0101_DettaglioObiettiviSettore" class="java.util.Date"/>
		<parameter name="date3112_DettaglioObiettiviSettore" class="java.util.Date"/>
		<parameter name="work_effort_id_DettaglioObiettiviSettore" class="java.lang.String"/>
		<queryString language="SQL">
			<![CDATA[select * from (
	select 
		wea.work_effort_id_from,
		gl.account_name,
		gl.description,
		gl.gl_resource_type_id,
		scorekpi.amount,
		grt.description as resource_type_description
	from work_effort_assoc wea
	join work_effort we on we.work_effort_id = wea.work_effort_id_to and we.work_effort_type_id = '20IN60CPO' and we.work_effort_revision_id is null
		and we.estimated_start_date <= $P{date3112_DettaglioObiettiviSettore} and (we.estimated_completion_date >= $P{date0101_DettaglioObiettiviSettore} or we.estimated_completion_date is null)
	join work_effort_assoc wea2 on wea2.work_effort_id_from = we.work_effort_id and wea2.work_effort_assoc_type_id = '20INC'
	join work_effort we2 on we2.work_effort_id = wea2.work_effort_id_to and we2.work_effort_type_id = '20P44SER' and we2.work_effort_revision_id is null
			and we2.estimated_start_date <= $P{date3112_DettaglioObiettiviSettore} and (we2.estimated_completion_date >= $P{date0101_DettaglioObiettiviSettore} or we2.estimated_completion_date is null)
	join work_effort_measure wem on wem.work_effort_id = we2.work_effort_id and wem.gl_account_id <> 'SCORE'
	join work_effort_purpose_account wepa on wepa.gl_account_id = wem.gl_account_id and wepa.work_effort_purpose_type_id = 'OBPINS'
	join gl_account gl on gl.gl_account_id = wem.gl_account_id 
	left join (
		select 
			act.voucher_ref,
			ate.amount
		from acctg_trans act
		join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id and ate.gl_account_id = 'SCOREKPI'
		where act.transaction_date = $P{date3112_DettaglioObiettiviSettore}
	) scorekpi on scorekpi.voucher_ref = wem.work_effort_measure_id 
	left join gl_resource_type grt on gl.gl_resource_type_id = grt.gl_resource_type_id 
	where wea.work_effort_assoc_type_id = '20I'
	order by
		we2.source_reference_id 
) as dettaglio_obiettivi_settore
where dettaglio_obiettivi_settore.work_effort_id_from = $P{work_effort_id_DettaglioObiettiviSettore}
order by dettaglio_obiettivi_settore.account_name]]>
		</queryString>
