		<property name="com.jaspersoft.studio.field.name" value="Matricola"/>
		<property name="com.jaspersoft.studio.field.label" value="Matricola"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="party_parent_role"/>
	</field>
	<field name="Categoria economica" class="java.lang.String">
