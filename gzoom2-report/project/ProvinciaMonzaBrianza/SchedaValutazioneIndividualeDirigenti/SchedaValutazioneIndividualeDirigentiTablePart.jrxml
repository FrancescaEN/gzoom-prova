	<subDataset name="DatasetObiettiviEsecutivi" uuid="917dffba-05a4-44b1-ae72-8696d23f4fd6">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.xml"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="personId" class="java.lang.String" isForPrompting="false"/>
		<parameter name="date3112" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilDateTime.getMonthEndFromDatetime("12",$P{REPORT_TIME_ZONE}.getID(),YEAR($P{monitoringDate}), $P{REPORT_LOCALE}.getDefault())]]></defaultValueExpression>
		</parameter>
		<parameter name="date0101" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilDateTime.getMonthStartFromDatetime("1",$P{REPORT_TIME_ZONE}.getID(),YEAR($P{monitoringDate}), $P{REPORT_LOCALE}.getDefault())]]></defaultValueExpression>
		</parameter>
		<parameter name="monitoringDate" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[TODAY( )]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select * from (	
	select 
		wea.work_effort_id_from as work_effort,
		concat(we.source_reference_id, ' - ', we.work_effort_name) as nome,
		1 as sequenza,
		wea.assoc_weight,
		score.amount
	from work_effort_assoc wea
	join work_effort we on we.work_effort_id = wea.work_effort_id_to and we.work_effort_type_id = '20P44OPD' and we.work_effort_revision_id is null
		and we.estimated_start_date <= '31-12-2022' and (we.estimated_completion_date >= '01-01-2022' or we.estimated_completion_date is null)
	left join (
		select 
			wem.work_effort_id,
			ate.amount
		from work_effort_measure wem 
		join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id and ate.gl_account_id = 'SCORE'
	) score on score.work_effort_id = we.work_effort_id 
	where wea.work_effort_assoc_type_id = '20INC'
	union all
	select 
		wem.work_effort_id as work_effort,
		gl.account_name as nome,
		2 as sequenza,
		null,
		null
	from work_effort_measure wem 
	join gl_account gl on gl.gl_account_id = wem.gl_account_id 
	where wem.gl_account_id <> 'SCORE'
) as obiettivi_esecutivi
where obiettivi_esecutivi.work_effort = '12695_cc'
order by obiettivi_esecutivi.sequenza, obiettivi_esecutivi.nome]]>
		</queryString>
		<field name="work_effort" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="work_effort"/>
			<property name="com.jaspersoft.studio.field.label" value="work_effort"/>
		</field>
		<field name="nome" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="nome"/>
			<property name="com.jaspersoft.studio.field.label" value="nome"/>
		</field>
		<field name="sequenza" class="java.lang.Integer">
			<property name="com.jaspersoft.studio.field.name" value="sequenza"/>
			<property name="com.jaspersoft.studio.field.label" value="sequenza"/>
		</field>
		<field name="assoc_weight" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="assoc_weight"/>
			<property name="com.jaspersoft.studio.field.label" value="assoc_weight"/>
		</field>
		<field name="amount" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="amount"/>
			<property name="com.jaspersoft.studio.field.label" value="amount"/>
		</field>
		<group name="Raggiungimento tipologia obiettivo">
			<groupExpression><![CDATA[$F{work_effort}]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="Dataset_ObiettiviEOIndicatoriDiPerformance" uuid="010c3433-aff8-420f-9b8f-a5e44d92cde2">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.xml"/>
		<parameter name="work_effort_id_obiettivi_esecutivi" class="java.lang.String">
			<defaultValueExpression><![CDATA[$P{work_effort_id_obiettivi_esecutivi}]]></defaultValueExpression>
		</parameter>
		<queryString language="SQL">
			<![CDATA[select * from (	
	select 
		wea.work_effort_id_from as work_effort,
		concat(we.source_reference_id, ' - ', we.work_effort_name) as nome,
		1 as sequenza,
		wea.assoc_weight,
		score.amount,
		'PIPPO' as pippo
	from work_effort_assoc wea
	join work_effort we on we.work_effort_id = wea.work_effort_id_to and we.work_effort_type_id = '20P44OPD' and we.work_effort_revision_id is null
		and we.estimated_start_date <= '31-12-2022' and (we.estimated_completion_date >= '01-01-2022' or we.estimated_completion_date is null)
	left join (
		select 
			wem.work_effort_id,
			ate.amount
		from work_effort_measure wem 
		join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id and ate.gl_account_id = 'SCORE'
	) score on score.work_effort_id = we.work_effort_id 
	where wea.work_effort_assoc_type_id = '20INC'
	union all
	select 
		wem.work_effort_id as work_effort,
		gl.account_name as nome,
		2 as sequenza,
		null,
		null,
		'PIPPO' as pippo
	from work_effort_measure wem 
	join gl_account gl on gl.gl_account_id = wem.gl_account_id 
	where wem.gl_account_id <> 'SCORE'
) as obiettivi_esecutivi
where obiettivi_esecutivi.work_effort = $P{work_effort_id_obiettivi_esecutivi}
order by obiettivi_esecutivi.sequenza, obiettivi_esecutivi.nome]]>
		</queryString>
		<field name="nome" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="nome"/>
			<property name="com.jaspersoft.studio.field.label" value="nome"/>
		</field>
		<field name="pippo" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="pippo"/>
			<property name="com.jaspersoft.studio.field.label" value="pippo"/>
		</field>
		<group name="pippo">
			<groupExpression><![CDATA[$F{pippo}]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="Dataset_ComportamentiOrganizzativi" uuid="2de8e2da-2509-4c0b-a29f-c37332c46153">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="NO_DATA_ADAPTER"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="350"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="646"/>
		<parameter name="date0101" class="java.util.Date"/>
		<parameter name="date3112" class="java.util.Date"/>
		<parameter name="personId" class="java.lang.String"/>
		<parameter name="work_effort_id_comportamenti_organizzativi" class="java.lang.String">
			<defaultValueExpression><![CDATA["12649"]]></defaultValueExpression>
		</parameter>
		<parameter name="monitoringDate" class="java.util.Date">
			<defaultValueExpression><![CDATA[TODAY()]]></defaultValueExpression>
		</parameter>
		<parameter name="valore_comport_comparto_comportamenti_organizzativi" class="java.lang.Double"/>
		<parameter name="_testMode" class="java.lang.Boolean">
			<defaultValueExpression><![CDATA[false]]></defaultValueExpression>
		</parameter>
		<parameter name="estAnte_ComportamentiOrganizzativi" class="java.lang.Boolean"/>
		<parameter name="valore_comp_org_dirigenti" class="java.lang.Double"/>
		<queryString>
			<![CDATA[select * from (
	select 
		wea.work_effort_id_from,
		gamrs.uom_code,
		gl.account_name,
		grt.description,
		wea.assoc_weight,
		grt.gl_resource_type_id, 
		gl.account_code
	from work_effort_assoc wea
	join work_effort we on we.work_effort_id = wea.work_effort_id_to and we.work_effort_type_id in ('20IN24COM', '20IN44COM') and we.work_effort_revision_id is null
		and we.estimated_start_date <= $P{date3112} and (we.estimated_completion_date >= $P{date0101} or we.estimated_completion_date is null)
	join work_effort_measure wem on wem.work_effort_id = we.work_effort_id 
	join gl_account gl on gl.gl_account_id = wem.gl_account_id 
	join gl_resource_type grt on grt.gl_resource_type_id = gl.gl_resource_type_id 
	left join (
		select 
			ate.amount,
			act.voucher_ref
		from acctg_trans act 
		join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id and ate.gl_account_id = 'SCOREKPI'
		where act.transaction_date = $P{date3112}
	) scorekpi on scorekpi.voucher_ref = wem.work_effort_measure_id 
	left join gl_account_meas_rat_sc gamrs on gamrs.gl_account_id = wem.gl_account_id 
		and gamrs.uom_rating_value = scorekpi.amount 
	where wea.work_effort_assoc_type_id = '20I' and wem.gl_account_id <> 'SCORE'
) as comportamenti_organizzativi
where comportamenti_organizzativi.work_effort_id_from = $P{work_effort_id_comportamenti_organizzativi}
order by 
		comportamenti_organizzativi.gl_resource_type_id, 
		comportamenti_organizzativi.account_code]]>
		</queryString>
		<field name="work_effort_id_from" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="work_effort_id_from"/>
			<property name="com.jaspersoft.studio.field.label" value="work_effort_id_from"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort_assoc"/>
		</field>
		<field name="uom_code" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="uom_code"/>
			<property name="com.jaspersoft.studio.field.label" value="uom_code"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="gl_account_meas_rat_sc"/>
		</field>
		<field name="account_name" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="account_name"/>
			<property name="com.jaspersoft.studio.field.label" value="account_name"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="gl_account"/>
		</field>
		<field name="description" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="description"/>
			<property name="com.jaspersoft.studio.field.label" value="description"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="gl_resource_type"/>
		</field>
		<field name="assoc_weight" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="assoc_weight"/>
			<property name="com.jaspersoft.studio.field.label" value="assoc_weight"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort_assoc"/>
		</field>
		<field name="gl_resource_type_id" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="gl_resource_type_id"/>
			<property name="com.jaspersoft.studio.field.label" value="gl_resource_type_id"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="gl_resource_type"/>
		</field>
		<field name="account_code" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="account_code"/>
			<property name="com.jaspersoft.studio.field.label" value="account_code"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="gl_account"/>
		</field>
		<sortField name="gl_resource_type_id"/>
		<sortField name="account_code"/>
		<group name="Group_descrizione">
			<groupExpression><![CDATA[$F{description}]]></groupExpression>
		</group>
		<group name="Group_tipologia">
			<groupExpression><![CDATA[$F{account_name}]]></groupExpression>
