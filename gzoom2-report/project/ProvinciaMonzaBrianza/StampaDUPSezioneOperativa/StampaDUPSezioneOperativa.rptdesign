            <method name="beforeOpen"><![CDATA[//@monitoringDate
var monitoringDateString = '';
if (params["monitoringDate"].value != null &amp;&amp; params["monitoringDate"].value != '') {
	monitoringDateString = "and (data_stampa = '"+ params["monitoringDate"].value + "')";	
}
this.queryText = this.queryText.replace("@monitoringDate",  monitoringDateString );

//@orgUnitId
var orgUnitIdString = '';
if (params["orgUnitId"].value != null &amp;&amp; params["orgUnitId"].value != '') {
	orgUnitIdString = "and (org_unit_id = '"+ params["orgUnitId"].value + "')";	
}
this.queryText = this.queryText.replace("@orgUnitId",  orgUnitIdString );]]></method>
