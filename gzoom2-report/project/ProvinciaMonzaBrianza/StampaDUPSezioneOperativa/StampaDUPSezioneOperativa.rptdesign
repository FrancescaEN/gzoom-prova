            <xml-property name="queryText"><![CDATA[select r.*
from REPORT_DUPOPE_ENT r
inner join work_effort FIL_W on r.work_effort_id = FIL_W.work_effort_id
where r.work_effort_id = ?
and FIL_W.work_effort_snapshot_id is null
@monitoringDate
@orgUnitId]]></xml-property>
