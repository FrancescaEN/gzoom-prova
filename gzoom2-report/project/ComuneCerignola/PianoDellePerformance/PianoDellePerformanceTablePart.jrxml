		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="cerignola_PROD"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="date3112" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
		</parameter>
		<parameter name="date0101" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
		</parameter>
		<parameter name="idSchedaSettore" class="java.lang.String"/>
		<parameter name="monitoringDate" class="java.util.Date" isForPrompting="false"/>
		<queryString>
			<![CDATA[select *  from peg_scheda_settore
left join peg_obiettivi_operativi ON
peg_scheda_settore.id_scheda_settore = peg_obiettivi_operativi.id_scheda_settore
WHERE peg_scheda_settore.data_inizio_scheda_settore <= CAST($P{date3112} AS TIMESTAMP)
AND peg_scheda_settore.data_fine_scheda_settore >= CAST($P{date0101} AS TIMESTAMP)
AND peg_scheda_settore.id_scheda_settore = $P{idSchedaSettore} 
ORDER BY peg_scheda_settore.codice_settore]]>
		</queryString>
