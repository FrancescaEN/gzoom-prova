		<defaultValueExpression><![CDATA[SUBSTITUTE(com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc($P{date0101}, $P{odaDialect}),"'","")]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select *  from peg_scheda_settore FIL_W
 $P!{filterInnerJoinString} 
 $P!{filterLeftJoinString} 
left join peg_obiettivi_operativi ON
FIL_W.id_scheda_settore = peg_obiettivi_operativi.id_scheda_settore
WHERE FIL_W.data_inizio_scheda_settore <= CAST($P{date3112sql} AS TIMESTAMP)
AND FIL_W.data_fine_scheda_settore >= CAST($P{date0101sql} AS TIMESTAMP)
 $P!{filterWhereString} 
 $P!{orgUnitIdString} 
ORDER BY FIL_W.codice_settore]]>
	</queryString>
