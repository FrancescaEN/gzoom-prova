                </structure>
                <structure>
                    <property name="position">9</property>
                    <property name="name">TEMPI_MODI_ATTUAZIONE_NAME</property>
                    <property name="nativeName">TEMPI_MODI_ATTUAZIONE_NAME</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">10</property>
                    <property name="name">RESP_MISURA</property>
                    <property name="nativeName">RESP_MISURA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">11</property>
                    <property name="name">TEMPI_MODI_ATTUAZIONE</property>
                    <property name="nativeName">TEMPI_MODI_ATTUAZIONE</property>
