            <xml-property name="queryText"><![CDATA[select 
  u1.from_value as "U1_FROM_VALUE", 
  u1.thru_value as "U1_THRU_VALUE",
  u2.from_value as "U2_FROM_VALUE", 
  u2.thru_value as "U2_THRU_VALUE",
  u3.from_value as "U3_FROM_VALUE", 
  u3.thru_value as "U3_THRU_VALUE",
  u4.from_value as "U4_FROM_VALUE", 
  u4.thru_value as "U4_THRU_VALUE"
from uom_range_values u1 
inner join uom_range_values u2 on u2.uom_range_values_id = 'CORRIS04'
inner join uom_range_values u3 on u3.uom_range_values_id = 'CORRIS09'
inner join uom_range_values u4 on u4.uom_range_values_id = 'CORRIS15'
where u1.uom_range_values_id = 'CORRIS00']]></xml-property>
