            <xml-property name="queryText"><![CDATA[select 
  d.work_effort_id as "WORK_EFFORT_ID", 
  d.etch as "ETCH",
  d.work_effort_name as "WORK_EFFORT_NAME", 
  count(valut_basso.*) as "COUNT_BASSO", 
  count(valut_medio.*) as "COUNT_MEDIO",
  count(valut_medio_alto.*) as "COUNT_MEDIO_ALTO", 
  count(valut_alto.*) as "COUNT_ALTO"
from work_effort_assoc a
inner join work_effort b on b.work_effort_id = a.work_effort_id_to
    and b.work_effort_revision_id is null
    and (@excludeValidity = 'Y' or (@excludeValidity = 'N' and b.estimated_start_date <= @date3112 and (b.estimated_completion_date is null or b.estimated_completion_date >= @date0101)))
inner join work_effort_assoc c on c.work_effort_id_from = b.work_effort_id
    and c.work_effort_assoc_type_id = '15APPPC'
inner join work_effort d on d.work_effort_id = c.work_effort_id_to
    and d.work_effort_revision_id is null
    and (@excludeValidity = 'Y' or (@excludeValidity = 'N' and d.estimated_start_date <= @date3112 and (d.estimated_completion_date is null or d.estimated_completion_date >= @date0101)))
inner join work_effort_assoc e on e.work_effort_id_from = d.work_effort_id
    and e.work_effort_assoc_type_id = '15APSARC'
inner join work_effort f on f.work_effort_id = e.work_effort_id_to
    and f.work_effort_revision_id is null
    and (@excludeValidity = 'Y' or (@excludeValidity = 'N' and f.estimated_start_date <= @date3112 and (f.estimated_completion_date is null or f.estimated_completion_date >= @date0101)))
left join (
	select 
		wem.work_effort_id, ate.amount
	from work_effort_measure wem
	inner join acctg_trans act on act.voucher_ref = wem.work_effort_measure_id 
	    and act.transaction_date <= @date3112 
	    and act.transaction_date >= @date0101
	inner join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id
	    and ate.amount >= ? and ate.amount <= ?
	where ate.gl_account_id = 'SCOREKPI'
) valut_basso on valut_basso.work_effort_id = f.work_effort_id

left join (
	select 
		wem.work_effort_id, ate.amount
	from work_effort_measure wem
	inner join acctg_trans act on act.voucher_ref = wem.work_effort_measure_id 
	    and act.transaction_date <= @date3112 
	    and act.transaction_date >= @date0101
	inner join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id
	    and ate.amount >= ? and ate.amount <= ?
	where ate.gl_account_id = 'SCOREKPI'
) valut_medio on valut_medio.work_effort_id = f.work_effort_id

left join (
	select 
		wem.work_effort_id, ate.amount
	from work_effort_measure wem
	inner join acctg_trans act on act.voucher_ref = wem.work_effort_measure_id 
	    and act.transaction_date <= @date3112 
	    and act.transaction_date >= @date0101
	inner join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id
	    and ate.amount >= ? and ate.amount <= ?
	where ate.gl_account_id = 'SCOREKPI'
) valut_medio_alto on valut_medio_alto.work_effort_id = f.work_effort_id

left join (
	select 
		wem.work_effort_id, ate.amount
	from work_effort_measure wem
	inner join acctg_trans act on act.voucher_ref = wem.work_effort_measure_id 
	    and act.transaction_date <= @date3112 
	    and act.transaction_date >= @date0101
	inner join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id
	    and ate.amount >= ? and ate.amount <= ?
	where ate.gl_account_id = 'SCOREKPI'
) valut_alto on valut_alto.work_effort_id = f.work_effort_id

where a.work_effort_id_from = ?
  and a.work_effort_assoc_type_id = '15APPPC'
  @orgUnitId
group by 
  d.work_effort_id, 
  d.etch,
  d.work_effort_name
order by d.etch]]></xml-property>
