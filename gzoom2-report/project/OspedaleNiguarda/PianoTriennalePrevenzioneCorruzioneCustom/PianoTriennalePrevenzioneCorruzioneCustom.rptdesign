</model:DesignValues>]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="MaxScoreDS" id="58942">
            <list-property name="columnHints"/>
            <list-property name="parameters">
                <structure>
                    <property name="name">workEffortId</property>
                    <property name="nativeName"></property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">0</property>
                    <property name="position">1</property>
                    <expression name="defaultValue" type="constant">N/A</expression>
                    <property name="isOptional">false</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">valore</property>
                        <property name="dataType">float</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">commento</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">emoticon</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <method name="beforeOpen"><![CDATA[this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value );

//this.queryText = this.queryText.replace("@date3112",  "'2019-12-31 00:00:00.000'" );
//this.queryText = this.queryText.replace("@date0101",  "'2019-01-01 00:00:00.000'" );

//ReportLog.info("......QUERYSCORE "+this.queryText);
//ReportLog.info(".....VALORI "+this.getInputParameters());]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">valore</property>
                    <property name="nativeName">valore</property>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">commento</property>
                    <property name="nativeName">commento</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">emoticon</property>
                    <property name="nativeName">emoticon</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select 
	max(rp.amount) as VALORE, 
	vp."comments" as COMMENTO,
	ep.object_info as EMOTICON
/* AREA DI RISCHIO */
from work_effort sp
/* PROCESSI FIGLI */
join work_effort_assoc wea on wea.work_effort_id_from = sp.work_effort_id and wea.work_effort_assoc_type_id = '15APSARC'
join work_effort proc on proc.work_effort_id = wea.work_effort_id_to and proc.work_effort_type_id = '15AP3PRO' and proc.work_effort_revision_id is null
	and proc.estimated_start_date <= @date3112	
	and proc.estimated_completion_date >= @date0101
/* PUNTEGGIO PROCESSI FIGLI */
left join (
	select 
		wem.work_effort_id,
		ate.amount 
	from work_effort_measure wem
	join acctg_trans act on act.voucher_ref = wem.work_effort_measure_id and act.transaction_date = @date3112	
	join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id and ate.gl_account_id = 'SCORE'
) rp on rp.work_effort_id = proc.work_effort_id 
/* SCALA DI VALORI */
join uom_range_values vp on vp.uom_range_id = 'CORRIS' and vp.from_value <= rp.amount and vp.thru_value >= rp.amount
	and rp.amount = (
		select 
			max(ate.amount)
		from work_effort_measure wem
		join work_effort proc on proc.work_effort_id = wem.work_effort_id and proc.work_effort_type_id = '15AP3PRO' and proc.work_effort_revision_id is null
			and proc.estimated_start_date <= @date3112	
			and proc.estimated_completion_date >= @date0101
		join work_effort_assoc wea on wea.work_effort_id_to = proc.work_effort_id and wea.work_effort_assoc_type_id = '15APSARC'
		join acctg_trans act on act.voucher_ref = wem.work_effort_measure_id and act.transaction_date = @date3112	
		join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id and ate.gl_account_id = 'SCORE'
		where wea.work_effort_id_from = sp.work_effort_id
		group by wea.work_effort_id_from 
	)		
join content c on c.content_id = vp.icon_content_id 
join data_resource ep on ep.data_resource_id = c.data_resource_id
where sp.work_effort_id = ?
group by
	vp."comments",
	ep.object_info]]></xml-property>
        </oda-data-set>
    </data-sets>
