        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="ScoreDS" id="58497">
            <list-property name="columnHints"/>
            <list-property name="parameters">
                <structure>
                    <property name="name">param_1</property>
                    <property name="nativeName"></property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">0</property>
                    <property name="position">1</property>
                    <expression name="defaultValue" type="constant">""</expression>
                    <property name="isOptional">false</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">AMOUNT</property>
                        <property name="dataType">float</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">COMMENTS</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">OBJECT_INFO</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">4</property>
                        <property name="name">DECIMAL_SCALE</property>
                        <property name="dataType">decimal</property>
                    </structure>
                    <structure>
                        <property name="position">5</property>
                        <property name="name">ABBREVIATION</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <method name="beforeOpen"><![CDATA[this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );

//this.queryText = this.queryText.replace("@date3112",  "'2019-12-31 00:00:00.000'" );

ReportLog.info("......QUERYSCORE "+this.queryText);
ReportLog.info(".....VALORI "+this.getInputParameters());]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">AMOUNT</property>
                    <property name="nativeName">AMOUNT</property>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">COMMENTS</property>
                    <property name="nativeName">COMMENTS</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">OBJECT_INFO</property>
                    <property name="nativeName">OBJECT_INFO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">DECIMAL_SCALE</property>
                    <property name="nativeName">DECIMAL_SCALE</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">ABBREVIATION</property>
                    <property name="nativeName">ABBREVIATION</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select 
	rp.amount as "AMOUNT",		
	vp.comments as "COMMENTS",
	ep.object_info as "OBJECT_INFO",
	uom.decimal_scale as "DECIMAL_SCALE",
	uom.abbreviation as "ABBREVIATION"
from work_effort sp
inner join work_effort_type spt on spt.work_effort_type_id = sp.work_effort_type_id
left join work_effort_measure wm on wm.work_effort_id = sp.work_effort_id 
    and wm.we_measure_type_enum_id = 'WEMT_SCORE'
left join gl_account ac on ac.gl_account_id = wm.gl_account_id 	
left join uom uom on ac.default_uom_id = uom.uom_id	
-- score
left join (																											
	select tp.voucher_ref, tp.transaction_date, ep.amount																										
	from acctg_trans tp																										
		inner join acctg_trans_entry ep on ep.acctg_trans_id = tp.acctg_trans_id																									
	where ep.gl_account_id = 'SCORE' and ep.gl_fiscal_type_id = 'CORRIS'																										
	) rp on rp.voucher_ref = wm.work_effort_measure_id  
	    and rp.transaction_date = @date3112																							
left join uom_range_values vp on vp.uom_range_id = spt.uom_range_score_id																											
		and vp.from_value <= rp.amount and vp.thru_value >= rp.amount		
left join enumeration cp on cp.enum_id = vp.color_enum_id																											
left join content ip on ip.content_id = vp.icon_content_id																											
left join data_resource ep on ep.data_resource_id = ip.data_resource_id	
where sp.work_effort_id = ?]]></xml-property>
        </oda-data-set>
