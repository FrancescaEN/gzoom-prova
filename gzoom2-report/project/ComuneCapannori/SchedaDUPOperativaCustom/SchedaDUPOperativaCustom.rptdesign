            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">seq_refpol</property>
                    <property name="nativeName">seq_refpol</property>
                    <property name="dataType">integer</property>
                    <property name="nativeDataType">4</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">tipo_refpole</property>
                    <property name="nativeName">tipo_refpole</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">ruolo_refpol</property>
                    <property name="nativeName">ruolo_refpol</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">referente_politico</property>
                    <property name="nativeName">referente_politico</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select
ooass.sequence_num as seq_refpol, assrole.role_type_id as tipo_refpole, assrole.description as ruolo_refpol, ass.party_name as referente_politico
from 
work_effort_party_assignment ooass 
inner join party ass on ass.party_id = ooass.party_id
inner join role_type assrole on assrole.role_type_id = ooass.role_type_id
where ooass.work_effort_id = ? -- main.work_effort_id
  and (ooass.from_date is null or ooass.from_date <= @monitoringDate) -- input.ref_date
  and (ooass.thru_date is null or ooass.thru_date >= @monitoringDate) -- input.ref_date
order by ooass.sequence_num, assrole.role_type_id, ass.party_name
]]></xml-property>
