    <body>
        <grid name="masterGrid" id="41049">
            <property name="width">100%</property>
            <column id="41050">
                <property name="width">100%</property>
            </column>
            <row id="50958">
                <property name="style">std1-16-center-rgb213x213x213</property>
                <property name="backgroundColor">#D5D5D5</property>
                <property name="borderLeftColor">#808080</property>
                <property name="borderLeftStyle">solid</property>
                <property name="borderLeftWidth">thin</property>
                <property name="borderRightColor">#808080</property>
                <property name="borderRightStyle">solid</property>
                <property name="borderRightWidth">thin</property>
                <property name="masterPage">BaseSimpleMasterPageNoPag_Postgres</property>
                <list-property name="visibility">
                    <structure>
                        <property name="format">all</property>
                        <expression name="valueExpr" type="javascript">(params["workEffortIdChild"].value != null &amp;&amp; params["workEffortIdChild"].value != '')</expression>
                    </structure>
                </list-property>
                <cell id="50959">
                    <property name="paddingTop">1pt</property>
                    <property name="paddingLeft">0pt</property>
                    <property name="paddingBottom">1pt</property>
                    <property name="paddingRight">0pt</property>
                    <text-data name="NewTextData312121" id="25247">
                        <property name="backgroundAttachment">scroll</property>
                        <property name="backgroundPositionX">0%</property>
                        <property name="backgroundPositionY">0%</property>
                        <property name="backgroundRepeat">repeat</property>
                        <property name="fontWeight">bold</property>
                        <property name="fontVariant">normal</property>
                        <property name="textOverline">none</property>
                        <property name="marginTop">5pt</property>
                        <property name="marginLeft">0pt</property>
                        <property name="marginBottom">5pt</property>
                        <property name="marginRight">0pt</property>
                        <property name="paddingTop">0pt</property>
                        <property name="paddingLeft">0pt</property>
                        <property name="paddingBottom">0pt</property>
                        <property name="paddingRight">0pt</property>
                        <property name="textIndent">0em</property>
                        <property name="letterSpacing">normal</property>
                        <property name="lineHeight">normal</property>
                        <property name="orphans">2</property>
                        <property name="textTransform">none</property>
                        <property name="verticalAlign">middle</property>
                        <property name="whiteSpace">normal</property>
                        <property name="widows">2</property>
                        <property name="wordSpacing">normal</property>
                        <property name="pageBreakAfter">auto</property>
                        <property name="pageBreakBefore">auto</property>
                        <property name="pageBreakInside">auto</property>
                        <property name="showIfBlank">false</property>
                        <property name="canShrink">false</property>
                        <property name="overflow">hidden</property>
                        <expression name="valueExpr">reportTitle + ' ' + BirtDateTime.year(params["monitoringDate"].value) + ' - ' + BirtMath.add(BirtDateTime.year(params["monitoringDate"].value),2)</expression>
                        <property name="contentType">html</property>
                    </text-data>
                </cell>
            </row>
            <row id="50960">
                <property name="masterPage">BaseSimpleMasterPageNoPag_Postgres</property>
                <property name="pageBreakAfter">auto</property>
                <property name="height">140mm</property>
                <list-property name="visibility">
                    <structure>
                        <property name="format">all</property>
                        <expression name="valueExpr" type="javascript">(params["workEffortIdChild"].value != null &amp;&amp; params["workEffortIdChild"].value != '')</expression>
                    </structure>
                </list-property>
                <cell id="50961">
                    <property name="paddingTop">1pt</property>
                    <property name="paddingLeft">0pt</property>
                    <property name="paddingBottom">1pt</property>
                    <property name="paddingRight">0pt</property>
                    <property name="textAlign">center</property>
                    <property name="verticalAlign">middle</property>
                    <image id="25252">
                        <property name="source">file</property>
                        <property name="fitToContainer">true</property>
                        <expression name="uri" type="javascript">reportContext.getPersistentGlobalVariable("logo_login");</expression>
                    </image>
                    <label id="57101">
                        <property name="style">fieldLabel-10-bold</property>
                        <property name="fontSize">16pt</property>
                        <property name="marginTop">80pt</property>
                        <text-property name="text" key="sezione_operativa"></text-property>
                    </label>
                    <text-data id="57924">
                        <property name="textAlign">left</property>
                        <list-property name="visibility">
                            <structure>
                                <property name="format">all</property>
                                <expression name="valueExpr" type="javascript">params["Comment"].value==null || params["Comment"].value==""</expression>
                            </structure>
                        </list-property>
                        <expression name="valueExpr">params["Comment"].value</expression>
                        <property name="contentType">html</property>
                    </text-data>
                </cell>
            </row>
