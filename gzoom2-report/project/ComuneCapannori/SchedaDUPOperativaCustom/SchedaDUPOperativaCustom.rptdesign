            <method name="beforeOpen"><![CDATA[//this.queryText = this.queryText.replace("@excludePerformanceKPI", "'" + params["excludePerformanceKPI"].value+ "'");
//this.queryText = this.queryText.replace("@excludeValidity", "'" + params["excludeValidity"].value+ "'");
/**/
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value );
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );																
this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );

/* 
this.queryText = this.queryText.replace("@date0101",  "'2021-01-01 00:00:00.000'" );
this.queryText = this.queryText.replace("@date3112",  "'2021-12-31 00:00:00.000'" );
this.queryText = this.queryText.replace("@monitoringDate",  "'2021-12-31 00:00:00.000'" ); 
*/
//@orgUnitId
var orgUnitIdString = '';
if (params["orgUnitId"].value != null &amp;&amp; params["orgUnitId"].value != '') {
	orgUnitIdString = "and (uooo.party_id = '"+ params["orgUnitId"].value + "' or (uoso.party_id is not null and uoso.party_id = '"+ params["orgUnitId"].value + "'))";	
}
this.queryText = this.queryText.replace("@orgUnitId",  orgUnitIdString );

//ReportLog.info("... SCHEDA DUP orgunitid this.queryText= "+params["orgUnitId"].value);

//@partyId Reponsabilità politica ass_party_id
var partyId = '';
if (params["politicianRoleTypeId"].value != null &amp;&amp; params["politicianRoleTypeId"].value != '') {
	partyId = " and (ass.party_id is not null and ass.party_id = '"+params["politicianRoleTypeId"].value+"') ";
}
this.queryText = this.queryText.replace("@partyId",  partyId );


//@personId Responsabilità tecnica resp_party_id
var personId = '';
if (params["personId"].value != null &amp;&amp; params["personId"].value != '') {
	personId = "and ((uooopa.party_id is not null and uooopa.party_id = '"+params["personId"].value+"') or (uosopa.party_id is not null and uosopa.party_id = '"+params["personId"].value+"'))";
}
this.queryText = this.queryText.replace("@personId",  personId );

//WorkEffortId->WorkEffortIdChild
var workEffortId = '';
if (params["workEffortIdParametric"].value != null &amp;&amp; params["workEffortIdParametric"].value != '') {
	/**/workEffortId = "and (lm.work_effort_id in ("+params["workEffortIdParametric"].value+") or os.work_effort_id in ("+params["workEffortIdParametric"].value+") or FIL_W.work_effort_id in ("+params["workEffortIdParametric"].value+")"
	+" or ri.work_effort_id in ("+params["workEffortIdParametric"].value+") or FIL_W.work_effort_id in ("+params["workEffortIdParametric"].value+") or pr.work_effort_id in ("+params["workEffortIdParametric"].value+") or mi.work_effort_id in ("+params["workEffortIdParametric"].value+") or so.work_effort_id in ("+params["workEffortIdParametric"].value+")) ";
}
this.queryText = this.queryText.replace("@workEffortId",  workEffortId );


//@workEffortEtch
var workEffortEtch = '';
if(params["workEffortEtch"].value!=null &amp;&amp; params["workEffortEtch"].value!= '') {
	workEffortEtch = " and FIL_W.ETCH like '%"+params["workEffortEtch"].value+"%' ";
}
this.queryText = this.queryText.replace("@workEffortEtch",  workEffortEtch );

//@codiceObpeg
var codiceObpeg = '';
if(params["codiceObpeg"].value!=null &amp;&amp; params["codiceObpeg"].value!= '') {
	codiceObpeg = " and FIL_W.SOURCE_REFERENCE_ID like '%"+params["codiceObpeg"].value+"%' ";
}
this.queryText = this.queryText.replace("@codiceObpeg",  codiceObpeg );

//@workEffortName
var workEffortName = '';
if(params["workEffortName"].value!=null &amp;&amp; params["workEffortName"].value!= '') {
	workEffortName = " and FIL_W.work_effort_name like '%"+params["workEffortName"].value+"%' ";
}
this.queryText = this.queryText.replace("@workEffortName",  workEffortName );

//Revision id
var revision = '';
if(params["workEffortRevision"].value != null &amp;&amp; params["workEffortRevision"].value != '') {
	revision = " and FIL_W.work_effort_revision_id = '"+params["workEffortRevision"].value+"' and proo.work_effort_revision_id = '"+params["workEffortRevision"].value+"' ";
}
else {
	revision = " and FIL_W.work_effort_revision_id is null and proo.work_effort_revision_id is null ";
}
this.queryText = this.queryText.replace("@revision",  revision );

// Verifica assessori
var assessors = '';
/**/if (params["assessors"].value != null &amp;&amp; params["assessors"].value != '') {
	if (params["assessors"].value == 'ONLY_VERIFIED'){
		assessors = "and (ae.amount is not null and ae.amount = 100)";
	} else if (params["assessors"].value == 'NOT_COMPILED'){
		assessors = "and (ae.amount is null or ae.amount <> 100) ";
	}
}
this.queryText = this.queryText.replace("@assessors",  assessors );

var scoreActual = '';
if(params["scoreActual"].value != null &amp;&amp; params["scoreActual"].value != '') {
/**/
	if (params["scoreActual"].value == 'SCOREACTUAL_SNR'){
		score = " and ris.range_values_factor is not null and ris.range_values_factor = 0 ";
	} else if (params["scoreActual"].value == 'SCOREACTUAL_NRP'){
		score = " and ris.range_values_factor is not null and ris.range_values_factor <> 100 ";
	} else if (params["scoreActual"].value == 'SCOREACTUAL_TCA'){
		score = " and  ris.range_values_factor is not null ";
	} else if (params["scoreActual"].value == 'SCOREACTUAL_SNC'){
		score = " and  ris.range_values_factor is null ";
	}

}
this.queryText = this.queryText.replace("@scoreActual",  scoreActual );

//ReportLog.info("... SCHEDA DUP workEffortIdChild this.queryText= "+params["workEffortId20D6"].value);

//GESTIRE PERMESSI
/* */
filter = new com.mapsengineering.base.birt.util.UtilFilter(params["userLoginId"].value, params["localDispatcherName"].value);
var filterInnerJoin = filter.getWorkEffortFilterInner();
var filterLeftJoin = filter.getWorkEffortFilterLeftJoin();
var filterWhere = filter.getWorkEffortFilterWhere();

/*   
var filterInnerJoin = "";
var filterLeftJoin = "";
var filterWhere = "";
*/
this.queryText = this.queryText.replace("@filterInnerJoin",  filterInnerJoin );
this.queryText = this.queryText.replace("@filterLeftJoin",  filterLeftJoin );
this.queryText = this.queryText.replace("@filterWhere",  filterWhere );


ReportLog.info("... SCHEDA DUP this.queryText= "+this.queryText);
ReportLog.info("PARAMS= "+this.getInputParameters());]]></method>
