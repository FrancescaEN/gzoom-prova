                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select
uosoc.parent_role_code as codice_altrauo, uoso.party_name as altreuo_operativo
from 
 work_effort_assoc ooso
inner join work_effort so on so.work_effort_id = ooso.work_effort_id_to
inner join party uoso on uoso.party_id = so.org_unit_id
inner join party_parent_role uosoc on uosoc.party_id = uoso.party_id
 and uosoc.role_type_id = 'ORGANIZATION_UNIT'
inner join party_group uosog on uosog.party_id = uoso.party_id
where  ooso.work_effort_id_from = ? -- input.work_effort_id 
  and ooso.work_effort_assoc_type_id = '20D6O' 
  and ooso.from_date <= @monitoringDate     -- input.ref_date
  and ooso.thru_date >= @monitoringDate     -- input.ref_date
order by uosoc.parent_role_code
]]></xml-property>
