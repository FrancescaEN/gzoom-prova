            <xml-property name="queryText"><![CDATA[select concat(we.etch, ' - ', we.work_effort_name) as work_effort_name,
wetav.m_work_effort_id as work_effort_id,
gl.account_name,
gl.gl_account_id,
wetav.m_uom_descr,
wetav.g_uom_abbreviation,
wetav.g_uom_type_id,
max(case when wetav.tt_transaction_date = @date3112 and wetav.tm_gl_fiscal_type_id = 'BUDGET' then wetav.tm_amount else null end) as target_num,
max(case when wetav.tt_transaction_date = @fineannosuccessivo and wetav.tm_gl_fiscal_type_id = 'BUDGET' then wetav.tm_amount else null end) as target1_num,
max(case when wetav.tt_transaction_date = @date1231menouno and wetav.tm_gl_fiscal_type_id = 'ACTUAL' then wetav.tm_amount else null end) as actual1_num,
max(case when wetav.tt_transaction_date = @date1231menodue and wetav.tm_gl_fiscal_type_id = 'ACTUAL' then wetav.tm_amount else null end) as actual2_num,
max(case when wetav.tt_transaction_date = @date3112 and wetav.tm_gl_fiscal_type_id = 'BUDGET' then wetav.r_uom_descr else null end) as target_str,
max(case when wetav.tt_transaction_date = @fineannosuccessivo and wetav.tm_gl_fiscal_type_id = 'BUDGET' then wetav.r_uom_descr else null end) as target1_str,
max(case when wetav.tt_transaction_date = @date1231menouno and wetav.tm_gl_fiscal_type_id = 'ACTUAL' then wetav.r_uom_descr else null end) as actual1_str,
max(case when wetav.tt_transaction_date = @date1231menodue and wetav.tm_gl_fiscal_type_id = 'ACTUAL' then wetav.r_uom_descr else null end) as actual2_str,
max(case when wetav.tt_transaction_date = @date1231menouno and wetav.tm_gl_fiscal_type_id = 'ACTUAL' then wetav.tt_description else null end) as actual1_comm,
max(case when wetav.tt_transaction_date = @date1231menodue and wetav.tm_gl_fiscal_type_id = 'ACTUAL' then wetav.tt_description else null end) as actual2_comm
/* PRENDO TUTTI GLI INDICATORI, ANCHE QUELLI SENZA VALORI */
from work_effort_measure wem
join work_effort we on we.work_effort_id = wem.work_effort_id
join gl_account gl on gl.gl_account_id = wem.gl_account_id
join work_effort_purpose_account wepa on wepa.gl_account_id = wem.gl_account_id and wepa.work_effort_purpose_type_id = 'INDEFF'
left join work_effort_trans_all_view wetav on wetav.m_work_effort_measure_id = wem.work_effort_measure_id
where wem.work_effort_id = ?
group by concat(we.etch, ' - ', we.work_effort_name),
wetav.m_work_effort_id,
gl.account_name,
gl.gl_account_id,
wetav.m_uom_descr,
wetav.g_uom_type_id,
wetav.g_uom_abbreviation
union all 
select concat(peg.etch, ' - ', peg.work_effort_name) as work_effort_name,
wetav.m_work_effort_id as work_effort_id,
gl.account_name,
gl.gl_account_id,
wetav.m_uom_descr,
wetav.g_uom_abbreviation,
wetav.g_uom_type_id,
max(case when wetav.tt_transaction_date = @date3112 and wetav.tm_gl_fiscal_type_id = 'BUDGET' then wetav.tm_amount else null end) as target_num,
max(case when wetav.tt_transaction_date = @fineannosuccessivo and wetav.tm_gl_fiscal_type_id = 'BUDGET' then wetav.tm_amount else null end) as target1_num,
max(case when wetav.tt_transaction_date = @date1231menouno and wetav.tm_gl_fiscal_type_id = 'ACTUAL' then wetav.tm_amount else null end) as actual1_num,
max(case when wetav.tt_transaction_date = @date1231menodue and wetav.tm_gl_fiscal_type_id = 'ACTUAL' then wetav.tm_amount else null end) as actual2_num,
max(case when wetav.tt_transaction_date = @date3112 and wetav.tm_gl_fiscal_type_id = 'BUDGET' then wetav.r_uom_descr else null end) as target_str,
max(case when wetav.tt_transaction_date = @fineannosuccessivo and wetav.tm_gl_fiscal_type_id = 'BUDGET' then wetav.r_uom_descr else null end) as target1_str,
max(case when wetav.tt_transaction_date = @date1231menouno and wetav.tm_gl_fiscal_type_id = 'ACTUAL' then wetav.r_uom_descr else null end) as actual1_str,
max(case when wetav.tt_transaction_date = @date1231menodue and wetav.tm_gl_fiscal_type_id = 'ACTUAL' then wetav.r_uom_descr else null end) as actual2_str,
max(case when wetav.tt_transaction_date = @date1231menouno and wetav.tm_gl_fiscal_type_id = 'ACTUAL' then wetav.tt_description else null end) as actual1_comm,
max(case when wetav.tt_transaction_date = @date1231menodue and wetav.tm_gl_fiscal_type_id = 'ACTUAL' then wetav.tt_description else null end) as actual2_comm
from work_effort_assoc wea
join work_effort peg on peg.work_effort_id = wea.work_effort_id_to and peg.work_effort_revision_id is null
and peg.work_effort_type_id in ('20P44ASM', '20P44OOI')
and peg.estimated_start_date <= @date3112 and peg.estimated_completion_date >= @date0101
/* PRENDO SOLO GLI OBIETTIVI PEG CHE HANNO INDICATORI */
join work_effort_measure wem on wem.work_effort_id = peg.work_effort_id
join gl_account gl on gl.gl_account_id = wem.gl_account_id
join work_effort_purpose_account wepa on wepa.gl_account_id = wem.gl_account_id and wepa.work_effort_purpose_type_id in ('ORDIND', 'STRIND')
left join work_effort_trans_all_view wetav on wetav.m_work_effort_measure_id = wem.work_effort_measure_id
where wea.work_effort_assoc_type_id = '20D6OC' 
and wea.work_effort_id_from = ?
group by
concat(peg.etch, ' - ', peg.work_effort_name),
gl.gl_account_id,
wetav.m_work_effort_id,
gl.account_name,
wetav.m_uom_descr,
wetav.g_uom_abbreviation,
wetav.g_uom_type_id]]></xml-property>
        </oda-data-set>
    </data-sets>
    <styles>
        <style name="report" id="4">
            <property name="fontFamily">sans-serif</property>
            <property name="fontSize">10pt</property>
