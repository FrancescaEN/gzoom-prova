	<parameter name="orgUnitIdString" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$P{orgUnitId}  != null && $P{orgUnitId}  != "" ? " AND (EMPL.ID_STRUTTURA = '"+ $P{orgUnitId} + "' OR EMPL.ID_SCHEDA = '"+ $P{workEffortId} + "')" : " AND EMPL.ID_STRUTTURA like '%%'"]]></defaultValueExpression>
	</parameter>
	<parameter name="personIdString" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$P{personId}  != null && $P{personId}  != "" ? " AND (EMPL.ID_SOGGETTO = '"+ $P{personId} + "')" : " AND EMPL.ID_SOGGETTO like '%%'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select EMPL.* ,
to_char(EMPL.DATA_INIZIO, 'DD/MM/YYYY') as dataInizioFormattata,
to_char(EMPL.DATA_FINE, 'DD/MM/YYYY') as DataFineFormattata
from vw_scheda_valutazione EMPL
inner join work_effort FIL_W
on FIL_W.work_effort_id = EMPL.ID_SCHEDA
/* START filterInnerJoin */
   $P!{filterInnerJoinString} 
/* END filterInnerJoin */
/* START filterLeftJoin */
  $P!{filterLeftJoinString} 
/* END filterLeftJoin */
where EMPL.DATA_INIZIO <= CAST($P{date3112sql} AS TIMESTAMP) AND EMPL.DATA_FINE >= CAST($P{date0101sql} AS TIMESTAMP) 
and ( EMPL.ID_VALUTATORE is null or 
 ((EMPL.DATA_INIZIO_VALUTATORE <= CAST($P{date3112sql} AS TIMESTAMP) AND (EMPL.DATA_FINE_VALUTATORE >= CAST($P{date3112sql} AS TIMESTAMP) OR EMPL.DATA_FINE_VALUTATORE is NULL )))
)
  /* START filterWhere */
 $P!{filterWhereString} 
   /* END filterWhere */  
 /* START orgUnitIdString */
 $P!{orgUnitIdString}
 /* END orgUnitIdString */
 order by EMPL.nome_valutato, EMPL.codice_valutato]]>
	</queryString>
