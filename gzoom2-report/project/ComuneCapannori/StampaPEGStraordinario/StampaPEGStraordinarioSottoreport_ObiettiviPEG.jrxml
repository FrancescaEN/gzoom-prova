	<parameter name="workEffortRevision" class="java.lang.String" isForPrompting="false"/>
	<parameter name="workEffortRevisionString" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$P{workEffortRevision}  != null && $P{workEffortRevision}  != "" && LEN($P{workEffortRevision}) != 0  ? " AND peg.work_effort_revision_id = '"+ $P{workEffortRevision} + "'" : " AND peg.work_effort_revision_id is null"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[select peg.work_effort_id as ID_OBIETTIVO,
	peg.work_effort_name as NOME_OBIETTIVO,
	peg.source_reference_id as CODICE_OBIETTIVO,
	peg.etch as ETICHETTA_OBIETTIVO,
	strutt.org_unit_id as ID_STRUTTURA_OBIETTIVO,
	peg.estimated_start_date as DATA_INIZIO_OBIETTIVO,
	peg.estimated_completion_date as DATA_FINE_OBIETTIVO,
	peg.weight_kpi as PESO_INDICATORI,
	peg.weight_sons as PESO_FASI,
	obs.source_reference_id as CODICE_OBIETTIVO_DUP,
	obs.etch as ETICHETTA_OBIETTIVO_DUP,
	obs.work_effort_name as NOME_OBIETTIVO_DUP,
	obo.source_reference_id as CODICE_OBIETTIVO_OP_DUP,
	obo.etch as ETICHETTA_OBIETTIVO_OP_DUP,
	obo.work_effort_name as NOME_OBIETTIVO_OP_DUP,
	descr.note_info as DESCRIZIONE,
	mon.note_info as NOTE_MONITORAGGIO,
	val.amount as VALUTAZIONE_OBIETTIVO,
	score.amount as PUNTEGGIO
from work_effort_assoc wea2 
join work_effort peg on peg.work_effort_id = wea2.work_effort_id_to and peg.work_effort_type_id = '20P44ASM'
 $P!{workEffortRevisionString} 
/* SCHEDA DI STRUTTURA */
join work_effort strutt on strutt.work_effort_id = wea2.work_effort_id_from and wea2.work_effort_assoc_type_id = $P{workEffortAssocTypeId}
/* OBIETTIVO OPERATIVO DUP */
left join work_effort_assoc wea3 on wea3.work_effort_id_to = peg.work_effort_id and wea3.work_effort_assoc_type_id = '20D6OC'
 and wea3.work_effort_revision_id is null
left join work_effort obo on obo.work_effort_id = wea3.work_effort_id_from and obo.work_effort_revision_id is null
/* OBIETTIVO STRATEGICO DUP */
left join work_effort_assoc wea4 on wea4.work_effort_id_to = wea3.work_effort_id_from and wea4.work_effort_assoc_type_id = '20D6C'
 and wea4.work_effort_revision_id is null
left join work_effort obs on obs.work_effort_id = wea4.work_effort_id_from and obs.work_effort_revision_id is null
/* NOTE */
left join (
	select
			wen.work_effort_id,
			nd.note_info
		from work_effort_note wen
		join note_data nd on nd.note_id = wen.note_id
		where wen.sequence_id = '100' 
		and nd.note_date_time = least(
		(
		    select max(note_date_time)
		    from note_data nd2
		    join work_effort_note wen2 on wen2.note_id = nd2.note_id
		    where wen2.work_effort_id = wen.work_effort_id and wen2.sequence_id = '100'
		),
		(
		    select max(note_date_time)
		    from note_data nd2
		    join work_effort_note wen2 on wen2.note_id = nd2.note_id
		    where wen2.work_effort_id = wen.work_effort_id and wen2.sequence_id = '100'
		    	and EXTRACT(YEAR from nd2.note_date_time) = $P{YEAR}
		))
) descr on descr.work_effort_id = peg.work_effort_id
/* MONITORAGGIO */
left join (
	select 
		wen.work_effort_id,
		nd.note_info
	from work_effort_note wen
	join note_data nd on nd.note_id = wen.note_id and EXTRACT(YEAR from nd.note_date_time) = $P{YEAR}
	where wen.sequence_id = '300'
) mon on mon.work_effort_id = peg.work_effort_id
 /* VALUTAZIONE OBIETTIVO */
left join (
	select 
		wem.work_effort_id,
		ate.amount
	from work_effort_measure wem
	join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id and ate.gl_account_id = '10522'
) val on val.work_effort_id = peg.work_effort_id  
 /* PUNTEGGIO */
left join (
	select 
		wem.work_effort_id,
		ate.amount
	from work_effort_measure wem
	join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id and ate.gl_account_id = 'SCORE'
	 join acctg_trans act on act.acctg_trans_id = ate.acctg_trans_id and act.transaction_date = CAST($P{date3112sql} AS TIMESTAMP)
) score on score.work_effort_id = peg.work_effort_id  
where  wea2.work_effort_id_from = $P{workEffortIdFrom}
and wea2.work_effort_assoc_type_id = $P{workEffortAssocTypeId}
and wea2.from_date <= CAST($P{monitoringDateString} AS TIMESTAMP) and wea2.thru_date >= CAST($P{monitoringDateString} AS TIMESTAMP)
and peg.estimated_start_date <= CAST($P{monitoringDateString} AS TIMESTAMP) and peg.estimated_completion_date >= CAST($P{monitoringDateString} AS TIMESTAMP)
and strutt.org_unit_id = $P{idStruttura}]]>
	</queryString>
