		<parameter name="FROMAT" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT 
		INDIC.ID_SCHEDA,
		INDIC.NOME_INDICATORE$P!{langLocale} as NOME_INDICATORE,
		INDIC.CODICE_INDICATORE,
		INDIC.UDM$P!{langLocale} as UDM,
		INDIC.TIPO_UDM,			
		
      MAX(CASE WHEN INDIC.TIPO_RILEVAZIONE_VALORE  = 'BUDGET' AND INDIC.DATA_VALORE = CAST($P{date3112sql} AS TIMESTAMP) THEN INDIC.VALORE_NUMERO ELSE NULL END)  BUDGET_VALORE_NUMERICO,
	  MAX(CASE WHEN INDIC.TIPO_RILEVAZIONE_VALORE = 'BUDGET' AND INDIC.DATA_VALORE = CAST($P{date3112sql} AS TIMESTAMP) THEN INDIC.VALORE_STRINGA ELSE NULL END)  BUDGET_VALORE_STRINGA,
	  
	  MAX(CASE WHEN INDIC.TIPO_RILEVAZIONE_VALORE = 'ACTUAL' AND INDIC.DATA_VALORE = CAST($P{date3112sql} AS TIMESTAMP) THEN INDIC.VALORE_NUMERO ELSE NULL END)  ACTUAL_VALORE_NUMERICO,
	  MAX(CASE WHEN INDIC.TIPO_RILEVAZIONE_VALORE = 'ACTUAL' AND INDIC.DATA_VALORE = CAST($P{date3112sql} AS TIMESTAMP) THEN INDIC.VALORE_STRINGA ELSE NULL END)  ACTUAL_VALORE_STRINGA,	  	   
	  	  
	  MAX(CASE WHEN INDIC.TIPO_RILEVAZIONE_VALORE  = 'BUDGET' AND INDIC.DATA_VALORE = CAST($P{date3112P1sql} AS TIMESTAMP) THEN INDIC.VALORE_NUMERO ELSE NULL END) BUDGET_VALORE_NUMERICO_P1,
	  MAX(CASE WHEN INDIC.TIPO_RILEVAZIONE_VALORE = 'BUDGET' AND INDIC.DATA_VALORE = CAST($P{date3112P1sql} AS TIMESTAMP) THEN INDIC.VALORE_STRINGA ELSE NULL END)  BUDGET_VALORE_STRINGA_P1,

	  MAX(CASE WHEN INDIC.TIPO_RILEVAZIONE_VALORE = 'ACTUAL' AND INDIC.DATA_VALORE = CAST($P{date3112P1sql} AS TIMESTAMP) THEN INDIC.VALORE_NUMERO ELSE NULL END)  ACTUAL_VALORE_NUMERICO_P1,
	  MAX(CASE WHEN INDIC.TIPO_RILEVAZIONE_VALORE = 'ACTUAL' AND INDIC.DATA_VALORE = CAST($P{date3112P1sql} AS TIMESTAMP) THEN INDIC.VALORE_STRINGA ELSE NULL END)  ACTUAL_VALORE_STRINGA_P1,

	   
	  MAX(CASE WHEN INDIC.TIPO_RILEVAZIONE_VALORE  = 'BUDGET' AND INDIC.DATA_VALORE = CAST($P{date3112P2sql} AS TIMESTAMP) THEN INDIC.VALORE_NUMERO ELSE NULL END) BUDGET_VALORE_NUMERICO_P2,
	  MAX(CASE WHEN INDIC.TIPO_RILEVAZIONE_VALORE = 'BUDGET' AND INDIC.DATA_VALORE = CAST($P{date3112P2sql} AS TIMESTAMP) THEN INDIC.VALORE_STRINGA ELSE NULL END)  BUDGET_VALORE_STRINGA_P2,

	  MAX(CASE WHEN INDIC.TIPO_RILEVAZIONE_VALORE = 'ACTUAL' AND INDIC.DATA_VALORE = CAST($P{date3112P2sql} AS TIMESTAMP) THEN INDIC.VALORE_NUMERO ELSE NULL END)  ACTUAL_VALORE_NUMERICO_P2,
	  MAX(CASE WHEN INDIC.TIPO_RILEVAZIONE_VALORE = 'ACTUAL' AND INDIC.DATA_VALORE = CAST($P{date3112P2sql} AS TIMESTAMP) THEN INDIC.VALORE_STRINGA ELSE NULL END)  ACTUAL_VALORE_STRINGA_P2,
	  
	  MAX(CASE WHEN INDIC.TIPO_RILEVAZIONE_VALORE  = 'BUDGET' AND INDIC.DATA_VALORE = CAST($P{date3112M2sql} AS TIMESTAMP) THEN INDIC.VALORE_NUMERO ELSE NULL END) BUDGET_VALORE_NUMERICO_M2,
	  MAX(CASE WHEN INDIC.TIPO_RILEVAZIONE_VALORE = 'BUDGET' AND INDIC.DATA_VALORE = CAST($P{date3112M2sql} AS TIMESTAMP) THEN INDIC.VALORE_STRINGA ELSE NULL END)  BUDGET_VALORE_STRINGA_M2,

	  MAX(CASE WHEN INDIC.TIPO_RILEVAZIONE_VALORE = 'ACTUAL' AND INDIC.DATA_VALORE = CAST($P{date3112M2sql} AS TIMESTAMP) THEN INDIC.VALORE_NUMERO ELSE NULL END)  ACTUAL_VALORE_NUMERICO_M2,
	  MAX(CASE WHEN INDIC.TIPO_RILEVAZIONE_VALORE = 'ACTUAL' AND INDIC.DATA_VALORE = CAST($P{date3112M2sql} AS TIMESTAMP) THEN INDIC.VALORE_STRINGA ELSE NULL END)  ACTUAL_VALORE_STRINGA_M2

FROM PEG_STR_INDIC_VIEW INDIC
where ID_SCHEDA = $P{workEffortId}
 GROUP BY          	
		INDIC.ID_SCHEDA,
		INDIC.NOME_INDICATORE$P!{langLocale},
		INDIC.CODICE_INDICATORE,
		INDIC.UDM$P!{langLocale},
		INDIC.TIPO_UDM
order by INDIC.CODICE_INDICATORE, INDIC.NOME_INDICATORE]]>
		</queryString>
