		<queryString language="SQL">
			<![CDATA[select * 
from PEG_STR_FASI_VIEW FASI 
where FASI.ID_SCHEDA = $P{workEffortId}
and FASI.DATA_INIZIO_FASE <= CAST($P{date3112sql} AS TIMESTAMP)
and FASI.DATA_FINE_FASE >= CAST($P{date0101sql} AS TIMESTAMP)
and (FASI.DATA_PUNTEGGIO = CAST($P{date3112sql} AS TIMESTAMP) or FASI.data_punteggio is null)
order by FASI.CODICE_FASE,FASI.DATA_INIZIO_FASE,FASI.DATA_FINE_FASE, FASI.NOME_FASE]]>
		</queryString>
