		<queryString language="SQL">
			<![CDATA[select * from PEG_STR_ANAG_VIEW ANAG
where ANAG.ID_SCHEDA = $P{workEffortId}
and ANAG.DATA_INIZIO_ASSEGNAZIONE <= CAST($P{monitoringDateString} AS TIMESTAMP) 
and (ANAG.DATA_FINE_ASSEGNAZIONE >= CAST($P{monitoringDateString} AS TIMESTAMP) or ANAG.DATA_FINE_ASSEGNAZIONE is null) 
and (ANAG.ID_PROFILO_PROFESSIONALE is null or 
	(ANAG.DATA_INIZIO_PROFILO_PROFESSIONALE <= CAST($P{monitoringDateString} AS TIMESTAMP)
		and (ANAG.DATA_FINE_PROFILO_PROFESSIONALE >=  CAST($P{monitoringDateString} AS TIMESTAMP) or ANAG.DATA_FINE_PROFILO_PROFESSIONALE is null)))
order by ANAG.NOME_SOGGETTO, ANAG.CODICE_SOGGETTO]]>
		</queryString>
