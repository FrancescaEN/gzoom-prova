	<parameter name="workEffortIdFrom" class="java.lang.String"/>
	<parameter name="workEffortAssocTypeId" class="java.lang.String"/>
	<parameter name="titoloObiettivo" class="java.lang.String"/>
	<parameter name="FORMAT" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilNumber.getFormatPattern(2, "Num")]]></defaultValueExpression>
	</parameter>
