		<queryString language="SQL">
			<![CDATA[select * 
from PEG_ORD_CAP_VIEW CAP
where CAP.ID_SCHEDA = $P{workEffortId}
and (extract(YEAR from CAP.ANNO_STANZIATO) = $P{YEAR} or CAP.ANNO_STANZIATO is null)
order by CAP.TIPOLOGIA_CAPITOLO, CAP.CODICE_CAPITOLO]]>
		</queryString>
