	<parameter name="exposeFinancial" class="java.lang.String"/>
	<parameter name="orgUnitIdString" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$P{orgUnitId}  != null && $P{orgUnitId}  != "" && LEN($P{orgUnitId}) != 0  ? " AND (FIL_W.org_unit_id = '"+ $P{orgUnitId} + "')" : " AND FIL_W.org_unit_id like '%%'"]]></defaultValueExpression>
	</parameter>
