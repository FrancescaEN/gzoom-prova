		</parameter>
		<parameter name="date3112M2sql" class="java.lang.String">
			<defaultValueExpression><![CDATA[SUBSTITUTE(com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc($P{date3112M2}, $P{odaDialect}),"'","")]]></defaultValueExpression>
