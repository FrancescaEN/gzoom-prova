	<parameter name="exposeFinancial" class="java.lang.String"/>
	<parameter name="orgUnitIdStringUff" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$P{orgUnitId}  != null && $P{orgUnitId}  != "" && LEN($P{orgUnitId}) != 0  ? " AND (FIL_W.org_unit_id = '"+ $P{orgUnitId} + "' or sett.org_unit_id = '"+ $P{orgUnitId} + "')" : " AND FIL_W.org_unit_id like '%%'"]]></defaultValueExpression>
	</parameter>
	<parameter name="workEffortRevision" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[select settUff.*
from((select 
	FIL_W.work_effort_id as ID_SETTORE,
	FIL_W.work_effort_name as NOME_SETTORE,
	FIL_W.source_reference_id as CODICE_SETTORE,
	FIL_W.etch as ETICHETTA_SETTORE,
	FIL_W.org_unit_id as ID_STRUTTURA_SETTORE,
	FIL_W.estimated_start_date as DATA_INIZIO_SETTORE,
	FIL_W.estimated_completion_date as DATA_FINE_SETTORE,
	null as ID_UFFICIO,
	null as NOME_UFFICIO,
	null as CODICE_UFFICIO,
	null as ETICHETTA_UFFICIO,
	null as ID_STRUTTURA_UFFICIO,
	null as DATA_INIZIO_UFFICIO,
	null as DATA_FINE_UFFICIO,
	resp.party_name as RESPONSABILE_SETTORE,
	rt.description as tipo_settore,
	null as RESPONSABILE_UFFICIO,
	null as tipo_ufficio
/* SETTORE */
from work_effort FIL_W
/* START filterInnerJoin */
   $P!{filterInnerJoinString} 
/* END filterInnerJoin */
/* START filterLeftJoin */
  $P!{filterLeftJoinString} 
/* END filterLeftJoin */
/* ANAGRAFICA SETTORE */
join party p on p.party_id = FIL_W.org_unit_id 
join party_role prole on prole.party_id = p.party_id 
join role_type rt on rt.role_type_id = prole.role_type_id 
/* RESPONSABILE */
left join party_relationship pr on pr.party_id_from = p.party_id and pr.party_relationship_type_id = 'ORG_RESPONSIBLE'
	and pr.from_date <= CAST($P{monitoringDateString} AS TIMESTAMP) and (pr.thru_date >=CAST($P{monitoringDateString} AS TIMESTAMP) or pr.thru_date is null)
left join party resp on resp.party_id = pr.party_id_to 
where FIL_W.work_effort_type_id = '20P24SPL' 
and FIL_W.estimated_start_date <= CAST($P{monitoringDateString} AS TIMESTAMP) and FIL_W.estimated_completion_date >=CAST($P{monitoringDateString} AS TIMESTAMP) 
 /* START orgUnitIdString */
 $P!{orgUnitIdString}
 /* END orgUnitIdString */
 /* START filterWhere */
 $P!{filterWhereString} 
   /* END filterWhere */  )
union
(select 
	sett.work_effort_id as ID_SETTORE,
	sett.work_effort_name as NOME_SETTORE,
	sett.source_reference_id as CODICE_SETTORE,
	sett.etch as ETICHETTA_SETTORE,
	sett.org_unit_id as ID_STRUTTURA_SETTORE,
	sett.estimated_start_date as DATA_INIZIO_SETTORE,
	sett.estimated_completion_date as DATA_FINE_SETTORE,
	FIL_W.work_effort_id as ID_UFFICIO,
	FIL_W.work_effort_name as NOME_UFFICIO,
	FIL_W.source_reference_id as CODICE_UFFICIO,
	FIL_W.etch as ETICHETTA_UFFICIO,
	FIL_W.org_unit_id as ID_STRUTTURA_UFFICIO,
	FIL_W.estimated_start_date as DATA_INIZIO_UFFICIO,
	FIL_W.estimated_completion_date as DATA_FINE_UFFICIO,
	respsett.party_name as RESPONSABILE_SETTORE,
	rtsett.description as tipo_settore,
	resp.party_name as RESPONSABILE_UFFICIO,
	rt.description as tipo_ufficio
/* SETTORE */
from work_effort sett
join party psett on psett.party_id = sett.org_unit_id 
join party_role prolesett on prolesett.party_id = psett.party_id 
join role_type rtsett on rtsett.role_type_id = prolesett.role_type_id 
/* RESPONSABILE SETTORE*/
left join party_relationship prsett on prsett.party_id_from = psett.party_id and prsett.party_relationship_type_id = 'ORG_RESPONSIBLE'
	and prsett.from_date <= CAST($P{monitoringDateString} AS TIMESTAMP) and (prsett.thru_date >=CAST($P{monitoringDateString} AS TIMESTAMP) or prsett.thru_date is null)
left join party respsett on respsett.party_id = prsett.party_id_to 
/* UFFICIO */
join work_effort_assoc wea on wea.work_effort_id_from = sett.work_effort_id and wea.work_effort_assoc_type_id = '20P2D' and wea.from_date <= CAST($P{monitoringDateString} AS TIMESTAMP) and 
wea.thru_date >=  CAST($P{monitoringDateString} AS TIMESTAMP)
join work_effort FIL_W on FIL_W.work_effort_id = wea.work_effort_id_to AND fil_w.work_effort_type_id='20P26SSL' AND fil_w.work_effort_revision_id is null
join party p on p.party_id = FIL_W.org_unit_id 
join party_role prole on prole.party_id = p.party_id 
join role_type rt on rt.role_type_id = prole.role_type_id 
/* START filterInnerJoin */
   $P!{filterInnerJoinString} 
/* END filterInnerJoin */
/* START filterLeftJoin */
  $P!{filterLeftJoinString} 
/* END filterLeftJoin */
/* RESPONSABILE */
left join party_relationship pr on pr.party_id_from = FIL_W.org_unit_id and pr.party_relationship_type_id = 'ORG_RESPONSIBLE'
	and pr.from_date <= CAST($P{monitoringDateString} AS TIMESTAMP) and (pr.thru_date >=  CAST($P{monitoringDateString} AS TIMESTAMP) or pr.thru_date is null)
left join party resp on resp.party_id = pr.party_id_to
where sett.work_effort_type_id = '20P24SPL'
and sett.estimated_start_date <= CAST($P{monitoringDateString} AS TIMESTAMP) and sett.estimated_completion_date >= CAST($P{monitoringDateString} AS TIMESTAMP)
and FIL_W.estimated_start_date <= CAST($P{monitoringDateString} AS TIMESTAMP) and FIL_W.estimated_completion_date >= CAST($P{monitoringDateString} AS TIMESTAMP)
 /* START orgUnitIdString */
 $P!{orgUnitIdStringUff}
 /* END orgUnitIdString */
 /* START filterWhere */
 $P!{filterWhereString} 
   /* END filterWhere */  )) settUff
   order by CODICE_SETTORE, CODICE_UFFICIO]]>
	</queryString>
