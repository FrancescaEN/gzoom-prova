            <xml-property name="queryText"><![CDATA[select
fa.etch as fase_codice, fa.work_effort_name as fase_descrizione,
fa.estimated_start_date as fase_inizio_prev, fa.estimated_completion_date as fase_fine_prev,
fa.actual_start_date as fase_inizio_eff, fa.actual_completion_date as fase_fine_eff
from work_effort_assoc opfa
inner join work_effort fa on fa.work_effort_id = opfa.work_effort_id_to
where opfa.work_effort_id_from = ?  -- main.identificativo_obipeg
 and opfa.work_effort_assoc_type_id = '20P4'
 and opfa.thru_date >= @date0101  -- AAAA(input.ref_date)-01-01
order by fa.etch]]></xml-property>
