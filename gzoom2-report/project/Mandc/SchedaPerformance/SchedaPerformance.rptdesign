            </list-property>
            <xml-property name="queryText"><![CDATA[select
pp.parent_role_code as matricola, pa.party_name as assegn_denominazione,
uo.party_name as assegn_struttura,
ca.description as assegn_categoria,
wp.from_date as assegn_inizio, wp.thru_date as assegn_fine,
pe.employment_amount as parttime, wp.role_type_weight as ass_impiego
from work_effort_party_assignment wp
inner join party pa on pa.party_id = wp.party_id
inner join party_parent_role pp on pp.party_id = pa.party_id and pp.role_type_id = 'EMPLOYEE'
inner join person pe on pe.party_id = pa.party_id
left join empl_position_type ep on ep.empl_position_type_id = pe.empl_position_type_id
left join empl_position_type ca on ca.empl_position_type_id = ep.parent_type_id
left join party_relationship pr on pr.party_relationship_type_id = 'ORG_EMPLOYMENT'
  and pr.party_id_to = pa.party_id
  and pr.from_date <= @monitoringDate -- input.ref_date
  and (pr.thru_date is null or pr.thru_date >= @monitoringDate) -- input.ref_date
left join party uo on uo.party_id = pr.party_id_from
where wp.work_effort_id = ? -- main.identificativo_obipeg
  and wp.role_type_id = 'WE_ASSIGNMENT'
  and wp.from_date <= @date3112 -- AAAA(input.ref_date)-12-31
  and wp.thru_date >= @date0101 -- AAAA(input.ref_date)-01-01]]></xml-property>
