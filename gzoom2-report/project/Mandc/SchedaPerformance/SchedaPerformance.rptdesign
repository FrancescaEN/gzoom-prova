            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT V.M_SEQUENCE_ID AS SEQUENZA,
	V.G_INPUT_ENUM_ID AS TIPO_MODELLO,
	V.G_ACCOUNT_CODE AS CODICE_INDIC,
	V.G_ACCOUNT_NAME AS TITOLO_INDIC,
	V.G_DESCRIPTION AS DESCRIZIONE_INDIC,
	V.G_UOM_ABBREVIATION AS UOM_ETCH,
	V.R_UOM_CODE AS UOM_CODE,
	V.R_UOM_DESCR AS UOM_DESCR,
	V.M_UOM_DESCR AS TITOLO_MISURA,
	V.M_COMMENTS AS DESCRIZIONE_MISURA,
	V.G_DETAIL_ENUM_ID,
	--GESTITO SOLO ACCDET_NULL	
 	V.G_UOM_TYPE_ID AS TIPO_UOM,
	V.G_UOM_DECIMAL_SCALE AS SCALA_UOM,
	MAX(V.M_FROM_DATE) FROM  WORK_EFFORT_TRANS_ALL_VIEW V WHERE
M_WORK_EFFORT_ID = ?
AND V.M_WE_MEASURE_TYPE_ENUM_ID = 'WEMT_OUTPUT' AND
V.G_ACCOUNT_CODE not like '%MONIT%'
GROUP BY V.M_SEQUENCE_ID,V.G_INPUT_ENUM_ID,V.G_ACCOUNT_CODE,V.M_FROM_DATE,V.G_ACCOUNT_NAME,V.G_DESCRIPTION,V.G_UOM_ABBREVIATION,
V.M_UOM_DESCR,V.M_COMMENTS,V.G_DETAIL_ENUM_ID,V.G_UOM_TYPE_ID,V.G_UOM_DECIMAL_SCALE,V.R_UOM_CODE,V.R_UOM_DESCR]]></xml-property>
        </oda-data-set>
    </data-sets>
