                                                        <structure>
                                                            <property name="name">Expression</property>
                                                            <expression name="value" type="javascript">BirtMath.round((row["ass_impiego"])/100*(row["parttime"])/100*(BirtDateTime.diffDay(params["date0101"].value,params["date3112"].value)+1)/365,2);</expression>
                                                        </structure>
