*/
//ReportLog.info("note  "+this.queryText);]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">sequence_id</property>
                    <property name="nativeName">sequence_id</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">note_date_time</property>
                    <property name="nativeName">note_date_time</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">nota_nome</property>
                    <property name="nativeName">nota_nome</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">nota_contenuto</property>
                    <property name="nativeName">nota_contenuto</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select
wn.sequence_id, nd.note_date_time, nd.note_name as nota_nome, nd.note_info as nota_contenuto
from work_effort_note wn
inner join note_data nd on nd.note_id = wn.note_id
where wn.work_effort_id = ?  -- main.identificativo_obipeg
  and wn.sequence_id = ? 
  and (nd.note_date_time >= @date0101  -- 01/01/AAAA(input.ref_date)
  and nd.note_date_time <= @monitoringDate)  -- input.ref_date
  and nd.note_info is not null and rtrim(nd.note_info) is not null
order by wn.sequence_id, nd.note_date_time]]></xml-property>
        </oda-data-set>
