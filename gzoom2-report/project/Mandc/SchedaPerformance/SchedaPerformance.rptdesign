this.queryText = this.queryText.replace("@monitoraggiodueannisuccessivi",  "'2023-12-31 00:00:00.000'" );				
this.queryText = this.queryText.replace("@date1231-1", "'2020-12-31 00:00:00.000'");
this.queryText = this.queryText.replace("@date1231-2", "'2019-12-31 00:00:00.000'");
