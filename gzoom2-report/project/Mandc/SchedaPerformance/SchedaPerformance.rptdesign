                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">22</property>
                    <property name="name">titolo_lineamandato</property>
                    <property name="nativeName">titolo_lineamandato</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">23</property>
                    <property name="name">etch_os</property>
                    <property name="nativeName">etch_os</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">24</property>
                    <property name="name">codice_obistrategico</property>
                    <property name="nativeName">codice_obistrategico</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">25</property>
                    <property name="name">titolo_obistrategico</property>
                    <property name="nativeName">titolo_obistrategico</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">26</property>
                    <property name="name">etch_oo</property>
                    <property name="nativeName">etch_oo</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">27</property>
                    <property name="name">codice_obioperativo</property>
                    <property name="nativeName">codice_obioperativo</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">28</property>
                    <property name="name">titolo_obioperativo</property>
                    <property name="nativeName">titolo_obioperativo</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">29</property>
                    <property name="name">etch_pr</property>
                    <property name="nativeName">etch_pr</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">30</property>
                    <property name="name">codice_programma</property>
                    <property name="nativeName">codice_programma</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">31</property>
                    <property name="name">titolo_programma</property>
                    <property name="nativeName">titolo_programma</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">32</property>
                    <property name="name">etch_mi</property>
                    <property name="nativeName">etch_mi</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">33</property>
                    <property name="name">codice_missione</property>
                    <property name="nativeName">codice_missione</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">34</property>
                    <property name="name">titolo_missione</property>
                    <property name="nativeName">titolo_missione</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">35</property>
                    <property name="name">tipo_riferimento</property>
                    <property name="nativeName">tipo_riferimento</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">36</property>
                    <property name="name">codice_riferimento</property>
                    <property name="nativeName">codice_riferimento</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">37</property>
                    <property name="name">titolo_riferimento</property>
                    <property name="nativeName">titolo_riferimento</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">38</property>
                    <property name="name">monitoraggio_valore</property>
                    <property name="nativeName">monitoraggio_valore</property>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="position">39</property>
                    <property name="name">monitoraggio_descrizione</property>
                    <property name="nativeName">monitoraggio_descrizione</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">40</property>
                    <property name="name">monitoraggio_riferimento</property>
                    <property name="nativeName">monitoraggio_riferimento</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">41</property>
                    <property name="name">monitoraggio_commento</property>
                    <property name="nativeName">monitoraggio_commento</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">42</property>
                    <property name="name">risultato_valore</property>
                    <property name="nativeName">risultato_valore</property>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="position">43</property>
                    <property name="name">risultato_descrizione</property>
                    <property name="nativeName">risultato_descrizione</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">44</property>
                    <property name="name">risultato_emoticon</property>
                    <property name="nativeName">risultato_emoticon</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">45</property>
                    <property name="name">risultato_riferimento</property>
                    <property name="nativeName">risultato_riferimento</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">46</property>
                    <property name="name">risultato_commento</property>
                    <property name="nativeName">risultato_commento</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">47</property>
                    <property name="name">ris_uo_valore</property>
                    <property name="nativeName">ris_uo_valore</property>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="position">48</property>
                    <property name="name">ris_uo_descrizione</property>
                    <property name="nativeName">ris_uo_descrizione</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">49</property>
                    <property name="name">ris_uo_emoticon</property>
                    <property name="nativeName">ris_uo_emoticon</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">50</property>
                    <property name="name">ris_uo_riferimento</property>
                    <property name="nativeName">ris_uo_riferimento</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">51</property>
                    <property name="name">ris_uo_commento</property>
                    <property name="nativeName">ris_uo_commento</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">52</property>
                    <property name="name">identificativo_obipeg</property>
                    <property name="nativeName">identificativo_obipeg</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">53</property>
                    <property name="name">etch_tip</property>
                    <property name="nativeName">etch_tip</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">54</property>
                    <property name="name">tipologia_obiettivo</property>
                    <property name="nativeName">tipologia_obiettivo</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select
	(
		CASE
			ouop.work_effort_assoc_type_id when '20P2D' then raou.sequence_num
			else nopa.sequence_num
		END
	) as ordinamento_1,
	(case
		ouop.work_effort_assoc_type_id when '20P2D' then 0
		else para.sequence_num
	end) as ordinamento_2,
	(case
		ouop.work_effort_assoc_type_id when '20P2D' then 0
		else raou.sequence_num
	end) as ordinamento_3,
	ou.source_reference_id as ordinamento_4, 
	ouop.sequence_num as ordinamento_5, 
	op.source_reference_id as ordinamento_6,
	(
		CASE
			ouop.work_effort_assoc_type_id when '20P2D' then 1
			else 3
		END
	) as livello_struttura,
	out.description as etch_ou,
	ou.etch as codice_uo_resp,
	pa.work_effort_name as titolo_uononno_responsabile,
	ra.work_effort_name as titolo_uopadre_responsabile,
	ou.work_effort_name as titolo_uo_responsabile,
	uooppa.party_name as denominazione_responsabile_tecnico, -- RESPONSABILE DI STRUTTURA
	opt.description as etch_op,								   
	op.etch as codice_obipeg,
	op.work_effort_name as titolo_obipeg,
	opt.work_effort_type_id as tip_op,
	opt.seq_esp as seq_esp_op,
	op.description as descrizione_obipeg,
	lmt.description as etch_lm,
	lm.etch as codice_linea,
	lm.work_effort_name as titolo_lineamandato,
	ost.description as etch_os,
	os.etch as codice_obistrategico,
	os.work_effort_name as titolo_obistrategico,
	oot.description as etch_oo,
	oo.etch as codice_obioperativo,
	oo.work_effort_name as titolo_obioperativo,
	prt.description as etch_pr,
	pr.etch as codice_programma,
	pr.work_effort_name as titolo_programma,
	mit.description as etch_mi,
	mi.etch as codice_missione,
	mi.work_effort_name as titolo_missione,
	rit.description as tipo_riferimento,
	ri.etch as codice_riferimento,
	ri.work_effort_name as titolo_riferimento,
	aem.amount as monitoraggio_valore,
	mon.uom_descr as monitoraggio_descrizione,
	-- drm.object_info as monitoraggio_emoticon,
	aem.description as monitoraggio_riferimento,
	atm.description as monitoraggio_commento,
	aer.amount as risultato_valore,
	ris.comments as risultato_descrizione,
	drr.object_info as risultato_emoticon,
	aer.description as risultato_riferimento,
	atr.description as risultato_commento,
	aeo.amount as ris_uo_valore,
	rio.comments as ris_uo_descrizione,
	dro.object_info as ris_uo_emoticon,
	aeo.description as ris_uo_riferimento,
	ato.description as ris_uo_commento,
	op.work_effort_id as identificativo_obipeg,
	opt.purpose_etch as etch_tip,
    oppt.description as tipologia_obiettivo
from
--- OBIETTIVO ESECUTIVO ----
work_effort op
 inner join user_preference up on up.user_pref_value = op.organization_id 
	and up.user_pref_type_id = 'ORGANIZATION_PARTY' and up.user_login_id = @userLoginId
inner join work_effort_type opt on
	opt.work_effort_type_id = op.work_effort_type_id
	-- struttura responsabile e soggetto responsabile
---- UNITA ORGANIZZATIVA OBIETTIVO ESECUTIVO ----
inner join party uoop on
	uoop.party_id = op.org_unit_id
inner join party_parent_role uoopc on
	uoopc.party_id = uoop.party_id
	and uoopc.role_type_id = 'ORGANIZATION_UNIT'
inner join party_group uoopg on
	uoopg.party_id = uoop.party_id
---- RELAZIONE CON RESPONSABILE DI STRUTTURA OBIETTIVO ESECUTIVO ----
left join party_relationship uoopre on
	uoopre.party_id_from = uoop.party_id
	and uoopre.party_relationship_type_id = 'ORG_RESPONSIBLE'
	and uoopre.from_date <= @monitoringDate --'2021-01-01'
	-- input.ref_date	 
	and (uoopre.thru_date is null
	or uoopre.thru_date >= @monitoringDate --'2021-01-01'
	)
	-- input.ref_date
---- PARTY RESPONSABILE DI STRUTTURA ---	
left join party uooppa on
	uoopre.party_id_to is not null
	and uooppa.party_id = uoopre.party_id_to
left join work_effort_assoc ouop on
	ouop.work_effort_id_to = op.work_effort_id
	and ouop.work_effort_assoc_type_id in ('20P2D')
	and ouop.from_date <= @monitoringDate --'2021-01-01'
	and ouop.thru_date >= @monitoringDate --'2021-01-01'
	and ouop.work_effort_revision_id is null
	-- input.ref_date
---- SCHEDA UNITA ORGANIZZATIVA ----
inner join work_effort ou on
	ou.work_effort_id = ouop.work_effort_id_from
inner join work_effort_type out on
	out.work_effort_type_id = ou.work_effort_type_id
	-- organigramma struttura responsabile -> struttura padre (ra) -> struttura nonno (rara)
inner join work_effort_assoc raou on
	raou.work_effort_id_to = ou.work_effort_id
	and raou.work_effort_assoc_type_id = '20P2D'
	and raou.from_date <= @monitoringDate --'2021-01-01'
	and raou.thru_date >= @monitoringDate --'2021-01-01'
	and raou.work_effort_revision_id is null
	-- input.ref_date
---- SCHEDA UNITA ORGANIZZATIVA LIV. SUPERIORE ----	
inner join work_effort ra on
	ra.work_effort_id = raou.work_effort_id_from
inner join work_effort_type rat on
	rat.work_effort_type_id = ra.work_effort_type_id
--- ASSOCIATIVA SCHEDA COMUNE ----	
left join work_effort_assoc para on
	para.work_effort_id_to = ra.work_effort_id
	and para.work_effort_assoc_type_id = '20P2D'
	and para.from_date <= @monitoringDate --'2021-01-01'
	and para.thru_date >= @monitoringDate --'2021-01-01'
	and para.work_effort_revision_id is null
	-- input.ref_date
--- WORK EFFORT SCHEDA UO RADICE ----	
left join work_effort pa on
	para.work_effort_id_from is not null
	and pa.work_effort_id = para.work_effort_id_from
left join work_effort_assoc nopa on
	para.work_effort_id_from is not null
	and nopa.work_effort_id_to = para.work_effort_id_from
	and nopa.work_effort_assoc_type_id = '20P2D'
	and nopa.from_date <= @monitoringDate --'2021-01-01'
	and nopa.thru_date >= @monitoringDate --'2021-01-01'
	and nopa.work_effort_revision_id is null
	-- input.ref_date
	-- relazioni obiettivo peg -> obiettivo operativo -> obiettivo strategico -> linea di mandato
---- ASSOCIATIVA CON OBIETTIVO OPERATIVO ----
left join work_effort_assoc ooop on
	ooop.work_effort_id_to = op.work_effort_id
	and ooop.work_effort_assoc_type_id = '20D6OC'
	and ooop.from_date <= @monitoringDate --'2021-01-01'
	and ooop.thru_date >= @monitoringDate --'2021-01-01'
	and ooop.work_effort_revision_id is null
	-- input.ref_date
---- OBIETTIVO ESECUTIVO (anche lui) ----
inner join work_effort FIL_W on
	FIL_W.work_effort_id = ooop.work_effort_id_to
---- OBIETTIVO OPERATIVO ----
left join work_effort oo on
	ooop.work_effort_id_from is not null
	and oo.work_effort_id = ooop.work_effort_id_from
left join work_effort_type oot on
	oo.work_effort_type_id is not null
	and oot.work_effort_type_id = oo.work_effort_type_id
---- ASSOCIATIVA CON OBIETTIVO STRATEGICO ----
left join work_effort_assoc osoo on
	oo.work_effort_id is not null
	and osoo.work_effort_id_to = oo.work_effort_id
	and osoo.work_effort_assoc_type_id = '20D6C'
	and osoo.from_date <= @monitoringDate --'2021-01-01'
	and osoo.thru_date >= @monitoringDate --'2021-01-01'
	and osoo.work_effort_revision_id is null
	-- input.ref_date
---- OBIETTIVO STRATEGICO ----
left join work_effort os on
	osoo.work_effort_id_from is not null
	and os.work_effort_id = osoo.work_effort_id_from
left join work_effort_type ost on
	os.work_effort_type_id is not null
	and ost.work_effort_type_id = os.work_effort_type_id
---- ASSOCIATIVA LINEA DI MANDATO ----
left join work_effort_assoc lmos on
	os.work_effort_id is not null
	and lmos.work_effort_id_to = os.work_effort_id
	and lmos.work_effort_assoc_type_id = '20D6'
	and lmos.from_date <= @monitoringDate --'2021-01-01'
	and lmos.thru_date >= @monitoringDate --'2021-01-01'
	and lmos.work_effort_revision_id is null
	-- input.ref_date
----LINEA DI MANDATO ----
left join work_effort lm on
	lmos.work_effort_id_from is not null
	and lm.work_effort_id = lmos.work_effort_id_from
left join work_effort_type lmt on
	lm.work_effort_type_id is not null
	and lmt.work_effort_type_id = lm.work_effort_type_id
---- ASSOCIATIVA PIANO DI MANDATO ----
left join work_effort_assoc pmlm on
	lm.work_effort_id is not null
	and pmlm.work_effort_id_to = lm.work_effort_id
	and pmlm.work_effort_assoc_type_id = '20D6'
	and pmlm.from_date <= @monitoringDate --'2021-01-01'
	and pmlm.thru_date >= @monitoringDate --'2021-01-01'
	and pmlm.work_effort_revision_id is null
	-- input.ref_date
---- PIANO DI MANDATO ----
left join work_effort pm on
	pmlm.work_effort_id_from is not null
	and pm.work_effort_id = pmlm.work_effort_id_from
left join work_effort_type pmt on
	pm.work_effort_type_id is not null
	and pmt.work_effort_type_id = pm.work_effort_type_id
	-- relazioni obiettivo operativo -> programma -> missione
---- ASSOCIATIVA PROGRAMMA ----
left join work_effort_assoc proo on
	oo.work_effort_id is not null
	and proo.work_effort_id_to = oo.work_effort_id
	and proo.work_effort_assoc_type_id = '20D2C'
	and proo.from_date <= @monitoringDate --'2021-01-01'
	and proo.thru_date >= @monitoringDate --'2021-01-01'
	and proo.work_effort_revision_id is null
	-- input.ref_date
---- PROGRAMMA ----
left join work_effort pr on
	proo.work_effort_id_from is not null
	and pr.work_effort_id = proo.work_effort_id_from
left join work_effort_type prt on
	pr.work_effort_type_id is not null
	and prt.work_effort_type_id = pr.work_effort_type_id
---- ASSOCIATIVA MISSIONE ----
left join work_effort_assoc mipr on
	pr.work_effort_id is not null
	and mipr.work_effort_id_to = pr.work_effort_id
	and mipr.work_effort_assoc_type_id = '20D2'
	and mipr.from_date <= @monitoringDate --'2021-01-01'
	and mipr.thru_date >= @monitoringDate --'2021-01-01'
	and mipr.work_effort_revision_id is null
	-- input.ref_date
---- MISSIONE ----
left join work_effort mi on
	mipr.work_effort_id_from is not null
	and mi.work_effort_id = mipr.work_effort_id_from
left join work_effort_type mit on
	mi.work_effort_type_id is not null
	and mit.work_effort_type_id = mi.work_effort_type_id
---- ASSOCIATIVA CON STAKEHOLDERS ----
left join work_effort_assoc riop on
	riop.work_effort_id_to = op.work_effort_id
	and riop.work_effort_assoc_type_id like '20R%'
	and riop.from_date <= @monitoringDate --'2021-01-01'
	and riop.thru_date >= @monitoringDate --'2021-01-01'
	and riop.work_effort_revision_id is null
	-- input.ref_date
---- STAKEHOLDERS ----
left join work_effort ri on
	riop.work_effort_id_from is not null
	and ri.work_effort_id = riop.work_effort_id_from
left join work_effort_type rit on
	ri.work_effort_id is not null
	and rit.work_effort_type_id = ri.work_effort_type_id
	-- monitoraggio obiettivo peg
---- MONITORAGGIO OBIETTIVO PEG ----
left join gl_account glmm on glmm.account_code like '%MONIT%'
left join work_effort_measure opmm on opmm.work_effort_id = op.work_effort_id and glmm.gl_account_id = opmm.gl_account_id
left join acctg_trans atm on
	opmm.work_effort_measure_id is not null
	and atm.voucher_ref = opmm.work_effort_measure_id
	and glmm.gl_account_id is not null 
	and atm.transaction_date = @date3006 --'2021-06-30'
	--input.ref_date
left join acctg_trans_entry aem on
	atm.acctg_trans_id is not null
	and aem.acctg_trans_id = atm.acctg_trans_id
left join gl_account_meas_rat_sc mon on
	aem.amount is not null
	and mon.uom_id = 'MON'
	and mon.uom_rating_value = aem.amount
	and mon.gl_account_id=glmm.gl_account_id
---- PUNTEGGIO OBIETTIVO PEG ----
left join work_effort_measure opmr on
	opmr.gl_account_id = 'SCORE'
	and opmr.work_effort_id = op.work_effort_id
left join acctg_trans atr on
	opmr.work_effort_measure_id is not null
	and atr.voucher_ref = opmr.work_effort_measure_id
	and atr.transaction_date = @monitoringDate --'2021-12-31'
	--input.ref_date
left join acctg_trans_entry aer on
	atr.acctg_trans_id is not null
	and aer.acctg_trans_id = atr.acctg_trans_id
left join uom_range_values ris on
	aer.amount is not null
	and ris.uom_range_id = opt.uom_range_score_id
	and ris.from_value <= aer.amount
	and ris.thru_value >= aer.amount
left join content cor on
	ris.icon_content_id is not null
	and cor.content_id = ris.icon_content_id
left join data_resource drr on
	cor.data_resource_id is not null
	and drr.data_resource_id = cor.data_resource_id
	-- risultato struttura
left join work_effort_measure oumr on
	oumr.gl_account_id = 'SCORE'
	and oumr.work_effort_id = ou.work_effort_id
left join acctg_trans ato on
	oumr.work_effort_measure_id is not null
	and ato.voucher_ref = oumr.work_effort_measure_id
	and ato.transaction_date = @monitoringDate --'2021-12-31'
	--input.ref_date
left join acctg_trans_entry aeo on
	ato.acctg_trans_id is not null
	and aeo.acctg_trans_id = ato.acctg_trans_id
left join uom_range_values rio on
	aeo.amount is not null
	and rio.uom_range_id = out.uom_range_score_id
	and rio.from_value <= aeo.amount
	and rio.thru_value >= aeo.amount
left join content coo on
	rio.icon_content_id is not null
	and coo.content_id = rio.icon_content_id
left join data_resource dro on
	coo.data_resource_id is not null
	and dro.data_resource_id = coo.data_resource_id	
left join work_effort_purpose_type oppt on 
	oppt.work_effort_purpose_type_id = op.work_effort_purpose_type_id	
@filterInnerJoin
@filterLeftJoin
where 1=1
and op.work_effort_revision_id is null and ooop.WORK_EFFORT_REVISION_ID is null 
@orgUnitId
@personId
@workEffortName
@filterWhere
order by ordinamento_1,
ordinamento_2,
ordinamento_3, 
ordinamento_4, 
ordinamento_5, 
ordinamento_6]]></xml-property>
