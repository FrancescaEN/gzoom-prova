            </structure>
            <method name="beforeOpen"><![CDATA[//this.queryText = this.queryText.replace("@excludePerformanceKPI", "'" + params["excludePerformanceKPI"].value+ "'");
//this.queryText = this.queryText.replace("@excludeValidity", "'" + params["excludeValidity"].value+ "'");
/**/	
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value );
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );															
this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );

/*
this.queryText = this.queryText.replace("@date0101",  "'2020-01-01 00:00:00.000'" );
this.queryText = this.queryText.replace("@date3112",  "'2020-12-31 00:00:00.000'" );
this.queryText = this.queryText.replace("@monitoringDate",  "'2020-12-31 00:00:00.000'" );
*/

//Debug.log("... this.queryText= "+this.queryText);]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">codice_altrauo</property>
                    <property name="nativeName">codice_altrauo</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">altreuo_operativo</property>
                    <property name="nativeName">altreuo_operativo</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select
uosoc.parent_role_code as codice_altrauo, uoso.party_name as altreuo_operativo
from 
 work_effort_assoc ooso
inner join work_effort so on so.work_effort_id = ooso.work_effort_id_to
inner join party uoso on uoso.party_id = so.org_unit_id
inner join party_parent_role uosoc on uosoc.party_id = uoso.party_id
 and uosoc.role_type_id = 'ORGANIZATION_UNIT'
inner join party_group uosog on uosog.party_id = uoso.party_id
where  ooso.work_effort_id_from = ? -- input.work_effort_id 
  and ooso.work_effort_assoc_type_id = '20D6O' 
  and ooso.from_date <= @monitoringDate     -- input.ref_date
  and ooso.thru_date >= @monitoringDate     -- input.ref_date
order by uosoc.parent_role_code
]]></xml-property>
