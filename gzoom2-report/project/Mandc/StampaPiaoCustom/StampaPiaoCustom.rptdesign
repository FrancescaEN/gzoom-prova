            <xml-property name="queryText"><![CDATA[select FIL_W.work_effort_id as oo_work_effort,
vp.etch as etic_ambiti_valpub,
vp.work_effort_name as titolo_ambiti_valpub,
vpot.description as tipologia_ambito_valpub,
vpo.etch as codice_ambito_valpub,
vpo.work_effort_name as titolo_ambito_valpub,
ate_vpo.amount as punteggio_ambito_valpub,
vpo_data.object_info as icon_ambito_valpub,
astt.description as tipologia_area_strategica,
ast.etch as codice_are_strategica,
ast.work_effort_name as titolo_are_strategica,
ate_ast.amount as punteggio_are_strategica,
ast_data.object_info as icon_are_strategica,
(select string_agg(ab.work_effort_name,'; ')
from work_effort_assoc astab
left join work_effort ab on ab.work_effort_id = astab.work_effort_id_from -- AMBITI DI BENESSERE     
	and astab.work_effort_assoc_type_id = '23R2C' 
	and ab.estimated_start_date <= @date3112    -- 'AAAA(input.ref_date)-12-31'
	and ab.estimated_completion_date >= @date0101 -- 'AAAA(input.ref_date)-01-01'
	left join work_effort_type abt on abt.work_effort_type_id = ab.work_effort_type_id   
WHERE astab.work_effort_id_to =ast.work_effort_id and astab.from_date <= @monitoringDate and astab.thru_date >= @monitoringDate) AS ambiti_benessere_are_str, 
oot.description as tipologia_oboperativo,  
FIL_W.etch as codice_oboperativo,
FIL_W.work_effort_name as titolo_oboperativo,
uoooc.parent_role_code as codice_uoresp_oboperativo,
uooo.party_name as uoresp_oboperativo,
uooopa.party_name as resp_tecnico,
ood.note_info as descr_oboperativo,
(select string_agg(concat(pr.etch,' - ',pr.work_effort_name),'; ')
from work_effort_assoc proo
left join work_effort pr on pr.work_effort_id = proo.work_effort_id_from
where proo.work_effort_assoc_type_id = '20D2C'
and proo.from_date <= @monitoringDate and proo.thru_date >= @monitoringDate  -- input.ref_date
and proo.work_effort_id_to = FIL_W.work_effort_id) as programma_oboperativo,
--pr.etch as codice_programma, pr.work_effort_name as programma_oboperativo,  
mi.etch as codice_missione, 
mi.work_effort_name as missione_oboperativo,
(SELECT string_agg(ass.party_name, '; ')
FROM party ass
left join work_effort_party_assignment ooass on ooass.party_id = ass.party_id     
	and (ooass.from_date is null or ooass.from_date <= @monitoringDate) -- input.ref_date  
	and (ooass.thru_date is null or ooass.thru_date >= @monitoringDate) -- input.ref_date  
	and ooass.role_type_id='WEM_P10RESPPOLITICO'
where ooass.work_effort_id=FIL_W.work_effort_id) AS referenti_politici,
ga.account_name as indic_val_pubblico,
uomga.abbreviation as udm,
uomga.uom_type_id as tipo_uom,
uomga.decimal_scale as decimal_scale,
max(case when at.gl_fiscal_type_id = 'BUDGET' and (at.transaction_date is null
		or at.transaction_date = @date3112) and ga.default_uom_id in ('TF_mon', 'TF_yr', 'EUR', 'OTH_NU2', 'OTH_SCO', 'TF_dd', 'TF_hh', 'OTH_NUM', 'OTH_PER') then ae.amount else null end) as target_val_pub,
max(case when at.gl_fiscal_type_id = 'BUDGET' and (at.transaction_date is null
		or at.transaction_date = @date3112) and ga.default_uom_id not in ('TF_mon', 'TF_yr', 'EUR', 'OTH_NU2', 'OTH_SCO', 'TF_dd', 'TF_hh', 'OTH_NUM', 'OTH_PER') then gamrs.uom_descr else null end) as target_val_pub_descr,

max(case when at.gl_fiscal_type_id = 'BUDGET' and (at.transaction_date is null
		or at.transaction_date = @fineannosuccessivo) and ga.default_uom_id in ('TF_mon', 'TF_yr', 'EUR', 'OTH_NU2', 'OTH_SCO', 'TF_dd', 'TF_hh', 'OTH_NUM', 'OTH_PER') then ae.amount else null end) as target_val_pub_piu_uno,
max(case when at.gl_fiscal_type_id = 'BUDGET' and (at.transaction_date is null
		or at.transaction_date = @fineannosuccessivo) and ga.default_uom_id not in ('TF_mon', 'TF_yr', 'EUR', 'OTH_NU2', 'OTH_SCO', 'TF_dd', 'TF_hh', 'OTH_NUM', 'OTH_PER') then gamrs.uom_descr else null end) as target_val_pub_descr_piu_uno,

max(case when at.gl_fiscal_type_id = 'BUDGET' and (at.transaction_date is null
		or at.transaction_date = @finedueannisuccessivi) and ga.default_uom_id in ('TF_mon', 'TF_yr', 'EUR', 'OTH_NU2', 'OTH_SCO', 'TF_dd', 'TF_hh', 'OTH_NUM', 'OTH_PER') then ae.amount else null end) as target_val_pub_piu_due,
max(case when at.gl_fiscal_type_id = 'BUDGET' and (at.transaction_date is null
		or at.transaction_date = @finedueannisuccessivi) and ga.default_uom_id not in ('TF_mon', 'TF_yr', 'EUR', 'OTH_NU2', 'OTH_SCO', 'TF_dd', 'TF_hh', 'OTH_NUM', 'OTH_PER') then gamrs.uom_descr else null end) as target_val_pub_descr_piu_due,


max(case when at.gl_fiscal_type_id = 'ACTUAL' and (at.transaction_date is null
		or at.transaction_date = @date3112) and ga.default_uom_id in ('TF_mon', 'TF_yr', 'EUR', 'OTH_NU2', 'OTH_SCO', 'TF_dd', 'TF_hh', 'OTH_NUM', 'OTH_PER') then ae.amount else null end) as actual_val_pub,
max(case when at.gl_fiscal_type_id = 'ACTUAL' and (at.transaction_date is null
		or at.transaction_date = @date3112) and ga.default_uom_id not in ('TF_mon', 'TF_yr', 'EUR', 'OTH_NU2', 'OTH_SCO', 'TF_dd', 'TF_hh', 'OTH_NUM', 'OTH_PER') then gamrs.uom_descr else null end) as actual_val_pub_descr,

max(case when at.gl_fiscal_type_id = 'ACTUAL' and (at.transaction_date is null
		or at.transaction_date = @fineannosuccessivo) and ga.default_uom_id in ('TF_mon', 'TF_yr', 'EUR', 'OTH_NU2', 'OTH_SCO', 'TF_dd', 'TF_hh', 'OTH_NUM', 'OTH_PER') then ae.amount else null end) as actual_val_pub_piu_uno,
max(case when at.gl_fiscal_type_id = 'ACTUAL' and (at.transaction_date is null
		or at.transaction_date = @fineannosuccessivo) and ga.default_uom_id not in ('TF_mon', 'TF_yr', 'EUR', 'OTH_NU2', 'OTH_SCO', 'TF_dd', 'TF_hh', 'OTH_NUM', 'OTH_PER') then gamrs.uom_descr else null end) as actual_val_pub_descr_piu_uno,

max(case when at.gl_fiscal_type_id = 'ACTUAL' and (at.transaction_date is null
		or at.transaction_date = @finedueannisuccessivi) and ga.default_uom_id in ('TF_mon', 'TF_yr', 'EUR', 'OTH_NU2', 'OTH_SCO', 'TF_dd', 'TF_hh', 'OTH_NUM', 'OTH_PER') then ae.amount else null end) as actual_val_pub_piu_due,
max(case when at.gl_fiscal_type_id = 'ACTUAL' and (at.transaction_date is null
		or at.transaction_date = @finedueannisuccessivi) and ga.default_uom_id not in ('TF_mon', 'TF_yr', 'EUR', 'OTH_NU2', 'OTH_SCO', 'TF_dd', 'TF_hh', 'OTH_NUM', 'OTH_PER') then gamrs.uom_descr else null end) as actual_val_pub_descr_piu_due,

ate_obo.amount as punteggio_ob_operativo,
obo_data.object_info as icon_oboperativo,
---- SOTTOSEZIONE PIAO ----
(select string_agg(distinct sotpiao.work_effort_name,', ') as sotpiao_name 
from work_effort sotpiao 
left join work_effort_assoc piaosez on piaosez.work_effort_id_to=sotpiao.work_effort_id
	and piaosez.work_effort_assoc_type_id='23R6'
	and piaosez.from_date <= @monitoringDate and piaosez.thru_date >= @monitoringDate
left join work_effort sezpiao on sezpiao.work_effort_id=piaosez.work_effort_id_from
	and sezpiao.estimated_start_date <= @date3112 and sezpiao.estimated_completion_date >= @date0101
left join work_effort_assoc pioe on pioe.work_effort_id_from=sotpiao.work_effort_id 
	and pioe.work_effort_assoc_type_id='23R6C' -- COLLEGAMENTO OB.ES CON SOTTSEZ PIAO
	and pioe.from_date <= @monitoringDate and pioe.thru_date >= @monitoringDate  -- input.ref_date
left join work_effort oe on oe.work_effort_id= pioe.work_effort_id_to
	and oe.estimated_start_date <= @date3112 and oe.estimated_completion_date >= @date0101
left join work_effort_assoc oooe on oooe.work_effort_id_to=oe.work_effort_id 
	and oooe.work_effort_assoc_type_id='20D6OC' --COLLEGAMENTO OBO CON OB.ESECUTIVO/PROC
	and oooe.from_date <= @monitoringDate and oooe.thru_date >= @monitoringDate  -- input.ref_date
where oooe.work_effort_id_from=FIL_W.work_effort_id) as sott_sezione_piao,
--- SEZIONE PIAO ----
(select string_agg(distinct sezpiao.work_effort_name,'; ') as sezpiao_name
from work_effort sotpiao
left join work_effort_assoc piaosez on piaosez.work_effort_id_to=sotpiao.work_effort_id
	and piaosez.work_effort_assoc_type_id='23R6'and piaosez.from_date <= @monitoringDate and piaosez.thru_date >= @monitoringDate
left join work_effort sezpiao on sezpiao.work_effort_id=piaosez.work_effort_id_from
	and sezpiao.estimated_start_date <= @date3112 and sezpiao.estimated_completion_date >= @date0101
left join work_effort_assoc pioe on pioe.work_effort_id_from=sotpiao.work_effort_id 
	and pioe.work_effort_assoc_type_id='23R6C' -- COLLEGAMENTO OB.ES CON SOTTSEZ PIAO
	and pioe.from_date <= @monitoringDate and pioe.thru_date >= @monitoringDate  -- input.ref_date
left join work_effort oe on oe.work_effort_id= pioe.work_effort_id_to
	and oe.estimated_start_date <= @date3112 and oe.estimated_completion_date >= @date0101
left join work_effort_assoc oooe on oooe.work_effort_id_to=oe.work_effort_id 
	and oooe.work_effort_assoc_type_id='20D6OC' --COLLEGAMENTO OBO CON OB.ESECUTIVO/PROC
	and oooe.from_date <= @monitoringDate and oooe.thru_date >= @monitoringDate  -- input.ref_date
where oooe.work_effort_id_from=FIL_W.work_effort_id) as sezione_piao 
---- AMBITI VALORE PUBBLICO ----
from work_effort vp 
left join work_effort_type pmp on pmp.work_effort_type_id=vp.work_effort_type_id 
	and vp.work_effort_type_id ='23R80'
INNER JOIN USER_PREFERENCE UP ON UP.USER_PREF_TYPE_ID = 'ORGANIZATION_PARTY' 
	AND UP.USER_PREF_VALUE = VP.ORGANIZATION_ID AND UP.USER_LOGIN_ID = @userLoginId
left join work_effort_type pmt on pmt.work_effort_type_id = vp.work_effort_type_id
left join work_effort_assoc vpavp on vpavp.work_effort_id_from = vp.work_effort_id 
	and vpavp.work_effort_assoc_type_id = '23R8' and vpavp.from_date <= @monitoringDate and vpavp.thru_date >= @monitoringDate  -- input.ref_date 
---- AMBITO VALORE PUBBLICO ---- 
left join work_effort vpo on vpo.work_effort_id = vpavp.work_effort_id_to
	and vpo.estimated_start_date <= @date3112     -- 'AAAA(input.ref_date)-12-31'
	and vpo.estimated_completion_date >= @date0101 -- 'AAAA(input.ref_date)-01-01'
left join work_effort_type vpot on vpot.work_effort_type_id = vpo.work_effort_type_id 
left join work_effort_assoc vpoas on vpoas.work_effort_id_from = vpo.work_effort_id 
	and vpoas.work_effort_assoc_type_id = '23R8' and vpoas.from_date <= @monitoringDate and vpoas.thru_date >= @monitoringDate  -- input.ref_date 
---- AREA STRATEGICA ----
left join work_effort ast on ast.work_effort_id = vpoas.work_effort_id_to  
	and ast.estimated_start_date <= @date3112      -- 'AAAA(input.ref_date)-12-31'  
	and ast.estimated_completion_date >= @date0101 -- 'AAAA(input.ref_date)-01-01'
left join work_effort_type astt on astt.work_effort_type_id = ast.work_effort_type_id
---- COLLEGAMENTO AREA STRATEGICA A OBIETTIVO OPERATIVO ----
left join work_effort_assoc asoo on asoo.work_effort_id_from=ast.work_effort_id
	and asoo.work_effort_assoc_type_id='20R6C' and asoo.from_date <= @monitoringDate and asoo.thru_date >= @monitoringDate  -- input.ref_date 
---- OBIETTIVO OPERATIVO ---- 
left join work_effort FIL_W on FIL_W.work_effort_id = asoo.work_effort_id_to  
	and FIL_W.estimated_start_date <= @date3112      -- 'AAAA(input.ref_date)-12-31'  
	and FIL_W.estimated_completion_date >= @date0101 -- 'AAAA(input.ref_date)-01-01'
inner join work_effort_type oot on oot.work_effort_type_id = FIL_W.work_effort_type_id
@filterInnerJoin
@filterLeftJoin	
---- NOTA DESCRIZIONE OBIETTIVO OPERATIVO ----
left join work_effort_note oon on oon.work_effort_id = FIL_W.work_effort_id and oon.sequence_id='100'
left join note_data ood on ood.note_id = oon.note_id
left join party uooo on uooo.party_id = FIL_W.org_unit_id
left join party_parent_role uoooc on uoooc.party_id = uooo.party_id  and uoooc.role_type_id = 'ORGANIZATION_UNIT'
left join party_group uooog on uooog.party_id = uooo.party_id
left join party_relationship uooore on uooore.party_id_from = uooo.party_id  
	and (uooore.from_date is null or uooore.from_date <= @monitoringDate) -- input.ref_date  
	and (uooore.thru_date is null or uooore.thru_date >= @monitoringDate) -- input.ref_date  
	and uooore.party_relationship_type_id = 'ORG_RESPONSIBLE'  
	and uooore.from_date <= FIL_W.estimated_completion_date  
	and (uooore.thru_date is null or uooore.thru_date >= FIL_W.estimated_start_date)
---- PARTY DEL RESPONSABILE ----
left join party uooopa on uooore.party_id_to is not null and uooopa.party_id = uooore.party_id_to
---- COLLEGAMENTO CON PROGRAMMA BILANCIO ----
left join work_effort_assoc proo on proo.work_effort_id_to = FIL_W.work_effort_id 
	and proo.work_effort_assoc_type_id = '20D2C'  
	and proo.from_date <= @monitoringDate and proo.thru_date >= @monitoringDate  -- input.ref_date
---- PROGRAMMA DI BILANCIO ----
left join work_effort pr on pr.work_effort_id = proo.work_effort_id_from
---- COLLEGAMENTO CON MISSIONE DI BILANCIO ----
left join work_effort_assoc mipr on mipr.work_effort_id_to = pr.work_effort_id 
	and mipr.work_effort_assoc_type_id = '20D2'  
	and mipr.from_date <= @monitoringDate and mipr.thru_date >= @monitoringDate  -- input.ref_date
---- MISSIONE DI BILANCIO ----
left join work_effort mi on mi.work_effort_id = mipr.work_effort_id_from
---- COLLEGAMENTO CON SCHEMA BILANCIO ----
left join work_effort_assoc bimi on bimi.work_effort_id_to = mi.work_effort_id 
	and bimi.work_effort_assoc_type_id = '20D2'  
	and bimi.from_date <= @monitoringDate and bimi.thru_date >= @monitoringDate  -- input.ref_date
---- SCHEMA BILANCIO ----
left join work_effort bi on bi.work_effort_id = bimi.work_effort_id_from
----- INDICATORI VALORE PUBBLICO ----
left join work_effort_measure ind_ope on ind_ope.work_effort_id = FIL_W.work_effort_id
	and ind_ope.gl_account_id <>'SCORE' 
	and ind_ope.period_type_id='FISCAL_YEAR'
left join gl_account ga on ga.gl_account_id=ind_ope.gl_account_id
left join uom uomga on uomga.uom_id=ga.default_uom_id
left join acctg_trans_entry ae on ae.gl_account_id=ind_ope.gl_account_id 
left join gl_account_meas_rat_sc gamrs on gamrs.gl_account_id=ae.gl_account_id and gamrs.uom_rating_value=ae.amount
left join acctg_trans at on ae.acctg_trans_id = at.acctg_trans_id
---- PUNTEGGIO OBIETTIVO OPERATIVO ----
left join work_effort_measure sco_obo on sco_obo.gl_account_id = 'SCORE' and sco_obo.work_effort_id = FIL_W.work_effort_id   
left join acctg_trans at_obo on at_obo.voucher_ref = sco_obo.work_effort_measure_id  and at_obo.transaction_date = @monitoringDate  --input.ref_date
left join acctg_trans_entry ate_obo on ate_obo.acctg_trans_id = at_obo.acctg_trans_id  
left join uom_range_values ri_obo on ri_obo.uom_range_id = oot.uom_range_score_id  
	and ri_obo.from_value <= ate_obo.amount 
	and ri_obo.thru_value >= ate_obo.amount
left join content co_obo on co_obo.content_id = ri_obo.icon_content_id
left join data_resource obo_data on obo_data.data_resource_id = co_obo.data_resource_id
---- PUNTEGGIO AREA STRATEGICA ----
left join work_effort_measure sco_ast on sco_ast.gl_account_id = 'SCORE'  
	and sco_ast.work_effort_id = ast.work_effort_id   
left join acctg_trans at_ast on at_ast.voucher_ref = sco_ast.work_effort_measure_id  and at_ast.transaction_date = @monitoringDate
left join acctg_trans_entry ate_ast on ate_ast.acctg_trans_id = at_ast.acctg_trans_id  
left join uom_range_values ri_ast on ri_ast.uom_range_id = astt.uom_range_score_id  
	and ri_ast.from_value <= ate_ast.amount and ri_ast.thru_value >= ate_ast.amount
left join content co_ast on co_ast.content_id = ri_ast.icon_content_id
left join data_resource ast_data on ast_data.data_resource_id = co_ast.data_resource_id
---- PUNTEGGIO AREA AMBITI DI VALORE PUBBLICO ----
left join work_effort_measure sco_vpo on sco_vpo.gl_account_id = 'SCORE'  
	and sco_vpo.work_effort_id = vpo.work_effort_id   
left join acctg_trans at_vpo on at_vpo.voucher_ref = sco_vpo.work_effort_measure_id and at_vpo.transaction_date = @monitoringDate  --input.ref_date
left join acctg_trans_entry ate_vpo on ate_vpo.acctg_trans_id = at_vpo.acctg_trans_id  
left join uom_range_values ri_vpo on ri_vpo.uom_range_id = vpot.uom_range_score_id  
	and ri_vpo.from_value <= ate_vpo.amount and ri_vpo.thru_value >= ate_vpo.amount
left join content co_vpo on co_vpo.content_id = ri_vpo.icon_content_id
left join data_resource vpo_data on vpo_data.data_resource_id = co_vpo.data_resource_id
where  1=1
@filterWhere
group by vp.work_effort_name, vp.work_effort_id, vpo.work_effort_name, vpo.work_effort_id,         
vp.etch, vpo.etch, ast.etch,ast.work_effort_id, ast.work_effort_name, 
oot.etch, FIL_W.work_effort_name, FIL_W.work_effort_id,         
uoooc.parent_role_code, uooo.party_name, uooopa.party_name, ood.note_info,         
pr.work_effort_name, pr.work_effort_id, mi.work_effort_name, mi.work_effort_id,         
ga.account_name, ate_obo.amount, ate_ast.amount, ate_vpo.amount,vpo_data.object_info,
ast_data.object_info,obo_data.object_info,uomga.abbreviation,uomga.uom_type_id,uomga.decimal_scale,vpot.description,astt.description,oot.description 
order by vpo.etch]]></xml-property>
