            <xml-property name="queryText"><![CDATA[SELECT
	V.M_SEQUENCE_ID AS SEQUENZA,
	V.G_INPUT_ENUM_ID AS TIPO_ODELLO,
	V.G_ACCOUNT_CODE AS CODICE_INDIC,
	V.G_ACCOUNT_NAME AS TITOLO_INDIC,
	V.G_DESCRIPTION AS DESCRIZIONE_INDIC,
	V.G_UOM_ABBREVIATION AS UOM_ETCH,
	V.M_UOM_DESCR AS TITOLO_MISURA,
	V.M_COMMENTS AS DESCRIZIONE_MISURA,
	V.G_DETAIL_ENUM_ID,
	-- GESTITO SOLO ACCDET_NULL	
 	V.G_UOM_TYPE_ID AS TIPO_UOM,
	V.G_UOM_DECIMAL_SCALE AS SCALA_UOM,
	SUM( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menotre THEN V.TM_AMOUNT ELSE NULL END ) ACTUAL_DATO_3112_MENO_TRE,
	SUM( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menodue THEN V.TM_AMOUNT ELSE NULL END ) ACTUAL_DATO_3112_MENO_DUE,
	SUM( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menouno THEN V.TM_AMOUNT ELSE NULL END ) ACTUAL_DATO_3112_MENO_UNO,
	SUM( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3006 THEN V.TM_AMOUNT ELSE NULL END ) ACTUAL_DATO_3006,
	SUM( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3112 THEN V.TM_AMOUNT ELSE NULL END ) ACTUAL_DATO_3112,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menotre THEN V.R_UOM_CODE ELSE NULL END ) ACTUAL_COD_3112_MENO_TRE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menodue THEN V.R_UOM_CODE ELSE NULL END ) ACTUAL_COD_3112_MENO_DUE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menouno THEN V.R_UOM_CODE ELSE NULL END ) ACTUAL_COD_3112_MENO_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3006 THEN V.R_UOM_CODE ELSE NULL END ) ACTUAL_COD_3006,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3112 THEN V.R_UOM_CODE ELSE NULL END ) ACTUAL_COD_3112,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3006 THEN V.TT_DESCRIPTION ELSE NULL END ) ACTUAL_COMM_3006,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3112 THEN V.TT_DESCRIPTION ELSE NULL END ) ACTUAL_COMM_3112,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @fineannosuccessivo THEN V.TT_DESCRIPTION ELSE NULL END ) ACTUAL_COMM_3112_PIU_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @finedueannisuccessivi THEN V.TT_DESCRIPTION ELSE NULL END ) ACTUAL_COMM_3112_PIU_DUE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3006 THEN V.TM_DESCRIPTION ELSE NULL END ) ACTUAL_RIF_3006,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3112 THEN V.TM_DESCRIPTION ELSE NULL END ) ACTUAL_RIF_3112,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @fineannosuccessivo THEN V.TM_DESCRIPTION ELSE NULL END ) ACTUAL_RIF_3112_PIU_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @finedueannisuccessivi THEN V.TM_DESCRIPTION ELSE NULL END ) ACTUAL_RIF_3112_PIU_DUE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menotre THEN V.R_UOM_CODE ELSE NULL END ) BUDGET_COD_3112_MENO_TRE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menodue THEN V.R_UOM_CODE ELSE NULL END ) BUDGET_COD_3112_MENO_DUE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menouno THEN V.R_UOM_CODE ELSE NULL END ) BUDGET_COD_3112_MENO_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3006 THEN V.R_UOM_CODE ELSE NULL END ) BUDGET_COD_3006,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3112 THEN V.R_UOM_CODE ELSE NULL END ) BUDGET_COD_3112,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @fineannosuccessivo THEN V.R_UOM_CODE ELSE NULL END ) BUDGET_COD_3112_PIU_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @finedueannisuccessivi THEN V.R_UOM_CODE ELSE NULL END ) BUDGET_COD_3112_PIU_DUE,
	SUM( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menotre THEN V.TM_AMOUNT ELSE NULL END ) BUDGET_DATO_3112_MENO_TRE,
	SUM( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menodue THEN V.TM_AMOUNT ELSE NULL END ) BUDGET_DATO_3112_MENO_DUE,
	SUM( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menouno THEN V.TM_AMOUNT ELSE NULL END ) BUDGET_DATO_3112_MENO_UNO,
	SUM( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3006 THEN V.TM_AMOUNT ELSE NULL END ) BUDGET_DATO_3006,
	SUM( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3112 THEN V.TM_AMOUNT ELSE NULL END ) BUDGET_DATO_3112,
	SUM( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @fineannosuccessivo THEN V.TM_AMOUNT ELSE NULL END ) BUDGET_DATO_3112_PIU_UNO,
	SUM( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @finedueannisuccessivi THEN V.TM_AMOUNT ELSE NULL END ) BUDGET_DATO_3112_PIU_DUE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3006 THEN V.TT_DESCRIPTION ELSE NULL END ) BUDGET_COMM_3006,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3112 THEN V.TT_DESCRIPTION ELSE NULL END ) BUDGET_COMM_3112,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @fineannosuccessivo THEN V.TT_DESCRIPTION ELSE NULL END ) BUDGET_COMM_3112_PIU_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @finedueannisuccessivi THEN V.TT_DESCRIPTION ELSE NULL END ) BUDGET_COMM_3112_PIU_DUE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3006 THEN V.TM_DESCRIPTION ELSE NULL END ) BUDGET_RIF_3006,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3112 THEN V.TM_DESCRIPTION ELSE NULL END ) BUDGET_RIF_3112,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @fineannosuccessivo THEN V.TM_DESCRIPTION ELSE NULL END ) BUDGET_RIF_3112_PIU_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @finedueannisuccessivi THEN V.TM_DESCRIPTION ELSE NULL END ) BUDGET_RIF_3112_PIU_DUE, 
	SUM(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3006 THEN TR.B_AMOUNT ELSE NULL END) SCORE_DATO_3006,  
	SUM(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3112 THEN TR.B_AMOUNT ELSE NULL END) SCORE_DATO_3112,  
	MAX(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3112 THEN TR.A_DESCRIPTION ELSE NULL END) SCORE_COMM_3112,  
	MAX(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3006 THEN TR.A_DESCRIPTION ELSE NULL END) SCORE_COMM_3006,  
	MAX(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3006 THEN TR.B_DESCRIPTION ELSE NULL END) SCORE_RIF_3006,  
	MAX(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3112 THEN TR.B_DESCRIPTION ELSE NULL END) SCORE_RIF_3112,  
	MAX(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3006 THEN RV.COMMENTS ELSE NULL END) SCORE_DESC_3006,  
	MAX(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3112 THEN RV.COMMENTS ELSE NULL END) SCORE_DESC_3112,  
	MAX(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3006 THEN DR.OBJECT_INFO ELSE NULL END) SCORE_EMOTICON_3006,  
	MAX(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3112 THEN DR.OBJECT_INFO ELSE NULL END) SCORE_EMOTICON_3112
FROM
	WORK_EFFORT_TRANS_ALL_VIEW V
INNER JOIN WORK_EFFORT_TYPE WET ON WET.WORK_EFFORT_TYPE_ID = V.W_WORK_EFFORT_TYPE_ID
LEFT JOIN ACCTG_TRANS_VIEW TR ON TR.B_GL_ACCOUNT_ID ='SCORE'
  AND TR.B_VOUCHER_REF = V.M_WORK_EFFORT_MEASURE_ID
  AND TR.A_TRANSACTION_DATE = V.TT_TRANSACTION_DATE
  AND TR.B_GL_FISCAL_TYPE_ID = V.TT_GL_FISCAL_TYPE_ID
LEFT JOIN UOM_RANGE_VALUES RV ON TR.B_AMOUNT IS NOT NULL
  AND RV.UOM_RANGE_ID = WET.UOM_RANGE_SCORE_ID
  AND RV.FROM_VALUE <= TR.B_AMOUNT AND RV.THRU_VALUE >= TR.B_AMOUNT
LEFT JOIN CONTENT CO ON RV.ICON_CONTENT_ID IS NOT NULL
  AND CO.CONTENT_ID = RV.ICON_CONTENT_ID
LEFT JOIN DATA_RESOURCE DR ON CO.DATA_RESOURCE_ID IS NOT NULL
  AND DR.DATA_RESOURCE_ID = CO.DATA_RESOURCE_ID
WHERE
	V.G_GL_ACCOUNT_TYPE_ID IN(
		'INDGEN',
		'INDSER'
		  
	)
	AND V.G_ACCOUNT_CODE <> 'SCORE'
	AND V.M_WORK_EFFORT_ID = ?
	AND V.M_THRU_DATE >= @date0101
	AND V.M_FROM_DATE <= @date3112
GROUP BY
	V.M_SEQUENCE_ID,
	V.G_INPUT_ENUM_ID,
	V.G_ACCOUNT_CODE,
	V.M_WORK_EFFORT_MEASURE_ID,
	V.G_ACCOUNT_NAME,
	V.G_DESCRIPTION,
	V.G_UOM_ABBREVIATION,
	V.M_UOM_DESCR,
	V.M_COMMENTS,
	V.G_DETAIL_ENUM_ID,
	-- GESTITO SOLO ACCDET_NULL	
 	V.G_UOM_TYPE_ID,
	V.G_UOM_DECIMAL_SCALE	
UNION ALL
	SELECT
	V.M_SEQUENCE_ID AS SEQUENZA,
	V.G_INPUT_ENUM_ID AS TIPO_ODELLO,
	V.G_ACCOUNT_CODE AS CODICE_INDIC,
	V.G_ACCOUNT_NAME AS TITOLO_INDIC,
	V.G_DESCRIPTION AS DESCRIZIONE_INDIC,
	V.G_UOM_ABBREVIATION AS UOM_ETCH,
	V.M_UOM_DESCR AS TITOLO_MISURA,
	V.M_COMMENTS AS DESCRIZIONE_MISURA,
	V.G_DETAIL_ENUM_ID,
	-- GESTITO SOLO ACCDET_NULL	
 	V.G_UOM_TYPE_ID AS TIPO_UOM,
	V.G_UOM_DECIMAL_SCALE AS SCALA_UOM,
	SUM( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menotre THEN V.TM_AMOUNT ELSE NULL END ) ACTUAL_DATO_3112_MENO_TRE,
	SUM( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menodue THEN V.TM_AMOUNT ELSE NULL END ) ACTUAL_DATO_3112_MENO_DUE,
	SUM( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menouno THEN V.TM_AMOUNT ELSE NULL END ) ACTUAL_DATO_3112_MENO_UNO,
	SUM( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3006 THEN V.TM_AMOUNT ELSE NULL END ) ACTUAL_DATO_3006,
	SUM( CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3112 THEN V.TM_AMOUNT ELSE NULL END ) ACTUAL_DATO_3112,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menotre THEN V.R_UOM_CODE ELSE NULL END ) ACTUAL_COD_3112_MENO_TRE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menodue THEN V.R_UOM_CODE ELSE NULL END ) ACTUAL_COD_3112_MENO_DUE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menouno THEN V.R_UOM_CODE ELSE NULL END ) ACTUAL_COD_3112_MENO_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3006 THEN V.R_UOM_CODE ELSE NULL END ) ACTUAL_COD_3006,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3112 THEN V.R_UOM_CODE ELSE NULL END ) ACTUAL_COD_3112,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3006 THEN V.TT_DESCRIPTION ELSE NULL END ) ACTUAL_COMM_3006,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3112 THEN V.TT_DESCRIPTION ELSE NULL END ) ACTUAL_COMM_3112,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @fineannosuccessivo THEN V.TT_DESCRIPTION ELSE NULL END ) ACTUAL_COMM_3112_PIU_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @finedueannisuccessivi THEN V.TT_DESCRIPTION ELSE NULL END ) ACTUAL_COMM_3112_PIU_DUE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3006 THEN V.TM_DESCRIPTION ELSE NULL END ) ACTUAL_RIF_3006,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3112 THEN V.TM_DESCRIPTION ELSE NULL END ) ACTUAL_RIF_3112,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @fineannosuccessivo THEN V.TM_DESCRIPTION ELSE NULL END ) ACTUAL_RIF_3112_PIU_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @finedueannisuccessivi THEN V.TM_DESCRIPTION ELSE NULL END ) ACTUAL_RIF_3112_PIU_DUE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menotre THEN V.R_UOM_CODE ELSE NULL END ) BUDGET_COD_3112_MENO_TRE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menodue THEN V.R_UOM_CODE ELSE NULL END ) BUDGET_COD_3112_MENO_DUE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menouno THEN V.R_UOM_CODE ELSE NULL END ) BUDGET_COD_3112_MENO_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3006 THEN V.R_UOM_CODE ELSE NULL END ) BUDGET_COD_3006,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3112 THEN V.R_UOM_CODE ELSE NULL END ) BUDGET_COD_3112,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @fineannosuccessivo THEN V.R_UOM_CODE ELSE NULL END ) BUDGET_COD_3112_PIU_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @finedueannisuccessivi THEN V.R_UOM_CODE ELSE NULL END ) BUDGET_COD_3112_PIU_DUE,
	SUM( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menotre THEN V.TM_AMOUNT ELSE NULL END ) BUDGET_DATO_3112_MENO_TRE,
	SUM( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menodue THEN V.TM_AMOUNT ELSE NULL END ) BUDGET_DATO_3112_MENO_DUE,
	SUM( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menouno THEN V.TM_AMOUNT ELSE NULL END ) BUDGET_DATO_3112_MENO_UNO,
	SUM( CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3006 THEN V.TM_AMOUNT ELSE NULL END ) BUDGET_DATO_3006,
	SUM( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3112 THEN V.TM_AMOUNT ELSE NULL END ) BUDGET_DATO_3112,
	SUM( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @fineannosuccessivo THEN V.TM_AMOUNT ELSE NULL END ) BUDGET_DATO_3112_PIU_UNO,
	SUM( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @finedueannisuccessivi THEN V.TM_AMOUNT ELSE NULL END ) BUDGET_DATO_3112_PIU_DUE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3006 THEN V.TT_DESCRIPTION ELSE NULL END ) BUDGET_COMM_3006,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3112 THEN V.TT_DESCRIPTION ELSE NULL END ) BUDGET_COMM_3112,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @fineannosuccessivo THEN V.TT_DESCRIPTION ELSE NULL END ) BUDGET_COMM_3112_PIU_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @finedueannisuccessivi THEN V.TT_DESCRIPTION ELSE NULL END ) BUDGET_COMM_3112_PIU_DUE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3006 THEN V.TM_DESCRIPTION ELSE NULL END ) BUDGET_RIF_3006,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3112 THEN V.TM_DESCRIPTION ELSE NULL END ) BUDGET_RIF_3112,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @fineannosuccessivo THEN V.TM_DESCRIPTION ELSE NULL END ) BUDGET_RIF_3112_PIU_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @finedueannisuccessivi THEN V.TM_DESCRIPTION ELSE NULL END ) BUDGET_RIF_3112_PIU_DUE, 
	SUM(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3006 THEN TR.B_AMOUNT ELSE NULL END) SCORE_DATO_3006,  
	SUM(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3112 THEN TR.B_AMOUNT ELSE NULL END) SCORE_DATO_3112,  
	MAX(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3112 THEN TR.A_DESCRIPTION ELSE NULL END) SCORE_COMM_3112,  
	MAX(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3006 THEN TR.A_DESCRIPTION ELSE NULL END) SCORE_COMM_3006,  
	MAX(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3006 THEN TR.B_DESCRIPTION ELSE NULL END) SCORE_RIF_3006,  
	MAX(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3112 THEN TR.B_DESCRIPTION ELSE NULL END) SCORE_RIF_3112,  
	MAX(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3006 THEN RV.COMMENTS ELSE NULL END) SCORE_DESC_3006,  
	MAX(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3112 THEN RV.COMMENTS ELSE NULL END) SCORE_DESC_3112,  
	MAX(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3006 THEN DR.OBJECT_INFO ELSE NULL END) SCORE_EMOTICON_3006,  
	MAX(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3112 THEN DR.OBJECT_INFO ELSE NULL END) SCORE_EMOTICON_3112
FROM
	WORK_EFFORT_TRANS_ALL_VIEW V    	
INNER JOIN WORK_EFFORT_TYPE WET ON WET.WORK_EFFORT_TYPE_ID = V.W_WORK_EFFORT_TYPE_ID
LEFT JOIN ACCTG_TRANS_VIEW TR ON TR.B_GL_ACCOUNT_ID ='SCORE'
  AND TR.B_VOUCHER_REF = V.M_WORK_EFFORT_MEASURE_ID
  AND TR.A_TRANSACTION_DATE = V.TT_TRANSACTION_DATE
  AND TR.B_GL_FISCAL_TYPE_ID = V.TT_GL_FISCAL_TYPE_ID
LEFT JOIN UOM_RANGE_VALUES RV ON TR.B_AMOUNT IS NOT NULL
  AND RV.UOM_RANGE_ID = WET.UOM_RANGE_SCORE_ID
  AND RV.FROM_VALUE <= TR.B_AMOUNT AND RV.THRU_VALUE >= TR.B_AMOUNT
LEFT JOIN CONTENT CO ON RV.ICON_CONTENT_ID IS NOT NULL
  AND CO.CONTENT_ID = RV.ICON_CONTENT_ID
LEFT JOIN DATA_RESOURCE DR ON CO.DATA_RESOURCE_ID IS NOT NULL
  AND DR.DATA_RESOURCE_ID = CO.DATA_RESOURCE_ID
INNER JOIN WORK_EFFORT_ASSOC OOSO ON OOSO.WORK_EFFORT_ID_TO = V.M_WORK_EFFORT_ID	
 AND OOSO.WORK_EFFORT_ASSOC_TYPE_ID = '20D6O'	
WHERE
	V.G_GL_ACCOUNT_TYPE_ID IN(
		'INDGEN',
		'INDSER'
		  
	)
	AND V.G_ACCOUNT_CODE <> 'SCORE' 
	AND OOSO.WORK_EFFORT_ID_FROM = ?	--oo_work_effort_id
	AND V.M_THRU_DATE >= @date0101
	AND V.M_FROM_DATE <= @date3112
GROUP BY
	V.M_SEQUENCE_ID,
	V.G_INPUT_ENUM_ID,
	V.G_ACCOUNT_CODE,
	V.M_WORK_EFFORT_MEASURE_ID,
	V.G_ACCOUNT_NAME,
	V.G_DESCRIPTION,
