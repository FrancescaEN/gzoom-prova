            <xml-property name="queryText"><![CDATA[select
ooass.sequence_num as seq_refpol, assrole.role_type_id as tipo_refpole, assrole.description as ruolo_refpol, ass.party_name as referente_politico
from 
work_effort_party_assignment ooass 
inner join party ass on ass.party_id = ooass.party_id
inner join role_type assrole on assrole.role_type_id = ooass.role_type_id
where ooass.work_effort_id = ? -- main.work_effort_id
  and ooass.role_type_id='WEM_P10RESPPOLITICO'
  and (ooass.from_date is null or ooass.from_date <= @monitoringDate) -- input.ref_date
  and (ooass.thru_date is null or ooass.thru_date >= @monitoringDate) -- input.ref_date
order by ooass.sequence_num, assrole.role_type_id, ass.party_name
]]></xml-property>
