this.queryText = this.queryText.replace("@finedueannisuccessivi",  "'2020-12-31 00:00:00.000'" );				
this.queryText = this.queryText.replace("@date1231menouno", "'2020-12-31 00:00:00.000'");
this.queryText = this.queryText.replace("@date1231menodue", "'2020-12-31 00:00:00.000'");
this.queryText = this.queryText.replace("@date1231menotre",  "'2020-12-31 00:00:00.000'");
this.queryText = this.queryText.replace("@monitoringDate",  "'2020-12-31 00:00:00.000'");
this.queryText = this.queryText.replace("@date3006",  "'2020-12-31 00:00:00.000'"); 
