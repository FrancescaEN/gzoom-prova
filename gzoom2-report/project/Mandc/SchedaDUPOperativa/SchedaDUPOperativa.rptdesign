            <xml-property name="queryText"><![CDATA[select
lmt.etch as etic_linea_mandato,
lm.etch as codice_linea, lm.work_effort_name as titolo_lineamandato,drlm.object_info as emoticon_linea, pun_lm.amount as punteggio_linea, 
ost.etch as etic_obi_strategico, 
os.etch as codice_obistrategico, os.work_effort_name as titolo_obistrategico, osd.note_info as descr_obistrategico, 
pun_obs.amount as puntegio_obistrategico, dros.object_info as emoticon_obistrategico,
oot.etch as etic_obi_operativo, 
FIL_W.etch as codice_obioperativo, FIL_W.work_effort_name as titolo_obioperativo,  ood.note_info as descr_obioperativo, 
claso.work_effort_name as classificazione_obiettivo,
uoooc.parent_role_code as codice_uoresp, uooo.external_id as codso4_uoresp, 
uooog.comments codcdr_uoresp, uooo.party_name as uoresp_operativo,
uooopa.party_name as resp_tecnico,
aer.amount as risultato_valore, ris.comments as risultato_descrizione, drr.object_info as risultato_emoticon, 
aer.description as risultato_riferimento, atr.description as risultato_commento, 
nd_atsv.note_name as tipologia_att_svolgere,nd_rso.note_name as tipologia_ris_ottenuto, nd_img.note_name as tipologia_iniz_miglioramento,
nd_atsv.note_info as nota_att_svolgere, nd_rso.note_info as nota_ris_ottenuto, nd_img.note_info as nota_iniz_miglioramento,
ooass.sequence_num as seq_refpol, assrole.role_type_id as tipo_refpole, assrole.description as ruolo_refpol, ass.party_name as referente_politico, 
mi.work_effort_id, 
prtype.etch as etic_programma, pr.etch as codice_programma, pr.work_effort_name as programma, 
mitype.etch as etic_missione, mi.etch as codice_missione, mi.work_effort_name as missione, 
so.etch as codice_sottobiettivo, so.work_effort_name as sottoobiettivo, 
uosoc.parent_role_code as codice_altrauo, uoso.external_id as codso4_altrauo, 
uosog.comments as codcdr_altrauo, uoso.party_name as altreuo_operativo,
uosopa.party_name as altro_resp_tecnico, 
aer.amount as valutazione_valore, ris.comments as valutazione_descrizione, drr.object_info as valutazione_emoticon,
aer.orig_amount misurazione_valore, aer.description as misurazione_riferimento, atr.description as misurazione_commento,
mi.work_effort_id, 
FIL_W.work_effort_id as oo_work_effort, so.work_effort_id as so_work_effort
from work_effort pm
inner join work_effort_type pmt on pmt.work_effort_type_id = pm.work_effort_type_id
inner join work_effort_assoc pmlm on pmlm.work_effort_id_from = pm.work_effort_id
 and pmlm.work_effort_assoc_type_id = '20D6'
 and pmlm.from_date <= @monitoringDate and pmlm.thru_date >= @monitoringDate  -- input.ref_date
inner join work_effort lm on lm.work_effort_id = pmlm.work_effort_id_to
	and lm.estimated_start_date <= @date3112     -- 'AAAA(input.ref_date)-12-31'
	and lm.estimated_completion_date >= @date0101 -- 'AAAA(input.ref_date)-01-01'
inner join work_effort_type lmt on lmt.work_effort_type_id = lm.work_effort_type_id 
-- PUNTEGGIO LINEA STRATEGICA
left join work_effort_measure lmm on lmm.work_effort_id =lm.work_effort_id
	and  lmm.gl_account_id = 'SCORE'
left join acctg_trans lms on lmm.work_effort_measure_id is not null
  	and lms.voucher_ref = lmm.work_effort_measure_id
  	and lms.transaction_date = @monitoringDate  --input.ref_date
left join acctg_trans_entry pun_lm on pun_lm.acctg_trans_id=lms.acctg_trans_id
left join uom_range_values urvlm on pun_lm.amount is not null
  and urvlm.uom_range_id = lmt.uom_range_score_id  
  and urvlm.from_value <= pun_lm.amount and urvlm.thru_value >= pun_lm.amount
left join content corlm on urvlm.icon_content_id is not null
  and corlm.content_id = urvlm.icon_content_id
left join data_resource drlm on corlm.data_resource_id is not null
  and drlm.data_resource_id = corlm.data_resource_id 
  
inner join work_effort_assoc lmos on lmos.work_effort_id_from = lm.work_effort_id
 and lmos.work_effort_assoc_type_id = '20D6'
 and lmos.from_date <= @monitoringDate and lmos.thru_date >= @monitoringDate  -- input.ref_date
inner join work_effort os on os.work_effort_id = lmos.work_effort_id_to
  and os.estimated_start_date <= @date3112      -- 'AAAA(input.ref_date)-12-31'
  and os.estimated_completion_date >= @date0101 -- 'AAAA(input.ref_date)-01-01'
inner join work_effort_type ost on ost.work_effort_type_id = os.work_effort_type_id 
-- PUNTEGGIO OBIETTIVO STRATEGICO
  left join work_effort_measure osm on osm.work_effort_id = os.work_effort_id and  osm.gl_account_id = 'SCORE'
left join acctg_trans oss on osm.work_effort_measure_id is not null
  and oss.voucher_ref = osm.work_effort_measure_id
  and oss.transaction_date = @monitoringDate --input.ref_date
left join acctg_trans_entry pun_obs
on pun_obs.acctg_trans_id=oss.acctg_trans_id
left join uom_range_values urvos on pun_obs.amount is not null
  and urvos.uom_range_id = ost.uom_range_score_id  
  and urvos.from_value <= pun_obs.amount and urvos.thru_value >= pun_obs.amount
left join content coros on urvos.icon_content_id is not null
  and coros.content_id = urvos.icon_content_id
left join data_resource dros on coros.data_resource_id is not null
  and dros.data_resource_id = coros.data_resource_id 
inner join work_effort_note osn on osn.work_effort_id = os.work_effort_id 
inner join note_data osd on osd.note_id = osn.note_id
 and (osn.is_main = 'Y' or osd.note_date_time = @date0101) 
inner join work_effort_assoc osoo on osoo.work_effort_id_from = os.work_effort_id
 and osoo.work_effort_assoc_type_id = '20D6C'
  and osoo.from_date <= @monitoringDate and osoo.thru_date >= @monitoringDate  -- input.ref_date
inner join work_effort FIL_W on
	FIL_W.work_effort_id = osoo.work_effort_id_to
  and FIL_W.estimated_start_date <= @date3112      -- 'AAAA(input.ref_date)-12-31'
  and FIL_W.estimated_completion_date >= @date0101 -- 'AAAA(input.ref_date)-01-01'
inner join work_effort_type oot on oot.work_effort_type_id = FIL_W.work_effort_type_id 
inner join work_effort_note oon on oon.work_effort_id = FIL_W.work_effort_id and oon.sequence_id='100' 
inner join note_data ood on ood.note_id = oon.note_id
 and (oon.is_main = 'Y' or ood.note_date_time = @date0101) 
 
-- COLLEGAMENTO CON CLASSIFICAZIONE OBIETTIVO 
																				  
left join work_effort_assoc prosp on prosp.work_effort_id_to = FIL_W.work_effort_id and prosp.work_effort_assoc_type_id ='23R4C'
											 
-- WORK CLASSIFICAZIONE OBIETTIVO
left join work_effort claso on
	prosp.work_effort_id_from is not null
	and claso.work_effort_id = prosp.work_effort_id_from
	and(
		claso.estimated_start_date is null
		or claso.estimated_start_date <= @date3112
	) -- 'AAAA(input.ref_date)-12-31'
	and(
		claso.estimated_completion_date is null
		or claso.estimated_completion_date >= @date0101
	) -- 'AAA(input.ref_date)-01-01'
 
inner join party uooo on uooo.party_id = FIL_W.org_unit_id
inner join party_parent_role uoooc on uoooc.party_id = uooo.party_id
  and uoooc.role_type_id = 'ORGANIZATION_UNIT'
inner join party_group uooog on uooog.party_id = uooo.party_id
left join party_relationship uooore on uooore.party_id_from = uooo.party_id
  and (uooore.from_date is null or uooore.from_date <= @monitoringDate) -- input.ref_date
  and (uooore.thru_date is null or uooore.thru_date >= @monitoringDate) -- input.ref_date
  and uooore.party_relationship_type_id = 'ORG_RESPONSIBLE'
  and uooore.from_date <= FIL_W.estimated_completion_date
  and (uooore.thru_date is null or uooore.thru_date >= FIL_W.estimated_start_date)
left join party uooopa on uooore.party_id_to is not null
 and uooopa.party_id = uooore.party_id_to
left join work_effort_party_assignment ooass on ooass.work_effort_id = FIL_W.work_effort_id
  and (ooass.from_date is null or ooass.from_date <= @monitoringDate) -- input.ref_date
  and (ooass.thru_date is null or ooass.thru_date >= @monitoringDate) -- input.ref_date
left join party ass on ooass.party_id is not null
 and ass.party_id = ooass.party_id
left join role_type assrole on ooass.role_type_id is not null
 and assrole.role_type_id = ooass.role_type_id
inner join work_effort_assoc proo on proo.work_effort_id_to = FIL_W.work_effort_id
 and proo.work_effort_assoc_type_id = '20D2C'
  and proo.from_date <= @monitoringDate and proo.thru_date >= @monitoringDate  -- input.ref_date
inner join work_effort pr on pr.work_effort_id = proo.work_effort_id_from
inner join work_effort_type prtype on prtype.work_effort_type_id = pr.work_effort_type_id 
inner join work_effort_assoc mipr on mipr.work_effort_id_to = pr.work_effort_id
 and mipr.work_effort_assoc_type_id = '20D2'
  and mipr.from_date <= @monitoringDate and mipr.thru_date >= @monitoringDate  -- input.ref_date
inner join work_effort mi on mi.work_effort_id = mipr.work_effort_id_from
inner join work_effort_type mitype on mitype.work_effort_type_id = mi.work_effort_type_id 
inner join work_effort_assoc bimi on bimi.work_effort_id_to = mi.work_effort_id
 and bimi.work_effort_assoc_type_id = '20D2'
  and bimi.from_date <= @monitoringDate and bimi.thru_date >= @monitoringDate  -- input.ref_date
inner join work_effort bi on bi.work_effort_id = bimi.work_effort_id_from
inner join user_preference up on up.user_pref_value = pm.organization_id 
	and up.user_pref_type_id = 'ORGANIZATION_PARTY' and up.user_login_id = @userLoginId
@filterInnerJoin
@filterLeftJoin	
left join work_effort_assoc ooso on ooso.work_effort_id_from = FIL_W.work_effort_id
 and ooso.work_effort_assoc_type_id = '20D6O'
  and ooso.from_date <= @monitoringDate and ooso.thru_date >= @monitoringDate  -- input.ref_date
left join work_effort so on ooso.work_effort_id_to is not null
  and so.work_effort_id = ooso.work_effort_id_to
  and (so.estimated_start_date is null or so.estimated_start_date <= @date3112)           -- 'AAAA(input.ref_date)-12-31'
  and (so.estimated_completion_date is null or so.estimated_completion_date >= @date0101) -- 'AAA(input.ref_date)-01-01'
left join party uoso on so.org_unit_id is not null
 and uoso.party_id = so.org_unit_id
left join party_parent_role uosoc on uoso.party_id is not null
 and uosoc.party_id = uoso.party_id
 and uosoc.role_type_id = 'ORGANIZATION_UNIT'
left join party_group uosog on uoso.party_id is not null
 and  uosog.party_id = uoso.party_id
left join party_relationship uosore on uoso.party_id is not null
  and (uosore.from_date is null or uosore.from_date <= @monitoringDate) -- input.ref_date
  and (uosore.thru_date is null or uosore.thru_date >= @monitoringDate) -- input.ref_date
 and uosore.party_id_from = uoso.party_id
 and uosore.party_relationship_type_id = 'ORG_RESPONSIBLE'
 and uosore.from_date <= so.estimated_completion_date
 and (uosore.thru_date is null or uosore.thru_date >= so.estimated_start_date)
left join party uosopa on uosore.party_id_to is not null and uosopa.party_id = uosore.party_id_to
left join work_effort_measure opm on
	opm.work_effort_id = FIL_W.work_effort_id
	and opm.gl_account_id = '10001'
left join acctg_trans at on
	opm.work_effort_measure_id is not null
	and at.voucher_ref = opm.work_effort_measure_id
	and(
		at.transaction_date is null
		or at.transaction_date = @date3112
	) -- 'AAAA(input.ref_date)-12-31'
left join acctg_trans_entry ae on
	at.acctg_trans_id is not null
	and ae.acctg_trans_id = at.acctg_trans_id
	
left join work_effort_assoc riop on
	riop.work_effort_id_to = FIL_W.work_effort_id
	and riop.work_effort_assoc_type_id in(
		'20R2C',
		'20R6C',
		'20R8C'
	)
left join work_effort ri on
	riop.work_effort_id_from is not null
	and ri.work_effort_id = riop.work_effort_id_from
	and(
		ri.estimated_start_date is null
		or ri.estimated_start_date <= @date3112
	) -- 'AAAA(input.ref_date)-12-31'
	and(
		ri.estimated_completion_date is null
		or ri.estimated_completion_date >= @date0101
	) -- 'AAA(input.ref_date)-01-01'
left join work_effort_measure oxm on   oxm.gl_account_id = 'SCORE'
  and oxm.work_effort_id = FIL_W.work_effort_id  -- Se stampa operativa
left join acctg_trans atr on oxm.work_effort_measure_id is not null
  and atr.voucher_ref = oxm.work_effort_measure_id
  and atr.transaction_date = @monitoringDate  --input.ref_date
left join acctg_trans_entry aer on atr.acctg_trans_id is not null
  and aer.acctg_trans_id = atr.acctg_trans_id
left join uom_range_values ris on aer.amount is not null
  and ris.uom_range_id = ost.uom_range_score_id   -- Se stampa operativa
  and ris.from_value <= aer.amount and ris.thru_value >= aer.amount
left join content cor on ris.icon_content_id is not null
  and cor.content_id = ris.icon_content_id
left join data_resource drr on cor.data_resource_id is not null
  and drr.data_resource_id = cor.data_resource_id
-- NOTA ATTIVITA' DA SVOLGERE
left join work_effort_note atsv_obo on atsv_obo.work_effort_id = FIL_W.work_effort_id
and atsv_obo.sequence_id='110'
left join note_data nd_atsv on atsv_obo.note_id = nd_atsv.note_id
and nd_atsv.note_date_time=@monitoringDate -- input.ref_date
-- NOTA RISULTATO OTTENUTO
left join work_effort_note rso_obo on rso_obo.work_effort_id = FIL_W.work_effort_id  
and rso_obo.sequence_id='225'
left join note_data nd_rso on rso_obo.note_id = nd_rso.note_id
and nd_rso.note_date_time=@monitoringDate -- input.ref_date
-- NOTA INIZIATIVE MIGLIORAMENTO
left join work_effort_note img_obo on img_obo.work_effort_id = FIL_W.work_effort_id  
and img_obo.sequence_id='230'
left join note_data nd_img on img_obo.note_id = nd_img.note_id
and nd_img.note_date_time=@monitoringDate -- input.ref_date
where 
  1=1
@partyId
@filterWhere
@orgUnitId
order by lm.etch]]></xml-property>
