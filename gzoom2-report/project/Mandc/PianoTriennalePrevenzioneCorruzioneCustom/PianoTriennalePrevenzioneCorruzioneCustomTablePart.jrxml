	<parameter name="organizationIdString" class="java.lang.String">
		<defaultValueExpression><![CDATA[$P{organizationId}  != null && $P{organizationId}  != ""   && LEN($P{organizationId}) != 0 ? "' AND  RA.ORGANIZATION_ID = '" + $P{orgUnitId}  + "'": ""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	radtc.etch AS "RAD_TITOLO",
	ra.work_effort_id AS "RA_WORK_EFFORT_ID",
	wet.etch as "AREA_TYPE",
	arsup.work_effort_id as "ID_AREA",
	concat(arsup.etch, ' - ', arsup.work_effort_name) as "AREA",
	wet3.etch as "PROCESSO_TYPE",
	ar.work_effort_id as "ID_PROCESSO",
	concat(ar.etch, ' - ', ar.work_effort_name) as "PROCESSO",
	wet2.etch as "FASE_TYPE",
    fil_w.work_effort_id as "ID_FASE",
	concat(fil_w.etch, ' - ', fil_w.work_effort_name) as "FASE",
	concat(ppr.parent_role_code, ' - ', p.party_name) as "STRUTTURA",
	p2.party_name as "RESP_STRUTTURA",
	valut.amount as "VALUTAZIONE_RISCHIO",
	valut.comments as "FASCIA_VALUTAZIONE",
	valut.object_info as "EMOTE",
	notefase.motivazione_name as "MOTIVAZIONE_VAL_RISC_NAME",
	notefase.motivazione as "MOTIVAZIONE_VALUTAZIONE_RISCHIO"
from work_effort ra																		
inner join work_effort_type rat ON rat.work_effort_type_id = ra.work_effort_type_id	
inner join work_effort_type_content radtc ON radtc.work_effort_type_id = rat.work_effort_type_id
	and radtc.content_id = $P{reportContentId}
join work_effort_assoc wea on wea.work_effort_id_from = ra.work_effort_id 
    and wea.work_effort_assoc_type_id = '15APPPC' -- relazione gerarchica PTPC -- lista aree
join work_effort arsup on arsup.work_effort_id = wea.work_effort_id_to 
    and arsup.work_effort_type_id = '15AP1ARE' -- area di rischio
    and arsup.work_effort_revision_id is null
	and arsup.estimated_start_date <= $P{date3112} 
	and ($P{excludeValidity} = 'Y' or ($P{excludeValidity} = 'N' and arsup.estimated_start_date <= $P{date3112} and (arsup.estimated_completion_date is null or arsup.estimated_completion_date >= $P{date0101})))	
join work_effort_type wet on wet.work_effort_type_id = arsup.work_effort_type_id
join work_effort_assoc wea2 on wea2.work_effort_id_from = arsup.work_effort_id 
    and wea2.work_effort_assoc_type_id = '15APPPC' -- relazione area-processo
join work_effort ar on ar.work_effort_id = wea2.work_effort_id_to 
    and ar.work_effort_type_id = '15AP2SAR' -- processo
    and ar.work_effort_revision_id is null
	and ($P{excludeValidity} = 'Y' or ($P{excludeValidity} = 'N' and ar.estimated_start_date <= $P{date3112} and (ar.estimated_completion_date is null or ar.estimated_completion_date >= $P{date0101})))	
join work_effort_type wet3 on wet3.work_effort_type_id = ar.work_effort_type_id
join work_effort_assoc wea3 on wea3.work_effort_id_from = ar.work_effort_id 
    and wea3.work_effort_assoc_type_id = '15APSARC' -- relazione processo-fase
join work_effort fil_w on fil_w.work_effort_id = wea3.work_effort_id_to 
    and fil_w.work_effort_type_id = '15AP3PRO' -- fase
    and fil_w.work_effort_revision_id is null
	and ($P{excludeValidity} = 'Y' or ($P{excludeValidity} = 'N' and fil_w.estimated_start_date <= $P{date3112} and (fil_w.estimated_completion_date is null or fil_w.estimated_completion_date >= $P{date0101})))
join work_effort_type wet2 on wet2.work_effort_type_id = fil_w.work_effort_type_id
left join (
	select 
		wem.work_effort_id, ate.amount, urv.comments, dr.object_info 
	from work_effort_measure wem
	left join acctg_trans act on act.voucher_ref = wem.work_effort_measure_id 
	    and act.acctg_trans_type_id like 'SCORE%'
	    and act.transaction_date >= $P{date0101} 
	    and act.transaction_date <= $P{date3112}
	left join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id
	left join uom_range_values urv on urv.uom_range_id = 'CORRIS' and urv.from_value <= ate.amount and urv.thru_value >= ate.amount
	left join content c on c.content_id = urv.icon_content_id 
	left join data_resource dr on dr.data_resource_id = c.data_resource_id
	where wem.gl_account_id = 'COR12324' -- GRADO DI RISCHIO RESIDUO
) valut on valut.work_effort_id = fil_w.work_effort_id 
left join (
	select 
		wen.work_effort_id,
		max(case when wen.sequence_id = 100 then nd.note_name else null end) as motivazione_name,
		--max(case when wen.sequence_id = 110 then nd.note_name else null end) as descrizione_name, -- non è annuale
		max(case when wen.sequence_id = 100 then nd.note_info else null end) as motivazione
		--max(case when wen.sequence_id = 110 then nd.note_info else null end) as descrizione -- non è annuale
	from work_effort_note wen
	join note_data nd on nd.note_id = wen.note_id 
	    and nd.note_date_time >= $P{date0101} and nd.note_date_time <= $P{date3112} 
	group by
		wen.work_effort_id
) notefase on notefase.work_effort_id = fil_w.work_effort_id 
join party p on p.party_id = fil_w.org_unit_id 
join party_parent_role ppr on ppr.party_id = p.party_id 
    and ppr.role_type_id = 'ORGANIZATION_UNIT'
left join party_relationship pr2 on pr2.party_id_from = fil_w.org_unit_id 
    and pr2.party_relationship_type_id = 'ORG_RESPONSIBLE' 
    and pr2.thru_date is null
left join party p2 on p2.party_id = pr2.party_id_to 

/* START filterInnerJoin */
   $P!{filterInnerJoinString} 
/* END filterInnerJoin */
/* START filterLeftJoin */
  $P!{filterLeftJoinString} 
/* END filterLeftJoin */
															
where 1 = 1

	/* START orgUnitIdString */
	$P!{orgUnitIdString}
	/* END orgUnitIdString */
	 /* START organizationIdString */
	$P!{organizationIdString}
	/* END organizationIdString */
	/* START workEffortIdString */
	$P!{workEffortIdString}
	/* END workEffortIdString */
	/* START filterWhere */
	$P!{filterWhereString} 
   /* END filterWhere */
   ORDER BY concat(ar.etch, ' - ', ar.work_effort_name),concat(fil_w.etch, ' - ', fil_w.work_effort_name)]]>
	</queryString>
