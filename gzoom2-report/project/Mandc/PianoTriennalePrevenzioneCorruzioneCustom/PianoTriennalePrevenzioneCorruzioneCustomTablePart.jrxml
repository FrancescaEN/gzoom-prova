		<defaultValueExpression><![CDATA[$P{workEffortId}  != null && $P{workEffortId}  != "" && $P{workEffortIdChild}  != null && $P{workEffortIdChild}  != "" ? 
" AND (RA.WORK_EFFORT_ID = '" +$P{workEffortId} +  "' AND (AR.WORK_EFFORT_ID = '" + $P{workEffortIdChild}  + "' OR PR.WORK_EFFORT_ID = '" + $P{workEffortIdChild} + 
 "' OR FIL_W.WORK_EFFORT_ID = '" +  $P{workEffortIdChild} + "' OR RI.WORK_EFFORT_ID = '" +  $P{workEffortIdChild} + "')) " : 
 $P{workEffortId}  != null && $P{workEffortId} != "" ?  " AND ( RA.WORK_EFFORT_ID = '" +$P{workEffortId} + "' ) " :
 $P{workEffortIdChild}  != null && $P{workEffortIdChild} != "" ? " AND ( AR.WORK_EFFORT_ID = '" + $P{workEffortIdChild} + "' OR PR.WORK_EFFORT_ID = '" + $P{workEffortIdChild} + "' OR FIL_W.WORK_EFFORT_ID = '" + $P{workEffortIdChild} + "' OR RI.WORK_EFFORT_ID = '" + $P{workEffortIdChild} + "') " : ""]]></defaultValueExpression>
	</parameter>
