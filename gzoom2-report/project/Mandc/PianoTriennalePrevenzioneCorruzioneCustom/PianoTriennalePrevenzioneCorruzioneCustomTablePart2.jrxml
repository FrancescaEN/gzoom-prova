	<parameter name="monitoringDateString" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc($P{monitoringDate}, $P{odaDialect});]]></defaultValueExpression>
	</parameter>
	<parameter name="workEffortIdString" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$P{workEffortId}  != null && $P{workEffortId}  != "" && $P{workEffortIdChild}  != null && $P{workEffortIdChild}  != "" ? 
" AND (RA.WORK_EFFORT_ID = '" +$P{workEffortId} +  "' AND (AR.WORK_EFFORT_ID = '" + $P{workEffortIdChild}  + "' OR PR.WORK_EFFORT_ID = '" + $P{workEffortIdChild} + 
 "' OR FIL_W.WORK_EFFORT_ID = '" +  $P{workEffortIdChild} + "' OR RI.WORK_EFFORT_ID = '" +  $P{workEffortIdChild} + "')) " : 
 $P{workEffortId}  != null && $P{workEffortId} != "" ?  " AND ( RA.WORK_EFFORT_ID = '" +$P{workEffortId} + "' ) " :
 $P{workEffortIdChild}  != null && $P{workEffortIdChild} != "" ? " AND ( AR.WORK_EFFORT_ID = '" + $P{workEffortIdChild} + "' OR PR.WORK_EFFORT_ID = '" + $P{workEffortIdChild} + "' OR FIL_W.WORK_EFFORT_ID = '" + $P{workEffortIdChild} + "' OR RI.WORK_EFFORT_ID = '" + $P{workEffortIdChild} + "') " : ""]]></defaultValueExpression>
	</parameter>
	<parameter name="sottoprocessoId" class="java.lang.String"/>
	<parameter name="date3112P1" class="java.util.Date" isForPrompting="false">
		<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilDateTime.getMonthEndFromDatetime("12",$P{REPORT_TIME_ZONE}.getID(),(YEAR($P{monitoringDate})+1), $P{REPORT_LOCALE}.getDefault())]]></defaultValueExpression>
