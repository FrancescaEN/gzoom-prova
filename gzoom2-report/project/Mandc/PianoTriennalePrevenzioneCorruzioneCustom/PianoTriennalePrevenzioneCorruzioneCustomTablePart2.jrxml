	<subDataset name="ScoreDS" uuid="b4c923e5-84c9-4653-bc2a-28513aad5385">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="226"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="769"/>
		<parameter name="date3112" class="java.util.Date"/>
		<parameter name="sottoprocessoId" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT 
	
	RP.AMOUNT AS "AMOUNT",		
	VP.COMMENTS AS "COMMENTS",
	EP.OBJECT_INFO AS "OBJECT_INFO",
	UOM.DECIMAL_SCALE AS "DECIMAL_SCALE",
	UOM.ABBREVIATION AS "ABBREVIATION"

FROM WORK_EFFORT SP
INNER JOIN WORK_EFFORT_TYPE SPT ON SPT.WORK_EFFORT_TYPE_ID = SP.WORK_EFFORT_TYPE_ID
LEFT JOIN WORK_EFFORT_MEASURE WM																										
	ON WM.WORK_EFFORT_ID = SP.WORK_EFFORT_ID AND WM.WE_MEASURE_TYPE_ENUM_ID = 'WEMT_SCORE'
LEFT JOIN GL_ACCOUNT AC ON AC.GL_ACCOUNT_ID = WM.GL_ACCOUNT_ID 	
LEFT JOIN UOM UOM ON AC.DEFAULT_UOM_ID = UOM.UOM_ID	

-- score
LEFT JOIN (																											
	SELECT TP.VOUCHER_REF, TP.TRANSACTION_DATE, EP.AMOUNT																										
	FROM ACCTG_TRANS TP																										
		INNER JOIN ACCTG_TRANS_ENTRY EP ON EP.ACCTG_TRANS_ID = TP.ACCTG_TRANS_ID																									
	WHERE EP.GL_ACCOUNT_ID = 'SCORE'  AND EP.GL_FISCAL_TYPE_ID = 'CORRIS'																										
	) RP ON RP.VOUCHER_REF = WM.WORK_EFFORT_MEASURE_ID  AND RP.TRANSACTION_DATE = CAST($P{date3112} AS TIMESTAMP)																							
LEFT JOIN UOM_RANGE_VALUES VP ON VP.UOM_RANGE_ID = SPT.UOM_RANGE_SCORE_ID																											
		AND VP.FROM_VALUE <= RP.AMOUNT AND VP.THRU_VALUE >= RP.AMOUNT		
LEFT JOIN ENUMERATION CP ON CP.ENUM_ID = VP.COLOR_ENUM_ID																											
LEFT JOIN CONTENT IP ON IP.CONTENT_ID = VP.ICON_CONTENT_ID																											
LEFT JOIN DATA_RESOURCE EP ON EP.DATA_RESOURCE_ID = IP.DATA_RESOURCE_ID	
WHERE SP.WORK_EFFORT_ID = $P{sottoprocessoId}]]>
		</queryString>
		<field name="AMOUNT" class="java.lang.Double"/>
		<field name="COMMENTS" class="java.lang.String"/>
		<field name="OBJECT_INFO" class="java.lang.String"/>
		<field name="DECIMAL_SCALE" class="java.lang.Integer"/>
		<field name="ABBREVIATION" class="java.lang.String"/>
		<variable name="FORMAT" class="java.lang.String">
			<variableExpression><![CDATA[com.mapsengineering.base.birt.util.UtilNumber.getFormatPattern($F{DECIMAL_SCALE}, $F{ABBREVIATION})]]></variableExpression>
		</variable>
	</subDataset>
	<subDataset name="NoteDS" uuid="a17d3523-4fe8-4989-a82b-57aa234fe4aa">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
		<parameter name="sottoprocessoId" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT 
 ND.NOTE_NAME AS "NOTE_NAME",
 ND.NOTE_INFO AS "NOTE_INFO",
 N.SEQUENCE_ID AS "SEQUENCE_ID"
FROM    WORK_EFFORT_NOTE N
INNER JOIN NOTE_DATA ND ON ND.NOTE_ID = N.NOTE_ID
WHERE N.WORK_EFFORT_ID = $P{sottoprocessoId} 
	AND N.IS_MAIN = 'Y'
ORDER BY 
	N.SEQUENCE_ID, 
	N.NOTE_ID]]>
		</queryString>
		<field name="NOTE_NAME" class="java.lang.String"/>
		<field name="NOTE_INFO" class="java.lang.String"/>
		<field name="SEQUENCE_ID" class="java.lang.Integer"/>
	</subDataset>
	<subDataset name="FattoriRischioDS" uuid="bd6928cb-b51f-420c-886e-daab1319797a">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="265"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="730"/>
		<parameter name="date3112" class="java.util.Date"/>
		<parameter name="sottoprocessoId" class="java.lang.String"/>
		<parameter name="monitoringDate" class="java.util.Date"/>
		<queryString>
			<![CDATA[SELECT AC.ACCOUNT_NAME AS "ACCOUNT_NAME", 
	WI.UOM_DESCR AS "UOM_DESCR", 
	NDR.NOTE_INFO AS "NOTE_INFO"
FROM  WORK_EFFORT_MEASURE WI 	
INNER JOIN GL_ACCOUNT AC ON AC.GL_ACCOUNT_ID = WI.GL_ACCOUNT_ID
INNER JOIN UOM UOM ON AC.DEFAULT_UOM_ID = UOM.UOM_ID
INNER JOIN WORK_EFFORT_PURPOSE_ACCOUNT WPA ON WPA.GL_ACCOUNT_ID = AC.GL_ACCOUNT_ID
	AND WPA.WORK_EFFORT_PURPOSE_TYPE_ID = 'CORFAT'
INNER JOIN ACCTG_TRANS TP ON TP.VOUCHER_REF = WI.WORK_EFFORT_MEASURE_ID
INNER JOIN ACCTG_TRANS_ENTRY EP ON EP.ACCTG_TRANS_ID = TP.ACCTG_TRANS_ID
	AND EP.GL_ACCOUNT_ID <> 'SCOREKPI'
	
-- BEGIN NOTA 
LEFT OUTER JOIN WORK_EFFORT_NOTE MN ON MN.WORK_EFFORT_ID = WI.WORK_EFFORT_ID
	AND MN.SEQUENCE_ID = '2' 
LEFT OUTER JOIN NOTE_DATA NDR ON NDR.NOTE_ID = MN.NOTE_ID
   AND NDR.NOTE_DATE_TIME = $P{monitoringDate}
-- END		
	
WHERE WI.WE_MEASURE_TYPE_ENUM_ID <> 'WEMT_SCORE'
	AND TP.VOUCHER_REF = WI.WORK_EFFORT_MEASURE_ID 
	AND TP.TRANSACTION_DATE = $P{date3112}
	AND EP.AMOUNT = 100
	AND WI.WORK_EFFORT_ID = $P{sottoprocessoId}]]>
		</queryString>
		<field name="ACCOUNT_NAME" class="java.lang.String"/>
		<field name="UOM_DESCR" class="java.lang.String"/>
		<field name="NOTE_INFO" class="java.lang.String"/>
	</subDataset>
	<subDataset name="RelazioniDS" uuid="fd10a1a9-e3f1-4232-b1c7-a4515ce1cf33">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="232"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="763"/>
		<parameter name="sottoprocessoId" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT 
     WC.CONTENT_ID AS "CONTENT_ID", 
     WC.ETCH AS "ETCH", 
     WEA.WE_FROM_ETCH AS "FROM_ETCH", 
     WEA.WE_FROM_NAME AS "FROM_NAME"
FROM WORK_EFFORT WE
INNER JOIN work_effort_type_content WC ON WC.WORK_EFFORT_TYPE_ID = WE.WORK_EFFORT_TYPE_ID AND WC.WE_TYPE_CONTENT_TYPE_ID = 'FOLDER' AND WC.CONTENT_ID LIKE 'WEFLD_WET%'
INNER JOIN work_effort_type_assoc WA ON WA.WORK_EFFORT_TYPE_ID = WC.WORK_EFFORT_TYPE_ID AND WA.CONTENT_ID = WC.CONTENT_ID
LEFT JOIN WORK_EFFORT_ASSOC_VIEW WEA ON WEA.WE_TO_ID = WE.WORK_EFFORT_ID AND WEA.WE_FROM_TYPE_ID = WA.WORK_EFFORT_TYPE_ID_REF
INNER JOIN WORK_EFFORT_TYPE WT ON WT.WORK_EFFORT_TYPE_ID = WEA.WE_FROM_TYPE_ID
WHERE WE.WORK_EFFORT_ID = $P{sottoprocessoId} 
AND WT.PARENT_TYPE_ID = 'CTX_PR']]>
		</queryString>
		<field name="CONTENT_ID" class="java.lang.String"/>
		<field name="ETCH" class="java.lang.String"/>
		<field name="FROM_ETCH" class="java.lang.String"/>
		<field name="FROM_NAME" class="java.lang.String"/>
	</subDataset>
	<subDataset name="Note2DS" uuid="d9bbf969-c085-421e-97b2-0a4055ba5366">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
		<parameter name="sottoprocessoId" class="java.lang.String"/>
		<parameter name="monitoringDate" class="java.util.Date"/>
		<queryString>
			<![CDATA[SELECT
  WN.WORK_EFFORT_ID AS "WORK_EFFORT_ID",
  ND.NOTE_NAME AS "NOTE_NAME",
  ND.NOTE_INFO AS "NOTE_INFO"
FROM WORK_EFFORT_NOTE WN
INNER JOIN NOTE_DATA ND ON WN.NOTE_ID = ND.NOTE_ID
WHERE WN.WORK_EFFORT_ID = $P{sottoprocessoId}
 AND ND.NOTE_DATE_TIME = $P{monitoringDate}
 AND WN.IS_MAIN <> 'Y']]>
		</queryString>
		<field name="WORK_EFFORT_ID" class="java.lang.String"/>
		<field name="NOTE_NAME" class="java.lang.String"/>
		<field name="NOTE_INFO" class="java.lang.String"/>
	</subDataset>
