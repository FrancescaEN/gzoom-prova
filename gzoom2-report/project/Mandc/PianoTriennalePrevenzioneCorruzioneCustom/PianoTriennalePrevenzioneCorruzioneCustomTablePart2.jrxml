						<reportElement positionType="Float" stretchType="ContainerHeight" mode="Opaque" x="0" y="0" width="180" height="15" isRemoveLineWhenBlank="true" backcolor="#D5D5D5" uuid="d85e10a3-cb44-4cd4-805b-a463e1ee14f5">
							<property name="com.jaspersoft.studio.unit.width" value="px"/>
						</reportElement>
						<box>
							<pen lineColor="#808080"/>
							<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
							<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
							<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
							<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						</box>
						<textField textAdjust="StretchHeight" isBlankWhenNull="true">
							<reportElement positionType="Float" mode="Opaque" x="0" y="0" width="180" height="15" isRemoveLineWhenBlank="true" forecolor="#000000" backcolor="#D5D5D5" uuid="707bf5e8-aa45-4bde-957f-957541441c92">
								<property name="com.jaspersoft.studio.unit.height" value="px"/>
								<property name="com.jaspersoft.studio.unit.y" value="px"/>
								<property name="com.jaspersoft.studio.unit.x" value="px"/>
								<property name="com.jaspersoft.studio.unit.width" value="px"/>
								<printWhenExpression><![CDATA[$V{Gruppo_AREA_COUNT}==0]]></printWhenExpression>
							</reportElement>
							<textElement verticalAlignment="Middle">
								<font size="8" isBold="true"/>
							</textElement>
							<textFieldExpression><![CDATA[$F{AREA_DESC} !=null && $F{AREA_DESC} !="" ? 
	($F{AREA_ETCH} !=null && $F{AREA_ETCH} !="" ? $F{AREA_ETCH}  + " - "  + $F{AREA_DESC} : $F{AREA_DESC}) : 
($F{AREA_ETCH} !=null && $F{AREA_ETCH} !="" ? $F{AREA_ETCH}  + " - "  + $F{AREA_NAME} : $F{AREA_NAME})]]></textFieldExpression>
						</textField>
					</frame>
					<componentElement>
						<reportElement stretchType="ContainerHeight" x="180" y="0" width="90" height="15" isRemoveLineWhenBlank="true" uuid="2a153d78-54d8-4797-a4a9-42c54af2bf48">
							<property name="com.jaspersoft.studio.unit.height" value="px"/>
							<property name="com.jaspersoft.studio.element.name" value="Score"/>
							<property name="com.jaspersoft.studio.unit.y" value="px"/>
							<property name="com.jaspersoft.studio.unit.x" value="px"/>
							<property name="com.jaspersoft.studio.unit.width" value="px"/>
							<property name="com.jaspersoft.studio.layout" value="com.jaspersoft.studio.editor.layout.FreeLayout"/>
