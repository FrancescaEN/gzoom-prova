		<parameter name="filterLeftJoinString" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[$P{filterLeftJoin} != null ? $P{filterLeftJoin} : ""]]></defaultValueExpression>
		</parameter>
		<parameter name="filterInnerJoinString" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[$P{filterInnerJoin} != null ? $P{filterInnerJoin} : ""]]></defaultValueExpression>
		</parameter>
		<parameter name="date3009" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilDateTime.getMonthEndFromDatetime("9",$P{REPORT_TIME_ZONE}.getID(),YEAR($P{monitoringDate}), $P{REPORT_LOCALE}.getDefault())]]></defaultValueExpression>
		</parameter>
		<parameter name="date3009sql" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc($P{date3009}, $P{odaDialect});]]></defaultValueExpression>
		</parameter>
		<parameter name="excludeValidity" class="java.lang.String">
			<defaultValueExpression><![CDATA["N"]]></defaultValueExpression>
		</parameter>
		<parameter name="exposeReleaseDate" class="java.lang.String" isForPrompting="false"/>
		<parameter name="YEAR" class="java.lang.Integer">
			<defaultValueExpression><![CDATA[YEAR($P{monitoringDate})]]></defaultValueExpression>
		</parameter>
		<parameter name="workEffortIdChild" class="java.lang.String"/>
		<parameter name="workEffortIdString" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[$P{workEffortIdChild}  != null && $P{workEffortIdChild}  != "" ? 
 " AND ( FIL_W.WORK_EFFORT_ID = '" + $P{workEffortIdChild} + "' OR WE_SUB.WORK_EFFORT_ID = '" + $P{workEffortIdChild} + "' OR WE_AREA.WORK_EFFORT_ID = '" + $P{workEffortIdChild} + "') " : ""]]></defaultValueExpression>
		</parameter>
		<parameter name="sottoprocessoId" class="java.lang.String"/>
		<parameter name="date3112P1" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilDateTime.getMonthEndFromDatetime("12",$P{REPORT_TIME_ZONE}.getID(),(YEAR($P{monitoringDate})+1), $P{REPORT_LOCALE}.getDefault())]]></defaultValueExpression>
		</parameter>
		<parameter name="date3112P1sql" class="java.lang.String">
			<defaultValueExpression><![CDATA[SUBSTITUTE(com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc($P{date3112P1}, $P{odaDialect}),"'","")]]></defaultValueExpression>
		</parameter>
		<parameter name="date3112P2" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilDateTime.getMonthEndFromDatetime("12",$P{REPORT_TIME_ZONE}.getID(),(YEAR($P{monitoringDate})+2), $P{REPORT_LOCALE}.getDefault())]]></defaultValueExpression>
		</parameter>
		<parameter name="date3112P2sql" class="java.lang.String">
			<defaultValueExpression><![CDATA[SUBSTITUTE(com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc($P{date3112P2}, $P{odaDialect}),"'","")]]></defaultValueExpression>
		</parameter>
		<parameter name="ReportLargePath" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.AppHeaderLogo.getReportContentUrl("REPORT_LARGE",$P{defaultOrganizationPartyId})]]></defaultValueExpression>
		</parameter>
		<parameter name="AREA" class="java.lang.String"/>
		<parameter name="rangeValue" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT WE_AREA.WORK_EFFORT_NAME AS "WORK_EFFORT_NAME",
COUNT(*) AS "NUM_PROC",
WT.ETCH AS "ETHC_PROC",
SUM(CASE WHEN VP.RANGE_VALUES_FACTOR = 0 THEN 1 ELSE 0 END) AS "LIV_0",
SUM(CASE WHEN VP.RANGE_VALUES_FACTOR = 25 THEN 1 ELSE 0 END) AS "LIV_25",
SUM(CASE WHEN VP.RANGE_VALUES_FACTOR = 33 THEN 1 ELSE 0 END) AS "LIV_33",
SUM(CASE WHEN VP.RANGE_VALUES_FACTOR = 50 THEN 1 ELSE 0 END) AS "LIV_50",
SUM(CASE WHEN VP.RANGE_VALUES_FACTOR = 67 THEN 1 ELSE 0 END) AS "LIV_67",
SUM(CASE WHEN VP.RANGE_VALUES_FACTOR = 75 THEN 1 ELSE 0 END) AS "LIV_75",
SUM(CASE WHEN VP.RANGE_VALUES_FACTOR = 100 THEN 1 ELSE 0 END) AS "LIV_100"
FROM WORK_EFFORT FIL_W
/* START filterInnerJoin */
   $P!{filterInnerJoinString} 
/* END filterInnerJoin */
/* START filterLeftJoin */
  $P!{filterLeftJoinString} 
/* END filterLeftJoin */	
INNER JOIN WORK_EFFORT_ASSOC WEA ON FIL_W.WORK_EFFORT_ID=WEA.WORK_EFFORT_ID_TO
INNER JOIN WORK_EFFORT WE_SUB ON WEA.WORK_EFFORT_ID_FROM=WE_SUB.WORK_EFFORT_ID
INNER JOIN WORK_EFFORT_ASSOC WEA_2 ON WEA_2.WORK_EFFORT_ID_TO = WE_SUB.WORK_EFFORT_ID
INNER JOIN WORK_EFFORT WE_AREA ON WEA_2.WORK_EFFORT_ID_FROM = WE_AREA.WORK_EFFORT_ID
INNER JOIN WORK_EFFORT_MEASURE WM ON WM.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID AND WM.GL_ACCOUNT_ID = 'SCORE'
INNER JOIN WORK_EFFORT_TYPE WT ON WT.WORK_EFFORT_TYPE_ID = FIL_W.WORK_EFFORT_TYPE_ID
	
INNER JOIN ACCTG_TRANS_ENTRY EP ON EP.VOUCHER_REF = WM.WORK_EFFORT_MEASURE_ID AND EP.GL_FISCAL_TYPE_ID = 'CORRIS'
INNER JOIN ACCTG_TRANS TP ON TP.ACCTG_TRANS_ID = EP.ACCTG_TRANS_ID AND TP.TRANSACTION_DATE = $P{date3112}																						
INNER JOIN UOM_RANGE_VALUES VP ON VP.UOM_RANGE_ID = WT.UOM_RANGE_SCORE_ID																											
		AND VP.FROM_VALUE <= EP.AMOUNT AND VP.THRU_VALUE >= EP.AMOUNT	
INNER JOIN UOM_RANGE UR ON VP.UOM_RANGE_ID = UR.UOM_RANGE_ID		
WHERE FIL_W.WORK_EFFORT_TYPE_ID='15AP3PRO' AND WE_SUB.WORK_EFFORT_TYPE_ID='15AP2SAR' AND WE_AREA.WORK_EFFORT_TYPE_ID='15AP1ARE'
AND FIL_W.WORK_EFFORT_REVISION_ID IS NULL AND WE_SUB.WORK_EFFORT_REVISION_ID IS NULL AND WE_AREA.WORK_EFFORT_REVISION_ID IS NULL 
AND EXISTS (SELECT 1 FROM WORK_EFFORT_ASSOC WA INNER JOIN WORK_EFFORT RIS ON RIS.WORK_EFFORT_ID = WA.WORK_EFFORT_ID_TO 
				INNER JOIN WORK_EFFORT_ASSOC WAM ON WAM.WORK_EFFORT_ID_FROM = RIS.WORK_EFFORT_ID 
				INNER JOIN WORK_EFFORT MIS ON MIS.WORK_EFFORT_ID = WAM.WORK_EFFORT_ID_TO 
				WHERE WA.WORK_EFFORT_ID_FROM = FIL_W.WORK_EFFORT_ID AND RIS.WORK_EFFORT_TYPE_ID = '15AP4RIS'
				AND MIS.WORK_EFFORT_TYPE_ID LIKE '15AP5M%') 

	/* START filterWhere */
	$P!{filterWhereString} 
   /* END filterWhere */
	 /* START orgUnitIdString */
	$P!{orgUnitIdString}
	/* END orgUnitIdString */
	
	/* START workEffortIdString */
	$P!{workEffortIdString}
	/* END workEffortIdString */
AND WE_AREA.WORK_EFFORT_ID = $P{areaId}
GROUP BY  WE_AREA.WORK_EFFORT_NAME,WT.ETCH]]>
		</queryString>
		<field name="LIV_0" class="java.lang.Integer"/>
		<field name="LIV_25" class="java.lang.Integer"/>
		<field name="LIV_33" class="java.lang.Integer"/>
		<field name="LIV_50" class="java.lang.Integer"/>
		<field name="LIV_67" class="java.lang.Integer"/>
		<field name="LIV_75" class="java.lang.Integer"/>
