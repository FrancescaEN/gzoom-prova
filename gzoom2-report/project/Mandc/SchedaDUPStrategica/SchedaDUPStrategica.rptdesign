        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="RiferimentiDS" id="57149">
            <property name="nullsOrdering">nulls lowest</property>
            <list-property name="columnHints">
                <structure>
                    <property name="columnName">tipo_riferimento</property>
                    <property name="analysis">dimension</property>
                    <text-property name="displayName">tipo_riferimento</text-property>
                    <text-property name="heading">tipo_riferimento</text-property>
                </structure>
                <structure>
                    <property name="columnName">codice_riferimento</property>
                    <property name="analysis">dimension</property>
                    <text-property name="displayName">codice_riferimento</text-property>
                    <text-property name="heading">codice_riferimento</text-property>
                </structure>
                <structure>
                    <property name="columnName">titolo_riferimento</property>
                    <property name="analysis">dimension</property>
                    <text-property name="displayName">titolo_riferimento</text-property>
                    <text-property name="heading">titolo_riferimento</text-property>
                </structure>
            </list-property>
            <list-property name="parameters">
                <structure>
                    <property name="name">workEffortId</property>
                    <property name="nativeName"></property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">0</property>
                    <property name="position">1</property>
                    <expression name="defaultValue" type="constant">N/A</expression>
                    <property name="isOptional">false</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">tipo_riferimento</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">codice_riferimento</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">titolo_riferimento</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <method name="beforeOpen"><![CDATA[/**/
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value );
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );	
this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );

/*
this.queryText = this.queryText.replace("@date0101",  "'2020-01-01 00:00:00.000'" );
this.queryText = this.queryText.replace("@date3112",  "'2020-12-31 00:00:00.000'" );
this.queryText = this.queryText.replace("@monitoringDate",  "'2020-12-31 00:00:00.000'" ); */

//ReportLog.info("riferimenti  "+this.queryText);]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">tipo_riferimento</property>
                    <property name="nativeName">tipo_riferimento</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">codice_riferimento</property>
                    <property name="nativeName">codice_riferimento</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">titolo_riferimento</property>
                    <property name="nativeName">titolo_riferimento</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select
	rit.description as tipo_riferimento,
	ri.etch as codice_riferimento,
	ri.work_effort_name as titolo_riferimento
from
	work_effort_assoc riop
inner join work_effort ri on
	ri.work_effort_id = riop.work_effort_id_from
inner join work_effort_type rit on
	rit.work_effort_type_id = ri.work_effort_type_id
where
	riop.work_effort_id_to = ? -- main.identificativo_obipeg
	and riop.work_effort_assoc_type_id like '20R%'
	and riop.from_date <= @monitoringDate     -- input.ref_date
    and riop.thru_date >= @monitoringDate     -- input.ref_date
order by
	tipo_riferimento,
	codice_riferimento,
	titolo_riferimento 
 	]]></xml-property>
        </oda-data-set>
    </data-sets>
