            <method name="beforeOpen"><![CDATA[//this.queryText = this.queryText.replace("@excludePerformanceKPI", "'" + params["excludePerformanceKPI"].value+ "'");
//this.queryText = this.queryText.replace("@excludeValidity", "'" + params["excludeValidity"].value+ "'");
/**/
//this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value );
//this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );																
this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );
//this.queryText = this.queryText.replace("@monitoringDate",  "''" );

 
//this.queryText = this.queryText.replace("@date0101",  "'2020-01-01 00:00:00.000'" );
//this.queryText = this.queryText.replace("@date3112",  "'2020-12-31 00:00:00.000'" );


//ReportLog.info("... this.queryText= "+this.queryText);]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">tipo_refpole</property>
                    <property name="nativeName">tipo_refpole</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">0</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">ruolo_refpol</property>
                    <property name="nativeName">ruolo_refpol</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">0</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">referente_politico</property>
                    <property name="nativeName">referente_politico</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">0</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select
assrole.role_type_id as tipo_refpole,
assrole.description as ruolo_refpol,
ass.party_name as referente_politico
from work_effort os 
inner join work_effort_assoc osoo on osoo.work_effort_id_from = os.work_effort_id
 and osoo.work_effort_assoc_type_id = '20D6C'
inner join work_effort oo on oo.work_effort_id = osoo.work_effort_id_to
inner join work_effort_party_assignment ooass on ooass.work_effort_id = oo.work_effort_id
inner join party ass on ooass.party_id is not null
 and ass.party_id = ooass.party_id
inner join role_type assrole on ooass.role_type_id is not null
 and assrole.role_type_id = ooass.role_type_id
where os.work_effort_id = ? -- main.work_effort_id
and ooass.sequence_num = '1'
and  (ooass.from_date is null or ooass.from_date <= @monitoringDate) -- input.ref_date
  and (ooass.thru_date is null or ooass.thru_date >= @monitoringDate) -- input.ref_date
group by assrole.role_type_id,  assrole.description, ass.party_name
order by assrole.role_type_id, ass.party_name]]></xml-property>
