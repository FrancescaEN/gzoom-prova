                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="position">38</property>
                    <property name="name">misurazione_riferimento</property>
                    <property name="nativeName">misurazione_riferimento</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">39</property>
                    <property name="name">misurazione_commento</property>
                    <property name="nativeName">misurazione_commento</property>
