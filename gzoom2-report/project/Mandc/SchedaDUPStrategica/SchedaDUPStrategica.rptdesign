                </structure>
                <structure>
                    <property name="position">41</property>
                    <property name="name">mi_work_effort</property>
                    <property name="nativeName">mi_work_effort</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">42</property>
                    <property name="name">oo_work_effort</property>
                    <property name="nativeName">oo_work_effort</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">43</property>
                    <property name="name">so_work_effort</property>
                    <property name="nativeName">so_work_effort</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select
lmt.etch as etic_linea_mandato,
lm.etch as codice_linea, lm.work_effort_name as titolo_lineamandato, 
ost.etch as etic_obi_strategico, 
FIL_W.etch as codice_obistrategico, FIL_W.work_effort_name as titolo_obistrategico, osd.note_info as descr_obistrategico, 
oot.etch as etic_obi_operativo, 
oo.etch as codice_obioperativo, oo.work_effort_name as titolo_obioperativo,  ood.note_info as descr_obioperativo, 
uoooc.parent_role_code as codice_uoresp, uooo.external_id as codso4_uoresp, 
uooog.comments codcdr_uoresp, uooo.party_name as uoresp_operativo,
uooopa.party_name as resp_tecnico,
ooass.sequence_num as seq_refpol, assrole.role_type_id as tipo_refpole, assrole.description as ruolo_refpol, ass.party_name as referente_politico, 
pr.etch as codice_programma, pr.work_effort_name as programma, 
mi.etch as codice_missione, mi.work_effort_name as missione, 
so.etch as codice_sottobiettivo, so.work_effort_name as sottoobiettivo, 
uosoc.parent_role_code as codice_altrauo, uoso.external_id as codso4_altrauo, 
uosog.comments as codcdr_altrauo, uoso.party_name as altreuo_operativo,
uosopa.party_name as altro_resp_tecnico, 
onu.etch as onu_etch, dronu.object_info as icona_agenda2030, 
aer.amount as valutazione_valore, ris.comments as valutazione_descrizione, drr.object_info as valutazione_emoticon,
aer.orig_amount misurazione_valore, aer.description as misurazione_riferimento, atr.description as misurazione_commento,
t310.note_info as valutazione_attivita, 
mi.work_effort_id as mi_work_effort,  
oo.work_effort_id as oo_work_effort, FIL_W.work_effort_id as so_work_effort
from work_effort pm
inner join user_preference up on up.user_pref_type_id = 'ORGANIZATION_PARTY' and up.user_pref_value = pm.organization_id and up.user_login_id = @userLoginId
inner join work_effort_type pmt on pmt.work_effort_type_id = pm.work_effort_type_id
inner join work_effort_assoc pmlm on pmlm.work_effort_id_from = pm.work_effort_id
 and pmlm.work_effort_assoc_type_id = '20D6'
 and pmlm.from_date <= @monitoringDate and pmlm.thru_date >= @monitoringDate  -- input.ref_date
inner join work_effort lm on lm.work_effort_id = pmlm.work_effort_id_to
	and lm.estimated_start_date <= @date3112     -- 'AAAA(input.ref_date)-12-31'
	and lm.estimated_completion_date >= @date0101 -- 'AAAA(input.ref_date)-01-01'
inner join work_effort_type lmt on lmt.work_effort_type_id = lm.work_effort_type_id 
left join work_effort_assoc lmos on lmos.work_effort_id_from = lm.work_effort_id
 and lmos.work_effort_assoc_type_id = '20D6'
 and lmos.from_date <= @monitoringDate and lmos.thru_date >= @monitoringDate  -- input.ref_date
left join work_effort FIL_W on FIL_W.work_effort_id = lmos.work_effort_id_to
  and FIL_W.estimated_start_date <= @date3112      -- 'AAAA(input.ref_date)-12-31'
  and FIL_W.estimated_completion_date >= @date0101 -- 'AAAA(input.ref_date)-01-01'
left join work_effort_type ost on ost.work_effort_type_id = FIL_W.work_effort_type_id 
inner join work_effort_note osn on osn.work_effort_id = FIL_W.work_effort_id and osn.sequence_id='100'
inner join note_data osd on osd.note_id = osn.note_id
  and (osn.is_main = 'Y' or osd.note_date_time = @date0101) -- 'AAAA(input.ref_date)-01-01'
left join work_effort_assoc osoo on osoo.work_effort_id_from = FIL_W.work_effort_id
 and osoo.work_effort_assoc_type_id = '20D6C'
  and osoo.from_date <= @monitoringDate and osoo.thru_date >= @monitoringDate  -- input.ref_date
left join work_effort oo on oo.work_effort_id = osoo.work_effort_id_to
  and oo.estimated_start_date <= @date3112      -- 'AAAA(input.ref_date)-12-31'
  and oo.estimated_completion_date >= @date0101 -- 'AAAA(input.ref_date)-01-01'
left join work_effort_type oot on oot.work_effort_type_id = oo.work_effort_type_id 
left join work_effort_note oon on oon.work_effort_id = oo.work_effort_id
left join note_data ood on ood.note_id = oon.note_id
left join party uooo on uooo.party_id = oo.org_unit_id
left join party_parent_role uoooc on uoooc.party_id = uooo.party_id
  and uoooc.role_type_id = 'ORGANIZATION_UNIT'
left join party_group uooog on uooog.party_id = uooo.party_id
left join party_relationship uooore on uooore.party_id_from = uooo.party_id
  and (uooore.from_date is null or uooore.from_date <= @monitoringDate) -- input.ref_date
  and (uooore.thru_date is null or uooore.thru_date >= @monitoringDate) -- input.ref_date
  and uooore.party_relationship_type_id = 'ORG_RESPONSIBLE'
  and uooore.from_date <= oo.estimated_completion_date
  and (uooore.thru_date is null or uooore.thru_date >= oo.estimated_start_date)
left join party uooopa on uooore.party_id_to is not null
 and uooopa.party_id = uooore.party_id_to
left join work_effort_party_assignment ooass on ooass.work_effort_id = oo.work_effort_id
  and (ooass.from_date is null or ooass.from_date <= @monitoringDate) -- input.ref_date
  and (ooass.thru_date is null or ooass.thru_date >= @monitoringDate) -- input.ref_date
left join party ass on ooass.party_id is not null
 and ass.party_id = ooass.party_id
left join role_type assrole on ooass.role_type_id is not null
 and assrole.role_type_id = ooass.role_type_id
left join work_effort_assoc proo on proo.work_effort_id_to = oo.work_effort_id
 and proo.work_effort_assoc_type_id = '20D2C'
  and proo.from_date <= @monitoringDate and proo.thru_date >= @monitoringDate  -- input.ref_date
left join work_effort pr on pr.work_effort_id = proo.work_effort_id_from
left join work_effort_assoc mipr on mipr.work_effort_id_to = pr.work_effort_id
 and mipr.work_effort_assoc_type_id = '20D2'
  and mipr.from_date <= @monitoringDate and mipr.thru_date >= @monitoringDate  -- input.ref_date
left join work_effort mi on mi.work_effort_id = mipr.work_effort_id_from
left join work_effort_assoc onuoo on onuoo.work_effort_id_to = proo.work_effort_id_to
 and onuoo.work_effort_assoc_type_id = '20R7C'
 and onuoo.from_date <= @monitoringDate     -- input.ref_date
 and onuoo.thru_date >= @monitoringDate     -- input.ref_date
left join work_effort onu on onu.work_effort_id = onuoo.work_effort_id_from
left join work_effort_content onuicon on onuicon.work_effort_id = onu.work_effort_id
  and onuicon.work_effort_content_type_id = 'ICON'
left join content coonu on coonu.content_id = onuicon.content_id
left join data_resource dronu on dronu.data_resource_id = coonu.data_resource_id 
left join work_effort_assoc bimi on bimi.work_effort_id_to = mi.work_effort_id
 and bimi.work_effort_assoc_type_id = '20D2'
  and bimi.from_date <= @monitoringDate and bimi.thru_date >= @monitoringDate  -- input.ref_date
left join work_effort bi on bi.work_effort_id = bimi.work_effort_id_from
@filterInnerJoin
@filterLeftJoin	
left join work_effort_assoc ooso on ooso.work_effort_id_from = oo.work_effort_id
 and ooso.work_effort_assoc_type_id = '20D6O'
  and ooso.from_date <= @monitoringDate and ooso.thru_date >= @monitoringDate  -- input.ref_date
left join work_effort so on ooso.work_effort_id_to is not null
  and so.work_effort_id = ooso.work_effort_id_to
  and (so.estimated_start_date is null or so.estimated_start_date <= @date3112)           -- 'AAAA(input.ref_date)-12-31'
  and (so.estimated_completion_date is null or so.estimated_completion_date >= @date0101) -- 'AAA(input.ref_date)-01-01'
left join party uoso on so.org_unit_id is not null
 and uoso.party_id = so.org_unit_id
left join party_parent_role uosoc on uoso.party_id is not null
 and uosoc.party_id = uoso.party_id
 and uosoc.role_type_id = 'ORGANIZATION_UNIT'
left join party_group uosog on uoso.party_id is not null
 and  uosog.party_id = uoso.party_id
left join party_relationship uosore on uoso.party_id is not null
  and (uosore.from_date is null or uosore.from_date <= @monitoringDate) -- input.ref_date
  and (uosore.thru_date is null or uosore.thru_date >= @monitoringDate) -- input.ref_date
 and uosore.party_id_from = uoso.party_id
 and uosore.party_relationship_type_id = 'ORG_RESPONSIBLE'
 and uosore.from_date <= so.estimated_completion_date
 and (uosore.thru_date is null or uosore.thru_date >= so.estimated_start_date)
left join party uosopa on uosore.party_id_to is not null and uosopa.party_id = uosore.party_id_to
left join work_effort_measure opm on
	opm.work_effort_id = FIL_W.work_effort_id
	and opm.gl_account_id = '10001'
left join acctg_trans at on
	opm.work_effort_measure_id is not null
	and at.voucher_ref = opm.work_effort_measure_id
	and(
		at.transaction_date is null
		or at.transaction_date = @date3112
	) -- 'AAAA(input.ref_date)-12-31'
left join acctg_trans_entry ae on
	at.acctg_trans_id is not null
	and ae.acctg_trans_id = at.acctg_trans_id
	
left join work_effort_assoc riop on
	riop.work_effort_id_to = FIL_W.work_effort_id
	and riop.work_effort_assoc_type_id in(
		'20R2C',
		'20R6C',
		'20R8C'
	)
left join work_effort ri on
	riop.work_effort_id_from is not null
	and ri.work_effort_id = riop.work_effort_id_from
	and(
		ri.estimated_start_date is null
		or ri.estimated_start_date <= @date3112
	) -- 'AAAA(input.ref_date)-12-31'
	and(
		ri.estimated_completion_date is null
		or ri.estimated_completion_date >= @date0101
	) -- 'AAA(input.ref_date)-01-01'
left join work_effort_measure oxm on   oxm.gl_account_id = 'SCORE'
  and oxm.work_effort_id = FIL_W.work_effort_id  -- Se stampa operativa
left join acctg_trans atr on oxm.work_effort_measure_id is not null
  and atr.voucher_ref = oxm.work_effort_measure_id
  and atr.transaction_date = @monitoringDate  --input.ref_date
left join acctg_trans_entry aer on atr.acctg_trans_id is not null
  and aer.acctg_trans_id = atr.acctg_trans_id
left join uom_range_values ris on aer.amount is not null
  and ris.uom_range_id = ost.uom_range_score_id   -- Se stampa operativa
  and ris.from_value <= aer.amount and ris.thru_value >= aer.amount
left join content cor on ris.icon_content_id is not null
  and cor.content_id = ris.icon_content_id
left join data_resource drr on cor.data_resource_id is not null
  and drr.data_resource_id = cor.data_resource_id
left join work_effort_note n310 on n310.work_effort_id = FIL_W.work_effort_id  -- Se stampa operativa
  and n310.sequence_id = 310
left join note_data t310 on n310.note_id is not null
  and t310.note_id = n310.note_id
  and t310.note_date_time = @monitoringDate  --input.ref_date
where 
  1=1
-- and (uooo.party_id = '10019' or (uoso.party_id is not null and uoso.party_id = '10019'))   -- input.uorg_uni_id (se valorizzato)
-- and (ass.party_id is not null and ass.party_id = '10170')    -- input.ass_party_id (se valorizzato)
@partyId
--  and (lm.work_effort_id = '10103' or FIL_W.work_effort_id = '10103' or oo.work_effort_id = '10103'
--   or pr.work_effort_id = '10103' or mi.work_effort_id = '10103' or so.work_effort_id = '10103')   -- input.work_effort_id (se valorizzato)
@filterWhere
@orgUnitId
]]></xml-property>
            <xml-property name="designerValues"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<model:DesignValues xmlns:design="http://www.eclipse.org/datatools/connectivity/oda/design" xmlns:model="http://www.eclipse.org/birt/report/model/adapter/odaModel">
