m2.MIS_PREVISTE, m2.MIS_ATTUATE 
-- round((cast(m2.MIS_ATTUATE as decimal(10,2))/ cast(m2.MIS_PREVISTE as decimal(10,2))* 100.0 )- 100.0 , 0) as MIS_DELTA_PERC
from (select m1.DATA_RIFERIMENTO,m1.ANNO,m1.ETCH_TIPO_MISURA,m1.ETCH_AREA_RISCHIO, m1.AREA_RISCHIO, m1.AREA_RISCHIO_LANG, m1.ARE_ID, m1.TIPO_MISURA, m1.TIPO_MISURA_LANG, m1.MIS_TIP, 
sum(m1.MIS_PREVISTE) as MIS_PREVISTE, sum(m1.MIS_ATTUATE) as MIS_ATTUATE
from (select m.DATA_RIFERIMENTO,m.ANNO,m.ETCH_TIPO_MISURA,m.ETCH_AREA_RISCHIO, m.AREA_RISCHIO, m.AREA_RISCHIO_LANG, m.ARE_ID, m.TIPO_MISURA, m.TIPO_MISURA_LANG, m.MIS_TIP, 1 as MIS_PREVISTE, m.SAL_ATTUATA as MIS_ATTUATE
from COR_MIS_REPORT_VIEW m 
where anno= $P{YEAR} 
and are_id= $P{areaId} 
 $P!{orgUnitIdString} ) m1
group by m1.DATA_RIFERIMENTO,m1.ANNO, m1.ETCH_TIPO_MISURA,m1.ETCH_AREA_RISCHIO,m1.AREA_RISCHIO, m1.AREA_RISCHIO_LANG, m1.ARE_ID, m1.TIPO_MISURA, m1.TIPO_MISURA_LANG, m1.MIS_TIP
order by m1.DATA_RIFERIMENTO,m1.ANNO, m1.ETCH_TIPO_MISURA,m1.ETCH_AREA_RISCHIO,m1.AREA_RISCHIO, m1.AREA_RISCHIO_LANG, m1.ARE_ID, m1.TIPO_MISURA, m1.TIPO_MISURA_LANG, m1.MIS_TIP) m2
   where 1=1
   and m2.DATA_RIFERIMENTO= $P{customTimePeriod}]]>
