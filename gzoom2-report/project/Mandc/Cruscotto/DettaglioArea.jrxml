		<queryString>
			<![CDATA[select m1.DATA_RIFERIMENTO,m1.ANNO, m1.AREA_RISCHIO, m1.AREA_RISCHIO_LANG, m1.ARE_ID,m1.PROCESSO, m1.PROCESSO_LANG, m1.PRO_ID, 
sum(m1.NUM_PREVISTE) as NUM_PREVISTE,
sum(m1.MIS_ATTUATE) as MIS_ATTUATE, 
sum(m1.MIS_NO_ATTUATE) as MIS_NO_ATTUATE, 
sum(m1.NUM_IN_CORSO) as NUM_IN_CORSO,
sum(m1.NUM_DA_AVVIARE) as NUM_DA_AVVIARE,
sum(m1.NUM_RITARDO) as NUM_RITARDO,
sum(m1.NUM_NESSUNO) as NUM_NESSUNO,
sum(m1.NUM_PERSONALE) as NUM_PERSONALE,
sum(m1.NUM_FINANZIARIO) as NUM_FINANZIARIO,
sum(m1.NUM_COMPETENZE) as NUM_COMPETENZE,
sum(m1.NUM_ALTRO) as NUM_ALTRO,
sum(m1.NUM_IDONEO) as NUM_IDONEO,
sum(m1.NUM_NON_IDONEO) as NUM_NON_IDONEO,
sum(m1.NUM_DA_VALUTARE) as NUM_DA_VALUTARE
from (select m.DATA_RIFERIMENTO,m.ANNO, m.PROCESSO, m.PROCESSO_LANG, m.pRO_ID, m.AREA_RISCHIO, m.AREA_RISCHIO_LANG, m.ARE_ID,
1 as NUM_PREVISTE, 
m.SAL_ATTUATA as MIS_ATTUATE,
case when m.SAL_ATTUATA = 0 then 1 else 0 end as MIS_NO_ATTUATE,
m.SAL_IN_CORSO as NUM_IN_CORSO,
m.SAL_DA_AVVIARE as NUM_DA_AVVIARE,
m.SAL_RITARDO as NUM_RITARDO,
m.OST_NESSUNO as NUM_NESSUNO,
m.OST_PERSONALE as NUM_PERSONALE,
m.OST_FINANZIARIO as NUM_FINANZIARIO,
m.OST_COMPETENZE as NUM_COMPETENZE,
m.OST_ALTRO as NUM_ALTRO,
m.IDO_IDONEO as NUM_IDONEO,
m.IDO_NON_IDONEO as NUM_NON_IDONEO,
m.IDO_DA_VALUTARE as NUM_DA_VALUTARE
from COR_MIS_REPORT_VIEW m
where are_id= $P{areaId} 
and anno= $P{YEAR} 
 $P!{orgUnitIdString} ) m1
   where 1=1
   and m1.DATA_RIFERIMENTO= $P{customTimePeriod} 
group by m1.DATA_RIFERIMENTO,m1.ANNO, m1.AREA_RISCHIO, m1.AREA_RISCHIO_LANG, m1.ARE_ID,m1.PROCESSO, m1.PROCESSO_LANG, m1.PRO_ID
order by m1.DATA_RIFERIMENTO,m1.ANNO, m1.AREA_RISCHIO, m1.AREA_RISCHIO_LANG, m1.ARE_ID,m1.PROCESSO, m1.PROCESSO_LANG, m1.PRO_ID;]]>
