	<parameter name="filterLeftJoinString" class="java.lang.String" isForPrompting="false"/>
	<parameter name="filterInnerJoinString" class="java.lang.String" isForPrompting="false"/>
	<parameter name="customTimePeriodString" class="java.lang.String" isForPrompting="false"/>
	<parameter name="personId" class="java.lang.String" isForPrompting="false"/>
	<parameter name="workEffortId" class="java.lang.String" isForPrompting="false"/>
	<parameter name="date3009" class="java.util.Date" isForPrompting="false"/>
	<parameter name="date3009sql" class="java.lang.String" isForPrompting="false"/>
	<parameter name="exposePaginator" class="java.lang.String" isForPrompting="false"/>
	<parameter name="YEAR" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select m1.ANNO,
			m1.ETCH_AREA_RISCHIO,
			m1.AREA_RISCHIO, 
			SUM(m1.MIS_PREVISTE) as MIS_PREVISTE, 
			SUM(m1.MIS_ATTUATE) as MIS_ATTUATE, 
			-- round((SUM(cast (m1.MIS_ATTUATE as decimal(10,2))) / SUM(cast(m1.MIS_PREVISTE as decimal(10,2))) * 100.0) - 100.0 , 0) as MIS_DELTA_PERC,
			(select count(*) from COR_PRO_DETAIL_VIEW p where p.ANNO = m1.ANNO and p.ARE_ID = m1.ARE_ID) as PRO_PREVISTI,
			-- round(SUM(cast (m1.MIS_PREVISTE as decimal(10,2))) / cast((select count(*) from COR_PRO_DETAIL_VIEW p where p.ANNO = m1.ANNO and p.ARE_ID = m1.ARE_ID) as decimal(10,2)),0) as MIS_PRO, 	
			m1.ARE_ID
from (select m.ANNO,m.ETCH_AREA_RISCHIO,m.ARE_ID, m.AREA_RISCHIO,1 as MIS_PREVISTE, m.SAL_ATTUATA as MIS_ATTUATE
			from COR_MIS_REPORT_VIEW m
			where exists (SELECT 1 from USER_LOGIN_SECURITY_GROUP ULSG 
										INNER JOIN SECURITY_GROUP_PERMISSION SP ON SP.GROUP_ID = ULSG.GROUP_ID AND SP.PERMISSION_ID = 'CORPERFMGR_ADMIN'
										WHERE ULSG.USER_LOGIN_ID =  $P{userLoginId}
										and m.anno= $P{YEAR} 
										AND m.DATA_RIFERIMENTO= $P{customTimePeriod} 
										and m.company= $P{defaultOrganizationPartyId} 
										 $P!{orgUnitIdString} )
			or exists (SELECT 1 from USER_LOGIN_SECURITY_GROUP ULSG 
								INNER JOIN SECURITY_GROUP_PERMISSION SP ON SP.GROUP_ID = ULSG.GROUP_ID AND SP.PERMISSION_ID = 'CORPERFORG_ADMIN'
								INNER JOIN USER_LOGIN UL ON UL.USER_LOGIN_ID = ULSG.USER_LOGIN_ID 
								INNER JOIN PARTY_RELATIONSHIP PRO ON PRO.PARTY_ID_TO = UL.PARTY_ID
								AND (PRO.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
								or (PRO.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_DELEGATE' AND (PRO.CTX_ENABLED IS NULL OR PRO.CTX_ENABLED LIKE 'CTX_CO')))
								WHERE ULSG.USER_LOGIN_ID =  $P{userLoginId} 
								and EXTRACT(YEAR FROM PRO.FROM_DATE) <= cast(m.ANNO as decimal(10,0))
								and (PRO.THRU_DATE is null or EXTRACT(YEAR FROM PRO.FROM_DATE) >= cast(m.ANNO as decimal(10,0)) )
								AND PRO.PARTY_ID_FROM = m.PRO_RESP)
			and m.anno= $P{YEAR} 
			AND m.DATA_RIFERIMENTO= $P{customTimePeriod} 
			and m.company= $P{defaultOrganizationPartyId} 
			 $P!{orgUnitIdString} ) m1
 where 1=1
 group by m1.ANNO,m1.ETCH_AREA_RISCHIO, m1.AREA_RISCHIO, m1.ARE_ID 
order by m1.ANNO,m1.ETCH_AREA_RISCHIO, m1.AREA_RISCHIO, m1.ARE_ID]]>
	</queryString>
