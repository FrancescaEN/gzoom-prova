            <xml-property name="queryText"><![CDATA[--INDICATORI
select
	ate.amount as "AMOUNT",
	ga.gl_account_id as "INDICATORE_ID",
	ga.account_name as "INDICATORE_NOME",
	u.uom_type_id as "TYPE_MEASURE",
	gamrs.uom_code as "AMOUNT_CODE",
	gamrs.uom_descr as "AMOUNT_DESCR",
	max(wepa.work_effort_purpose_type_id) as "FINALITA_INDICATORE",
	dr.object_info as "PATH_SMILE",
	wem.uom_descr as "INDICATORE_DESC",
	u.decimal_scale as "DECIMAL_SCALE",
	u.abbreviation as "ABBREVATION",
	max(case when at2.transaction_date = @date3112	-- 2022 anno del monitoring date
		and ate.gl_fiscal_type_id = 'BUDGET'	--target	
			then ate.amount 
			else null end
	) as "TARGET_ANNO",
	max(case when at2.transaction_date = @date3112piu1	-- 2023 anno del monitoring date +1
		and ate.gl_fiscal_type_id = 'BUDGET'	--target	
			then ate.amount 
			else null end
	) as "TARGET_ANNO_1",
	max(case when at2.transaction_date = @date3112piu2	-- 2024 anno del monitoring date +2
		and ate.gl_fiscal_type_id = 'BUDGET'	--target	
			then ate.amount 
			else null end
	) as "TARGET_ANNO_2"
from 
	work_effort_measure wem 
	join gl_account ga on ga.gl_account_id = wem.gl_account_id 					-- indicatori 
	join work_effort_purpose_account wepa on ga.gl_account_id = wepa.gl_account_id 
		--and wepa.work_effort_purpose_type_id = 'CORMIS'
	join uom u on u.uom_id = ga.default_uom_id				-- tipo dell'unità di misura (si/no, valore ecc)
	left join acctg_trans at2 on at2.voucher_ref = wem.work_effort_measure_id 	-- serve solo per data
	left join acctg_trans_entry ate on ate.acctg_trans_id = at2.acctg_trans_id 	-- valori	
	left join gl_account_meas_rat_sc gamrs on gamrs.gl_account_id = ga.gl_account_id -- ho il valore che viene mostrato quando il tipo è "RATING_SCALE"
		and gamrs.uom_rating_value <= ate.amount and gamrs.uom_rating_value >= ate.amount 	
	left join uom_range_values urv on urv.uom_range_id = ga.gl_account_type_id 		
		and urv.from_value <= ate.amount and urv.thru_value >= ate.amount 
	left join content c on urv.icon_content_id = c.content_id 	
	left join data_resource dr on c.data_resource_id =dr.data_resource_id
where 0=0
	and wem.work_effort_id = ? -- ID_WORK_EFFORT
	and u.uom_type_id != 'OTHER_MEASURE'
	--and ga.gl_account_id = 'CORRIS.5.1'		-- prendo esattamente l'indicatore "valutazione FACCINA" per FASE
	-- id:indicatore = 10391 ---> prendi esattamente l'indicatore "valutazione FACCINA" per PROCESSO
	-- id_indicatore = 10380 ---> Tipo misura consolidata / da consolidare
	-- FINALITA_INDICATORE = 'CORMIS' solo con indicatori del processo per prendere i soli indicatori di questo tipo
group by 
"AMOUNT",
"INDICATORE_ID",
"INDICATORE_NOME",
"TYPE_MEASURE",
"AMOUNT_CODE",
"AMOUNT_DESCR",
--"FINALITA_INDICATORE",
"PATH_SMILE",
"INDICATORE_DESC",
"DECIMAL_SCALE",
"ABBREVATION"]]></xml-property>
