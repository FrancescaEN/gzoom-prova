                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[ --NOTE
SELECT 
ND.NOTE_NAME AS "NOTE_NAME" , 
ND.NOTE_INFO AS "NOTE_INFO", 
ND.NOTE_ID AS "NOTE_ID", 
ND.NOTE_DATE_TIME AS "NOTE_DATE", 
MN.WORK_EFFORT_ID AS "W_E_ID",
MN.SEQUENCE_ID AS "SEQUENCE_ID"
  FROM WORK_EFFORT_NOTE MN
  INNER JOIN NOTE_DATA ND ON ND.NOTE_ID = MN.NOTE_ID
  where 0=0 
  and MN.WORK_EFFORT_ID = ? --WORK_EFFORT_ID
  ORDER BY "SEQUENCE_ID"
  --PROCESSO
  -- 	quando cerchi "Elementi di contesto", puoi trovarlo confrontando con sequence-ID con "80"
  --FASE
  -- 	quando cerchi "Attività in presenza" = sequenceId = 100
  -- 	quando cerchi "Attività da remoto" = sequenceId = 102
  -- 	quando cerchi "Eventi rischiosi" = sequenceId = 103
  -- 	quando cerchi "Fattori abilitanti" = sequenceId = 104
  -- 	quando cerchi "RESPONSABILITA" = sequenceId = 105
  --MISURE
  -- 	solo una
  --	no data della nota]]></xml-property>
