            <xml-property name="queryText"><![CDATA[SELECT IND.* 
FROM REP_SK_IND IND
INNER JOIN WORK_EFFORT FIL_W 
	ON IND.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
@filterInnerJoin
@filterLeftJoin
WHERE DATA_STAMPA = @monitoringDate 
@workEffortId
@workEffortTypeId 
@orgUnitId
@filterWhere

]]></xml-property>
