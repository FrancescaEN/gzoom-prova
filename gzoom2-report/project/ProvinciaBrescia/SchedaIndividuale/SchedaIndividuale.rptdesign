            <method name="beforeOpen"><![CDATA[this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );
//this.queryText = this.queryText.replace("@monitoringDate",  "'2020-12-31 00:00:00.000'");

//@orgUnitId
var orgUnitIdString = '';
/**/if (params["orgUnitId"].value != null &amp;&amp; params["orgUnitId"].value != '') {
	orgUnitIdString = " AND FIL_W.ORG_UNIT_ID = '"+ params["orgUnitId"].value + "'";
}
this.queryText = this.queryText.replace("@orgUnitId",  orgUnitIdString );

//@workEffortId
var workEffortId = '';
if (params["workEffortId"].value != null &amp;&amp; params["workEffortId"].value != '')
{
    workEffortId = " AND FIL_W.WORK_EFFORT_ID = '"+params["workEffortId"].value + "'";
} else if (params["workEffortIdChild"].value != null &amp;&amp; params["workEffortIdChild"].value != '')
{
    workEffortId = " AND FIL_W.WORK_EFFORT_ID = '"+params["workEffortIdChild"].value + "'";
}
this.queryText = this.queryText.replace("@workEffortId",  workEffortId );

//@workEffortTypeId
var workEffortTypeId = '';
if (params["workEffortTypeId"].value != null &amp;&amp; params["workEffortTypeId"].value != '')
{
    workEffortTypeId = " AND FIL_W.WORK_EFFORT_TYPE_ID = '"+params["workEffortTypeId"].value + "'";
}
this.queryText = this.queryText.replace("@workEffortTypeId",  workEffortTypeId );

//GESTIRE PERMESSI

 /*
 
var filterInnerJoin = "";
var filterLeftJoin = "";
var filterWhere = "";  */

 /* */
filter = new com.mapsengineering.base.birt.util.UtilFilter(params["userLoginId"].value, params["localDispatcherName"].value);
filterInnerJoin = filter.getWorkEffortFilterInner();
filterLeftJoin = filter.getWorkEffortFilterLeftJoin();
filterWhere = filter.getWorkEffortFilterWhere(); 

this.queryText = this.queryText.replace("@filterInnerJoin",  filterInnerJoin );
this.queryText = this.queryText.replace("@filterLeftJoin",  filterLeftJoin );
this.queryText = this.queryText.replace("@filterWhere",  filterWhere );

//ReportLog.info("query detail "+this.queryText);
]]></method>
