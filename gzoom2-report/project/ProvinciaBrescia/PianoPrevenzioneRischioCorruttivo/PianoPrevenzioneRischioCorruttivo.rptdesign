                    <property name="nativeName">NOME_FASE</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">NOTE_INFO</property>
                    <property name="nativeName">NOTE_INFO</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select
ob4 .work_effort_name AS "NOME_FASE",
wenv.note_info  AS "NOTE_INFO"
from work_effort ob4
-- Fase misura
left join work_effort_note_view wenv on wenv.work_effort_id = ob4.work_effort_id
 where ob4.work_effort_id = ?
 and wenv.sequence_id = 10]]></xml-property>
