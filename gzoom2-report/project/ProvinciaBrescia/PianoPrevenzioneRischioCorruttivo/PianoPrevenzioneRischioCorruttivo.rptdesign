                                                                <column id="60480"/>
                                                                <detail>
                                                                    <row id="60477">
                                                                        <list-property name="visibility">
                                                                            <structure>
                                                                                <property name="format">all</property>
                                                                                <expression name="valueExpr" type="javascript">//10380 è l'ID dell'indicatore che mostra il consolidamento (già consolidato/da consolidare)&#13;
//questo indicatore è mostrato in una parte differente della stampa&#13;
if(row["INDICATORE_ID"] == '10380')&#13;
	true&#13;
else if(row["TYPE_MEASURE"] == 'RATING_SCALE' &amp;&amp; row["ABBREVATION"] != 'S/N')&#13;
	row["AMOUNT_DESCR"] == null || row["AMOUNT_DESCR"] == ''&#13;
else&#13;
	(row["TARGET_ANNO_NUM"] == null &amp;&amp; row["TARGET_ANNO_STR"] ==null)</expression>
                                                                            </structure>
                                                                        </list-property>
                                                                        <cell id="60478">
                                                                            <text-data id="60479">
                                                                                <expression name="valueExpr">var str = row["INDICATORE_DESC"] +" (" +BirtDateTime.year(params["monitoringDate"].value)+" "+row["ABBREVATION"]+" "&#13;
if(row["TYPE_MEASURE"] == 'RATING_SCALE')&#13;
	str += row["TARGET_ANNO_STR"];&#13;
else&#13;
	str += row["TARGET_ANNO_NUM"];&#13;
if(row["ABBREVATION"] == 'Perc.')&#13;
	str += '%';&#13;
str += ")";&#13;
str</expression>
                                                                                <property name="contentType">html</property>
                                                                            </text-data>
                                                                        </cell>
                                                                    </row>
                                                                </detail>
                                                            </table>
                                                        </cell>
                                                    </row>
                                                </header>
                                            </group>
                                        </table>
                                    </cell>
                                </row>
                                <row id="60903">
                                    <property name="borderLeftColor">#C0C0C0</property>
                                    <property name="borderLeftStyle">solid</property>
                                    <property name="borderLeftWidth">thin</property>
                                    <property name="borderRightColor">#C0C0C0</property>
                                    <property name="borderRightStyle">solid</property>
                                    <property name="borderRightWidth">thin</property>
                                    <list-property name="visibility">
                                        <structure>
                                            <property name="format">all</property>
                                            <expression name="valueExpr" type="javascript">row["WORK_EFFORT_NAME4"]==null || row["WORK_EFFORT_NAME4"]==''</expression>
                                        </structure>
                                    </list-property>
