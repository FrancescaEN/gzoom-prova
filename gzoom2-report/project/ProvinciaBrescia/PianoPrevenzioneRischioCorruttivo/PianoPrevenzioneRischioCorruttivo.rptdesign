                            </footer>
                        </group>
                    </table>
                </cell>
            </row>
        </grid>
        <text-data id="60900">
            <expression name="valueExpr">if (row["TYPE_MEASURE"]=='OTHER_MEASURE' &amp;&amp; row["ABBREVATION"]=='Perc.' &amp;&amp; row["TARGET_ANNO_NUM"] != null &amp;&amp; row["TARGET_ANNO_NUM"] != ''  ){row["TARGET_ANNO_NUM"]+'%';}&#13;
else if (row["TYPE_MEASURE"]=='OTHER_MEASURE' &amp;&amp; row["ABBREVATION"]!='Perc.' &amp;&amp; row["TARGET_ANNO_NUM"] != null &amp;&amp; row["TARGET_ANNO_NUM"] != ''  ){row["TARGET_ANNO_NUM"]+'%';}&#13;
else {row["TARGET_ANNO_STR"];}</expression>
            <property name="contentType">html</property>
        </text-data>
