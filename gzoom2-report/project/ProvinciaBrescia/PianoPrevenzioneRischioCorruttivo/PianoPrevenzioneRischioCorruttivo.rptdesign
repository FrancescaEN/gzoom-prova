        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="FasiMisureDS" id="60250">
            <list-property name="columnHints"/>
            <list-property name="parameters">
                <structure>
                    <property name="name">work_effort_id</property>
                    <property name="nativeName"></property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">0</property>
                    <property name="position">1</property>
                    <expression name="defaultValue" type="constant">N/A</expression>
                    <property name="isOptional">false</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">SOURCE_REFERENCE_ID</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">NOME_FASE</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">NOTE_INFO</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <method name="beforeOpen"><![CDATA[/*
this.queryText = this.queryText.replace("@date0101",  "'2021-01-01 00:00:00.000'" );
this.queryText = this.queryText.replace("@date3112",  "'2021-12-31 00:00:00.000'" );
*/
/**/
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value );
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );


//ReportLog.info("......this.queryText FasiMisure DS: "+this.queryText);	]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">SOURCE_REFERENCE_ID</property>
                    <property name="nativeName">SOURCE_REFERENCE_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">NOME_FASE</property>
                    <property name="nativeName">NOME_FASE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">NOTE_INFO</property>
                    <property name="nativeName">NOTE_INFO</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select FMIS.source_reference_id AS "SOURCE_REFERENCE_ID",
FMIS.work_effort_name AS "NOME_FASE",
wenv.note_info  AS "NOTE_INFO"
from work_effort ob4
-- Fase misura
left join work_effort_assoc wea on wea.work_effort_id_from = OB4.work_effort_id 
	and wea.work_effort_assoc_type_id = '15APSARC'		-- nome della relazione
	AND ('N' = 'Y' OR ('N' = 'N' AND wea.from_date <= @date3112 AND wea.thru_date >= @date0101))
left join work_effort FMIS on wea.work_effort_id_to = FMIS.work_effort_id 
	and FMIS.work_effort_type_id = '15AP6F1'
	and FMIS.work_effort_revision_id is null	--se nullo non è storicizzato
	AND ('N' = 'Y' OR ('N' = 'N' AND FMIS.ESTIMATED_START_DATE <= @date3112 AND FMIS.ESTIMATED_COMPLETION_DATE >= @date0101))
left join work_effort_note_view wenv on wenv.work_effort_id = fmis.work_effort_id 
 where ob4.work_effort_id = ?
 and wenv.sequence_id = 1
 order by FMIS.source_reference_id]]></xml-property>
        </oda-data-set>
