            <xml-property name="queryText"><![CDATA[select
case when (valut.amount is null and ar.etch='Z') then 99 else valut.amount end as amount,
RADTC.ETCH AS "RAD_TITOLO",
--RA.WORK_EFFORT_ID AS "RA_WORK_EFFORT_ID",
RR.SEQUENCE_NUM AS "AREA_SEQUENCE",
ART.ETCH AS "AREA_ETCH_TYPE",
AR.ETCH AS "AREA_ETCH",
AR.WORK_EFFORT_NAME AS "AREA_NAME",
AR.WORK_EFFORT_ID AS "AREA_ID",
AR.DESCRIPTION AS "AREA_DESC",
PR.ETCH AS "PROCESSO_ETCH",
PRT.ETCH AS "PROCESSO_ETCH_TYPE",
PR.WORK_EFFORT_NAME AS "PROCESSO_NAME",
PR.WORK_EFFORT_ID AS "PROCESSO_ID",
PR.DESCRIPTION AS "PROCESSO_DESC",
AP.SEQUENCE_NUM AS "PROCESSO_SEQUENCE",
FIL_W.ETCH AS "SOTTOPROC_ETCH",
SPT.ETCH AS "SOTTOPROC_ETCH_TYPE",
FIL_W.WORK_EFFORT_NAME AS "SOTTOPROC_NAME",
FIL_W.WORK_EFFORT_ID AS "SOTTOPROC_ID",
FIL_W.DESCRIPTION AS "SOTTOPROC_DESC",
FIL_W.ESTIMATED_START_DATE AS "SOT_ESTI_START_DATE",
PP.SEQUENCE_NUM AS "SOTTOPROC_SEQUENCE",
SC.PARENT_ROLE_CODE AS "SETTORE_ID",
ST.PARTY_NAME AS "SETTORE_NAME",

MIS.WORK_EFFORT_ID4 AS "WORK_EFFORT_ID4", 
MIS.ETCH_TYPE4 AS "ETCH_TYPE4", 
MIS.ETCH4 AS "ETCH4", 
MIS.WORK_EFFORT_NAME4 AS "WORK_EFFORT_NAME4", 
MIS.SEQUENCE_NUM4 AS "SEQUENCE_NUM4", 
MIS.DESCRIPTION4 AS "DESCRIPTION4", 
MIS.ASSOC_WEIGHT4 AS "ASSOC_WEIGHT4", 
MIS.SOURCE_REFERENCE_ID4 AS "SOURCE_REFERENCE_ID4",	
		
MIS.DESCRIPTION_TYPE4 AS "DESCRIPTION_TYPE4",
MIS.TIPOLOGIA_MISURE AS "TIPOLOGIA_MISURE",

--FASE DELLA MISURA
FMIS.work_effort_id AS "FASE_MIS_ID",	--da collegare con note

PR.SOURCE_REFERENCE_ID AS "SOURCE_REFERENCE_ID1",
FIL_W.SOURCE_REFERENCE_ID AS "SOURCE_REFERENCE_ID2"

FROM WORK_EFFORT RA
INNER JOIN WORK_EFFORT_TYPE RAT ON RAT.WORK_EFFORT_TYPE_ID = RA.WORK_EFFORT_TYPE_ID
INNER JOIN WORK_EFFORT_TYPE_CONTENT RADTC ON RADTC.WORK_EFFORT_TYPE_ID = RAT.WORK_EFFORT_TYPE_ID
AND RADTC.CONTENT_ID = 'REP_PPR_CORR'

-- area
INNER JOIN WORK_EFFORT_ASSOC RR ON RR.WORK_EFFORT_ID_FROM = RA.WORK_EFFORT_ID
AND RR.WORK_EFFORT_ASSOC_TYPE_ID = RAT.HIERARCHY_ASSOC_TYPE_ID
INNER JOIN WORK_EFFORT AR ON AR.WORK_EFFORT_ID = RR.WORK_EFFORT_ID_TO
AND ('N' = 'Y' OR ('N' = 'N' AND AR.ESTIMATED_START_DATE <= @date3112 AND AR.ESTIMATED_COMPLETION_DATE >= @date0101))
INNER JOIN WORK_EFFORT_TYPE ART ON ART.WORK_EFFORT_TYPE_ID = AR.WORK_EFFORT_TYPE_ID

-- Processo
INNER JOIN WORK_EFFORT_ASSOC AP ON AP.WORK_EFFORT_ID_FROM = AR.WORK_EFFORT_ID
AND AP.WORK_EFFORT_ASSOC_TYPE_ID = ART.WORK_EFFORT_ASSOC_TYPE_ID
INNER JOIN WORK_EFFORT PR ON PR.WORK_EFFORT_ID = AP.WORK_EFFORT_ID_TO
AND ('N' = 'Y' OR ('N' = 'N' AND PR.ESTIMATED_START_DATE <= @date3112 AND PR.ESTIMATED_COMPLETION_DATE >= @date0101))
INNER JOIN WORK_EFFORT_TYPE PRT ON PRT.WORK_EFFORT_TYPE_ID = PR.WORK_EFFORT_TYPE_ID
-- collegamento alla struttura
INNER JOIN PARTY ST ON ST.PARTY_ID = PR.ORG_UNIT_ID
INNER JOIN PARTY_PARENT_ROLE SC ON SC.PARTY_ID = ST.PARTY_ID AND SC.ROLE_TYPE_ID = 'ORGANIZATION_UNIT'


--valutazione di rischio del processo
left join (
select ate.amount,
wem.work_effort_id 
from work_effort_measure wem 
join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id and ate.gl_account_id = '10391'
join acctg_trans at2 on at2.acctg_trans_id = ate.acctg_trans_id and at2.transaction_date = @date3112
)valut on valut.work_effort_id = pr.work_effort_id


-- Sottoprocesso (FASE)
INNER JOIN WORK_EFFORT_ASSOC PP ON PP.WORK_EFFORT_ID_FROM = PR.WORK_EFFORT_ID
AND PP.WORK_EFFORT_ASSOC_TYPE_ID = PRT.WORK_EFFORT_ASSOC_TYPE_ID
INNER JOIN WORK_EFFORT FIL_W ON FIL_W.WORK_EFFORT_ID = PP.WORK_EFFORT_ID_TO
AND ('N' = 'Y' OR ('N' = 'N' AND FIL_W.ESTIMATED_START_DATE <= @date3112 AND FIL_W.ESTIMATED_COMPLETION_DATE >= @date0101))
INNER JOIN WORK_EFFORT_TYPE SPT ON SPT.WORK_EFFORT_TYPE_ID = FIL_W.WORK_EFFORT_TYPE_ID
LEFT OUTER JOIN WORK_EFFORT_PURPOSE_TYPE WEPT ON WEPT.WORK_EFFORT_PURPOSE_TYPE_ID = FIL_W.WORK_EFFORT_PURPOSE_TYPE_ID

@filterInnerJoin
@filterLeftJoin	

-- MISURE
left join (
	select 
		ob4a.work_effort_id_from,
		OB4.WORK_EFFORT_ID AS WORK_EFFORT_ID4,
		OB4T.ETCH AS ETCH_TYPE4, 
		OB4.ETCH AS ETCH4, 
		OB4.WORK_EFFORT_NAME AS WORK_EFFORT_NAME4, 
		OB4A.SEQUENCE_NUM AS SEQUENCE_NUM4, 
		OB4.DESCRIPTION AS DESCRIPTION4, 
		OB4A.ASSOC_WEIGHT AS ASSOC_WEIGHT4, 
		OB4.SOURCE_REFERENCE_ID AS SOURCE_REFERENCE_ID4,	
		OB4T.DESCRIPTION AS DESCRIPTION_TYPE4,
		wept2.description as TIPOLOGIA_MISURE
	from work_effort_assoc ob4a
	JOIN WORK_EFFORT OB4 ON OB4.WORK_EFFORT_ID = OB4A.WORK_EFFORT_ID_TO
		AND ('N' = 'Y' OR ('N' = 'N' AND OB4.ESTIMATED_START_DATE <= @date3112 AND OB4.ESTIMATED_COMPLETION_DATE >= @date0101))																											
	JOIN WORK_EFFORT_TYPE OB4T ON OB4T.WORK_EFFORT_TYPE_ID = OB4.WORK_EFFORT_TYPE_ID	
	JOIN work_effort_purpose_type wept2 on wept2.work_effort_purpose_type_id = OB4.work_effort_purpose_type_id 
) mis on mis.work_effort_id_from = fil_w.work_effort_id

-- Fase misura
left join work_effort_assoc wea on wea.work_effort_id_from = mis.WORK_EFFORT_ID4 
	and wea.work_effort_assoc_type_id = '15APSARC'		-- nome della relazione
	AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND wea.from_date <= @date3112 AND wea.thru_date >= @date0101))
left join work_effort FMIS on wea.work_effort_id_to = FMIS.work_effort_id 
	and FMIS.work_effort_type_id = '15AP6F1'
	and FMIS.work_effort_revision_id is null	--se nullo non è storicizzato
	AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND FMIS.ESTIMATED_START_DATE <= @date3112 AND FMIS.ESTIMATED_COMPLETION_DATE >= @date0101))


WHERE 0=0
  	@orgUnitId 
	@workEffortId
	@organizationId
	@filterWhere
	 
	
AND RA.WORK_EFFORT_REVISION_ID IS NULL 
AND AR.WORK_EFFORT_REVISION_ID IS NULL 
AND PR.WORK_EFFORT_REVISION_ID IS NULL 
AND FIL_W.WORK_EFFORT_REVISION_ID IS NULL
order by SC.PARENT_ROLE_CODE,

		 valut.amount DESC,
		 PR.SOURCE_REFERENCE_ID,
		 FIL_W.SOURCE_REFERENCE_ID,
		 MIS.SOURCE_REFERENCE_ID4]]></xml-property>
            <xml-property name="designerValues"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
