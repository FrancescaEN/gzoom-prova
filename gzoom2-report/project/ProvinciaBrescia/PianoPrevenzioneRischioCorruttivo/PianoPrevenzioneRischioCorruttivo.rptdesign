            <method name="beforeOpen"><![CDATA[this.queryText = this.queryText.replace("@date3006",  params["date3006Sql"].value );
this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );	

//this.queryText = this.queryText.replace("@date3006",  "'2023-06-30 00:00:00.000'" );
//this.queryText = this.queryText.replace("@monitoringDate",  "'2023-01-01 00:00:00.000'" );

//ReportLog.info(" ########### MasterDS: "+this.queryText);
//ReportLog.info(" ########### MasterDSPARAMS: "+this.getInputParameters());]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">NOTE_NAME</property>
                    <property name="nativeName">NOTE_NAME</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">NOTE_INFO</property>
                    <property name="nativeName">NOTE_INFO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">NOTE_ID</property>
                    <property name="nativeName">NOTE_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">NOTE_DATE</property>
                    <property name="nativeName">NOTE_DATE</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">W_E_ID</property>
                    <property name="nativeName">W_E_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">SEQUENCE_ID</property>
                    <property name="nativeName">SEQUENCE_ID</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">is_automatic</property>
                    <property name="nativeName">is_automatic</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[ --NOTE
SELECT 
ND.NOTE_NAME AS "NOTE_NAME" , 
ND.NOTE_INFO AS "NOTE_INFO", 
ND.NOTE_ID AS "NOTE_ID", 
ND.NOTE_DATE_TIME AS "NOTE_DATE", 
MN.WORK_EFFORT_ID AS "W_E_ID",
MN.SEQUENCE_ID AS "SEQUENCE_ID",
weta.is_automatic
  FROM WORK_EFFORT_NOTE MN
  INNER JOIN NOTE_DATA ND ON ND.NOTE_ID = MN.NOTE_ID
  inner join work_effort_type_attr weta on weta.attr_name = nd.note_name
  where 0=0 
  and mn.work_effort_id = ?
  and ((@monitoringDate < @date3006 and weta.is_automatic='N') or @monitoringDate >= @date3006)
  --and MN.WORK_EFFORT_ID = '' --WORK_EFFORT_ID
  --and weta.is_automatic = 'N' 
  ORDER BY "SEQUENCE_ID"
  --PROCESSO
  -- 	quando cerchi "Elementi di contesto", puoi trovarlo confrontando con sequence-ID con "80"
  --FASE
  -- 	quando cerchi "Attività in presenza" = sequenceId = 100
  -- 	quando cerchi "Attività da remoto" = sequenceId = 102
  -- 	quando cerchi "Eventi rischiosi" = sequenceId = 103
  -- 	quando cerchi "Fattori abilitanti" = sequenceId = 104
  -- 	quando cerchi "RESPONSABILITA" = sequenceId = 105
  --MISURE
  -- 	solo una
  --	no data della nota]]></xml-property>
