            <xml-property name="queryText"><![CDATA[select 
	conta.totale as "CONTA_INDICATORI",
	wepa.work_effort_purpose_type_id as "FINALITA_INDICATORE",
	ga.gl_account_id as "INDICATORE_ID",
	ga.account_name as "INDICATORE_NOME",
	wem.uom_descr as "INDICATORE_DESC",
	wem.work_effort_id,
	u.uom_type_id as "TYPE_MEASURE",
	u.decimal_scale as "DECIMAL_SCALE",
	u.abbreviation as "ABBREVATION",
	valut.amount as "VALUTAZIONE_RISCHIO",
	valut.uom_descr as "VALUTAZIONE_RISCHIO_COMMENTO",
	max(case when valind.transaction_date = @date3112 and valind.gl_fiscal_type_id = 'BUDGET' then valind.amount else null end) as "TARGET_ANNO_NUM",
	max(case when valind.transaction_date = @date3112piu1 and valind.gl_fiscal_type_id = 'BUDGET' then valind.amount else null end) as "TARGET_ANNO_1_NUM",
	max(case when valind.transaction_date = @date3112piu2 and valind.gl_fiscal_type_id = 'BUDGET' then valind.amount else null end) as "TARGET_ANNO_2_NUM",
	max(case when valind.transaction_date = @date3112 and valind.gl_fiscal_type_id = 'BUDGET' then valind.uom_descr else null end) as "TARGET_ANNO_STR",
	max(case when valind.transaction_date = @date3112piu1 and valind.gl_fiscal_type_id = 'BUDGET' then valind.uom_descr else null end) as "TARGET_ANNO_1_STR",
	max(case when valind.transaction_date = @date3112piu2 and valind.gl_fiscal_type_id = 'BUDGET' then valind.uom_descr else null end) as "TARGET_ANNO_2_STR",
	max(case when valind.transaction_date = @date3112 and valind.gl_fiscal_type_id = 'ACTUAL' then valind.amount else null end) as "ACTUAL_ANNO_NUM",
	max(case when valind.transaction_date = @date3112piu1 and valind.gl_fiscal_type_id = 'ACTUAL' then valind.amount else null end) as "ACTUAL_ANNO_1_NUM",
	max(case when valind.transaction_date = @date3112piu2 and valind.gl_fiscal_type_id = 'ACTUAL' then valind.amount else null end) as "ACTUAL_ANNO_2_NUM",
	max(case when valind.transaction_date = @date3112 and valind.gl_fiscal_type_id = 'ACTUAL' then valind.uom_descr else null end) as "ACTUAL_ANNO_STR",
	max(case when valind.transaction_date = @date3112piu1 and valind.gl_fiscal_type_id = 'ACTUAL' then valind.uom_descr else null end) as "ACTUAL_ANNO_1_STR",
	max(case when valind.transaction_date = @date3112piu2 and valind.gl_fiscal_type_id = 'ACTUAL' then valind.uom_descr else null end) as "ACTUAL_ANNO_2_STR",
	max(case when valind.gl_account_id = '10380' then valind.uom_descr else null end) as "AMOUNT_DESCR",
	valut.object_info as "PATH_SMILE"
/* INDICATORI */
from work_effort_measure wem
join work_effort we on we.work_effort_id = wem.work_effort_id 
join work_effort_purpose_account wepa on wepa.gl_account_id = wem.gl_account_id
join gl_account ga on ga.gl_account_id = wem.gl_account_id 
join uom u on u.uom_id = ga.default_uom_id 
/* VALORI INDICATORI */
left join (
	select 
		at2.voucher_ref,
		at2.transaction_date,
		ate.gl_account_id,
		ate.gl_fiscal_type_id,
		ate.amount,
		gamrs.uom_descr
	from acctg_trans at2
	join acctg_trans_entry ate on ate.acctg_trans_id = at2.acctg_trans_id and ate.gl_account_id <> 'SCORE' and ate.gl_account_id <> 'SCOREKPI'
	left join gl_account_meas_rat_sc gamrs on gamrs.gl_account_id = ate.gl_account_id 
		and gamrs.uom_rating_value <= ate.amount and gamrs.uom_rating_value >= ate.amount
) valind on valind.voucher_ref = wem.work_effort_measure_id 
/* SOTTOQUERY CHE CONTA GLI INDICATORI */
left join (
	select 
		wem.work_effort_id,
		count(*) as totale
	from work_effort_measure wem
	join work_effort_purpose_account wepa2 on wepa2.gl_account_id = wem.gl_account_id and wepa2.work_effort_purpose_type_id = 'CORMIS'
	where wem.gl_account_id <> 'SCORE'
	group by wem.work_effort_id 
) conta on conta.work_effort_id = we.work_effort_id 
/* VALUTAZIONE RISCHIO */
left join (
	select 
		ate.voucher_ref,
		ate.amount,
		gamrs.uom_descr,
		dr.object_info 
	from acctg_trans_entry ate
	join acctg_trans act on act.acctg_trans_id = ate.acctg_trans_id and act.transaction_date = @date3112
	left join gl_account_meas_rat_sc gamrs on gamrs.gl_account_id = ate.gl_account_id 
		and gamrs.uom_rating_value <= ate.amount and gamrs.uom_rating_value >= ate.amount
	join uom_range_values urv on urv.uom_range_id = 'CORRIS'
		and urv.from_value <= ate.amount and urv.thru_value >= ate.amount
	join content c on urv.icon_content_id = c.content_id 	
	join data_resource dr on c.data_resource_id =dr.data_resource_id
	where ate.gl_account_id in ('10391','CORRIS.5.1')
) valut on valut.voucher_ref = wem.work_effort_measure_id 
where wem.gl_account_id <> 'SCORE'
  and wem.work_effort_id = ?
group by
	ga.gl_account_id,
	ga.account_name,
	wem.uom_descr,
	u.uom_type_id,
	u.decimal_scale,
	u.abbreviation,
	valut.object_info,
	wem.work_effort_id,
	wepa.work_effort_purpose_type_id,
	conta.totale,
	valut.amount,
	valut.uom_descr]]></xml-property>
