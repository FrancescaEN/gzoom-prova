			<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
		</parameter>
		<queryString language="SQL">
			<![CDATA[SELECT ND.NOTE_INFO$P!{langLocale} AS "NOTE_INFO"
FROM  WORK_EFFORT_TYPE_ATTR WTA
INNER JOIN NOTE_DATA ND ON ND.NOTE_ID = WTA.NOTE_ID
INNER JOIN CONTENT C ON C.CONTENT_ID =  'GDPR_REG_TART'
WHERE WTA.WORK_EFFORT_TYPE_ID = $P{workEffortTypeId}
	AND C.DESCRIPTION = ND.NOTE_NAME]]>
		</queryString>
		<field name="NOTE_INFO" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="NOTE_INFO"/>
			<property name="com.jaspersoft.studio.field.label" value="NOTE_INFO"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="ND"/>
		</field>
	</subDataset>
