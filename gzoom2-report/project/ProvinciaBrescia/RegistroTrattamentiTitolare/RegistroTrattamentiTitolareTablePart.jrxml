	<parameter name="workEffortId" class="java.lang.String" isForPrompting="false"/>
	<parameter name="exposePaginator" class="java.lang.String" isForPrompting="false"/>
	<parameter name="exposeReleaseDate" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[select 
	wet.etch as TIPOLOGIA_TRATTAMENTO,
	FIL_W.work_effort_name as NOME_TRATTAMENTO,
	FIL_W.etch as ETCH_TRATTAMENTO, FIL_W.source_reference_id as CODICE_TRATTAMENTO,
	FIL_W.estimated_start_date as DATA_INIZIO_TRATTAMENTO, FIL_W.estimated_completion_date as DATA_FINE_TRATTAMENTO,
	rl.description as TIPOLOGIA_UNITA_RESPONSABILE,
	concat(pprstrutt.parent_role_code, ' - ', strutt.party_name) as UNITA_RESPONSABILE,
	/* 1 - Descrizione trattamento */
	note.NOME_DESCRIZIONE_TRATTAMENTO as NOME1,
	note.DESCRIZIONE_TRATTAMENTO as INFO1,
	/* 2 - Categorie trattamenti */
	note.NOME_CATEGORIE_TRATTAMENTO as NOME2,
	note.CATEGORIE_TRATTAMENTO as INFO2,
	/* 3 - Base giuridica di legittimità */
	note.NOME_BASE_TRATTAMENTO as NOME3,
	note.BASE_TRATTAMENTO as INFO3,
	/* 4 - Contitolari */
	note.NOME_CONTITOLARI as NOME4,
	note.CONTITOLARI as INFO4,
	/* 5 - Trasferimento dati */
	note.NOME_TRASFERIMENTO_DATI as NOME5,
	note.TRASFERIMENTO_DATI as INFO5,
	
	/* 6 - Responsabile interno */
	resp_int.description as NOME6,
	resp_int.lista as INFO6,
	/* 7 - Incaricato trattamento */
	inc_tratt.description as NOME7,
	inc_tratt.lista as INFO7,
	/* 8 - Responsabile esterno */
	resp_est.description as NOME8,
	resp_est.lista as INFO8,
	/* 9 - Titolare esterno */
	tit_est.description as NOME9,
	tit_est.lista as INFO9,
	
	/* 10 - Categorie interessati */
	note.NOME_CATEGORIE_INTERESSATI as NOME10,
	note.CATEGORIE_INTERESSATI as INFO10,
	/* 11 - Categorie destinatari */
	note.NOME_CATEGORIE_DESTINATARI as NOME11,
	note.CATEGORIE_DESTINATARI as INFO11,
	/* 12 - Destinatari */
	note.NOME_DESTINATARI as NOME12,
	note.DESTINATARI as INFO12,
	/* 13 - Dati particolari */
	note.NOME_DATI_PARTICOLARI as NOME13,
	note.DATI_PARTICOLARI as INFO13,
	/* 14 - Categorie dati personali */
	note.NOME_DATI_PERSONALI as NOME14,
	note.DATI_PERSONALI as INFO14,
	/* 15 - Asset utilizzati */
	'Asset utilizzati' as NOME15,
	asset.lista as INFO15,
	/* 16 - Termine ultimo cancellazione */
	note.NOME_PERIODO_CONSERVAZIONE as NOME16,
	note.PERIODO_CONSERVAZIONE as INFO16,
	
	/* 17 - Note */
	note.NOME_NOTE as NOME17,
	note.NOTE as INFO17,
	/* 18 - Misure di sicurezza Organizzative */
	note.NOME_MISURE_ORGANIZZATIVE as NOME18,
	note.MISURE_ORGANIZZATIVE as INFO18,
	/* 19 - Misure di sicurezza tecniche */
	note.NOME_MISURE_TECNICHE_ORIZZONTALI as NOME19,
	note.MISURE_TECNICHE_ORIZZONTALI as INFO19,
	/* 20 - Misure di sicurezza tecniche (Verticali) */
	note.NOME_MISURE_TECNICHE_VERTICALI as NOME20,
	note.MISURE_TECNICHE_VERTICALI as INFO20,
	/* 21 - Ulteriori misure di sicurezza */
	note.NOME_ULTERIORI_MISURE as NOME21,
	note.ULTERIORI_MISURE as INFO21,
	/* 22 - Val.Impatto – Probabilità */
	valimp.NOME_PROB as NOME22,
	valimp.PROB as INFO22,
	/* 23 - Val.Impatto - Gravità */
	valimp.NOME_GRAV as NOME23,
	valimp.GRAV as INFO23,
	/* 24 - VALUTAZIONE D'IMPATTO */
	valimp.NOME_VAL as NOME24,
	valimp.VAL as INFO24,
	/* 25 - Valutazione Necessità DPIA */
	'Valutazione Necessità DPIA' as NOME25,
	dpia.lista as INFO25,
	/* 26 - Necessità DPIA */
	'Necessità DPIA' as NOME26,
	necdpia.uom_code as INFO26,
	/* 27 - Atti */
	'Atti' as NOME27,
	atti.lista as INFO27,
	/* 28 - Nomine */
	'Nomine' as NOME28,
	nomine.lista as INFO28
/* TRATTAMENTO */
from work_effort FIL_W
join work_effort_type wet on wet.work_effort_type_id = FIL_W.work_effort_type_id
/* UNITA' RESPONSABILE */
join party strutt on strutt.party_id = FIL_W.org_unit_id
join party_parent_role pprstrutt on pprstrutt.party_id = strutt.party_id
join party_role prstrutt on prstrutt.party_id = strutt.party_id
join role_type rl on rl.role_type_id = prstrutt.role_type_id and rl.role_type_id = 'SSL'
join party org on org.party_id = FIL_W.organization_id
/* START filterInnerJoin */
   $P!{filterInnerJoinString} 
/* END filterInnerJoin */
/* START filterLeftJoin */
  $P!{filterLeftJoinString} 
/* END filterLeftJoin */

/* 4 - Responsabile interno */
left join (
	select 
		wepa.work_effort_id,
		rt.description,
		 string_agg(
        concat(p.party_name, '                    ', 
            to_char(wepa.from_date, 'DD/MM/YYYY'), ' - ', 
            to_char(wepa.thru_date, 'DD/MM/YYYY')
        ), 
        E'\n' ORDER BY p.party_name
    ) as lista
	from work_effort_party_assignment wepa 
	join party p on p.party_id = wepa.party_id
	join role_type rt on rt.role_type_id = wepa.role_type_id and rt.role_type_id = 'WEM_GDPR_TRATRINT'
	where wepa.from_date <= $P{date3112} and (wepa.thru_date >= $P{date0101} or wepa.thru_date is null)
	group by wepa.work_effort_id, rt.description
) resp_int on resp_int.work_effort_id = FIL_W.work_effort_id
/* 5 - Incaricato trattamento */
left join (
	select 
		wepa.work_effort_id,
		rt.description,
		string_agg(
        concat(p.party_name, '                    ', 
            to_char(wepa.from_date, 'DD/MM/YYYY'), ' - ', 
            to_char(wepa.thru_date, 'DD/MM/YYYY')
        ), 
        E'\n' ORDER BY p.party_name
    ) as lista
	from work_effort_party_assignment wepa 
	join party p on p.party_id = wepa.party_id
	join role_type rt on rt.role_type_id = wepa.role_type_id and rt.role_type_id = 'WEM_GDPR_TRATINC'
	where wepa.from_date <= $P{date3112} and (wepa.thru_date >= $P{date0101} or wepa.thru_date is null)
	group by wepa.work_effort_id, rt.description
) inc_tratt on inc_tratt.work_effort_id = FIL_W.work_effort_id 
/* 6 - Responsabile esterno */
left join (
	select 
		wepa.work_effort_id,
		rt.description,
		string_agg(
        concat(p.party_name, '                    ', 
            to_char(wepa.from_date, 'DD/MM/YYYY'), ' - ', 
            to_char(wepa.thru_date, 'DD/MM/YYYY')
        ), 
        E'\n' ORDER BY p.party_name
    ) as lista
	from work_effort_party_assignment wepa 
	join party p on p.party_id = wepa.party_id
	join role_type rt on rt.role_type_id = wepa.role_type_id and rt.role_type_id = 'WEM_GDPR_TRATRES'
	where wepa.from_date <= $P{date3112} and (wepa.thru_date >= $P{date0101} or wepa.thru_date is null)
	group by wepa.work_effort_id, rt.description
) resp_est on resp_est.work_effort_id = FIL_W.work_effort_id 
/* 7 - Titolare esterno */
left join (
	select 
		wepa.work_effort_id,
		rt.description,
		string_agg(p.party_name, ',
' order by p.party_name) as lista
	from work_effort_party_assignment wepa 
	join party p on p.party_id = wepa.party_id
	join role_type rt on rt.role_type_id = wepa.role_type_id and rt.role_type_id = 'WEM_GDPR_TRATTIT'
	where wepa.from_date <= $P{date3112} and (wepa.thru_date >= $P{date0101} or wepa.thru_date is null)
	group by wepa.work_effort_id, rt.description
) tit_est on tit_est.work_effort_id = FIL_W.work_effort_id 
/* 14 - Asset utilizzati */
left join (
	select 
		wea.work_effort_id_from,
		string_agg(concat(we.etch, ' - ', we.work_effort_name, '                      ', to_char(we.estimated_start_date, 'DD/MM/YYYY'), ' - ', to_char(we.estimated_completion_date, 'DD/MM/YYYY')), '
' order by we.etch) as lista
	from work_effort_assoc wea
	join work_effort we on we.work_effort_id = wea.work_effort_id_to and we.work_effort_type_id = '18PRAS0ASS' and we.work_effort_revision_id is null
	group by
		wea.work_effort_id_from
) asset on asset.work_effort_id_from = FIL_W.work_effort_id 
/* NOTE */
left join (
	select
		wen.work_effort_id,
		max(case when wen.sequence_id = 110 then nd.note_name else null end) as NOME_DESCRIZIONE_TRATTAMENTO,
		max(case when wen.sequence_id = 110 then nd.note_info else null end) as DESCRIZIONE_TRATTAMENTO,
		max(case when wen.sequence_id = 130 then nd.note_name else null end) as NOME_CATEGORIE_TRATTAMENTO,
		max(case when wen.sequence_id = 130 then nd.note_info else null end) as CATEGORIE_TRATTAMENTO,
		max(case when wen.sequence_id = 140 then nd.note_name else null end) as NOME_CONTITOLARI,
		max(case when wen.sequence_id = 140 then nd.note_info else null end) as CONTITOLARI,
		max(case when wen.sequence_id = 150 then nd.note_name else null end) as NOME_TRASFERIMENTO_DATI,
		max(case when wen.sequence_id = 150 then nd.note_info else null end) as TRASFERIMENTO_DATI,
		max(case when wen.sequence_id = 160 then nd.note_name else null end) as NOME_BASE_TRATTAMENTO,
		max(case when wen.sequence_id = 160 then nd.note_info else null end) as BASE_TRATTAMENTO,
		max(case when wen.sequence_id = 210 then nd.note_name else null end) as NOME_DATI_PERSONALI,
		max(case when wen.sequence_id = 210 then nd.note_info else null end) as DATI_PERSONALI,
		max(case when wen.sequence_id = 220 then nd.note_name else null end) as NOME_DATI_PARTICOLARI,
		max(case when wen.sequence_id = 220 then nd.note_info else null end) as DATI_PARTICOLARI,
		max(case when wen.sequence_id = 230 then nd.note_name else null end) as NOME_PERIODO_CONSERVAZIONE,
		max(case when wen.sequence_id = 230 then nd.note_info else null end) as PERIODO_CONSERVAZIONE,
		max(case when wen.sequence_id = 240 then nd.note_name else null end) as NOME_CATEGORIE_INTERESSATI,
		max(case when wen.sequence_id = 240 then nd.note_info else null end) as CATEGORIE_INTERESSATI,
		max(case when wen.sequence_id = 250 then nd.note_name else null end) as NOME_CATEGORIE_DESTINATARI,
		max(case when wen.sequence_id = 250 then nd.note_info else null end) as CATEGORIE_DESTINATARI,
		max(case when wen.sequence_id = 260 then nd.note_name else null end) as NOME_DESTINATARI,
		max(case when wen.sequence_id = 260 then nd.note_info else null end) as DESTINATARI,
		max(case when wen.sequence_id = 320 then nd.note_name else null end) as NOME_MISURE_ORGANIZZATIVE,
		max(case when wen.sequence_id = 320 then nd.note_info else null end) as MISURE_ORGANIZZATIVE,
		max(case when wen.sequence_id = 330 then nd.note_name else null end) as NOME_MISURE_TECNICHE_ORIZZONTALI,
		max(case when wen.sequence_id = 330 then nd.note_info else null end) as MISURE_TECNICHE_ORIZZONTALI,
		max(case when wen.sequence_id = 340 then nd.note_name else null end) as NOME_MISURE_TECNICHE_VERTICALI,
		max(case when wen.sequence_id = 340 then nd.note_info else null end) as MISURE_TECNICHE_VERTICALI,
		max(case when wen.sequence_id = 350 then nd.note_name else null end) as NOME_ULTERIORI_MISURE,
		max(case when wen.sequence_id = 350 then nd.note_info else null end) as ULTERIORI_MISURE,
		max(case when wen.sequence_id = 360 then nd.note_name else null end) as NOME_NOTE,
		max(case when wen.sequence_id = 360 then nd.note_info else null end) as NOTE
	from work_effort_note wen 
	join note_data nd on nd.note_id = wen.note_id
	group by wen.work_effort_id	
) note on note.work_effort_id = FIL_W.work_effort_id 
/* 22/23/24 - Val.Impatto */
left join (
	select 
		wem.work_effort_id,
		max(case when gl.gl_account_id = '10440' then gl.account_name else null end) as NOME_PROB,
		max(case when gl.gl_account_id = '10440' then ate.amount else null end) as PROB,
		max(case when gl.gl_account_id = '10441' then gl.account_name else null end) as NOME_GRAV,
		max(case when gl.gl_account_id = '10441' then ate.amount else null end) as GRAV,
		max(case when gl.gl_account_id = '10442' then gl.account_name else null end) as NOME_VAL,
		max(case when gl.gl_account_id = '10442' then ate.amount else null end) as VAL
	from work_effort_measure wem
	join gl_account gl on gl.gl_account_id = wem.gl_account_id
	join acctg_trans act on act.voucher_ref = wem.work_effort_measure_id 
	join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id 
	group by
		wem.work_effort_id
) valimp on valimp.work_effort_id = FIL_W.work_effort_id
/* 25 - Necessità DPIA */
LEFT JOIN (
	SELECT 
		WEM.WORK_EFFORT_ID,
		string_agg(gl.account_name, ',
' order by gl.account_name) as lista
	FROM WORK_EFFORT_MEASURE WEM 
	JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID
	join WORK_EFFORT_PURPOSE_ACCOUNT WEPA on WEPA.GL_ACCOUNT_ID = GL.GL_ACCOUNT_ID 
	JOIN ACCTG_TRANS_ENTRY ATE ON ATE.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID and ATE.AMOUNT = 100
	join acctg_trans act on act.acctg_trans_id = ate.acctg_trans_id 
	JOIN WORK_EFFORT_MEAS_RAT_SC WEMRS ON WEMRS.WORK_EFFORT_MEASURE_ID = ATE.VOUCHER_REF
  		and WEMRS.UOM_RATING_VALUE = ATE.AMOUNT
	WHERE WEPA.WORK_EFFORT_PURPOSE_TYPE_ID = 'TRAVIP' and ATE.GL_ACCOUNT_ID <> 'GDPR10018'
	group by
		WEM.WORK_EFFORT_ID
) DPIA ON DPIA.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
/* 26 - Indicatore Necessità DPIA */
left join (
	select 
		WEM.WORK_EFFORT_ID,
		GL.ACCOUNT_NAME,
		WEMRS.UOM_CODE
	FROM WORK_EFFORT_MEASURE WEM
	JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID
	JOIN ACCTG_TRANS_ENTRY ATE ON ATE.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID
	join acctg_trans act on act.acctg_trans_id = ate.acctg_trans_id 
	JOIN WORK_EFFORT_MEAS_RAT_SC WEMRS ON WEMRS.WORK_EFFORT_MEASURE_ID = ATE.VOUCHER_REF
  		AND WEMRS.UOM_RATING_VALUE = ATE.AMOUNT
	where WEM.GL_ACCOUNT_ID = 'X10018'
) NECDPIA on NECDPIA.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID 
/* 28 - Atti */
left join (
	select 
		wec.work_effort_id,
		string_agg(concat(c.description, ' - ', c.content_name), ',
' order by c.description) as lista  
	from work_effort_content wec
	join content c on c.content_id = wec.content_id
	where wec.work_effort_content_type_id = 'ALLATTI'
	group by
		wec.work_effort_id
) atti on atti.work_effort_id = FIL_W.work_effort_id 
/* 29 - Nomine */
left join (
	select 
		wec.work_effort_id,
		string_agg(concat(c.description, ' - ', c.content_name), ',
' order by c.description) as lista 
	from work_effort_content wec
	join content c on c.content_id = wec.content_id
	where wec.work_effort_content_type_id = 'ALLNOM'
	group by
		wec.work_effort_id
) nomine on nomine.work_effort_id = FIL_W.work_effort_id 
where FIL_W.work_effort_type_id = '18PRTR0TRA' and FIL_W.work_effort_revision_id is null /*and FIL_W.source_reference_id = 'TRT.0007'*/
	and FIL_W.ESTIMATED_START_DATE <= $P{date3112} and (FIL_W.ESTIMATED_COMPLETION_DATE >= $P{date0101} or FIL_W.ESTIMATED_COMPLETION_DATE is null)
	$P!{orgUnitIdString}
	/* START filterWhere */
 	$P!{filterWhereString} 
   /* END filterWhere */
ORDER BY
	WET.ETCH,
	FIL_W.ETCH]]>
	</queryString>
