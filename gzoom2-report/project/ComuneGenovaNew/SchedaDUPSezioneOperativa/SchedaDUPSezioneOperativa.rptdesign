            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">Codice OBO</property>
                    <property name="nativeName">Codice OBO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">Etichetta OBO</property>
                    <property name="nativeName">Etichetta OBO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">Nome OBO</property>
                    <property name="nativeName">Nome OBO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">Cod MOGE</property>
                    <property name="nativeName">Cod MOGE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">ELENCO ANNUALE LL.PP.</property>
                    <property name="nativeName">ELENCO ANNUALE LL.PP.</property>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">Descrizione breve</property>
                    <property name="nativeName">Descrizione breve</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">Finanziamento</property>
                    <property name="nativeName">Finanziamento</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">Nome intervento</property>
                    <property name="nativeName">Nome intervento</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">9</property>
                    <property name="name">Totale quadro economico</property>
                    <property name="nativeName">Totale quadro economico</property>
                    <property name="dataType">float</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
	OBO.SOURCE_REFERENCE_ID as "Codice OBO",
	OBO.ETCH AS "Etichetta OBO",
	OBO.WORK_EFFORT_NAME AS "Nome OBO",
	INTER.SOURCE_REFERENCE_ID AS "Cod MOGE",
	YEAR(INTER.ESTIMATED_START_DATE) AS "ELENCO ANNUALE LL.PP.",
	INTER.DESCRIPTION AS "Descrizione breve",
	NOTE.NOTE_INFO AS "Finanziamento",
	INTER.WORK_EFFORT_NAME AS "Nome intervento",
	QUADRO.AMOUNT AS "Totale quadro economico"
/* OBIETTIVO OPERATIVO */
FROM WORK_EFFORT OBO
/* INTERVENTI SU OPERE PUBBLICHE */
LEFT JOIN WORK_EFFORT_ASSOC WEA ON WEA.WORK_EFFORT_ID_TO = OBO.WORK_EFFORT_ID AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '22D5C'
LEFT JOIN WORK_EFFORT INTER ON INTER.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_FROM AND INTER.WORK_EFFORT_REVISION_ID IS NULL AND INTER.WORK_EFFORT_TYPE_ID = '22D52OPE'
	AND INTER.ESTIMATED_START_DATE <= @date3112 AND INTER.ESTIMATED_COMPLETION_DATE >= @date0101
/* NOTE */
LEFT JOIN (
	SELECT 
		WEN.WORK_EFFORT_ID,
		ND.NOTE_INFO 
	FROM WORK_EFFORT_NOTE WEN
	JOIN NOTE_DATA ND ON ND.NOTE_ID = WEN.NOTE_ID 
	WHERE WEN.SEQUENCE_ID = '120'
) NOTE ON NOTE.WORK_EFFORT_ID = INTER.WORK_EFFORT_ID 
/* TOTALE QUADRO ECONOMICO */
LEFT JOIN (
	SELECT 
		WEM.WORK_EFFORT_ID,
		ATE.AMOUNT 
	FROM WORK_EFFORT_MEASURE WEM
	JOIN ACCTG_TRANS ACT ON ACT.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID AND ACT.TRANSACTION_DATE = @date3112
	JOIN ACCTG_TRANS_ENTRY ATE ON ATE.ACCTG_TRANS_ID = ACT.ACCTG_TRANS_ID 
	WHERE WEM.GL_ACCOUNT_ID = '10150'
) QUADRO ON QUADRO.WORK_EFFORT_ID = INTER.WORK_EFFORT_ID
WHERE OBO.WORK_EFFORT_TYPE_ID = '20D66OOP' AND OBO.WORK_EFFORT_REVISION_ID IS NULL 
	AND OBO.ESTIMATED_START_DATE <= @date3112 AND OBO.ESTIMATED_COMPLETION_DATE >= @date0101
	AND OBO.WORK_EFFORT_ID = ?]]></xml-property>
        </oda-data-set>
