        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="StoricoUODS" id="59192">
            <list-property name="columnHints"/>
            <list-property name="parameters">
                <structure>
                    <property name="name">param_1</property>
                    <property name="nativeName"></property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">0</property>
                    <property name="position">1</property>
                    <expression name="defaultValue" type="constant">N/A</expression>
                    <property name="isOptional">false</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">party_id_storico</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">group_name_storico</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <method name="beforeOpen"><![CDATA[this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );

//this.queryText = this.queryText.replace("@monitoringDate",  "'2020-12-31 00:00:00.000'" );

//ReportLog.info("storico uo  "+this.queryText);]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">party_id_storico</property>
                    <property name="nativeName">party_id_storico</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">group_name_storico</property>
                    <property name="nativeName">group_name_storico</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select
	pn1.party_id as party_id_storico,
	pn1.group_name as group_name_storico
from
	party_name_history pn1
where
	exists(
		select
			party_id as party_id,
			change_date as change_date
		from
			(
				select
					party_id as party_id,
					min( change_date ) as change_date
				from
					party_name_history pn3
				where
					pn3.change_date >=  @monitoringDate
				group by
					party_id
			) pn2
		where
			pn2.party_id = pn1.party_id
			and pn2.change_date = pn1.change_date
	)
	and pn1.party_id =?]]></xml-property>
        </oda-data-set>
