            <xml-property name="queryText"><![CDATA[SELECT 
   N_Q.SEQUENZA,
   N_Q.GL_ACCOUNT_ID,
   N_Q.TIPO_ODELLO,
   N_Q.CODICE_INDIC,
   N_Q.TITOLO_INDIC,
   N_Q.DESCRIZIONE_INDIC,
   N_Q.UOM_ETCH,
   N_Q.TITOLO_MISURA,
   N_Q.DESCRIZIONE_MISURA,
   N_Q.G_DETAIL_ENUM_ID,
   N_Q.TIPO_UOM,
   N_Q.SCALA_UOM,
   N_Q.ACTUAL_DATO_3112_MENO_QUATTRO,
   N_Q.ACTUAL_DATO_3112_MENO_TRE,
   N_Q.ACTUAL_DATO_3112_MENO_DUE,
   N_Q.ACTUAL_DATO_3112_MENO_UNO,
   N_Q.ACTUAL_DATO_3006,
   N_Q.ACTUAL_DATO_3112,
   N_Q.ACTUAL_COD_3112_MENO_QUATTRO,
   N_Q.ACTUAL_COD_3112_MENO_TRE,
   N_Q.ACTUAL_COD_3112_MENO_DUE,
   N_Q.ACTUAL_COD_3112_MENO_UNO,
   N_Q.ACTUAL_COD_3006,
   N_Q.ACTUAL_COD_3112,
   N_Q.ACTUAL_COMM_3006,
   N_Q.ACTUAL_COMM_3112,
   N_Q.ACTUAL_COMM_3112_PIU_UNO,
   N_Q.ACTUAL_COMM_3112_PIU_DUE,
   N_Q.ACTUAL_RIF_3006,
   N_Q.ACTUAL_RIF_3112,
   N_Q.ACTUAL_RIF_3112_PIU_UNO,
   N_Q.ACTUAL_RIF_3112_PIU_DUE,
   N_Q.BUDGET_COD_3112_MENO_TRE,
   N_Q.BUDGET_COD_3112_MENO_DUE,
   N_Q.BUDGET_COD_3112_MENO_UNO,
   N_Q.BUDGET_COD_3006,
   N_Q.BUDGET_COD_3112,
   N_Q.BUDGET_COD_3112_PIU_UNO,
   N_Q.BUDGET_DATO_3112_MENO_TRE,
   N_Q.BUDGET_DATO_3112_MENO_DUE,
   N_Q.BUDGET_DATO_3112_MENO_UNO,
   N_Q.BUDGET_DATO_3006,
   N_Q.BUDGET_DATO_3112,
   N_Q.BUDGET_DATO_3112_PIU_UNO,
   N_Q.BUDGET_DATO_3112_PIU_DUE,
   N_Q.BUDGET_COMM_3006,
   N_Q.BUDGET_COMM_3112_PIU_UNO,
   N_Q.BUDGET_COMM_3112_PIU_DUE,
   N_Q.BUDGET_RIF_3006,
   N_Q.BUDGET_RIF_3112,
   N_Q.BUDGET_RIF_3112_PIU_UNO,
   N_Q.BUDGET_RIF_3112_PIU_DUE, 
   N_Q.ACTUAL_RIF_3112_MENO_UNO,
   N_Q.ACTUAL_RIF_3112_MENO_DUE, 
   N_Q.ACTUAL_RIF_3112_MENO_TRE,
   N_Q.ACTUAL_RIF_3112_MENO_QUATTRO,
   N_Q.ACTUAL_COMM_3112_MENO_UNO,
   N_Q.ACTUAL_COMM_3112_MENO_DUE,
   N_Q.ACTUAL_COMM_3112_MENO_TRE,
   N_Q.ACTUAL_COMM_3112_MENO_QUATTRO,
   MAX(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3006 THEN TR.B_AMOUNT ELSE NULL END) SCORE_DATO_3006,  
   MAX(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3112 THEN TR.B_AMOUNT ELSE NULL END) SCORE_DATO_3112,  
   MAX(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3112 THEN TR.A_DESCRIPTION ELSE NULL END) SCORE_COMM_3112,  
   MAX(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3006 THEN TR.A_DESCRIPTION ELSE NULL END) SCORE_COMM_3006,  
   MAX(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3006 THEN TR.B_DESCRIPTION ELSE NULL END) SCORE_RIF_3006,  
   MAX(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3112 THEN TR.B_DESCRIPTION ELSE NULL END) SCORE_RIF_3112,  
   MAX(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3006 THEN RV.COMMENTS ELSE NULL END) SCORE_DESC_3006,  
   MAX(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3112 THEN RV.COMMENTS ELSE NULL END) SCORE_DESC_3112,  
   MAX(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3006 THEN DR.OBJECT_INFO ELSE NULL END) SCORE_EMOTICON_3006,  
   MAX(CASE WHEN TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TR.A_TRANSACTION_DATE = @date3112 THEN DR.OBJECT_INFO ELSE NULL END) SCORE_EMOTICON_3112,
   MAX(CASE WHEN TR2.B_GL_FISCAL_TYPE_ID = 'TREND' AND TR2.A_TRANSACTION_DATE = @date3112 THEN TR2.B_AMOUNT ELSE NULL END) SCORE_DATO_TREND_3112,
   MAX(CASE WHEN TR2.B_GL_FISCAL_TYPE_ID = 'TREND' AND TR2.A_TRANSACTION_DATE = @date3112 THEN DR2.OBJECT_INFO ELSE NULL END) SCORE_EMOTICON_TREND_3112
FROM (
 SELECT
	V.M_SEQUENCE_ID AS SEQUENZA,
	V.G_INPUT_ENUM_ID AS TIPO_ODELLO,
	V.G_ACCOUNT_CODE AS CODICE_INDIC,
	V.G_ACCOUNT_NAME AS TITOLO_INDIC,
	V.G_DESCRIPTION AS DESCRIZIONE_INDIC,
	V.G_UOM_ABBREVIATION AS UOM_ETCH,
	V.M_UOM_DESCR AS TITOLO_MISURA,
	V.M_COMMENTS AS DESCRIZIONE_MISURA,
	V.G_DETAIL_ENUM_ID,
 	V.G_UOM_TYPE_ID AS TIPO_UOM,
	V.G_UOM_DECIMAL_SCALE AS SCALA_UOM,
	V.M_GL_ACCOUNT_ID AS GL_ACCOUNT_ID,
 	WET.UOM_RANGE_SCORE_ID,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menoquattro THEN V.TM_AMOUNT ELSE NULL END ) ACTUAL_DATO_3112_MENO_QUATTRO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menotre THEN V.TM_AMOUNT ELSE NULL END ) ACTUAL_DATO_3112_MENO_TRE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menodue THEN V.TM_AMOUNT ELSE NULL END ) ACTUAL_DATO_3112_MENO_DUE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menouno THEN V.TM_AMOUNT ELSE NULL END ) ACTUAL_DATO_3112_MENO_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3006 THEN V.TM_AMOUNT ELSE NULL END ) ACTUAL_DATO_3006,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3112 THEN V.TM_AMOUNT ELSE NULL END ) ACTUAL_DATO_3112,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menoquattro THEN V.R_UOM_CODE ELSE NULL END ) ACTUAL_COD_3112_MENO_QUATTRO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menotre THEN V.R_UOM_CODE ELSE NULL END ) ACTUAL_COD_3112_MENO_TRE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menodue THEN V.R_UOM_CODE ELSE NULL END ) ACTUAL_COD_3112_MENO_DUE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menouno THEN V.R_UOM_CODE ELSE NULL END ) ACTUAL_COD_3112_MENO_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3006 THEN V.R_UOM_CODE ELSE NULL END ) ACTUAL_COD_3006,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3112 THEN V.R_UOM_CODE ELSE NULL END ) ACTUAL_COD_3112,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3006 THEN V.TT_DESCRIPTION ELSE NULL END ) ACTUAL_COMM_3006,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3112 THEN V.TT_DESCRIPTION ELSE NULL END ) ACTUAL_COMM_3112,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @fineannosuccessivo THEN V.TT_DESCRIPTION ELSE NULL END ) ACTUAL_COMM_3112_PIU_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @finedueannisuccessivi THEN V.TT_DESCRIPTION ELSE NULL END ) ACTUAL_COMM_3112_PIU_DUE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3006 THEN V.TM_DESCRIPTION ELSE NULL END ) ACTUAL_RIF_3006,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3112 THEN V.TM_DESCRIPTION ELSE NULL END ) ACTUAL_RIF_3112,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @fineannosuccessivo THEN V.TM_DESCRIPTION ELSE NULL END ) ACTUAL_RIF_3112_PIU_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @finedueannisuccessivi THEN V.TM_DESCRIPTION ELSE NULL END ) ACTUAL_RIF_3112_PIU_DUE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menotre THEN V.R_UOM_CODE ELSE NULL END ) BUDGET_COD_3112_MENO_TRE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menodue THEN V.R_UOM_CODE ELSE NULL END ) BUDGET_COD_3112_MENO_DUE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menouno THEN V.R_UOM_CODE ELSE NULL END ) BUDGET_COD_3112_MENO_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3006 THEN V.R_UOM_CODE ELSE NULL END ) BUDGET_COD_3006,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3112 THEN V.R_UOM_CODE ELSE NULL END ) BUDGET_COD_3112,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @fineannosuccessivo THEN V.R_UOM_CODE ELSE NULL END ) BUDGET_COD_3112_PIU_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @finedueannisuccessivi THEN V.R_UOM_CODE ELSE NULL END ) BUDGET_COD_3112_PIU_DUE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menotre THEN V.TM_AMOUNT ELSE NULL END ) BUDGET_DATO_3112_MENO_TRE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menodue THEN V.TM_AMOUNT ELSE NULL END ) BUDGET_DATO_3112_MENO_DUE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menouno THEN V.TM_AMOUNT ELSE NULL END ) BUDGET_DATO_3112_MENO_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3006 THEN V.TM_AMOUNT ELSE NULL END ) BUDGET_DATO_3006,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3112 THEN V.TM_AMOUNT ELSE NULL END ) BUDGET_DATO_3112,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @fineannosuccessivo THEN V.TM_AMOUNT ELSE NULL END ) BUDGET_DATO_3112_PIU_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @finedueannisuccessivi THEN V.TM_AMOUNT ELSE NULL END ) BUDGET_DATO_3112_PIU_DUE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3006 THEN V.TT_DESCRIPTION ELSE NULL END ) BUDGET_COMM_3006,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3112 THEN V.TT_DESCRIPTION ELSE NULL END ) BUDGET_COMM_3112,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @fineannosuccessivo THEN V.TT_DESCRIPTION ELSE NULL END ) BUDGET_COMM_3112_PIU_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @finedueannisuccessivi THEN V.TT_DESCRIPTION ELSE NULL END ) BUDGET_COMM_3112_PIU_DUE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3006 THEN V.TM_DESCRIPTION ELSE NULL END ) BUDGET_RIF_3006,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3112 THEN V.TM_DESCRIPTION ELSE NULL END ) BUDGET_RIF_3112,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @fineannosuccessivo THEN V.TM_DESCRIPTION ELSE NULL END ) BUDGET_RIF_3112_PIU_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @finedueannisuccessivi THEN V.TM_DESCRIPTION ELSE NULL END ) BUDGET_RIF_3112_PIU_DUE, 
	
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menouno THEN V.TM_DESCRIPTION ELSE NULL END ) ACTUAL_RIF_3112_MENO_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menodue THEN V.TM_DESCRIPTION ELSE NULL END ) ACTUAL_RIF_3112_MENO_DUE, 
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menotre THEN V.TM_DESCRIPTION ELSE NULL END ) ACTUAL_RIF_3112_MENO_TRE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menoquattro THEN V.TM_DESCRIPTION ELSE NULL END ) ACTUAL_RIF_3112_MENO_QUATTRO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menouno THEN V.TT_DESCRIPTION ELSE NULL END ) ACTUAL_COMM_3112_MENO_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menodue THEN V.TT_DESCRIPTION ELSE NULL END ) ACTUAL_COMM_3112_MENO_DUE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menotre THEN V.TT_DESCRIPTION ELSE NULL END ) ACTUAL_COMM_3112_MENO_TRE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menoquattro THEN V.TT_DESCRIPTION ELSE NULL END ) ACTUAL_COMM_3112_MENO_QUATTRO
FROM
	WORK_EFFORT_TRANS_ALL_VIEW V
INNER JOIN WORK_EFFORT_TYPE WET ON WET.WORK_EFFORT_TYPE_ID = V.W_WORK_EFFORT_TYPE_ID
WHERE
	V.G_GL_ACCOUNT_TYPE_ID IN(
		'INDGEN',
		'INDRIS',
		'INDPEA'
	)
	AND V.G_ACCOUNT_CODE <> 'SCORE'
	AND V.M_WORK_EFFORT_ID = ?
	AND V.M_THRU_DATE >= @date0101
	AND V.M_FROM_DATE <= @date3112
GROUP BY
	V.M_SEQUENCE_ID,
	V.G_INPUT_ENUM_ID,
	V.G_ACCOUNT_CODE,
	V.M_WORK_EFFORT_MEASURE_ID,
	V.G_ACCOUNT_NAME,
	V.G_DESCRIPTION,
	V.G_UOM_ABBREVIATION,
	V.M_UOM_DESCR,
	V.M_COMMENTS,
	V.G_DETAIL_ENUM_ID,
 	V.G_UOM_TYPE_ID,
	V.G_UOM_DECIMAL_SCALE,
	V.M_GL_ACCOUNT_ID,
 	WET.UOM_RANGE_SCORE_ID
UNION
  SELECT
	V.M_SEQUENCE_ID AS SEQUENZA,
	V.G_INPUT_ENUM_ID AS TIPO_ODELLO,
	V.G_ACCOUNT_CODE AS CODICE_INDIC,
	V.G_ACCOUNT_NAME AS TITOLO_INDIC,
	V.G_DESCRIPTION AS DESCRIZIONE_INDIC,
	V.G_UOM_ABBREVIATION AS UOM_ETCH,
	V.M_UOM_DESCR AS TITOLO_MISURA,
	V.M_COMMENTS AS DESCRIZIONE_MISURA,
	V.G_DETAIL_ENUM_ID,
 	V.G_UOM_TYPE_ID AS TIPO_UOM,
	V.G_UOM_DECIMAL_SCALE AS SCALA_UOM,
    V.M_GL_ACCOUNT_ID AS GL_ACCOUNT_ID,
 	WET.UOM_RANGE_SCORE_ID,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menoquattro THEN V.TM_AMOUNT ELSE NULL END ) ACTUAL_DATO_3112_MENO_QUATTRO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menotre THEN V.TM_AMOUNT ELSE NULL END ) ACTUAL_DATO_3112_MENO_TRE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menodue THEN V.TM_AMOUNT ELSE NULL END ) ACTUAL_DATO_3112_MENO_DUE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menouno THEN V.TM_AMOUNT ELSE NULL END ) ACTUAL_DATO_3112_MENO_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3006 THEN V.TM_AMOUNT ELSE NULL END ) ACTUAL_DATO_3006,
	MAX( CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3112 THEN V.TM_AMOUNT ELSE NULL END ) ACTUAL_DATO_3112,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menoquattro THEN V.R_UOM_CODE ELSE NULL END ) ACTUAL_COD_3112_MENO_QUATTRO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menotre THEN V.R_UOM_CODE ELSE NULL END ) ACTUAL_COD_3112_MENO_TRE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menodue THEN V.R_UOM_CODE ELSE NULL END ) ACTUAL_COD_3112_MENO_DUE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menouno THEN V.R_UOM_CODE ELSE NULL END ) ACTUAL_COD_3112_MENO_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3006 THEN V.R_UOM_CODE ELSE NULL END ) ACTUAL_COD_3006,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3112 THEN V.R_UOM_CODE ELSE NULL END ) ACTUAL_COD_3112,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3006 THEN V.TT_DESCRIPTION ELSE NULL END ) ACTUAL_COMM_3006,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3112 THEN V.TT_DESCRIPTION ELSE NULL END ) ACTUAL_COMM_3112,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @fineannosuccessivo THEN V.TT_DESCRIPTION ELSE NULL END ) ACTUAL_COMM_3112_PIU_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @finedueannisuccessivi THEN V.TT_DESCRIPTION ELSE NULL END ) ACTUAL_COMM_3112_PIU_DUE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3006 THEN V.TM_DESCRIPTION ELSE NULL END ) ACTUAL_RIF_3006,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3112 THEN V.TM_DESCRIPTION ELSE NULL END ) ACTUAL_RIF_3112,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @fineannosuccessivo THEN V.TM_DESCRIPTION ELSE NULL END ) ACTUAL_RIF_3112_PIU_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @finedueannisuccessivi THEN V.TM_DESCRIPTION ELSE NULL END ) ACTUAL_RIF_3112_PIU_DUE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menotre THEN V.R_UOM_CODE ELSE NULL END ) BUDGET_COD_3112_MENO_TRE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menodue THEN V.R_UOM_CODE ELSE NULL END ) BUDGET_COD_3112_MENO_DUE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menouno THEN V.R_UOM_CODE ELSE NULL END ) BUDGET_COD_3112_MENO_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3006 THEN V.R_UOM_CODE ELSE NULL END ) BUDGET_COD_3006,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3112 THEN V.R_UOM_CODE ELSE NULL END ) BUDGET_COD_3112,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @fineannosuccessivo THEN V.R_UOM_CODE ELSE NULL END ) BUDGET_COD_3112_PIU_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @finedueannisuccessivi THEN V.R_UOM_CODE ELSE NULL END ) BUDGET_COD_3112_PIU_DUE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menotre THEN V.TM_AMOUNT ELSE NULL END ) BUDGET_DATO_3112_MENO_TRE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menodue THEN V.TM_AMOUNT ELSE NULL END ) BUDGET_DATO_3112_MENO_DUE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menouno THEN V.TM_AMOUNT ELSE NULL END ) BUDGET_DATO_3112_MENO_UNO,
	MAX( CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3006 THEN V.TM_AMOUNT ELSE NULL END ) BUDGET_DATO_3006,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3112 THEN V.TM_AMOUNT ELSE NULL END ) BUDGET_DATO_3112,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @fineannosuccessivo THEN V.TM_AMOUNT ELSE NULL END ) BUDGET_DATO_3112_PIU_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @finedueannisuccessivi THEN V.TM_AMOUNT ELSE NULL END ) BUDGET_DATO_3112_PIU_DUE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3006 THEN V.TT_DESCRIPTION ELSE NULL END ) BUDGET_COMM_3006,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3112 THEN V.TT_DESCRIPTION ELSE NULL END ) BUDGET_COMM_3112,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @fineannosuccessivo THEN V.TT_DESCRIPTION ELSE NULL END ) BUDGET_COMM_3112_PIU_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @finedueannisuccessivi THEN V.TT_DESCRIPTION ELSE NULL END ) BUDGET_COMM_3112_PIU_DUE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3006 THEN V.TM_DESCRIPTION ELSE NULL END ) BUDGET_RIF_3006,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date3112 THEN V.TM_DESCRIPTION ELSE NULL END ) BUDGET_RIF_3112,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @fineannosuccessivo THEN V.TM_DESCRIPTION ELSE NULL END ) BUDGET_RIF_3112_PIU_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @finedueannisuccessivi THEN V.TM_DESCRIPTION ELSE NULL END ) BUDGET_RIF_3112_PIU_DUE, 
	
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menouno THEN V.TM_DESCRIPTION ELSE NULL END ) ACTUAL_RIF_3112_MENO_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menodue THEN V.TM_DESCRIPTION ELSE NULL END ) ACTUAL_RIF_3112_MENO_DUE, 
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menotre THEN V.TM_DESCRIPTION ELSE NULL END ) ACTUAL_RIF_3112_MENO_TRE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menoquattro THEN V.TM_DESCRIPTION ELSE NULL END ) ACTUAL_RIF_3112_MENO_QUATTRO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menouno THEN V.TT_DESCRIPTION ELSE NULL END ) ACTUAL_COMM_3112_MENO_UNO,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menodue THEN V.TT_DESCRIPTION ELSE NULL END ) ACTUAL_COMM_3112_MENO_DUE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menotre THEN V.TT_DESCRIPTION ELSE NULL END ) ACTUAL_COMM_3112_MENO_TRE,
	MAX( CASE WHEN V.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = @date1231menoquattro THEN V.TT_DESCRIPTION ELSE NULL END ) ACTUAL_COMM_3112_MENO_QUATTRO
FROM
	WORK_EFFORT_TRANS_ALL_VIEW V    	
INNER JOIN WORK_EFFORT_TYPE WET ON WET.WORK_EFFORT_TYPE_ID = V.W_WORK_EFFORT_TYPE_ID
INNER JOIN WORK_EFFORT_ASSOC OOSO 
  ON  OOSO.WORK_EFFORT_ID_TO = V.M_WORK_EFFORT_ID  
  AND OOSO.WORK_EFFORT_ASSOC_TYPE_ID = '20D6O'  
WHERE
	V.G_GL_ACCOUNT_TYPE_ID IN(
		'INDGEN',
		'INDRIS',
		'INDPEA'
	)
	AND V.G_ACCOUNT_CODE <> 'SCORE' 
	AND OOSO.WORK_EFFORT_ID_FROM = ? 	
	AND V.M_THRU_DATE >= @date0101
	AND V.M_FROM_DATE <= @date3112
GROUP BY
	V.M_SEQUENCE_ID,
	V.G_INPUT_ENUM_ID,
	V.G_ACCOUNT_CODE,
	V.M_WORK_EFFORT_MEASURE_ID,
	V.G_ACCOUNT_NAME,
	V.G_DESCRIPTION,
	V.G_UOM_ABBREVIATION,
	V.M_UOM_DESCR,
	V.M_COMMENTS,
	V.G_DETAIL_ENUM_ID,
 	V.G_UOM_TYPE_ID,
	V.G_UOM_DECIMAL_SCALE,
	V.M_GL_ACCOUNT_ID,
 	WET.UOM_RANGE_SCORE_ID
) N_Q
LEFT JOIN WORK_EFFORT_MEASURE   M 
  ON   M.GL_ACCOUNT_ID = N_Q.GL_ACCOUNT_ID
  AND  M.WORK_EFFORT_ID = ?
LEFT JOIN ACCTG_TRANS_VIEW TR 
  ON TR.B_VOUCHER_REF = M.WORK_EFFORT_MEASURE_ID  
  AND TR.B_GL_ACCOUNT_ID ='SCOREKPI'
  AND  (TR.A_TRANSACTION_DATE = @date3006  OR 
         TR.A_TRANSACTION_DATE   = @date3112 )
  AND  TR.B_GL_FISCAL_TYPE_ID   = 'ACTUAL' 
LEFT JOIN UOM_RANGE_VALUES RV ON TR.B_AMOUNT IS NOT NULL
  AND  RV.UOM_RANGE_ID = N_Q.UOM_RANGE_SCORE_ID
  AND  RV.FROM_VALUE <= TR.B_AMOUNT AND RV.THRU_VALUE >= TR.B_AMOUNT
LEFT JOIN CONTENT CO ON RV.ICON_CONTENT_ID IS NOT NULL
  AND  CO.CONTENT_ID = RV.ICON_CONTENT_ID
LEFT JOIN DATA_RESOURCE DR ON CO.DATA_RESOURCE_ID IS NOT NULL
  AND DR.DATA_RESOURCE_ID = CO.DATA_RESOURCE_ID
LEFT JOIN ACCTG_TRANS_VIEW TR2 ON TR2.B_GL_ACCOUNT_ID ='SCOREKPI'
  AND TR2.B_VOUCHER_REF = M.WORK_EFFORT_MEASURE_ID
  AND  (TR2.A_TRANSACTION_DATE = @date3006  OR 
         TR2.A_TRANSACTION_DATE   = @date3112 )
  AND TR2.B_GL_FISCAL_TYPE_ID = 'TREND'
LEFT JOIN UOM_RANGE_VALUES RV2 ON TR2.B_AMOUNT IS NOT NULL
  AND RV2.UOM_RANGE_ID = N_Q.UOM_RANGE_SCORE_ID
  AND RV2.FROM_VALUE <= TR2.B_AMOUNT AND RV2.THRU_VALUE >= TR2.B_AMOUNT
LEFT JOIN CONTENT CO2 ON RV2.ICON_CONTENT_ID IS NOT NULL
  AND CO2.CONTENT_ID = RV2.ICON_CONTENT_ID
LEFT JOIN DATA_RESOURCE DR2 ON CO2.DATA_RESOURCE_ID IS NOT NULL
  AND DR2.DATA_RESOURCE_ID = CO2.DATA_RESOURCE_ID  
GROUP BY 
  N_Q.SEQUENZA,
  N_Q.GL_ACCOUNT_ID,
  N_Q.TIPO_ODELLO,
  N_Q.CODICE_INDIC,
  N_Q.TITOLO_INDIC,
  N_Q.DESCRIZIONE_INDIC,
  N_Q.UOM_ETCH,
  N_Q.TITOLO_MISURA,
  N_Q.DESCRIZIONE_MISURA,
  N_Q.G_DETAIL_ENUM_ID,
  N_Q.TIPO_UOM,
  N_Q.SCALA_UOM,
  N_Q.ACTUAL_DATO_3112_MENO_QUATTRO,
  N_Q.ACTUAL_DATO_3112_MENO_TRE,
  N_Q.ACTUAL_DATO_3112_MENO_DUE,
  N_Q.ACTUAL_DATO_3112_MENO_UNO,
  N_Q.ACTUAL_DATO_3006,
  N_Q.ACTUAL_DATO_3112,
  N_Q.ACTUAL_COD_3112_MENO_QUATTRO,
  N_Q.ACTUAL_COD_3112_MENO_TRE,
  N_Q.ACTUAL_COD_3112_MENO_DUE,
  N_Q.ACTUAL_COD_3112_MENO_UNO,
  N_Q.ACTUAL_COD_3006,
  N_Q.ACTUAL_COD_3112,
  N_Q.ACTUAL_COMM_3006,
  N_Q.ACTUAL_COMM_3112,
  N_Q.ACTUAL_COMM_3112_PIU_UNO,
  N_Q.ACTUAL_COMM_3112_PIU_DUE,
  N_Q.ACTUAL_RIF_3006,
  N_Q.ACTUAL_RIF_3112,
  N_Q.ACTUAL_RIF_3112_PIU_UNO,
  N_Q.ACTUAL_RIF_3112_PIU_DUE,
  N_Q.BUDGET_COD_3112_MENO_TRE,
  N_Q.BUDGET_COD_3112_MENO_DUE,
  N_Q.BUDGET_COD_3112_MENO_UNO,
  N_Q.BUDGET_COD_3006,
  N_Q.BUDGET_COD_3112,
  N_Q.BUDGET_COD_3112_PIU_UNO,
  N_Q.BUDGET_DATO_3112_MENO_TRE,
  N_Q.BUDGET_DATO_3112_MENO_DUE,
  N_Q.BUDGET_DATO_3112_MENO_UNO,
  N_Q.BUDGET_DATO_3006,
  N_Q.BUDGET_DATO_3112,
  N_Q.BUDGET_DATO_3112_PIU_UNO,
  N_Q.BUDGET_DATO_3112_PIU_DUE,
  N_Q.BUDGET_COMM_3006,
  N_Q.BUDGET_COMM_3112_PIU_UNO,
  N_Q.BUDGET_COMM_3112_PIU_DUE,
  N_Q.BUDGET_RIF_3006,
  N_Q.BUDGET_RIF_3112,
  N_Q.BUDGET_RIF_3112_PIU_UNO,
  N_Q.BUDGET_RIF_3112_PIU_DUE, 
  N_Q.ACTUAL_RIF_3112_MENO_UNO,
  N_Q.ACTUAL_RIF_3112_MENO_DUE, 
  N_Q.ACTUAL_RIF_3112_MENO_TRE,
  N_Q.ACTUAL_RIF_3112_MENO_QUATTRO,
  N_Q.ACTUAL_COMM_3112_MENO_UNO,
  N_Q.ACTUAL_COMM_3112_MENO_DUE,
  N_Q.ACTUAL_COMM_3112_MENO_TRE,
  N_Q.ACTUAL_COMM_3112_MENO_QUATTRO 
       ]]></xml-property>
