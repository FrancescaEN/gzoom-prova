this.queryText = this.queryText.replace("@finedueannisuccessivi",  params["date3112+2Sql"].value );				
this.queryText = this.queryText.replace("@date1231menouno",  params["date1231-1Sql"].value );
this.queryText = this.queryText.replace("@date1231menodue",  params["date1231-2Sql"].value );
