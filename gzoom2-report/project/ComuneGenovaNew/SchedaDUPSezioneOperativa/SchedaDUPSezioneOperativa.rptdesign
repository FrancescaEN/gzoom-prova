            <xml-property name="queryText"><![CDATA[SELECT 
	description as tipo_riferimento,
	max(case when riferimento = '1' then ri.ETCH else null end) as codice_riferimento_1,
	max(case when riferimento = '1' then ri.WORK_EFFORT_NAME else null end) as titolo_riferimento_1,
	max(case when riferimento = '1' then riferimento else null end) as id_riferimento_1,
	max(case when riferimento = '1' then ri.LOCATION_DESC else null end) as colore_riferimento_1,
	max(case when riferimento = '2' then ri.ETCH else null end) as codice_riferimento_2,
	max(case when riferimento = '2' then ri.WORK_EFFORT_NAME else null end) as titolo_riferimento_2,
	max(case when riferimento = '2' then riferimento else null end) as id_riferimento_2,
	max(case when riferimento = '2' then ri.LOCATION_DESC else null end) as colore_riferimento_2,
	max(case when riferimento = '3' then ri.ETCH else null end) as codice_riferimento_3,
	max(case when riferimento = '3' then ri.WORK_EFFORT_NAME else null end) as titolo_riferimento_3,
	max(case when riferimento = '3' then riferimento else null end) as id_riferimento_3,
	max(case when riferimento = '3' then ri.LOCATION_DESC else null end) as colore_riferimento_3,
	max(case when riferimento = '4' then ri.ETCH else null end) as codice_riferimento_4,
	max(case when riferimento = '4' then ri.WORK_EFFORT_NAME else null end) as titolo_riferimento_4,
	max(case when riferimento = '4' then riferimento else null end) as id_riferimento_4,
	max(case when riferimento = '4' then ri.LOCATION_DESC else null end) as colore_riferimento_4,
	max(case when riferimento = '5' then ri.ETCH else null end) as codice_riferimento_5,
	max(case when riferimento = '5' then ri.WORK_EFFORT_NAME else null end) as titolo_riferimento_5,
	max(case when riferimento = '5' then riferimento else null end) as id_riferimento_5,
	max(case when riferimento = '5' then ri.LOCATION_DESC else null end) as colore_riferimento_5,
	max(case when riferimento = '6' then ri.ETCH else null end) as codice_riferimento_6,
	max(case when riferimento = '6' then ri.WORK_EFFORT_NAME else null end) as titolo_riferimento_6,
	max(case when riferimento = '6' then riferimento else null end) as id_riferimento_6,
	max(case when riferimento = '6' then ri.LOCATION_DESC else null end) as colore_riferimento_6,
	max(case when riferimento = '7' then ri.ETCH else null end) as codice_riferimento_7,
	max(case when riferimento = '7' then ri.WORK_EFFORT_NAME else null end) as titolo_riferimento_7,
	max(case when riferimento = '7' then riferimento else null end) as id_riferimento_7,
	max(case when riferimento = '7' then ri.LOCATION_DESC else null end) as colore_riferimento_7,
	max(case when riferimento = '8' then ri.ETCH else null end) as codice_riferimento_8,
	max(case when riferimento = '8' then ri.WORK_EFFORT_NAME else null end) as titolo_riferimento_8,
	max(case when riferimento = '8' then riferimento else null end) as id_riferimento_8,
	max(case when riferimento = '8' then ri.LOCATION_DESC else null end) as colore_riferimento_8,
	max(case when riferimento = '9' then ri.ETCH else null end) as codice_riferimento_9,
	max(case when riferimento = '9' then ri.WORK_EFFORT_NAME else null end) as titolo_riferimento_9,
	max(case when riferimento = '9' then riferimento else null end) as id_riferimento_9,
	max(case when riferimento = '9' then ri.LOCATION_DESC else null end) as colore_riferimento_9,
	max(case when riferimento = '10' then ri.ETCH else null end) as codice_riferimento_10,
	max(case when riferimento = '10' then ri.WORK_EFFORT_NAME else null end) as titolo_riferimento_10,
	max(case when riferimento = '10' then riferimento else null end) as id_riferimento_10,
	max(case when riferimento = '10' then ri.LOCATION_DESC else null end) as colore_riferimento_10
   FROM
 (select  rit.description, R.WORK_EFFORT_ID , R.ETCH , R.WORK_EFFORT_NAME  , R.LOCATION_DESC,  ROW_NUMBER() over(order by SOURCE_reference_id )  riferimento  
from work_effort_assoc riop
join work_effort r        on r.work_effort_id        = riop.work_effort_id_from
join work_effort_type rit on rit.work_effort_type_id = r.work_effort_type_id
where
       riop.work_effort_id_to = ? -- main.identificativo_obipeg
       and riop.work_effort_assoc_type_id like '20R%'
       and riop.from_date <= @monitoringDate    -- input.ref_date
       and riop.thru_date >= @monitoringDate    -- input.ref_date 
       and r.work_effort_type_id =  '20R52OBS'
group by  rit.description, R.WORK_EFFORT_ID , R.ETCH , R.WORK_EFFORT_NAME , R.LOCATION_DESC  , R.SOURCE_REFERENCE_ID

 ) RI
group by
	description   

;
]]></xml-property>
        </oda-data-set>
    </data-sets>
