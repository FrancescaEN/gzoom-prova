            <xml-property name="queryText"><![CDATA[select t310.note_info as valutazione_attivita
from work_effort_note n310 
join note_data t310 on
	n310.note_id is not null
	and t310.note_id = n310.note_id
	and t310.note_date_time = @monitoringDate
where n310.work_effort_id = ?
	and n310.sequence_id = 310]]></xml-property>
