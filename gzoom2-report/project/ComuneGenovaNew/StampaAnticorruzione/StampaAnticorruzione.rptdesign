                                                            <expression name="valueExpr">if ((row["TIPO_ODELLO"] != null) &amp;&amp; (row["TIPO_ODELLO"] != '') &amp;&amp; (row["TIPO_ODELLO"] == 'ACCINP_UO')){&#13;
	row["CODICE_INDIC"] + " - " + row["TITOLO_INDIC"];&#13;
} else if ((row["TITOLO_MISURA"] != null) &amp;&amp; (row["TITOLO_MISURA"] != '')){&#13;
		row["TITOLO_MISURA"];&#13;
} else{&#13;
		row["TITOLO_INDIC"];&#13;
}</expression>
