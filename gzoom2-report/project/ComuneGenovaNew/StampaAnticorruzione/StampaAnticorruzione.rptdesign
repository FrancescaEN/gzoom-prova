            <method name="beforeOpen"><![CDATA[/*
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value );

this.queryText = this.queryText.replace("@date0101",  "'2020-01-01 00:00:00.000'" );
*/
//ReportLog.info("riferimenti  "+this.queryText);]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">att_codice</property>
                    <property name="nativeName">att_codice</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">att_descr</property>
                    <property name="nativeName">att_descr</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">att_rischi</property>
                    <property name="nativeName">att_rischi</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">att_misure</property>
                    <property name="nativeName">att_misure</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select 
att.etch as att_codice, att.work_effort_name as att_descr,  
t210.note_info as att_rischi, t220.note_info as att_misure
from work_effort_assoc priatt
inner join work_effort att on att.work_effort_id = priatt.work_effort_id_to
left join work_effort_note n210 on n210.work_effort_id = att.work_effort_id
  and n210.sequence_id = 210
left join note_data t210 on n210.note_id is not null
  and t210.note_id = n210.note_id -- and t210.note_date_time = @date0101 -- 'AAAA(input.ref_date)-01-01'
left join work_effort_note n220 on n220.work_effort_id = att.work_effort_id
  and n220.sequence_id = 220
left join note_data t220 on n220.note_id is not null
  and t220.note_id = n220.note_id -- and t220.note_date_time = @date0101 -- 'AAAA(input.ref_date)-01-01'
where priatt.work_effort_id_from = ? -- identificativo_prifas
 and priatt.work_effort_assoc_type_id = '20A6'
order by att.source_reference_id
]]></xml-property>
