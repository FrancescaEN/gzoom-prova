            <xml-property name="queryText"><![CDATA[select 
radorg.sequence_num as ordinamento_1,
uopric.parent_role_code as ordinamento_2, 
uopric.parent_role_code as codice_dir_resp, uopri.external_id as codso4_dir_resp, 
ari.etch as codice_area, ari.work_effort_name as titolo_area,
uopri.vat_code as codcdr_dir_resp, uopri.party_name as titolo_direzione_responsabile,
res.party_name as denominazione_responsabile_tecnico,
pri.etch as codice_profas, pri.work_effort_name as titolo_profas,  
ae.amount as rischio_valore, mon.comments as rischio_descrizione, drm.object_info as rischio_emoticon,
t210.note_info as pro_rischi, t220.note_info as pro_misure,

t230.note_info as pro_comportamenti,

t310.note_info as mon_primo, t320.note_info as mon_secondo,
pri.work_effort_id as identificativo_prifas
from work_effort ppc
inner join work_effort_type ppct on ppct.work_effort_type_id = ppc.work_effort_type_id
inner join work_effort_assoc ppcari on ppcari.work_effort_id_from = ppc.work_effort_id
 and ppcari.work_effort_assoc_type_id = '20A4'
inner join work_effort ari on ari.work_effort_id = ppcari.work_effort_id_to
inner join work_effort_assoc aripri on aripri.work_effort_id_from = ari.work_effort_id
 and aripri.work_effort_assoc_type_id = '20A4C'
inner join work_effort pri on pri.work_effort_id = aripri.work_effort_id_to
inner join work_effort_type prit on prit.work_effort_type_id = pri.work_effort_type_id
inner join party uopri on uopri.party_id = pri.org_unit_id
inner join party_parent_role uopric on uopric.party_id = uopri.party_id
  and uopric.role_type_id = 'ORGANIZATION_UNIT'
inner join party_group uoprig on uoprig.party_id = uopri.party_id
left join party_relationship prires on prires.party_id_from = uopri.party_id
  and prires.party_relationship_type_id = 'ORG_RESPONSIBLE'
  and prires.from_date <= pri.estimated_completion_date and prires.from_date <= @monitoringDate-- input.ref_date
  and (prires.thru_date is null or (prires.thru_date >= pri.estimated_start_date and prires.thru_date >= @monitoringDate)) -- input.ref_date
left join party res on prires.party_id_to is not null
 and res.party_id = prires.party_id_to
inner join work_effort_assoc orgpri on orgpri.work_effort_id_to = pri.work_effort_id
 and orgpri.work_effort_assoc_type_id in ('20P2DC', '20P2SC')
inner join work_effort FIL_W on FIL_W.work_Effort_id = pri.WORK_EFFORT_ID
inner join work_effort org on org.work_effort_id = orgpri.work_effort_id_from
inner join work_effort_assoc radorg on radorg.work_effort_id_to = org.work_effort_id
 and radorg.work_effort_assoc_type_id = '20P2'
inner join work_effort rad on rad.work_effort_id = radorg.work_effort_id_from
inner join work_effort_measure prim on prim.work_effort_id = pri.work_effort_id
inner join gl_account pria on pria.gl_account_id = prim.gl_account_id
  and pria.account_code = 'PARRIS.99'
    
  @filterInnerJoin
  @filterLeftJoin	
  
left join acctg_trans at on prim.work_effort_measure_id is not null
  and pria.gl_account_id is not null
  and at.voucher_ref = prim.work_effort_measure_id
  and (at.transaction_date is null or at.transaction_date = @fineAnnoPrec) -- 'input.ref_date se input_ref_date = AAAA-12-31
--  and (at.transaction_date is null or at.transaction_date = '2020-12-31') -- '(AAAA(input.ref_date)-1)-12-31' se input_ref_date <> AAAA-12-31
left join acctg_trans_entry ae on at.acctg_trans_id is not null
  and ae.acctg_trans_id = at.acctg_trans_id
left join uom_range_values mon on ae.amount is not null
  and mon.uom_range_id = prit.uom_range_score_id
  and mon.range_values_factor = ae.amount
left join content com on mon.icon_content_id is not null
  and com.content_id = mon.icon_content_id
left join data_resource drm on com.data_resource_id is not null
  and drm.data_resource_id = com.data_resource_id
left join work_effort_note n210 on n210.work_effort_id = pri.work_effort_id
  and n210.sequence_id = 210
left join note_data t210 on n210.note_id is not null
  and t210.note_id = n210.note_id -- and t210.note_date_time = @date0101 -- 'AAAA(input.ref_date)-01-01'
left join work_effort_note n220 on n220.work_effort_id = pri.work_effort_id
  and n220.sequence_id = 220

left join work_effort_note n230 on n230.work_effort_id = pri.work_effort_id
  and n230.sequence_id = 230
left join note_data t230 on n230.note_id is not null
  and t230.note_id = n230.note_id 
  
left join note_data t220 on n220.note_id is not null
  and t220.note_id = n220.note_id -- and t220.note_date_time = @date0101 -- 'AAAA(input.ref_date)-01-01'
 
left join work_effort_note_view t310 on t310.note_id is not null
  and t310.work_effort_id = pri.work_effort_id and t310.sequence_id = 310
  and t310.note_date_time = @date3112
left join work_effort_note_view t320 on t320.note_id is not null
  and t320.work_effort_id = pri.work_effort_id and t320.sequence_id = 320
  and t320.note_date_time = @date3112  
  
where ari.estimated_start_date <= @date3112      -- 'AAAA(input.ref_date)-12-31'
  and ari.estimated_completion_date >= @date0101 -- 'AAAA(input.ref_date)-01-01'
  and pri.estimated_start_date <= @date3112      -- 'AAAA(input.ref_date)-12-31'
  and pri.estimated_completion_date >= @date0101 -- 'AAAA(input.ref_date)-01-01'
  @workEffortId
  @orgUnitId
-- and uopri.party_id = '10113'   -- input.uorg_uni_id (se valorizzato)
@personId
--  and res.party_id is not null and res.party_id = 'admin' -- input.resp_party_id (se valorizzato)
@revision
-- and pri.work_effort_revision_id is null -- se input.work_effort_revision_id is null
-- and orgpri.work_effort_revision_id is null -- se input.work_effort_revision_id is null
-- and pri.work_effort_revision_id = input.work_effort_revision_id -- se input.work_effort_revision_id è valorizzato
-- and orgpri.work_effort_revision_id = input.work_effort_revision_id -- se input.work_effort_revision_id è valorizzato
@score
-- and ae.amount is not null and ae.amount = 0 -- se input.livello_rischio = alto
-- and ae.amount is not null and aem.amount <> 100 -- se input.livello_rischio = alto e medio
-- and ae.amount is null  -- se input.livello_rischio = non_monitorato
@codiceObpeg
-- and pri.source_reference_id like '%ABCDE%'  -- se input.source_reference_id valorizzato
@workEffortEtch
-- and pri.etch like '%ABCDE%'  -- se input.etch valorizzato
@workEffortName
-- and pri.work_effort_name like '%ABCDE%'  -- se input.work_effort_name valorizzato
@filterWhere
order by ordinamento_1, ordinamento_2
]]></xml-property>
            <xml-property name="designerValues"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
