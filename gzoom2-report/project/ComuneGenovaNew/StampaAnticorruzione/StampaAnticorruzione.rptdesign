	row["CODICE_INDIC"] + " - " + row["TITOLO_INDIC"];&#13;
} else if ((row["TITOLO_MISURA"] != null) &amp;&amp; (row["TITOLO_MISURA"] != '')){&#13;
		row["TITOLO_MISURA"];&#13;
} else{&#13;
