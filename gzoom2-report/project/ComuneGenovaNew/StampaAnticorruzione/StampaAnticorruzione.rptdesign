	if (row["TIPO_UOM"] == 'RATING_SCALE'){&#13;
		row["ACTUAL_COD_3112"];&#13;
	} else if (row["TIPO_UOM"] == 'DATE_MEASURE'){&#13;
		UtilDateTime.numberConvertToDate(row["ACTUAL_DATO_3112"], reportContext.getLocale());&#13;
	} else{&#13;
		row["ACTUAL_DATO_3112"]!= null ? UtilNumber.getValueFormatted(row["ACTUAL_DATO_3112"], row["FORMAT"]) : '';&#13;
	}&#13;
}</expression>
