                                                <header>
                                                    <row id="62044">
                                                        <method name="onCreate"><![CDATA[importPackage(Packages.org.ofbiz.base.util);

//adesso so il numero di pagina corretto vado a settare dentro il vettore il numero della pagina

var mapRealPageNumber = reportContext.getPersistentGlobalVariable("mapRealPageNumber");


var key = this.getRowData().getColumnValue("CodiceMissione")+"_"+this.getRowData().getColumnValue("CodiceProgramma");
var element = mapRealPageNumber.get(key);	
if (element == null) {	
	var NPage = reportContext.getGlobalVariable("nPagina");
	mapRealPageNumber.put(key, NPage);
	reportContext.setPersistentGlobalVariable("mapRealPageNumber", mapRealPageNumber);
}
]]></method>
