                                            <property name="textAlign">right</property>
                                            <method name="onRender"><![CDATA[importPackage(Packages.org.ofbiz.base.util);

//adesso devo settare il valore corretto

var mapRealPageNumber = reportContext.getPersistentGlobalVariable("mapRealPageNumber");
	
var key = this.getRowData().getColumnValue("CodiceMissione");
var element = mapRealPageNumber.get(key);	
if (element != null) {	
