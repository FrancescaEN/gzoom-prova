            <method name="beforeOpen"><![CDATA[/**/
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value );
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );	
this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );

/*
this.queryText = this.queryText.replace("@date0101",  "'2021-01-01'" );
this.queryText = this.queryText.replace("@date3112",  "'2021-12-31'" );
this.queryText = this.queryText.replace("@monitoringDate",  "'2021-12-31'" );   
*/
//ReportLog.info("... ObStratMissioneDS: "+this.queryText);]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">CodiceMissione</property>
                    <property name="nativeName">CodiceMissione</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">TitoloMissione</property>
                    <property name="nativeName">TitoloMissione</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">CodiceLineaMandato</property>
                    <property name="nativeName">CodiceLineaMandato</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">TitoloLineaMandato</property>
                    <property name="nativeName">TitoloLineaMandato</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">CodiceObeittivoStrategico</property>
                    <property name="nativeName">CodiceObeittivoStrategico</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">TitoloObiettivoStrategico</property>
                    <property name="nativeName">TitoloObiettivoStrategico</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">descrizioneObiettivoStrategico</property>
                    <property name="nativeName">descrizioneObiettivoStrategico</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT
       MI.ETCH AS "CodiceMissione",
       MI.work_effort_name AS "TitoloMissione",
        ST.etch AS "CodiceLineaMandato",
        ST.work_effort_name AS "TitoloLineaMandato", 
        obs.etch AS "CodiceObeittivoStrategico",
        obs.work_effort_name AS "TitoloObiettivoStrategico", 
       cast( ns.note_info AS char(3000))  AS "descrizioneObiettivoStrategico" 
FROM WORK_EFFORT OBS
-- paca 13-11-2025 - inizo
JOIN WORK_EFFORT_ASSOC AAOS  
    ON  AAOS.WORK_EFFORT_ID_FROM = OBS.WORK_EFFORT_ID
    AND AAOS.WORK_EFFORT_ASSOC_TYPE_ID = '20D6C'
    AND AAOS.FROM_DATE <= @monitoringDate   -- DATA DI LANCIO
    AND AAOS.THRU_DATE >= @monitoringDate   -- DATA DI LANCIO
JOIN WORK_EFFORT OBO    
    ON  OBO.WORK_EFFORT_ID = AAOS.WORK_EFFORT_ID_TO
    AND OBO.ESTIMATED_START_DATE      <= @date3112   -- 2023 ANNO DELLA DATA DI LANCIO
    AND OBO.ESTIMATED_COMPLETION_DATE >= @date0101   -- 2023 ANNO DELLA DATA DI LANCIO
    AND OBO.WORK_EFFORT_TYPE_ID = '20D66OOP'  
    AND OBO.WORK_EFFORT_REVISION_ID IS NULL
-- paca 13-11-2025 fine
JOIN   WORK_EFFORT_ASSOC AAST
    ON  AAST.WORK_EFFORT_ID_TO = OBS.WORK_EFFORT_ID
    AND AAST.WORK_EFFORT_ASSOC_TYPE_ID = '20D6'
    AND AAST.FROM_DATE <= @monitoringDate     -- DATA DI LANCIO
    AND AAST.THRU_DATE >= @monitoringDate     -- DATA DI LANCIO
JOIN WORK_EFFORT ST
   ON   ST.WORK_EFFORT_ID = AAST.WORK_EFFORT_ID_FROM
    AND ST.ESTIMATED_START_DATE      <= @date3112   -- 2023 ANNO DELLA DATA DI LANCIO
    AND ST.ESTIMATED_COMPLETION_DATE >= @date0101   -- 2023 ANNO DELLA DATA DI LANCIO
    AND ST.WORK_EFFORT_TYPE_ID = '20D62LIN'
    AND ST.WORK_EFFORT_REVISION_ID IS NULL        
JOIN WORK_EFFORT_ASSOC AAPR
--     INIZIO PACA 13-11-2025
--     ON AAPR.WORK_EFFORT_ID_TO = OBS.WORK_EFFORT_ID    
--    AND AAPR.WORK_EFFORT_ASSOC_TYPE_ID = '23PROB'
       ON AAPR.WORK_EFFORT_ID_TO = OBO.WORK_EFFORT_ID
      AND AAPR.WORK_EFFORT_ASSOC_TYPE_ID = '20D2C'
--    FINE PACA 13-11-2025 fine
    AND AAPR.FROM_DATE <= @monitoringDate     -- DATA DI LANCIO
    AND AAPR.THRU_DATE >= @monitoringDate     -- DATA DI LANCIO
JOIN WORK_EFFORT PR
    ON  PR.WORK_EFFORT_ID = AAPR.WORK_EFFORT_ID_FROM
    AND PR.ESTIMATED_START_DATE      <= @date3112   -- 2023 ANNO DELLA DATA DI LANCIO
    AND PR.ESTIMATED_COMPLETION_DATE >= @date0101   -- 2023 ANNO DELLA DATA DI LANCIO
    AND PR.WORK_EFFORT_TYPE_ID = '20D24PRO'  
    AND PR.WORK_EFFORT_REVISION_ID IS NULL    
JOIN WORK_EFFORT_ASSOC AAMI
     ON AAMI.WORK_EFFORT_ID_TO = PR.WORK_EFFORT_ID
    AND AAMI.WORK_EFFORT_ASSOC_TYPE_ID = '20D2'
    AND AAMI.FROM_DATE <= @monitoringDate     -- DATA DI LANCIO
    AND AAMI.THRU_DATE >= @monitoringDate     -- DATA DI LANCIO
JOIN WORK_EFFORT MI
   ON   MI.WORK_EFFORT_ID = AAMI.WORK_EFFORT_ID_FROM
    AND MI.ESTIMATED_START_DATE      <= @date3112   -- 2023 ANNO DELLA DATA DI LANCIO
    AND MI.ESTIMATED_COMPLETION_DATE >= @date0101   -- 2023 ANNO DELLA DATA DI LANCIO
    AND MI.WORK_EFFORT_TYPE_ID = '20D22MIS'  
    AND MI.WORK_EFFORT_REVISION_ID IS NULL    
LEFT JOIN WORK_EFFORT_NOTE_VIEW NS 
ON  NS.WORK_EFFORT_ID = OBS.WORK_EFFORT_ID
AND NS.NOTE_NAME = 'Descrizione'
WHERE  OBS.WORK_EFFORT_TYPE_ID  = '20D64OST'    
AND    OBS.WORK_EFFORT_REVISION_ID IS NULL 
AND    MI.ETCH = ?
AND    OBS.ESTIMATED_START_DATE      <= @date3112   -- 2023 ANNO DELLA DATA DI LANCIO
AND    OBS.ESTIMATED_COMPLETION_DATE >= @date0101   -- 2023 ANNO DELLA DATA DI LANCIO
group by MI.ETCH ,
       MI.work_effort_name,MI.work_effort_name,
        ST.etch ,
        ST.work_effort_name , 
        obs.etch ,
        obs.work_effort_name , 
         cast( ns.note_info as  char(3000))
    order by 
MI.ETCH,
          st.etch,
          obs.etch
          ;
          ]]></xml-property>
