                                                                                <text-data id="62600">
                                                                                    <property name="fontSize">7pt</property>
                                                                                    <property name="textAlign">left</property>
                                                                                    <expression name="valueExpr" type="javascript">var titolo = BirtStr.toUpper(BirtStr.trim(row["TitoloObiettivoOperativo"]));&#13;
var descr  = BirtStr.trim(row["descrizioneObiettivoOperativo"]);&#13;
&#13;
titolo = titolo != null ? titolo : "";&#13;
descr  = descr != null ? descr : "";&#13;
&#13;
// Per HTML: a capo con &lt;br/>&#13;
(titolo != "" &amp;&amp; descr != "")&#13;
    ? titolo + "&lt;br/>" + descr&#13;
    : (titolo != "" ? titolo : descr);</expression>
                                                                                    <property name="contentType">html</property>
                                                                                </text-data>
                                                                            </cell>
                                                                        </row>
                                                                    </header>
                                                                </group>
                                                            </table>
                                                        </cell>
