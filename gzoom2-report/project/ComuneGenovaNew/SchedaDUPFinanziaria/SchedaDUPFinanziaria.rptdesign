                    <property name="position">6</property>
                    <property name="name">conto_capitale</property>
                    <property name="nativeName">conto_capitale</property>
                    <property name="dataType">float</property>
                    <property name="nativeDataType">8</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">spese_correnti_p1</property>
                    <property name="nativeName">spese_correnti_p1</property>
                    <property name="dataType">float</property>
                    <property name="nativeDataType">8</property>
                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">conto_capitale_p1</property>
                    <property name="nativeName">conto_capitale_p1</property>
                    <property name="dataType">float</property>
                    <property name="nativeDataType">8</property>
                </structure>
                <structure>
                    <property name="position">9</property>
                    <property name="name">spese_correnti_p2</property>
                    <property name="nativeName">spese_correnti_p2</property>
                    <property name="dataType">float</property>
                    <property name="nativeDataType">8</property>
                </structure>
                <structure>
                    <property name="position">10</property>
                    <property name="name">conto_capitale_p2</property>
                    <property name="nativeName">conto_capitale_p2</property>
                    <property name="dataType">float</property>
                    <property name="nativeDataType">8</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT
    MISSIONE.ETCH AS "CodiceMissione",
    MISSIONE.WORK_EFFORT_NAME  AS "DescrizioneMissione", 
    PROG.ETCH AS "CodiceProgramma",
    PROG.WORK_EFFORT_NAME  AS "DescrizioneProgramma",     
    -- Somme Stanziato con etichette dinamiche
    SUM((RISFIN.STSPAA * WEA2.ASSOC_WEIGHT) / 100) AS "spese_correnti",
    SUM((RISFIN.STCOAA * WEA2.ASSOC_WEIGHT) / 100) AS "conto_capitale",
    SUM((RISFIN.STSPAA1 * WEA2.ASSOC_WEIGHT) / 100) AS "spese_correnti_p1",
    SUM((RISFIN.STCOAA1 * WEA2.ASSOC_WEIGHT) / 100) AS "conto_capitale_p1",
    SUM((RISFIN.STSPAA2 * WEA2.ASSOC_WEIGHT) / 100) AS "spese_correnti_p2",
    SUM((RISFIN.STCOAA2 * WEA2.ASSOC_WEIGHT) / 100) AS "conto_capitale_p2" 
FROM WORK_EFFORT MISSIONE 
JOIN WORK_EFFORT_ASSOC WEA2
    ON WEA2.WORK_EFFORT_ID_FROM = MISSIONE.WORK_EFFORT_ID
    AND WEA2.WORK_EFFORT_ASSOC_TYPE_ID = '20D2'
    AND WEA2.FROM_DATE <= @monitoringDate    -- DATA DI LANCIO
    AND WEA2.THRU_DATE >= @monitoringDate    -- DATA DI LANCIO
JOIN WORK_EFFORT PROG
    ON  PROG.WORK_EFFORT_ID = WEA2.WORK_EFFORT_ID_TO
    AND PROG.ESTIMATED_START_DATE      <= @date3112   -- 2023 ANNO DELLA DATA DI LANCIO
    AND PROG.ESTIMATED_COMPLETION_DATE >= @date0101   -- 2023 ANNO DELLA DATA DI LANCIO
    AND PROG.WORK_EFFORT_TYPE_ID = '20D24PRO'  
    AND PROG.WORK_EFFORT_REVISION_ID IS NULL
LEFT JOIN (
    SELECT
        WEM.WORK_EFFORT_ID,
        MAX(CASE WHEN ATE.GL_FISCAL_TYPE_ID = 'STSPAA' THEN ATE.AMOUNT END) AS STSPAA,
        MAX(CASE WHEN ATE.GL_FISCAL_TYPE_ID = 'STSPAA1' THEN ATE.AMOUNT END) AS STSPAA1,
        MAX(CASE WHEN ATE.GL_FISCAL_TYPE_ID = 'STSPAA2' THEN ATE.AMOUNT END) AS STSPAA2,
        MAX(CASE WHEN ATE.GL_FISCAL_TYPE_ID = 'STCOAA' THEN ATE.AMOUNT END) AS STCOAA,
        MAX(CASE WHEN ATE.GL_FISCAL_TYPE_ID = 'STCOAA1' THEN ATE.AMOUNT END) AS STCOAA1,
        MAX(CASE WHEN ATE.GL_FISCAL_TYPE_ID = 'STCOAA2' THEN ATE.AMOUNT END) AS STCOAA2,
        MAX(CASE WHEN ATE.GL_FISCAL_TYPE_ID = 'IMSPAA' THEN ATE.AMOUNT END) AS IMSPAA,
        MAX(CASE WHEN ATE.GL_FISCAL_TYPE_ID = 'IMSPAA1' THEN ATE.AMOUNT END) AS IMSPAA1,
        MAX(CASE WHEN ATE.GL_FISCAL_TYPE_ID = 'IMSPAA2' THEN ATE.AMOUNT END) AS IMSPAA2,
        MAX(CASE WHEN ATE.GL_FISCAL_TYPE_ID = 'IMCOAA' THEN ATE.AMOUNT END) AS IMCOAA,
        MAX(CASE WHEN ATE.GL_FISCAL_TYPE_ID = 'IMCOAA1' THEN ATE.AMOUNT END) AS IMCOAA1,
        MAX(CASE WHEN ATE.GL_FISCAL_TYPE_ID = 'IMCOAA2' THEN ATE.AMOUNT END) AS IMCOAA2
    FROM WORK_EFFORT_MEASURE WEM
    JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID
    JOIN WORK_EFFORT_PURPOSE_ACCOUNT WEPA
        ON WEPA.GL_ACCOUNT_ID = GL.GL_ACCOUNT_ID
        AND WEPA.WORK_EFFORT_PURPOSE_TYPE_ID = 'RISFIN'
    JOIN ACCTG_TRANS_ENTRY ATE
        ON ATE.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID
    JOIN ACCTG_TRANS ACT
        ON ACT.ACCTG_TRANS_ID = ATE.ACCTG_TRANS_ID
        AND ACT.TRANSACTION_DATE = @monitoringDate
    GROUP BY WEM.WORK_EFFORT_ID
) RISFIN ON RISFIN.WORK_EFFORT_ID = PROG.WORK_EFFORT_ID
WHERE  MISSIONE.WORK_EFFORT_TYPE_ID = '20D22MIS'
AND    MISSIONE.WORK_EFFORT_REVISION_ID IS NULL 
AND MISSIONE.ETCH = ?
AND    MISSIONE.ESTIMATED_START_DATE      <= @date3112   -- 2023 ANNO DELLA DATA DI LANCIO
AND    MISSIONE.ESTIMATED_COMPLETION_DATE >= @date0101   -- 2023 ANNO DELLA DATA DI LANCIO
GROUP BY
     MISSIONE.ETCH,
     MISSIONE.WORK_EFFORT_NAME ,
     PROG.ETCH,
     PROG.WORK_EFFORT_NAME 
     ORDER BY MISSIONE.ETCH,PROG.ETCH ;]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="SpeseMissioneDS" id="62055">
