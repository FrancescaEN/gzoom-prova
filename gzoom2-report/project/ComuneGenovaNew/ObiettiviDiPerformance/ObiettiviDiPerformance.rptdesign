            <xml-property name="queryText"><![CDATA[SELECT 
	OBP.WORK_EFFORT_ID AS "ID Obiettivo di performance",
	ND1.NOTE_NAME AS "Nome nota riferimenti",
	ND1.NOTE_INFO AS "Riferimenti",
	ND2.NOTE_NAME AS "Nome nota stakeholder",
	ND2.NOTE_INFO AS "Stakeholder"
FROM WORK_EFFORT OBP
/* RIFERIMENTI */
JOIN WORK_EFFORT_NOTE WEN1 ON WEN1.WORK_EFFORT_ID = OBP.WORK_EFFORT_ID AND WEN1.SEQUENCE_ID = '120'
JOIN NOTE_DATA ND1 ON ND1.NOTE_ID = WEN1.NOTE_ID 
/* STAKEHOLDER */
JOIN WORK_EFFORT_NOTE WEN2 ON WEN2.WORK_EFFORT_ID = OBP.WORK_EFFORT_ID AND WEN2.SEQUENCE_ID = '130'
JOIN NOTE_DATA ND2 ON ND2.NOTE_ID = WEN2.NOTE_ID 
WHERE OBP.WORK_EFFORT_ID = ? /* FIL_W.WORK_EFFORT_ID DELLA MASTERDS */
AND OBP.WORK_EFFORT_REVISION_ID IS NULL]]></xml-property>
