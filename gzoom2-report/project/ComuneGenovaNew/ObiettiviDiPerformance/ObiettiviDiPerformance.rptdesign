            <property name="rowFetchLimit">0</property>
            <method name="beforeOpen"><![CDATA[/**/
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value );
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );	

/*
this.queryText = this.queryText.replace("@date0101",  "'2020-01-01 00:00:00.000'" );
this.queryText = this.queryText.replace("@date3112",  "'2020-12-31 00:00:00.000'" );*/

var contentType = '';
if (params["reportContentId"].value == 'REPORT_PEG2023' || params["reportContentId"].value == 'REPORT_PEG2023_XLS'){
	contentType = " and wc.work_effort_content_type_id = 'PEGDEF' ";
} else if (params["reportContentId"].value == 'REPORT_MONIT_PEG23'){
	contentType = " and wc.work_effort_content_type_id = 'PEGMON' ";
} else if (params["reportContentId"].value == 'REPORT_RISU_PEG23'){
	contentType = " and wc.work_effort_content_type_id = 'PEGVAL' ";
}
this.queryText = this.queryText.replace("@contentType",  contentType );

//ReportLog.info("... this.queryText allegati= "+this.queryText);]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">tipo_allegato</property>
                    <property name="nativeName">tipo_allegato</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">descrizione_allegato</property>
                    <property name="nativeName">descrizione_allegato</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">nome_file</property>
                    <property name="nativeName">nome_file</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select
	wt.description as tipo_allegato,
	co.description as descrizione_allegato,
	al.data_resource_name as nome_file
from
	work_effort_content wc
inner join work_effort_content_type wt on
	wt.work_effort_content_type_id = wc.work_effort_content_type_id
inner join content co on
	co.content_id = wc.content_id
inner join data_resource al on
	al.data_resource_id = co.data_resource_id
where
	wc.work_effort_id = ? -- main.identificativo_obipeg
	and wc.from_date <= @date3112 -- 'AAAA(input.ref_date)-12-31'
	and(
		wc.thru_date is null
		or wc.thru_date >= @date0101
	) -- 'AAA(input.ref_date)-01-01'
	@contentType
order by
	descrizione_allegato]]></xml-property>
