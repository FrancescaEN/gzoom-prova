            <xml-property name="queryText"><![CDATA[SELECT 
	LINEA.WORK_EFFORT_ID AS "ID Linea di Mandato",
	LINEA.ETCH AS "Etichetta Linea di Mandato",
	LINEA.WORK_EFFORT_NAME AS "Nome Linea di Mandato",
	OBS.WORK_EFFORT_ID AS "ID Obiettivo Strategico",
	OBS.ETCH AS "Etichetta Obiettivo Strategico",
	OBS.WORK_EFFORT_NAME AS "Nome Obiettivo Strategico",
	OBO.WORK_EFFORT_ID AS "ID Obiettivo Operativo",
	OBO.ETCH AS "Etichetta Obiettivo Operativo",
	OBO.WORK_EFFORT_NAME AS "Nome Obiettivo Operativo",
	WEA.SEQUENCE_NUM AS "Numero sequenza",
	MISS.WORK_EFFORT_ID AS "ID Missione",
	MISS.ETCH AS "Etichetta Missione",
	MISS.WORK_EFFORT_NAME AS "Nome Missione",
	PROG.WORK_EFFORT_ID AS "ID Programma",
	PROG.ETCH AS "Etichetta Programma",
	PROG.WORK_EFFORT_NAME AS "Nome Programma"
/* OBIETTIVO DI PERFORMANCE */
FROM WORK_EFFORT FIL_W
/* OBIETTIVO OPERATIVO */
JOIN WORK_EFFORT_ASSOC WEA ON WEA.WORK_EFFORT_ID_TO = FIL_W.WORK_EFFORT_ID AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '20D6OC'
	AND WEA.FROM_DATE <= @date3112 AND WEA.THRU_DATE >= @date0101
JOIN WORK_EFFORT OBO ON OBO.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_FROM AND OBO.WORK_EFFORT_REVISION_ID IS NULL
/* OBIETTIVO STRATEGICO */
JOIN WORK_EFFORT_ASSOC WEA2 ON WEA2.WORK_EFFORT_ID_TO = OBO.WORK_EFFORT_ID AND WEA2.WORK_EFFORT_ASSOC_TYPE_ID = '20D6C'
	AND WEA2.FROM_DATE <= @date3112 AND WEA2.THRU_DATE >= @date0101
JOIN WORK_EFFORT OBS ON OBS.WORK_EFFORT_ID = WEA2.WORK_EFFORT_ID_FROM AND OBS.WORK_EFFORT_REVISION_ID IS NULL
/* LINEA DI MANDATO */
JOIN WORK_EFFORT_ASSOC WEA3 ON WEA3.WORK_EFFORT_ID_TO = OBS.WORK_EFFORT_ID AND WEA3.WORK_EFFORT_ASSOC_TYPE_ID = '20D6'
	AND WEA3.FROM_DATE <=@date3112 AND WEA3.THRU_DATE >= @date0101
JOIN WORK_EFFORT LINEA ON LINEA.WORK_EFFORT_ID = WEA3.WORK_EFFORT_ID_FROM AND LINEA.WORK_EFFORT_REVISION_ID IS NULL
/* PROGRAMMA DI BILANCIO */
JOIN WORK_EFFORT_ASSOC WEA4 ON WEA4.WORK_EFFORT_ID_TO = OBO.WORK_EFFORT_ID AND WEA4.WORK_EFFORT_ASSOC_TYPE_ID = '20D2C'
	AND WEA4.FROM_DATE <= @date3112 AND WEA4.THRU_DATE >= @date0101
JOIN WORK_EFFORT PROG ON PROG.WORK_EFFORT_ID = WEA4.WORK_EFFORT_ID_FROM AND PROG.WORK_EFFORT_REVISION_ID IS NULL
/* MISSIONE DI BILANCIO */
JOIN WORK_EFFORT_ASSOC WEA5 ON WEA5.WORK_EFFORT_ID_TO = PROG.WORK_EFFORT_ID AND WEA5.WORK_EFFORT_ASSOC_TYPE_ID = '20D2'
	AND WEA5.FROM_DATE <= @date3112 AND WEA5.THRU_DATE >= @date0101
JOIN WORK_EFFORT MISS ON MISS.WORK_EFFORT_ID = WEA5.WORK_EFFORT_ID_FROM AND MISS.WORK_EFFORT_REVISION_ID IS NULL
WHERE FIL_W.WORK_EFFORT_ID = ? /* VALORE PASSATO DALLA QUERY MASTERDS */
	AND FIL_W.WORK_EFFORT_REVISION_ID IS NULL
order by linea.source_reference_id, obs.source_reference_id, obo.source_reference_id, miss.source_reference_id, prog.source_reference_id	]]></xml-property>
        </oda-data-set>
