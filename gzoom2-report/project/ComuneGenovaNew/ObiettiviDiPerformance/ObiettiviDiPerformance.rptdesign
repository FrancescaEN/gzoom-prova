                                                            <expression name="valueExpr">if (BirtComp.greaterOrEqual(row["inizio_responsabilita"],params["date0101"].value)){&#13;
var initDate = row["inizio_responsabilita"];&#13;
} else{&#13;
var initDate = params["date0101"].value;&#13;
}&#13;
&#13;
if (BirtComp.greaterOrEqual(row["fine_responsabilita"],params["monitoringDate"].value)){&#13;
var endDate = null;&#13;
} else{&#13;
var endDate = row["fine_responsabilita"];&#13;
}&#13;
&#13;
if (endDate != null){&#13;
Formatter.format(initDate,'dd/MM/yyyy') + " al " + Formatter.format(endDate,'dd/MM/yyyy');&#13;
} else{&#13;
Formatter.format(initDate,'dd/MM/yyyy');&#13;
}</expression>
