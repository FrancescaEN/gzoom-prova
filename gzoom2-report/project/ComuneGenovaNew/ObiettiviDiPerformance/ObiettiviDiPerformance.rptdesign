                    <expression name="expression">if (row["titolo_direzione_responsabile_alt"] == null || row["titolo_direzione_responsabile_alt"] == ''){&#13;
row["codice_dir_resp"] + " - " + row["titolo_direzione_responsabile"];&#13;
} else{&#13;
row["codice_dir_resp"] + " - " + row["titolo_direzione_responsabile_alt"];&#13;
}</expression>
                    <property name="dataType">string</property>
                    <list-property name="arguments">
                        <structure>
                            <property name="name">Expression</property>
                            <expression name="value">row["codice_dir_resp"] + " - " + row["titolo_direzione_responsabile"]</expression>
                        </structure>
                        <structure>
                            <property name="name">Separat&amp;or</property>
                            <expression name="value">"\n"</expression>
                        </structure>
                    </list-property>
                </structure>
            </list-property>
