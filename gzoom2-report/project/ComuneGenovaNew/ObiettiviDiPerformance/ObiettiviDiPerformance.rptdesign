                    </cell>
                    <cell id="58052">
                        <text-data id="58171">
                            <expression name="valueExpr">importPackage(Packages.com.mapsengineering.base.birt.util);&#13;
&#13;
if((row["TIPO_UOM"] != null) &amp;&amp; (row["TIPO_UOM"] != '')){&#13;
	if (row["TIPO_UOM"] == 'RATING_SCALE'){&#13;
		row["ACTUAL_COD_3112_MENO_DUE"];&#13;
	} else if (row["TIPO_UOM"] == 'DATE_MEASURE'){&#13;
		UtilDateTime.numberConvertToDate(row["ACTUAL_DATO_3112_MENO_DUE"], reportContext.getLocale());&#13;
	} else{&#13;
		row["ACTUAL_DATO_3112_MENO_DUE"];&#13;
	}&#13;
}</expression>
                            <property name="contentType">html</property>
                        </text-data>
                    </cell>
                    <cell id="58053">
                        <text-data id="58172">
                            <expression name="valueExpr">importPackage(Packages.com.mapsengineering.base.birt.util);&#13;
&#13;
if((row["TIPO_UOM"] != null) &amp;&amp; (row["TIPO_UOM"] != '')){&#13;
	if (row["TIPO_UOM"] == 'RATING_SCALE'){&#13;
		row["ACTUAL_COD_3112_MENO_UNO"];&#13;
	} else if (row["TIPO_UOM"] == 'DATE_MEASURE'){&#13;
		UtilDateTime.numberConvertToDate(row["ACTUAL_DATO_3112_MENO_UNO"], reportContext.getLocale());&#13;
	} else{&#13;
		row["ACTUAL_DATO_3112_MENO_UNO"];&#13;
