            <xml-property name="queryText"><![CDATA[select
	(
		CASE
			WHEN ouop.work_effort_assoc_type_id = '20P2D' AND RA.WORK_EFFORT_TYPE_ID = '20P20ORG' THEN raou.sequence_num
			ELSE RARA.SEQUENCE_NUM
		END
	) as ordinamento_1,
	(
		CASE
			WHEN ouop.work_effort_assoc_type_id = '20P2D' AND RA.WORK_EFFORT_TYPE_ID = '20P20ORG' THEN 0
			ELSE raou.SEQUENCE_NUM
		END
	) as ordinamento_2,
	uoopc.parent_role_code as ordinamento_3,
	(
		CASE
			WHEN ouop.work_effort_assoc_type_id = '20P2D' THEN 1
			ELSE 2
		END
	) as livello_struttura,
	uoopc.parent_role_code as codice_dir_resp,
	uoop.external_id as codso4_dir_resp,
	uoop.vat_code codcdr_dir_resp,
	uoop.party_name as titolo_direzione_responsabile,
	pn1.group_name as titolo_direzione_responsabile_alt, 
	uooppa.party_name as denominazione_responsabile_tecnico,
	uoopre.from_date as responsabile_tecnico_inizio,
	padre.party_name as nome_struttura_padre,
	pprpadre.parent_role_code as codice_struttura_padre,
	FIL_W.work_effort_id as id_obipeg,
	FIL_W.etch as codice_obipeg,
	FIL_W.work_effort_name as titolo_obipeg,
	FIL_W.estimated_start_date as inizio_obipeg,
	FIL_W.estimated_completion_date as fine_obipeg,
	opass.sequence_num as seq_ref_pol,
	assrole.role_type_id as tipo_ref_pol,
	assrole.description as ruolo_referente_politico,
	ass.party_name as denominazione_referente_politico,
	ae.amount as controllato_assessore,
	lm.etch as codice_linea,
	lm.work_effort_name as titolo_lineamandato,
	os.etch as codice_obistrategico,
	os.work_effort_name as titolo_obistrategico,
	oo.etch as codice_obioperativo,
	oo.work_effort_name as titolo_obioperativo,
	pr.etch as codice_programma,
	pr.work_effort_name as titolo_programma,
	mi.etch as codice_missione,
	mi.work_effort_name as titolo_missione,
	rit.description as tipo_riferimento,
	ri.etch as codice_riferimento,
	ri.work_effort_name as titolo_riferimento,
	uoop.party_id as identificativo_uoresponsabile,
	FIL_W.work_effort_id as identificativo_obipeg,
	oo.work_effort_id as identificativo_obioperativo,
	aem.amount as monitoraggio_valore,
	mon.comments as monitoraggio_descrizione,
	drm.object_info as monitoraggio_emoticon,
	t210.note_info as monitoraggio_motivazioni, t220.note_info as monitoraggio_azioni,
	aer.amount as risultato_valore, ris.comments as risultato_descrizione, drr.object_info as risultato_emoticon,		
	aer.description as risultato_riferimento, atr.description as risultato_commento,		
	t310.note_info as risultato_attivita
/* MANDATO */
from work_effort pm
inner join work_effort_type pmt on pmt.work_effort_type_id = pm.work_effort_type_id
/* LINEA DI MANDATO */
inner join work_effort_assoc pmlm on pmlm.work_effort_id_from = pm.work_effort_id and pmlm.work_effort_assoc_type_id = '20D6'
	and pmlm.from_date <= @monitoringDate and pmlm.thru_date >= @monitoringDate
inner join work_effort lm on lm.work_effort_id = pmlm.work_effort_id_to
/* OBIETTIVO STRATEGICO */
inner join work_effort_assoc lmos on lmos.work_effort_id_from = lm.work_effort_id and lmos.work_effort_assoc_type_id = '20D6'
	and lmos.from_date <= @monitoringDate and lmos.thru_date >= @monitoringDate
inner join work_effort os on os.work_effort_id = lmos.work_effort_id_to
/* OBIETTIVO OPERATIVO */
inner join work_effort_assoc osoo on osoo.work_effort_id_from = os.work_effort_id and osoo.work_effort_assoc_type_id = '20D6C'
	and osoo.from_date <= @monitoringDate and osoo.thru_date >= @monitoringDate
inner join work_effort oo on oo.work_effort_id = osoo.work_effort_id_to
/* OBIETTIVO DI PERFORMANCE */
inner join work_effort_assoc ooop on ooop.work_effort_id_from = oo.work_effort_id and ooop.work_effort_assoc_type_id = '20D6OC'
	and ooop.from_date <= @monitoringDate and ooop.thru_date >= @monitoringDate
inner join work_effort FIL_W on FIL_W.work_effort_id = ooop.work_effort_id_to
inner join work_effort_type opt on opt.work_effort_type_id = FIL_W.work_effort_type_id
@variedObj
/* STRUTTURA RESPONSABILE */
inner join party uoop on uoop.party_id = FIL_W.org_unit_id
inner join party_parent_role uoopc on uoopc.party_id = uoop.party_id and uoopc.role_type_id = 'ORGANIZATION_UNIT'
/* STRUTTURA PADRE */
inner join party_relationship prel on prel.party_id_to = uoop.party_id and prel.party_relationship_type_id = 'GROUP_ROLLUP'
	and prel.from_date <= @monitoringDate and (prel.thru_date >= @monitoringDate or prel.thru_date is null)
inner join party padre on padre.party_id = prel.party_id_from
inner join party_parent_role pprpadre on pprpadre.party_id = padre.party_id and pprpadre.role_type_id = 'ORGANIZATION_UNIT'
/* STORICO NOME STRUTTURA */
left outer join party_name_history pn1 on pn1.party_id = uoop.party_id
and
	exists(
		select
			party_id as party_id,
			change_date as change_date
		from
			(
				select
					party_id as party_id,
					min( change_date ) as change_date
				from
					party_name_history pn3
				where
					pn3.change_date >= @monitoringDate 
				group by
					party_id
			) pn2
		where
			pn2.party_id = pn1.party_id
			and pn2.change_date = pn1.change_date
	)
-- punto 1 testare che non duplichi i record
left join PARTY_ROLE uoopr on uoopr.PARTY_ID = uoopc.PARTY_ID 
inner join party_group uoopg on uoopg.party_id = uoop.party_id
/* RESPONSABILE STRUTTURA */
left join party_relationship uoopre on uoopre.party_id_from = uoop.party_id
	and uoopre.party_relationship_type_id = 'ORG_RESPONSIBLE' 
	and uoopre.from_date <= @monitoringDate and(uoopre.thru_date is null or uoopre.thru_date >= @date0101)
left join party uooppa on uoopre.party_id_to is not null and uooppa.party_id = uoopre.party_id_to
/* ASSESSORI / POLITICI */
left join work_effort_party_assignment opass on opass.work_effort_id = FIL_W.work_effort_id
	and(opass.from_date <= @monitoringDate) -- input.ref_date
	and(opass.thru_date >= @monitoringDate) -- input.ref_date
left join party ass on opass.party_id is not null and ass.party_id = opass.party_id
left join role_type assrole on opass.role_type_id is not null and assrole.role_type_id = opass.role_type_id
/* PROGRAMMA DI BILANCIO */
inner join work_effort_assoc proo on proo.work_effort_id_to = oo.work_effort_id and proo.work_effort_assoc_type_id = '20D2C'
	and proo.from_date <= @monitoringDate and proo.thru_date >= @monitoringDate
inner join work_effort pr on pr.work_effort_id = proo.work_effort_id_from
/* MISSIONE DI BILANCIO */
inner join work_effort_assoc mipr on mipr.work_effort_id_to = pr.work_effort_id and mipr.work_effort_assoc_type_id = '20D2'
	and mipr.from_date <= @monitoringDate and mipr.thru_date >= @monitoringDate
inner join work_effort mi on mi.work_effort_id = mipr.work_effort_id_from
/* RELAZIONE CON SCHEDA DI STRUTTURA */
inner join work_effort_assoc ouop on ouop.work_effort_id_to = FIL_W.work_effort_id and ouop.work_effort_assoc_type_id in('20P2D','20P2S')
	and ouop.from_date <= @monitoringDate and ouop.thru_date >= @monitoringDate
inner join work_effort ou on ou.work_effort_id = ouop.work_effort_id_from and ou.work_effort_revision_id is null
/* RELAZIONE TRA SCHEDA DI STRUTTURA E SCHEDA DI STRUTTURA PADRE */
inner join work_effort_assoc raou on raou.work_effort_id_to = ou.work_effort_id and raou.work_effort_assoc_type_id = '20P2'
	and raou.from_date <= @monitoringDate and raou.thru_date >= @monitoringDate
inner join work_effort ra on ra.work_effort_id = raou.work_effort_id_from and ra.work_effort_revision_id is null
/* RELAZIONE TRA SCHEDA DI STRUTTURA PADRE E SCHEDA DI STRUTTURA NONNO */
inner join work_effort_assoc rara on rara.work_effort_id_to = ra.work_effort_id and raou.work_effort_assoc_type_id = '20P2'
	and rara.from_date <= @monitoringDate and rara.thru_date >= @monitoringDate
inner join work_effort zz on zz.work_effort_id = rara.work_effort_id_from and zz.work_effort_type_id like '20P20%' and zz.work_effort_revision_id is null

  @filterInnerJoin
  @filterLeftJoin	
/* RIFERIMENTI */
left join work_effort_assoc riop on
	riop.work_effort_id_to = FIL_W.work_effort_id
	and riop.work_effort_assoc_type_id in(
		'20R2C',
		'20R6C',
		'20R8C'
	)
	and riop.from_date <= @monitoringDate and riop.thru_date >= @monitoringDate
left join work_effort ri on
	riop.work_effort_id_from is not null
	and ri.work_effort_id = riop.work_effort_id_from
	and(
		ri.estimated_start_date is null
		or ri.estimated_start_date <= @date3112
	) -- 'AAAA(input.ref_date)-12-31'
	and(
		ri.estimated_completion_date is null
		or ri.estimated_completion_date >= @date0101
	) -- 'AAA(input.ref_date)-01-01'
left join work_effort_type rit on
	ri.work_effort_id is not null
	and rit.work_effort_type_id = ri.work_effort_type_id
left join work_effort_measure opm on
	opm.work_effort_id = FIL_W.work_effort_id
	and opm.gl_account_id = '10001'
left join acctg_trans at on
	opm.work_effort_measure_id is not null
	and at.voucher_ref = opm.work_effort_measure_id
	and(
		at.transaction_date = @date3112 
	) -- 'AAAA(input.ref_date)-12-31'
left join acctg_trans_entry ae on
	at.acctg_trans_id is not null
	and ae.acctg_trans_id = at.acctg_trans_id
	
left join work_effort_measure opmm on opmm.work_effort_id = FIL_W.work_effort_id
  and opmm.gl_account_id = '10020'
left join acctg_trans atm on opmm.work_effort_measure_id is not null
  and atm.voucher_ref = opmm.work_effort_measure_id 
  and (atm.transaction_date = @monitoringDate) --input.ref_date
left join acctg_trans_entry aem on atm.acctg_trans_id is not null
  and aem.acctg_trans_id = atm.acctg_trans_id 
left join uom_range_values mon on aem.amount is not null
  and mon.uom_range_id = 'PEGMON'
  and mon.range_values_factor = aem.amount
left join content com on mon.icon_content_id is not null
  and com.content_id = mon.icon_content_id
left join data_resource drm on com.data_resource_id is not null
  and drm.data_resource_id = com.data_resource_id
left join work_effort_note n210 on n210.work_effort_id = FIL_W.work_effort_id
  and n210.sequence_id = 210
left join note_data t210 on n210.note_id is not null
  and t210.note_id = n210.note_id
  --and (t210.note_date_time = @monitoringDate) --input.ref_date
left join work_effort_note n220 on n220.work_effort_id = FIL_W.work_effort_id
  and n220.sequence_id = 220
left join note_data t220 on n220.note_id is not null
  and t220.note_id = n220.note_id
  --and (t220.note_date_time = @monitoringDate) --input.ref_date
left join work_effort_measure opmr on   opmr.gl_account_id = 'SCORE'
  and opmr.work_effort_id = FIL_W.work_effort_id
left join acctg_trans atr on opmr.work_effort_measure_id is not null
  and atr.voucher_ref = opmr.work_effort_measure_id
  and atr.transaction_date = @monitoringDate  --input.ref_date
left join acctg_trans_entry aer on atr.acctg_trans_id is not null
  and aer.acctg_trans_id = atr.acctg_trans_id
left join uom_range_values ris on aer.amount is not null
  and ris.uom_range_id = opt.uom_range_score_id
  and ris.from_value <= aer.amount and ris.thru_value >= aer.amount
left join content cor on ris.icon_content_id is not null
  and cor.content_id = ris.icon_content_id
left join data_resource drr on cor.data_resource_id is not null
  and drr.data_resource_id = cor.data_resource_id
left join work_effort_note n310 on n310.work_effort_id = FIL_W.work_effort_id
  and n310.sequence_id = 310
left join note_data t310 on n310.note_id is not null
  and t310.note_id = n310.note_id
  --and t310.note_date_time = @monitoringDate  --input.ref_date
where 1=1
   @revision
   @codiceObpeg
   @workEffortEtch
   @workEffortName
   @orgUnitId -- and uoop.party_id = '10113'   -- input.uorg_uni_id (se valorizzato)
   @partyId -- and (ass.party_id is not null and ass.party_id = '10150')    -- input.ass_party_id (se valorizzato)
   @personId --  and uooopa.party_id is not null and uooopa.party_id = 'admin' -- input.resp-party_id (se valorizzato)
   @workEffortId --  and (lm.work_effort_id = '10670' or os.work_effort_id = '10670' or oo.work_effort_id = '10670' or FIL_W.work_effort_id = '10670'
 --   or pr.work_effort_id = '10670' or mi.work_effort_id = '10670' or ri.work_effort_id = '10670')   -- input.work_effort_id (se valorizzato)
   @assessors
 -- and ae.amount is not null and ae.amount = 0 -- se input.validazione_assessori = solo non validati
 -- and ae.amount is not null and ae.amount = 100 -- se input.validazione_assessori = solo validati
 -- and opm.work_effort_measure_id is not null and ae.amount is null -- se input.validazione_assessori = non compilati
  @score
  @scoreActual
  @filterWhere 
 
order by
	ordinamento_1,
	ordinamento_2,
	ordinamento_3
	]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="ExcelDS" id="58005">
