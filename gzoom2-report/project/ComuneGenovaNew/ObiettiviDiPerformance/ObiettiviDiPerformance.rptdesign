row["descrizione_allegato"] + " - " + row["nome_file"];&#13;
} else{&#13;
row["nome_file"];&#13;
}</expression>
                        </structure>
                        <structure>
                            <property name="name">Separator</property>
                            <expression name="value">", "</expression>
                        </structure>
                    </list-property>
                </structure>
            </list-property>
