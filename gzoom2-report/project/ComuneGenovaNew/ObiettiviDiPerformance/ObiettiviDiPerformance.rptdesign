        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="ObiettiviTrasversaliDS" id="58775">
            <list-property name="columnHints"/>
            <list-property name="parameters">
                <structure>
                    <property name="name">param_1</property>
                    <property name="nativeName"></property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">0</property>
                    <property name="position">1</property>
                    <expression name="defaultValue" type="javascript">""</expression>
                    <property name="isOptional">false</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <structure name="cachedMetaData"/>
            <method name="beforeOpen"><![CDATA[/**/
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value );
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );								
this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );

/*
this.queryText = this.queryText.replace("@date0101",  "'2020-01-01 00:00:00.000'" );
this.queryText = this.queryText.replace("@date3112",  "'2020-12-31 00:00:00.000'" );
this.queryText = this.queryText.replace("@monitoringDate",  "'2020-01-01 00:00:00.000'" );
*/
ReportLog.info("ObiettiviTrasversali "+this.queryText);]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet"/>
            <xml-property name="queryText"><![CDATA[SELECT 
	OBT.WORK_EFFORT_ID AS "ID Obiettivo trasversale",
	OBP.WORK_EFFORT_ID AS "ID Obiettivo di performance",
	P.PARTY_NAME AS "Nome struttura",
	PPR.PARENT_ROLE_CODE AS "Codice struttura",
	RESP.PARTY_NAME AS "Responsabile",
	CONCAT(RESP.PARTY_NAME, ', ', P.PARTY_NAME, ' (', PPR.PARENT_ROLE_CODE, ')') AS "Concatenazione"
FROM WORK_EFFORT OBP
/* OBIETTIVO TRASVERSALE */
JOIN WORK_EFFORT_ASSOC WEA ON WEA.WORK_EFFORT_ID_TO = OBP.WORK_EFFORT_ID AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '23D6OT'
	AND WEA.FROM_DATE <= @monitoringDate AND WEA.THRU_DATE >= @monitoringDate
JOIN WORK_EFFORT OBT ON OBT.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_FROM AND OBT.WORK_EFFORT_REVISION_ID IS NULL
/* ALTRI OBIETTIVI DI PERFORMANCE COLLEGATI */
JOIN WORK_EFFORT_ASSOC WEA2 ON WEA2.WORK_EFFORT_ID_FROM = OBT.WORK_EFFORT_ID AND WEA2.WORK_EFFORT_ASSOC_TYPE_ID = '23D6OT'
	AND WEA2.FROM_DATE <= @monitoringDate AND WEA2.THRU_DATE >= @monitoringDate
JOIN WORK_EFFORT ALTRI ON ALTRI.WORK_EFFORT_ID = WEA2.WORK_EFFORT_ID_TO AND ALTRI.WORK_EFFORT_REVISION_ID IS NULL
	AND ALTRI.WORK_EFFORT_ID <> OBP.WORK_EFFORT_ID AND ALTRI.ORG_UNIT_ID <> OBP.ORG_UNIT_ID
/* STRUTTURA ALTRI OBIETTIVI */
JOIN PARTY P ON P.PARTY_ID = ALTRI.ORG_UNIT_ID
JOIN PARTY_PARENT_ROLE PPR ON PPR.PARTY_ID = P.PARTY_ID 
/* RESPONSABILE STRUTTURA */
LEFT JOIN PARTY_RELATIONSHIP PR ON PR.PARTY_ID_FROM = P.PARTY_ID AND PR.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
	AND PR.FROM_DATE <= @date3112 AND (PR.THRU_DATE >= @date0101 OR PR.THRU_DATE IS NULL)
LEFT JOIN PARTY RESP ON RESP.PARTY_ID = PR.PARTY_ID_TO 
WHERE OBP.WORK_EFFORT_ID = ? /* FIL_W.WORK_EFFORT_ID PASSATO DALLA MASTERDS */
	AND OBP.WORK_EFFORT_REVISION_ID IS NULL]]></xml-property>
        </oda-data-set>
    </data-sets>
