                                                            <property name="textAlign">center</property>
                                                            <expression name="valueExpr">importPackage(Packages.com.mapsengineering.base.birt.util);&#13;
&#13;
if((row["TIPO_UOM"] != null) &amp;&amp; (row["TIPO_UOM"] != '')){&#13;
	if (row["TIPO_UOM"] == 'RATING_SCALE'){&#13;
		row["ACTUAL_COD_3112_MENO_QUATTRO"];&#13;
	} else if (row["TIPO_UOM"] == 'DATE_MEASURE'){&#13;
		UtilDateTime.numberConvertToDate(row["ACTUAL_DATO_3112_MENO_QUATTRO"], reportContext.getLocale());&#13;
	} else{&#13;
		row["ACTUAL_DATO_3112_MENO_QUATTRO"]!= null ? UtilNumber.getValueFormatted(row["ACTUAL_DATO_3112_MENO_QUATTRO"], row["FORMAT"]) : '';&#13;
	}&#13;
}</expression>
