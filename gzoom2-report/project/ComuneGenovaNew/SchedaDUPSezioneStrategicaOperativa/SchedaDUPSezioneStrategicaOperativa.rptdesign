this.queryText = this.queryText.replace("@date3006",  "'2021-12-31 00:00:00.000'");
*/

ReportLog.info("IndicatoriGestionaliDS "+this.queryText);
ReportLog.info("Parameters "+this.getInputParameters());]]></method>
