            <xml-property name="queryText"><![CDATA[/* VERSIONE V1.0 CON #COND0# = AAAA
 * FILTRO SU STRUTTURA A LIVELLO DI OBIETTIVO OPERATIVO
 */

SELECT 
	PEG.WORK_EFFORT_ID AS "PEG WorkEffortId",
	LINEA.ETCH AS "Etichetta linea di mandato",
	LINEA.WORK_EFFORT_NAME AS "Titolo linea di mandato",
	OBS.ETCH AS "Etichetta obiettivo strategico",
	OBS.WORK_EFFORT_NAME AS "Titolo obiettivo strategico",
	CASE 
		WHEN OBSTREND.TREND_BREVE = 'F1' THEN 'Decrescente'
		WHEN OBSTREND.TREND_BREVE = 'F2' THEN 'Stabile'
		WHEN OBSTREND.TREND_BREVE = 'F3' THEN 'Crescente'
		ELSE NULL END AS "Trend breve termine OBS",
	CASE 
		WHEN OBSTREND.TREND_LUNGO = 'F1' THEN 'Decrescente'
		WHEN OBSTREND.TREND_LUNGO = 'F2' THEN 'Stabile'
		WHEN OBSTREND.TREND_LUNGO = 'F3' THEN 'Crescente'
		ELSE NULL END AS "Trend lungo termine OBS",
	OBO.ETCH AS "Eticehtta obiettivo operativo",
	OBO.WORK_EFFORT_NAME AS "Titolo obiettivo operativo",
	CASE 
		WHEN OBO.TREND_BREVE = 'F1' THEN 'Decrescente'
		WHEN OBO.TREND_BREVE = 'F2' THEN 'Stabile'
		WHEN OBO.TREND_BREVE = 'F3' THEN 'Crescente'
		ELSE NULL END AS "Trend breve termine OBO",
	CASE 
		WHEN OBO.TREND_LUNGO = 'F1' THEN 'Decrescente'
		WHEN OBO.TREND_LUNGO = 'F2' THEN 'Stabile'
		WHEN OBO.TREND_LUNGO = 'F3' THEN 'Crescente'
		ELSE NULL END AS "Trend lungo termine OBO",
	OBO.PARENT_ROLE_CODE AS "Codice struttura responsabile obiettvio operativo",
	OBO.PARTY_NAME AS "Denominazione struttura responsabile obiettivo operativo",
	PEG.ETCH AS "Etichetta obiettivo gestionale",
	PEG.WORK_EFFORT_NAME AS "Titolo obiettivo gestionale",
	PEG.NOTE_INFO AS "Descrizione obiettivo gestionale",
	PEG.AMOUNT AS "Risultato obiettivo gestionale",
	PEG.PARENT_ROLE_CODE AS "Codice struttura responsabile obiettivo gestionale",
	PEG.PARTY_NAME AS "Denominazione struttura responsabile obiettivo gestionale"
/* MANDATO */
FROM WORK_EFFORT MAND
/* LINEA DI MANDATO */
JOIN WORK_EFFORT_ASSOC WEA ON WEA.WORK_EFFORT_ID_FROM = MAND.WORK_EFFORT_ID AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '20D6'
JOIN WORK_EFFORT LINEA ON LINEA.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_TO AND LINEA.WORK_EFFORT_TYPE_ID = '20D62LIN' AND LINEA.WORK_EFFORT_REVISION_ID IS NULL
	AND LINEA.ESTIMATED_START_DATE <= @date3112 AND LINEA.ESTIMATED_COMPLETION_DATE >= @date0101
/* OBIETTIVO STRATEGICO */
LEFT JOIN WORK_EFFORT_ASSOC WEA2 ON WEA2.WORK_EFFORT_ID_FROM = LINEA.WORK_EFFORT_ID AND WEA2.WORK_EFFORT_ASSOC_TYPE_ID = '20D6'
LEFT JOIN WORK_EFFORT OBS ON OBS.WORK_EFFORT_ID = WEA2.WORK_EFFORT_ID_TO AND OBS.WORK_EFFORT_TYPE_ID = '20D64OST' AND OBS.WORK_EFFORT_REVISION_ID IS NULL
	AND OBS.ESTIMATED_START_DATE <= @date3112 AND OBS.ESTIMATED_COMPLETION_DATE >= @date0101
/* TREND OBIETTIVO STRATEGICO */
LEFT JOIN (
	SELECT 
		WEM.WORK_EFFORT_ID,
		MAX(CASE WHEN ATE.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN URV.UOM_RANGE_VALUES_ID ELSE NULL END) AS TREND_BREVE,
		MAX(CASE WHEN ATE.GL_FISCAL_TYPE_ID = 'TREND' THEN URV.UOM_RANGE_VALUES_ID ELSE NULL END) AS TREND_LUNGO
	FROM WORK_EFFORT_MEASURE WEM
	JOIN ACCTG_TRANS ACT ON ACT.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID AND ACT.TRANSACTION_DATE = @date3112
	JOIN ACCTG_TRANS_ENTRY ATE ON ATE.ACCTG_TRANS_ID = ACT.ACCTG_TRANS_ID AND ATE.GL_ACCOUNT_ID = 'SCORE'
	JOIN UOM_RANGE_VALUES URV ON URV.UOM_RANGE_ID = 'TRENDCC' AND URV.FROM_VALUE <= ATE.AMOUNT AND URV.THRU_VALUE >= ATE.AMOUNT 
	GROUP BY
		WEM.WORK_EFFORT_ID
) OBSTREND ON OBSTREND.WORK_EFFORT_ID = OBS.WORK_EFFORT_ID 
/* OBIETTIVO OPERATIVO */
LEFT JOIN (
	SELECT 
		WEA3.WORK_EFFORT_ID_FROM,
		OBO.ETCH,
		OBO.ORG_UNIT_ID,
		OBO.WORK_EFFORT_NAME,
		PPR.PARENT_ROLE_CODE,
		OBO.WORK_EFFORT_ID,
		P.PARTY_NAME,
		OBOTREND.TREND_BREVE,
		OBOTREND.TREND_LUNGO
	FROM WORK_EFFORT_ASSOC WEA3
	JOIN WORK_EFFORT OBO ON OBO.WORK_EFFORT_ID = WEA3.WORK_EFFORT_ID_TO AND OBO.WORK_EFFORT_TYPE_ID = '20D66OOP' AND OBO.WORK_EFFORT_REVISION_ID IS NULL
		AND OBO.ESTIMATED_START_DATE <= @date3112 AND OBO.ESTIMATED_COMPLETION_DATE >= @date0101
	/* STRUTTURA OBIETTIVO OPERATIVO */
	JOIN PARTY P ON P.PARTY_ID = OBO.ORG_UNIT_ID 
	JOIN PARTY_PARENT_ROLE PPR ON PPR.PARTY_ID = P.PARTY_ID 
	/* TREND OBIETTIVO STRATEGICO */
	LEFT JOIN (
		SELECT 
			WEM.WORK_EFFORT_ID,
			MAX(CASE WHEN ATE.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN URV.UOM_RANGE_VALUES_ID ELSE NULL END) AS TREND_BREVE,
			MAX(CASE WHEN ATE.GL_FISCAL_TYPE_ID = 'TREND' THEN URV.UOM_RANGE_VALUES_ID ELSE NULL END) AS TREND_LUNGO
		FROM WORK_EFFORT_MEASURE WEM
		JOIN ACCTG_TRANS ACT ON ACT.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID AND ACT.TRANSACTION_DATE = @date3112
		JOIN ACCTG_TRANS_ENTRY ATE ON ATE.ACCTG_TRANS_ID = ACT.ACCTG_TRANS_ID AND ATE.GL_ACCOUNT_ID = 'SCORE'
		JOIN UOM_RANGE_VALUES URV ON URV.UOM_RANGE_ID = 'TRENDCC' AND URV.FROM_VALUE <= ATE.AMOUNT AND URV.THRU_VALUE >= ATE.AMOUNT 
		GROUP BY
			WEM.WORK_EFFORT_ID
	) OBOTREND ON OBOTREND.WORK_EFFORT_ID = OBO.WORK_EFFORT_ID 
	WHERE WEA3.WORK_EFFORT_ASSOC_TYPE_ID = '20D6C'
) OBO ON OBO.WORK_EFFORT_ID_FROM = OBS.WORK_EFFORT_ID 
/* OBIETTIVO PEG / OBIETTIVO PEG ANTICORRUZIONE */
JOIN (
	SELECT 
		WEA4.WORK_EFFORT_ID_FROM,
		PEG.WORK_EFFORT_NAME,
		PEG.WORK_EFFORT_ID,
		PEG.ETCH,
		ND.NOTE_INFO,
		WEA4.WORK_EFFORT_ASSOC_TYPE_ID,
		P.PARTY_NAME,
		PPR.PARENT_ROLE_CODE,
		SCORE.AMOUNT
	FROM WORK_EFFORT_ASSOC WEA4
	JOIN WORK_EFFORT PEG ON PEG.WORK_EFFORT_ID = WEA4.WORK_EFFORT_ID_TO AND PEG.WORK_EFFORT_TYPE_ID IN ('20P44OPD', '20P44OPA') AND PEG.WORK_EFFORT_REVISION_ID IS NULL
		AND PEG.ESTIMATED_START_DATE <= @date3112 AND PEG.ESTIMATED_COMPLETION_DATE >= @date0101
	/* STRUTTURA OBIETTIVO GESTIONALE */
	JOIN PARTY P ON P.PARTY_ID = PEG.ORG_UNIT_ID 
	JOIN PARTY_PARENT_ROLE PPR ON PPR.PARTY_ID = P.PARTY_ID 
	/* NOTE OBIETTIVO GESTIONALE */
	LEFT JOIN WORK_EFFORT_NOTE WEN ON WEN.WORK_EFFORT_ID = PEG.WORK_EFFORT_ID AND WEN.SEQUENCE_ID = 110
	LEFT JOIN NOTE_DATA ND ON ND.NOTE_ID = WEN.NOTE_ID
	/* RISULTATO OBIETTIVI GESTIONALI */
	LEFT JOIN (
		SELECT 
			WEM.WORK_EFFORT_ID,
			ATE.AMOUNT 
		FROM WORK_EFFORT_MEASURE WEM
		JOIN ACCTG_TRANS ACT ON ACT.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID AND ACT.TRANSACTION_DATE = @date3112
		JOIN ACCTG_TRANS_ENTRY ATE ON ATE.ACCTG_TRANS_ID = ACT.ACCTG_TRANS_ID AND ATE.GL_ACCOUNT_ID = 'SCORE' AND ATE.GL_FISCAL_TYPE_ID = 'ACTUAL'
		) SCORE ON SCORE.WORK_EFFORT_ID = PEG.WORK_EFFORT_ID 
	WHERE WEA4.WORK_EFFORT_ASSOC_TYPE_ID = '20D6OC'
) PEG ON PEG.WORK_EFFORT_ID_FROM = OBO.WORK_EFFORT_ID 
WHERE MAND.WORK_EFFORT_TYPE_ID = '20D60MAN' AND MAND.WORK_EFFORT_REVISION_ID IS NULL
	AND MAND.ESTIMATED_START_DATE <= @date3112 AND MAND.ESTIMATED_COMPLETION_DATE >= @date0101
	
AND OBO.WORK_EFFORT_ID = ?
	
ORDER BY
	LINEA.ETCH,
	OBS.ETCH,
	OBO.ETCH,
	PEG.ETCH,
	PEG.PARENT_ROLE_CODE]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="IndicatoriGestionaliDS" id="62073">
