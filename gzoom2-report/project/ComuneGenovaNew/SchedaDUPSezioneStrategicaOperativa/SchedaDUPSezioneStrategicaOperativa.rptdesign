            <xml-property name="queryText"><![CDATA[SELECT 
	LINEA.ETCH AS "CodiceLinea",
	CONCAT(LINEA.ETCH, ' - ', LINEA.WORK_EFFORT_NAME) AS "Città",
	OBS.ETCH AS "Obiettivo strategico",
	OBS.WORK_EFFORT_NAME AS "Titolo obiettivo",
	PROG.ETCH AS "Programma di bilancio",
	WEA2.ASSOC_WEIGHT AS "% ripartizione",
	(RISFIN.STSPAA * WEA2.ASSOC_WEIGHT) / 100 AS "% Stanziato spese correnti anno corrente",
	(RISFIN.STCOAA * WEA2.ASSOC_WEIGHT) / 100 AS "% Stanziato conto capitale anno corrente",
	(RISFIN.STSPAA1 * WEA2.ASSOC_WEIGHT) / 100 AS "% Stanziato spese correnti anno successivo",
	(RISFIN.STCOAA1 * WEA2.ASSOC_WEIGHT) / 100 AS "% Stanziato conto capitale anno successivo",
	(RISFIN.STSPAA2 * WEA2.ASSOC_WEIGHT) / 100 AS "% Stanziato spese correnti due anni successivi",
	(RISFIN.STCOAA2 * WEA2.ASSOC_WEIGHT) / 100 AS "% Stanziato conto capitale due anni successivi",
	(RISFIN.IMSPAA * WEA2.ASSOC_WEIGHT) / 100 AS "% Impegnato spese correnti anno corrente",
	(RISFIN.IMCOAA * WEA2.ASSOC_WEIGHT) / 100 AS "% Impegnato conto capitale anno corrente",
	(RISFIN.IMSPAA1 * WEA2.ASSOC_WEIGHT) / 100 AS "% Impegnato spese correnti anno successivo",
	(RISFIN.IMCOAA1 * WEA2.ASSOC_WEIGHT) / 100 AS "% Impegnato conto capitale anno successivo",
	(RISFIN.IMSPAA2 * WEA2.ASSOC_WEIGHT) / 100 AS "% Impegnato spese correnti due anni successivi",
	(RISFIN.IMCOAA2 * WEA2.ASSOC_WEIGHT) / 100 AS "% Impegnato conto capitale due anni successivi",
	LINEA.LOCATION_DESC AS colore_scuro, LINEA.INFO_URL AS colore_chiaro
/* OBIETTIVO STRATEGICO */
FROM WORK_EFFORT OBS
/* LINEA DI MANDATO */
JOIN WORK_EFFORT_ASSOC WEA ON WEA.WORK_EFFORT_ID_TO = OBS.WORK_EFFORT_ID AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '20D6'
JOIN WORK_EFFORT LINEA ON LINEA.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_FROM AND LINEA.WORK_EFFORT_TYPE_ID = '20D62LIN' AND LINEA.WORK_EFFORT_REVISION_ID IS NULL
/* PROGRAMMA DI BILANCIO */
JOIN WORK_EFFORT_ASSOC WEA2 ON WEA2.WORK_EFFORT_ID_TO = OBS.WORK_EFFORT_ID AND WEA2.WORK_EFFORT_ASSOC_TYPE_ID = '23PROB'
	AND WEA2.FROM_DATE <= @monitoringDate AND WEA2.THRU_DATE >= @monitoringDate
JOIN WORK_EFFORT PROG ON PROG.WORK_EFFORT_ID = WEA2.WORK_EFFORT_ID_FROM AND PROG.WORK_EFFORT_TYPE_ID = '20D24PRO' AND PROG.WORK_EFFORT_REVISION_ID IS NULL
/* RISORSE FINANZIARIE */
LEFT JOIN (
	SELECT 
		WEM.WORK_EFFORT_ID,
		MAX(CASE WHEN ATE.GL_FISCAL_TYPE_ID = 'STSPAA' THEN ATE.AMOUNT ELSE NULL END) AS STSPAA,
		MAX(CASE WHEN ATE.GL_FISCAL_TYPE_ID = 'STSPAA1' THEN ATE.AMOUNT ELSE NULL END) AS STSPAA1,
		MAX(CASE WHEN ATE.GL_FISCAL_TYPE_ID = 'STSPAA2' THEN ATE.AMOUNT ELSE NULL END) AS STSPAA2,
		MAX(CASE WHEN ATE.GL_FISCAL_TYPE_ID = 'STCOAA' THEN ATE.AMOUNT ELSE NULL END) AS STCOAA,
		MAX(CASE WHEN ATE.GL_FISCAL_TYPE_ID = 'STCOAA1' THEN ATE.AMOUNT ELSE NULL END) AS STCOAA1,
		MAX(CASE WHEN ATE.GL_FISCAL_TYPE_ID = 'STCOAA2' THEN ATE.AMOUNT ELSE NULL END) AS STCOAA2,
		MAX(CASE WHEN ATE.GL_FISCAL_TYPE_ID = 'IMSPAA' THEN ATE.AMOUNT ELSE NULL END) AS IMSPAA,
		MAX(CASE WHEN ATE.GL_FISCAL_TYPE_ID = 'IMSPAA1' THEN ATE.AMOUNT ELSE NULL END) AS IMSPAA1,
		MAX(CASE WHEN ATE.GL_FISCAL_TYPE_ID = 'IMSPAA2' THEN ATE.AMOUNT ELSE NULL END) AS IMSPAA2,
		MAX(CASE WHEN ATE.GL_FISCAL_TYPE_ID = 'IMCOAA' THEN ATE.AMOUNT ELSE NULL END) AS IMCOAA,
		MAX(CASE WHEN ATE.GL_FISCAL_TYPE_ID = 'IMCOAA1' THEN ATE.AMOUNT ELSE NULL END) AS IMCOAA1,
		MAX(CASE WHEN ATE.GL_FISCAL_TYPE_ID = 'IMCOAA2' THEN ATE.AMOUNT ELSE NULL END) AS IMCOAA2
	FROM WORK_EFFORT_MEASURE WEM
	JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID 
	JOIN WORK_EFFORT_PURPOSE_ACCOUNT WEPA ON WEPA.GL_ACCOUNT_ID = GL.GL_ACCOUNT_ID AND WEPA.WORK_EFFORT_PURPOSE_TYPE_ID = 'RISFIN'
	JOIN ACCTG_TRANS_ENTRY ATE ON ATE.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID
	JOIN ACCTG_TRANS ACT ON ACT.ACCTG_TRANS_ID = ATE.ACCTG_TRANS_ID AND ACT.TRANSACTION_DATE = @date3112
	GROUP BY
		WEM.WORK_EFFORT_ID
) RISFIN ON RISFIN.WORK_EFFORT_ID = PROG.WORK_EFFORT_ID 
WHERE OBS.WORK_EFFORT_TYPE_ID = '20D64OST' AND OBS.WORK_EFFORT_REVISION_ID IS NULL
	AND OBS.ESTIMATED_START_DATE <= @date3112 AND OBS.ESTIMATED_COMPLETION_DATE >= @date0101]]></xml-property>
        </oda-data-set>
