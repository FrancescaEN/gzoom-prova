                </structure>
            </list-property>
            <list-property name="parameters">
                <structure>
                    <property name="name">workEffortId</property>
                    <property name="nativeName"></property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">0</property>
                    <property name="position">1</property>
                    <expression name="defaultValue" type="constant">N/A</expression>
                    <property name="isOptional">false</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">tipo_riferimento</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">codice_riferimento</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">titolo_riferimento</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <method name="beforeOpen"><![CDATA[/**/
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value );
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );	
this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );

/*
this.queryText = this.queryText.replace("@date0101",  "'2020-01-01 00:00:00.000'" );
this.queryText = this.queryText.replace("@date3112",  "'2020-12-31 00:00:00.000'" );
this.queryText = this.queryText.replace("@monitoringDate",  "'2020-12-31 00:00:00.000'" ); */

//ReportLog.info("riferimenti  "+this.queryText);]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">tipo_riferimento</property>
                    <property name="nativeName">tipo_riferimento</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">codice_riferimento</property>
                    <property name="nativeName">codice_riferimento</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">titolo_riferimento</property>
                    <property name="nativeName">titolo_riferimento</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select
	rit.description as tipo_riferimento,
	ri.etch as codice_riferimento,
	ri.work_effort_name as titolo_riferimento
from
	work_effort_assoc riop
inner join work_effort ri on
	ri.work_effort_id = riop.work_effort_id_from
inner join work_effort_type rit on
	rit.work_effort_type_id = ri.work_effort_type_id
where
	riop.work_effort_id_to = ? -- main.identificativo_obipeg
	and riop.work_effort_assoc_type_id like '20R%'
	and riop.from_date <= @monitoringDate    -- input.ref_date
    and riop.thru_date >= @monitoringDate    -- input.ref_date 

order by
	tipo_riferimento,
	codice_riferimento,
	titolo_riferimento 
 	]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="PNRRDS" id="59668">
            <list-property name="columnHints"/>
            <list-property name="parameters">
                <structure>
                    <property name="name">workEffortId</property>
                    <property name="nativeName"></property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">0</property>
                    <property name="position">1</property>
                    <expression name="defaultValue" type="constant">N/A</expression>
                    <property name="isOptional">false</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">Codice OBO</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">Etichetta OBO</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">Nome OBO</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">4</property>
                        <property name="name">Investimento</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">5</property>
                        <property name="name">Intervento</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">6</property>
                        <property name="name">Componente</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">7</property>
                        <property name="name">Missione</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <method name="beforeOpen"><![CDATA[/**/
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value );
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );	
this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );

/* 
this.queryText = this.queryText.replace("@date0101",  "CONVERT(DATETIME, '2021-01-01', 121)" );
this.queryText = this.queryText.replace("@date3112",  "CONVERT(DATETIME, '2021-12-31', 121)" );
this.queryText = this.queryText.replace("@monitoringDate",  "CONVERT(DATETIME, '2021-12-31', 121)" ); 
*/

ReportLog.info("PNRRDS:  "+this.queryText);]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">Codice OBO</property>
                    <property name="nativeName">Codice OBO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">Etichetta OBO</property>
                    <property name="nativeName">Etichetta OBO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">Nome OBO</property>
                    <property name="nativeName">Nome OBO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">Investimento</property>
                    <property name="nativeName">Investimento</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">Intervento</property>
                    <property name="nativeName">Intervento</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">Componente</property>
                    <property name="nativeName">Componente</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">Missione</property>
                    <property name="nativeName">Missione</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
	OBO.SOURCE_REFERENCE_ID as "Codice OBO",
	OBO.ETCH AS "Etichetta OBO",
	OBO.WORK_EFFORT_NAME AS "Nome OBO",
	CONCAT(INV.ETCH, ' ', INV.WORK_EFFORT_NAME) AS "Investimento",
	CONCAT(INTER.ETCH, ' ', INTER.WORK_EFFORT_NAME) AS "Intervento",
	CONCAT(COMP.ETCH, ' ', COMP.WORK_EFFORT_NAME) AS "Componente",
	CONCAT(MISS.ETCH, ' ', MISS.WORK_EFFORT_NAME) AS "Missione"
/* OBIETTIVO OPERATIVO */
FROM WORK_EFFORT OBO
/* INVESTIMENTO PNRR */
LEFT JOIN WORK_EFFORT_ASSOC WEA ON WEA.WORK_EFFORT_ID_TO = OBO.WORK_EFFORT_ID AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '22R3C'
LEFT JOIN WORK_EFFORT INV ON INV.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_FROM AND INV.WORK_EFFORT_REVISION_ID IS NULL AND INV.WORK_EFFORT_TYPE_ID = '22R38INV'
/* INTERVENTO PNRR */
LEFT JOIN WORK_EFFORT_ASSOC WEA2 ON WEA2.WORK_EFFORT_ID_TO = INV.WORK_EFFORT_ID AND WEA2.WORK_EFFORT_ASSOC_TYPE_ID = '22R3'
LEFT JOIN WORK_EFFORT INTER ON INTER.WORK_EFFORT_ID = WEA2.WORK_EFFORT_ID_FROM AND INTER.WORK_EFFORT_REVISION_ID IS NULL AND INTER.WORK_EFFORT_TYPE_ID = '22R36INT'
/* COMPONENTE PNRR */
LEFT JOIN WORK_EFFORT_ASSOC WEA3 ON WEA3.WORK_EFFORT_ID_TO = INTER.WORK_EFFORT_ID AND WEA3.WORK_EFFORT_ASSOC_TYPE_ID = '22R3'
LEFT JOIN WORK_EFFORT COMP ON COMP.WORK_EFFORT_ID = WEA3.WORK_EFFORT_ID_FROM AND COMP.WORK_EFFORT_REVISION_ID IS NULL AND COMP.WORK_EFFORT_TYPE_ID = '22R34COM'
/* MISSIONE PNRR */
JOIN WORK_EFFORT_ASSOC WEA4 ON WEA4.WORK_EFFORT_ID_TO = COMP.WORK_EFFORT_ID AND WEA4.WORK_EFFORT_ASSOC_TYPE_ID = '22R3'
JOIN WORK_EFFORT MISS ON MISS.WORK_EFFORT_ID = WEA4.WORK_EFFORT_ID_FROM AND MISS.WORK_EFFORT_REVISION_ID IS NULL AND MISS.WORK_EFFORT_TYPE_ID = '22R32MIS'
WHERE OBO.WORK_EFFORT_TYPE_ID = '20D66OOP' AND OBO.WORK_EFFORT_REVISION_ID IS NULL 
	AND OBO.ESTIMATED_START_DATE <= @date3112 AND OBO.ESTIMATED_COMPLETION_DATE >= @date0101
	AND OBO.WORK_EFFORT_ID = ?]]></xml-property>
        </oda-data-set>
