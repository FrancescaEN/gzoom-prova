            <method name="beforeOpen"><![CDATA[//this.queryText = this.queryText.replace("@excludePerformanceKPI", "'" + params["excludePerformanceKPI"].value+ "'");
//this.queryText = this.queryText.replace("@excludeValidity", "'" + params["excludeValidity"].value+ "'");
/**/
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value );
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );																
this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );


/*
this.queryText = this.queryText.replace("@date0101",  "CONVERT(DATETIME, '2021-01-01', 121)" );
this.queryText = this.queryText.replace("@date3112",  "CONVERT(DATETIME, '2021-01-01', 121)" );
this.queryText = this.queryText.replace("@monitoringDate",  "CONVERT(DATETIME, '2021-01-01', 121)" );
*/

//@orgUnitId
var orgUnitIdString = '';
if (params["orgUnitId"].value != null &amp;&amp; params["orgUnitId"].value != '') {
	orgUnitIdString = "and (oo.org_unit_id = '"+ params["orgUnitId"].value + "' or so.org_unit_id = '"+ params["orgUnitId"].value + "')";	
}
this.queryText = this.queryText.replace("@orgUnitId",  orgUnitIdString );

//@partyId Reponsabilità politica ass_party_id
var partyId = '';
if (params["partyId"].value != null &amp;&amp; params["partyId"].value != '') {
	partyId = " and (ass.party_id is not null and ass.party_id = '"+params["partyId"].value+"') ";
}
this.queryText = this.queryText.replace("@partyId",  partyId );


//@personId Responsabilità tecnica resp_party_id
var personId = '';
if (params["personId"].value != null &amp;&amp; params["personId"].value != '') {
	personId = "and ((uooopa.party_id is not null and uooopa.party_id = '"+params["personId"].value+"') or (uosopa.party_id is not null and uosopa.party_id = '"+params["personId"].value+"'))";
}
this.queryText = this.queryText.replace("@personId",  personId );

//WorkEffortId->WorkEffortIdChild
//ReportLog.info("workEffortIdParametric "+params["workEffortIdParametric"].value);
///*
var workEffortId = '';
if (params["workEffortIdParametric"].value != null &amp;&amp; params["workEffortIdParametric"].value != '') {
	workEffortId = "and (lm.work_effort_id in ("+params["workEffortIdParametric"].value+") or os.work_effort_id in ("+params["workEffortIdParametric"].value+") or oo.work_effort_name in ("+params["workEffortIdParametric"].value+")"
	+" or ri.work_effort_id in ("+params["workEffortIdParametric"].value+") or oo.work_effort_name in ("+params["workEffortIdParametric"].value+") or pr.work_effort_id in ("+params["workEffortIdParametric"].value+") or mi.work_effort_id in ("+params["workEffortIdParametric"].value+") or so.work_effort_id in ("+params["workEffortIdParametric"].value+")) ";
} else if (params["workEffortId"].value != null &amp;&amp; params["workEffortId"].value != '')
{
   workEffortId = "and (lm.work_effort_id = '"+params["workEffortId"].value+"' or os.work_effort_id = '"+params["workEffortId"].value+"' or oo.work_effort_name = '"+params["workEffortId"].value+"'"
	+" or ri.work_effort_id = '"+params["workEffortId"].value+"' or oo.work_effort_name = '"+params["workEffortId"].value+"' or pr.work_effort_id = '"+params["workEffortId"].value+"' or mi.work_effort_id = '"+params["workEffortId"].value+"' or so.work_effort_id = '"+params["workEffortId"].value+"') ";
}
//*/
this.queryText = this.queryText.replace("@workEffortId",  workEffortId );
//@workEffortEtch
var workEffortEtch = '';
if(params["workEffortEtch"].value!=null &amp;&amp; params["workEffortEtch"].value!= '') {
	workEffortEtch = " and FIL_W.ETCH like '%"+params["workEffortEtch"].value+"%' ";
}
this.queryText = this.queryText.replace("@workEffortEtch",  workEffortEtch );

//@codiceObpeg
var codiceObpeg = '';
if(params["codiceObpeg"].value!=null &amp;&amp; params["codiceObpeg"].value!= '') {
	codiceObpeg = " and FIL_W.SOURCE_REFERENCE_ID like '%"+params["codiceObpeg"].value+"%' ";
}
this.queryText = this.queryText.replace("@codiceObpeg",  codiceObpeg );

//@workEffortName
var workEffortName = '';
if(params["workEffortName"].value!=null &amp;&amp; params["workEffortName"].value!= '') {
	workEffortName = " and FIL_W.work_effort_name like '%"+params["workEffortName"].value+"%' ";
}
this.queryText = this.queryText.replace("@workEffortName",  workEffortName );

//Revision id
var revision = '';
if(params["workEffortRevision"].value != null &amp;&amp; params["workEffortRevision"].value != '') {
	revision = " and pm.work_effort_revision_id = '"+params["workEffortRevision"].value+"'";
}
else {
	revision = " and pm.work_effort_revision_id is null ";
}
this.queryText = this.queryText.replace("@revision",  revision );

//WorkEffortId->WorkEffortIdChild
var workEffortId = '';
if (params["workEffortIdChild"].value != null &amp;&amp; params["workEffortIdChild"].value != '') {
	workEffortId = "and (lm.work_effort_id = '"+params["workEffortIdChild"].value+"' or os.work_effort_id = '"+params["workEffortIdChild"].value+"' or oo.work_effort_id = '"+params["workEffortIdChild"].value+"'"
	+"or pr.work_effort_id = '"+params["workEffortIdChild"].value+"' or mi.work_effort_id = '"+params["workEffortIdChild"].value+"' or so.work_effort_id = '"+params["workEffortIdChild"].value+"') ";
}
this.queryText = this.queryText.replace("@workEffortId",  workEffortId );

//GESTIRE PERMESSI
/**/
filter = new com.mapsengineering.base.birt.util.UtilFilter(params["userLoginId"].value, params["localDispatcherName"].value);
var filterInnerJoin = filter.getWorkEffortFilterInner();
var filterLeftJoin = filter.getWorkEffortFilterLeftJoin();
var filterWhere = filter.getWorkEffortFilterWhere();

/*
var filterInnerJoin = "";
var filterLeftJoin = "";
var filterWhere = "";
*/

this.queryText = this.queryText.replace("@filterInnerJoin",  filterInnerJoin );
this.queryText = this.queryText.replace("@filterLeftJoin",  filterLeftJoin );
this.queryText = this.queryText.replace("@filterWhere",  filterWhere );


ReportLog.info("MasterDS "+this.queryText);]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet"/>
            <xml-property name="queryText"><![CDATA[select
lm.etch as codice_linea, lm.work_effort_name as titolo_lineamandato, 
os.etch as codice_obistrategico, os.work_effort_name as titolo_obistrategico, osd.note_info as descr_obistrategico, 
oo.etch as codice_obioperativo, oo.work_effort_name as titolo_obioperativo,  ood.note_info as descr_obioperativo, 
uoooc.parent_role_code as codice_uoresp, uooo.external_id as codso4_uoresp, 
uooog.comments codcdr_uoresp, uooo.party_name as uoresp_operativo,
uooopa.party_name as resp_tecnico,
ooass.sequence_num as seq_refpol, assrole.role_type_id as tipo_refpole, assrole.description as ruolo_refpol, ass.party_name as referente_politico, 
pr.etch as codice_programma, pr.work_effort_name as programma, 
mi.etch as codice_missione, mi.work_effort_name as missione, 
so.etch as codice_sottobiettivo, so.work_effort_name as sottoobiettivo, 
uosoc.parent_role_code as codice_altrauo, uoso.external_id as codso4_altrauo, 
uosog.comments as codcdr_altrauo, uoso.party_name as altreuo_operativo,
uosopa.party_name as altro_resp_tecnico, 
oo.work_effort_id as oo_work_effort, os.work_effort_id as so_work_effort,
aer.amount as valutazione_valore, ris.comments as valutazione_descrizione, drr.object_info as valutazione_emoticon,
aer_tr.amount as valutazione_valore_trend, ris_tr.comments as valutazione_descrizione_trend, drr_tr.object_info as valutazione_emoticon_trend,
n310os.note_info as valutazione_attivita_strat, n310oo.note_info as valutazione_attivita_op,
aer2.amount as valutazione_valore_st, drr2.object_info as valutazione_emoticon_st, aer_tr2.amount as valutazione_valore_trend_st, drr_tr2.object_info as valutazione_emoticon_trend_st,
lm.location_desc as colore_scuro, lm.info_url as colore_chiaro, lm.work_effort_id as lm_work_effort_id
from work_effort pm
inner join work_effort_type pmt on pmt.work_effort_type_id = pm.work_effort_type_id
inner join work_effort_assoc pmlm on pmlm.work_effort_id_from = pm.work_effort_id
 and pmlm.work_effort_assoc_type_id = '20D6'
inner join work_effort lm on lm.work_effort_id = pmlm.work_effort_id_to
and lm.estimated_start_date <= @date3112     -- 'AAAA(input.ref_date)-12-31'
and lm.estimated_completion_date >= @date0101 -- 'AAAA(input.ref_date)-01-01'
inner join work_effort_assoc lmos on lmos.work_effort_id_from = lm.work_effort_id
 and lmos.work_effort_assoc_type_id = '20D6'
 and lmos.from_date <= @monitoringDate and lmos.thru_date >= @monitoringDate  -- input.ref_date
inner join work_effort os on os.work_effort_id = lmos.work_effort_id_to
  and os.estimated_start_date <= @date3112      -- 'AAAA(input.ref_date)-12-31'
  and os.estimated_completion_date >= @date0101 -- 'AAAA(input.ref_date)-01-01'
inner join work_effort_type ost on ost.work_effort_type_id = os.work_effort_type_id 
inner join work_effort_note osn on osn.work_effort_id = os.work_effort_id and osn.is_main = 'Y'
inner join note_data osd on osd.note_id = osn.note_id
inner join work_effort_assoc osoo on osoo.work_effort_id_from = os.work_effort_id
 and osoo.work_effort_assoc_type_id = '20D6C'
inner join work_effort FIL_W on
	FIL_W.work_effort_id = osoo.work_effort_id_to
  and FIL_W.estimated_start_date <= @date3112      -- 'AAAA(input.ref_date)-12-31'
  and FIL_W.estimated_completion_date >= @date0101 -- 'AAAA(input.ref_date)-01-01'
inner join work_effort oo on oo.work_effort_id = osoo.work_effort_id_to
  and oo.estimated_start_date <= @date3112      -- 'AAAA(input.ref_date)-12-31'
  and oo.estimated_completion_date >= @date0101 -- 'AAAA(input.ref_date)-01-01'
inner join work_effort_type oot on oot.work_effort_type_id = oo.work_effort_type_id 
inner join work_effort_note oon on oon.work_effort_id = oo.work_effort_id and oon.is_main = 'Y'
inner join note_data ood on ood.note_id = oon.note_id

--left join work_effort_assoc riop on
--	riop.work_effort_id_to = oo.work_effort_id
--	and riop.work_effort_assoc_type_id in(
--		'20R2C',
--		'20R6C',
--		'20R8C'
--	)

	
left join work_effort_assoc riop on
	riop.work_effort_id_to = FIL_W.work_effort_id
	and riop.work_effort_assoc_type_id like('20R%')
	

left join work_effort ri on
	riop.work_effort_id_from is not null
	and ri.work_effort_id = riop.work_effort_id_from
	and(
		ri.estimated_start_date is null
		or ri.estimated_start_date <= @date3112
	) -- 'AAAA(input.ref_date)-12-31'
	and(
		ri.estimated_completion_date is null
		or ri.estimated_completion_date >= @date0101
	) -- 'AAA(input.ref_date)-01-01'

inner join party uooo on uooo.party_id = oo.org_unit_id
inner join party_parent_role uoooc on uoooc.party_id = uooo.party_id
  and uoooc.role_type_id = 'ORGANIZATION_UNIT'
inner join party_group uooog on uooog.party_id = uooo.party_id
left join party_relationship uooore on uooore.party_id_from = uooo.party_id
  and uooore.party_relationship_type_id = 'ORG_RESPONSIBLE'
  and (uooore.from_date is null or uooore.from_date <= @monitoringDate) -- input.ref_date
  and (uooore.thru_date is null or uooore.thru_date >= @monitoringDate) -- input.ref_date
  and uooore.from_date <= oo.estimated_completion_date
  and (uooore.thru_date is null or uooore.thru_date >= oo.estimated_start_date)
left join party uooopa on uooore.party_id_to is not null
 and uooopa.party_id = uooore.party_id_to
left join work_effort_party_assignment ooass on ooass.work_effort_id = oo.work_effort_id
  and (ooass.from_date is null or ooass.from_date <= @monitoringDate) -- input.ref_date
  and (ooass.thru_date is null or ooass.thru_date >= @monitoringDate) -- input.ref_date
left join party ass on ooass.party_id is not null
 and ass.party_id = ooass.party_id
left join role_type assrole on ooass.role_type_id is not null
 and assrole.role_type_id = ooass.role_type_id
inner join work_effort_assoc proo on proo.work_effort_id_to = oo.work_effort_id
 and proo.work_effort_assoc_type_id = '20D2C'
 and proo.from_date <= @monitoringDate and proo.thru_date >= @monitoringDate  -- input.ref_date
inner join work_effort pr on pr.work_effort_id = proo.work_effort_id_from
inner join work_effort_assoc mipr on mipr.work_effort_id_to = pr.work_effort_id
 and mipr.work_effort_assoc_type_id = '20D2'
 and mipr.from_date <= @monitoringDate and mipr.thru_date >= @monitoringDate  -- input.ref_date
inner join work_effort mi on mi.work_effort_id = mipr.work_effort_id_from
inner join work_effort_assoc bimi on bimi.work_effort_id_to = mi.work_effort_id
 and bimi.work_effort_assoc_type_id = '20D2'
 and bimi.from_date <= @monitoringDate and bimi.thru_date >= @monitoringDate  -- input.ref_date
inner join work_effort bi on bi.work_effort_id = bimi.work_effort_id_from

@filterInnerJoin
@filterLeftJoin

left join work_effort_assoc ooso on ooso.work_effort_id_from = oo.work_effort_id
 and ooso.work_effort_assoc_type_id = '20D6O'
 and ooso.from_date <= @monitoringDate and ooso.thru_date >= @monitoringDate  -- input.ref_date
left join work_effort so on ooso.work_effort_id_to is not null
 and so.work_effort_id = ooso.work_effort_id_to
 and (so.estimated_start_date is null or so.estimated_start_date <= @date3112)           -- 'AAAA(input.ref_date)-12-31'
 and (so.estimated_completion_date is null or so.estimated_completion_date >= @date0101) -- 'AAA(input.ref_date)-01-01'
left join party uoso on so.org_unit_id is not null
 and uoso.party_id = so.org_unit_id
left join party_parent_role uosoc on uoso.party_id is not null
 and uosoc.party_id = uoso.party_id
 and uosoc.role_type_id = 'ORGANIZATION_UNIT'
left join party_group uosog on uoso.party_id is not null
 and  uosog.party_id = uoso.party_id
left join party_relationship uosore on uoso.party_id is not null
 and uosore.party_id_from = uoso.party_id
 and uosore.party_relationship_type_id = 'ORG_RESPONSIBLE'
 and (uosore.from_date is null or uosore.from_date <= @monitoringDate) -- input.ref_date
 and (uosore.thru_date is null or uosore.thru_date >= @monitoringDate) -- input.ref_date
 and uosore.from_date <= so.estimated_completion_date
 and (uosore.thru_date is null or uosore.thru_date >= so.estimated_start_date)
 
left join party uosopa on uosore.party_id_to is not null and uosopa.party_id = uosore.party_id_to

 left join work_effort_measure oxm on   oxm.gl_account_id = 'SCORE'
  and oxm.work_effort_id = oo.work_effort_id  -- Se stampa operativa
left join acctg_trans atr on oxm.work_effort_measure_id is not null
  and atr.voucher_ref = oxm.work_effort_measure_id
  and atr.transaction_date = @monitoringDate  --input.ref_date
  and atr.gl_fiscal_type_id = 'ACTUAL'
left join acctg_trans_entry aer on atr.acctg_trans_id is not null
  and aer.acctg_trans_id = atr.acctg_trans_id
left join uom_range_values ris on aer.amount is not null
  and ris.uom_range_id = oot.uom_range_score_id   -- Se stampa operativa
  and ris.from_value <= aer.amount and ris.thru_value >= aer.amount
left join content cor on ris.icon_content_id is not null
  and cor.content_id = ris.icon_content_id
left join data_resource drr on cor.data_resource_id is not null
  and drr.data_resource_id = cor.data_resource_id
left join acctg_trans atr_tr on oxm.work_effort_measure_id is not null
  and atr_tr.voucher_ref = oxm.work_effort_measure_id
  and atr_tr.transaction_date = @monitoringDate  --input.ref_date
  and atr_tr.gl_fiscal_type_id = 'TREND'
left join acctg_trans_entry aer_tr on atr_tr.acctg_trans_id is not null
  and aer_tr.acctg_trans_id = atr_tr.acctg_trans_id
left join uom_range_values ris_tr on aer_tr.amount is not null
  and ris_tr.uom_range_id = oot.uom_range_score_id   -- Se stampa operativa
  and ris_tr.from_value <= aer_tr.amount and ris_tr.thru_value >= aer_tr.amount
left join content cor_tr on ris_tr.icon_content_id is not null
  and cor_tr.content_id = ris_tr.icon_content_id
left join data_resource drr_tr on cor_tr.data_resource_id is not null
  and drr_tr.data_resource_id = cor_tr.data_resource_id
 
left join work_effort_measure oxm2 on   oxm2.gl_account_id = 'SCORE'
  and oxm2.work_effort_id = os.work_effort_id  -- Se stampa operativa
left join acctg_trans atr2 on oxm2.work_effort_measure_id is not null
  and atr2.voucher_ref = oxm2.work_effort_measure_id
  and atr2.transaction_date = @monitoringDate  --input.ref_date
  and atr2.gl_fiscal_type_id = 'ACTUAL'
left join acctg_trans_entry aer2 on atr2.acctg_trans_id is not null
  and aer2.acctg_trans_id = atr2.acctg_trans_id
left join uom_range_values ris2 on aer2.amount is not null
  and ris2.uom_range_id = ost.uom_range_score_id   -- Se stampa operativa
  and ris2.from_value <= aer2.amount and ris2.thru_value >= aer2.amount
left join content cor2 on ris2.icon_content_id is not null
  and cor2.content_id = ris2.icon_content_id
left join data_resource drr2 on cor2.data_resource_id is not null
  and drr2.data_resource_id = cor2.data_resource_id
left join acctg_trans atr_tr2 on oxm2.work_effort_measure_id is not null
  and atr_tr2.voucher_ref = oxm2.work_effort_measure_id
  and atr_tr2.transaction_date = @monitoringDate  --input.ref_date
  and atr_tr2.gl_fiscal_type_id = 'TREND'
left join acctg_trans_entry aer_tr2 on atr_tr2.acctg_trans_id is not null
  and aer_tr2.acctg_trans_id = atr_tr2.acctg_trans_id
left join uom_range_values ris_tr2 on aer_tr2.amount is not null
  and ris_tr2.uom_range_id = ost.uom_range_score_id   -- Se stampa operativa
  and ris_tr2.from_value <= aer_tr2.amount and ris_tr2.thru_value >= aer_tr2.amount
left join content cor_tr2 on ris_tr2.icon_content_id is not null
  and cor_tr2.content_id = ris_tr2.icon_content_id
left join data_resource drr_tr2 on cor_tr2.data_resource_id is not null
  and drr_tr2.data_resource_id = cor_tr2.data_resource_id  
  
left join work_effort_note_view n310os on n310os.work_effort_id = os.work_effort_id 
  and n310os.sequence_id = 310 and n310os.note_date_time = @monitoringDate
left join work_effort_note_view n310oo on n310oo.work_effort_id = oo.work_effort_id 
  and n310oo.sequence_id = 310 and n310oo.note_date_time = @monitoringDate    

where 1=1
-- and (uooo.party_id = '10019' or (uoso.party_id is not null and uoso.party_id = '10019'))   -- input.uorg_uni_id (se valorizzato)
-- and (ass.party_id is not null and ass.party_id = '10170')    -- input.ass_party_id (se valorizzato)
@partyId
@personId
@revision
@codiceObpeg
@workEffortEtch
@workEffortName
--  and ((uooopa.party_id is not null and uooopa.party_id = 'admin') or (uosopa.party_id is not null and uosopa.party_id = 'admin')) -- input.resp-party_id (se valorizzato)
@workEffortId--  and (lm.work_effort_id = '10103' or os.work_effort_id = '10103' or oo.work_effort_id = '10103'
--   or pr.work_effort_id = '10103' or mi.work_effort_id = '10103' or so.work_effort_id = '10103')   -- input.work_effort_id (se valorizzato)
@filterWhere
@orgUnitId]]></xml-property>
