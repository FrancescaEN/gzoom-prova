                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">Etichetta OBO</property>
                    <property name="nativeName">Etichetta OBO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">Nome OBO</property>
                    <property name="nativeName">Nome OBO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">Cod MOGE</property>
                    <property name="nativeName">Cod MOGE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">ELENCO ANNUALE LL.PP.</property>
                    <property name="nativeName">ELENCO ANNUALE LL.PP.</property>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">Descrizione breve</property>
                    <property name="nativeName">Descrizione breve</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">Finanziamento</property>
                    <property name="nativeName">Finanziamento</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">Nome intervento</property>
                    <property name="nativeName">Nome intervento</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">9</property>
                    <property name="name">Totale quadro economico</property>
                    <property name="nativeName">Totale quadro economico</property>
                    <property name="dataType">float</property>
                </structure>
