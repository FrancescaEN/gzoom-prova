        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="AltreUODSNew" id="59316">
            <list-property name="columnHints"/>
            <list-property name="parameters">
                <structure>
                    <property name="name">workEffortId</property>
                    <property name="nativeName"></property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">0</property>
                    <property name="position">1</property>
                    <expression name="defaultValue" type="constant">N/A</expression>
                    <property name="isOptional">false</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">codice_altrauo</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">altreuo_operativo</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">codice_altrauo_hist</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">4</property>
                        <property name="name">altreuo_operativo_hist</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">5</property>
                        <property name="name">altreuo_alt</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <method name="beforeOpen"><![CDATA[//this.queryText = this.queryText.replace("@excludePerformanceKPI", "'" + params["excludePerformanceKPI"].value+ "'");
//this.queryText = this.queryText.replace("@excludeValidity", "'" + params["excludeValidity"].value+ "'");
/**/
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value );
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );															
this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );	

/*
this.queryText = this.queryText.replace("@date0101",  "'2020-01-01 00:00:00.000'" );
this.queryText = this.queryText.replace("@date3112",  "'2020-12-31 00:00:00.000'" );
this.queryText = this.queryText.replace("@monitoringDate",  "'2020-12-31 00:00:00.000'" ); */


//Debug.log("... this.queryText= "+this.queryText);

//ReportLog.info("AltreUO this.queryText= "+this.queryText);]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">codice_altrauo</property>
                    <property name="nativeName">codice_altrauo</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">altreuo_operativo</property>
                    <property name="nativeName">altreuo_operativo</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">codice_altrauo_hist</property>
                    <property name="nativeName">codice_altrauo_hist</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">altreuo_operativo_hist</property>
                    <property name="nativeName">altreuo_operativo_hist</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">altreuo_alt</property>
                    <property name="nativeName">altreuo_alt</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select
	uosoc.parent_role_code as codice_altrauo,
	uoso.party_name as altreuo_operativo,
	hist.codice_uoresp as codice_altrauo_hist,
	hist.party_name as altreuo_operativo_hist,
	pn1.group_name as altreuo_alt
from
	work_effort_assoc ooso
inner join work_effort so on
	so.work_effort_id = ooso.work_effort_id_to
	
inner join party uoso on
	uoso.party_id = so.org_unit_id
inner join party_parent_role uosoc on
	uosoc.party_id = uoso.party_id
	and uosoc.role_type_id = 'ORGANIZATION_UNIT'
inner join party_group uosog on
	uosog.party_id = uoso.party_id
	
inner join (select
	(
		case
			when st.org_unit_id is not null then st.org_unit_id
			else w.org_unit_id
		end
	) org_unit_id, st.party_name, st.codice_uoresp, w.work_effort_id 
from
	work_effort w 
	-- obiettivo operativo  
left join(
		select
			wp.work_effort_id,
			p.party_name,
			wp.party_id org_unit_id,
			uoooc.parent_role_code as codice_uoresp 
		from
			work_effort_party_assignment wp
		inner join role_type r on
			wp.role_type_id = r.role_type_id
			and r.parent_type_id = 'ORGANIZATION_UNIT'
		inner join party p
 			on wp.party_id = p.party_id
 		inner join party_parent_role uoooc on uoooc.party_id = p.party_id
  			and uoooc.role_type_id = 'ORGANIZATION_UNIT'
		where
			wp.from_date <=  @monitoringDate
			and wp.thru_date >=  @monitoringDate
	) st
on
	st.work_effort_id = w.work_effort_id
) hist on so.work_effort_id = hist.work_effort_id


	
left outer join party_name_history pn1 on
	pn1.party_id = hist.org_unit_id
	and exists(
		select
			party_id as party_id,
			change_date as change_date
		from
			(
				select
					party_id as party_id,
					min( change_date ) as change_date
				from
					party_name_history pn3
				where
					pn3.change_date >= @monitoringDate
				group by
					party_id
			) pn2
		where
			pn2.party_id = pn1.party_id
			and pn2.change_date = pn1.change_date
	)
where
	ooso.work_effort_id_from = ? -- input.work_effort_id 
	and ooso.work_effort_assoc_type_id = '20D6O'
	and ooso.from_date <= @monitoringDate
	and ooso.thru_date >= @monitoringDate
order by
	uosoc.parent_role_code
	
	]]></xml-property>
