            <xml-property name="queryText"><![CDATA[select
	ri.tipo_riferimento,
	max(case when ri.riferimento = '1' then ri.ETCH else null end) as codice_riferimento_1,
	max(case when ri.riferimento = '1' then ri.WORK_EFFORT_NAME else null end) as titolo_riferimento_1,
	max(case when ri.riferimento = '1' then ri.DESCRIPTION else null end) as descrizione_riferimento_1,
	max(case when ri.riferimento = '1' then ri.OBJECT_INFO else null end) as object_info_1,
	max(case when ri.riferimento = '2' then ri.ETCH else null end) as codice_riferimento_2,
	max(case when ri.riferimento = '2' then ri.WORK_EFFORT_NAME else null end) as titolo_riferimento_2,
	max(case when ri.riferimento = '2' then ri.DESCRIPTION else null end) as descrizione_riferimento_2,
	max(case when ri.riferimento = '2' then ri.OBJECT_INFO else null end) as object_info_2,
	max(case when ri.riferimento = '3' then ri.ETCH else null end) as codice_riferimento_3,
	max(case when ri.riferimento = '3' then ri.WORK_EFFORT_NAME else null end) as titolo_riferimento_3,
	max(case when ri.riferimento = '3' then ri.DESCRIPTION else null end) as descrizione_riferimento_3,
	max(case when ri.riferimento = '3' then ri.OBJECT_INFO else null end) as object_info_3,
	max(case when ri.riferimento = '4' then ri.ETCH else null end) as codice_riferimento_4,
	max(case when ri.riferimento = '4' then ri.WORK_EFFORT_NAME else null end) as titolo_riferimento_4,
	max(case when ri.riferimento = '4' then ri.DESCRIPTION else null end) as descrizione_riferimento_4,
	max(case when ri.riferimento = '4' then ri.OBJECT_INFO else null end) as object_info_4,
	max(case when ri.riferimento = '5' then ri.ETCH else null end) as codice_riferimento_5,
	max(case when ri.riferimento = '5' then ri.WORK_EFFORT_NAME else null end) as titolo_riferimento_5,
	max(case when ri.riferimento = '5' then ri.DESCRIPTION else null end) as descrizione_riferimento_5,
	max(case when ri.riferimento = '5' then ri.OBJECT_INFO else null end) as object_info_5,
	max(case when ri.riferimento = '6' then ri.ETCH else null end) as codice_riferimento_6,
	max(case when ri.riferimento = '6' then ri.WORK_EFFORT_NAME else null end) as titolo_riferimento_6,
	max(case when ri.riferimento = '6' then ri.DESCRIPTION else null end) as descrizione_riferimento_6,
	max(case when ri.riferimento = '6' then ri.OBJECT_INFO else null end) as object_info_6,
	max(case when ri.riferimento = '7' then ri.ETCH else null end) as codice_riferimento_7,
	max(case when ri.riferimento = '7' then ri.WORK_EFFORT_NAME else null end) as titolo_riferimento_7,
	max(case when ri.riferimento = '7' then ri.DESCRIPTION else null end) as descrizione_riferimento_7,
	max(case when ri.riferimento = '7' then ri.OBJECT_INFO else null end) as object_info_7,
	max(case when ri.riferimento = '8' then ri.ETCH else null end) as codice_riferimento_8,
	max(case when ri.riferimento = '8' then ri.WORK_EFFORT_NAME else null end) as titolo_riferimento_8,
	max(case when ri.riferimento = '8' then ri.DESCRIPTION else null end) as descrizione_riferimento_8,
	max(case when ri.riferimento = '8' then ri.OBJECT_INFO else null end) as object_info_8,
	max(case when ri.riferimento = '9' then ri.ETCH else null end) as codice_riferimento_9,
	max(case when ri.riferimento = '9' then ri.WORK_EFFORT_NAME else null end) as titolo_riferimento_9,
	max(case when ri.riferimento = '9' then ri.DESCRIPTION else null end) as descrizione_riferimento_9,
	max(case when ri.riferimento = '9' then ri.OBJECT_INFO else null end) as object_info_9,
	max(case when ri.riferimento = '10' then ri.ETCH else null end) as codice_riferimento_10,
	max(case when ri.riferimento = '10' then ri.WORK_EFFORT_NAME else null end) as titolo_riferimento_10,
	max(case when ri.riferimento = '10' then ri.DESCRIPTION else null end) as descrizione_riferimento_10,
	max(case when ri.riferimento = '10' then ri.OBJECT_INFO else null end) as object_info_10,
	max(case when ri.riferimento = '11' then ri.ETCH else null end) as codice_riferimento_11,
	max(case when ri.riferimento = '11' then ri.WORK_EFFORT_NAME else null end) as titolo_riferimento_11,
	max(case when ri.riferimento = '11' then ri.DESCRIPTION else null end) as descrizione_riferimento_11,
	max(case when ri.riferimento = '11' then ri.OBJECT_INFO else null end) as object_info_11,
	max(case when ri.riferimento = '12' then ri.ETCH else null end) as codice_riferimento_12,
	max(case when ri.riferimento = '12' then ri.WORK_EFFORT_NAME else null end) as titolo_riferimento_12,
	max(case when ri.riferimento = '12' then ri.DESCRIPTION else null end) as descrizione_riferimento_12,
	max(case when ri.riferimento = '12' then ri.OBJECT_INFO else null end) as object_info_12,
	max(case when ri.riferimento = '13' then ri.ETCH else null end) as codice_riferimento_13,
	max(case when ri.riferimento = '13' then ri.WORK_EFFORT_NAME else null end) as titolo_riferimento_13,
	max(case when ri.riferimento = '13' then ri.DESCRIPTION else null end) as descrizione_riferimento_13,
	max(case when ri.riferimento = '13' then ri.OBJECT_INFO else null end) as object_info_13,
	max(case when ri.riferimento = '14' then ri.ETCH else null end) as codice_riferimento_14,
	max(case when ri.riferimento = '14' then ri.WORK_EFFORT_NAME else null end) as titolo_riferimento_14,
	max(case when ri.riferimento = '14' then ri.DESCRIPTION else null end) as descrizione_riferimento_14,
	max(case when ri.riferimento = '14' then ri.OBJECT_INFO else null end) as object_info_14,
	max(case when ri.riferimento = '15' then ri.ETCH else null end) as codice_riferimento_15,
	max(case when ri.riferimento = '15' then ri.WORK_EFFORT_NAME else null end) as titolo_riferimento_15,
	max(case when ri.riferimento = '15' then ri.DESCRIPTION else null end) as descrizione_riferimento_15,
	max(case when ri.riferimento = '15' then ri.OBJECT_INFO else null end) as object_info_15,
	max(case when ri.riferimento = '16' then ri.ETCH else null end) as codice_riferimento_16,
	max(case when ri.riferimento = '16' then ri.WORK_EFFORT_NAME else null end) as titolo_riferimento_16,
	max(case when ri.riferimento = '16' then ri.DESCRIPTION else null end) as descrizione_riferimento_16,
	max(case when ri.riferimento = '16' then ri.OBJECT_INFO else null end) as object_info_16,
	max(case when ri.riferimento = '17' then ri.ETCH else null end) as codice_riferimento_17,
	max(case when ri.riferimento = '17' then ri.WORK_EFFORT_NAME else null end) as titolo_riferimento_17,
	max(case when ri.riferimento = '17' then ri.DESCRIPTION else null end) as descrizione_riferimento_17,
	max(case when ri.riferimento = '17' then ri.OBJECT_INFO else null end) as object_info_17
	FROM 
(select rit.description tipo_riferimento, 
    r.SOURCE_REFERENCE_ID ,r.etch,  dr.OBJECT_INFO, r.WORK_EFFORT_NAME, r.description ,  ROW_NUMBER() over(order by SOURCE_reference_id )  riferimento
	from work_effort_assoc riop
inner join work_effort r on r.work_effort_id = riop.work_effort_id_from
inner join work_effort_type rit on rit.work_effort_type_id = r.work_effort_type_id
left join work_effort_content wec on wec.work_effort_id = r.work_effort_id
left join content co on co.content_id = wec.content_id
left join data_resource dr on dr.data_resource_id = co.data_resource_id    
where
       riop.work_effort_id_to = ? -- main.identificativo_obipeg
       and 
       riop.work_effort_assoc_type_id like '20R%'
       and riop.from_date <= @monitoringDate    -- input.ref_date
    and riop.thru_date >= @monitoringDate    -- input.ref_date 
       and rit.work_effort_type_id = '20R31PAR' ) RI
group by 
	ri.tipo_riferimento   
;
]]></xml-property>
        </oda-data-set>
