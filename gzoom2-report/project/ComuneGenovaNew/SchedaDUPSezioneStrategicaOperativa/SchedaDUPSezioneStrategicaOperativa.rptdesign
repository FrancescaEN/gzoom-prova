        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="OrgUnitHistDS" id="59318">
            <list-property name="columnHints"/>
            <list-property name="parameters">
                <structure>
                    <property name="name">param_1</property>
                    <property name="nativeName"></property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">0</property>
                    <property name="position">1</property>
                    <expression name="defaultValue" type="constant">N/A</expression>
                    <property name="isOptional">false</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">org_unit_id</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">party_name</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">codice_uoresp</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <method name="beforeOpen"><![CDATA[this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );

//this.queryText = this.queryText.replace("@monitoringDate",  "'2020-12-31 00:00:00.000'" );

//ReportLog.info("OrgUnitHist "+this.queryText);]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">org_unit_id</property>
                    <property name="nativeName">org_unit_id</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">party_name</property>
                    <property name="nativeName">party_name</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">codice_uoresp</property>
                    <property name="nativeName">codice_uoresp</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select
	(
		case
			when st.org_unit_id is not null then st.org_unit_id
			else w.org_unit_id
		end
	) org_unit_id, st.party_name, st.codice_uoresp 
from
	work_effort w 
	-- obiettivo operativo  
left join(
		select
			wp.work_effort_id,
			p.party_name,
			wp.party_id org_unit_id,
			uoooc.parent_role_code as codice_uoresp 
		from
			work_effort_party_assignment wp
		inner join role_type r on
			wp.role_type_id = r.role_type_id
			and r.parent_type_id = 'ORGANIZATION_UNIT'
		inner join party p
 			on wp.party_id = p.party_id
 		inner join party_parent_role uoooc on uoooc.party_id = p.party_id
  			and uoooc.role_type_id = 'ORGANIZATION_UNIT'
		where
			wp.from_date <=  @monitoringDate
			and wp.thru_date >=  @monitoringDate
	) st
on
	st.work_effort_id = w.work_effort_id
where
	w.work_effort_id = ?]]></xml-property>
        </oda-data-set>
