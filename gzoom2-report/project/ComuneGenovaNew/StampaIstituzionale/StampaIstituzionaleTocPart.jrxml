	<group name="ObiettivoStrategicoGroup" keepTogether="true">
		<groupExpression><![CDATA[$F{Obiettivo strategico}]]></groupExpression>
		<groupHeader>
			<band height="57">
				<property name="com.jaspersoft.studio.unit.height" value="px"/>
				<frame>
					<reportElement positionType="Float" mode="Opaque" x="0" y="1" width="554" height="16" forecolor="#FFFFFF" backcolor="#F2F0F0" uuid="adb7c0df-01af-45dd-8e7a-812c76ed0de3">
						<property name="com.jaspersoft.studio.unit.width" value="px"/>
					</reportElement>
					<box>
						<pen lineWidth="1.0" lineColor="#D5D5D5"/>
						<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#D5D5D5"/>
						<leftPen lineWidth="1.0" lineStyle="Solid" lineColor="#D5D5D5"/>
						<bottomPen lineWidth="1.0" lineStyle="Solid" lineColor="#D5D5D5"/>
						<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#D5D5D5"/>
