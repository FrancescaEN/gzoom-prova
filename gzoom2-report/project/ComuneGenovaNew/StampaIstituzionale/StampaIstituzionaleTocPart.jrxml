	<queryString>
		<![CDATA[/* VERSIONE V1.1 CON #COND0# = AAAA
FILTRO SU STRUTTURA 
NUOVE AGGIUNTE DI ALCUNI CAMPI */

SELECT
	YEAR($P{customTimePeriod}) AS "Anno",
	CONCAT(ATT.ETCH, ' - ', ATT.WORK_EFFORT_NAME) AS "Attività",
	CONCAT(PPRSTRUTT.PARENT_ROLE_CODE, ' - ', STRUTT.PARTY_NAME) AS "Soggetto",
	CAST(ND.NOTE_INFO AS CHAR) AS "Descrizione dell'attività svolta",
	-- ALLE.LISTA AS "Allegati", /* DA TRASFORMARE IN STRING_AGG */
	SI.DESCRIPTION AS "Stato attività",
	FORMAT(ATT.ESTIMATED_START_DATE, 'dd/MM/yyyy') AS "Inizio attività",
	FORMAT(ATT.ESTIMATED_COMPLETION_DATE, 'dd/MM/yyyy') AS "Fine attività",
	CONCAT(AZ.ETCH, ' - ', AZ.WORK_EFFORT_NAME) AS "Azione",
	CONCAT(ATTINT.ETCH, ' - ', ATTINT.WORK_EFFORT_NAME) AS "AttivItà integrata",
	CONCAT(AZINT.ETCH, ' - ', AZINT.WORK_EFFORT_NAME) AS "Azione integrata",
	FORMAT(AZINT.ESTIMATED_START_DATE, 'dd/MM/yyyy') AS "Inizio azione integrata",
	FORMAT(AZINT.ESTIMATED_COMPLETION_DATE, 'dd/MM/yyyy') AS "Fine azione integrata",
	SINT.DESCRIPTION AS "Stato azione integrata",
	NOTEAZINT.NOTE_INFO AS "Descrizione azione integrata",
	CONCAT(OBS.ETCH, ' - ', OBS.WORK_EFFORT_NAME) AS "Obiettivo strategico",
	NOTEOBS.NOTE_INFO AS "Descrizione obiettivo strategico",
	CONCAT(PIANO.ETCH, ' - ', PIANO.WORK_EFFORT_NAME) AS "Piano d'azione",
	NOTEPIA.NOTE_INFO AS "Descrizione piano d'azione",
	WEA5.WORK_EFFORT_ASSOC_TYPE_ID 
/* AZIONE DEL COMUNE / AZIONE NON DEL COMUNE */
FROM WORK_EFFORT AZ
/* ATTIVITA' */
JOIN WORK_EFFORT_ASSOC WEA ON WEA.WORK_EFFORT_ID_FROM = AZ.WORK_EFFORT_ID AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '21U4ASO'
JOIN WORK_EFFORT ATT ON ATT.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_TO AND ATT.WORK_EFFORT_TYPE_ID = '21U42ATT' AND ATT.WORK_EFFORT_REVISION_ID IS NULL
	AND ATT.ESTIMATED_START_DATE <= $P{date3112} AND (ATT.ESTIMATED_COMPLETION_DATE >= $P{date0101} OR ATT.ESTIMATED_COMPLETION_DATE IS NULL)
/* STRUTTURA ATTIVITA' */
JOIN PARTY STRUTT ON STRUTT.PARTY_ID = ATT.ORG_UNIT_ID 
JOIN PARTY_PARENT_ROLE PPRSTRUTT ON PPRSTRUTT.PARTY_ID = STRUTT.PARTY_ID
/* STATO ATTIVITA' */
JOIN STATUS_ITEM SI ON SI.STATUS_ID = ATT.CURRENT_STATUS_ID 
/* NOTE ATTIVITA' */
LEFT JOIN WORK_EFFORT_NOTE WEN ON WEN.WORK_EFFORT_ID = ATT.WORK_EFFORT_ID AND WEN.SEQUENCE_ID = 100
LEFT JOIN NOTE_DATA ND ON ND.NOTE_ID = WEN.NOTE_ID

/* ALLEGATI */
/*
LEFT JOIN (
	SELECT
		WEC.WORK_EFFORT_ID,
		CONCAT(WECT.DESCRIPTION, ' - ', C.DESCRIPTION) AS LISTA
	FROM WORK_EFFORT_CONTENT WEC
	JOIN WORK_EFFORT_CONTENT_TYPE WECT ON WECT.WORK_EFFORT_CONTENT_TYPE_ID = WEC.WORK_EFFORT_CONTENT_TYPE_ID
	JOIN CONTENT C ON C.CONTENT_ID = WEC.CONTENT_ID
) ALLE ON ALLE.WORK_EFFORT_ID = ATT.WORK_EFFORT_ID
*/

/* AZIONE INTEGRATA */
LEFT JOIN WORK_EFFORT_ASSOC WEA2 ON WEA2.WORK_EFFORT_ID_TO = AZ.WORK_EFFORT_ID AND WEA2.WORK_EFFORT_ASSOC_TYPE_ID = '21U2AINC'
LEFT JOIN WORK_EFFORT AZINT ON AZINT.WORK_EFFORT_ID = WEA2.WORK_EFFORT_ID_FROM AND AZINT.WORK_EFFORT_TYPE_ID = '21U26AIN' AND AZINT.WORK_EFFORT_REVISION_ID IS NULL
	AND AZINT.ESTIMATED_START_DATE <= $P{date3112}  AND (AZINT.ESTIMATED_COMPLETION_DATE >= $P{date0101} OR AZINT.ESTIMATED_COMPLETION_DATE IS NULL)
/* STATO AZIONE INTEGRATA */
LEFT JOIN STATUS_ITEM SINT ON SINT.STATUS_ID = AZINT.CURRENT_STATUS_ID
/* NOTE AZIONE INTEGRATA */
LEFT JOIN (
	SELECT WEN.WORK_EFFORT_ID, ND.NOTE_INFO 
	FROM WORK_EFFORT_NOTE WEN
	JOIN NOTE_DATA ND ON ND.NOTE_ID = WEN.NOTE_ID AND WEN.SEQUENCE_ID = '100'
) NOTEAZINT ON NOTEAZINT.WORK_EFFORT_ID = AZINT.WORK_EFFORT_ID
/* ATTIVITA' INTEGRATA */
LEFT JOIN WORK_EFFORT_ASSOC WEA5 ON WEA5.WORK_EFFORT_ID_TO = ATT.WORK_EFFORT_ID AND WEA5.WORK_EFFORT_ASSOC_TYPE_ID = 'COPY'
LEFT JOIN WORK_EFFORT ATTINT ON ATTINT.WORK_EFFORT_ID = WEA5.WORK_EFFORT_ID_FROM AND ATTINT.WORK_EFFORT_TYPE_ID = '21U28ATI' AND ATTINT.WORK_EFFORT_REVISION_ID IS NULL
AND ATTINT.ESTIMATED_START_DATE <= $P{date3112} AND (ATTINT.ESTIMATED_COMPLETION_DATE >= $P{date0101} OR ATTINT.ESTIMATED_COMPLETION_DATE IS NULL)
/* OBIETTIVO STRATEGICO */
LEFT JOIN WORK_EFFORT_ASSOC WEA3 ON WEA3.WORK_EFFORT_ID_TO = AZINT.WORK_EFFORT_ID AND WEA3.WORK_EFFORT_ASSOC_TYPE_ID = '21U2OBSC'
LEFT JOIN WORK_EFFORT OBS ON OBS.WORK_EFFORT_ID = WEA3.WORK_EFFORT_ID_FROM AND OBS.WORK_EFFORT_TYPE_ID = '21U24OST' AND OBS.WORK_EFFORT_REVISION_ID IS NULL
	AND OBS.ESTIMATED_START_DATE <= $P{date3112} AND (OBS.ESTIMATED_COMPLETION_DATE >= $P{date0101}  OR OBS.ESTIMATED_COMPLETION_DATE IS NULL)
/* NOTE OBIETTIVO STRATEGICO */
LEFT JOIN (
	SELECT WEN.WORK_EFFORT_ID, ND.NOTE_INFO 
	FROM WORK_EFFORT_NOTE WEN
	JOIN NOTE_DATA ND ON ND.NOTE_ID = WEN.NOTE_ID AND WEN.SEQUENCE_ID = '100'
) NOTEOBS ON NOTEOBS.WORK_EFFORT_ID = OBS.WORK_EFFORT_ID 
/* PIANO AZIONE */
LEFT JOIN WORK_EFFORT_ASSOC WEA4 ON WEA4.WORK_EFFORT_ID_TO = OBS.WORK_EFFORT_ID AND WEA4.WORK_EFFORT_ASSOC_TYPE_ID = '21U2PGE'
LEFT JOIN WORK_EFFORT PIANO ON PIANO.WORK_EFFORT_ID = WEA4.WORK_EFFORT_ID_FROM AND PIANO.WORK_EFFORT_TYPE_ID = '21U22PAZ' AND PIANO.WORK_EFFORT_REVISION_ID IS NULL
	AND PIANO.ESTIMATED_START_DATE <=$P{date3112} AND (PIANO.ESTIMATED_COMPLETION_DATE >=$P{date0101} OR PIANO.ESTIMATED_COMPLETION_DATE IS NULL)
/* NOTE PIANO AZIONE */
LEFT JOIN (
	SELECT WEN.WORK_EFFORT_ID, ND.NOTE_INFO 
	FROM WORK_EFFORT_NOTE WEN
	JOIN NOTE_DATA ND ON ND.NOTE_ID = WEN.NOTE_ID AND WEN.SEQUENCE_ID = '100'
) NOTEPIA ON NOTEPIA.WORK_EFFORT_ID = PIANO.WORK_EFFORT_ID 
WHERE AZ.WORK_EFFORT_TYPE_ID IN ('21U40ASC', '21U40ASO') AND AZ.WORK_EFFORT_REVISION_ID IS NULL
	AND AZ.ESTIMATED_START_DATE <=$P{date3112} AND (AZ.ESTIMATED_COMPLETION_DATE >= $P{date0101}  OR AZ.ESTIMATED_COMPLETION_DATE IS NULL)
ORDER BY
	ATT.ETCH, AZ.ETCH, AZINT.ETCH, OBS.ETCH, PIANO.ETCH]]>
	</queryString>
