            <method name="beforeOpen"><![CDATA[//
workEffortRevisionId = "AND RAD.WORK_EFFORT_REVISION_ID IS NULL AND OB1.WORK_EFFORT_REVISION_ID IS NULL AND OB2.WORK_EFFORT_REVISION_ID IS NULL ";

if (params["workEffortRevision"].value != null &amp;&amp; params["workEffortRevision"].value != '') {
	workEffortRevisionId = "AND RAD.WORK_EFFORT_REVISION_ID = '" + params["workEffortRevision"].value + "' ";
	workEffortRevisionId += "AND OB1.WORK_EFFORT_REVISION_ID = '" + params["workEffortRevision"].value + "' ";
	workEffortRevisionId += "AND OB2.WORK_EFFORT_REVISION_ID = '" + params["workEffortRevision"].value + "' ";
}

this.queryText = this.queryText.replace("@workEffortRevisionId", workEffortRevisionId);

this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value );
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );
this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );
/*
 this.queryText = this.queryText.replace("@monitoringDate", "'2019-12-31 00:00:00.000'");
this.queryText = this.queryText.replace("@date0101",  "'2019-01-01 00:00:00.000'" ); 
this.queryText = this.queryText.replace("@date3112",  "'2019-12-31 00:00:00.000'" ); */
/**/
this.queryText = this.queryText.replace("@excludeValidity", "'" + params["excludeValidity"].value+ "'");
//this.queryText = this.queryText.replace("@userLoginId", "'" + params["userLoginId"].value+ "'");
//this.queryText = this.queryText.replace("@userprofile", "'" + params["userprofile"].value+ "'");

//@workEffortIdChild
var workEffortIdChildString = '';
/**/if (params["workEffortIdChild"].value != null &amp;&amp; params["workEffortIdChild"].value != '') {
	workEffortIdChildString = " and ('"+ params["workEffortIdChild"].value + "' IS NULL or '"+ params["workEffortIdChild"].value + "' = '' ";
	workEffortIdChildString += "or  OB1.WORK_EFFORT_ID = '"+ params["workEffortIdChild"].value + "'";		
	workEffortIdChildString += "or OB2.WORK_EFFORT_ID = '"+ params["workEffortIdChild"].value + "' )";	
} 
this.queryText = this.queryText.replace("@workEffortIdChild",  workEffortIdChildString );

//@workEffortId
var workEffortIdString = '';
/**/ if (params["workEffortId"].value != null &amp;&amp; params["workEffortId"].value != '') {
	workEffortIdString = " and ('"+ params["workEffortId"].value + "' IS NULL ";
	workEffortIdString += " or '"+ params["workEffortId"].value + "' = ''";	
	workEffortIdString += " or RAD.WORK_EFFORT_ID = '"+ params["workEffortId"].value + "' ";
	workEffortIdString += " or OB1.WORK_EFFORT_ID = '"+ params["workEffortId"].value + "' or OB1.WORK_EFFORT_SNAPSHOT_ID = '"+ params["workEffortId"].value + "' )";	
} 
this.queryText = this.queryText.replace("@workEffortId",  workEffortIdString );

//@orgUnitId
var orgUnitIdString = '';
/**/  if (params["orgUnitId"].value != null &amp;&amp; params["orgUnitId"].value != '') {
	orgUnitIdString= "AND ('"+ params["orgUnitId"].value + "' IS NULL or '"+ params["orgUnitId"].value + "' = '' or '"+ params["orgUnitId"].value + "' =  OB1.ORG_UNIT_ID or '"+ params["orgUnitId"].value + "' = OB2.ORG_UNIT_ID)"
} 
this.queryText = this.queryText.replace("@orgUnitId",  orgUnitIdString );

//GESTIRE PERMESSI
/**/
filter = new com.mapsengineering.base.birt.util.UtilFilter(params["userLoginId"].value, params["localDispatcherName"].value);
var filterInnerJoin = filter.getWorkEffortFilterInner();
var filterLeftJoin = filter.getWorkEffortFilterLeftJoin();
var filterWhere = filter.getWorkEffortFilterWhere();
 
/* 
var filterInnerJoin = "";
var filterLeftJoin = "";
var filterWhere = ""; */

this.queryText = this.queryText.replace("@filterInnerJoin",  filterInnerJoin );
this.queryText = this.queryText.replace("@filterLeftJoin",  filterLeftJoin );
this.queryText = this.queryText.replace("@filterWhere",  filterWhere );

 

ReportLog.info("......this.queryText"+this.queryText);]]></method>
