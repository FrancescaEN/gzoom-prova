            <xml-property name="queryText"><![CDATA[SELECT 
 ND.NOTE_NAME,
 ND.NOTE_INFO,
 N.SEQUENCE_ID
FROM    WORK_EFFORT_NOTE N
JOIN    NOTE_DATA ND
ON      ND.NOTE_ID = N.NOTE_ID
WHERE   N.WORK_EFFORT_ID = ? 
AND   ( ? = 'N' OR (? = 'Y' AND N.IS_MAIN != 'Y'))
AND     ND.NOTE_DATE_TIME = ?
AND     N.SEQUENCE_ID >=100 AND  N.SEQUENCE_ID <= 199
ORDER BY 
N.SEQUENCE_ID , 
N.NOTE_ID

]]></xml-property>
