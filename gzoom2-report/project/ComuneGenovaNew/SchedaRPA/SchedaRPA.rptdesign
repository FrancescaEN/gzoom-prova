            <xml-property name="queryText"><![CDATA[ SELECT 
 	A_OB1.SEQUENCE_NUM AS SOCIETA_SEQ_NUM,
 	OB1.ETCH AS SOCIETA_ETCH,
 	OB1.WORK_EFFORT_NAME AS  SOCIETA_NAME,
 	A_OB2.SEQUENCE_NUM AS OBIETTIVO_SEQ_NUM, 
 	OB2.ETCH AS  OBIETTIVO_ETCH,
 	OB2.WORK_EFFORT_NAME  AS OBIETTIVO_NAME,
 	OB2.DESCRIPTION 		AS OBIETTIVO_DESCR,
	RAD.WORK_EFFORT_NAME	AS TITOLO_RADICE ,
	P_E.PARTY_NAME			AS NOME_ENTE,
  	P_RES_A.PARTY_NAME      AS RESPONSABILE_SOC,  
  	RT.DESCRIPTION			AS RUOLO_RESPONSABILE_SOC,
  	P_RES_C.PARTY_NAME      AS RESPONSABILE_OBI,  
  	OB1.SOURCE_REFERENCE_ID AS SOC_SOURCE_REFERENCE_ID,
 	OB1.WORK_EFFORT_ID 		AS SOCIETA_ID,
	OB1.ESTIMATED_COMPLETION_DATE AS OBIETTIVO_ESTIMATED_COMPLETION_DATE, 
 	OB2.SOURCE_REFERENCE_ID AS OBI_SOURCE_REFERENCE_ID,
 	OB2.WORK_EFFORT_ID 		AS OBIETTIVO_ID,
 	OB2.WORK_EFFORT_PURPOSE_TYPE_ID AS TIPO_OBIETTIVO,
 	RAD.ESTIMATED_START_DATE AS  RAD_ESTIMATED_START_DATE,
	RAD.ESTIMATED_COMPLETION_DATE AS  RAD_ESTIMATED_COMPLETION_DATE,
	OB2.ORG_UNIT_ID AS OB2_ORG_UNIT_ID
	
FROM WORK_EFFORT_TYPE T_RAD
INNER JOIN WORK_EFFORT RAD ON T_RAD.WORK_EFFORT_TYPE_ID = RAD.WORK_EFFORT_TYPE_ID 
	AND T_RAD.IS_ROOT = 'Y'    
	AND RAD.ESTIMATED_COMPLETION_DATE >= @date0101

INNER JOIN WORK_EFFORT_ASSOC A_OB1 ON  A_OB1.WORK_EFFORT_ID_FROM = RAD.WORK_EFFORT_ID
	AND A_OB1.FROM_DATE <= @date3112 																
	AND A_OB1.THRU_DATE >= @date0101 
INNER JOIN WORK_EFFORT_ASSOC_TYPE TA_OB1 ON TA_OB1.WORK_EFFORT_ASSOC_TYPE_ID = A_OB1.WORK_EFFORT_ASSOC_TYPE_ID
INNER JOIN WORK_EFFORT OB1 ON  A_OB1.WORK_EFFORT_ID_TO = OB1.WORK_EFFORT_ID
     AND  (A_OB1.THRU_DATE = OB1.ESTIMATED_COMPLETION_DATE OR A_OB1.THRU_DATE = RAD.ESTIMATED_COMPLETION_DATE)
	 AND OB1.ESTIMATED_COMPLETION_DATE >= @date0101

INNER JOIN WORK_EFFORT_ASSOC A_OB2 ON  A_OB2.WORK_EFFORT_ID_FROM = OB1.WORK_EFFORT_ID
	AND A_OB2.FROM_DATE <= @date3112 																
	AND A_OB2.THRU_DATE >= @date0101 
INNER JOIN WORK_EFFORT_ASSOC_TYPE TA_OB2 ON TA_OB2.WORK_EFFORT_ASSOC_TYPE_ID = A_OB2.WORK_EFFORT_ASSOC_TYPE_ID    
INNER JOIN WORK_EFFORT OB2 ON  A_OB2.WORK_EFFORT_ID_TO  = OB2.WORK_EFFORT_ID
     AND  (A_OB2.THRU_DATE = OB1.ESTIMATED_COMPLETION_DATE OR A_OB2.THRU_DATE = OB2.ESTIMATED_COMPLETION_DATE)
	 AND OB2.ESTIMATED_COMPLETION_DATE >= @date0101 

INNER JOIN WORK_EFFORT_TYPE T_OB2 ON  T_OB2.WORK_EFFORT_TYPE_ID = OB2.WORK_EFFORT_TYPE_ID
INNER JOIN work_effort FIL_W ON FIL_W.work_effort_id = A_OB1.work_effort_id_to
INNER JOIN PARTY P_E ON P_E.PARTY_ID = RAD.ORGANIZATION_ID

@filterInnerJoin
@filterLeftJoin
  
LEFT OUTER JOIN PARTY_RELATIONSHIP PR_RES_A
     ON  PR_RES_A.PARTY_ID_FROM              = OB1.ORG_UNIT_ID
     AND PR_RES_A.ROLE_TYPE_ID_FROM          = OB1.ORG_UNIT_ROLE_TYPE_ID
     AND PR_RES_A.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
AND (@excludeValidity = 'N' OR (@excludeValidity = 'Y' AND PR_RES_A.THRU_DATE IS NULL))
AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND(PR_RES_A.FROM_DATE   <= @monitoringDate AND (PR_RES_A.THRU_DATE  >= @monitoringDate OR PR_RES_A.THRU_DATE IS NULL)  )))

LEFT OUTER JOIN PARTY  P_RES_A
     ON P_RES_A.PARTY_ID = PR_RES_A.PARTY_ID_TO
LEFT OUTER JOIN ROLE_TYPE RT
	 ON RT.ROLE_TYPE_ID = PR_RES_A.ROLE_TYPE_ID_TO      
     
LEFT OUTER JOIN PARTY_RELATIONSHIP PR_RES_C
     ON  PR_RES_C.PARTY_ID_FROM              = OB2.ORG_UNIT_ID
     AND PR_RES_C.ROLE_TYPE_ID_FROM          = OB2.ORG_UNIT_ROLE_TYPE_ID
     AND PR_RES_C.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
AND (@excludeValidity = 'N' OR (@excludeValidity = 'Y' AND(PR_RES_C.THRU_DATE          IS NULL)))
AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND( PR_RES_C.FROM_DATE   <= @monitoringDate AND (PR_RES_C.THRU_DATE  >= @monitoringDate OR PR_RES_C.THRU_DATE IS NULL) )))

LEFT OUTER JOIN PARTY  P_RES_C
     ON P_RES_C.PARTY_ID = PR_RES_C.PARTY_ID_TO
     	 
WHERE  0=0
		@workEffortIdChild
		@workEffortId
		@orgUnitId         
		AND ((RAD.WEIGHT_SONS > 0 AND TA_OB1.PARENT_TYPE_ID = 'HIE'
       	AND OB1.WORK_EFFORT_PARENT_ID = RAD.WORK_EFFORT_PARENT_ID)
			    OR (RAD.WEIGHT_ASSOC_WORK_EFFORT > 0 AND A_OB1.WORK_EFFORT_ASSOC_TYPE_ID = RAD.WORK_EFFORT_ASSOC_TYPE_ID))
    
	    AND ((OB1.WEIGHT_SONS > 0 AND TA_OB2.PARENT_TYPE_ID = 'HIE'
              AND OB2.WORK_EFFORT_PARENT_ID = OB1.WORK_EFFORT_PARENT_ID)
		    OR (OB1.WEIGHT_ASSOC_WORK_EFFORT > 0 AND A_OB2.WORK_EFFORT_ASSOC_TYPE_ID = OB1.WORK_EFFORT_ASSOC_TYPE_ID))
	
		-- AGGIUNGO CONDIZIONE PER LO STORICIZZATO
		@workEffortRevisionId
	@filterWhere 
GROUP BY 
	A_OB1.SEQUENCE_NUM,
	OB1.ETCH,
	OB1.WORK_EFFORT_NAME,
	A_OB2.SEQUENCE_NUM,
	OB2.ETCH,
	OB2.WORK_EFFORT_NAME,
	OB2.DESCRIPTION,
	RAD.WORK_EFFORT_NAME,
	P_E.PARTY_NAME,
	P_RES_A.PARTY_NAME,
	RT.DESCRIPTION,
	P_RES_C.PARTY_NAME,
	OB1.SOURCE_REFERENCE_ID,
	OB1.WORK_EFFORT_ID,
	OB1.ESTIMATED_COMPLETION_DATE, 
	OB2.SOURCE_REFERENCE_ID,
	OB2.WORK_EFFORT_ID,
	OB2.WORK_EFFORT_PURPOSE_TYPE_ID,
	RAD.ESTIMATED_START_DATE,
	RAD.ESTIMATED_COMPLETION_DATE,
	OB2.ORG_UNIT_ID
ORDER BY
	A_OB1.SEQUENCE_NUM,
	OB1.SOURCE_REFERENCE_ID,
	OB1.WORK_EFFORT_ID,
	A_OB2.SEQUENCE_NUM,
	OB2.SOURCE_REFERENCE_ID,
	OB2.WORK_EFFORT_ID
 ]]></xml-property>
