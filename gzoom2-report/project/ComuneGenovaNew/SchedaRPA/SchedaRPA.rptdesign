                <structure>
                    <property name="position">55</property>
                    <property name="name">ACTUAL_ACC_TRN_ENTR_ABB_3112M4</property>
                    <property name="nativeName">ACTUAL_ACC_TRN_ENTR_ABB_3112M4</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">56</property>
                    <property name="name">ACTUAL_DATO_3112_MENO_QUATTRO</property>
