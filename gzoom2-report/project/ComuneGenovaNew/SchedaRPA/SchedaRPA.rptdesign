                <value type="javascript">(BirtDateTime.year(params["monitoringDate"].value) == BirtDateTime.year(params["date0101"].value) &amp;&amp;  BirtDateTime.month(params["monitoringDate"].value) == BirtDateTime.month(params["date0101"].value)  &#13;
