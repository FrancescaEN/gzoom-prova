            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">PARTY_NAME</property>
                    <property name="nativeName">PARTY_NAME</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">OB3WORK_EFFORT_ID</property>
                    <property name="nativeName">OB3WORK_EFFORT_ID</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">COUNTER</property>
                    <property name="nativeName">COUNTER</property>
                    <property name="dataType">integer</property>
                    <property name="nativeDataType">4</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
	 P.PARTY_NAME  AS PARTY_NAME,
	 A.WORK_EFFORT_ID AS OB3WORK_EFFORT_ID,
	 COUNT(*) AS COUNTER
FROM   WORK_EFFORT_PARTY_ASSIGNMENT   A
JOIN   PARTY                          P
ON     P.PARTY_ID = A.PARTY_ID
WHERE  A.WORK_EFFORT_ID  = ?
AND    ROLE_TYPE_ID LIKE 'WEM%'
AND (? = 'Y' OR (? = 'N' AND( A.FROM_DATE   <= ? AND A.THRU_DATE >= ? )))
GROUP BY A.SEQUENCE_NUM,P.PARTY_NAME, A.WORK_EFFORT_ID
ORDER BY A.SEQUENCE_NUM,PARTY_NAME
 ]]></xml-property>
        </oda-data-set>
