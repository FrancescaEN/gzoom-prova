        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="MasterAttivitaStrutturaliDS" id="41863">
            <property name="nullsOrdering">nulls lowest</property>
            <list-property name="computedColumns">
                <structure>
                    <property name="name">count</property>
                    <property name="dataType">integer</property>
                    <property name="aggregateFunction">COUNT</property>
                    <list-property name="arguments">
                        <structure>
                            <property name="name">Expression</property>
                            <expression name="value">row["OBIETTIVO_ID"]</expression>
                        </structure>
                    </list-property>
                </structure>
                <structure>
                    <property name="name">SOCIETA_CONCAT</property>
                    <expression name="expression">row["SOCIETA_ETCH"]+" - "+row["SOCIETA_NAME"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">OBIETTIVO_CONCAT</property>
                    <expression name="expression">row["OBIETTIVO_DESCR"] == null || row["OBIETTIVO_DESCR"] == '' ?&#13;
row["OBIETTIVO_ETCH"]+" - "+row["OBIETTIVO_NAME"] :&#13;
row["OBIETTIVO_ETCH"]+" - "+row["OBIETTIVO_DESCR"]</expression>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <list-property name="columnHints"/>
            <list-property name="parameters"/>
