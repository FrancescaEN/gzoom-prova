            <xml-property name="queryText"><![CDATA[SELECT
	OB5.WORK_EFFORT_NAME OBB_STRAT_NAME,
	OB5.ESTIMATED_COMPLETION_DATE OB4_ESTIMATED_COMPLETION_DATE,
	A_OB4.THRU_DATE A_OB4_THRU_DATE,
	OB5.ETCH OBB_STRAT_ETCH,
	OB5.DESCRIPTION OBB_STRAT_DESCR,
	A_OB4.WORK_EFFORT_ID_TO A_OB4_WORK_EFFORT_ID_TO,
	OB6.WORK_EFFORT_NAME MISSIONE_NAME,
	OB6.ETCH MISSIONE_ETCH,
	OB5.WORK_EFFORT_ID OBB_STRAT_ID,
	OB6.WORK_EFFORT_ID MISSIONE_ID,
	A_OB4.WORK_EFFORT_REVISION_ID AS OB4_WORK_EFFORT_REVISION_ID
FROM
	WORK_EFFORT OB4
INNER JOIN WORK_EFFORT_ASSOC A_OB4 ON
	A_OB4.WORK_EFFORT_ID_FROM = OB4.WORK_EFFORT_ID
	AND A_OB4.WORK_EFFORT_ASSOC_TYPE_ID <> 'ROOT'
	AND A_OB4.WORK_EFFORT_ASSOC_TYPE_ID = '20T4OO'			
	AND A_OB4.FROM_DATE <= @date3112
	AND A_OB4.THRU_DATE >= @date0101
INNER JOIN WORK_EFFORT_ASSOC A_OB5 ON
	A_OB5.WORK_EFFORT_ID_TO = OB4.WORK_EFFORT_ID
	AND A_OB5.WORK_EFFORT_ASSOC_TYPE_ID = '20D6C' 	
	AND A_OB5.FROM_DATE <= @date3112
	AND A_OB5.THRU_DATE >= @date0101
INNER JOIN WORK_EFFORT OB5 ON
	A_OB5.WORK_EFFORT_ID_FROM = OB5.WORK_EFFORT_ID
	AND(
		A_OB5.THRU_DATE = OB4.ESTIMATED_COMPLETION_DATE
		OR A_OB5.THRU_DATE = OB5.ESTIMATED_COMPLETION_DATE
	)
	AND A_OB5.WORK_EFFORT_ASSOC_TYPE_ID <> 'ROOT'
INNER JOIN WORK_EFFORT_ASSOC A_OB6 on
	A_OB6.WORK_EFFORT_ID_TO = OB5.WORK_EFFORT_ID
	and A_OB6.WORK_EFFORT_ASSOC_TYPE_ID = '20D6' 		
	and A_OB6.FROM_DATE <= @date3112
	and A_OB6.THRU_DATE >= @date0101
INNER JOIN WORK_EFFORT OB6 on
	A_OB6.WORK_EFFORT_ID_FROM = OB6.WORK_EFFORT_ID
	and(
		A_OB5.THRU_DATE = OB4.ESTIMATED_COMPLETION_DATE
		or A_OB5.THRU_DATE = OB5.ESTIMATED_COMPLETION_DATE
	)
	and A_OB5.WORK_EFFORT_ASSOC_TYPE_ID <> 'ROOT'
WHERE
	A_OB4.WORK_EFFORT_ID_TO = ?
	AND(
		A_OB4.THRU_DATE = ?
		OR A_OB4.THRU_DATE = OB4.ESTIMATED_COMPLETION_DATE
	)
	@workEffortRevisionId 
GROUP BY
	OB5.WORK_EFFORT_NAME,
	OB5.ESTIMATED_COMPLETION_DATE,
	A_OB4.THRU_DATE,
	OB5.ETCH,
	OB5.DESCRIPTION,
	A_OB4.WORK_EFFORT_ID_TO,
	OB6.WORK_EFFORT_NAME,
	OB6.ETCH,
	OB5.WORK_EFFORT_ID,
	OB6.WORK_EFFORT_ID,
	A_OB5.WORK_EFFORT_ASSOC_TYPE_ID,
	A_OB6.WORK_EFFORT_ASSOC_TYPE_ID,
	A_OB4.WORK_EFFORT_REVISION_ID]]></xml-property>
