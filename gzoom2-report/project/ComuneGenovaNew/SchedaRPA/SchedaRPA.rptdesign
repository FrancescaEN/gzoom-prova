                </structure>
                <structure>
                    <property name="position">10</property>
                    <property name="name">COUNTER</property>
                    <property name="nativeName">COUNTER</property>
                    <property name="dataType">integer</property>
                    <property name="nativeDataType">4</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT OB2.WORK_EFFORT_NAME AS OB2_WORK_EFFORT_NAME,
       OB2.WORK_EFFORT_ID AS OB2_WORK_EFFORT_ID,
       A_OB2.SEQUENCE_NUM AS OB2_SEQ_NUM, 
 	   OB2.SOURCE_REFERENCE_ID AS OB2_SOURCE_REFERENCE_ID, 	
       OB2.ETCH AS OB2_ETCH,
       OB2.DESCRIPTION AS OB2_DESCRIPTION,
       V_COL.AREA_NAME,
       V_COL.AREA_ETCH,
       A_OB2.ASSOC_WEIGHT AS A_OB3_ASSOC_WEIGHT,
       COUNT (*) AS COUNTER
       
FROM WORK_EFFORT OB1
 INNER JOIN WORK_EFFORT_ASSOC A_OB2 ON A_OB2.WORK_EFFORT_ID_FROM = OB1.WORK_EFFORT_ID
 INNER JOIN WORK_EFFORT_ASSOC_TYPE TA_OB2 ON TA_OB2.WORK_EFFORT_ASSOC_TYPE_ID = A_OB2.WORK_EFFORT_ASSOC_TYPE_ID	    	
	    AND (TA_OB2.PARENT_TYPE_ID IS NULL OR TA_OB2.PARENT_TYPE_ID <> 'TECHNICAL')	
 INNER JOIN WORK_EFFORT OB2 ON A_OB2.WORK_EFFORT_ID_TO = OB2.WORK_EFFORT_ID
 	AND OB2.ESTIMATED_COMPLETION_DATE >= ?
 	AND OB2.ESTIMATED_START_DATE <= ?
 
 LEFT OUTER JOIN
     (SELECT OB3.WORK_EFFORT_NAME AS AREA_NAME,
             OB3.ETCH AS AREA_ETCH,
             OB3.DESCRIPTION AS AREA_DESCRIPTION,
			 A_OB3.WORK_EFFORT_ID_TO AS A_OB3_WORK_EFFORT_ID_TO,
 			 OB3.ESTIMATED_COMPLETION_DATE AS OB3_ESTIMATED_COMPLETION_DATE,
			 A_OB3.THRU_DATE AS A_OB3_THRU_DATE,
			 A_OB3.ASSOC_WEIGHT	AS  A_OB3_ASSOC_WEIGHT		 
      FROM WORK_EFFORT OB3
      	JOIN WORK_EFFORT_ASSOC A_OB3
	    	 ON A_OB3.WORK_EFFORT_ID_FROM = OB3.WORK_EFFORT_ID 
	  	JOIN WORK_EFFORT_ASSOC_TYPE TA_OB3 ON TA_OB3.WORK_EFFORT_ASSOC_TYPE_ID = A_OB3.WORK_EFFORT_ASSOC_TYPE_ID
	    	 AND (TA_OB3.PARENT_TYPE_ID IS NULL OR (TA_OB3.PARENT_TYPE_ID <> 'HIE' AND TA_OB3.PARENT_TYPE_ID <> 'TECHNICAL'))
             )   V_COL
		      ON    V_COL.A_OB3_WORK_EFFORT_ID_TO = OB2.WORK_EFFORT_ID
		      AND  (V_COL.A_OB3_THRU_DATE         = OB2.ESTIMATED_COMPLETION_DATE   OR
        		    V_COL.A_OB3_THRU_DATE      = V_COL.OB3_ESTIMATED_COMPLETION_DATE)
 WHERE OB1.WORK_EFFORT_ID = ? AND OB2.WORK_EFFORT_PURPOSE_TYPE_ID = ?
 GROUP BY OB2.WORK_EFFORT_NAME,
	      OB2.WORK_EFFORT_ID,
    	  OB2.ETCH,
 		  V_COL.AREA_NAME,
		  V_COL.AREA_ETCH,
    	  OB2.DESCRIPTION,
    	  A_OB2.ASSOC_WEIGHT,
    	  A_OB2.SEQUENCE_NUM, 
 	      OB2.SOURCE_REFERENCE_ID]]></xml-property>
