        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="ObiettiviCorrelatiDS" id="49811">
            <property name="nullsOrdering">nulls lowest</property>
            <list-property name="computedColumns">
                <structure>
                    <property name="name">count</property>
                    <property name="dataType">integer</property>
                    <property name="aggregateFunction">COUNT</property>
                    <list-property name="arguments">
                        <structure>
                            <property name="name">Expression</property>
                            <expression name="value">row["OBB_CORR_NAME"]</expression>
                        </structure>
                    </list-property>
                </structure>
                <structure>
                    <property name="name">SOCIETA_CONCAT</property>
                    <expression name="expression">row["OBB_COR_ETCH"]+" - "+row["OBB_CORR_NAME"]</expression>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <list-property name="parameters">
                <structure>
                    <property name="name">workeffortId</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <expression name="defaultValue" type="constant">N/A</expression>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">OBB_CORR_NAME</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">OBB_COR_ETCH</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">NOTE_INFO</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">4</property>
                        <property name="name">count</property>
                        <property name="dataType">integer</property>
                    </structure>
                    <structure>
                        <property name="position">5</property>
                        <property name="name">SOCIETA_CONCAT</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <property name="rowFetchLimit">0</property>
            <method name="beforeOpen"><![CDATA[//
workEffortRevisionId = " AND A_OB4.WORK_EFFORT_REVISION_ID IS NULL ";

if (params["workEffortRevision"].value != null &amp;&amp; params["workEffortRevision"].value != '') {
	workEffortRevisionId = " AND A_OB4.WORK_EFFORT_REVISION_ID = '" + params["workEffortRevision"].value + "' ";
}

// 
this.queryText = this.queryText.replace("@workEffortRevisionId", workEffortRevisionId);

/**/this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value );
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );

/*this.queryText = this.queryText.replace("@date0101",  "'2019-01-01 00:00:00.000'" ); 
this.queryText = this.queryText.replace("@date3112",  "'2019-12-31 00:00:00.000'" );*/

//ReportLog.info("......this.queryText"+this.queryText);
]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">OBB_CORR_NAME</property>
                    <property name="nativeName">OBB_CORR_NAME</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">OBB_COR_ETCH</property>
                    <property name="nativeName">OBB_COR_ETCH</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">NOTE_INFO</property>
                    <property name="nativeName">NOTE_INFO</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[ SELECT
	OB4.WORK_EFFORT_NAME OBB_CORR_NAME,
	OB4.ETCH OBB_COR_ETCH,
	D_OB4.NOTE_INFO 
FROM
	WORK_EFFORT OB4
INNER JOIN WORK_EFFORT_ASSOC A_OB4 ON
	A_OB4.WORK_EFFORT_ID_FROM = OB4.WORK_EFFORT_ID
	AND A_OB4.WORK_EFFORT_ASSOC_TYPE_ID = '20T4OO'
INNER JOIN WORK_EFFORT_NOTE N_OB4 ON
	N_OB4.WORK_EFFORT_ID = OB4.WORK_EFFORT_ID
	AND N_OB4.SEQUENCE_ID = 100
INNER JOIN NOTE_DATA D_OB4 ON
	D_OB4.NOTE_ID = N_OB4.NOTE_ID
WHERE
	A_OB4.WORK_EFFORT_ID_TO = ?
	AND A_OB4.FROM_DATE <= @date3112
	AND A_OB4.THRU_DATE >= @date0101
	@workEffortRevisionId
ORDER BY
	A_OB4.SEQUENCE_NUM,
	OB4.SOURCE_REFERENCE_ID,
	OB4.WORK_EFFORT_ID
 ]]></xml-property>
