            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT M_WORK_EFFORT_MEASURE_ID, 
	GT.DESCRIPTION, 
	G_ACCOUNT_NAME,
	G_DESCRIPTION, 
	G_UOM_ABBREVIATION, 
	G_DETAIL_ENUM_ID, 
	G_INPUT_ENUM_ID, 
	WP.UOM_DESCR,
	WP.COMMENTS, 
	M_UOM_DESCR,
    M_COMMENTS, 
 	V.M_SEQUENCE_ID,
	V.G_ACCOUNT_CODE,
	V.G_GL_ACCOUNT_ID ,
	V.G_UOM_TYPE_ID,
	V.W_WORK_EFFORT_TYPE_ID,
	G_UOM_DECIMAL_SCALE,
	WTIC.CONTENT_ID AS CONTENT_FOLDER_IND,
	WTIC.ETCH AS ETCH_FOLDER_IND,
	V.M_KPI_SCORE_WEIGHT,
	COUNT(*) COUNTER,
	
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TT_TRANSACTION_DATE = ?  THEN TT_DESCRIPTION ELSE NULL END)  BUDGET_ACC_TRN_ABB_3112M1,  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TT_TRANSACTION_DATE = ?  THEN TT_DESCRIPTION ELSE NULL END)  BUDGET_ACC_TRN_ABB_3112,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TT_TRANSACTION_DATE = ?  THEN TT_DESCRIPTION ELSE NULL END)  BUDGET_ACC_TRN_ABB_31121,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TT_TRANSACTION_DATE = ?  THEN TT_DESCRIPTION ELSE NULL END)  BUDGET_ACC_TRN_ABB_31122,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TT_TRANSACTION_DATE = ?  THEN TM_DESCRIPTION ELSE NULL END)  BUDGET_ACC_TRN_ENTRY_ABB_3112M1,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TT_TRANSACTION_DATE = ?  THEN TM_DESCRIPTION ELSE NULL END)  BUDGET_ACC_TRN_ENTRY_ABB_3112,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TT_TRANSACTION_DATE = ?  THEN TM_DESCRIPTION ELSE NULL END)  BUDGET_ACC_TRN_ENTRY_ABB_31121,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TT_TRANSACTION_DATE = ?  THEN TM_DESCRIPTION ELSE NULL END)  BUDGET_ACC_TRN_ENTRY_ABB_31122,

MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TT_TRANSACTION_DATE = ?  THEN TT_DESCRIPTION ELSE NULL END)  ACTUAL_ACC_TRN_ABB_3112,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TT_TRANSACTION_DATE = ?  THEN TT_DESCRIPTION ELSE NULL END)  ACTUAL_ACC_TRN_ABB_3112M1,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TT_TRANSACTION_DATE = ?  THEN TT_DESCRIPTION ELSE NULL END)  ACTUAL_ACC_TRN_ABB_3112M2,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TT_TRANSACTION_DATE = ?  THEN TT_DESCRIPTION ELSE NULL END)  ACTUAL_ACC_TRN_ABB_3112M3,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TT_TRANSACTION_DATE = ?  THEN TM_DESCRIPTION ELSE NULL END)  ACTUAL_ACC_TRN_ENTR_ABB_3112,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TT_TRANSACTION_DATE = ?  THEN TM_DESCRIPTION ELSE NULL END)  ACTUAL_ACC_TRN_ENTR_ABB_3112M1,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TT_TRANSACTION_DATE = ?  THEN TM_DESCRIPTION ELSE NULL END)  ACTUAL_ACC_TRN_ENTR_ABB_3112M2,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TT_TRANSACTION_DATE = ?  THEN TM_DESCRIPTION ELSE NULL END)  ACTUAL_ACC_TRN_ENTR_ABB_3112M3,

MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TT_TRANSACTION_DATE = ?  THEN R_UOM_CODE ELSE NULL END) BUDGET_COD_3112_MENO_UNO,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TT_TRANSACTION_DATE = ?  THEN R_UOM_CODE ELSE NULL END) BUDGET_COD_3112,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TT_TRANSACTION_DATE = ?  THEN R_UOM_CODE ELSE NULL END) BUDGET_COD_3112_PIU_UNO,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TT_TRANSACTION_DATE = ?  THEN R_UOM_CODE ELSE NULL END) BUDGET_COD_3112_PIU_DUE,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TT_TRANSACTION_DATE = ?  THEN R_UOM_CODE ELSE NULL END) ACTUAL_COD_3112,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TT_TRANSACTION_DATE = ?  THEN R_UOM_CODE ELSE NULL END) ACTUAL_COD_3112_MENO_UNO,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TT_TRANSACTION_DATE = ?  THEN R_UOM_CODE ELSE NULL END) ACTUAL_COD_3112_MENO_DUE,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TT_TRANSACTION_DATE = ?  THEN R_UOM_CODE ELSE NULL END) ACTUAL_COD_3112_MENO_TRE,


SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TT_TRANSACTION_DATE = ?  THEN TM_AMOUNT ELSE NULL END)  BUDGET_DATO_3112_MENO_UNO,
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TT_TRANSACTION_DATE = ?  THEN TM_AMOUNT ELSE NULL END)  BUDGET_DATO_3112,
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TT_TRANSACTION_DATE = ?  THEN TM_AMOUNT ELSE NULL END)  BUDGET_DATO_3112_PIU_UNO,
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TT_TRANSACTION_DATE = ?  THEN TM_AMOUNT ELSE NULL END)  BUDGET_DATO_3112_PIU_DUE,
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TT_TRANSACTION_DATE = ?  THEN TM_AMOUNT ELSE NULL END)  ACTUAL_DATO_3112,
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TT_TRANSACTION_DATE = ?  THEN TM_AMOUNT ELSE NULL END)  ACTUAL_DATO_3112_MENO_UNO,
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TT_TRANSACTION_DATE = ?  THEN TM_AMOUNT ELSE NULL END)  ACTUAL_DATO_3112_MENO_DUE,
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TT_TRANSACTION_DATE = ?  THEN TM_AMOUNT ELSE NULL END)  ACTUAL_DATO_3112_MENO_TRE,

MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TT_TRANSACTION_DATE = ?  THEN R_UOM_CODE ELSE NULL END) ACTUAL_COD_3112_MENO_QUATTRO,
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TT_TRANSACTION_DATE = ?  THEN TM_DESCRIPTION ELSE NULL END)  ACTUAL_ACC_TRN_ENTR_ABB_3112M4,
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TT_TRANSACTION_DATE = ?  THEN TM_AMOUNT ELSE NULL END)  ACTUAL_DATO_3112_MENO_QUATTRO
 
FROM     WORK_EFFORT_TRANS_INDIC_VIEW V
JOIN     ENUMERATION E 
ON       V.M_WE_MEASURE_TYPE_ENUM_ID = E.ENUM_ID        
JOIN  WORK_EFFORT_TYPE WT
ON    WT.WORK_EFFORT_TYPE_ID = V.W_WORK_EFFORT_TYPE_ID
JOIN WORK_EFFORT_TYPE_CONTENT WTIC ON WTIC.WORK_EFFORT_TYPE_ID = WT.WORK_EFFORT_TYPE_ID
JOIN  WORK_EFFORT_PURPOSE_ACCOUNT WA
ON    WA.GL_ACCOUNT_ID          = V.G_GL_ACCOUNT_ID
AND   WA.WORK_EFFORT_PURPOSE_TYPE_ID =  WTIC.WORK_EFFORT_PURPOSE_TYPE_ID
JOIN GL_ACCOUNT G 
ON G.GL_ACCOUNT_ID = V.G_GL_ACCOUNT_ID
JOIN  GL_ACCOUNT_TYPE GT
ON    GT.GL_ACCOUNT_TYPE_ID = V.G_GL_ACCOUNT_TYPE_ID

LEFT OUTER JOIN 
	( SELECT WM.GL_ACCOUNT_ID, PR.INTERNAL_NAME, PR.PRODUCT_ID, WM.UOM_DESCR, WM.COMMENTS
	FROM WORK_EFFORT_MEASURE WM
	INNER JOIN PRODUCT PR ON PR.PRODUCT_ID = WM.PRODUCT_ID
	WHERE WM.WORK_EFFORT_ID IS NULL) WP
	ON WP.GL_ACCOUNT_ID = M_GL_ACCOUNT_ID AND WP.PRODUCT_ID = M_PRODUCT_ID
	
WHERE M_WORK_EFFORT_ID = ? 
	AND  V.M_THRU_DATE >= ?
	AND  V.M_FROM_DATE <= ?  
	AND (TM_GL_ACCOUNT_ID IS NULL OR TM_GL_ACCOUNT_ID <> 'SCOREKPI')
	
	@workEffortRevisionId -- FILTRO GLI INDICATORI IN BASE ALLA REVISION 
	
GROUP BY  GT.DESCRIPTION, G_ACCOUNT_NAME, G_DESCRIPTION, G_UOM_ABBREVIATION,V.G_ACCOUNT_CODE, V.G_GL_ACCOUNT_ID ,
M_WORK_EFFORT_MEASURE_ID,G_DETAIL_ENUM_ID,G_INPUT_ENUM_ID, WP.UOM_DESCR, WP.COMMENTS, M_UOM_DESCR, M_COMMENTS, V.M_SEQUENCE_ID,
V.G_ACCOUNT_CODE, V.G_GL_ACCOUNT_ID , V.G_UOM_TYPE_ID, G_UOM_DECIMAL_SCALE,V.W_WORK_EFFORT_TYPE_ID,
 WTIC.CONTENT_ID, WTIC.ETCH, V.M_KPI_SCORE_WEIGHT

ORDER BY    
  V.G_ACCOUNT_CODE,
  V.G_GL_ACCOUNT_ID ,
  V.M_WORK_EFFORT_MEASURE_ID]]></xml-property>
