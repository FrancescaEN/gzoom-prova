//Debug.log("... this.queryText= "+this.queryText);]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">tipo_allegato</property>
                    <property name="nativeName">tipo_allegato</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">descrizione_allegato</property>
                    <property name="nativeName">descrizione_allegato</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">nome_file</property>
                    <property name="nativeName">nome_file</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select
	wt.description as tipo_allegato,
	co.description as descrizione_allegato,
	al.data_resource_name as nome_file
from
	work_effort_content wc
inner join work_effort_content_type wt on
	wt.work_effort_content_type_id = wc.work_effort_content_type_id
inner join content co on
	co.content_id = wc.content_id
inner join data_resource al on
	al.data_resource_id = co.data_resource_id
where
	wc.work_effort_id = ? -- main.identificativo_obipeg
	and wc.from_date <= @date3112 -- 'AAAA(input.ref_date)-12-31'
	and(
		wc.thru_date is null
		or wc.thru_date >= @date0101
	) -- 'AAA(input.ref_date)-01-01'
	and wc.work_effort_content_type_id = 'PEGDEF'
order by
	descrizione_allegato]]></xml-property>
