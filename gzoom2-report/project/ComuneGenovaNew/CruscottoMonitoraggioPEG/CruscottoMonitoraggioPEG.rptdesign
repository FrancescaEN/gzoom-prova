            <xml-property name="queryText"><![CDATA[select
	ood.note_info as descrizione_obipeg
from
	work_effort oo
inner join work_effort_note oon on
	oon.work_effort_id = oo.work_effort_id
inner join note_data ood on
	ood.note_id = oon.note_id
	and ood.note_name = 'Descrizione'
where
	oo.work_effort_id = ? -- main.identificativo_obipeg
	and ood.note_date_time = @date0101 -- 'AAAA(input.ref_date)-01-01';]]></xml-property>
