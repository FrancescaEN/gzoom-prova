                    <expression name="valueExpr">if (params["reportContentId"].value == 'REPORT_PEG14_DET') {&#13;
    if (BirtComp.equalTo(params["monitoringDate"].value ,params["date3112"].value)) {&#13;
        reportContext.getMessage('PEG14_title_monit_det', reportContext.getLocale())  + " " + (BirtDateTime.year(params["monitoringDate"].value)) + "-" +BirtMath.add(BirtDateTime.year(params["monitoringDate"].value),2) + " al " + Formatter.format(params["monitoringDate"].value, "dd/MM/yyyy");&#13;
    } else {&#13;
        reportContext.getMessage('PEG14_title_det', reportContext.getLocale())  + " " + (BirtDateTime.year(params["monitoringDate"].value)) + "-" +BirtMath.add(BirtDateTime.year(params["monitoringDate"].value),2) + " al " + Formatter.format(params["monitoringDate"].value, "dd/MM/yyyy");&#13;
    }&#13;
} else if (params["reportContentId"].value == 'REPORT_PEG14') {&#13;
    if (BirtComp.equalTo(params["monitoringDate"].value ,params["date3112"].value)) {&#13;
        reportContext.getMessage('PEG14_title_monit', reportContext.getLocale())  + " " + (BirtDateTime.year(params["monitoringDate"].value)) + "-" +BirtMath.add(BirtDateTime.year(params["monitoringDate"].value),2) + " al " + Formatter.format(params["monitoringDate"].value, "dd/MM/yyyy");&#13;
    } else {&#13;
        reportContext.getMessage('PEG14_title', reportContext.getLocale())  + " " + (BirtDateTime.year(params["monitoringDate"].value)) + "-" +BirtMath.add(BirtDateTime.year(params["monitoringDate"].value),2) + " al " + Formatter.format(params["monitoringDate"].value, "dd/MM/yyyy");&#13;
    }&#13;
} else {&#13;
    if (params["exposeDateSituationAt"].value == 'Y') {&#13;
        reportContext.getMessage('PEG14_situa', reportContext.getLocale())  + " " + Formatter.format(params["monitoringDate"].value, "dd/MM/yyyy");&#13;
    }&#13;
}</expression>
