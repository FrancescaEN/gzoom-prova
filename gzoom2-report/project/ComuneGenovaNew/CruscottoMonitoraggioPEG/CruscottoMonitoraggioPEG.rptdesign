            <method name="beforeOpen"><![CDATA[
/*
this.queryText = this.queryText.replace("@date0101",  "'2020-01-01 00:00:00.000'" );
this.queryText = this.queryText.replace("@date3112",  "'2020-12-31 00:00:00.000'" );
this.queryText = this.queryText.replace("@fineannosuccessivo",  "'2020-12-31 00:00:00.000'" );
this.queryText = this.queryText.replace("@finedueannisuccessivi",  "'2020-12-31 00:00:00.000'" );				
this.queryText = this.queryText.replace("@date1231-1", "'2020-12-31 00:00:00.000'");
this.queryText = this.queryText.replace("@date1231-2", "'2020-12-31 00:00:00.000'");
this.queryText = this.queryText.replace("@date1231-3",  "'2020-12-31 00:00:00.000'");
this.queryText = this.queryText.replace("@monitoringDate",  "'2020-12-31 00:00:00.000'");
this.queryText = this.queryText.replace("@date3006",  "'2020-12-31 00:00:00.000'"); */
/**/
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value );
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );																
this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );
this.queryText = this.queryText.replace("@date3006",  params["date3006Sql"].value );	
this.queryText = this.queryText.replace("@fineannosuccessivo",  params["date3112+1Sql"].value );
this.queryText = this.queryText.replace("@finedueannisuccessivi",  params["date3112+2Sql"].value );				
this.queryText = this.queryText.replace("@date1231-1",  params["date1231-1Sql"].value );
this.queryText = this.queryText.replace("@date1231-2",  params["date1231-2Sql"].value );
this.queryText = this.queryText.replace("@date1231-3",  params["date1231-3Sql"].value );

// ReportLog.info("start log 2");

//@workEffortEtch
var workEffortEtch = '';
if(params["workEffortEtch"].value!=null &amp;&amp; params["workEffortEtch"].value!= '') {
	workEffortEtch = " and FIL_W.ETCH like '%"+params["workEffortEtch"].value+"%' ";
}
this.queryText = this.queryText.replace("@workEffortEtch",  workEffortEtch );

//@codiceObpeg
var codiceObpeg = '';
if(params["codiceObpeg"].value!=null &amp;&amp; params["codiceObpeg"].value!= '') {
	codiceObpeg = " and FIL_W.SOURCE_REFERENCE_ID like '%"+params["codiceObpeg"].value+"%' ";
}
this.queryText = this.queryText.replace("@codiceObpeg",  codiceObpeg );

//@workEffortName
var workEffortName = '';
if(params["workEffortName"].value!=null &amp;&amp; params["workEffortName"].value!= '') {
	workEffortName = " and FIL_W.work_effort_name like '%"+params["workEffortName"].value+"%' ";
}
this.queryText = this.queryText.replace("@workEffortName",  workEffortName );

//@orgUnitId
var orgUnitIdString = '';
/**/if (params["orgUnitId"].value != null &amp;&amp; params["orgUnitId"].value != '') {
	orgUnitIdString = " and uoop.party_id = '"+ params["orgUnitId"].value + "' and uoopr.ROLE_TYPE_ID IN ('20DIR', '30SET') ";	
}
this.queryText = this.queryText.replace("@orgUnitId",  orgUnitIdString );

//@partyId Reponsabilità politica ass_party_id
var partyId = '';
/**/if (params["partyId"].value != null &amp;&amp; params["partyId"].value != '') {
	partyId = " and (ass.party_id is not null and ass.party_id = '"+params["partyId"].value+"') ";
}
this.queryText = this.queryText.replace("@partyId",  partyId );

//@personId Responsabilità tecnica resp_party_id
var personId = '';
/**/if (params["personId"].value != null &amp;&amp; params["personId"].value != '') {
	personId = "and (uooopa.party_id is not null and uooopa.party_id = '"+params["personId"].value+"') and uoopre.role_type_id_from in ('20DIR', '30SET')";
}
this.queryText = this.queryText.replace("@personId",  personId );

//ReportLog.info("workEffortID prima: "+params["workEffortIdParametric"].value);
//WorkEffortId->WorkEffortIdChild
var workEffortId = '';
/**/if (params["workEffortIdParametric"].value != null &amp;&amp; params["workEffortIdParametric"].value != '') {
	workEffortId = "and (lm.work_effort_id in ("+params["workEffortIdParametric"].value+") or os.work_effort_id in ("+params["workEffortIdParametric"].value+") or oo.work_effort_id in ("+params["workEffortIdParametric"].value+")"
	+" or FIL_W.work_effort_id in ("+params["workEffortIdParametric"].value+") or pr.work_effort_id in ("+params["workEffortIdParametric"].value+") or mi.work_effort_id in ("+params["workEffortIdParametric"].value+") or ri.work_effort_id in ("+params["workEffortIdParametric"].value+")) ";
} 
this.queryText = this.queryText.replace("@workEffortId",  workEffortId );

// Verifica assessori
var assessors = '';
/**/if (params["assessors"].value != null &amp;&amp; params["assessors"].value != '') {
	if (params["assessors"].value == 'ONLY_NOT_VERIFIED'){
		assessors = "and (ae.amount is not null and ae.amount = 0)";
	} else if (params["assessors"].value == 'ONLY_VERIFIED'){
		assessors = "and (ae.amount is not null and ae.amount = 100)";
	} else if (params["assessors"].value == 'NOT_COMPILED'){
		assessors = "and (opm.work_effort_measure_id is not null and ae.amount is null)";
	}
}
this.queryText = this.queryText.replace("@assessors",  assessors );


var score = '';
if(params["scorePreview"].value != null &amp;&amp; params["scorePreview"].value != '') {

	if (params["scorePreview"].value == 'SCOREPREVIEW_CRI'){
		score = "and (aem.amount is not null and aem.amount = 0) ";
	} else if (params["scorePreview"].value == 'SCOREPREVIEW_RIT'){
		score = "and (aem.amount is not null and aem.amount <> 100) ";
	}
}
this.queryText = this.queryText.replace("@score",  score );

//ReportLog.info("assessori "+params["assessors"].value);

//GESTIRE PERMESSI
/**/

var filterInnerJoin = "";
var filterLeftJoin = "";
var filterWhere = ""; 

 /* 
 filter = new com.mapsengineering.base.birt.util.UtilFilter(params["userLoginId"].value, params["localDispatcherName"].value);
 filterInnerJoin = filter.getWorkEffortFilterInner();
filterLeftJoin = filter.getWorkEffortFilterLeftJoin();
filterWhere = filter.getWorkEffortFilterWhere();
*/
this.queryText = this.queryText.replace("@filterInnerJoin",  filterInnerJoin );
this.queryText = this.queryText.replace("@filterLeftJoin",  filterLeftJoin );
this.queryText = this.queryText.replace("@filterWhere",  filterWhere );
 
ReportLog.info("query PEG "+this.queryText);]]></method>
