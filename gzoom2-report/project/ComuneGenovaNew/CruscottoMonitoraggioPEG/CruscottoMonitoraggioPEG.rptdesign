                    </structure>
                    <structure>
                        <property name="position">10</property>
                        <property name="name">id_obipeg</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">11</property>
                        <property name="name">codice_obipeg</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">12</property>
                        <property name="name">titolo_obipeg</property>
