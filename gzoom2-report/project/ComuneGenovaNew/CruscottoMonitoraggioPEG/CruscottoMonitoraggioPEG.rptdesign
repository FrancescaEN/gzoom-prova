            <xml-property name="queryText"><![CDATA[select
(CASE WHEN ouop.work_effort_assoc_type_id = '20P2D' THEN raou.sequence_num ELSE rara.sequence_num END) as ordinamento_1,
uoopc.parent_role_code as ordinamento_2, 
(CASE WHEN ouop.work_effort_assoc_type_id = '20P2D' THEN 1 ELSE 2 END) as livello_struttura,
uoopc.parent_role_code as codice_dir_resp, uoop.external_id as codso4_dir_resp, 
uoop.vat_code codcdr_dir_resp, uoop.party_name as titolo_direzione_responsabile,
SUM(CASE WHEN aem.amount is not null AND aem.amount = 0 THEN 1 ELSE 0 END) as tot_critici,
SUM(CASE WHEN aem.amount is not null AND aem.amount = 50 THEN 1 ELSE 0 END) as tot_in_ritardo,
SUM(CASE WHEN aem.amount is not null AND aem.amount = 100 THEN 1 ELSE 0 END) as tot_in_linea,
SUM(CASE WHEN aem.amount is null THEN 1 ELSE 0 END) as tot_no_monit
from work_effort pm
inner join work_effort_type pmt on pmt.work_effort_type_id = pm.work_effort_type_id
inner join work_effort_assoc pmlm on pmlm.work_effort_id_from = pm.work_effort_id
 and pmlm.work_effort_assoc_type_id = '20D6'
inner join work_effort lm on lm.work_effort_id = pmlm.work_effort_id_to
inner join work_effort_assoc lmos on lmos.work_effort_id_from = lm.work_effort_id
 and lmos.work_effort_assoc_type_id = '20D6'
inner join work_effort os on os.work_effort_id = lmos.work_effort_id_to
inner join work_effort_assoc osoo on osoo.work_effort_id_from = os.work_effort_id
 and osoo.work_effort_assoc_type_id = '20D6C'
inner join work_effort oo on oo.work_effort_id = osoo.work_effort_id_to
inner join work_effort_assoc ooop on ooop.work_effort_id_from = oo.work_effort_id
 and ooop.work_effort_assoc_type_id = '20D6OC'
inner join work_effort op on op.work_effort_id = ooop.work_effort_id_to
inner join party uoop on uoop.party_id = op.org_unit_id
inner join party_parent_role uoopc on uoopc.party_id = uoop.party_id
  and uoopc.role_type_id = 'ORGANIZATION_UNIT'
inner join party_group uoopg on uoopg.party_id = uoop.party_id
left join party_relationship uoopre on uoopre.party_id_from = uoop.party_id
  and uoopre.party_relationship_type_id = 'ORG_RESPONSIBLE'
  and uoopre.from_date <= op.estimated_completion_date
  and (uoopre.thru_date is null or uoopre.thru_date >= op.estimated_completion_date)
  and (uoopre.from_date is null or uoopre.from_date <= @monitoringDate) -- input.ref_date
  and (uoopre.thru_date is null or uoopre.thru_date >= @monitoringDate) -- input.ref_date
left join party uooppa on uoopre.party_id_to is not null
 and uooppa.party_id = uoopre.party_id_to
inner join work_effort_assoc proo on proo.work_effort_id_to = oo.work_effort_id
 and proo.work_effort_assoc_type_id = '20D2C'
inner join work_effort pr on pr.work_effort_id = proo.work_effort_id_from
inner join work_effort_assoc mipr on mipr.work_effort_id_to = pr.work_effort_id
 and mipr.work_effort_assoc_type_id = '20D2'
inner join work_effort mi on mi.work_effort_id = mipr.work_effort_id_from
inner join work_effort_assoc ouop on ouop.work_effort_id_to = op.work_effort_id
 and ouop.work_effort_assoc_type_id in ('20P2D', '20P2S')
inner join work_effort ou on ou.work_effort_id = ouop.work_effort_id_from
inner join work_effort_assoc raou on raou.work_effort_id_to = ou.work_effort_id
 and raou.work_effort_assoc_type_id = '20P2'
 and (raou.from_date is null or raou.from_date <= @monitoringDate) -- input.ref_date
 and (raou.thru_date is null or raou.thru_date >= @monitoringDate) -- input.ref_date
 and raou.WORK_EFFORT_REVISION_ID is null
inner join work_effort ra on ra.work_effort_id = raou.work_effort_id_from
inner join work_effort_assoc rara on rara.work_effort_id_to = ra.work_effort_id
 and raou.work_effort_assoc_type_id = '20P2'
 and (rara.from_date is null or rara.from_date <= @monitoringDate) -- input.ref_date
 and (rara.thru_date is null or rara.thru_date >= @monitoringDate) -- input.ref_date
 and rara.WORK_EFFORT_REVISION_ID is null
inner join work_effort zz on zz.work_effort_id = rara.work_effort_id_from
 and zz.work_effort_type_id like '20P20%'

@filterInnerJoin
@filterLeftJoin

left join work_effort_measure opm on opm.work_effort_id = op.work_effort_id
  and opm.gl_account_id = '10001'
left join acctg_trans at on opm.work_effort_measure_id is not null
  and at.voucher_ref = opm.work_effort_measure_id
left join acctg_trans_entry ae on at.acctg_trans_id is not null
  and ae.acctg_trans_id = at.acctg_trans_id
left join work_effort_measure opmm on opmm.work_effort_id = op.work_effort_id
  and opmm.gl_account_id = '10020'
left join acctg_trans atm on opmm.work_effort_measure_id is not null
  and atm.voucher_ref = opmm.work_effort_measure_id
left join acctg_trans_entry aem on atm.acctg_trans_id is not null
  and aem.acctg_trans_id = atm.acctg_trans_id
left join uom_range_values mon on aem.amount is not null
  and mon.uom_range_id = 'PEGMON'
  and mon.range_values_factor = aem.amount
left join content com on mon.icon_content_id is not null
  and com.content_id = mon.icon_content_id
left join data_resource drm on com.data_resource_id is not null
  and drm.data_resource_id = com.data_resource_id
left join work_effort_note n210 on n210.work_effort_id = op.work_effort_id
  and n210.sequence_id = 210
left join note_data t210 on n210.note_id is not null
  and t210.note_id = n210.note_id
left join work_effort_note n220 on n220.work_effort_id = op.work_effort_id
  and n220.sequence_id = 220
left join note_data t220 on n220.note_id is not null
  and t220.note_id = n220.note_id
  
where lm.estimated_start_date <= @date3112      -- 'AAAA(input.ref_date)-12-31'
  and lm.estimated_completion_date >= @date0101 -- 'AAAA(input.ref_date)-01-01'
  and os.estimated_start_date <= @date3112      -- 'AAAA(input.ref_date)-12-31'
  and os.estimated_completion_date >= @date0101 -- 'AAAA(input.ref_date)-01-01'
  and oo.estimated_start_date <= @date3112      -- 'AAAA(input.ref_date)-12-31'
  and oo.estimated_completion_date >= @date0101 -- 'AAAA(input.ref_date)-01-01'
  and op.estimated_start_date <= @date3112      -- 'AAAA(input.ref_date)-12-31'
  and op.estimated_completion_date >= @date0101 -- 'AAAA(input.ref_date)-01-01'
  and (at.transaction_date is null or at.transaction_date = @date3112) -- 'AAAA(input.ref_date)-12-31'
  and (atm.transaction_date is null or atm.transaction_date = @monitoringDate) --input.ref_date
  and (t210.note_date_time is null or t210.note_date_time = @monitoringDate) --input.ref_date
  and (t220.note_date_time is null or t220.note_date_time = @monitoringDate) --input.ref_date
@orgUnitId -- and uoop.party_id = '10113'   -- input.uorg_uni_id (se valorizzato)
-- and exists (select 1 from work_effort_party_assignment opass
--    inner join party ass on ass.party_id = opass.party_id
--    inner join role_type assrole on assrole.role_type_id = opass.role_type_id
--    where opass.from_date <= '2020-01-01' -- input.ref_date
--      and opass.thru_date >= '2020-01-01'   -- input.ref_date
@partyId--      and opass.work_effort_id = op.work_effort_id)       -- input.ass_party_id (se valorizzato)
@personId  --  and uooopa.party_id is not null and uooopa.party_id = 'admin' -- input.resp-party_id (se valorizzato)
@workEffortId --  and (lm.work_effort_id IN ('10670', '123456') or os.work_effort_id IN ('10670', '123456')     -- lista input.work_effort_id (se valorizzato)
--   or oo.work_effort_id IN ('10670', '123456') or pr.work_effort_id IN ('10670', '123456') or mi.work_effort_id IN ('10670', '123456')
--   or exists (select 1 from left join work_effort_assoc riop1
--      inner join work_effort ri on  ri.work_effort_id = riop.work_effort_id_from
--      and (ri.estimated_start_date is null or ri.estimated_start_date <= '2020-12-31')           -- 'AAAA(input.ref_date)-12-31'
--      and (ri.estimated_completion_date is null or ri.estimated_completion_date >= '2020-01-01') -- 'AAAA(input.ref_date)-01-01'
--      where riop1.work_effort_id_to = op.work_effort_id
--      and riop1.work_effort_assoc_type_id like '20R%'
--      and riop1.work_effort_id IN ('10670', '123456'))
--  and (lm.work_effort_id IN ('10670', '123456') or os.work_effort_id IN ('10670', '123456')     -- lista input.work_effort_id2 (se valorizzato)
--   or oo.work_effort_id IN ('10670', '123456') or pr.work_effort_id IN ('10670', '123456') or mi.work_effort_id IN ('10670', '123456')
--   or exists (select 1 from left join work_effort_assoc riop1
--      inner join work_effort ri on  ri.work_effort_id = riop.work_effort_id_from
--      and (ri.estimated_start_date is null or ri.estimated_start_date <= '2020-12-31')           -- 'AAAA(input.ref_date)-12-31'
--      and (ri.estimated_completion_date is null or ri.estimated_completion_date >= '2020-01-01') -- 'AAAA(input.ref_date)-01-01'
--      where riop1.work_effort_id_to = op.work_effort_id
--      and riop1.work_effort_assoc_type_id like '20R%'
--      and riop1.work_effort_id IN ('10670', '123456'))
--  and (lm.work_effort_id IN ('10670', '123456') or os.work_effort_id IN ('10670', '123456')     -- lista input.work_effort_id3 (se valorizzato)
--   or oo.work_effort_id IN ('10670', '123456') or pr.work_effort_id IN ('10670', '123456') or mi.work_effort_id IN ('10670', '123456')
--   or exists (select 1 from left join work_effort_assoc riop1
--      inner join work_effort ri on  ri.work_effort_id = riop.work_effort_id_from
--      and (ri.estimated_start_date is null or ri.estimated_start_date <= '2020-12-31')           -- 'AAAA(input.ref_date)-12-31'
--      and (ri.estimated_completion_date is null or ri.estimated_completion_date >= '2020-01-01') -- 'AAAA(input.ref_date)-01-01'
--      where riop1.work_effort_id_to = op.work_effort_id
--      and riop1.work_effort_assoc_type_id like '20R%'
--      and riop1.work_effort_id IN ('10670', '123456'))
@assessors -- and ae.amount is not null and ae.amount = 100 -- se input.validazione_assessori = solo validati
-- and (ae.amount is null or ae.amount <> 100) -- se input.validazione_assessori = non compilati
and op.work_effort_revision_id is null -- se input.work_effort_revision_id is null
and ooop.work_effort_revision_id is null -- se input.work_effort_revision_id is null
-- and op.work_effort_revision_id = input.work_effort_revision_id -- se input.work_effort_revision_id è valorizzato
-- and ooop.work_effort_revision_id = input.work_effort_revision_id -- se input.work_effort_revision_id è valorizzato
@score-- and aem.amount is not null and aem.amount = 0 -- se input.previsione_risultato = critico
-- and aem.amount is not null and aem.amount <> 100 -- se input.previsione_risultato = critico o in ritardo
@codiceObpeg
@workEffortEtch
@workEffortName -- and op.source_reference_id like '%ABCDE%'  -- se input.source:reference:id valorizzato
-- and op.work_effort_name like '%ABCDE%'  -- se input.work_effort_name valorizzato
@filterWhere
group by ouop.work_effort_assoc_type_id, raou.sequence_num, rara.sequence_num,
uoopc.parent_role_code, uoop.external_id, uoop.vat_code, uoop.party_name
order by ordinamento_1, ordinamento_2


]]></xml-property>
