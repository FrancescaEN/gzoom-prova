            <method name="beforeOpen"><![CDATA[							
this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );
//this.queryText = this.queryText.replace("@monitoringDate",  "'2020-01-01 00:00:00.000'" );

//Debug.log("... this.queryText= "+this.queryText);]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">seq_refpol</property>
                    <property name="nativeName">seq_refpol</property>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">tipo_refpole</property>
                    <property name="nativeName">tipo_refpole</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">ruolo_refpol</property>
                    <property name="nativeName">ruolo_refpol</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">referente_politico</property>
                    <property name="nativeName">referente_politico</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select
	opass.sequence_num as seq_refpol,
	assrole.role_type_id as tipo_refpole,
	assrole.description as ruolo_refpol,
	ass.party_name as referente_politico
from
	work_effort_party_assignment opass
inner join party ass on
	ass.party_id = opass.party_id
inner join role_type assrole on
	assrole.role_type_id = opass.role_type_id
where
	opass.work_effort_id = ? -- main.work_effort_id
	and(
		opass.from_date is null
		or opass.from_date <= @monitoringDate
	)
	and(
		opass.thru_date is null
		or opass.thru_date >= @monitoringDate
	)
order by
	opass.sequence_num,
	assrole.role_type_id,
	ass.party_name
	]]></xml-property>
        </oda-data-set>
