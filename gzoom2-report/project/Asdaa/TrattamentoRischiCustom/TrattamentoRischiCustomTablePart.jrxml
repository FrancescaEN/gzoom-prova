		<property name="com.jaspersoft.studio.field.label" value="tipologia_unita_responsabile"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="role_type"/>
	</field>
	<field name="unita_responsabile" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="unita_responsabile"/>
		<property name="com.jaspersoft.studio.field.label" value="unita_responsabile"/>
	</field>
