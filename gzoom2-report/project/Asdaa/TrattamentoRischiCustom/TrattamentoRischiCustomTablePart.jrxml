	<queryString>
		<![CDATA[select 
	wet.etch$P!{langLocale} as TIPOLOGIA_TRATTAMENTO,
	FIL_W.work_effort_name$P!{langLocale} as NOME_TRATTAMENTO,
	FIL_W.etch as ETCH_TRATTAMENTO,
	FIL_W.source_reference_id as CODICE_TRATTAMENTO,
	FIL_W.estimated_start_date as DATA_INIZIO_TRATTAMENTO, 
	FIL_W.estimated_completion_date as DATA_FINE_TRATTAMENTO,
	rl.description$P!{langLocale} as TIPOLOGIA_UNITA_RESPONSABILE,
	concat(pprstrutt.parent_role_code, ' - ', strutt.party_name$P!{langLocale}) as UNITA_RESPONSABILE,
	/* 1 - Finalità trattamento */
	NOTE.NOME_FINALITA_TRATTAMENTO$P!{langLocale} as NOME1,
	NOTE.FINALITA_TRATTAMENTO$P!{langLocale} as INFO1,
	/* 2 - Descrizione trattamento */
	NOTE.NOME_DESCRIZIONE_TRATTAMENTO$P!{langLocale} as NOME2, 
	NOTE.DESCRIZIONE_TRATTAMENTO$P!{langLocale} as INFO2, 
	/* 3 - Fasi del trattamento */
	NOTE.NOME_FASI_TRATTAMENTO$P!{langLocale} as NOME3,
	NOTE.FASI_TRATTAMENTO$P!{langLocale} as INFO3,
	/* 4 - Base giuridica di legittimità */
	NOTE.NOME_BASE_TRATTAMENTO$P!{langLocale} as NOME4,
	NOTE.BASE_TRATTAMENTO$P!{langLocale} as INFO4,
	/* 5 - Note */
	NOTE.NOME_NOTE$P!{langLocale} as NOME5, 
	NOTE.NOTE$P!{langLocale} as INFO5,
	/* 6 - Categorie interessati */
	NOTE.NOME_CATEGORIE_INTERESSATI$P!{langLocale} as NOME6, 
	NOTE.CATEGORIE_INTERESSATI$P!{langLocale} as INFO6, 
	/* 7 - Categorie destinatari */
	NOTE.NOME_CATEGORIE_DESTINATARI$P!{langLocale} as NOME7, 
	NOTE.CATEGORIE_DESTINATARI$P!{langLocale} as INFO7, 
	/* 8 - Persone fisiche autorizzate */
	NOTE.NOME_PERSONE_AUTORIZZATE$P!{langLocale} as NOME8, 
	NOTE.PERSONE_AUTORIZZATE$P!{langLocale} as INFO8,
	/* 9 - Strutture aziendali coinvolte */
	NOTE.NOME_STRUTTURE_AZIENDALI$P!{langLocale} as NOME9, 
	NOTE.STRUTTURE_AZIENDALI$P!{langLocale} as INFO9, 
	/* 10 - Responsabili */
	NOTE.NOME_RESPONSABILI$P!{langLocale} as NOME10, 
	NOTE.RESPONSABILI$P!{langLocale} as INFO10, 
	/* 11 - Trasferimento dati */
	TRASF.ACCOUNT_NAME$P!{langLocale} as NOME11, 
	TRASF.UOM_CODE$P!{langLocale} as INFO11, 	
	/* 12 - Categorie dati personali */
	NOTE.NOME_DATI_PERSONALI$P!{langLocale} as NOME12, 
	NOTE.DATI_PERSONALI$P!{langLocale} as INFO12, 
	/* 13 - Periodo di conservazione dei dati */
	NOTE.NOME_PERIODO_CONSERVAZIONE$P!{langLocale} as NOME13, 
	NOTE.PERIODO_CONSERVAZIONE$P!{langLocale} as INFO13, 
	/* 14 - Strumenti per il Trattamento */
	FOLDER.NOME_CARATTERISTICHE$P!{langLocale} as NOME14, 
	CARAT.LISTA$P!{langLocale} as INFO14, 
	/* 15 - Asset utilizzati */
	NOTE.NOME_ASSET$P!{langLocale} as NOME15, 
	NOTE.ASSET$P!{langLocale} as INFO15, 
	/* 16 - Misure di sicurezza Organizzative */
	NOTE.NOME_MISURE_ORGANIZZATIVE$P!{langLocale} as NOME16, 
	NOTE.MISURE_ORGANIZZATIVE$P!{langLocale} as INFO16, 
	/* 17 - Misure di sicurezza tecniche */
	NOTE.NOME_MISURE_TECNICHE$P!{langLocale} as NOME17, 
	NOTE.MISURE_TECNICHE$P!{langLocale} as INFO17
/* TRATTAMENTO */
from work_effort FIL_W
join work_effort_type wet on wet.work_effort_type_id = FIL_W.work_effort_type_id
/* UNITA' RESPONSABILE */
join party strutt on strutt.party_id = FIL_W.org_unit_id
join party_parent_role pprstrutt on pprstrutt.party_id = strutt.party_id and pprstrutt.role_type_id not in ('INTERNAL_ORGANIZATIO')
join party_role prstrutt on prstrutt.party_id = strutt.party_id and prstrutt.role_type_id not in ('CORSPL', 'CORSSL', 'CORSTL','INTERNAL_ORGANIZATIO')
join role_type rl on rl.role_type_id = prstrutt.role_type_id and rl.parent_type_id = 'ORGANIZATION_UNIT'
join party org on org.party_id = FIL_W.organization_id

/* START filterInnerJoin */
 $P!{filterInnerJoin}
/* END filterInnerJoin */
/* START filterLeftJoin */
 $P!{filterLeftJoin}
/* END filterLeftJoin */

/* NOMI DEI FOLDER */
left join (
	select 
		WETC.WORK_EFFORT_TYPE_ID,
		MAX(case when WETC.CONTENT_ID = 'WEFLD_WEFROM' then WETC.ETCH$P!{langLocale} else null END) as NOME_ASSET$P!{langLocale},
		MAX(case when WETC.CONTENT_ID = 'WEFLD_IND3' then WETC.ETCH$P!{langLocale} else null END) as NOME_CARATTERISTICHE$P!{langLocale}
	from WORK_EFFORT_TYPE_CONTENT WETC
	group by
		WETC.WORK_EFFORT_TYPE_ID
) FOLDER on FOLDER.WORK_EFFORT_TYPE_ID = WET.WORK_EFFORT_TYPE_ID
/* NOTE */
left join (
	select 
		wen.work_effort_id,
		max(case when wen.sequence_id = 110 then nd.note_name$P!{langLocale} else null end) as NOME_DESCRIZIONE_TRATTAMENTO$P!{langLocale},
		max(case when wen.sequence_id = 110 then nd.note_info$P!{langLocale} else null end) as DESCRIZIONE_TRATTAMENTO$P!{langLocale},
		max(case when wen.sequence_id = 120 then nd.note_name$P!{langLocale} else null end) as NOME_FASI_TRATTAMENTO$P!{langLocale},
		max(case when wen.sequence_id = 120 then nd.note_info$P!{langLocale} else null end) as FASI_TRATTAMENTO$P!{langLocale},
		max(case when wen.sequence_id = 130 then nd.note_name$P!{langLocale} else null end) as NOME_CATEGORIE_TRATTAMENTO$P!{langLocale},
		max(case when wen.sequence_id = 130 then nd.note_info$P!{langLocale} else null end) as CATEGORIE_TRATTAMENTO$P!{langLocale},
		max(case when wen.sequence_id = 140 then nd.note_name$P!{langLocale} else null end) as NOME_FINALITA_TRATTAMENTO$P!{langLocale},
		max(case when wen.sequence_id = 140 then nd.note_info$P!{langLocale} else null end) as FINALITA_TRATTAMENTO$P!{langLocale},
		max(case when wen.sequence_id = 150 then nd.note_name$P!{langLocale} else null end) as NOME_BASE_TRATTAMENTO$P!{langLocale},
		max(case when wen.sequence_id = 150 then nd.note_info$P!{langLocale} else null end) as BASE_TRATTAMENTO$P!{langLocale},
		max(case when wen.sequence_id = 210 then nd.note_name$P!{langLocale} else null end) as NOME_STRUTTURE_AZIENDALI$P!{langLocale},
		max(case when wen.sequence_id = 210 then nd.note_info$P!{langLocale} else null end) as STRUTTURE_AZIENDALI$P!{langLocale},
		max(case when wen.sequence_id = 230 then nd.note_name$P!{langLocale} else null end) as NOME_PERSONE_AUTORIZZATE$P!{langLocale},
		max(case when wen.sequence_id = 230 then nd.note_info$P!{langLocale} else null end) as PERSONE_AUTORIZZATE$P!{langLocale},
		max(case when wen.sequence_id = 260 then nd.note_name$P!{langLocale} else null end) as NOME_RESPONSABILI$P!{langLocale},
		max(case when wen.sequence_id = 260 then nd.note_info$P!{langLocale} else null end) as RESPONSABILI$P!{langLocale},
		max(case when wen.sequence_id = 270 then nd.note_name$P!{langLocale} else null end) as NOME_CATEGORIE_INTERESSATI$P!{langLocale},
		max(case when wen.sequence_id = 270 then nd.note_info$P!{langLocale} else null end) as CATEGORIE_INTERESSATI$P!{langLocale},
		max(case when wen.sequence_id = 280 then nd.note_name$P!{langLocale} else null end) as NOME_CATEGORIE_DESTINATARI$P!{langLocale},
		max(case when wen.sequence_id = 280 then nd.note_info$P!{langLocale} else null end) as CATEGORIE_DESTINATARI$P!{langLocale},
		max(case when wen.sequence_id = 310 then nd.note_name$P!{langLocale} else null end) as NOME_DATI_PERSONALI$P!{langLocale},
		max(case when wen.sequence_id = 310 then nd.note_info$P!{langLocale} else null end) as DATI_PERSONALI$P!{langLocale},
		max(case when wen.sequence_id = 320 then nd.note_name$P!{langLocale} else null end) as NOME_ASSET$P!{langLocale},
		max(case when wen.sequence_id = 320 then nd.note_info$P!{langLocale} else null end) as ASSET$P!{langLocale},
		max(case when wen.sequence_id = 340 then nd.note_name$P!{langLocale} else null end) as NOME_PERIODO_CONSERVAZIONE$P!{langLocale},
		max(case when wen.sequence_id = 340 then nd.note_info$P!{langLocale} else null end) as PERIODO_CONSERVAZIONE$P!{langLocale},
		max(case when wen.sequence_id = 350 then nd.note_name$P!{langLocale} else null end) as NOME_TRASFERIMENTO_DATI$P!{langLocale},
		max(case when wen.sequence_id = 350 then nd.note_info$P!{langLocale} else null end) as TRASFERIMENTO_DATI$P!{langLocale},
		max(case when wen.sequence_id = 360 then nd.note_name$P!{langLocale} else null end) as NOME_MISURE_ORGANIZZATIVE$P!{langLocale},
		max(case when wen.sequence_id = 360 then nd.note_info$P!{langLocale} else null end) as MISURE_ORGANIZZATIVE$P!{langLocale},
		max(case when wen.sequence_id = 370 then nd.note_name$P!{langLocale} else null end) as NOME_MISURE_TECNICHE$P!{langLocale},
		max(case when wen.sequence_id = 370 then nd.note_info$P!{langLocale} else null end) as MISURE_TECNICHE$P!{langLocale},
		max(case when wen.sequence_id = 510 then nd.note_name$P!{langLocale} else null end) as NOME_NOTE$P!{langLocale},
		max(case when wen.sequence_id = 510 then nd.note_info$P!{langLocale} else null end) as NOTE$P!{langLocale}
	from work_effort_note wen 
	join note_data nd on nd.note_id = wen.note_id
	group by wen.work_effort_id
) note on note.work_effort_id = FIL_W.work_effort_id
/* 11 - Trasferimento dati */
left join (
	select 
		wem.work_effort_id,
		gl.account_name$P!{langLocale},
		gamrs.uom_code$P!{langLocale}
	from work_effort_measure wem
	join gl_account gl on gl.gl_account_id = wem.gl_account_id and gl.gl_account_id = '10033'
	join uom u on u.uom_id = gl.default_uom_id 
	left join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id
	left join gl_account_meas_rat_sc gamrs on gamrs.gl_account_id = gl.gl_account_id 
		and gamrs.uom_rating_value = ate.amount 
) trasf on trasf.work_effort_id = FIL_W.work_effort_id 
/* 14 - Strumenti per il Trattamento */
left join (
	select 
		wem.work_effort_id,
		string_agg(gl.account_name$P!{langLocale}, ',
' order by gl.account_name) as lista$P!{langLocale}
	from work_effort_measure wem
	join gl_account gl on gl.gl_account_id = wem.gl_account_id and gl.gl_account_id <> '10033'
	join work_effort_purpose_account wepa on wepa.gl_account_id = gl.gl_account_id and wepa.work_effort_purpose_type_id = 'TRACAR'
	join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id and ate.amount = 100
	group by wem.work_effort_id 
) carat on carat.work_effort_id = FIL_W.work_effort_id 
where FIL_W.work_effort_type_id =  $P{workEffortTypeId}  and FIL_W.work_effort_revision_id is null
	and FIL_W.estimated_start_date <=  $P{date3112} and (FIL_W.estimated_completion_date >= $P{date0101} or FIL_W.estimated_completion_date is null)	
 /* START orgUnitIdString */
 $P!{orgUnitIdString}
 /* END orgUnitIdString */
  /* START filterWhere */
$P!{filterWhere} 
   /* END filterWhere */
ORDER BY
	WET.ETCH,
	FIL_W.ETCH]]>
	</queryString>
	<field name="tipologia_trattamento" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="tipologia_trattamento"/>
		<property name="com.jaspersoft.studio.field.label" value="tipologia_trattamento"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="work_effort_type"/>
	</field>
