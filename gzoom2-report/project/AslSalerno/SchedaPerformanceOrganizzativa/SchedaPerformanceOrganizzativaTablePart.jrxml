	</parameter>
	<parameter name="customTimePeriodString" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc($P{customTimePeriod}, $P{odaDialect});]]></defaultValueExpression>
	</parameter>
	<parameter name="personId" class="java.lang.String" isForPrompting="false"/>
	<parameter name="workEffortId" class="java.lang.String" isForPrompting="false"/>
	<parameter name="date3009" class="java.util.Date" isForPrompting="false">
		<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilDateTime.getMonthEndFromDatetime("9",$P{REPORT_TIME_ZONE}.getID(),YEAR($P{customTimePeriod}), $P{REPORT_LOCALE}.getDefault())]]></defaultValueExpression>
	</parameter>
	<parameter name="date3009sql" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc($P{date3009}, $P{odaDialect});]]></defaultValueExpression>
	</parameter>
