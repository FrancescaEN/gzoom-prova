	<subDataset name="DatasetObiettivi" uuid="3d0cfe7a-0085-47db-b4bf-92a44c3be58d">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ASL SALERNO TEST"/>
		<parameter name="codiceStruttura" class="java.lang.String"/>
		<parameter name="YEAR" class="java.lang.Integer"/>
		<parameter name="YearString" class="java.lang.String">
			<defaultValueExpression><![CDATA[$P{YEAR}.toString()]]></defaultValueExpression>
		</parameter>
		<queryString language="SQL">
			<![CDATA[select
esoi.cod_struttura as "Codice Struttura",
esoi.etch_ob as "Cod.",
esoi.titolo_ob as "Descrizione",
esoi.indicatore_desc as "Descrizione Dettaglio",   --- Per AslSalerno -- aggiunto la descrizione dell'indicatore. Il titolo (ossia "Descrizione" sopra) sarebbe il nome indicatore
esoi.peso_ob as "Peso",
esoi.consuntivo as "Consuntivo",
-- esoi.risultato_ind_stringa as "ConsuntivoStringa",  -- PerAslSalerno non serve.
esoi.commento as "Valore Obiettivo",
esoi.risultato_ind as "Valore Raggiunto",
esoi.risultato_pesato_ob as "Punti"
from exp_str_ob_ind esoi
where esoi.cod_struttura= $P{codiceStruttura} 
and anno = $P{YearString}
order by esoi.cod_struttura,esoi.etch_ob asc]]>
		</queryString>
		<field name="Codice Struttura" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Codice Struttura"/>
			<property name="com.jaspersoft.studio.field.label" value="Codice Struttura"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="exp_str_ob_ind"/>
		</field>
		<field name="Cod." class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Cod."/>
			<property name="com.jaspersoft.studio.field.label" value="Cod."/>
			<property name="com.jaspersoft.studio.field.tree.path" value="exp_str_ob_ind"/>
		</field>
		<field name="Descrizione" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Descrizione"/>
			<property name="com.jaspersoft.studio.field.label" value="Descrizione"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="exp_str_ob_ind"/>
		</field>
		<field name="Descrizione Dettaglio" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Descrizione Dettaglio"/>
			<property name="com.jaspersoft.studio.field.label" value="Descrizione Dettaglio"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="exp_str_ob_ind"/>
		</field>
		<field name="Peso" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Peso"/>
			<property name="com.jaspersoft.studio.field.label" value="Peso"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="exp_str_ob_ind"/>
		</field>
		<field name="Consuntivo" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Consuntivo"/>
			<property name="com.jaspersoft.studio.field.label" value="Consuntivo"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="exp_str_ob_ind"/>
		</field>
		<field name="Valore Obiettivo" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Valore Obiettivo"/>
			<property name="com.jaspersoft.studio.field.label" value="Valore Obiettivo"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="exp_str_ob_ind"/>
		</field>
		<field name="Valore Raggiunto" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Valore Raggiunto"/>
			<property name="com.jaspersoft.studio.field.label" value="Valore Raggiunto"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="exp_str_ob_ind"/>
		</field>
		<field name="Punti" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Punti"/>
			<property name="com.jaspersoft.studio.field.label" value="Punti"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="exp_str_ob_ind"/>
		</field>
		<variable name="codiceObiettivo" class="java.lang.String">
			<variableExpression><![CDATA[$F{Cod.}]]></variableExpression>
		</variable>
	</subDataset>
	<subDataset name="DatasetTotale" uuid="fe7c673a-ea8d-4d75-be5c-4149480857e8">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="postgres_gzoom_aslnapoli1"/>
		<parameter name="codiceStruttura" class="java.lang.String"/>
		<parameter name="TOTALE_Punti" class="java.lang.Double"/>
		<parameter name="YearString" class="java.lang.String">
			<defaultValueExpression><![CDATA[$P{YEAR}.toString()]]></defaultValueExpression>
		</parameter>
		<parameter name="YEAR" class="java.lang.Integer"/>
		<queryString language="SQL">
			<![CDATA[-- RIGA FINALE TOTALI DEL BLOCCO 2 --
select distinct
esoi2.cod_struttura as "Codice Struttura",
sum(cast(esoi2.peso_ob as integer))as "TOTALE PESO",
sum(cast(esoi2.risultato_pesato_ob as integer)) as "TOTALE PUNTI"
from exp_str_ob_ind esoi2 
where esoi2.cod_struttura= $P{codiceStruttura} 
and anno = $P{YearString}
group by esoi2.cod_struttura]]>
		</queryString>
		<field name="Codice Struttura" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Codice Struttura"/>
			<property name="com.jaspersoft.studio.field.label" value="Codice Struttura"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="exp_str_ob_ind"/>
		</field>
		<field name="TOTALE PESO" class="java.lang.Long">
			<property name="com.jaspersoft.studio.field.name" value="TOTALE PESO"/>
			<property name="com.jaspersoft.studio.field.label" value="TOTALE PESO"/>
		</field>
		<field name="TOTALE PUNTI" class="java.lang.Long">
			<property name="com.jaspersoft.studio.field.name" value="TOTALE PUNTI"/>
			<property name="com.jaspersoft.studio.field.label" value="TOTALE PUNTI"/>
		</field>
	</subDataset>
	<subDataset name="DatasetIndicatori" uuid="7822dbb7-4ee7-4dc2-a759-68ca9c38fe0e">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="postgres_gzoom_aslnapoli1"/>
		<parameter name="codiceStruttura" class="java.lang.String"/>
		<parameter name="codiceObiettivo" class="java.lang.String"/>
		<queryString language="SQL">
			<![CDATA[select 
esoi3.cod_struttura as "Codice Struttura",
concat(esoi3.etch_ob,' - ',esoi3.titolo_ob) as "Titolo Obiettivo",
esoi3.peso_ob as "Peso",
cast(replace(esoi3.risultato_ind,',','.') as decimal(10,2))*cast(replace(esoi3.peso_ob,',','.') as decimal(10,2))/100 as "Peso X Valore Raggiunto /100",-- * cast(esoi3.peso_ob as decimal(10,2))),--/100,--((( cast(esoi3.peso_ob as integer) * cast(esoi3.risultato_ind as integer))/100)) else null end) as "Peso X Valore Raggiunto /100",
esoi3.indicatore_desc as "Indicatore",
esoi3.indicatore as "Regola di Calcolo",
esoi3.commento as "Valore Obiettivo (target)",
esoi3.consuntivo as "Consuntivo", 
esoi3.risultato_ind as "Valore Raggiunto (0-100)"
from exp_str_ob_ind esoi3
where esoi3.risultato_ind is not null 
and esoi3.risultato_ind <>''
and esoi3.peso_ob is not null 
and esoi3.peso_ob <>''
and esoi3.cod_struttura= $P{codiceStruttura}]]>
		</queryString>
		<field name="Codice Struttura" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Codice Struttura"/>
			<property name="com.jaspersoft.studio.field.label" value="Codice Struttura"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="exp_str_ob_ind"/>
		</field>
		<field name="Titolo Obiettivo" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Titolo Obiettivo"/>
			<property name="com.jaspersoft.studio.field.label" value="Titolo Obiettivo"/>
		</field>
		<field name="Peso" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Peso"/>
			<property name="com.jaspersoft.studio.field.label" value="Peso"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="exp_str_ob_ind"/>
		</field>
		<field name="Peso X Valore Raggiunto /100" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="Peso X Valore Raggiunto /100"/>
			<property name="com.jaspersoft.studio.field.label" value="Peso X Valore Raggiunto /100"/>
		</field>
		<field name="Indicatore" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Indicatore"/>
			<property name="com.jaspersoft.studio.field.label" value="Indicatore"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="exp_str_ob_ind"/>
		</field>
		<field name="Regola di Calcolo" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Regola di Calcolo"/>
			<property name="com.jaspersoft.studio.field.label" value="Regola di Calcolo"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="exp_str_ob_ind"/>
		</field>
		<field name="Valore Obiettivo (target)" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Valore Obiettivo (target)"/>
			<property name="com.jaspersoft.studio.field.label" value="Valore Obiettivo (target)"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="exp_str_ob_ind"/>
		</field>
		<field name="Consuntivo" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Consuntivo"/>
			<property name="com.jaspersoft.studio.field.label" value="Consuntivo"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="exp_str_ob_ind"/>
		</field>
		<field name="Valore Raggiunto (0-100)" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Valore Raggiunto (0-100)"/>
			<property name="com.jaspersoft.studio.field.label" value="Valore Raggiunto (0-100)"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="exp_str_ob_ind"/>
		</field>
		<group name="Group1">
			<groupExpression><![CDATA[$F{Titolo Obiettivo}]]></groupExpression>
		</group>
	</subDataset>
	<parameter name="ReportTitle" class="java.lang.String" isForPrompting="false"/>
	<parameter name="langLocale" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
