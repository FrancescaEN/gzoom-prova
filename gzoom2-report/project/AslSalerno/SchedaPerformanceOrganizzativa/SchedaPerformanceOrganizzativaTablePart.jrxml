		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="YEAR" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[YEAR($P{customTimePeriod})]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select distinct
str.work_effort_type_id as "Tipologia Struttura",
ppr.parent_role_code as "Codice Struttura",
str.work_effort_name as "Nome Struttura",
str.current_status_id as "Stato Struttura",
to_char(str.estimated_start_date,'YYYY') as "Anno",
pad.work_effort_name as "Struttura Padre",
concat(pe.last_name,' ',pe.first_name) as "Direttore/Referente/ Responsabile",
CONCAT(dirpe.last_name, ' ', dirpe.first_name) AS "Direttore/Referente/Responsabile Struttura Superiore",
dirpe.salutation as "Titolo Direttore/Referente/Responsabile Struttura Superiore",
MAX(CASE WHEN wes.status_id = 'WEORGST_PLANSHARED' THEN wes.status_datetime END) AS "Data Assegnata/Visionata",
MAX(CASE WHEN wes.status_id = 'WEORGST_PLANAPP' THEN wes.status_datetime END) AS "Data Visionata/Confermata",
MAX(CASE WHEN wes.status_id = 'STR_EXEC' THEN wes.status_datetime END) AS "Data Valutazione in proposta/Obiettivi consuntivati",
MAX(CASE WHEN wes.status_id = 'STR_EXECVAL' THEN wes.status_datetime END) AS "Data Obiettivi consuntivati/Obiettivi visionati"
from work_effort str
left join work_effort_assoc wea on wea.work_effort_id_to=str.work_effort_id and wea.work_effort_assoc_type_id ='20P20ORG'
left join work_effort pad on pad.work_effort_id=wea.work_effort_id_from
left join party_relationship pr on pr.party_id_from=str.org_unit_id and pr.party_relationship_type_id='ORG_RESPONSIBLE' and pr.thru_date is null
left join party_relationship orgsup on orgsup.party_id_to=str.org_unit_id and orgsup.party_relationship_type_id='GROUP_ROLLUP' and orgsup.thru_date is null
left join party_relationship dirsup on dirsup.party_id_from=orgsup.party_id_from and dirsup.party_relationship_type_id = 'ORG_RESPONSIBLE' and dirsup.thru_date is null
left join person dirpe on dirpe.party_id=dirsup.party_id_to
left join person pe on pe.party_id=pr.party_id_to
left join party_parent_role ppr on ppr.party_id = pr.party_id_from
LEFT JOIN work_effort_status wes ON wes.work_effort_id = str.work_effort_id
-- where str.work_effort_type_id in('20P21SC','20P22SPL','20P24SSL','20P26STL')
where str.work_effort_type_id in ('20P21SC', '20P21SCO', '20P21SCOF', '20P21UCD', '20P22SPL', '20P22SPLSCO', '20P24SSL')  --- Per Asl Salerno
and str.estimated_start_date<=  $P{date3112} and str.estimated_start_date>=  $P{date0101} 
 $P!{orgUnitIdString} 
GROUP BY ppr.parent_role_code, str.work_effort_name, TO_CHAR(str.estimated_start_date, 'YYYY'),pad.work_effort_name, pe.last_name, pe.first_name, dirpe.first_name, dirpe.last_name,str.work_effort_type_id,str.current_status_id,dirpe.salutation
order by ppr.parent_role_code asc]]>
	</queryString>
