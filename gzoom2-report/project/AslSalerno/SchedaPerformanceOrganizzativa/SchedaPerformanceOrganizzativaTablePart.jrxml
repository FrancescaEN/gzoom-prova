		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="orgUnitIdString" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[(
 $P{workEffortId}  != null && $P{workEffortId}  != "" && LEN($P{workEffortId}) != 0 ? 
 "AND str.work_effort_id='" + $P{workEffortId} +  "' AND ppr.party_id=str.org_unit_id " : (
 $P{orgUnitId}  != null && $P{orgUnitId}  != "" && LEN($P{orgUnitId}) != 0  ?
 "and ppr.party_id= '"+ $P{orgUnitId}+ "'":" AND ppr.parent_role_code like '%%'")
 )]]></defaultValueExpression>
	</parameter>
