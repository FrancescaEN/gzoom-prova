	<queryString language="SQL">
		<![CDATA[select
    wem.work_effort_id as "ID Obiettivo",
    obt.work_effort_name as "Nome Obiettivo",
    obt.etch as "Codice Obiettivo",
    note.peso as "Peso Obiettivo",
    note.resp as "Responsabile",
    note.stk as "Utenti/STK",
    note.contr as "Contributori",
    note.tempi as "Tempi",
	gl.gl_account_id as "ID indicatore",
	wem.work_effort_measure_id as "ID misura",
	wem.comments2 as "Dimensione",
	wem.uom_descr as "Formula",
	gl.account_name as "UDM",
	wem.kpi_score_weight as "Peso",
	u.uom_type_id as "Tipo UDM",
	val.baseline, val.consuntivo_m2, val.preconsuntivo_m1, val.target, val.target_p1, val.target_p2,
	val.baseline_str, val.consuntivo_m2_str, val.preconsuntivo_m1_str, val.target_str, val.target_p1_str, val.target_p2_str,
	val.baseline_commento, val.consuntivo_m2_commento, val.preconsuntivo_m1_commento, val.target_commento, val.target_p1_commento, val.target_p2_commento,
	wem."comments" as "Fonte del dato",
    ROW_NUMBER() OVER (PARTITION BY obt.work_effort_id ORDER BY wem.work_effort_measure_id) as "Progressivo Misura"
/* OBIETTIVO TRASVERSALE */
from work_effort obt
/* NOTE */
left join (
    select
        wen.work_effort_id,
        max(case when wen.sequence_id = 100 then nd.note_info else null end) as peso,
        max(case when wen.sequence_id = 200 then nd.note_info else null end) as resp,
        max(case when wen.sequence_id = 210 then nd.note_info else null end) as stk,
        max(case when wen.sequence_id = 220 then nd.note_info else null end) as contr,
        max(case when wen.sequence_id = 230 then nd.note_info else null end) as tempi
    from work_effort_note wen
    join note_data nd on nd.note_id = wen.note_id
    group by
        wen.work_effort_id
) note on note.work_effort_id = obt.work_effort_id
join work_effort_measure wem on wem.work_effort_id = obt.work_effort_id
join gl_account gl on gl.gl_account_id = wem.gl_account_id
join uom u on u.uom_id = gl.default_uom_id
/* VALORI */
left join (
    select
        ate.voucher_ref,
        max(case when extract(year from act.transaction_date) = 2022 and ate.gl_fiscal_type_id = 'BASELINE' then ate.amount else null end) as baseline,
        max(case when extract(year from act.transaction_date) =  $P{YEARM2} and ate.gl_fiscal_type_id = 'ACTUAL' then ate.amount else null end) as consuntivo_m2,
        max(case when extract(year from act.transaction_date) =  $P{YEARM1}  and ate.gl_fiscal_type_id = 'ACTUAL' then ate.amount else null end) as preconsuntivo_m1,
        max(case when extract(year from act.transaction_date) =   $P{YEAR} and ate.gl_fiscal_type_id = 'BUDGET' then ate.amount else null end) as target,
        max(case when extract(year from act.transaction_date) =  $P{YEARP1}  and ate.gl_fiscal_type_id = 'BUDGET' then ate.amount else null end) as target_p1,
        max(case when extract(year from act.transaction_date) =  $P{YEARP2}  and ate.gl_fiscal_type_id = 'BUDGET' then ate.amount else null end) as target_p2,
        max(case when extract(year from act.transaction_date) = 2022 and ate.gl_fiscal_type_id = 'BASELINE' then gamrs.uom_code else null end) as baseline_str,
        max(case when extract(year from act.transaction_date) =  $P{YEARM2} and ate.gl_fiscal_type_id = 'ACTUAL' then gamrs.uom_code else null end) as consuntivo_m2_str,
        max(case when extract(year from act.transaction_date) =  $P{YEARM1}  and ate.gl_fiscal_type_id = 'ACTUAL' then gamrs.uom_code else null end) as preconsuntivo_m1_str,
        max(case when extract(year from act.transaction_date) =   $P{YEAR} and ate.gl_fiscal_type_id = 'BUDGET' then gamrs.uom_code else null end) as target_str,
        max(case when extract(year from act.transaction_date) =  $P{YEARP1}  and ate.gl_fiscal_type_id = 'BUDGET' then gamrs.uom_code else null end) as target_p1_str,
        max(case when extract(year from act.transaction_date) =  $P{YEARP2}  and ate.gl_fiscal_type_id = 'BUDGET' then gamrs.uom_code else null end) as target_p2_str,
        max(case when extract(year from act.transaction_date) = 2022 and ate.gl_fiscal_type_id = 'BASELINE' then act.description else null end) as baseline_commento,
        max(case when extract(year from act.transaction_date) =  $P{YEARM2} and ate.gl_fiscal_type_id = 'ACTUAL' then act.description else null end) as consuntivo_m2_commento,
        max(case when extract(year from act.transaction_date) =  $P{YEARM1}  and ate.gl_fiscal_type_id = 'ACTUAL' then act.description else null end) as preconsuntivo_m1_commento,
        max(case when extract(year from act.transaction_date) =   $P{YEAR} and ate.gl_fiscal_type_id = 'BUDGET' then act.description else null end) as target_commento,
        max(case when extract(year from act.transaction_date) =  $P{YEARP1}  and ate.gl_fiscal_type_id = 'BUDGET' then act.description else null end) as target_p1_commento,
        max(case when extract(year from act.transaction_date) =  $P{YEARP2}  and ate.gl_fiscal_type_id = 'BUDGET' then act.description else null end) as target_p2_commento
    from acctg_trans_entry ate
    join acctg_trans act on act.acctg_trans_id = ate.acctg_trans_id
    left join gl_account_meas_rat_sc gamrs on gamrs.gl_account_id = ate.gl_account_id and gamrs.uom_rating_value = ate.amount
    group by
        ate.voucher_ref
) val on val.voucher_ref = wem.work_effort_measure_id
where obt.work_effort_type_id = '26R82OBT' and extract(year from obt.estimated_completion_date) =  $P{YEAR}  --Anno lancio stampa
order by
    obt.etch]]>
	</queryString>
