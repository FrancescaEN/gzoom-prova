	<queryString>
		<![CDATA[select
we.work_effort_name as nome_obiettivo,
p.party_name as struttura,
note.link_sito,
note.contesto_interno,
note.risultati_conseguiti,
note.iniziative,
note.risultati,
note.criticita,
note.documenti
from work_effort we
join party p on p.party_id = we.org_unit_id
left join (
select
wen.work_effort_id,
max(case when wen.sequence_id = 290 then nd.note_info else null end) as link_sito,
max(case when wen.sequence_id = 300 then nd.note_info else null end) as contesto_interno,
max(case when wen.sequence_id = 310 then nd.note_info else null end) as risultati_conseguiti,
max(case when wen.sequence_id = 320 then nd.note_info else null end) as iniziative,
max(case when wen.sequence_id = 330 then nd.note_info else null end) as risultati,
max(case when wen.sequence_id = 340 then nd.note_info else null end) as criticita,
max(case when wen.sequence_id = 350 then nd.note_info else null end) as documenti
from work_effort_note wen
join note_data nd on nd.note_id = wen.note_id
group by
wen.work_effort_id
) note on note.work_effort_id = we.work_effort_id
where we.work_effort_id = $P{workEffortId}]]>
	</queryString>
