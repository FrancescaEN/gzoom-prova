					<textFieldExpression><![CDATA[($F{Tipo misura}.equals("RATING_SCALE") ? 
     ($F{monitoraggio_stringa} == null || $F{monitoraggio_stringa}.equals("") ? "" : $F{monitoraggio_stringa}) :
     ($F{monitoraggio_valore} == null || $F{monitoraggio_valore}.toString().equals("") ? "" : 
         ($F{monitoraggio_valore}.doubleValue() % 1 == 0 ? 
             String.format("%,d", $F{monitoraggio_valore}.intValue()).replace(',', '.') + ($F{UDM}.equals("Perc.") ? " %" : "")  : 
             String.format("%,.2f", $F{monitoraggio_valore}).replace(',', 'X').replace('.', ',').replace('X', '.')+ ($F{UDM}.equals("Perc.") ? " %" : "") 
         )
     )
) + 
($F{monitoraggio_commento} != "" && $F{monitoraggio_commento} != null ? "\n" + $F{monitoraggio_commento} : "")]]></textFieldExpression>
