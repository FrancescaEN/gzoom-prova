	<queryString language="SQL">
		<![CDATA[/* SOTTOSEZIONE VALORE PUBBLICO */
select
	strat.work_effort_id as "ID Strategia",
	strat.etch as "Codice",
	strat.work_effort_name as "Nome",
	descr.note_info as "Descrizione",
	note.resp as "Responsabile",
	note.utenti as "Utenti/STK",
	wem."comments" as "Responsabile Old",
	wem.comments2 as "Utenti/STK Old",
	wem.uom_descr as "Contributors",
	case when wem.thru_date = '2099-12-31' then 'Continuativa' else extract(year from wem.thru_date)::text end as "Tempi",
	upper(gac.description) as "Dimensione",
	gl.account_name as "Nome indicatore", /* DA CONCATENARE CON CAMPO PRECEDENTE, ANDANDO A CAPO */
	gl.description as "Formula",
	case when gl.debit_credit_default = 'D' then '+' else '-' end as "Direzione",
	wem.kpi_score_weight as "Peso",
	u.uom_type_id as "Tipo misura", /* SE RATING SCALE MOSTRO STRINGA, ALTRIMENTI VALORE */
	baseline_valore, baseline_stringa, baseline_commento, baseline_scorekpi,
	consuntivo_m2_valore, consuntivo_m2_stringa, consuntivo_m2_commento, consuntivo_m2_scorekpi,
	preconsuntivo_m1_valore, preconsuntivo_m1_stringa, preconsuntivo_m1_commento, preconsuntivo_m1_scorekpi,
	target_valore, target_stringa, target_commento, target_scorekpi,
	consuntivo_valore, consuntivo_stringa, consuntivo_commento, consuntivo_scorekpi,
	target_p1_valore, target_p1_stringa, target_p1_commento, target_p1_scorekpi,
	target_p2_valore, target_p2_stringa, target_p2_commento, target_p2_scorekpi,
	soginf_valore, soginf_stringa, soginf_commento, sogsup_valore, sogsup_stringa, sogsup_commento,
	gl.source as "Fonte",
	u.abbreviation as "UDM",
	ROW_NUMBER() OVER (PARTITION BY strat.work_effort_id ORDER BY wem.sequence_id,wem.work_effort_measure_id) as "Progressivo"
/* STRATEGIA */
from work_effort strat
/* COLLEGAMENTO CON OBIETTIVO DI VALORE PUBBLICO */
join work_effort_assoc wea on wea.work_effort_id_to = strat.work_effort_id and wea.work_effort_assoc_type_id = '23R4'
join work_effort subsez on subsez.work_effort_id = wea.work_effort_id_from
	and subsez.work_effort_type_id = '23R44S21' and subsez.work_effort_revision_id is null
join work_effort ovp on ovp.work_effort_id = subsez.work_effort_parent_id
	and ovp.work_effort_type_id = '23R40PIAO' and ovp.work_effort_revision_id is null
/* DESCRIZIONE */
left join (
	select
		wen.work_effort_id,
		nd.note_info
	from work_effort_note wen
	join note_data nd on nd.note_id = wen.note_id
	where wen.sequence_id = 100
) descr on descr.work_effort_id = strat.work_effort_id
/* NOTE OLD */
left join (
	select
		wen.work_effort_id,
		max(case when wen.sequence_id = 300 then nd.note_info else null end) as resp,
		max(case when wen.sequence_id = 310 then nd.note_info else null end) as utenti
	from work_effort_note wen
	join note_data nd on nd.note_id = wen.note_id
	group by
		wen.work_effort_id
) note on note.work_effort_id = strat.work_effort_id
/* INDICATORI */
left join work_effort_measure wem on wem.work_effort_id = strat.work_effort_id and wem.gl_account_id not like 'SCORE%' 
left join gl_account gl on gl.gl_account_id = wem.gl_account_id
left join gl_account_class gac on gac.gl_account_class_id = gl.gl_account_class_id
left join uom u on u.uom_id = gl.default_uom_id
/* VALORI INDICATORI */
left join (
	select
		ate.gl_account_id,
		ate.voucher_ref,
		max(case when ate.gl_fiscal_type_id = 'BASELINE' and extract(year from act.transaction_date) = 2022 then ate.amount else null end) as baseline_valore,
		max(case when ate.gl_fiscal_type_id = 'BASELINE' and extract(year from act.transaction_date) = 2022 then gamrs.uom_descr else null end) as baseline_stringa,
		max(case when ate.gl_fiscal_type_id = 'BASELINE' and extract(year from act.transaction_date) = 2022 then act.description else null end) as baseline_commento,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEARM2}  then ate.amount else null end) as consuntivo_m2_valore,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEARM2}  then gamrs.uom_descr else null end) as consuntivo_m2_stringa,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEARM2}  then act.description else null end) as consuntivo_m2_commento,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEAR}  then ate.amount else null end) as consuntivo_valore,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEAR}  then gamrs.uom_descr else null end) as consuntivo_stringa,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEAR}  then act.description else null end) as consuntivo_commento,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEARM1}  then ate.amount else null end) as preconsuntivo_m1_valore,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEARM1}  then gamrs.uom_descr else null end) as preconsuntivo_m1_stringa,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEARM1}  then act.description else null end) as preconsuntivo_m1_commento,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEAR}  then ate.amount else null end) as target_valore,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEAR}  then gamrs.uom_descr else null end) as target_stringa,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEAR}  then act.description else null end) as target_commento,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP1}  then ate.amount else null end) as target_p1_valore,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP1}  then gamrs.uom_descr else null end) as target_p1_stringa,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP1}  then act.description else null end) as target_p1_commento,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP2}  then ate.amount else null end) as target_p2_valore,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP2}  then gamrs.uom_descr else null end) as target_p2_stringa,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP2}  then act.description else null end) as target_p2_commento,
		max(case when ate.gl_fiscal_type_id = 'SOGINF' then ate.amount else null end) as soginf_valore,
		max(case when ate.gl_fiscal_type_id = 'SOGINF' then gamrs.uom_descr else null end) as soginf_stringa,
		max(case when ate.gl_fiscal_type_id = 'SOGINF' then act.description else null end) as soginf_commento,
		max(case when ate.gl_fiscal_type_id = 'SOGSUP' then ate.amount else null end) as sogsup_valore,
		max(case when ate.gl_fiscal_type_id = 'SOGSUP' then gamrs.uom_descr else null end) as sogsup_stringa,
		max(case when ate.gl_fiscal_type_id = 'SOGSUP' then act.description else null end) as sogsup_commento
	from acctg_trans_entry ate
	join acctg_trans act on act.acctg_trans_id = ate.acctg_trans_id
	left join gl_account_meas_rat_sc gamrs on gamrs.gl_account_id = ate.gl_account_id
		and ate.amount = gamrs.uom_rating_value
	where ate.gl_account_id not like 'SCORE%' and ate.voucher_ref is null
	group by
		ate.gl_account_id,
		ate.voucher_ref
) valind on (valind.gl_account_id = wem.gl_account_id and gl.input_enum_id = 'ACCINP_UO') or
	(gl.input_enum_id = 'ACCINP_OBJ' and valind.voucher_ref = wem.work_effort_measure_id)
/* SCOREKPI */
left join (
	select
		wem.work_effort_id,
		gl.gl_account_id,
		max(case when ate.gl_fiscal_type_id = 'BASELINE' and extract(year from act.transaction_date) = 2022 then ate.amount else null end) as baseline_scorekpi,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEARM2}  then ate.amount else null end) as consuntivo_m2_scorekpi,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEARM1}  then ate.amount else null end) as preconsuntivo_m1_scorekpi,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEAR}  then ate.amount else null end) as target_scorekpi,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEAR}  then ate.amount else null end) as consuntivo_scorekpi,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP1}  then ate.amount else null end) as target_p1_scorekpi,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP2}  then ate.amount else null end) as target_p2_scorekpi
	from work_effort_measure wem
	join gl_account gl on gl.gl_account_id = wem.gl_account_id
	join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id and ate.gl_account_id = 'SCOREKPI'
	join acctg_trans act on act.acctg_trans_id = ate.acctg_trans_id
	group by
		wem.work_effort_id,
		gl.gl_account_id
) scorekpi on (scorekpi.gl_account_id, scorekpi.work_effort_id) = (valind.gl_account_id, wem.work_effort_id)
where strat.work_effort_type_id = '23R80OBS' and strat.work_effort_revision_id is null
	and extract(year from strat.estimated_completion_date) = $P{YEAR}
	and ovp.work_effort_id= $P{idOvp}
	/* ID OVP PASSATO DA QUERY SOPRA */
order by CASE WHEN strat.etch ~ '^\d+\)' THEN CAST(SUBSTRING(strat.etch  FROM '^\d+') AS INTEGER) ELSE NULL END, strat.etch ,wem.sequence_id,wem.work_effort_measure_id]]>
	</queryString>
