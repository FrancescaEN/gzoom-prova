					<textFieldExpression><![CDATA[($F{Tipo misura}.equals("RATING_SCALE") ? 
     ($F{baseline_stringa} == null || $F{baseline_stringa}.equals("") ? "" : $F{baseline_stringa}) :
     ($F{baseline_valore} == null || $F{baseline_valore}.toString().equals("") ? "" : 
         ($F{baseline_valore}.doubleValue() % 1 == 0 ? 
             String.format("%,d", $F{baseline_valore}.intValue()).replace(',', '.') + ($F{UDM}.equals("Perc.") ? " %" : "")  : 
             String.format("%,.2f", $F{baseline_valore}).replace(',', 'X').replace('.', ',').replace('X', '.')+($F{UDM}.equals("Perc.") ? " %" : "")
         )
     )
) + 
($F{baseline_commento} != "" && $F{baseline_commento} != null ? "\n" + $F{baseline_commento} : "")]]></textFieldExpression>
