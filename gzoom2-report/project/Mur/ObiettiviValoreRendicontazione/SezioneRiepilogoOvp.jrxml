	<parameter name="idOvp" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select
	ovp.work_effort_id as "Id Obiettivo valore pubblico",
	nd.note_info as "Testata Analisi",
	contesto.lista as "Analisi di contesto",
	impatti.lista as "Impatti attesi",
	subsez.work_effort_id as "Id Valore Pubblico",
	score.baseline, score.consuntivo_m2, score.preconsuntivo_m1, score.consuntivo,score.target, score.target_p1, score.target_p2
from work_effort ovp
/* SEZIONE PIAO */
join work_effort_assoc wea on wea.work_effort_id_from = ovp.work_effort_id and wea.work_effort_assoc_type_id = '23R4'
join work_effort sez on sez.work_effort_id = wea.work_effort_id_to
	and sez.work_effort_type_id = '23R42SEZ' and sez.work_effort_revision_id is null
/* SOTTOSEZIONE VALORE PUBBLICO */
join work_effort_assoc wea2 on wea2.work_effort_id_from = sez.work_effort_id and wea2.work_effort_assoc_type_id = '23R4'
join work_effort subsez on subsez.work_effort_id = wea2.work_effort_id_to
	and subsez.work_effort_type_id = '23R44S21' and subsez.work_effort_revision_id is null
join work_effort_note wen on wen.work_effort_id = subsez.work_effort_id and wen.sequence_id = 200
join note_data nd on nd.note_id = wen.note_id
/* ANALISI DI CONTESTO AGGREGATA */
LEFT JOIN (
  SELECT
    wea3.work_effort_id_from,
    string_agg(note_info, E'\n' ORDER BY etch) AS lista
  FROM work_effort_assoc wea3
  JOIN (
    SELECT DISTINCT
      strat.work_effort_id,
      nd.note_info,
      strat.etch
    FROM work_effort strat
    JOIN work_effort_note wen
      ON wen.work_effort_id = strat.work_effort_id
     AND wen.sequence_id = 200
    JOIN note_data nd
      ON nd.note_id = wen.note_id
    WHERE strat.work_effort_type_id = '23R80OBS'
  ) strat ON strat.work_effort_id = wea3.work_effort_id_to
  WHERE wea3.work_effort_assoc_type_id = '23R4'
  GROUP BY wea3.work_effort_id_from
) contesto ON contesto.work_effort_id_from = subsez.work_effort_id
/* IMPATTI ATTESI AGGREGATI */
LEFT JOIN (
  SELECT
    wea3.work_effort_id_from,
    string_agg(note_info, E'\n' ORDER BY etch) AS lista
  FROM work_effort_assoc wea3
  JOIN (
    SELECT DISTINCT
      strat.work_effort_id,
      nd.note_info,
      strat.etch
    FROM work_effort strat
    JOIN work_effort_note wen
      ON wen.work_effort_id = strat.work_effort_id
     AND wen.sequence_id = 210
    JOIN note_data nd
      ON nd.note_id = wen.note_id
    WHERE strat.work_effort_type_id = '23R80OBS'
  ) strat ON strat.work_effort_id = wea3.work_effort_id_to
  WHERE wea3.work_effort_assoc_type_id = '23R4'
  GROUP BY wea3.work_effort_id_from
) impatti ON impatti.work_effort_id_from = subsez.work_effort_id
/* PUNTEGGI */
left join (
	select
		wem.work_effort_id,
		max(case when extract(year from act.transaction_date) = 2022 and ate.gl_fiscal_type_id = 'BASELINE' then ate.amount else null end) as baseline,
		max(case when extract(year from act.transaction_date) = $P{YEARM2} and ate.gl_fiscal_type_id = 'ACTUAL' then ate.amount else null end) as consuntivo_m2,
		max(case when extract(year from act.transaction_date) = $P{YEARM1} and ate.gl_fiscal_type_id = 'ACTUAL' then ate.amount else null end) as preconsuntivo_m1,
		max(case when extract(year from act.transaction_date) = $P{YEAR} and ate.gl_fiscal_type_id = 'ACTUAL' then ate.amount else null end) as consuntivo,
		max(case when extract(year from act.transaction_date) = $P{YEAR} and ate.gl_fiscal_type_id = 'BUDGET' then ate.amount else null end) as target,
		max(case when extract(year from act.transaction_date) = $P{YEARP1} and ate.gl_fiscal_type_id = 'BUDGET' then ate.amount else null end) as target_p1,
		max(case when extract(year from act.transaction_date) = $P{YEARP2} and ate.gl_fiscal_type_id = 'BUDGET' then ate.amount else null end) as target_p2
	from work_effort_measure wem
	join acctg_trans act on act.voucher_ref = wem.work_effort_measure_id
	join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id and ate.gl_account_id = 'SCORE'
	where wem.gl_account_id = 'SCORE'
	group by
		wem.work_effort_id
) score on score.work_effort_id = subsez.work_effort_id
where ovp.work_effort_type_id = '23R40PIAO' and ovp.work_effort_revision_id is null and ovp.work_effort_id =  $P{idOvp} /* PASSATO DALLA QUERY SOPRA */]]>
	</queryString>
