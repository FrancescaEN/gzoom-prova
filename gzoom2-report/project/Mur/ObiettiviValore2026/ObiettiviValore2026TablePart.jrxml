	<queryString>
		<![CDATA[select 
	fil_w.work_effort_id as "ID Obiettivo Valore Pubblico",
	fil_w.etch as "Etichetta Obiettivo Valore Pubblico",
	fil_w.work_effort_name as "Nome Obiettivo Valore Pubblico",
	fil_w.org_unit_id as "ID struttura",
	fil_w.info_url as "Num. Allegato",
	p.party_name as "Nome struttura",
	ppr.parent_role_code as "Codice struttura"
/* OBIETTIVO DI VALORE PUBBLICO */
from work_effort fil_w
/* STRUTTURA */
join party p on p.party_id = fil_w.org_unit_id
join party_parent_role ppr on ppr.party_id = p.party_id 
/* START filterInnerJoin */
   $P!{filterInnerJoinString} 
/* END filterInnerJoin */
/* START filterLeftJoin */
  $P!{filterLeftJoinString} 
/* END filterLeftJoin */
where fil_w.work_effort_type_id = '26R40PIAO' and fil_w.work_effort_revision_id is null
	and extract(year from fil_w.estimated_completion_date) = $P{YEAR} 
  /* START filterWhere */
 $P!{filterWhereString} 
   /* END filterWhere */
 $P!{workEffortIdString} 
  $P!{orgUnitIdString} 
  order by fil_w.info_url,ppr.parent_role_code,fil_w.etch]]>
	</queryString>
