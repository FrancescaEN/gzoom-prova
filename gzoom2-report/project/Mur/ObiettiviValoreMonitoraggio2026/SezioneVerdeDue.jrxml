	<queryString language="SQL">
		<![CDATA[/* SOTTOSEZIONE AZIONI ORGANIZZATIVE AGILI */
select
	azi.work_effort_id as "ID Azione Organizzativa",
	azi.etch as "Codice",
	azi.work_effort_name as "Nome",
	note.descr as "Descrizione",
	note.resp as "Responsabile",
	note.contr as "Contributors",
	note.tempi as "Tempi",
	wem.comments as "Fonte",
	upper(wem.comments2) as "Dimensione",
	wem.uom_descr as "Formula",
	gl.account_name as "Nome indicatore", /* DA CONCATENARE CON CAMPO PRECEDENTE, ANDANDO A CAPO */
	case when gl.debit_credit_default = 'D' then '+' else '-' end as "Direzione",
	u.uom_type_id as "Tipo misura", /* SE RATING SCALE MOSTRO STRINGA, ALTRIMENTI VALORE */
	baseline_valore, baseline_stringa, baseline_commento,
	consuntivo_m2_valore, consuntivo_m2_stringa, consuntivo_m2_commento,
	preconsuntivo_m1_valore, preconsuntivo_m1_stringa, preconsuntivo_m1_commento,
	target_valore, target_stringa, target_commento,
	consuntivo_valore, consuntivo_stringa, consuntivo_commento,
	target_p1_valore, target_p1_stringa, target_p1_commento,
	target_p2_valore, target_p2_stringa, target_p2_commento
/* AZIONE ORGANIZZATIVA */
from work_effort azi
/* COLLEGAMENTO CON OBIETTIVO DI VALORE PUBBLICO */
join work_effort_assoc wea on wea.work_effort_id_to = azi.work_effort_id and wea.work_effort_assoc_type_id = '23R4'
join work_effort subsez on subsez.work_effort_id = wea.work_effort_id_from
	and subsez.work_effort_type_id = '26R44S32' and subsez.work_effort_revision_id is null
join work_effort ovp on ovp.work_effort_id = subsez.work_effort_parent_id
	and ovp.work_effort_type_id = '26R40PIAO' and ovp.work_effort_revision_id is null
/* NOTE */
left join (
	select
		wen.work_effort_id,
		max(case when wen.sequence_id = 100 then nd.note_info else null end) as descr,
		max(case when wen.sequence_id = 200 then nd.note_info else null end) as resp,
		max(case when wen.sequence_id = 210 then nd.note_info else null end) as contr,
		max(case when wen.sequence_id = 220 then nd.note_info else null end) as tempi
	from work_effort_note wen
	join note_data nd on nd.note_id = wen.note_id
	group by
		wen.work_effort_id
) note on note.work_effort_id = azi.work_effort_id
/* INDICATORI */
left join work_effort_measure wem on wem.work_effort_id = azi.work_effort_id and wem.gl_account_id not like 'SCORE%'
left join gl_account gl on gl.gl_account_id = wem.gl_account_id
left join gl_account_class gac on gac.gl_account_class_id = gl.gl_account_class_id
left join uom u on u.uom_id = gl.default_uom_id
/* VALORI INDICATORI */
left join (
	select
		ate.gl_account_id,
		ate.voucher_ref,
		max(case when ate.gl_fiscal_type_id = 'BASELINE' and extract(year from act.transaction_date) = 2022 then ate.amount else null end) as baseline_valore,
		max(case when ate.gl_fiscal_type_id = 'BASELINE' and extract(year from act.transaction_date) = 2022 then gamrs.uom_descr else null end) as baseline_stringa,
		max(case when ate.gl_fiscal_type_id = 'BASELINE' and extract(year from act.transaction_date) = 2022 then act.description else null end) as baseline_commento,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEARM2}  then ate.amount else null end) as consuntivo_m2_valore,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEARM2} then gamrs.uom_descr else null end) as consuntivo_m2_stringa,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEARM2} then act.description else null end) as consuntivo_m2_commento,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEARM1} then ate.amount else null end) as preconsuntivo_m1_valore,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEARM1} then gamrs.uom_descr else null end) as preconsuntivo_m1_stringa,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEARM1} then act.description else null end) as preconsuntivo_m1_commento,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEAR} then ate.amount else null end) as target_valore,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEAR} then gamrs.uom_descr else null end) as target_stringa,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEAR} then act.description else null end) as target_commento,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEAR}  then ate.amount else null end) as consuntivo_valore,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEAR} then gamrs.uom_descr else null end) as consuntivo_stringa,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEAR} then act.description else null end) as consuntivo_commento,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP1} then ate.amount else null end) as target_p1_valore,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP1} then gamrs.uom_descr else null end) as target_p1_stringa,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP1} then act.description else null end) as target_p1_commento,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP2} then ate.amount else null end) as target_p2_valore,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP2} then gamrs.uom_descr else null end) as target_p2_stringa,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP2} then act.description else null end) as target_p2_commento
	from acctg_trans_entry ate
	join acctg_trans act on act.acctg_trans_id = ate.acctg_trans_id
	left join gl_account_meas_rat_sc gamrs on gamrs.gl_account_id = ate.gl_account_id
		and ate.amount = gamrs.uom_rating_value
	group by
		ate.gl_account_id,
		ate.voucher_ref
) valind on (valind.gl_account_id = wem.gl_account_id and gl.input_enum_id = 'ACCINP_UO') or
	(gl.input_enum_id = 'ACCINP_OBJ' and valind.voucher_ref = wem.work_effort_measure_id)
where azi.work_effort_type_id = '26R86AOA' and azi.work_effort_revision_id is null
	and extract(year from azi.estimated_completion_date) = $P{YEAR}	
	and ovp.work_effort_id= $P{idOvp}
	/* ID OVP PASSATO DA QUERY SOPRA */
order by azi.etch]]>
	</queryString>
