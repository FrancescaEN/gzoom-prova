	<parameter name="idMisura" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[/* SOTTOSEZIONE ANTICORRUZIONE E TRASPARENZA */
select
ROW_NUMBER() OVER (PARTITION BY proc.work_effort_id ORDER BY proc.etch,ris.etch,mis.etch) as "Progressivo",
	ar.work_effort_id as "ID Area",
	proc.work_effort_id as "ID Processo",
	proc.work_effort_name as "Denominazione",
	note.nome_resp as "Nome nota Responsabile processo",
	note.resp as "Responsabile processo",
	note.nome_procedimento as "Nome note Procedimento",
	note.procedimento as "Procedimento",
	note.nome_inp as "Nome nota Input",
	note.inp as "Input",
	note.nome_fasi as "Nome nota fasi",
	note.fasi as "Fasi",
	note.nome_outp as "Nome nota Output",
	note.outp as "Output",
	note.nome_interni as "Nome nota Attori interni",
	note.interni as "Attori interni",
	note.nome_esterni as "Nome nota Attori esterni",
	note.esterni as "Attori esterni",
	case when ar.etch is null then null else concat(ar.etch, ' - ', ar.work_effort_name) end as "Area di rischio",
	case when ar.etch is null then null else concat(ar.etch, ' - ', note.altra_area) end as "Altra Area di rischio",
	anac.work_effort_name as "Priorità ANAC",
	ris.work_effort_id as "Id Rischio",
	ris.work_effort_name as "Nome rischio",
	mis.work_effort_id as "Id Misura",
	mis.work_effort_name as "Nome misura",
	mis.etch as "Etichetta misura",
	obp.lista as "Obiettivi di Performance",
	ndmis.note_info as "Responsabile misura",
	wept.description as "Tipologia misura",
	mis.work_effort_id as "ID Misura",
	wem.work_effort_measure_id as "ID indicatore su scheda",
	gl.gl_account_id as "ID indicatore",
	u.abbreviation as "Unità di misura",
	u.uom_type_id as "Tipo indicatore",
	wem.uom_descr as "Descrizione",
	wem."comments" as "Fonte del dato",
	baseline_valore, baseline_stringa, baseline_commento,
	consuntivo_m2_valore, consuntivo_m2_stringa, consuntivo_m2_commento,
	preconsuntivo_m1_valore, preconsuntivo_m1_stringa, preconsuntivo_m1_commento,
	target_valore, target_stringa, target_commento,
	target_p1_valore, target_p1_stringa, target_p1_commento,
	target_p2_valore, target_p2_stringa, target_p2_commento
/* PROCESSO */
from work_effort proc
/* COLLEGAMENTO A SOTTOSEZIONE */
join work_effort_assoc weasez on weasez.work_effort_id_to = proc.work_effort_id and weasez.work_effort_assoc_type_id = '23R4'
join work_effort subsez on subsez.work_effort_id = weasez.work_effort_id_from
	and subsez.work_effort_type_id = '26R44S23' and subsez.work_effort_revision_id is null
/* OBIETTIVO DI VALORE PUBBLICO */
join work_effort ovp on ovp.work_effort_id = subsez.work_effort_parent_id
	and ovp.work_effort_type_id = '26R40PIAO' and ovp.work_effort_revision_id is null
/* NOTE */
left join (
	select wen.work_effort_id,
		max(case when wen.sequence_id = 100 then nd.note_info else null end) as procedimento,
		max(case when wen.sequence_id = 210 then nd.note_info else null end) as inp,
		max(case when wen.sequence_id = 220 then nd.note_info else null end) as fasi,
		max(case when wen.sequence_id = 230 then nd.note_info else null end) as outp,
		max(case when wen.sequence_id = 300 then nd.note_info else null end) as resp,
		max(case when wen.sequence_id = 310 then nd.note_info else null end) as interni,
		max(case when wen.sequence_id = 320 then nd.note_info else null end) as esterni,
		max(case when wen.sequence_id = 400 then nd.note_info else null end) as altra_area,
		max(case when wen.sequence_id = 100 then nd.note_name else null end) as nome_procedimento,
		max(case when wen.sequence_id = 210 then nd.note_name else null end) as nome_inp,
		max(case when wen.sequence_id = 220 then nd.note_name else null end) as nome_fasi,
		max(case when wen.sequence_id = 230 then nd.note_name else null end) as nome_outp,
		max(case when wen.sequence_id = 300 then nd.note_name else null end) as nome_resp,
		max(case when wen.sequence_id = 310 then nd.note_name else null end) as nome_interni,
		max(case when wen.sequence_id = 320 then nd.note_name else null end) as nome_esterni,
		max(case when wen.sequence_id = 400 then nd.note_name else null end) as nome_altra_area
	from work_effort_note wen
	join note_data nd on nd.note_id = wen.note_id
	group by wen.work_effort_id
) note on note.work_effort_id = proc.work_effort_id
/* AREA DI RISCHIO */
left join work_effort_assoc wea on wea.work_effort_id_to = proc.work_effort_id and wea.work_effort_assoc_type_id = '24APSARC'
left join work_effort ar on ar.work_effort_id = wea.work_effort_id_from
	and ar.work_effort_type_id = '24A24ARE' and ar.work_effort_revision_id is null
/* PRIORITA ANAC */
left join work_effort_assoc wea2 on wea2.work_effort_id_to = proc.work_effort_id and wea2.work_effort_assoc_type_id = '24ANACPRO'
left join work_effort anac on anac.work_effort_id = wea2.work_effort_id_from
	and anac.work_effort_type_id = '24A82PRI' and anac.work_effort_revision_id is null
/* RISCHI */
left join work_effort_assoc wea3 on wea3.work_effort_id_from = proc.work_effort_id and wea3.work_effort_assoc_type_id = '24APPRO'
left join work_effort ris on ris.work_effort_id = wea3.work_effort_id_to
	and ris.work_effort_type_id = '24A46RIS' and ris.work_effort_revision_id is null
/* MISURE */
join work_effort_assoc wea4 on wea4.work_effort_id_from = ris.work_effort_id and wea4.work_effort_assoc_type_id = '24APPRO'
join work_effort mis on mis.work_effort_id = wea4.work_effort_id_to
	and mis.work_effort_type_id = '24A48MIS' and mis.work_effort_revision_id is null
/* RESPONSABILE MISURA */
left join work_effort_note wenmis on wenmis.work_effort_id = mis.work_effort_id and wenmis.sequence_id = 100
left join note_data ndmis on ndmis.note_id = wenmis.note_id
/* TIPOLOGIA MISURA */
left join work_effort_purpose_type wept on wept.work_effort_purpose_type_id = mis.work_effort_purpose_type_id
/* OBIETTIVO DI PERFORMANCE */
join (
	select
		wea.work_effort_id_to,
		string_agg(concat(obp.etch, ' - ', obp.work_effort_name), '
 
' order by obp.etch) as lista
	from work_effort_assoc wea
	join work_effort obp on obp.work_effort_id = wea.work_effort_id_from and obp.work_effort_revision_id is null and obp.work_effort_type_id = '26R82OBA'
	where wea.work_effort_assoc_type_id = '23R4'
	group by
		wea.work_effort_id_to
) obp on obp.work_effort_id_to = mis.work_effort_id
/* INDICATORE */
join work_effort_measure wem on wem.work_effort_id = mis.work_effort_id and wem.gl_account_id not like 'SCORE%'
join gl_account gl on gl.gl_account_id = wem.gl_account_id
join uom u on u.uom_id = gl.default_uom_id
/* VALORI INDICATORE */
left join (
	select 
		act.voucher_ref,
		max(case when ate.gl_fiscal_type_id = 'BASELINE' and extract(year from act.transaction_date) = 2022 then ate.amount else null end) as baseline_valore,
		max(case when ate.gl_fiscal_type_id = 'BASELINE' and extract(year from act.transaction_date) = 2022 then gamrs.uom_descr else null end) as baseline_stringa,
		max(case when ate.gl_fiscal_type_id = 'BASELINE' and extract(year from act.transaction_date) = 2022 then act.description else null end) as baseline_commento,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEARM2}  then ate.amount else null end) as consuntivo_m2_valore,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEARM2}  then gamrs.uom_descr else null end) as consuntivo_m2_stringa,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEARM2}  then act.description else null end) as consuntivo_m2_commento,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEARM1}  then ate.amount else null end) as preconsuntivo_m1_valore,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEARM1}  then gamrs.uom_descr else null end) as preconsuntivo_m1_stringa,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEARM1}  then act.description else null end) as preconsuntivo_m1_commento,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEAR}  then ate.amount else null end) as target_valore,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEAR}  then gamrs.uom_descr else null end) as target_stringa,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEAR}  then act.description else null end) as target_commento,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP1}  then ate.amount else null end) as target_p1_valore,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP1}  then gamrs.uom_descr else null end) as target_p1_stringa,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP1}  then act.description else null end) as target_p1_commento,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP2}  then ate.amount else null end) as target_p2_valore,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP2}  then gamrs.uom_descr else null end) as target_p2_stringa,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP2}  then act.description else null end) as target_p2_commento
	from acctg_trans act
	join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id and ate.gl_account_id not like 'SCORE%'
	left join gl_account_meas_rat_sc gamrs on gamrs.gl_account_id = ate.gl_account_id and ate.amount = gamrs.uom_rating_value 
	group by
		act.voucher_ref
) val on val.voucher_ref = wem.work_effort_measure_id 
where proc.work_effort_type_id = '24A42PRO' and proc.work_effort_revision_id is null
	and extract(year from proc.estimated_completion_date) = $P{YEAR}
	and mis.work_effort_id = $P{idMisura} 
order by proc.etch,	ris.etch,mis.etch]]>
	</queryString>
