	<parameter name="idValorePubblico" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select *
from (
select
	distinct on (wea.work_effort_id_from, nd.note_info) wea.work_effort_id_from, nd.note_info, we.etch  
from work_effort_assoc wea
join work_effort we on we.work_effort_id = wea.work_effort_id_to
join work_effort_note wen on wen.work_effort_id = we.work_effort_id and wen.sequence_id = 210
join note_data nd on nd.note_id = wen.note_id
where wea.work_effort_id_from = $P{idValorePubblico} ) as sub
order by CASE WHEN etch ~ '^\d+\)' THEN CAST(SUBSTRING(etch  FROM '^\d+') AS INTEGER) ELSE NULL END, etch
 ]]>
	</queryString>
