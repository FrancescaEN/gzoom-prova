					<textFieldExpression><![CDATA[($F{Tipo misura}.equals("RATING_SCALE") ? 
     ($F{soginf_stringa} == null || $F{soginf_stringa}.equals("") ? "" : $F{soginf_stringa}) :
     ($F{soginf_valore} == null || $F{soginf_valore}.toString().equals("") ? "" : 
