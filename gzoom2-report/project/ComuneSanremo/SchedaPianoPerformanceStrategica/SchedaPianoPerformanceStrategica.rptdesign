                                                    <expression name="valueExpr">row["ACTUAL5"] != null ? Formatter.format(BirtStr.indexOf("%",row._outer["FORMAT"],0) != -1 ? row["ACTUAL5"]/100 : row["ACTUAL5"], row._outer["FORMAT"]) : '';</expression>
