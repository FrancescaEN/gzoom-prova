                            <property name="name">Expression</property>
                            <expression name="value">row["NOTE_NAME"]</expression>
                        </structure>
                    </list-property>
                </structure>
            </list-property>
            <list-property name="columnHints"/>
            <list-property name="parameters">
                <structure>
                    <property name="name">WORK_EFFORT_TYPE_ID</property>
                    <property name="paramName">workEffortTypeId</property>
                    <property name="nativeName"></property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">0</property>
                    <property name="position">1</property>
                    <property name="isOptional">false</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">WORK_EFFORT_ID</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">SEQUENCE_ID</property>
                        <property name="dataType">decimal</property>
                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">NOTE_NAME</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">4</property>
                        <property name="name">NOTE_INFO</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">5</property>
                        <property name="name">WA_DESCRIPTION</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">6</property>
                        <property name="name">count</property>
                        <property name="dataType">integer</property>
                    </structure>
                </list-property>
            </structure>
            <method name="beforeOpen"><![CDATA[/*this.queryText = this.queryText.replace("@monitoringDate",  "'2023-12-31'" );*/

this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );

ReportLog.info("HEADERNOTEDS:"+ this.queryText);
ReportLog.info("PARAMS:"+ this.getInputParameters());
]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">WORK_EFFORT_ID</property>
                    <property name="nativeName">WORK_EFFORT_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">SEQUENCE_ID</property>
                    <property name="nativeName">SEQUENCE_ID</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">NOTE_NAME</property>
                    <property name="nativeName">NOTE_NAME</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">NOTE_INFO</property>
                    <property name="nativeName">NOTE_INFO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">WA_DESCRIPTION</property>
                    <property name="nativeName">WA_DESCRIPTION</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT  A0.WORK_EFFORT_ID AS "WORK_EFFORT_ID",
WN.SEQUENCE_ID AS "SEQUENCE_ID",
ND.NOTE_NAME AS "NOTE_NAME",
ND.NOTE_INFO AS "NOTE_INFO",
WA.DESCRIPTION AS "WA_DESCRIPTION"

from WORK_EFFORT_ANALYSIS WA
INNER JOIN WORK_EFFORT_TYPE_TYPE WETT ON WETT.work_effort_type_id_root = wa.work_effort_type_id AND WETT.SEQUENCE_NUM = 1  --MAPPA.WORK_EFFORT_TYPE_ID
INNER JOIN WORK_EFFORT A0 ON A0.WORK_EFFORT_TYPE_ID = WETT.WORK_EFFORT_TYPE_ID_FROM 
AND A0.ESTIMATED_START_DATE <= @monitoringDate AND A0.ESTIMATED_COMPLETION_DATE >= @monitoringDate AND A0.WORK_EFFORT_REVISION_ID IS null  --MAPPA.REFERENCE_DATE
INNER JOIN WORK_EFFORT_NOTE     WN ON A0.WORK_EFFORT_ID = WN.WORK_EFFORT_ID
INNER JOIN NOTE_DATA            ND ON WN.NOTE_ID = ND.NOTE_ID
WHERE ND.NOTE_DATE_TIME = WA.REFERENCE_DATE
and wa.work_effort_type_id = ?
and wa.reference_date = @monitoringDate --MAPPA.REFERENCE_DATE
ORDER BY  A0.WORK_EFFORT_ID,WN.SEQUENCE_ID,ND.NOTE_NAME]]></xml-property>
        </oda-data-set>
