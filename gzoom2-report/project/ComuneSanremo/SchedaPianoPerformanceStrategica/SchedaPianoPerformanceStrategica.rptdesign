            </list-property>
            <xml-property name="queryText"><![CDATA[select
	B0.ETCH as "ETICHETTA0",
	A0.WORK_EFFORT_NAME as "TITOLO0",
	A0.DESCRIPTION as "DESCRBREVE0",
	A0.WORK_EFFORT_ID as "ID0",
	A0.WORK_EFFORT_NAME as "TITLE",
	B1.ETCH as "ETICHETTA1",
	A1.ETCH as "ETCH1",
	A1.WORK_EFFORT_NAME as "WORK_EFFORT_NAME1",
	A1.DESCRIPTION as "DESCRBREVE1",
	A1.SOURCE_REFERENCE_ID as "CODE1",
	Z1.SEQUENCE_NUM as "SEQ1",
	A1.WORK_EFFORT_ID as "ID1",
	B1.UOM_RANGE_SCORE_ID as "FASCETACHIMETRO1",
	A1.ESTIMATED_START_DATE as "INIZIO1",
	A1.ESTIMATED_COMPLETION_DATE as "FINE1",
	B2.ETCH as "ETICHETTA2",
	A2.WORK_EFFORT_NAME as "TITOLO2",
	A2.DESCRIPTION as "DESCRBREVE2",
	A2.SOURCE_REFERENCE_ID as "CODE2",
	Z2.SEQUENCE_NUM as "SEQ2",
	A2.WORK_EFFORT_ID as "ID2",
	B2.UOM_RANGE_SCORE_ID as "FASCETACHIMETRO2",
	A2.ESTIMATED_START_DATE as "INIZIO2",
	A2.ESTIMATED_COMPLETION_DATE as "FINE2",
	B3.ETCH as "ETICHETTA3",
	A3.WORK_EFFORT_NAME as "TITOLO3",
	A3.DESCRIPTION as "DESCRBREVE3",
	A3.SOURCE_REFERENCE_ID as "CODE3",
	Z3.SEQUENCE_NUM as "SEQ3",
	A3.WORK_EFFORT_ID as "ID3",
	B3.UOM_RANGE_SCORE_ID as "FASCETACHIMETRO3",
	A3.ESTIMATED_START_DATE as "INIZIO3",
	A3.ESTIMATED_COMPLETION_DATE as "FINE3",
	B4.ETCH as "ETICHETTA4",
	A4.WORK_EFFORT_NAME as "TITOLO4",
	A4.DESCRIPTION as "DESCRBREVE4",
	A4.SOURCE_REFERENCE_ID as "CODE4",
	Z4.SEQUENCE_NUM as "SEQ4",
	A4.WORK_EFFORT_ID as "ID4",
	B4.UOM_RANGE_SCORE_ID as "FASCETACHIMETRO4",
	A4.ESTIMATED_START_DATE as "INIZIO4",
	A4.ESTIMATED_COMPLETION_DATE as "FINE4",
	B5.ETCH as "ETICHETTA5",
	A5.WORK_EFFORT_NAME as "TITOLO5",
	A5.DESCRIPTION as "DESCRBREVE5",
	A5.SOURCE_REFERENCE_ID as "CODE5",
	Z5.SEQUENCE_NUM as "SEQ5",
	A5.WORK_EFFORT_ID as "ID5",
	B5.UOM_RANGE_SCORE_ID as "FASCETACHIMETRO5",
	A5.ESTIMATED_START_DATE as "INIZIO5",
	A5.ESTIMATED_COMPLETION_DATE as "FINE5",
	UO.PARTY_NAME as "STRUTTECNICA",
	Y.DESCRIPTION as "WA_DESCRIPTION",
	Y.WORK_EFFORT_ANALYSIS_ID,
	Y.REFERENCE_DATE,
	MAX(case when R0.GL_FISCAL_TYPE_ID = Y.TYPE_BALANCE_SCORE_CON_ID then R0.AMOUNT else -1 end) as "ACTUAL0",
	MAX(case when R1.GL_FISCAL_TYPE_ID = Y.TYPE_BALANCE_SCORE_CON_ID then R1.AMOUNT else -1 end) as "ACTUAL1",
	MAX(case when R2.GL_FISCAL_TYPE_ID = Y.TYPE_BALANCE_SCORE_CON_ID then R2.AMOUNT else -1 end) as "ACTUAL2",
	MAX(case when R3.GL_FISCAL_TYPE_ID = Y.TYPE_BALANCE_SCORE_CON_ID then R3.AMOUNT else -1 end) as "ACTUAL3",
	MAX(case when R4.GL_FISCAL_TYPE_ID = Y.TYPE_BALANCE_SCORE_CON_ID then R4.AMOUNT else -1 end) as "ACTUAL4",
	MAX(case when R5.GL_FISCAL_TYPE_ID = 'ACTUAL' then R5.AMOUNT else -1 end) as "ACTUAL5_CONST",
	MAX(case when R5.GL_FISCAL_TYPE_ID = Y.TYPE_BALANCE_SCORE_CON_ID then R5.AMOUNT else -1 end) as "ACTUAL5",
	MAX(RS.PARTY_NAME) as "RESPTECNICO"
from
	WORK_EFFORT_ANALYSIS Y
inner join WORK_EFFORT_TYPE_TYPE WETT on
	WETT.WORK_EFFORT_TYPE_ID_ROOT = Y.work_effort_type_id
	and WETT.SEQUENCE_NUM = 1
	--MAPPA.WORK_EFFORT_TYPE_ID
inner join WORK_EFFORT A0 on
	A0.WORK_EFFORT_TYPE_ID = WETT.WORK_EFFORT_TYPE_ID_FROM
	and A0.ESTIMATED_START_DATE <= @monitoringDate
	and A0.ESTIMATED_COMPLETION_DATE >= @monitoringDate
	and A0.WORK_EFFORT_REVISION_ID is null
inner join WORK_EFFORT_TYPE B0 on
	B0.WORK_EFFORT_TYPE_ID = A0.WORK_EFFORT_TYPE_ID
	-- obiettivo strategico
inner join WORK_EFFORT_ASSOC Z1 on
	Z1.WORK_EFFORT_ID_FROM = A0.WORK_EFFORT_ID
	and z1.thru_date >= @date0101
	and z1.from_date <= @date3112
inner join WORK_EFFORT A1 on
	A1.WORK_EFFORT_ID = Z1.WORK_EFFORT_ID_TO
	and A1.WORK_EFFORT_REVISION_ID is null
	and A1.ESTIMATED_START_DATE <= @date3112
	and A1.ESTIMATED_COMPLETION_DATE >= @date0101
inner join WORK_EFFORT_ASSOC_TYPE D1 on
	D1.WORK_EFFORT_ASSOC_TYPE_ID = Z1.WORK_EFFORT_ASSOC_TYPE_ID
inner join WORK_EFFORT_TYPE B1 on
	B1.WORK_EFFORT_TYPE_ID = A1.WORK_EFFORT_TYPE_ID
	-- azione strategica
inner join WORK_EFFORT_ASSOC Z2 on
	Z2.WORK_EFFORT_ID_FROM = A1.WORK_EFFORT_ID
	and z2.thru_date >= @date0101
	and z2.from_date <= @date3112
inner join WORK_EFFORT_ASSOC_TYPE D2 on
	D2.WORK_EFFORT_ASSOC_TYPE_ID = Z2.WORK_EFFORT_ASSOC_TYPE_ID
inner join WORK_EFFORT A2 on
	A2.WORK_EFFORT_ID = Z2.WORK_EFFORT_ID_TO
	and A2.WORK_EFFORT_REVISION_ID is null
	and A2.ESTIMATED_START_DATE <= @date3112
	and A2.ESTIMATED_COMPLETION_DATE >= @date0101
inner join WORK_EFFORT_TYPE B2 on
	B2.WORK_EFFORT_TYPE_ID = A2.WORK_EFFORT_TYPE_ID
	-- obiettivo gestioneale                    
inner join WORK_EFFORT_ASSOC Z3 on
	Z3.WORK_EFFORT_ID_FROM = A2.WORK_EFFORT_ID
	and z3.thru_date >= @date0101
	and z3.from_date <= @date3112
inner join WORK_EFFORT_ASSOC_TYPE D3 on
	D3.WORK_EFFORT_ASSOC_TYPE_ID = Z3.WORK_EFFORT_ASSOC_TYPE_ID
inner join WORK_EFFORT A3 on
	A3.WORK_EFFORT_ID = Z3.WORK_EFFORT_ID_TO
	and A3.WORK_EFFORT_REVISION_ID is null
	and A3.ESTIMATED_START_DATE <= @date3112
	and A3.ESTIMATED_COMPLETION_DATE >= @date0101
inner join WORK_EFFORT_TYPE B3 on
	B3.WORK_EFFORT_TYPE_ID = A3.WORK_EFFORT_TYPE_ID
	-- obiettivo gestioneale di settore                    
inner join WORK_EFFORT_ASSOC Z4 on
	Z4.WORK_EFFORT_ID_FROM = A3.WORK_EFFORT_ID
	and z4.thru_date >= @date0101
	and z4.from_date <= @date3112
inner join WORK_EFFORT_ASSOC_TYPE D4 on
	D4.WORK_EFFORT_ASSOC_TYPE_ID = Z4.WORK_EFFORT_ASSOC_TYPE_ID
inner join WORK_EFFORT A4 on
	A4.WORK_EFFORT_ID = Z4.WORK_EFFORT_ID_TO
	and A4.WORK_EFFORT_REVISION_ID is null
	and A4.ESTIMATED_START_DATE <= @date3112
	and A4.ESTIMATED_COMPLETION_DATE >= @date0101
inner join WORK_EFFORT_TYPE B4 on
	B4.WORK_EFFORT_TYPE_ID = A4.WORK_EFFORT_TYPE_ID
	-- obiettivo gestioneale di processo                    
inner join WORK_EFFORT_ASSOC Z5 on
	Z5.WORK_EFFORT_ID_FROM = A4.WORK_EFFORT_ID
	and z5.thru_date >= @date0101
	and z5.from_date <= @date3112
inner join WORK_EFFORT_ASSOC_TYPE D5 on
	D5.WORK_EFFORT_ASSOC_TYPE_ID = Z5.WORK_EFFORT_ASSOC_TYPE_ID
inner join WORK_EFFORT A5 on
	A5.WORK_EFFORT_ID = Z5.WORK_EFFORT_ID_TO
	and A5.WORK_EFFORT_REVISION_ID is null
	and A5.ESTIMATED_START_DATE <= @date3112
	and A5.ESTIMATED_COMPLETION_DATE >= @date0101
inner join WORK_EFFORT_TYPE B5 on
	B5.WORK_EFFORT_TYPE_ID = A5.WORK_EFFORT_TYPE_ID
inner join PARTY UO on
	UO.PARTY_ID = A5.ORG_UNIT_ID
left outer join PARTY_RELATIONSHIP PR on
	PR.PARTY_ID_FROM = A5.ORG_UNIT_ID
	and PR.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
	and PR.THRU_DATE is null
left outer join PARTY RS on
	RS.PARTY_ID = PR.PARTY_ID_TO
left outer join ACCTG_TRANS Q0 on
	Q0.WORK_EFFORT_ID = A0.WORK_EFFORT_ID
	and Q0.TRANSACTION_DATE = Y.REFERENCE_DATE
left outer join ACCTG_TRANS_ENTRY R0 on
	Q0.ACCTG_TRANS_ID = R0.ACCTG_TRANS_ID
	and R0.GL_ACCOUNT_ID = 'SCORE'
left outer join ACCTG_TRANS Q1 on
	Q1.WORK_EFFORT_ID = A1.WORK_EFFORT_ID
	and Q1.TRANSACTION_DATE = Y.REFERENCE_DATE
left outer join ACCTG_TRANS_ENTRY R1 on
	Q1.ACCTG_TRANS_ID = R1.ACCTG_TRANS_ID
	and R1.GL_ACCOUNT_ID = 'SCORE'
left outer join ACCTG_TRANS Q2 on
	Q2.WORK_EFFORT_ID = A2.WORK_EFFORT_ID
	and Q2.TRANSACTION_DATE = Y.REFERENCE_DATE
left outer join ACCTG_TRANS_ENTRY R2 on
	Q2.ACCTG_TRANS_ID = R2.ACCTG_TRANS_ID
	and R2.GL_ACCOUNT_ID = 'SCORE'
left outer join ACCTG_TRANS Q3 on
	Q3.WORK_EFFORT_ID = A3.WORK_EFFORT_ID
	and Q3.TRANSACTION_DATE = Y.REFERENCE_DATE
left outer join ACCTG_TRANS_ENTRY R3 on
	Q3.ACCTG_TRANS_ID = R3.ACCTG_TRANS_ID
	and R3.GL_ACCOUNT_ID = 'SCORE'
left outer join ACCTG_TRANS Q4 on
	Q4.WORK_EFFORT_ID = A4.WORK_EFFORT_ID
	and Q4.TRANSACTION_DATE = Y.REFERENCE_DATE
left outer join ACCTG_TRANS_ENTRY R4 on
	Q4.ACCTG_TRANS_ID = R4.ACCTG_TRANS_ID
	and R4.GL_ACCOUNT_ID = 'SCORE'
left outer join ACCTG_TRANS Q5 on
	Q5.WORK_EFFORT_ID = A5.WORK_EFFORT_ID
	and Q5.TRANSACTION_DATE = Y.REFERENCE_DATE
left outer join ACCTG_TRANS_ENTRY R5 on
	Q5.ACCTG_TRANS_ID = R5.ACCTG_TRANS_ID
	and R5.GL_ACCOUNT_ID = 'SCORE'
where Y.work_effort_type_id = ?
	and Y.reference_date = @monitoringDate
	and ((D1.PARENT_TYPE_ID = 'HIE'
		and A0.WORK_EFFORT_PARENT_ID = A1.WORK_EFFORT_PARENT_ID)
	or Z1.WORK_EFFORT_ASSOC_TYPE_ID = A0.WORK_EFFORT_ASSOC_TYPE_ID)
	and (Z1.THRU_DATE = A0.ESTIMATED_COMPLETION_DATE
		or Z1.THRU_DATE = A1.ESTIMATED_COMPLETION_DATE)
	and ((D2.PARENT_TYPE_ID = 'HIE'
		and A1.WORK_EFFORT_PARENT_ID = A2.WORK_EFFORT_PARENT_ID)
	or Z2.WORK_EFFORT_ASSOC_TYPE_ID = A1.WORK_EFFORT_ASSOC_TYPE_ID)
	and (Z2.THRU_DATE = A1.ESTIMATED_COMPLETION_DATE
		or Z2.THRU_DATE = A2.ESTIMATED_COMPLETION_DATE)
	and ((D3.PARENT_TYPE_ID = 'HIE'
		and A2.WORK_EFFORT_PARENT_ID = A3.WORK_EFFORT_PARENT_ID)
	or Z3.WORK_EFFORT_ASSOC_TYPE_ID = A2.WORK_EFFORT_ASSOC_TYPE_ID)
	and (Z3.THRU_DATE = A2.ESTIMATED_COMPLETION_DATE
		or Z3.THRU_DATE = A3.ESTIMATED_COMPLETION_DATE)
	and ((D4.PARENT_TYPE_ID = 'HIE'
		and A3.WORK_EFFORT_PARENT_ID = A4.WORK_EFFORT_PARENT_ID)
	or Z4.WORK_EFFORT_ASSOC_TYPE_ID = A3.WORK_EFFORT_ASSOC_TYPE_ID)
	and (Z4.THRU_DATE = A3.ESTIMATED_COMPLETION_DATE
		or Z4.THRU_DATE = A4.ESTIMATED_COMPLETION_DATE)
	and ((D5.PARENT_TYPE_ID = 'HIE'
		and A4.WORK_EFFORT_PARENT_ID = A5.WORK_EFFORT_PARENT_ID)
	or Z5.WORK_EFFORT_ASSOC_TYPE_ID = A4.WORK_EFFORT_ASSOC_TYPE_ID)
	and (Z5.THRU_DATE = A4.ESTIMATED_COMPLETION_DATE
		or Z5.THRU_DATE = A5.ESTIMATED_COMPLETION_DATE)
group by
	B0.ETCH,
	A0.WORK_EFFORT_NAME,
	A0.DESCRIPTION,
	A0.WORK_EFFORT_ID,
	A0.WORK_EFFORT_NAME,	 
	B1.ETCH,
	A1.ETCH,
	A1.WORK_EFFORT_NAME,
	A1.DESCRIPTION,
	A1.SOURCE_REFERENCE_ID,
	Z1.SEQUENCE_NUM,
	A1.WORK_EFFORT_ID,
	B1.UOM_RANGE_SCORE_ID,
	A1.ESTIMATED_START_DATE,
	A1.ESTIMATED_COMPLETION_DATE,
	B2.ETCH,
	A2.WORK_EFFORT_NAME,
	A2.DESCRIPTION,
	A2.SOURCE_REFERENCE_ID,
	Z2.SEQUENCE_NUM,
	A2.WORK_EFFORT_ID,
	B2.UOM_RANGE_SCORE_ID,
	A2.ESTIMATED_START_DATE,
	A2.ESTIMATED_COMPLETION_DATE,
	B3.ETCH,
	A3.WORK_EFFORT_NAME,
	A3.DESCRIPTION,
	A3.SOURCE_REFERENCE_ID,
	Z3.SEQUENCE_NUM,
	A3.WORK_EFFORT_ID,
	B3.UOM_RANGE_SCORE_ID,
	A3.ESTIMATED_START_DATE,
	A3.ESTIMATED_COMPLETION_DATE,       	   
	B4.ETCH,
	A4.WORK_EFFORT_NAME,
	A4.DESCRIPTION,
	A4.SOURCE_REFERENCE_ID,
	Z4.SEQUENCE_NUM,
	A4.WORK_EFFORT_ID,
	B4.UOM_RANGE_SCORE_ID,
	A4.ESTIMATED_START_DATE,
	A4.ESTIMATED_COMPLETION_DATE,
	B5.ETCH,
	A5.WORK_EFFORT_NAME,
	A5.DESCRIPTION,
	A5.SOURCE_REFERENCE_ID,
	Z5.SEQUENCE_NUM,
	A5.WORK_EFFORT_ID,
	B5.UOM_RANGE_SCORE_ID,
	A5.ESTIMATED_START_DATE,
	A5.ESTIMATED_COMPLETION_DATE,	   
	UO.PARTY_NAME,
	Y.DESCRIPTION,
	Y.WORK_EFFORT_ANALYSIS_ID,
	Y.REFERENCE_DATE
order by
	Z1.SEQUENCE_NUM,
	A1.SOURCE_REFERENCE_ID,
	A1.WORK_EFFORT_ID, 
	Z2.SEQUENCE_NUM,
	A2.SOURCE_REFERENCE_ID,
	A2.WORK_EFFORT_ID,
    Z3.SEQUENCE_NUM,
	A3.SOURCE_REFERENCE_ID,
	A3.WORK_EFFORT_ID,
	Z4.SEQUENCE_NUM,
	A4.SOURCE_REFERENCE_ID,
	A4.WORK_EFFORT_ID,
	Z5.SEQUENCE_NUM,
	A5.SOURCE_REFERENCE_ID,
	A5.WORK_EFFORT_ID]]></xml-property>
