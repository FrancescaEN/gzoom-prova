            <xml-property name="queryText"><![CDATA[SELECT 
    B0.ETCH AS "ETICHETTA0", 
    A0.WORK_EFFORT_NAME AS "TITOLO0", 
    A0.DESCRIPTION AS "DESCRBREVE0", 
    A0.WORK_EFFORT_ID AS "ID0", 
    A0.WORK_EFFORT_NAME AS "TITLE",	 
    MAX(CASE WHEN R0.GL_FISCAL_TYPE_ID = Y.TYPE_BALANCE_SCORE_CON_ID THEN R0.AMOUNT ELSE -1 END) AS "ACTUAL0",
	
    B1.ETCH AS "ETICHETTA1", 
    A1.ETCH AS "ETCH1", 
    A1.WORK_EFFORT_NAME AS "WORK_EFFORT_NAME1", 
    A1.DESCRIPTION AS "DESCRBREVE1",
    A1.SOURCE_REFERENCE_ID AS "CODE1", 
    Z1.SEQUENCE_NUM AS "SEQ1", 
    A1.WORK_EFFORT_ID AS "ID1",  
    B1.UOM_RANGE_SCORE_ID AS "FASCETACHIMETRO1", 
    A1.ESTIMATED_START_DATE AS "INIZIO1", 
    A1.ESTIMATED_COMPLETION_DATE AS "FINE1",
    MAX(CASE WHEN R1.GL_FISCAL_TYPE_ID = Y.TYPE_BALANCE_SCORE_CON_ID THEN R1.AMOUNT ELSE -1 END) AS "ACTUAL1",
	
    B2.ETCH AS "ETICHETTA2", 
    A2.WORK_EFFORT_NAME AS "TITOLO2", 
    A2.DESCRIPTION AS "DESCRBREVE2",
    A2.SOURCE_REFERENCE_ID AS "CODE2", 
    Z2.SEQUENCE_NUM AS "SEQ2", 
    A2.WORK_EFFORT_ID AS "ID2",  
    B2.UOM_RANGE_SCORE_ID AS "FASCETACHIMETRO2", 
    A2.ESTIMATED_START_DATE AS "INIZIO2", 
    A2.ESTIMATED_COMPLETION_DATE AS "FINE2",
    MAX(CASE WHEN R2.GL_FISCAL_TYPE_ID = Y.TYPE_BALANCE_SCORE_CON_ID THEN R2.AMOUNT ELSE -1 END) AS "ACTUAL2",
    MAX(CASE WHEN R2.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN R2.AMOUNT ELSE -1 END) AS "ACTUAL2_CONST",
   
    UO.PARTY_NAME AS "STRUTTECNICA", 
    MAX(RS.PARTY_NAME) AS "RESPTECNICO", 
    Y.DESCRIPTION AS "WA_DESCRIPTION", 
    Y.WORK_EFFORT_ANALYSIS_ID AS "WORK_EFFORT_ANALYSIS_ID", 
    Y.REFERENCE_DATE AS "REFERENCE_DATE"

from WORK_EFFORT_ANALYSIS Y
INNER JOIN WORK_EFFORT_TYPE_TYPE WETT ON WETT.WORK_EFFORT_TYPE_ID_ROOT = Y.work_effort_type_id AND WETT.SEQUENCE_NUM = 1  --MAPPA.WORK_EFFORT_TYPE_ID
INNER JOIN WORK_EFFORT A0 ON A0.WORK_EFFORT_TYPE_ID = WETT.WORK_EFFORT_TYPE_ID_FROM 
		AND A0.ESTIMATED_START_DATE <= @monitoringDate AND A0.ESTIMATED_COMPLETION_DATE >= @monitoringDate AND A0.WORK_EFFORT_REVISION_ID IS null 
		 INNER JOIN WORK_EFFORT_TYPE B0 ON B0.WORK_EFFORT_TYPE_ID = A0.WORK_EFFORT_TYPE_ID
	 
     -- attività ordinaria
     INNER JOIN WORK_EFFORT_ASSOC Z1 ON Z1.WORK_EFFORT_ID_FROM = A0.WORK_EFFORT_ID
     INNER JOIN WORK_EFFORT A1 ON A1.WORK_EFFORT_ID = Z1.WORK_EFFORT_ID_TO AND A1.WORK_EFFORT_REVISION_ID IS NULL 
		 and A1.ESTIMATED_START_DATE <= @date3112
		 and A1.ESTIMATED_COMPLETION_DATE >= @date0101
    INNER JOIN WORK_EFFORT_ASSOC_TYPE D1 ON D1.WORK_EFFORT_ASSOC_TYPE_ID = Z1.WORK_EFFORT_ASSOC_TYPE_ID
     INNER JOIN WORK_EFFORT_TYPE B1 ON B1.WORK_EFFORT_TYPE_ID = A1.WORK_EFFORT_TYPE_ID
     	  
     	  
     -- processo
     INNER JOIN WORK_EFFORT_ASSOC Z2 ON Z2.WORK_EFFORT_ID_FROM = A1.WORK_EFFORT_ID
     INNER JOIN WORK_EFFORT_ASSOC_TYPE D2 ON D2.WORK_EFFORT_ASSOC_TYPE_ID = Z2.WORK_EFFORT_ASSOC_TYPE_ID
     INNER JOIN WORK_EFFORT A2 ON A2.WORK_EFFORT_ID = Z2.WORK_EFFORT_ID_TO AND A2.WORK_EFFORT_REVISION_ID IS NULL 
	    and A2.ESTIMATED_START_DATE <= @date3112
		and A2.ESTIMATED_COMPLETION_DATE >= @date0101
    INNER JOIN WORK_EFFORT_TYPE B2 ON B2.WORK_EFFORT_TYPE_ID = A2.WORK_EFFORT_TYPE_ID
     		AND B2.WORK_EFFORT_TYPE_ID = '15PM09'
     		
     INNER JOIN PARTY UO ON UO.PARTY_ID = A2.ORG_UNIT_ID
	 LEFT OUTER JOIN PARTY_RELATIONSHIP PR ON PR.PARTY_ID_FROM = A2.ORG_UNIT_ID AND PR.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE' AND PR.THRU_DATE IS NULL
  	 LEFT OUTER JOIN PARTY RS ON RS.PARTY_ID = PR.PARTY_ID_TO   
	       
     
     LEFT OUTER JOIN ACCTG_TRANS Q0 ON Q0.WORK_EFFORT_ID = A0.WORK_EFFORT_ID 
     LEFT OUTER JOIN ACCTG_TRANS_ENTRY R0 ON Q0.ACCTG_TRANS_ID = R0.ACCTG_TRANS_ID            
          AND R0.GL_ACCOUNT_ID = 'SCORE' AND Q0.TRANSACTION_DATE = Y.REFERENCE_DATE 
          AND (R0.GL_FISCAL_TYPE_ID = Y.TYPE_BALANCE_SCORE_CON_ID OR R0.GL_FISCAL_TYPE_ID = Y.TYPE_BALANCE_SCORE_TAR_ID) 
     
     
     LEFT OUTER JOIN ACCTG_TRANS Q1 ON Q1.WORK_EFFORT_ID = A1.WORK_EFFORT_ID 
     LEFT OUTER JOIN ACCTG_TRANS_ENTRY R1 ON Q1.ACCTG_TRANS_ID = R1.ACCTG_TRANS_ID            
          AND R1.GL_ACCOUNT_ID = 'SCORE' AND Q1.TRANSACTION_DATE = Y.REFERENCE_DATE
          AND (R1.GL_FISCAL_TYPE_ID = Y.TYPE_BALANCE_SCORE_CON_ID OR R1.GL_FISCAL_TYPE_ID = Y.TYPE_BALANCE_SCORE_TAR_ID) 
      
     LEFT OUTER JOIN ACCTG_TRANS Q2 ON Q2.WORK_EFFORT_ID = A2.WORK_EFFORT_ID 
     LEFT OUTER JOIN ACCTG_TRANS_ENTRY R2 ON Q2.ACCTG_TRANS_ID = R2.ACCTG_TRANS_ID            
          AND R2.GL_ACCOUNT_ID = 'SCORE' AND Q2.TRANSACTION_DATE = Y.REFERENCE_DATE 
          AND (R2.GL_FISCAL_TYPE_ID = Y.TYPE_BALANCE_SCORE_CON_ID OR R2.GL_FISCAL_TYPE_ID = Y.TYPE_BALANCE_SCORE_TAR_ID) 
     
   
  
  WHERE Y.work_effort_type_id = ?
  AND Y.reference_date = @monitoringDate --MAPPA.REFERENCE_DATE
  AND ((D1.PARENT_TYPE_ID = 'HIE' AND A0.WORK_EFFORT_PARENT_ID = A1.WORK_EFFORT_PARENT_ID) OR Z1.WORK_EFFORT_ASSOC_TYPE_ID = A0.WORK_EFFORT_ASSOC_TYPE_ID) 
  AND  (Z1.THRU_DATE = A0.ESTIMATED_COMPLETION_DATE OR Z1.THRU_DATE = A1.ESTIMATED_COMPLETION_DATE)
  AND ((D2.PARENT_TYPE_ID = 'HIE' AND A1.WORK_EFFORT_PARENT_ID = A2.WORK_EFFORT_PARENT_ID) OR Z2.WORK_EFFORT_ASSOC_TYPE_ID = A1.WORK_EFFORT_ASSOC_TYPE_ID) 
  AND  (Z2.THRU_DATE = A1.ESTIMATED_COMPLETION_DATE OR Z2.THRU_DATE = A2.ESTIMATED_COMPLETION_DATE)
     
GROUP BY B0.ETCH, A0.WORK_EFFORT_NAME, A0.DESCRIPTION, A0.WORK_EFFORT_ID, A0.WORK_EFFORT_NAME,	 	   	
	   B1.ETCH, A1.ETCH, A1.WORK_EFFORT_NAME, A1.DESCRIPTION,
       A1.SOURCE_REFERENCE_ID, Z1.SEQUENCE_NUM, A1.WORK_EFFORT_ID,  B1.UOM_RANGE_SCORE_ID, 
       A1.ESTIMATED_START_DATE, A1.ESTIMATED_COMPLETION_DATE,	   
       B2.ETCH, A2.WORK_EFFORT_NAME, A2.DESCRIPTION,
       A2.SOURCE_REFERENCE_ID, Z2.SEQUENCE_NUM, A2.WORK_EFFORT_ID,  B2.UOM_RANGE_SCORE_ID, 
       A2.ESTIMATED_START_DATE, A2.ESTIMATED_COMPLETION_DATE,      
	   UO.PARTY_NAME, Y.DESCRIPTION, Y.WORK_EFFORT_ANALYSIS_ID, Y.REFERENCE_DATE 
         
ORDER BY Z1.SEQUENCE_NUM, A1.SOURCE_REFERENCE_ID, A1.WORK_EFFORT_ID, 
	     Z2.SEQUENCE_NUM, A2.SOURCE_REFERENCE_ID, A2.WORK_EFFORT_ID]]></xml-property>
