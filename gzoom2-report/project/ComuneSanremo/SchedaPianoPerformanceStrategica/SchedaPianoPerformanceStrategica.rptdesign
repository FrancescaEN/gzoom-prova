                                            <method name="onRender"><![CDATA[//adesso devo settare il valore corretto

var mapRealPageNumber = reportContext.getPersistentGlobalVariable("mapRealPageNumber");
	
var key = this.getRowData().getColumnValue("TITOLO0") + "_" + this.getRowData().getColumnValue("TITOLO1") + "_" + this.getRowData().getColumnValue("TITOLO2");
var element = mapRealPageNumber.get(key);	
if (element != null) {	
	this.text = parseInt(element);
}
]]></method>
