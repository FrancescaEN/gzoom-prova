            <xml-property name="queryText"><![CDATA[select 
    gl.INPUT_ENUM_ID AS "G_INPUT_ENUM_ID",
    gl.ACCOUNT_NAME AS "G_ACCOUNT_NAME",
    wem.UOM_DESCR AS "M_UOM_DESCR",
    wem.WORK_EFFORT_MEASURE_ID AS "M_WORK_EFFORT_MEASURE_ID",
    u.ABBREVIATION AS "G_UOM_ABBREVIATION",
    u.decimal_scale AS "G_UOM_DECIMAL_SCALE",
    gl.DEBIT_CREDIT_DEFAULT AS "G_DEBIT_CREDIT_DEFAULT",
    gl.gl_account_type_id AS "G_GL_ACCOUNT_TYPE_ID",
    u.UOM_TYPE_ID AS "G_UOM_TYPE_ID",
    MAX(CASE WHEN at2.gl_fiscal_type_id = 'UPPER_LIMIT' AND ate.gl_account_id <> 'SCOREKPI' AND at2.transaction_date = @date3112 THEN wemrs.UOM_CODE ELSE NULL END) AS "UPPER_COD",
    MAX(CASE WHEN at2.gl_fiscal_type_id = 'MEDIUM_LIMIT' AND ate.gl_account_id <> 'SCOREKPI' AND at2.transaction_date = @date3112 THEN ate.amount ELSE NULL END) AS "MEDIUM_DATO",
    MAX(CASE WHEN at2.gl_fiscal_type_id = 'UPPER_LIMIT' AND ate.gl_account_id <> 'SCOREKPI' AND at2.transaction_date = @date3112 THEN ate.amount ELSE NULL END) AS "UPPER_DATO",
    MAX(CASE WHEN at2.gl_fiscal_type_id = 'LOWER_LIMIT' AND ate.gl_account_id <> 'SCOREKPI' AND at2.transaction_date = @date3112 THEN ate.amount ELSE NULL END) AS "LOWER_DATO",
    MAX(CASE WHEN at2.gl_fiscal_type_id = 'ACTUAL' AND ate.gl_account_id <> 'SCOREKPI' AND at2.transaction_date = @monitoringDate THEN ate.amount ELSE NULL END) AS "ACTUAL_DATO",    
    MAX(CASE WHEN at2.gl_fiscal_type_id = 'BUDGET' AND ate.gl_account_id <> 'SCOREKPI' AND at2.transaction_date = @monitoringDate THEN ate.amount ELSE NULL END) AS "BUDGET_DATO",     
    wem.KPI_SCORE_WEIGHT AS "M_KPI_SCORE_WEIGHT",
    wem.KPI_OTHER_WEIGHT AS "M_KPI_OTHER_WEIGHT",
    MAX(CASE WHEN at2.gl_fiscal_type_id = 'ACTUAL' AND ate.gl_account_id = 'SCOREKPI' AND at2.transaction_date = @monitoringDate THEN DATA_RESOURCE.OBJECT_INFO ELSE NULL END) AS "OBJECT_INFO_ACT",
    MAX(CASE WHEN at2.gl_fiscal_type_id = 'ACTUAL' AND ate.gl_account_id = 'SCOREKPI' AND at2.transaction_date = @monitoringDate THEN ate.perf_amount_calc ELSE NULL END) AS "PERF_AMOUNT_CALC",
    MAX(CASE WHEN at2.gl_fiscal_type_id = 'ACTUAL' AND ate.gl_account_id = 'SCOREKPI' AND at2.transaction_date = @monitoringDate THEN ate.amount ELSE NULL END) AS "PERF_AMOUNT_SOGLIA",
    MAX(CASE WHEN at2.gl_fiscal_type_id = 'ACTUAL' AND ate.gl_account_id <> 'SCOREKPI' AND at2.transaction_date = @date3112 THEN ate.check_amount1 ELSE NULL END) AS "CHECK_AMOUNT1",
    MAX(CASE WHEN at2.gl_fiscal_type_id = 'ACTUAL' AND ate.gl_account_id <> 'SCOREKPI' AND at2.transaction_date = @date3112 THEN ate.check_amount2 ELSE NULL END) AS "CHECK_AMOUNT2",
    MAX(CASE WHEN at2.gl_fiscal_type_id = 'ACTUAL' AND ate.gl_account_id <> 'SCOREKPI' AND at2.transaction_date = @date3112 THEN ate.check_amount3 ELSE NULL END) AS "CHECK_AMOUNT3",
    MAX(CASE WHEN at2.gl_fiscal_type_id = 'ACTUAL' AND ate.gl_account_id <> 'SCOREKPI' AND at2.transaction_date = @date3112 THEN ate.TEXT_VALUE1 ELSE NULL END) AS "TEXT_VALUE1"
	FROM WORK_EFFORT_ASSOC WA
	inner join work_effort_measure wem on wem.work_effort_id =WA.WORK_EFFORT_ID_TO
	inner JOIN work_effort we ON wem.work_effort_id = we.work_effort_id
	INNER JOIN WORK_EFFORT_TYPE WT ON WT.WORK_EFFORT_TYPE_ID = we.WORK_EFFORT_TYPE_ID
	inner JOIN gl_account gl ON wem.gl_account_id = gl.gl_account_id
	INNER JOIN GL_ACCOUNT_TYPE GT ON GT.GL_ACCOUNT_TYPE_ID = gl.GL_ACCOUNT_TYPE_ID
    inner JOIN uom u ON gl.default_uom_id = u.uom_id
    left join acctg_trans_entry ate on
    (  (gL.input_enum_id = 'ACCINP_OBJ' and ate.voucher_ref is not null and ate.voucher_ref = wem.work_effort_measure_id)
    or (gL.input_enum_id = 'ACCINP_UO' and ate.gl_account_id = wem.gl_account_id))
	left join acctg_trans at2 on at2.acctg_trans_id = ate.acctg_trans_id
    left join work_effort_meas_rat_sc wemrs on wemrs.work_effort_measure_id=wem.work_effort_measure_id
    AND wemrs.uom_id = ate.currency_uom_id
    AND wemrs.uom_rating_value = ate.amount 
    AND ate.gl_account_id NOT LIKE 'SCORE%'
	-- G_DEBIT_CREDIT_DEFAULT
	LEFT OUTER JOIN ENUMERATION D_C ON D_C.ENUM_ID = gl.DEBIT_CREDIT_DEFAULT
	LEFT JOIN UOM_RANGE UR ON UR.UOM_RANGE_ID = WT.UOM_RANGE_SCORE_ID
    LEFT JOIN UOM_RANGE_VALUES URV ON URV.UOM_RANGE_ID = WT.UOM_RANGE_SCORE_ID AND URV.FROM_VALUE <= ate.amount AND URV.THRU_VALUE >= ate.amount			
    LEFT JOIN CONTENT CONT ON CONT.CONTENT_ID = URV.ICON_CONTENT_ID
    LEFT JOIN DATA_RESOURCE DATA_RESOURCE ON DATA_RESOURCE.DATA_RESOURCE_ID = CONT.DATA_RESOURCE_ID
	WHERE (wem.GL_ACCOUNT_ID <> 'SCORE' OR wem.GL_ACCOUNT_ID IS NULL)
		 AND gl.ACCOUNT_TYPE_ENUM_ID = 'INDICATOR'
		 AND WA.WORK_EFFORT_ID_FROM = ?
   		 AND wem.THRU_DATE >= @date0101
	  	 AND wem.FROM_DATE <= @date3112
	  	 AND WA.WORK_EFFORT_ASSOC_TYPE_ID <> '15PM09_PM014'
	  	 AND We.WORK_EFFORT_REVISION_ID IS null
group by gl.gl_account_type_id,
gl.INPUT_ENUM_ID,
    gl.ACCOUNT_NAME,
    wem.UOM_DESCR,
    wem.WORK_EFFORT_MEASURE_ID,
    u.ABBREVIATION,
    u.decimal_scale,
    gl.DEBIT_CREDIT_DEFAULT,
    u.UOM_TYPE_ID,
    wem.KPI_SCORE_WEIGHT,
    wem.KPI_OTHER_WEIGHT]]></xml-property>
