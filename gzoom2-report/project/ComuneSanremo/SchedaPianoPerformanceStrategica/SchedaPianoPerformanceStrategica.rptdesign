                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">45</property>
                    <property name="name">DESCRBREVE5</property>
                    <property name="nativeName">DESCRBREVE5</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">46</property>
