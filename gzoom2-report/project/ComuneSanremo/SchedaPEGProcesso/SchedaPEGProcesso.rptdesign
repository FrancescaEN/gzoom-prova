                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT W.WORK_EFFORT_ID AS "ID0",
WNT.WORK_EFFORT_ID AS "WORK_EFFORT_ID", 
	 WNT.NOTE_ID AS "NOTE_ID", 
	 WNT.NOTE_NAME AS "NOTE_NAME",
	 WNT.NOTE_INFO AS "NOTE_INFO",
	 WNT.SEQUENCE_ID AS "SEQUENCE_ID",
	 WNT.NOTE_DATE_TIME AS "NOTE_DATE_TIME",
	 WNT.IS_HTML AS "IS_HTML"
FROM WORK_EFFORT W
LEFT OUTER JOIN (
	
	SELECT
	 N.WORK_EFFORT_ID, 
	 ND.NOTE_ID, 
	 ND.NOTE_NAME,
	 ND.NOTE_INFO,
	 N.SEQUENCE_ID,
	 ND.NOTE_DATE_TIME,
	 N.IS_HTML
	FROM WORK_EFFORT_NOTE N
	INNER JOIN NOTE_DATA ND ON ND.NOTE_ID = N.NOTE_ID
	WHERE N.IS_MAIN = 'N'
	
	--	@selectNote
		@typeNotes
		
) WNT ON WNT.WORK_EFFORT_ID = W.WORK_EFFORT_ID

WHERE W.WORK_EFFORT_ID = ? 	

ORDER BY 
	WNT.SEQUENCE_ID, 
	WNT.NOTE_ID
]]></xml-property>
