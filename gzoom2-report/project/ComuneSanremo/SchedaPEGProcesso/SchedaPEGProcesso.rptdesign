            <xml-property name="queryText"><![CDATA[SELECT 
B0.ETCH AS "ETICHETTA0", 
A0.ETCH AS "ETCH0", 
A0.WORK_EFFORT_NAME AS "NAME0", 
Z0.SEQUENCE_NUM AS "SEQ0", 
A0.WORK_EFFORT_ID AS "ID0", 
A0.DESCRIPTION AS "DESCRIPTION0", 
Z0.ASSOC_WEIGHT AS "ASSOC_WEIGHT0", 
A0.SOURCE_REFERENCE_ID AS "CODE0", 	   	   
P_A0.PARTY_NAME AS "RESPONSABILE",
FIL_W.WORK_EFFORT_ID_FROM_OP AS "WORK_EFFORT_ID_FROM_OP",
FIL_W.WORK_EFFORT_TYPE_ID_OP AS "WORK_EFFORT_TYPE_ID_OP", 
FIL_W.ETICHETTA_OP AS "ETICHETTA_OP", 
FIL_W.ETCH_OP AS "ETCH_OP", 
FIL_W.NAME_OP AS "NAME_OP", 
FIL_W.SEQ_OP AS "SEQ_OP", 
FIL_W.ID_OP AS "ID_OP", 
FIL_W.DESCRIPTION_OP AS "DESCRIPTION_OP", 
FIL_W.ASSOC_WEIGHT_OP AS "ASSOC_WEIGHT_OP", 
FIL_W.CODE_OP AS "CODE_OP"

	   
FROM WORK_EFFORT RAD
	 INNER JOIN WORK_EFFORT_TYPE RAT ON RAT.WORK_EFFORT_TYPE_ID = RAD.WORK_EFFORT_TYPE_ID	

	 -- SETTORE
	 INNER JOIN WORK_EFFORT_ASSOC Z0 ON Z0.WORK_EFFORT_ID_FROM = RAD.WORK_EFFORT_ID
	 	AND Z0.WORK_EFFORT_ASSOC_TYPE_ID = RAT.HIERARCHY_ASSOC_TYPE_ID
	 	AND ( @excludeValidity = 'Y' OR  (@excludeValidity = 'N' AND ( Z0.FROM_DATE <= @date3112 AND (Z0.THRU_DATE >= @date0101 OR Z0.THRU_DATE IS NULL ))))	 			
     INNER JOIN WORK_EFFORT A0 ON A0.WORK_EFFORT_ID = Z0.WORK_EFFORT_ID_TO
     INNER JOIN WORK_EFFORT_ASSOC_TYPE D0 ON D0.WORK_EFFORT_ASSOC_TYPE_ID = Z0.WORK_EFFORT_ASSOC_TYPE_ID     
     INNER JOIN WORK_EFFORT_TYPE B0 ON B0.WORK_EFFORT_TYPE_ID = A0.WORK_EFFORT_TYPE_ID     
	 	
	 INNER JOIN (
      	 -- PROCESSI
         SELECT Z1.WORK_EFFORT_ID_FROM AS WORK_EFFORT_ID_FROM_OP,
 			B1.WORK_EFFORT_TYPE_ID AS WORK_EFFORT_TYPE_ID_OP, B1.ETCH AS ETICHETTA_OP, FIL_W.ETCH AS ETCH_OP, FIL_W.WORK_EFFORT_NAME AS NAME_OP, Z1.SEQUENCE_NUM AS SEQ_OP, FIL_W.WORK_EFFORT_ID AS ID_OP, FIL_W.DESCRIPTION AS DESCRIPTION_OP, Z1.ASSOC_WEIGHT AS ASSOC_WEIGHT_OP, FIL_W.SOURCE_REFERENCE_ID AS CODE_OP
 
         FROM WORK_EFFORT_ASSOC Z1				 
			INNER JOIN WORK_EFFORT FIL_W ON FIL_W.WORK_EFFORT_ID = Z1.WORK_EFFORT_ID_TO			
			INNER JOIN WORK_EFFORT_ASSOC_TYPE D1 ON D1.WORK_EFFORT_ASSOC_TYPE_ID = Z1.WORK_EFFORT_ASSOC_TYPE_ID
			INNER JOIN WORK_EFFORT_TYPE B1 ON B1.WORK_EFFORT_TYPE_ID = FIL_W.WORK_EFFORT_TYPE_ID
				AND B1.WORK_EFFORT_TYPE_ID = '15PM09'
          	@filterInnerJoin
			@filterLeftJoin 
          WHERE  ( @excludeValidity = 'Y' OR  (@excludeValidity = 'N' AND ( Z1.FROM_DATE <= @date3112 AND (Z1.THRU_DATE >= @date0101 OR Z1.THRU_DATE IS NULL ))))	 			
				AND Z1.WORK_EFFORT_ASSOC_TYPE_ID = '15PM_PEG'
				
				@workEffortId1
				@filterWhere
				
				AND FIL_W.WORK_EFFORT_REVISION_ID IS NULL

          UNION ALL
          
         -- OBIETTIVO
         SELECT Z1.WORK_EFFORT_ID_FROM AS WORK_EFFORT_ID_FROM_OP,
			B1.WORK_EFFORT_TYPE_ID AS WORK_EFFORT_TYPE_ID_OP, B1.ETCH AS ETICHETTA_OP, A2.ETCH AS ETCH_OP, A2.WORK_EFFORT_NAME AS NAME_OP, Z1.SEQUENCE_NUM AS SEQ_OP, A2.WORK_EFFORT_ID AS ID_OP, A2.DESCRIPTION AS DESCRIPTION_OP, Z1.ASSOC_WEIGHT AS ASSOC_WEIGHT_OP, A2.SOURCE_REFERENCE_ID AS CODE_OP
 
         FROM WORK_EFFORT_ASSOC Z1				 
			INNER JOIN WORK_EFFORT A2 ON A2.WORK_EFFORT_ID = Z1.WORK_EFFORT_ID_TO			
			INNER JOIN WORK_EFFORT_ASSOC_TYPE D1 ON D1.WORK_EFFORT_ASSOC_TYPE_ID = Z1.WORK_EFFORT_ASSOC_TYPE_ID
			INNER JOIN WORK_EFFORT_TYPE B1 ON B1.WORK_EFFORT_TYPE_ID = A2.WORK_EFFORT_TYPE_ID
				AND B1.WORK_EFFORT_TYPE_ID = '15PM06'
         
         
         	INNER JOIN WORK_EFFORT_ASSOC Z2 ON Z2.WORK_EFFORT_ID_FROM = A2.WORK_EFFORT_ID
				AND Z2.WORK_EFFORT_ASSOC_TYPE_ID = '15PM06_PM014'	
				AND ( @excludeValidity = 'Y' OR  (@excludeValidity = 'N' AND ( Z2.FROM_DATE <= @date3112 AND (Z2.THRU_DATE >= @date0101 OR Z2.THRU_DATE IS NULL ))))
            INNER JOIN WORK_EFFORT FIL_W ON FIL_W.WORK_EFFORT_ID = Z2.WORK_EFFORT_ID_TO
            
            INNER JOIN WORK_EFFORT_ASSOC Z3 ON Z3.WORK_EFFORT_ID_TO = FIL_W.WORK_EFFORT_ID
				AND Z3.WORK_EFFORT_ASSOC_TYPE_ID = '15PM09_PM014'	
				AND ( @excludeValidity = 'Y' OR  (@excludeValidity = 'N' AND ( Z3.FROM_DATE <= @date3112 AND (Z3.THRU_DATE >= @date0101 OR Z3.THRU_DATE IS NULL ))))

            
            @filterInnerJoin
			@filterLeftJoin  
          WHERE  ( @excludeValidity = 'Y' OR  (@excludeValidity = 'N' AND ( Z1.FROM_DATE <= @date3112 AND (Z1.THRU_DATE >= @date0101 OR Z1.THRU_DATE IS NULL ))))	 			
				AND Z1.WORK_EFFORT_ASSOC_TYPE_ID = '15PM_PEG'
				
				@workEffortId2
				@filterWhere
				
				AND FIL_W.WORK_EFFORT_REVISION_ID IS NULL
				AND A2.WORK_EFFORT_REVISION_ID IS NULL

      ) FIL_W ON  FIL_W.WORK_EFFORT_ID_FROM_OP = A0.WORK_EFFORT_ID 
        

	
	 -- responsabile obiettivo
  	 LEFT OUTER JOIN PARTY_RELATIONSHIP P_RESP_A0 ON  P_RESP_A0.PARTY_ID_FROM = A0.ORG_UNIT_ID
     	AND P_RESP_A0.ROLE_TYPE_ID_FROM = A0.ORG_UNIT_ROLE_TYPE_ID
     	AND P_RESP_A0.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
     	AND (@excludeValidity = 'N' OR (@excludeValidity = 'Y' AND P_RESP_A0.THRU_DATE IS NULL))     
     	AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND P_RESP_A0.FROM_DATE <= @date3112 AND (P_RESP_A0.THRU_DATE >= @date0101 OR P_RESP_A0.THRU_DATE IS NULL) )) 
	 LEFT OUTER JOIN PARTY P_A0 ON P_A0.PARTY_ID = P_RESP_A0.PARTY_ID_TO
  
  	WHERE A0.WORK_EFFORT_REVISION_ID IS NULL
  
 GROUP BY
 	  -- RAD.WORK_EFFORT_NAME, RAT.ETCH, RAD.WORK_EFFORT_ID, 
	   B0.ETCH, A0.ETCH, A0.WORK_EFFORT_NAME, Z0.SEQUENCE_NUM, A0.WORK_EFFORT_ID, A0.DESCRIPTION, Z0.ASSOC_WEIGHT, A0.SOURCE_REFERENCE_ID, 	   	   
	   P_A0.PARTY_NAME,
	   FIL_W.WORK_EFFORT_ID_FROM_OP, FIL_W.WORK_EFFORT_TYPE_ID_OP, FIL_W.ETICHETTA_OP, FIL_W.ETCH_OP, FIL_W.NAME_OP, FIL_W.SEQ_OP, FIL_W.ID_OP, FIL_W.DESCRIPTION_OP, FIL_W.ASSOC_WEIGHT_OP, FIL_W.CODE_OP
 
 	
 ]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="IndicatoriSempliceDS" id="49522">
            <list-property name="computedColumns">
                <structure>
                    <property name="name">INDICATORE</property>
                    <expression name="expression">if(row["G_INPUT_ENUM_ID"] == "ACCINP_UO"){&#13;
	 row["G_ACCOUNT_NAME"];&#13;
} else if(row["G_INPUT_ENUM_ID"] == "ACCINP_PRD"){&#13;
	 (row["UOM_DESCR"] != null &amp;&amp; row["UOM_DESCR"] != "" ? row["UOM_DESCR"]  :  row["G_ACCOUNT_NAME"])&#13;
} else if(row["G_INPUT_ENUM_ID"] == "ACCINP_OBJ"){&#13;
	(row["M_UOM_DESCR"] != null &amp;&amp; row["M_UOM_DESCR"] != "" ? row["M_UOM_DESCR"]  : row["G_ACCOUNT_NAME"])&#13;
} else {&#13;
	row["G_ACCOUNT_NAME"];&#13;
}</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">COUNT</property>
                    <property name="dataType">integer</property>
                    <property name="aggregateFunction">COUNT</property>
