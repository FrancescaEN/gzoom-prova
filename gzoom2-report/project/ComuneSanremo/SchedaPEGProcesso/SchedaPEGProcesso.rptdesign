            <xml-property name="queryText"><![CDATA[SELECT 
 ND.NOTE_NAME AS "NOTE_NAME",
 ND.NOTE_INFO AS "NOTE_INFO",
 ND.NOTE_DATE_TIME AS "NOTE_DATE_TIME",
 N.SEQUENCE_ID AS "SEQUENCE_ID"

FROM    WORK_EFFORT_NOTE N
JOIN    NOTE_DATA ND
ON      ND.NOTE_ID = N.NOTE_ID
WHERE  N.WORK_EFFORT_ID = ? AND (

((    ( ? = 'ALL'  OR (? = 'Y' AND ? = N.INTERNAL_NOTE) OR (? = 'N' AND (N.INTERNAL_NOTE IS NULL OR ? = N.INTERNAL_NOTE)))
AND    ( ? = 'ALL' OR (? = 'DATE' AND  (ND.NOTE_DATE_TIME = ? ) OR ND.NOTE_DATE_TIME = ?))
OR  (? = 'NONE' AND N.WORK_EFFORT_ID = '' ))
	AND (N.IS_MAIN = 'N' OR N.IS_MAIN IS NULL)
 )
 OR    ( (? = 'N' AND N.IS_MAIN = 'Y')) )
 
ORDER BY NOTE_DATE_TIME ,  N.SEQUENCE_ID ]]></xml-property>
