            <xml-property name="queryText"><![CDATA[SELECT 
Z1.WORK_EFFORT_ID_FROM AS "ID0",
A1.WORK_EFFORT_ID AS "WORK_EFFORT_ID",
A1.ETCH AS "ETCH",
A1.WORK_EFFORT_NAME AS "WORK_EFFORT_NAME",
WA.WORK_EFFORT_ID AS "ID_OBIETTIVO",
PA.PARTY_ID AS "ID_DIPENDENTE",
PA.PARTY_NAME AS "DIPENDENTE",   
WA.ROLE_TYPE_WEIGHT AS "IMPIEGATO",
WA.COMMENTS AS "COMMENTS",
PA1.PARTY_NAME AS "PROFILO",
E.DESCRIPTION AS "CATEGORIA"


FROM  WORK_EFFORT_ASSOC Z1 
		
	INNER JOIN WORK_EFFORT A1 ON A1.WORK_EFFORT_ID = Z1.WORK_EFFORT_ID_TO			
	INNER JOIN WORK_EFFORT_ASSOC_TYPE D1 ON D1.WORK_EFFORT_ASSOC_TYPE_ID = Z1.WORK_EFFORT_ASSOC_TYPE_ID
	INNER JOIN WORK_EFFORT_TYPE B1 ON B1.WORK_EFFORT_TYPE_ID = A1.WORK_EFFORT_TYPE_ID
		AND  B1.WORK_EFFORT_TYPE_ID = '15PM09'
		
		
	INNER JOIN WORK_EFFORT_PARTY_ASSIGNMENT WA ON WA.WORK_EFFORT_ID = A1.WORK_EFFORT_ID
	INNER JOIN WORK_EFFORT_ASSOC WEA ON WEA.WORK_EFFORT_ID_TO = WA.WORK_EFFORT_ID
	INNER JOIN PARTY PA ON WA.PARTY_ID = PA.PARTY_ID
	
	INNER JOIN PERSON PE ON WA.PARTY_ID = PE.PARTY_ID
	LEFT OUTER JOIN EMPL_POSITION_TYPE E ON E.EMPL_POSITION_TYPE_ID = PE.EMPL_POSITION_TYPE_ID
	LEFT OUTER JOIN PARTY_RELATIONSHIP PR ON PR.PARTY_ID_FROM = WA.PARTY_ID
		AND PR.PARTY_RELATIONSHIP_TYPE_ID = 'QUALIF'
		AND PR.THRU_DATE IS NULL
	LEFT OUTER JOIN PARTY PA1 ON PR.PARTY_ID_TO = PA1.PARTY_ID
	
	
WHERE WA.ROLE_TYPE_ID = 'WE_ASSIGNMENT' 
	AND Z1.WORK_EFFORT_ID_FROM   = ?
	AND (WA.FROM_DATE <= @date3112 AND WA.THRU_DATE >= @date0101)
	AND ( @excludeValidity = 'Y' OR  (@excludeValidity = 'N' AND ( Z1.FROM_DATE <= @date3112 AND (Z1.THRU_DATE >= @date0101 OR Z1.THRU_DATE IS NULL ))))	 			
	AND Z1.WORK_EFFORT_ASSOC_TYPE_ID = '15PM_PEG' 
	AND A1.WORK_EFFORT_REVISION_ID IS NULL
	
GROUP BY 
	Z1.WORK_EFFORT_ID_FROM, 
	A1.WORK_EFFORT_ID,
	A1.ETCH,
	A1.WORK_EFFORT_NAME,
	WA.WORK_EFFORT_ID,
	PA.PARTY_ID,
	PA.PARTY_NAME,   
	WA.ROLE_TYPE_WEIGHT,
	WA.COMMENTS,
	PA1.PARTY_NAME,
	E.DESCRIPTION

ORDER BY PA.PARTY_NAME]]></xml-property>
