            <xml-property name="queryText"><![CDATA[SELECT 
    WA.WORK_EFFORT_ID_TO AS "WORK_EFFORT_ID_TO",
    W.WORK_EFFORT_NAME AS "WORK_EFFORT_NAME",
    W.WORK_EFFORT_ID AS "WORK_EFFORT_ID_PROC",
    INDIC.G_INPUT_ENUM_ID AS "G_INPUT_ENUM_ID",
    INDIC.G_ACCOUNT_CODE AS "G_ACCOUNT_CODE",
    INDIC.G_ACCOUNT_NAME AS "G_ACCOUNT_NAME",
    INDIC.G_GL_ACCOUNT_TYPE_ID AS "G_GL_ACCOUNT_TYPE_ID",
    INDIC.M_SEQUENCE_ID AS "M_SEQUENCE_ID",
    INDIC.M_WORK_EFFORT_MEASURE_ID AS "M_WORK_EFFORT_MEASURE_ID",        
    INDIC.G_UOM_ABBREVIATION AS "G_UOM_ABBREVIATION",
    INDIC.M_KPI_SCORE_WEIGHT AS "M_KPI_SCORE_WEIGHT",
    INDIC.G_UOM_DECIMAL_SCALE AS "G_UOM_DECIMAL_SCALE",
    INDIC.M_UOM_DESCR AS "M_UOM_DESCR",
    INDIC.M_WE_MEASURE_TYPE_ENUM_ID AS "M_WE_MEASURE_TYPE_ENUM_ID",
    INDIC.G_GL_ACCOUNT_ID AS "G_GL_ACCOUNT_ID",    
    INDIC.G_UOM_TYPE_ID AS "G_UOM_TYPE_ID",
    INDIC.M_THRU_DATE AS "M_THRU_DATE",
    WP.UOM_DESCR AS "UOM_DESCR",
    INDIC.G_DESCRIPTION AS "G_DESCRIPTION",
    GT.DESCRIPTION AS "GT_DESCRIPTION",
    INDIC.G_DEBIT_CREDIT_DEFAULT AS "G_DEBIT_CREDIT_DEFAULT",
    D_C.DESCRIPTION AS "DEBIT_CREDIT_DEFAULT_DESC",
    
    SUM(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @monitoringDateM2 THEN INDIC.TM_AMOUNT ELSE NULL END) AS "ACTUAL_DATO_M2",
    MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @monitoringDateM2 THEN INDIC.R_UOM_CODE ELSE NULL END) AS "ACTUAL_COD_M2",
    MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @monitoringDateM2 THEN INDIC.TT_DESCRIPTION ELSE NULL END) AS "ACTUAL_COMMENTO_M2",
    MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @monitoringDateM2 THEN INDIC.TM_DESCRIPTION ELSE NULL END) AS "ACTUAL_RIFERIMENTO_M2",
    
    SUM(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3112M1 THEN INDIC.TM_AMOUNT ELSE NULL END) AS "ACTUAL_DATO_3112M1",
    MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3112M1 THEN INDIC.R_UOM_CODE ELSE NULL END) AS "ACTUAL_COD_3112M1",
    MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3112M1 THEN INDIC.TT_DESCRIPTION ELSE NULL END) AS "ACTUAL_COMMENTO_3112M1",
    MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3112M1 THEN INDIC.TM_DESCRIPTION ELSE NULL END) AS "ACTUAL_RIFERIMENTO_3112M1",
    
    SUM(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3006M1 THEN INDIC.TM_AMOUNT ELSE NULL END) AS "ACTUAL_DATO_3006M1",
    MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3006M1 THEN INDIC.R_UOM_CODE ELSE NULL END) AS "ACTUAL_COD_3006M1",
    MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3006M1 THEN INDIC.TT_DESCRIPTION ELSE NULL END) AS "ACTUAL_COMMENTO_3006M1",
    MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3006M1 THEN INDIC.TM_DESCRIPTION ELSE NULL END) AS "ACTUAL_RIFERIMENTO_3006M1",
    
    SUM(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @monitoringDate THEN INDIC.TM_AMOUNT ELSE NULL END) AS "BUDGET_DATO",
    MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @monitoringDate THEN INDIC.R_UOM_CODE ELSE NULL END) AS "BUDGET_COD",
    MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @monitoringDate THEN INDIC.TT_DESCRIPTION ELSE NULL END) AS "BUDGET_COMMENTO",
    MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @monitoringDate THEN INDIC.TM_DESCRIPTION ELSE NULL END) AS "BUDGET_RIFERIMENTO",
    
	  SUM(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3006 THEN INDIC.TM_AMOUNT ELSE NULL END)  "BUDGET_DATO_3006",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3006 THEN INDIC.R_UOM_CODE ELSE NULL END)  "BUDGET_COD_3006",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3006 THEN INDIC.TT_DESCRIPTION ELSE NULL END) "BUDGET_COMMENTO_3006",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3006 THEN INDIC.TM_DESCRIPTION ELSE NULL END)  "BUDGET_RIFERIMENTO_3006",
	  
	  SUM(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3112 THEN INDIC.TM_AMOUNT ELSE NULL END)  "BUDGET_DATO_3112",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3112 THEN INDIC.R_UOM_CODE ELSE NULL END)  "BUDGET_COD_3112",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3112 THEN INDIC.TT_DESCRIPTION ELSE NULL END) "BUDGET_COMMENTO_3112",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3112 THEN INDIC.TM_DESCRIPTION ELSE NULL END)  "BUDGET_RIFERIMENTO_3112",
	  
	  SUM(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3112P1 THEN INDIC.TM_AMOUNT ELSE NULL END)  "BUDGET_DATO_P1",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3112P1 THEN INDIC.R_UOM_CODE ELSE NULL END)  "BUDGET_COD_P1",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3112P1 THEN INDIC.TT_DESCRIPTION ELSE NULL END) "BUDGET_COMMENTO_P1",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3112P1 THEN INDIC.TM_DESCRIPTION ELSE NULL END)  "BUDGET_RIFERIMENTO_P1",
	  
	  SUM(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3112P2 THEN INDIC.TM_AMOUNT ELSE NULL END)  "BUDGET_DATO_P2",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3112P2 THEN INDIC.R_UOM_CODE ELSE NULL END)  "BUDGET_COD_P2",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3112P2 THEN INDIC.TT_DESCRIPTION ELSE NULL END) "BUDGET_COMMENTO_P2",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TT_TRANSACTION_DATE = @date3112P2 THEN INDIC.TM_DESCRIPTION ELSE NULL END)  "BUDGET_RIFERIMENTO_P2",
	  
	  SUM(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3112 THEN INDIC.TM_AMOUNT ELSE NULL END)  "ACTUAL_DATO_3112",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3112 THEN INDIC.R_UOM_CODE ELSE NULL END)  "ACTUAL_COD_3112",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3112 THEN INDIC.TT_DESCRIPTION ELSE NULL END) "ACTUAL_COMMENTO_3112",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3112 THEN INDIC.TM_DESCRIPTION ELSE NULL END)  "ACTUAL_RIFERIMENTO_3112",
	  
	  SUM(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3006 THEN INDIC.TM_AMOUNT ELSE NULL END)  "ACTUAL_DATO_3006",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3006 THEN INDIC.R_UOM_CODE ELSE NULL END)  "ACTUAL_COD_3006",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3006 THEN INDIC.TT_DESCRIPTION ELSE NULL END) "ACTUAL_COMMENTO_3006",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TT_TRANSACTION_DATE = @date3006 THEN INDIC.TM_DESCRIPTION ELSE NULL END)  "ACTUAL_RIFERIMENTO_3006",
	  
	  SUM(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'LOWER_LIMIT' AND INDIC.TT_TRANSACTION_DATE = @date3112 THEN INDIC.TM_AMOUNT ELSE NULL END) "LOWER_DATO",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'LOWER_LIMIT' AND INDIC.TT_TRANSACTION_DATE = @date3112 THEN INDIC.R_UOM_CODE ELSE NULL END) "LOWER_COD",	  	   
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'LOWER_LIMIT' AND INDIC.TT_TRANSACTION_DATE = @date3112 THEN INDIC.TT_DESCRIPTION ELSE NULL END) "LOWER_COMMENTO",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'LOWER_LIMIT' AND INDIC.TT_TRANSACTION_DATE = @date3112 THEN INDIC.TM_DESCRIPTION ELSE NULL END) "LOWER_RIFERIMENTO",
	  
	  SUM(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'MEDIUM_LIMIT' AND INDIC.TT_TRANSACTION_DATE = @date3112 THEN INDIC.TM_AMOUNT ELSE NULL END) AS "MEDIUM_DATO",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'MEDIUM_LIMIT' AND INDIC.TT_TRANSACTION_DATE = @date3112 THEN INDIC.R_UOM_CODE ELSE NULL END) AS "MEDIUM_COD",	  	   
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'MEDIUM_LIMIT' AND INDIC.TT_TRANSACTION_DATE = @date3112 THEN INDIC.TT_DESCRIPTION ELSE NULL END) AS "MEDIUM_COMMENTO",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'MEDIUM_LIMIT' AND INDIC.TT_TRANSACTION_DATE = @date3112 THEN INDIC.TM_DESCRIPTION ELSE NULL END) AS "MEDIUM_RIFERIMENTO",
	  
	  SUM(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'UPPER_LIMIT' AND INDIC.TT_TRANSACTION_DATE = @date3112 THEN INDIC.TM_AMOUNT ELSE NULL END) AS "UPPER_DATO",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'UPPER_LIMIT' AND INDIC.TT_TRANSACTION_DATE = @date3112 THEN INDIC.R_UOM_CODE ELSE NULL END) AS "UPPER_COD",	  	   
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'UPPER_LIMIT' AND INDIC.TT_TRANSACTION_DATE = @date3112 THEN INDIC.TT_DESCRIPTION ELSE NULL END) AS "UPPER_COMMENTO",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'UPPER_LIMIT' AND INDIC.TT_TRANSACTION_DATE = @date3112 THEN INDIC.TM_DESCRIPTION ELSE NULL END) AS "UPPER_RIFERIMENTO"
	  
	  
	FROM WORK_EFFORT_ASSOC WA
	
	INNER JOIN WORK_EFFORT_TRANS_ALL_VIEW INDIC ON INDIC.M_WORK_EFFORT_ID = WA.WORK_EFFORT_ID_TO
	INNER JOIN GL_ACCOUNT_TYPE GT ON GT.GL_ACCOUNT_TYPE_ID = INDIC.G_GL_ACCOUNT_TYPE_ID
	LEFT OUTER JOIN 
	( SELECT WM.GL_ACCOUNT_ID, PR.PRODUCT_ID, WM.UOM_DESCR
		FROM WORK_EFFORT_MEASURE WM
		INNER JOIN PRODUCT PR ON PR.PRODUCT_ID = WM.PRODUCT_ID
		WHERE WM.WORK_EFFORT_ID IS NULL) WP
		ON WP.GL_ACCOUNT_ID = INDIC.M_GL_ACCOUNT_ID AND WP.PRODUCT_ID = INDIC.M_PRODUCT_ID
		
	-- G_DEBIT_CREDIT_DEFAULT
	LEFT OUTER JOIN ENUMERATION D_C ON D_C.ENUM_ID = INDIC.G_DEBIT_CREDIT_DEFAULT
	
	
	LEFT OUTER JOIN WORK_EFFORT_ASSOC WAP ON WAP.WORK_EFFORT_ID_TO = WA.WORK_EFFORT_ID_TO
		AND WAP.WORK_EFFORT_ASSOC_TYPE_ID = '15PM09_PM014'	
	LEFT OUTER JOIN WORK_EFFORT W ON W.WORK_EFFORT_ID = WAP.WORK_EFFORT_ID_FROM
		
	
	WHERE (INDIC.G_GL_ACCOUNT_ID <> 'SCORE' OR INDIC.G_GL_ACCOUNT_ID IS NULL)
		 AND INDIC.G_ACCOUNT_TYPE_ENUM_ID = 'INDICATOR'
		 AND ( INDIC.TM_GL_ACCOUNT_ID <> 'SCOREKPI'	OR INDIC.TM_GL_ACCOUNT_ID IS NULL )	 
		 AND ( @excludePerformanceKPI = 'N' OR ( @excludePerformanceKPI = 'Y' AND INDIC.M_WE_MEASURE_TYPE_ENUM_ID = 'WEMT_PERF'))
		 AND WA.WORK_EFFORT_ID_FROM = ?
   		 AND INDIC.M_THRU_DATE >= @date0101
	  	 AND INDIC.M_FROM_DATE <= @date3112
	  	 AND WA.WORK_EFFORT_ASSOC_TYPE_ID <> '15PM09_PM014'	
	  	 AND (WA.WORK_EFFORT_ID_TO = ? OR W.WORK_EFFORT_ID = ?)
 GROUP BY          	
		WA.WORK_EFFORT_ID_TO,
		W.WORK_EFFORT_NAME,
		W.WORK_EFFORT_ID,
		INDIC.G_INPUT_ENUM_ID,
		INDIC.G_ACCOUNT_CODE,
		INDIC.G_ACCOUNT_NAME,
		INDIC.G_GL_ACCOUNT_TYPE_ID,
		INDIC.M_SEQUENCE_ID,
		INDIC.M_WORK_EFFORT_MEASURE_ID,		
		INDIC.G_UOM_ABBREVIATION,
		INDIC.M_KPI_SCORE_WEIGHT,
		INDIC.G_UOM_DECIMAL_SCALE,
		INDIC.M_UOM_DESCR,
		INDIC.M_WE_MEASURE_TYPE_ENUM_ID,
		INDIC.G_GL_ACCOUNT_ID,	
		INDIC.G_UOM_TYPE_ID,
		INDIC.M_THRU_DATE,
		WP.UOM_DESCR,
		INDIC.G_DESCRIPTION,
		GT.DESCRIPTION,
		INDIC.G_DEBIT_CREDIT_DEFAULT,
		D_C.DESCRIPTION
			

]]></xml-property>
            <xml-property name="designerValues"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<model:DesignValues xmlns:design="http://www.eclipse.org/datatools/connectivity/oda/design" xmlns:model="http://www.eclipse.org/birt/report/model/adapter/odaModel">
  <Version>2.0</Version>
  <design:ResultSets derivedMetaData="true">
    <design:resultSetDefinitions>
      <design:resultSetColumns>
        <design:resultColumnDefinitions>
          <design:attributes>
            <design:identifier>
              <design:name>PARTY_ID</design:name>
              <design:position>1</design:position>
            </design:identifier>
            <design:nativeDataTypeCode>12</design:nativeDataTypeCode>
            <design:precision>20</design:precision>
            <design:scale>0</design:scale>
            <design:nullability>NotNullable</design:nullability>
            <design:uiHints>
              <design:displayName>PARTY_ID</design:displayName>
            </design:uiHints>
          </design:attributes>
          <design:usageHints>
