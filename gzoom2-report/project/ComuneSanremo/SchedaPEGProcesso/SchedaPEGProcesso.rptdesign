            <method name="beforeOpen"><![CDATA[this.queryText = this.queryText.replace("@excludeValidity", "'" + params["excludeValidity"].value+ "'");
/**/
this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value );

/*
this.queryText = this.queryText.replace("@monitoringDate", "'2023-12-31'");
this.queryText = this.queryText.replace("@date3112", "'2023-12-31'" );
this.queryText = this.queryText.replace("@date0101","'2023-12-31'" );
*/

//@workEffortId
var workEffortId1 = '';
var workEffortId2 = '';
if (params["workEffortId"].value != null &amp;&amp; params["workEffortId"].value != '') {
	workEffortId1 = " AND FIL_W.WORK_EFFORT_ID = '"+ params["workEffortId"].value + "'"; 
	workEffortId2 = " AND Z3.WORK_EFFORT_ID_FROM = '"+ params["workEffortId"].value + "'";	
}
this.queryText = this.queryText.replace("@workEffortId1",  workEffortId1 );
this.queryText = this.queryText.replace("@workEffortId2",  workEffortId2 );



//GESTIRE PERMESSI
/**/
filter = new com.mapsengineering.base.birt.util.UtilFilter(params["userLoginId"].value, params["localDispatcherName"].value);
var filterInnerJoin = filter.getWorkEffortFilterInner();
var filterLeftJoin = filter.getWorkEffortFilterLeftJoin();
var filterWhere = filter.getWorkEffortFilterWhere();

/*
var filterInnerJoin = "";
var filterLeftJoin = "";
var filterWhere = ""; */


this.queryText = this.queryText.replace("@filterInnerJoin",  filterInnerJoin );
this.queryText = this.queryText.replace("@filterLeftJoin",  filterLeftJoin );
this.queryText = this.queryText.replace("@filterWhere",  filterWhere );
]]></method>
