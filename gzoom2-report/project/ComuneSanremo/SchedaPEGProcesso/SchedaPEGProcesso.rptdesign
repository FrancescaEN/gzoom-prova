	row["BUDGET_DATO"] != null ? Formatter.format(BirtStr.indexOf("%",row["FORMAT"],0) != -1 ? row["BUDGET_DATO"]/100 : row["BUDGET_DATO"], row["FORMAT"]) : '';&#13;
}</expression>
