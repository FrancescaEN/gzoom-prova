                    <property name="nativeName">ASSOC_WEIGHT3</property>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="position">35</property>
                    <property name="name">CODE3</property>
                    <property name="nativeName">CODE3</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">36</property>
                    <property name="name">OBJECT_INFO3</property>
                    <property name="nativeName">OBJECT_INFO3</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">37</property>
                    <property name="name">RESPTECNICO</property>
                    <property name="nativeName">RESPTECNICO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">38</property>
                    <property name="name">ACTUAL0</property>
                    <property name="nativeName">ACTUAL0</property>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="position">39</property>
                    <property name="name">ACTUAL1</property>
                    <property name="nativeName">ACTUAL1</property>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="position">40</property>
                    <property name="name">ACTUAL2</property>
                    <property name="nativeName">ACTUAL2</property>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="position">41</property>
                    <property name="name">ACTUAL3</property>
                    <property name="nativeName">ACTUAL3</property>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="position">42</property>
                    <property name="name">OBJ_INFO0</property>
                    <property name="nativeName">OBJ_INFO0</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">43</property>
                    <property name="name">OBJ_INFO1</property>
                    <property name="nativeName">OBJ_INFO1</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">44</property>
                    <property name="name">OBJ_INFO2</property>
                    <property name="nativeName">OBJ_INFO2</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">45</property>
                    <property name="name">OBJ_INFO3</property>
                    <property name="nativeName">OBJ_INFO3</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">46</property>
                    <property name="name">PURPOSE_TYPE_DESC</property>
                    <property name="nativeName">PURPOSE_TYPE_DESC</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">47</property>
                    <property name="name">NOTE_INFO2</property>
                    <property name="nativeName">NOTE_INFO2</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">48</property>
                    <property name="name">NOTE_INFO3</property>
                    <property name="nativeName">NOTE_INFO3</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select
	SCHEDE.*,
	ND2.NOTE_INFO as "NOTE_INFO2",
	ND3.NOTE_INFO as "NOTE_INFO3"
from
	(
	select
		RAD.WORK_EFFORT_NAME as "TITLE",
		RAD.ESTIMATED_START_DATE as "DATA_INIZIO_SCHEDA",
		RAD.ESTIMATED_COMPLETION_DATE as "DATA_FINE_SCHEDA",
		B0.ETCH as "ETICHETTA0",
		A0.ETCH as "ETCH0",
		A0.WORK_EFFORT_NAME as "NAME0",
		Z0.SEQUENCE_NUM as "SEQ0",
		A0.WORK_EFFORT_ID as "ID0",
		A0.DESCRIPTION as "DESCRIPTION0",
		Z0.ASSOC_WEIGHT as "ASSOC_WEIGHT0",
		A0.SOURCE_REFERENCE_ID as "CODE0",
		B1.ETCH as "ETICHETTA1",
		A1.ETCH as "ETCH1",
		A1.WORK_EFFORT_NAME as "NAME1",
		Z1.SEQUENCE_NUM as "SEQ1",
		A1.WORK_EFFORT_ID as "ID1",
		A1.DESCRIPTION as "DESCRIPTION1",
		Z1.ASSOC_WEIGHT as "ASSOC_WEIGHT1",
		A1.SOURCE_REFERENCE_ID as "CODE1",
		B2.ETCH as "ETICHETTA2",
		A2.ETCH as "ETCH2",
		A2.WORK_EFFORT_NAME as "NAME2",
		Z2.SEQUENCE_NUM as "SEQ2",
		A2.WORK_EFFORT_ID as "ID2",
		A2.DESCRIPTION as "DESCRIPTION2",
		Z2.ASSOC_WEIGHT as "ASSOC_WEIGHT2",
		A2.SOURCE_REFERENCE_ID as "CODE2",
		B3.ETCH as "ETICHETTA3",
		FIL_W.ETCH as "ETCH3",
		FIL_W.WORK_EFFORT_NAME as "NAME3",
		Z3.SEQUENCE_NUM as "SEQ3",
		FIL_W.WORK_EFFORT_ID as "ID3",
		FIL_W.DESCRIPTION as "DESCRIPTION3",
		Z3.ASSOC_WEIGHT as "ASSOC_WEIGHT3",
		FIL_W.SOURCE_REFERENCE_ID as "CODE3",
		I3.OBJECT_INFO as "OBJECT_INFO3",
		MAX(RS.PARTY_NAME) as "RESPTECNICO",
		MAX(I0.AMOUNT) as "ACTUAL0",
		MAX(I1.AMOUNT) as "ACTUAL1",
		MAX(I2.AMOUNT) as "ACTUAL2",
		MAX(I3.AMOUNT) as "ACTUAL3",
		MAX(EP0.OBJECT_INFO) as "OBJ_INFO0",
		MAX(EP1.OBJECT_INFO) as "OBJ_INFO1",
		MAX(EP2.OBJECT_INFO) as "OBJ_INFO2",
		MAX(EP3.OBJECT_INFO) as "OBJ_INFO3",
		MAX(WEPT.DESCRIPTION) as "PURPOSE_TYPE_DESC"
		
FROM WORK_EFFORT RAD

	 INNER JOIN WORK_EFFORT_ASSOC DIPZ ON DIPZ.WORK_EFFORT_ID_FROM = RAD.WORK_EFFORT_ID
     INNER JOIN WORK_EFFORT DIPA ON DIPA.WORK_EFFORT_ID = DIPZ.WORK_EFFORT_ID_TO
		 AND ( @excludeValidity = 'Y' OR  (@excludeValidity = 'N' AND ( DIPA.ESTIMATED_START_DATE <= @monitoringDate AND DIPA.ESTIMATED_COMPLETION_DATE >= @monitoringDate )))     
     INNER JOIN WORK_EFFORT_ASSOC_TYPE DIPD ON DIPD.WORK_EFFORT_ASSOC_TYPE_ID = DIPZ.WORK_EFFORT_ASSOC_TYPE_ID     
     INNER JOIN WORK_EFFORT_TYPE DIPB ON DIPB.WORK_EFFORT_TYPE_ID = DIPA.WORK_EFFORT_TYPE_ID

	 INNER JOIN WORK_EFFORT_ASSOC Z0 ON Z0.WORK_EFFORT_ID_FROM = DIPA.WORK_EFFORT_ID
     INNER JOIN WORK_EFFORT A0 ON A0.WORK_EFFORT_ID = Z0.WORK_EFFORT_ID_TO
		 AND ( @excludeValidity = 'Y' OR  (@excludeValidity = 'N' AND ( A0.ESTIMATED_START_DATE <= @monitoringDate AND A0.ESTIMATED_COMPLETION_DATE >= @monitoringDate )))     
     INNER JOIN WORK_EFFORT_ASSOC_TYPE D0 ON D0.WORK_EFFORT_ASSOC_TYPE_ID = Z0.WORK_EFFORT_ASSOC_TYPE_ID     
     INNER JOIN WORK_EFFORT_TYPE B0 ON B0.WORK_EFFORT_TYPE_ID = A0.WORK_EFFORT_TYPE_ID     
	 	
     INNER JOIN WORK_EFFORT_ASSOC Z1 ON Z1.WORK_EFFORT_ID_FROM = A0.WORK_EFFORT_ID
     INNER JOIN WORK_EFFORT A1 ON A1.WORK_EFFORT_ID = Z1.WORK_EFFORT_ID_TO
		 AND ( @excludeValidity = 'Y' OR  (@excludeValidity = 'N' AND ( A1.ESTIMATED_START_DATE <= @monitoringDate AND A1.ESTIMATED_COMPLETION_DATE >= @monitoringDate )))     
     INNER JOIN WORK_EFFORT_ASSOC_TYPE D1 ON D1.WORK_EFFORT_ASSOC_TYPE_ID = Z1.WORK_EFFORT_ASSOC_TYPE_ID     
     INNER JOIN WORK_EFFORT_TYPE B1 ON B1.WORK_EFFORT_TYPE_ID = A1.WORK_EFFORT_TYPE_ID     	
     
     INNER JOIN WORK_EFFORT_ASSOC Z2 ON Z2.WORK_EFFORT_ID_FROM = A1.WORK_EFFORT_ID
     INNER JOIN WORK_EFFORT_ASSOC_TYPE D2 ON D2.WORK_EFFORT_ASSOC_TYPE_ID = Z2.WORK_EFFORT_ASSOC_TYPE_ID
     INNER JOIN WORK_EFFORT A2 ON A2.WORK_EFFORT_ID = Z2.WORK_EFFORT_ID_TO
		 AND ( @excludeValidity = 'Y' OR  (@excludeValidity= 'N' AND ( A2.ESTIMATED_START_DATE <= @monitoringDate AND A2.ESTIMATED_COMPLETION_DATE >= @monitoringDate )))     
     INNER JOIN WORK_EFFORT_TYPE B2 ON B2.WORK_EFFORT_TYPE_ID = A2.WORK_EFFORT_TYPE_ID
     
     INNER JOIN WORK_EFFORT_ASSOC Z3 ON Z3.WORK_EFFORT_ID_FROM = A2.WORK_EFFORT_ID
     INNER JOIN WORK_EFFORT_ASSOC_TYPE D3 ON D3.WORK_EFFORT_ASSOC_TYPE_ID = Z3.WORK_EFFORT_ASSOC_TYPE_ID
     INNER JOIN WORK_EFFORT FIL_W ON FIL_W.WORK_EFFORT_ID = Z3.WORK_EFFORT_ID_TO
		 AND ( @excludeValidity = 'Y' OR  (@excludeValidity= 'N' AND ( FIL_W.ESTIMATED_START_DATE <= @monitoringDate AND FIL_W.ESTIMATED_COMPLETION_DATE >= @monitoringDate )))     
     INNER JOIN WORK_EFFORT_TYPE B3 ON B3.WORK_EFFORT_TYPE_ID = FIL_W.WORK_EFFORT_TYPE_ID
     @filterInnerJoin
     @filterLeftJoin
     LEFT OUTER JOIN PARTY_RELATIONSHIP PR ON PR.PARTY_ID_FROM = RAD.ORG_UNIT_ID AND PR.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE' AND PR.THRU_DATE IS NULL
  	 LEFT OUTER JOIN PARTY RS ON RS.PARTY_ID = PR.PARTY_ID_TO 
  	 
  	 LEFT OUTER JOIN (
          SELECT Q.WORK_EFFORT_ID, Q.TRANSACTION_DATE, R.AMOUNT
          FROM ACCTG_TRANS Q 
          INNER JOIN ACCTG_TRANS_ENTRY R ON Q.ACCTG_TRANS_ID = R.ACCTG_TRANS_ID
          WHERE R.GL_ACCOUNT_ID = 'SCORE' AND R.GL_FISCAL_TYPE_ID = 'ACTUAL'
          AND Q.TRANSACTION_DATE = @monitoringDate
                     ) I0 ON I0.WORK_EFFORT_ID = A0.WORK_EFFORT_ID AND I0.TRANSACTION_DATE = @monitoringDate
                     
  	 LEFT OUTER JOIN (
          SELECT Q.WORK_EFFORT_ID, Q.TRANSACTION_DATE, R.AMOUNT
          FROM ACCTG_TRANS Q 
          INNER JOIN ACCTG_TRANS_ENTRY R ON Q.ACCTG_TRANS_ID = R.ACCTG_TRANS_ID
          WHERE R.GL_ACCOUNT_ID = 'SCORE' AND R.GL_FISCAL_TYPE_ID = 'ACTUAL'
          AND Q.TRANSACTION_DATE = @monitoringDate
                     ) I1 ON I1.WORK_EFFORT_ID = A1.WORK_EFFORT_ID AND I1.TRANSACTION_DATE = @monitoringDate
                     
  	 LEFT OUTER JOIN (
          SELECT Q.WORK_EFFORT_ID, Q.TRANSACTION_DATE, R.AMOUNT
          FROM ACCTG_TRANS Q 
          INNER JOIN ACCTG_TRANS_ENTRY R ON Q.ACCTG_TRANS_ID = R.ACCTG_TRANS_ID
          WHERE R.GL_ACCOUNT_ID = 'SCORE' AND R.GL_FISCAL_TYPE_ID = 'ACTUAL'
          AND Q.TRANSACTION_DATE = @monitoringDate
                     ) I2 ON I2.WORK_EFFORT_ID = A2.WORK_EFFORT_ID AND I2.TRANSACTION_DATE = @monitoringDate
    
    LEFT OUTER JOIN (
          SELECT Q.WORK_EFFORT_ID, Q.TRANSACTION_DATE, R.AMOUNT, VP.UOM_RANGE_ID, EP.OBJECT_INFO
          FROM ACCTG_TRANS Q 
          INNER JOIN ACCTG_TRANS_ENTRY R ON Q.ACCTG_TRANS_ID = R.ACCTG_TRANS_ID          
          LEFT OUTER JOIN UOM_RANGE_VALUES VP ON VP.FROM_VALUE <= R.AMOUNT AND VP.THRU_VALUE >= R.AMOUNT		
		  LEFT OUTER JOIN ENUMERATION CP ON CP.ENUM_ID = VP.COLOR_ENUM_ID																											
	      LEFT OUTER JOIN CONTENT IP ON IP.CONTENT_ID = VP.ICON_CONTENT_ID																											
	      LEFT OUTER JOIN DATA_RESOURCE EP ON EP.DATA_RESOURCE_ID = IP.DATA_RESOURCE_ID	
	      
          WHERE R.GL_ACCOUNT_ID = 'SCORE' AND R.GL_FISCAL_TYPE_ID = 'ACTUAL'
          AND Q.TRANSACTION_DATE = @monitoringDate
                     ) I3 ON I3.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID AND I3.TRANSACTION_DATE = @monitoringDate
                     	AND I3.UOM_RANGE_ID = B3.UOM_RANGE_SCORE_ID
                     	
    LEFT OUTER JOIN WORK_EFFORT_PURPOSE_TYPE WEPT ON WEPT.WORK_EFFORT_PURPOSE_TYPE_ID = FIL_W.WORK_EFFORT_PURPOSE_TYPE_ID
                     	
    LEFT OUTER JOIN UOM_RANGE UR0 ON UR0.UOM_RANGE_ID = 'RISULTATI'
    LEFT OUTER JOIN UOM_RANGE_VALUES URV0 ON URV0.UOM_RANGE_ID = UR0.UOM_RANGE_ID 
      AND URV0.FROM_VALUE <= I0.AMOUNT AND URV0.THRU_VALUE >= I0.AMOUNT 																											
    LEFT JOIN CONTENT IP0 ON IP0.CONTENT_ID = URV0.ICON_CONTENT_ID																											
    LEFT JOIN DATA_RESOURCE EP0 ON EP0.DATA_RESOURCE_ID = IP0.DATA_RESOURCE_ID  
    
    LEFT OUTER JOIN UOM_RANGE UR1 ON UR1.UOM_RANGE_ID = 'RISULTATI'
    LEFT OUTER JOIN UOM_RANGE_VALUES URV1 ON URV1.UOM_RANGE_ID = UR1.UOM_RANGE_ID 
      AND URV1.FROM_VALUE <= I1.AMOUNT AND URV1.THRU_VALUE >= I1.AMOUNT 																											
    LEFT JOIN CONTENT IP1 ON IP1.CONTENT_ID = URV1.ICON_CONTENT_ID																											
    LEFT JOIN DATA_RESOURCE EP1 ON EP1.DATA_RESOURCE_ID = IP1.DATA_RESOURCE_ID 
    
    LEFT OUTER JOIN UOM_RANGE UR2 ON UR2.UOM_RANGE_ID = 'RISULTATI'
    LEFT OUTER JOIN UOM_RANGE_VALUES URV2 ON URV2.UOM_RANGE_ID = UR2.UOM_RANGE_ID 
      AND URV2.FROM_VALUE <= I2.AMOUNT AND URV2.THRU_VALUE >= I2.AMOUNT 																											
    LEFT JOIN CONTENT IP2 ON IP2.CONTENT_ID = URV2.ICON_CONTENT_ID																											
    LEFT JOIN DATA_RESOURCE EP2 ON EP2.DATA_RESOURCE_ID = IP2.DATA_RESOURCE_ID 
    
    LEFT OUTER JOIN UOM_RANGE UR3 ON UR3.UOM_RANGE_ID = 'RISULTATI'
    LEFT OUTER JOIN UOM_RANGE_VALUES URV3 ON URV3.UOM_RANGE_ID = UR3.UOM_RANGE_ID 
      AND URV3.FROM_VALUE <= I3.AMOUNT AND URV3.THRU_VALUE >= I3.AMOUNT 																											
    LEFT JOIN CONTENT IP3 ON IP3.CONTENT_ID = URV3.ICON_CONTENT_ID																											
    LEFT JOIN DATA_RESOURCE EP3 ON EP3.DATA_RESOURCE_ID = IP3.DATA_RESOURCE_ID                      	
     
     	
WHERE ((D0.PARENT_TYPE_ID = 'HIE' AND RAD.WORK_EFFORT_PARENT_ID = A0.WORK_EFFORT_PARENT_ID) OR Z0.WORK_EFFORT_ASSOC_TYPE_ID = DIPA.WORK_EFFORT_ASSOC_TYPE_ID) 
  AND  (Z0.THRU_DATE = RAD.ESTIMATED_COMPLETION_DATE OR Z0.THRU_DATE = A0.ESTIMATED_COMPLETION_DATE)  	
  AND ((D1.PARENT_TYPE_ID = 'HIE' AND A0.WORK_EFFORT_PARENT_ID = A1.WORK_EFFORT_PARENT_ID) OR Z1.WORK_EFFORT_ASSOC_TYPE_ID = A0.WORK_EFFORT_ASSOC_TYPE_ID) 
  AND  (Z1.THRU_DATE = A0.ESTIMATED_COMPLETION_DATE OR Z1.THRU_DATE = A1.ESTIMATED_COMPLETION_DATE)
  AND ((D2.PARENT_TYPE_ID = 'HIE' AND A1.WORK_EFFORT_PARENT_ID = A2.WORK_EFFORT_PARENT_ID) OR Z2.WORK_EFFORT_ASSOC_TYPE_ID = A1.WORK_EFFORT_ASSOC_TYPE_ID) 
  AND  (Z2.THRU_DATE = A1.ESTIMATED_COMPLETION_DATE OR Z2.THRU_DATE = A2.ESTIMATED_COMPLETION_DATE)  
  AND ((D3.PARENT_TYPE_ID = 'HIE' AND A2.WORK_EFFORT_PARENT_ID = FIL_W.WORK_EFFORT_PARENT_ID) OR Z3.WORK_EFFORT_ASSOC_TYPE_ID = A2.WORK_EFFORT_ASSOC_TYPE_ID) 
  AND  (Z3.THRU_DATE = A2.ESTIMATED_COMPLETION_DATE OR Z3.THRU_DATE = FIL_W.ESTIMATED_COMPLETION_DATE)
   
  -- valorizzati solo se esistenti
  @workEffortId	 
  @workEffortIdChild
  @orgUnitId
  
  -- FILTRO PERMESSI
  @filterWhere
 GROUP BY  
 	   RAD.WORK_EFFORT_NAME, RAD.ESTIMATED_START_DATE, RAD.ESTIMATED_COMPLETION_DATE,
	   B0.ETCH, A0.ETCH, A0.WORK_EFFORT_NAME, Z0.SEQUENCE_NUM, A0.WORK_EFFORT_ID, A0.DESCRIPTION, Z0.ASSOC_WEIGHT, A0.SOURCE_REFERENCE_ID,  
	   B1.ETCH, A1.ETCH, A1.WORK_EFFORT_NAME, Z1.SEQUENCE_NUM, A1.WORK_EFFORT_ID, A1.DESCRIPTION, Z1.ASSOC_WEIGHT, A1.SOURCE_REFERENCE_ID,        
       B2.ETCH, A2.ETCH, A2.WORK_EFFORT_NAME, Z2.SEQUENCE_NUM, A2.WORK_EFFORT_ID, A2.DESCRIPTION, Z2.ASSOC_WEIGHT, A2.SOURCE_REFERENCE_ID,  
       B3.ETCH, FIL_W.ETCH, FIL_W.WORK_EFFORT_NAME, Z3.SEQUENCE_NUM, FIL_W.WORK_EFFORT_ID, FIL_W.DESCRIPTION, Z3.ASSOC_WEIGHT, FIL_W.SOURCE_REFERENCE_ID,
       I3.OBJECT_INFO
 ) SCHEDE
 
 
LEFT OUTER JOIN WORK_EFFORT_NOTE MN2 ON  MN2.WORK_EFFORT_ID = SCHEDE."ID2"
	AND MN2.SEQUENCE_ID = '1'
LEFT OUTER JOIN NOTE_DATA ND2 ON ND2.NOTE_ID = MN2.NOTE_ID
	
LEFT OUTER JOIN WORK_EFFORT_NOTE MN3 ON  MN3.WORK_EFFORT_ID = SCHEDE."ID3"
	AND MN3.SEQUENCE_ID = '1'
LEFT OUTER JOIN NOTE_DATA ND3 ON ND3.NOTE_ID = MN3.NOTE_ID

]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="WorkEffortNoteAndDataDS" id="17187">
            <property name="nullsOrdering">nulls lowest</property>
            <list-property name="columnHints">
                <structure>
                    <property name="columnName">NOTE_NAME</property>
                    <property name="analysis">dimension</property>
                    <text-property name="displayName">NOTE_NAME</text-property>
                    <text-property name="heading">NOTE_NAME</text-property>
                </structure>
                <structure>
                    <property name="columnName">NOTE_INFO</property>
                    <property name="analysis">dimension</property>
                    <text-property name="displayName">NOTE_INFO</text-property>
                    <text-property name="heading">NOTE_INFO</text-property>
                </structure>
                <structure>
                    <property name="columnName">SEQUENCE_ID</property>
                    <property name="analysis">measure</property>
                    <text-property name="displayName">SEQUENCE_ID</text-property>
                    <text-property name="heading">SEQUENCE_ID</text-property>
                </structure>
            </list-property>
            <list-property name="parameters">
                <structure>
                    <property name="name">workEffortId</property>
                    <property name="paramName">workEffortId</property>
                    <property name="nativeName"></property>
                    <property name="dataType">string</property>
