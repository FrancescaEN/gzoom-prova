                    <property name="nativeName">ACTUAL_PERF_3112</property>
                    <property name="dataType">float</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
    INDIC.G_INPUT_ENUM_ID AS "G_INPUT_ENUM_ID",
    INDIC.G_ACCOUNT_CODE AS "G_ACCOUNT_CODE",
    INDIC.G_ACCOUNT_NAME AS "G_ACCOUNT_NAME",
    INDIC.M_SEQUENCE_ID AS "M_SEQUENCE_ID",
    INDIC.M_WORK_EFFORT_MEASURE_ID AS "M_WORK_EFFORT_MEASURE_ID",        
    INDIC.G_UOM_ABBREVIATION AS "G_UOM_ABBREVIATION",
    INDIC.M_KPI_SCORE_WEIGHT AS "M_KPI_SCORE_WEIGHT",
    INDIC.G_UOM_DECIMAL_SCALE AS "G_UOM_DECIMAL_SCALE",
    INDIC.M_UOM_DESCR AS "M_UOM_DESCR",
    INDIC.M_WE_MEASURE_TYPE_ENUM_ID AS "M_WE_MEASURE_TYPE_ENUM_ID",
    INDIC.G_GL_ACCOUNT_ID AS "G_GL_ACCOUNT_ID",    
    INDIC.G_UOM_TYPE_ID AS "G_UOM_TYPE_ID",
    INDIC.M_THRU_DATE AS "M_THRU_DATE",
    INDIC.M_COMMENTS AS "M_COMMENTS",
    WP.UOM_DESCR AS "UOM_DESCR",
    GT.DESCRIPTION AS "DESCRIPTION",
    GAGM_U.GL_ACCOUNT_GROUP_ID AS "UNIT_MISURA",
    GAGM_C.GL_ACCOUNT_GROUP_ID AS "CONFRONTO",
     
	  SUM(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND INDIC.TT_TRANSACTION_DATE = @date3006 THEN INDIC.TM_AMOUNT ELSE NULL END)  AS "BUDGET_DATO_3006",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND INDIC.TT_TRANSACTION_DATE = @date3006 THEN INDIC.R_UOM_CODE ELSE NULL END) AS  "BUDGET_COD_3006",  	
 	  SUM(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND INDIC.TT_TRANSACTION_DATE = @date3006 THEN INDIC.TM_AMOUNT ELSE NULL END) AS "ACTUAL_DATO_3006",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND INDIC.TT_TRANSACTION_DATE = @date3006 THEN INDIC.R_UOM_CODE ELSE NULL END) AS  "ACTUAL_COD_3006",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TM_GL_ACCOUNT_ID = 'SCOREKPI' AND INDIC.TT_TRANSACTION_DATE = @date3006 THEN INDIC.TM_AMOUNT ELSE NULL END) AS "ACTUAL_PERF_3006",  

	  SUM(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND INDIC.TT_TRANSACTION_DATE = @date3112 THEN INDIC.TM_AMOUNT ELSE NULL END) AS "BUDGET_DATO_3112",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND INDIC.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND INDIC.TT_TRANSACTION_DATE = @date3112 THEN INDIC.R_UOM_CODE ELSE NULL END) AS "BUDGET_COD_3112",  	
 	  SUM(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND INDIC.TT_TRANSACTION_DATE = @date3112 THEN INDIC.TM_AMOUNT ELSE NULL END) AS "ACTUAL_DATO_3112",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND INDIC.TT_TRANSACTION_DATE = @date3112 THEN INDIC.R_UOM_CODE ELSE NULL END) AS "ACTUAL_COD_3112",
	  MAX(CASE WHEN INDIC.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND INDIC.TM_GL_ACCOUNT_ID = 'SCOREKPI' AND INDIC.TT_TRANSACTION_DATE = @date3112 THEN INDIC.TM_AMOUNT ELSE NULL END) AS "ACTUAL_PERF_3112"
	  
	FROM WORK_EFFORT_TRANS_INDIC_VIEW INDIC	
	INNER JOIN GL_ACCOUNT_TYPE GT ON GT.GL_ACCOUNT_TYPE_ID = INDIC.G_GL_ACCOUNT_TYPE_ID	
  	LEFT OUTER JOIN GL_ACCOUNT_GROUP_MEMBER GAGM_U ON GAGM_U.GL_ACCOUNT_ID = INDIC.G_GL_ACCOUNT_ID
  		AND GAGM_U.GL_ACCOUNT_GROUP_TYPE_ID = 'UnitaDiMisura'
  	LEFT OUTER JOIN GL_ACCOUNT_GROUP_MEMBER GAGM_C ON GAGM_C.GL_ACCOUNT_ID = INDIC.G_GL_ACCOUNT_ID
  		AND GAGM_C.GL_ACCOUNT_GROUP_TYPE_ID = 'Confronto'
  		
	LEFT OUTER JOIN 
	( SELECT WM.GL_ACCOUNT_ID, PR.PRODUCT_ID, WM.UOM_DESCR
		FROM WORK_EFFORT_MEASURE WM
		INNER JOIN PRODUCT PR ON PR.PRODUCT_ID = WM.PRODUCT_ID
		WHERE WM.WORK_EFFORT_ID IS NULL) WP
		ON WP.GL_ACCOUNT_ID = INDIC.M_GL_ACCOUNT_ID AND WP.PRODUCT_ID = INDIC.M_PRODUCT_ID
	
	
	WHERE (INDIC.G_GL_ACCOUNT_ID <> 'SCORE' OR INDIC.G_GL_ACCOUNT_ID IS NULL)
		 AND INDIC.G_ACCOUNT_TYPE_ENUM_ID = 'INDICATOR'		 
		 AND ( @excludePerformanceKPI = 'N' OR ( @excludePerformanceKPI = 'Y' AND INDIC.M_WE_MEASURE_TYPE_ENUM_ID = 'WEMT_PERF'))
		 AND INDIC.M_WORK_EFFORT_ID = ?
   		 AND INDIC.M_THRU_DATE >= @date0101
	  	 AND INDIC.M_FROM_DATE <= @date3112
	  	 	
 GROUP BY          	
		INDIC.G_INPUT_ENUM_ID,
		INDIC.G_ACCOUNT_CODE,
		INDIC.G_ACCOUNT_NAME,
		INDIC.M_SEQUENCE_ID,
		INDIC.M_WORK_EFFORT_MEASURE_ID,		
		INDIC.G_UOM_ABBREVIATION,
		INDIC.M_KPI_SCORE_WEIGHT,
		INDIC.G_UOM_DECIMAL_SCALE,
		INDIC.M_UOM_DESCR,
		INDIC.M_WE_MEASURE_TYPE_ENUM_ID,
		INDIC.G_GL_ACCOUNT_ID,	
		INDIC.G_UOM_TYPE_ID,
		INDIC.M_THRU_DATE,
		INDIC.M_COMMENTS,
		WP.UOM_DESCR,
		GT.DESCRIPTION,
		GAGM_U.GL_ACCOUNT_GROUP_ID,
		GAGM_C.GL_ACCOUNT_GROUP_ID	

]]></xml-property>
