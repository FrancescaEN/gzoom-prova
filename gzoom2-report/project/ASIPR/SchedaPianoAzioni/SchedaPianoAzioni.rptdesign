                    </structure>
                </list-property>
            </structure>
            <method name="beforeOpen"><![CDATA[ReportLog.info("... this.queryText DimensionePerformanceDS: "+this.queryText);]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">DIMENSIONE_PERFORMANCE</property>
                    <property name="nativeName">DIMENSIONE_PERFORMANCE</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">DIMENSIONE_PERFORMANCE_ETCH</property>
                    <property name="nativeName">DIMENSIONE_PERFORMANCE_ETCH</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">DIMENSIONE_PERFORMANCE_ETCH_TYPE</property>
                    <property name="nativeName">DIMENSIONE_PERFORMANCE_ETCH_TYPE</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT CASE WHEN APPO1.WORK_EFFORT_NAME is not null THEN APPO1.WORK_EFFORT_NAME
            WHEN APPO2.WORK_EFFORT_NAME is not null THEN APPO2.WORK_EFFORT_NAME
			WHEN APPO3.WORK_EFFORT_NAME is not null THEN APPO3.WORK_EFFORT_NAME           
			ELSE '' END AS "DIMENSIONE_PERFORMANCE",

	   CASE WHEN APPO1.ETCH is not null THEN APPO1.ETCH
            WHEN APPO2.ETCH is not null THEN APPO2.ETCH
			WHEN APPO3.ETCH is not null THEN APPO3.ETCH           
            ELSE '' END AS "DIMENSIONE_PERFORMANCE_ETCH",

	   CASE WHEN APPO1.ETCH_TYPE is not null THEN APPO1.ETCH_TYPE
            WHEN APPO2.ETCH_TYPE is not null THEN APPO2.ETCH_TYPE
			WHEN APPO3.ETCH_TYPE is not null THEN APPO3.ETCH_TYPE           
            ELSE '' END AS "DIMENSIONE_PERFORMANCE_ETCH_TYPE"

FROM WORK_EFFORT W
LEFT OUTER JOIN (
	 SELECT WEA1.WORK_EFFORT_ID_TO, MAX (W1.WORK_EFFORT_NAME) AS WORK_EFFORT_NAME, MAX (W1.ETCH) AS ETCH, MAX (WT1.ETCH) AS ETCH_TYPE
     FROM WORK_EFFORT_ASSOC WEA1
     INNER JOIN WORK_EFFORT W1 ON WEA1.WORK_EFFORT_ID_FROM = W1.WORK_EFFORT_ID
		AND WEA1.WORK_EFFORT_ASSOC_TYPE_ID = 'COLLDIRAZI'
		AND W1.WORK_EFFORT_TYPE_ID = 'DIRDIM15' 
	 INNER JOIN WORK_EFFORT_TYPE WT1 ON WT1.WORK_EFFORT_TYPE_ID = W1.WORK_EFFORT_TYPE_ID
     GROUP BY WEA1.WORK_EFFORT_ID_TO) APPO1 ON APPO1.WORK_EFFORT_ID_TO = W.WORK_EFFORT_ID
LEFT OUTER JOIN (
	 SELECT WEA1.WORK_EFFORT_ID_TO, MAX (W2.WORK_EFFORT_NAME) AS WORK_EFFORT_NAME, MAX (W2.ETCH) AS ETCH, MAX (WT2.ETCH) AS ETCH_TYPE
     FROM WORK_EFFORT_ASSOC WEA1
     INNER JOIN WORK_EFFORT W1 ON WEA1.WORK_EFFORT_ID_FROM = W1.WORK_EFFORT_ID
		AND WEA1.WORK_EFFORT_ASSOC_TYPE_ID = 'COLLDIRAZI'
		AND W1.WORK_EFFORT_TYPE_ID = 'DIRARE15' 
     INNER JOIN WORK_EFFORT_ASSOC WEA2 ON WEA2.WORK_EFFORT_ID_TO = WEA1.WORK_EFFORT_ID_FROM
     AND WEA2.WORK_EFFORT_ASSOC_TYPE_ID = 'DIR'
     INNER JOIN WORK_EFFORT W2 ON W2.WORK_EFFORT_ID = WEA2.WORK_EFFORT_ID_FROM
	 INNER JOIN WORK_EFFORT_TYPE WT2 ON WT2.WORK_EFFORT_TYPE_ID = W2.WORK_EFFORT_TYPE_ID
     GROUP BY WEA1.WORK_EFFORT_ID_TO) APPO2 ON APPO2.WORK_EFFORT_ID_TO = W.WORK_EFFORT_ID
LEFT OUTER JOIN (
	SELECT WEA1.WORK_EFFORT_ID_TO, MAX (W3.WORK_EFFORT_NAME) AS WORK_EFFORT_NAME, MAX (W3.ETCH) AS ETCH, MAX (WT3.ETCH) AS ETCH_TYPE
     FROM WORK_EFFORT_ASSOC WEA1
     INNER JOIN WORK_EFFORT W1 ON WEA1.WORK_EFFORT_ID_FROM = W1.WORK_EFFORT_ID
		AND WEA1.WORK_EFFORT_ASSOC_TYPE_ID = 'COLLDIRAZI'
		AND W1.WORK_EFFORT_TYPE_ID = 'DIROB15' 
		AND WEA1.SEQUENCE_NUM = 1
     INNER JOIN WORK_EFFORT_ASSOC WEA2 ON WEA2.WORK_EFFORT_ID_TO = WEA1.WORK_EFFORT_ID_FROM
		AND WEA2.WORK_EFFORT_ASSOC_TYPE_ID = 'DIR'
     INNER JOIN WORK_EFFORT_ASSOC WEA3 ON WEA3.WORK_EFFORT_ID_TO = WEA2.WORK_EFFORT_ID_FROM
		AND WEA3.WORK_EFFORT_ASSOC_TYPE_ID = 'DIR'
     INNER JOIN WORK_EFFORT W3 ON W3.WORK_EFFORT_ID = WEA3.WORK_EFFORT_ID_FROM
	 INNER JOIN WORK_EFFORT_TYPE WT3 ON WT3.WORK_EFFORT_TYPE_ID = W3.WORK_EFFORT_TYPE_ID
     GROUP BY WEA1.WORK_EFFORT_ID_TO) APPO3 ON APPO3.WORK_EFFORT_ID_TO = W.WORK_EFFORT_ID
WHERE W.WORK_EFFORT_ID = ?
]]></xml-property>
