            <method name="beforeOpen"><![CDATA[this.queryText = this.queryText.replace("@excludeValidity", "'" + params["excludeValidity"].value+ "'");
this.queryText = this.queryText.replace("@monitoringDate",   params["monitoringDateSql"].value );
//this.queryText = this.queryText.replace("@monitoringDate",  "'2021-01-01 00:00:00.000'" );


//ReportLog.info("... this.queryText OBCOLLEGATI: "+this.queryText);
//ReportLog.info("... this.queryText PARAMS: "+this.getInputParameters());
]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">ID_RAD</property>
                    <property name="nativeName">ID_RAD</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">ETICHETTA0</property>
                    <property name="nativeName">ETICHETTA0</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">ETCH0</property>
                    <property name="nativeName">ETCH0</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">NAME0</property>
                    <property name="nativeName">NAME0</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">SEQ0</property>
                    <property name="nativeName">SEQ0</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">CODE0</property>
                    <property name="nativeName">CODE0</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">ID0</property>
                    <property name="nativeName">ID0</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
	   Z0.WORK_EFFORT_ID_TO AS "ID_RAD",
	    B0.ETCH AS "ETICHETTA0",
	     A0.ETCH AS "ETCH0",
	      A0.WORK_EFFORT_NAME AS "NAME0",
	       Z0.SEQUENCE_NUM AS "SEQ0",
	        A0.SOURCE_REFERENCE_ID AS "CODE0",
	         A0.WORK_EFFORT_ID AS "ID0"
	      
FROM WORK_EFFORT_ASSOC Z0 
     INNER JOIN WORK_EFFORT A0 ON A0.WORK_EFFORT_ID = Z0.WORK_EFFORT_ID_FROM
		 AND ( @excludeValidity = 'Y' OR  (@excludeValidity = 'N' AND ( A0.ESTIMATED_START_DATE <= @monitoringDate AND A0.ESTIMATED_COMPLETION_DATE >= @monitoringDate )))     
     INNER JOIN WORK_EFFORT_ASSOC_TYPE D0 ON D0.WORK_EFFORT_ASSOC_TYPE_ID = Z0.WORK_EFFORT_ASSOC_TYPE_ID 
		AND D0.WORK_EFFORT_ASSOC_TYPE_ID = 'COLLDIRAZI'    
     INNER JOIN WORK_EFFORT_TYPE B0 ON B0.WORK_EFFORT_TYPE_ID = A0.WORK_EFFORT_TYPE_ID     

WHERE Z0.WORK_EFFORT_ID_TO = ? 
    AND Z0.SEQUENCE_NUM = ?
	AND B0.CODE_PREFIX LIKE 'OB%']]></xml-property>
