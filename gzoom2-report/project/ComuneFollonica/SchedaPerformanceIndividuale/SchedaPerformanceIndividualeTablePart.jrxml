			<defaultValueExpression><![CDATA["admin"]]></defaultValueExpression>
		</parameter>
		<parameter name="orgUnitId" class="java.lang.String">
			<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT 
	FIL_W.SOURCE_REFERENCE_ID as "Codice CDC",
    FIL_W.WORK_EFFORT_NAME as "Centro di costo",
    CDR.SOURCE_REFERENCE_ID as "Codice CDR",
    CDR.WORK_EFFORT_NAME as "Centro di responsabilità",
    SETT.SOURCE_REFERENCE_ID as "Codice settore",
    SETT.WORK_EFFORT_NAME as "Settore",
    P2.PARTY_NAME as "Responsabile",
    PEG.SOURCE_REFERENCE_ID as "Codice obiettivo di PEG",
    PEG.WORK_EFFORT_NAME as "Obiettivo di PEG",
    PEG.DESCRIPTION as "Descrizione",
    WEPT.DESCRIPTION as "Miglioramento/Mantenimento",
    string_agg(STAKE.WORK_EFFORT_NAME, '
') as "Stakeholders",
	CONCAT(MAND.ETCH, ' - ', MAND.WORK_EFFORT_NAME) as "Linea di mandato",
	CONCAT(OBS.ETCH, ' - ', OBS.WORK_EFFORT_NAME) as "Obiettivo strategico",
	CONCAT(MISB.ETCH, ' - ', MISB.WORK_EFFORT_NAME) as "Missione di bilancio",
	CONCAT(PROB.ETCH, ' - ', PROB.WORK_EFFORT_NAME) as "Programma di bilancio",
	CONCAT(OBO.ETCH, ' - ', OBO.WORK_EFFORT_NAME) as "Obiettivo operativo",
	MAX(case when EMAS.GL_ACCOUNT_ID = '10020' then EMAS.UOM_CODE else null END) as "Obiettivo EMAS",
	MAX(case when NOTA.NOTE_NAME = 'Risultato previsto' and NOTA.NOTE_DATE_TIME = $P{date0101} then NOTA.NOTE_INFO else null END) as "Risultato previsto",
	MON.UOM_DESCR as "Monitoraggio",
	MAX(case when NOTA.NOTE_NAME = 'Attività svolte' and NOTA.NOTE_DATE_TIME = $P{date3009} then NOTA.NOTE_INFO else null END) as "Attività svolte",
	MAX(case when NOTA.NOTE_NAME = 'Azioni correttive' and NOTA.NOTE_DATE_TIME = $P{date3009} then NOTA.NOTE_INFO else null END) as "Azioni correttive",
	MAX(case when NOTA.NOTE_NAME = 'Risultato ottenuto' and NOTA.NOTE_DATE_TIME = $P{date3112} then NOTA.NOTE_INFO else null END) as "Risultato ottenuto",
	MAX(case when NOTA.NOTE_NAME = 'Iniziative di miglioramento' and NOTA.NOTE_DATE_TIME = $P{date3112} then NOTA.NOTE_INFO else null END) as "Iniziative di miglioramento",
	INDIC.UOM_DESCR as "Indicatore",
	INDIC.DESCRIPTION as "Unità di misura",
	indic.target as "Target",
	indic.cons as "Consuntivo",
	indic.amount as "Punteggio indicatore",
	RIS.AMOUNT as "Raggiungimento obiettivo"
/* CENTRO DI COSTO */
FROM WORK_EFFORT FIL_W
/* RESPONSABILE CENTRO DI COSTO */
inner join PARTY P on P.PARTY_ID = FIL_W.ORG_UNIT_ID and P.STATUS_ID = 'PARTY_ENABLED'
inner join PARTY_RELATIONSHIP PR on PR.PARTY_ID_FROM = P.PARTY_ID and PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
	and PR.FROM_DATE <= $P{date3112} and (PR.THRU_DATE is null or PR.THRU_DATE >= $P{date3112})
inner join PARTY P2 on P2.PARTY_ID = PR.PARTY_ID_TO and P.STATUS_ID = 'PARTY_ENABLED'
/* CENTRO DI RESPONSABILITA' */
INNER JOIN WORK_EFFORT_ASSOC WEA ON WEA.WORK_EFFORT_ID_TO = FIL_W.WORK_EFFORT_ID AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '20P2'
INNER JOIN WORK_EFFORT CDR ON CDR.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_FROM AND CDR.WORK_EFFORT_TYPE_ID = '20P26SSL' and CDR.WORK_EFFORT_REVISION_ID is NULL
	and CDR.ESTIMATED_START_DATE <= $P{date3112} and (CDR.ESTIMATED_COMPLETION_DATE is null or CDR.ESTIMATED_COMPLETION_DATE >= $P{date0101})
/* SETTORE */
INNER JOIN WORK_EFFORT_ASSOC WEA2 ON WEA2.WORK_EFFORT_ID_TO = CDR.WORK_EFFORT_ID AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '20P2'
INNER JOIN WORK_EFFORT SETT ON SETT.WORK_EFFORT_ID = WEA2.WORK_EFFORT_ID_FROM AND SETT.WORK_EFFORT_TYPE_ID = '20P24SPL' and SETT.WORK_EFFORT_REVISION_ID is NULL
	and SETT.ESTIMATED_START_DATE <= $P{date3112} and (SETT.ESTIMATED_COMPLETION_DATE is null or SETT.ESTIMATED_COMPLETION_DATE >= $P{date0101})
	
/* START filterInnerJoin */
   $P!{filterInnerJoinString} 
/* END filterInnerJoin */
/* START filterLeftJoin */
  $P!{filterLeftJoinString} 
/* END filterLeftJoin */
	
/* OBIETTIVO DI PEG */
left join WORK_EFFORT_ASSOC WEAPEG on WEAPEG.WORK_EFFORT_ID_FROM = FIL_W.WORK_EFFORT_ID and WEAPEG.WORK_EFFORT_ASSOC_TYPE_ID = '20P23'
left join WORK_EFFORT PEG on PEG.WORK_EFFORT_ID = WEAPEG.WORK_EFFORT_ID_TO and PEG.WORK_EFFORT_TYPE_ID = '20P44OPD' and PEG.WORK_EFFORT_REVISION_ID is NULL
	and PEG.ESTIMATED_START_DATE <= $P{date3112} and (PEG.ESTIMATED_COMPLETION_DATE is null or PEG.ESTIMATED_COMPLETION_DATE >= $P{date0101})
left join WORK_EFFORT_PURPOSE_TYPE WEPT on WEPT.WORK_EFFORT_PURPOSE_TYPE_ID = PEG.WORK_EFFORT_PURPOSE_TYPE_ID
/* FLAG OBIETTIVO EMAS */
left join (
	select WEM.WORK_EFFORT_ID, WEM.GL_ACCOUNT_ID, WEMRS.UOM_CODE
	from WORK_EFFORT_MEASURE WEM
	inner join ACCTG_TRANS_ENTRY ATE on ATE.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID
	inner join WORK_EFFORT_MEAS_RAT_SC WEMRS on WEMRS.WORK_EFFORT_MEASURE_ID = ATE.VOUCHER_REF
		AND WEMRS.UOM_ID = ATE.CURRENCY_UOM_ID and WEMRS.UOM_RATING_VALUE = ATE.AMOUNT
) EMAS on EMAS.WORK_EFFORT_ID = PEG.WORK_EFFORT_ID
/* MONITORAGGIO OBIETTIVO DI PEG */
left join (
	select WEMRS.UOM_DESCR, wem.work_effort_id
	from WORK_EFFORT_MEASURE wem
	join GL_ACCOUNT GL on GL.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID and GL.GL_ACCOUNT_TYPE_ID = 'INDSCO'
	join ACCTG_TRANS at on at.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID and at.TRANSACTION_DATE = $P{date3009}
	join ACCTG_TRANS_ENTRY ATE on ATE.ACCTG_TRANS_ID = at.ACCTG_TRANS_ID
	LEFT join WORK_EFFORT_MEAS_RAT_SC WEMRS on WEMRS.WORK_EFFORT_MEASURE_ID = WEM.WORK_EFFORT_MEASURE_ID
		AND WEMRS.UOM_ID = ATE.CURRENCY_UOM_ID and WEMRS.UOM_RATING_VALUE = ATE.AMOUNT
) MON on MON.WORK_EFFORT_ID = PEG.WORK_EFFORT_ID
/* INDICATORI OBIETTIVO DI PEG */
left join (
	select 
	wem.work_effort_id,
	wem.uom_descr,
	gl.account_name,
	u.description,
	max(case when ATE.GL_FISCAL_TYPE_ID = 'BUDGET'
		then (case when U.UOM_TYPE_ID = 'RATING_SCALE' then gamrs.UOM_DESCR else
		(case when left(to_char(ATE.AMOUNT,'FM999999999.00'), 1) = '.' then CONCAT('0', to_char(ATE.AMOUNT,'FM999999999.00')) else to_char(ATE.AMOUNT,'FM999999999.00') end) END) end) as TARGET,
	max(case when ATE.GL_FISCAL_TYPE_ID = 'ACTUAL'
		then (case when U.UOM_TYPE_ID = 'RATING_SCALE' then gamrs.UOM_DESCR else
		(case when left(to_char(ATE.AMOUNT,'FM999999999.00'), 1) = '.' then CONCAT('0', to_char(ATE.AMOUNT,'FM999999999.00')) else to_char(ATE.AMOUNT,'FM999999999.00') end) END) end) as CONS,
	atekpi.amount 
	from work_effort_measure wem
	join work_effort_purpose_account wepa on wepa.gl_account_id = wem.gl_account_id and wepa.work_effort_purpose_type_id in ('OBPINN', 'OBPIND')
	join gl_account gl on gl.gl_account_id = wem.gl_account_id
	join uom u on u.uom_id = gl.default_uom_id 
	left join acctg_trans act on act.voucher_ref = wem.work_effort_measure_id and act.transaction_date = $P{date3112}
	left join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id and ate.gl_account_id <> 'SCOREKPI'
	left join gl_account_meas_rat_sc gamrs on gamrs.gl_account_id = wem.gl_account_id 
		and gamrs.uom_rating_value <= ate.amount and gamrs.uom_rating_value >= ate.amount
	left join acctg_trans_entry atekpi on atekpi.voucher_ref = wem.work_effort_measure_id and atekpi.gl_account_id = 'SCOREKPI'
	left join acctg_trans actkpi on actkpi.acctg_trans_id = atekpi.acctg_trans_id and actkpi.transaction_date = $P{date3112}
	group by
		wem.work_effort_id,
		wem.uom_descr,
		gl.account_name,
		u.description,
		atekpi.amount
) INDIC on INDIC.WORK_EFFORT_ID = PEG.WORK_EFFORT_ID
/* PUNTEGGIO OBIETTIVO DI PEG */
left join (
	select ATE.AMOUNT, WEM.WORK_EFFORT_ID
	from work_EFFORT_MEASURE WEM
	join ACCTG_TRANS at on at.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID and at.TRANSACTION_DATE = $P{date3112}
	join ACCTG_TRANS_ENTRY ATE on ATE.ACCTG_TRANS_ID = at.ACCTG_TRANS_ID
	where WEM.GL_ACCOUNT_ID = 'SCORE'
) RIS on RIS.WORK_EFFORT_ID = PEG.WORK_EFFORT_ID
/* NOTE OBIETTIVO DI PEG */
left join (
	select WEN.WORK_EFFORT_ID, ND.NOTE_NAME, ND.NOTE_INFO, ND.NOTE_DATE_TIME
	from WORK_EFFORT_NOTE WEN
	join NOTE_DATA ND on ND.NOTE_ID = WEN.NOTE_ID
) NOTA on NOTA.WORK_EFFORT_ID = PEG.WORK_EFFORT_ID
/* STAKEHOLDER */
left join WORK_EFFORT_ASSOC WEA3 on WEA3.WORK_EFFORT_ID_TO = PEG.WORK_EFFORT_ID and WEA3.WORK_EFFORT_ASSOC_TYPE_ID = '20R2C'
left join WORK_EFFORT STAKE on STAKE.WORK_EFFORT_ID = WEA3.WORK_EFFORT_ID_FROM and STAKE.WORK_EFFORT_TYPE_ID = '20R24STK' and STAKE.WORK_EFFORT_REVISION_ID is NULL
	and STAKE.ESTIMATED_START_DATE <= $P{date3112} and (STAKE.ESTIMATED_COMPLETION_DATE is null or STAKE.ESTIMATED_COMPLETION_DATE >= $P{date0101})
/* OBIETTIVO OPERATIVO */
left join WORK_EFFORT_ASSOC WEA4 on WEA4.WORK_EFFORT_ID_TO = PEG.WORK_EFFORT_ID and WEA4.WORK_EFFORT_ASSOC_TYPE_ID = '20D6OC'
left join WORK_EFFORT OBO on OBO.WORK_EFFORT_ID = WEA4.WORK_EFFORT_ID_FROM and OBO.WORK_EFFORT_TYPE_ID = '20D66OOP' and OBO.WORK_EFFORT_REVISION_ID is NULL
	and OBO.ESTIMATED_START_DATE <= $P{date3112} and (OBO.ESTIMATED_COMPLETION_DATE is null or OBO.ESTIMATED_COMPLETION_DATE >= $P{date0101})
/* OBIETTIVO STRATEGICO */
left join WORK_EFFORT_ASSOC WEA5 on WEA5.WORK_EFFORT_ID_TO = OBO.WORK_EFFORT_ID and WEA5.WORK_EFFORT_ASSOC_TYPE_ID = '20D6C'
left join WORK_EFFORT OBS on OBS.WORK_EFFORT_ID = WEA5.WORK_EFFORT_ID_FROM and OBS.WORK_EFFORT_TYPE_ID = '20D64OST' and OBS.WORK_EFFORT_REVISION_ID is null
	and OBS.ESTIMATED_START_DATE <= $P{date3112} and (OBS.ESTIMATED_COMPLETION_DATE is null or OBS.ESTIMATED_COMPLETION_DATE >= $P{date0101})
/* LINEA DI MANDATO */
left join WORK_EFFORT_ASSOC WEA6 on WEA6.WORK_EFFORT_ID_TO = OBS.WORK_EFFORT_ID and WEA6.WORK_EFFORT_ASSOC_TYPE_ID = '20D6'
left join WORK_EFFORT MAND on MAND.WORK_EFFORT_ID = WEA6.WORK_EFFORT_ID_FROM and MAND.WORK_EFFORT_TYPE_ID = '20D62LIN' and MAND.WORK_EFFORT_REVISION_ID is NULL
	and MAND.ESTIMATED_START_DATE <= $P{date3112} and (MAND.ESTIMATED_COMPLETION_DATE is null or MAND.ESTIMATED_COMPLETION_DATE >= $P{date0101})
/* PROGRAMMA DI BILANCIO */
left join WORK_EFFORT_ASSOC WEA7 on WEA7.WORK_EFFORT_ID_TO = OBO.WORK_EFFORT_ID and WEA7.WORK_EFFORT_ASSOC_TYPE_ID = '20D2C'
left join WORK_EFFORT PROB on PROB.WORK_EFFORT_ID = WEA7.WORK_EFFORT_ID_FROM and PROB.WORK_EFFORT_TYPE_ID = '20D24PRO' and PROB.WORK_EFFORT_REVISION_ID is null
	and PROB.ESTIMATED_START_DATE <= $P{date3112} and (PROB.ESTIMATED_COMPLETION_DATE is null or PROB.ESTIMATED_COMPLETION_DATE >= $P{date0101})
/* MISSIONE DI BILANCIO */
left join WORK_EFFORT_ASSOC WEA8 on WEA8.WORK_EFFORT_ID_TO = PROB.WORK_EFFORT_ID and WEA8.WORK_EFFORT_ASSOC_TYPE_ID = '20D2'
left join WORK_EFFORT MISB on MISB.WORK_EFFORT_ID = WEA8.WORK_EFFORT_ID_FROM and MISB.WORK_EFFORT_TYPE_ID = '20D22MIS' and MISB.WORK_EFFORT_REVISION_ID is null
	and MISB.ESTIMATED_START_DATE <= $P{date3112} and (MISB.ESTIMATED_COMPLETION_DATE is null or MISB.ESTIMATED_COMPLETION_DATE >= $P{date0101})
WHERE FIL_W.WORK_EFFORT_TYPE_ID = '20P28STL' and FIL_W.WORK_EFFORT_REVISION_ID is NULL
	and FIL_W.ESTIMATED_START_DATE <= $P{date3112} and (FIL_W.ESTIMATED_COMPLETION_DATE is null or FIL_W.ESTIMATED_COMPLETION_DATE >= $P{date0101})
	and PEG.work_effort_id = $P{workEffortId}
	
    /* START filterWhere */
    $P!{filterWhereString} 
   /* END filterWhere */
	
group by
	FIL_W.SOURCE_REFERENCE_ID,
    FIL_W.WORK_EFFORT_NAME,
    CDR.SOURCE_REFERENCE_ID,
    CDR.WORK_EFFORT_NAME,
    SETT.SOURCE_REFERENCE_ID,
    SETT.WORK_EFFORT_NAME,
    P2.PARTY_NAME,
    PEG.SOURCE_REFERENCE_ID,
    PEG.WORK_EFFORT_NAME,
    PEG.DESCRIPTION,
    WEPT.DESCRIPTION,
    CONCAT(MAND.ETCH, ' - ', MAND.WORK_EFFORT_NAME),
    MON.UOM_DESCR,
    CONCAT(OBS.ETCH, ' - ', OBS.WORK_EFFORT_NAME),
    CONCAT(MISB.ETCH, ' - ', MISB.WORK_EFFORT_NAME),
	CONCAT(PROB.ETCH, ' - ', PROB.WORK_EFFORT_NAME),
	CONCAT(OBO.ETCH, ' - ', OBO.WORK_EFFORT_NAME),
	INDIC.UOM_DESCR,
	INDIC.DESCRIPTION,
	RIS.AMOUNT,
	indic.target,
	indic.cons,
	indic.amount
order by
	SETT.SOURCE_REFERENCE_ID,
	FIL_W.SOURCE_REFERENCE_ID,
	CDR.SOURCE_REFERENCE_ID,
	PEG.SOURCE_REFERENCE_ID]]>
		</queryString>
