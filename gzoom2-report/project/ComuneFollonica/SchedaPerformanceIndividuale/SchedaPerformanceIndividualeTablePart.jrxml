	<subDataset name="Dataset_ObiettiviCollegati" uuid="cf488eb5-16b0-4f9f-944e-554270ecbb00">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.jrdax"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="176"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="818"/>
		<parameter name="personId" class="java.lang.String" isForPrompting="false"/>
		<parameter name="date3112" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilDateTime.getMonthEndFromDatetime("12",$P{REPORT_TIME_ZONE}.getID(),YEAR($P{monitoringDate}), $P{REPORT_LOCALE}.getDefault())]]></defaultValueExpression>
		</parameter>
		<parameter name="date0101" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilDateTime.getMonthStartFromDatetime("1",$P{REPORT_TIME_ZONE}.getID(),YEAR($P{monitoringDate}), $P{REPORT_LOCALE}.getDefault())]]></defaultValueExpression>
		</parameter>
		<parameter name="monitoringDate" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[TODAY( )]]></defaultValueExpression>
		</parameter>
		<parameter name="workEffortId" class="java.lang.String" isForPrompting="false"/>
		<parameter name="date3009" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilDateTime.getMonthEndFromDatetime("9",$P{REPORT_TIME_ZONE}.getID(),YEAR($P{monitoringDate}), $P{REPORT_LOCALE}.getDefault())]]></defaultValueExpression>
		</parameter>
		<parameter name="orgUnitId" class="java.lang.String">
			<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
		</parameter>
		<queryString language="SQL">
			<![CDATA[select sogg.party_id as "personIdObiettiviCollegati",
	sval.work_effort_name as "Nome scheda",
	to_char(sval.estimated_start_date, 'DD/MM/YYYY') as "Data inizio",
	to_char(sval.estimated_completion_date, 'DD/MM/YYYY') as "Data fine",
	matr.parent_role_code as "Matricola soggetto valutato",
	sogg.party_name as "Soggetto valutato",
	ob.etch as "Etichetta tipologia obiettivo",
	ob.obiet as "Raggiungimento tipologia obiettivo",
	ob.assoc_weight as "Peso raggiungimento tipologia obiettivo",
	ob.punteggio as "Punteggio raggiungimento tipologie obiettivi", 
	ob.punteggio_og as "Punteggio originale raggiungimento tipologie obiettivi",
	ob.description as "Commento punteggio raggiungimento tipologie obiettivi",
	ob.etchcoll as "Etichetta obiettivo collegato",
	ob.coll as "Obiettivo collegato",
	ob.peso as "Peso obiettivo collegato",
	ob.amount as "Punteggio obiettivo collegato",
	ob.info1 as "Commento obiettivo collegato",
	ob.work_effort_id as "Id obiettivo collegato",
	ob.description_PEG as "Descrizione PEG",
	ob.cod_cdc as "Codice CDC",
	ob.nome_cdc as "Nome CDC",
	ob.cod_cdr as "Codice CDR",
	ob.nome_cdr as "Nome CDR",
	ob.cod_sett as "Codice SETT",
	ob.nome_sett as "Nome SETT",
	ob.indicatore as "Indicatore",
	ob.indi_work_effort as "Id indicatore",
	ob.UDM as "Unità di misura",
	ob.target "Target",
	ob.consuntivo as "Consuntivo",
	ob.G_UOM_TYPE_ID,
	ob.CONSUNTIVO_AMOUNT,
	ob.TARGET_AMOUNT
	
/* SCHEDA DI VALUTAZIONE */
from work_effort sval
/* UNITA' RESPONSABILE */
join party p on p.party_id = sval.org_unit_id 
join party_parent_role ppr on ppr.party_id = p.party_id
/* SOGGETTO VALUTATO */
join work_effort_party_assignment wepa on wepa.work_effort_id = sval.work_effort_id 
join party sogg on sogg.party_id = wepa.party_id
join party_parent_role matr on matr.party_id = sogg.party_id 
join person pe on pe.party_id = sogg.party_id 
/* RAGGIUNGIMENTO OBIETTIVI */
join work_effort_assoc wea on wea.work_effort_id_from = sval.work_effort_id and wea.work_effort_assoc_type_id = '21VSCH'
join work_effort ragg on ragg.work_effort_id = wea.work_effort_id_to and ragg.work_effort_type_id = '21V2OBI' and ragg.work_effort_revision_id is null
	and ragg.estimated_start_date <= $P{date3112} and (ragg.estimated_completion_date >= $P{date0101}  or ragg.estimated_completion_date is null)
/* OBIETTIVI SOTTOSTANTI */
left join (
	select 
		wea.work_effort_id_from,
		ob.work_effort_name as obiet,
		ob.etch,
		coll.work_effort_id ,
		wea.assoc_weight,
		ris.amount as punteggio, 
		ris.orig_amount punteggio_og,
		ris.description,
		coll.etch as etchcoll,
		coll.work_effort_name as coll,
		coll.description as description_PEG,
		wea2.assoc_weight as peso,
		score.amount,
		note.name1,
		note.info1,
		INDIC.M_UOM_DESCR as Indicatore,
		INDIC.M_work_effort_id as indi_work_Effort,
		-- INDIC.G_ACCOUNT_NAME as UDM,
		INDIC.G_UOM_ABBREVIATION as UDM,
		indic.G_UOM_TYPE_ID,
		indic.CONSUNTIVO,
		indic.CONSUNTIVO_AMOUNT,
		indic.TARGET,
		indic.TARGET_AMOUNT,
		stru.cod_cdc,
		stru.nome_cdc,
		stru.cod_cdr,
		stru.nome_cdr,
		stru.cod_sett,
		stru.nome_sett
	/* OBIETTIVI */
	from work_effort_assoc wea
	join work_effort ob on ob.work_effort_id = wea.work_effort_id_to and ob.work_effort_type_id in ('21V5TIP','21V6TIP')  and ob.work_effort_revision_id is null
		and ob.estimated_start_date <= $P{date3112} and (ob.estimated_completion_date >= $P{date0101}  or ob.estimated_completion_date is null)
	/* RISULTATO RAGGIUNTO */
	left join (
		select 
			wem.work_effort_id,
			ate.amount,
			ate.orig_amount,
			act.description 
		from work_effort_measure wem
		join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id
		join acctg_trans act on act.acctg_trans_id = ate.acctg_trans_id 
	) ris on ris.work_effort_id = ob.work_effort_id
	/* COMMENTO */
	left join (
		select 
			wen.work_effort_id,
			max(case when wen.sequence_id = '100' then nd.note_name else null end) as name1,
			max(case when wen.sequence_id = '100' then nd.note_info else null end) as info1
		from work_effort_note wen
		join note_data nd on nd.note_id = wen.note_id
		group by wen.work_effort_id 
	) note on note.work_effort_id = ob.work_effort_id 
	/* OBIETTIVI COLLEGATI */
	left join work_effort_assoc wea2 on wea2.work_effort_id_from = ob.work_effort_id and wea2.work_effort_assoc_type_id = '21VOBIC'
	left join work_effort coll on coll.work_effort_id = wea2.work_effort_id_to and coll.work_effort_type_id = '20P44OPD' and coll.work_effort_revision_id is null
		and coll.estimated_start_date <= $P{date3112} and (coll.estimated_completion_date >= $P{date0101}  or coll.estimated_completion_date is null)
	/* INDICATORI OBIETTIVO DI PEG */
	left join (
		select 
		v.m_work_effort_id,
	--	v.g_account_name,
		v.m_uom_descr,
       V.G_UOM_TYPE_ID,
        V.G_UOM_ABBREVIATION,
        MAX( CASE WHEN v.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = $P{date3112} THEN V.R_UOM_CODE ELSE NULL END ) CONSUNTIVO,
        MAX( CASE WHEN v.TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = $P{date3112} THEN V.TM_AMOUNT  ELSE NULL END ) CONSUNTIVO_AMOUNT,
        MAX( CASE WHEN v.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = $P{date3112} THEN V.R_UOM_CODE ELSE NULL END ) TARGET,
        MAX( CASE WHEN v.TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND V.TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND V.TT_TRANSACTION_DATE = $P{date3112} THEN V.TM_AMOUNT ELSE NULL END ) TARGET_AMOUNT
		--atekpi.amount 
		from WORK_EFFORT_TRANS_ALL_VIEW V
		join work_effort_purpose_account wepa on wepa.gl_account_id = v.m_gl_account_id and wepa.work_effort_purpose_type_id in ('OBPIND')
		INNER JOIN WORK_EFFORT_TYPE WET ON WET.WORK_EFFORT_TYPE_ID = V.W_WORK_EFFORT_TYPE_ID										
		LEFT JOIN ACCTG_TRANS_VIEW TR ON TR.B_GL_ACCOUNT_ID ='SCOREKPI'										
		  AND TR.B_VOUCHER_REF = V.M_WORK_EFFORT_MEASURE_ID										
		  AND TR.A_TRANSACTION_DATE = V.TT_TRANSACTION_DATE										
		  AND TR.B_GL_FISCAL_TYPE_ID = 'ACTUAL'										
		LEFT JOIN UOM_RANGE_VALUES RV ON TR.B_AMOUNT IS NOT NULL										
		  AND RV.UOM_RANGE_ID = WET.UOM_RANGE_SCORE_ID										
		  AND RV.FROM_VALUE <= TR.B_AMOUNT AND RV.THRU_VALUE >= TR.B_AMOUNT										
		LEFT JOIN CONTENT CO ON RV.ICON_CONTENT_ID IS NOT NULL										
		  AND CO.CONTENT_ID = RV.ICON_CONTENT_ID										
		LEFT JOIN DATA_RESOURCE DR ON CO.DATA_RESOURCE_ID IS NOT NULL										
		  AND DR.DATA_RESOURCE_ID = CO.DATA_RESOURCE_ID	
		where 
		V.M_THRU_DATE >= $P{date0101}
		AND V.M_FROM_DATE <= $P{date3112}
		group by
		v.m_work_effort_id,
		V.M_SEQUENCE_ID,
		V.G_INPUT_ENUM_ID,
		V.G_ACCOUNT_CODE,
		V.M_WORK_EFFORT_MEASURE_ID,
		V.G_ACCOUNT_NAME,
		V.G_DESCRIPTION,
		V.G_UOM_ABBREVIATION,
		V.M_UOM_DESCR,
		V.M_COMMENTS,
		V.G_DETAIL_ENUM_ID,
		-- GESTITO SOLO ACCDET_NULL	
	 	V.G_UOM_TYPE_ID,
		V.G_UOM_DECIMAL_SCALE
	) INDIC on INDIC.M_WORK_EFFORT_ID = COLL.WORK_EFFORT_ID	
		/* CENTRO DI COSTO */
	left join (
		select 
			cdc.org_unit_id,
			cdc.source_reference_id as cod_cdc,
			cdc.work_effort_name as nome_cdc,
			cdr.source_reference_id as cod_cdr,
			cdr.work_effort_name as nome_cdr,
			sett.source_reference_id as cod_sett,
			sett.work_effort_name as nome_sett
		from work_effort cdc 
		/* CENTRO DI RESPONSABILITA' */
		join work_effort_assoc weacdc on weacdc.work_effort_id_to = cdc.work_effort_id and weacdc.work_effort_assoc_type_id = '20P2'
		join work_effort cdr on cdr.work_effort_id = weacdc.work_effort_id_from and cdr.work_effort_type_id = '20P26SSL' and cdr.work_effort_revision_id is null
			and cdr.estimated_start_date <= $P{date3112} and (cdr.estimated_completion_date >= $P{date0101} or cdr.estimated_completion_date is null)
		/* SETTORE */
		join work_effort_assoc weacdr on weacdr.work_effort_id_to = cdr.work_effort_id and weacdr.work_effort_assoc_type_id = '20P2'
		join work_effort sett on sett.work_effort_id = weacdr.work_effort_id_from and sett.work_effort_type_id = '20P24SPL' and sett.work_effort_revision_id is null
			and sett.estimated_start_date <= $P{date3112} and (sett.estimated_completion_date >= $P{date0101} or sett.estimated_completion_date is null)
		where cdc.work_effort_type_id = '20P28STL' and cdc.work_effort_revision_id is null
			and cdc.estimated_start_date <= $P{date3112} and (cdc.estimated_completion_date >= $P{date0101} or cdc.estimated_completion_date is null)
	) stru on stru.org_unit_id = coll.org_unit_id 
		
	/* PUNTEGGIO OBIETTIVI COLLEGATI */
	left join (
		select 
			wem.work_effort_id,
			ate.amount
		from work_effort_measure wem
		join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id
 		join acctg_trans act on act.acctg_trans_id = ate.acctg_trans_id and act.transaction_date = $P{date3112}
		and ate.gl_account_id = 'SCORE'
	) score on score.work_effort_id = coll.work_effort_id 
	where wea.work_effort_assoc_type_id = '21VSCH'
) ob on ob.work_effort_id_from = ragg.work_effort_id
where sval.work_effort_type_id = '21V0SCH' and sval.work_effort_revision_id is null
	and sval.estimated_start_date <= $P{date3112} and (sval.estimated_completion_date >= $P{date0101}  or sval.estimated_completion_date is null)
	and (sogg.party_id = $P{personId} or $P{personId} is null or $P{personId} = '')

order by
	sogg.party_name, ob.etch, ob.etchcoll]]>
		</queryString>
		<field name="personIdObiettiviCollegati" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="personIdObiettiviCollegati"/>
