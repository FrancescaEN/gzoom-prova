	<subDataset name="Dataset_Note" uuid="fe53a93d-8349-48ce-b1ba-0831ae43a4b2">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.jrdax"/>
		<parameter name="workEffortId" class="java.lang.String" isForPrompting="false"/>
		<queryString language="SQL">
			<![CDATA[select nd.NOTE_INFO
from WORK_EFFORT ws
inner join WORK_EFFORT_ASSOC wea on wea.WORK_EFFORT_ID_FROM = ws.WORK_EFFORT_ID and wea.WORK_EFFORT_ASSOC_TYPE_ID = 'TEMPL'
inner join WORK_EFFORT_NOTE wen on wen.WORK_EFFORT_ID = wea.WORK_EFFORT_ID_TO and wen.SEQUENCE_ID = 999
inner join NOTE_DATA nd on nd.NOTE_ID = wen.NOTE_ID 
and TO_CHAR(nd.NOTE_DATE_TIME,'YYYY') = TO_CHAR(ws.ESTIMATED_COMPLETION_DATE,'YYYY')
where ws.WORK_EFFORT_ID = $P{workEffortId}]]>
		</queryString>
		<field name="note_info" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="note_info"/>
			<property name="com.jaspersoft.studio.field.label" value="note_info"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="note_data"/>
		</field>
	</subDataset>
