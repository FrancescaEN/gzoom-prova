		</group>
		<group name="Settore_CdC_CdR_Group">
			<groupExpression><![CDATA["Settore "+$F{Codice SETT}+ " - CdC " +$F{Codice CDC}+ " - CdR " +$F{Codice CDR}]]></groupExpression>
		</group>
		<group name="Etichetta_Obiettivo_Group">
