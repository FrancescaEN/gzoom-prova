		<parameter name="workEffortId" class="java.lang.String" isForPrompting="false"/>
		<parameter name="orgUnitId" class="java.lang.String">
			<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
		</parameter>
		<queryString language="SQL">
			<![CDATA[/* VERSIONE V1.1 SENZA FILTRO SU STRUTTURA 
AGGIUNTA LA COLONNA DEFAULT_UOM_ID */

select 
	sval.work_effort_name as "Nome scheda",
	pe.empl_position_type_id as "Posizione economica",
	to_char(sval.estimated_start_date, 'DD/MM/YYYY') as "Data inizio",
	to_char(sval.estimated_completion_date, 'DD/MM/YYYY') as "Data fine",
	matr.parent_role_code as "Matricola soggetto valutato",
	sogg.party_name as "Soggetto valutato",
	indic.account_name as "Indicatore",
    indic.IndDesc as "Descrizione indicatore",
    case when indic.default_uom_id = 'OTH_V05' then 5 when indic.default_uom_id = 'OTH_V10' then 10 when indic.default_uom_id = 'OTH_V20' then 20
    	else null end as "Unità di misura",
	--indic.kpi_score_weight as "Peso indicatore",
	indic.amount as "Valutazione",
	indic.description as "Commento valutazione"
/* SCHEDA DI VALUTAZIONE */
from work_effort sval
/* UNITA' RESPONSABILE */
join party p on p.party_id = sval.org_unit_id 
join party_parent_role ppr on ppr.party_id = p.party_id
/* SOGGETTO VALUTATO */
join work_effort_party_assignment wepa on wepa.work_effort_id = sval.work_effort_id 
join party sogg on sogg.party_id = wepa.party_id
join party_parent_role matr on matr.party_id = sogg.party_id 
join person pe on pe.party_id = sogg.party_id 
/* VALORI CONDIVISI */
join work_effort_assoc wea2 on wea2.work_effort_id_from = sval.work_effort_id and wea2.work_effort_assoc_type_id = '21VSCH'
join work_effort val on val.work_effort_id = wea2.work_effort_id_to and val.work_effort_type_id = '21V2COM' and val.work_effort_revision_id is null
	and val.estimated_start_date <= $P{date3112} and (val.estimated_completion_date >= $P{date0101} or val.estimated_completion_date is null)
left join (
	select 
		wem.work_effort_id,
		wem.kpi_score_weight,
		ate.amount,
		act.description,
		gl.account_name,
        gl.description as IndDesc,
        gl.default_uom_id 
	from work_effort_measure wem
	join gl_account gl on gl.gl_account_id = wem.gl_account_id 
	left join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id and ate.gl_account_id <> 'SCOREKPI'
	left join acctg_trans act on act.acctg_trans_id = ate.acctg_trans_id
	where wem.gl_account_id <> 'SCORE'
) indic on indic.work_effort_id = val.work_effort_id 
where sval.work_effort_type_id = '21V0SCH' and sval.work_effort_revision_id is null
	and sval.estimated_start_date <= $P{date3112} and (sval.estimated_completion_date >= $P{date0101} or sval.estimated_completion_date is null)
	and (sogg.party_id = $P{personId} or $P{personId} is null or $P{personId} = '')

order by 
	sogg.party_name]]>
		</queryString>
		<field name="Nome scheda" class="java.lang.String">
