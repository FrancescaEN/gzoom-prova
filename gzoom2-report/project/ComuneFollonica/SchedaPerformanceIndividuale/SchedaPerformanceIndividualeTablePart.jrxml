	<parameter name="workEffortId" class="java.lang.String" isForPrompting="false"/>
	<parameter name="date3009" class="java.util.Date" isForPrompting="false">
		<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilDateTime.getMonthEndFromDatetime("9",$P{REPORT_TIME_ZONE}.getID(),YEAR($P{monitoringDate}), $P{REPORT_LOCALE}.getDefault())]]></defaultValueExpression>
	</parameter>
	<parameter name="date3009sql" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc($P{date3009}, $P{odaDialect});]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select 
	sogg.party_id as "personId",
	FIL_W.work_effort_name as "Nome scheda",
	FIL_W.work_effort_id as "Id scheda",
	to_char(FIL_W.estimated_start_date, 'DD/MM/YYYY') as "Data inizio",
	to_char(FIL_W.estimated_completion_date, 'DD/MM/YYYY') as "Data fine",
	matr.parent_role_code as "Matricola soggetto valutato",
	sogg.party_name as "Soggetto valutato",
	pe.empl_position_type_id as "Posizione economica",
	ept.description as "Descrizione Posizione economica",
	ppr.parent_role_code as "Codice unità responsabile",
	p.party_name as "Unità responsabile",
	ppr2.parent_role_code as "Codice CDR",
	p2.party_name as "Nome CDR",
	ppr3.parent_role_code as "Codice Settore",
	p3.party_name as "Nome Settore",
	ppr4.parent_role_code as "Codice Responsabile Settore",
	p4.party_name as "Nome Responsabile Settore",
	--note.name1 as "Nome nota Commenti interessato",
	note.info1 as "Commenti interessato",
	--note.name2 as "Nome nota Commenti responsabile diretto",
	note.info2 as "Commenti responsabile diretto",
	--note.name3 as "Nome nota Commenti dirigente",
	note.info3 as "Commenti dirigente",
	--ragg.work_effort_name as "Raggiungimento obiettivi",
	ate.amount as "Punteggio raggiungimento obiettivi",
	--note_ragg.name1 as "Nome Commento Raggiungimento",
	note_ragg.info1 as "Commento raggiungimento obiettivi",
	--val.work_effort_name as "Nome contributo valori condivisi",
	ate2.amount as "Punteggio valori condivisi",
	--note_val.name1 as "Nome commento Valori condivisi",
	note_val.info1 as "Commento valori condivisi",
	ate3.amount as "Punteggio",
	ate3.orig_amount as "Punteggio originale",
	ate3.description as "Commento punteggio",
	si.sequence_id,
	fatcomp.fatcomp_name as "Fattori compensazione nome",
	fatcomp.fatrid_name as "Fattori riduzione nome",	
	fatcomp.fatcomp as "Fattori compensazione valore",
	fatcomp.fatrid as "Fattori riduzione valore" ,
	fatcomp.fatcomp_desc as "Descrizione fattori compensazione", 
	fatcomp.fatrid_desc as "Descrizione fattori riduzione"
/* SCHEDA DI VALUTAZIONE */
from work_effort FIL_W
/* UNITA' RESPONSABILE */
join party p on p.party_id = FIL_W.org_unit_id 
join party_parent_role ppr on ppr.party_id = p.party_id
/* CENTRO DI RESPONSABILIA' */
join party_relationship pr on pr.party_id_to = p.party_id and pr.party_relationship_type_id = 'GROUP_ROLLUP' and pr.thru_date is null
join party p2 on p2.party_id = pr.party_id_from
join party_parent_role ppr2 on ppr2.party_id = p2.party_id
/* SETTORE */
join party_relationship pr2 on pr2.party_id_to = p2.party_id and pr2.party_relationship_type_id = 'GROUP_ROLLUP' and pr2.thru_date is null 
join party p3 on p3.party_id = pr2.party_id_from
join party_parent_role ppr3 on ppr3.party_id = p3.party_id
/* RESPONSABILE DEL SETTORE */
left join party_relationship pr3 on pr3.party_id_from = p3.party_id
and (PR3.FROM_DATE <= FIL_W.ESTIMATED_COMPLETION_DATE and (PR3.THRU_DATE >= FIL_W.ESTIMATED_COMPLETION_DATE or PR3.THRU_DATE is null))
and pr3.party_relationship_type_id = 'ORG_RESPONSIBLE'
left join party p4 on p4.party_id = pr3.party_id_to
left join party_parent_role ppr4 on ppr4.party_id = p4.party_id
/* SOGGETTO VALUTATO */
join work_effort_party_assignment wepa on wepa.work_effort_id = FIL_W.work_effort_id 
join party sogg on sogg.party_id = wepa.party_id
join party_parent_role matr on matr.party_id = sogg.party_id 
join person pe on pe.party_id = sogg.party_id
join empl_position_type ept on ept.empl_position_type_id = pe.empl_position_type_id 

/* START filterInnerJoin */
   $P!{filterInnerJoinString} 
/* END filterInnerJoin */
/* START filterLeftJoin */
  $P!{filterLeftJoinString} 
/* END filterLeftJoin */
 
/* NOTE */
left join (
	select 
		wen.work_effort_id,
		max(case when wen.sequence_id = '100' then nd.note_name else null end) as name1,
		max(case when wen.sequence_id = '100' then nd.note_info else null end) as info1,
		max(case when wen.sequence_id = '110' then nd.note_name else null end) as name2,
		max(case when wen.sequence_id = '110' then nd.note_info else null end) as info2,
		max(case when wen.sequence_id = '120' then nd.note_name else null end) as name3,
		max(case when wen.sequence_id = '120' then nd.note_info else null end) as info3		
	from work_effort_note wen
	join note_data nd on nd.note_id = wen.note_id
	group by
		wen.work_effort_id 
) note on note.work_effort_id = FIL_W.work_effort_id
/* RAGGIUNGIMENTO OBIETTIVI */
join work_effort_assoc wea on wea.work_effort_id_from = FIL_W.work_effort_id and wea.work_effort_assoc_type_id = '21VSCH'
join work_effort ragg on ragg.work_effort_id = wea.work_effort_id_to and ragg.work_effort_type_id = '21V2OBI' and ragg.work_effort_revision_id is null
	and ragg.estimated_start_date <= $P{date3112} and (ragg.estimated_completion_date >= $P{date0101} or ragg.estimated_completion_date is null)
/* PUNTEGGIO RAGGIUNGIMENTO OBIETTIVI */
left join work_effort_measure wem on wem.work_effort_id = ragg.work_effort_id 
left join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id and ate.gl_account_id = 'SCORE'
/* COMMENTO RAGGIUNGIMENTO OBIETTIVI */
left join (
		select 
			wen.work_effort_id,
			max(case when wen.sequence_id = '100' then nd.note_name else null end) as name1,
			max(case when wen.sequence_id = '100' then nd.note_info else null end) as info1
		from work_effort_note wen
		join note_data nd on nd.note_id = wen.note_id
		group by wen.work_effort_id 
) note_ragg on note_ragg.work_effort_id = ragg.work_effort_id 
/* VALORI CONDIVISI */
join work_effort_assoc wea2 on wea2.work_effort_id_from = FIL_W.work_effort_id and wea2.work_effort_assoc_type_id = '21VSCH'
join work_effort val on val.work_effort_id = wea2.work_effort_id_to and val.work_effort_type_id = '21V2COM' and val.work_effort_revision_id is null
	and val.estimated_start_date <= $P{date3112} and (val.estimated_completion_date >= $P{date0101} or val.estimated_completion_date is null)
/* PUNTEGGIO VALORI CONDIVISI */
left join work_effort_measure wem2 on wem2.work_effort_id = val.work_effort_id and wem2.gl_account_id = 'SCORE'
left join acctg_trans_entry ate2 on ate2.voucher_ref = wem2.work_effort_measure_id 
/* COMMENTO VALORI CONDIVISI */
left join (
		select 
			wen.work_effort_id,
			max(case when wen.sequence_id = '100' then nd.note_name else null end) as name1,
			max(case when wen.sequence_id = '100' then nd.note_info else null end) as info1
		from work_effort_note wen
		join note_data nd on nd.note_id = wen.note_id
		group by wen.work_effort_id 
) note_val on note_val.work_effort_id = val.work_effort_id 
/* PUNTEGGIO SCHEDA */
left join (
	select wem3.work_effort_id,
		ate3.amount,
		ate3.orig_amount,
		act3.description
	from work_effort_measure wem3 
 	join acctg_trans_entry ate3 on ate3.voucher_ref = wem3.work_effort_measure_id and ate3.gl_account_id = 'SCORE'
	join acctg_trans act3 on act3.acctg_trans_id = ate3.acctg_trans_id 
) ate3 on ate3.work_effort_id = FIL_W.work_effort_id 
/*Stato*/
left join status_item si on si.status_id = FIL_W.current_status_id 

/* FATTORI DI COMPENSAZIONE */
left join (
select 
we.work_effort_id,
we.work_effort_name,
max(case when wem.gl_account_id = '10070' then gl.account_name else null end) as fatcomp_name,  
max(case when wem.gl_account_id = '10071' then gl.account_name else null end) as fatrid_name,
max(case when wem.gl_account_id = '10070' then ate.amount else null end) as fatcomp,
max(case when wem.gl_account_id = '10071' then ate.amount else null end) as fatrid,
max(case when wem.gl_account_id = '10070' then act.description else null end) as fatcomp_desc,
max(case when wem.gl_account_id = '10071' then act.description else null end) as fatrid_desc
from work_effort_measure wem
join work_effort we on we.work_effort_id = wem.work_effort_id
join work_effort_purpose_account wepa on wepa.gl_account_id = wem.gl_account_id and wepa.work_effort_purpose_type_id in ('COMRID')
join gl_account gl on gl.gl_account_id = wem.gl_account_id
left join acctg_trans act on act.voucher_ref = wem.work_effort_measure_id and act.transaction_date = $P{date3112}
left join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id and ate.gl_account_id <> 'SCOREKPI'
where act.transaction_date = $P{date3112}
group by 
we.work_effort_id,
we.work_effort_name
) fatcomp on FATCOMP.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID 

where FIL_W.work_effort_type_id = '21V0SCH' and FIL_W.work_effort_revision_id is null
	and FIL_W.estimated_start_date <= $P{date3112} and (FIL_W.estimated_completion_date >= $P{date0101} or FIL_W.estimated_completion_date is null)
	and (sogg.party_id = $P{personId} or $P{personId} is null or $P{personId} = '')
	and (FIL_W.work_effort_id = $P{workEffortId} or $P{workEffortId} is null or $P{workEffortId} = '')
	and (FIL_W.org_unit_id = $P{orgUnitId} or $P{orgUnitId} is null or $P{orgUnitId} = '')
	and ppr2.parent_role_code <> 'Company'
 /* START filterWhere */
 $P!{filterWhereString} 
   /* END filterWhere */	
group by sogg.party_id,
	FIL_W.work_effort_name, 
	FIL_W.work_effort_id,
	to_char(FIL_W.estimated_start_date, 'DD/MM/YYYY'), to_char(FIL_W.estimated_completion_date, 'DD/MM/YYYY'), matr.parent_role_code,
	sogg.party_name, pe.empl_position_type_id, ept.description, ppr.parent_role_code, p.party_name,
	note.info1, note.info2, note.info3, ate.amount, note_ragg.info1, ate2.amount, note_val.info1, ate3.amount, ate3.orig_amount, ate3.description, 
	p2.party_name, ppr2.parent_role_code, p3.party_name, ppr3.parent_role_code, p4.party_name, ppr4.parent_role_code,si.sequence_id ,
	fatcomp.fatcomp_name,
	fatcomp.fatrid_name,	
	fatcomp.fatcomp,
	fatcomp.fatrid,
	fatcomp.fatcomp_desc, 
	fatcomp.fatrid_desc 
order by
	sogg.party_name]]>
	</queryString>
