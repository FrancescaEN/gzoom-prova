                                                                                        <expression name="valueExpr">var target = row["TARGET_CODE"] == null ? '-' : row["TARGET_CODE"];&#13;
				   &#13;
if (row["G_UOM_TYPE_ID"] != 'RATING_SCALE') {&#13;
	target = row["TARGET_AMOUNT"] != null ? Formatter.format(BirtStr.indexOf("%",row["FORMAT"],0) != -1 ? row["TARGET_AMOUNT"]/100 : row["TARGET_AMOUNT"], row["FORMAT"]) : '' ;&#13;
}&#13;
target</expression>
