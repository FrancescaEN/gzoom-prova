            <xml-property name="queryText"><![CDATA[SELECT 
																					
	RI.ETCH AS "RISCHIO_ETCH", 
	RIT.ETCH@langLocale AS "RISCHIO_ETCH_TYPE",
	RI.WORK_EFFORT_NAME@langLocale AS "RISCHIO_NAME",
	RI.WORK_EFFORT_ID AS "RISCHIO_ID",
	RI.DESCRIPTION@langLocale AS "RISCHIO_DESCRI",
	AK.SEQUENCE_NUM	as "RISCHIO_SEQUENCE_NUM",	 																					
	OB.ETCH AS "OBIETTIVO_ETCH",
	OBT.ETCH@langLocale AS "OBIETTIVO_ETCH_TYPE",
	OB.WORK_EFFORT_NAME@langLocale AS "OBIETTIVO_NAME",	
	OB.WORK_EFFORT_ID AS "OBIETTIVO_ID",																									
	MIT.ETCH@langLocale AS "TIPO_MISURA_ETCH",
	WETCMI.ETCH@langLocale AS "INDICATORE_ETCH",
	MI.ETCH AS "MISURA_ETCH", 
	MI.WORK_EFFORT_ID AS "MISURA_ID",
	MI.WORK_EFFORT_NAME@langLocale AS "MISURA_NAME",
	MI.DESCRIPTION@langLocale AS "MISURA_DESCRI",
	RM.SEQUENCE_NUM AS "MISURE_SEQUENCE_NUM",																									
	ND.NOTE_NAME@langLocale AS "NOTE_NAME", 
	ND.NOTE_INFO@langLocale AS "NOTE_INFO",
	P_RES.PARTY_NAME@langLocale AS "RESPONSABILE",
	NDR.NOTE_NAME@langLocale AS "MI_RESP_NOTE_NAME",
	NDR.NOTE_INFO@langLocale AS "MI_RESP_NOTE_INFO",
	WEPT.DESCRIPTION@langLocale AS "MISURA_FINALITA",
	
	-- INDICATORI
	WEM.INPUT_ENUM_ID AS "G_INPUT_ENUM_ID",
	WEM.ACCOUNT_NAME AS "G_ACCOUNT_NAME",
	WEM.UOM_DESCR AS "M_UOM_DESCR",
	UOM.ABBREVIATION AS "UOM_ABBREVIATION",
	UOM.DECIMAL_SCALE AS "UOM_DECIMAL_SCALE",
	UOM.UOM_TYPE_ID AS "G_UOM_TYPE_ID",
	INDICRI.AMOUNT AS "TARGET_AMOUNT",
	O.UOM_CODE AS "TARGET_CODE",
	INDICRI2.AMOUNT AS "TARGET_AMOUNT_PIU_UNO",
	O2.UOM_CODE AS "TARGET_CODE_PIU_UNO",
	INDICRI3.AMOUNT AS "TARGET_AMOUNT_PIU_DUE",
	O3.UOM_CODE AS "TARGET_CODE_PIU_DUE"		
																										
FROM WORK_EFFORT SP 
INNER JOIN WORK_EFFORT_TYPE SPT ON SPT.WORK_EFFORT_TYPE_ID = SP.WORK_EFFORT_TYPE_ID	

-- 	rischio
INNER JOIN WORK_EFFORT_ASSOC AK ON AK.WORK_EFFORT_ID_FROM = SP.WORK_EFFORT_ID																											
	   AND AK.WORK_EFFORT_ASSOC_TYPE_ID = SPT.WORK_EFFORT_ASSOC_TYPE_ID											
INNER JOIN WORK_EFFORT RI ON RI.WORK_EFFORT_ID = AK.WORK_EFFORT_ID_TO
		AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND RI.ESTIMATED_START_DATE <= @date3112 AND RI.ESTIMATED_COMPLETION_DATE >= @date0101))	
INNER JOIN WORK_EFFORT_TYPE RIT ON RIT.WORK_EFFORT_TYPE_ID = RI.WORK_EFFORT_TYPE_ID		


-- misure																											
LEFT OUTER JOIN WORK_EFFORT_ASSOC RM ON RM.WORK_EFFORT_ID_FROM = RI.WORK_EFFORT_ID																											
	AND RM.WORK_EFFORT_ASSOC_TYPE_ID = SPT.WORK_EFFORT_ASSOC_TYPE_ID									
LEFT OUTER JOIN WORK_EFFORT MI ON MI.WORK_EFFORT_ID = RM.WORK_EFFORT_ID_TO
		AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND MI.ESTIMATED_START_DATE <= @date3112 AND MI.ESTIMATED_COMPLETION_DATE >= @date0101))																											
LEFT OUTER JOIN WORK_EFFORT_TYPE MIT ON MIT.WORK_EFFORT_TYPE_ID = MI.WORK_EFFORT_TYPE_ID
LEFT OUTER JOIN WORK_EFFORT_PURPOSE_TYPE WEPT ON WEPT.WORK_EFFORT_PURPOSE_TYPE_ID = MI.WORK_EFFORT_PURPOSE_TYPE_ID
LEFT OUTER JOIN WORK_EFFORT_TYPE_CONTENT WETCMI ON WETCMI.WORK_EFFORT_TYPE_ID = MIT.WORK_EFFORT_TYPE_ID	
  AND WETCMI.CONTENT_ID LIKE '%WEFLD_IND%' AND WETCMI.WORK_EFFORT_PURPOSE_TYPE_ID = 'CORMIS'
  AND WE_TYPE_CONTENT_TYPE_ID = 'FOLDER'

-- obiettivo																										
LEFT OUTER JOIN WORK_EFFORT_ASSOC MO ON MO.WORK_EFFORT_ID_TO = MI.WORK_EFFORT_ID																											
	AND MO.WORK_EFFORT_ASSOC_TYPE_ID LIKE '%AZI'																							
LEFT OUTER JOIN WORK_EFFORT OB ON OB.WORK_EFFORT_ID = MO.WORK_EFFORT_ID_FROM
		AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND OB.ESTIMATED_START_DATE <= @date3112 AND OB.ESTIMATED_COMPLETION_DATE >= @date0101))																												
LEFT OUTER JOIN WORK_EFFORT_TYPE OBT ON OBT.WORK_EFFORT_TYPE_ID = OB.WORK_EFFORT_TYPE_ID	
																											
--  RESPONSABILE
LEFT OUTER JOIN PARTY_RELATIONSHIP PR_RES ON  PR_RES.PARTY_ID_FROM = SP.ORG_UNIT_ID
     AND PR_RES.ROLE_TYPE_ID_FROM = SP.ORG_UNIT_ROLE_TYPE_ID
     AND PR_RES.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
AND (@excludeValidity = 'N' OR (@excludeValidity = 'Y' AND PR_RES.THRU_DATE IS NULL))
AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND(PR_RES.FROM_DATE   <= @monitoringDate AND (PR_RES.THRU_DATE  >= @monitoringDate OR PR_RES.THRU_DATE IS NULL)  )))

LEFT OUTER JOIN PARTY P_RES ON P_RES.PARTY_ID = PR_RES.PARTY_ID_TO

LEFT OUTER JOIN WORK_EFFORT_NOTE MN ON  MN.WORK_EFFORT_ID = MI.WORK_EFFORT_ID
	AND MN.SEQUENCE_ID = '20'
LEFT OUTER JOIN NOTE_DATA ND ON ND.NOTE_ID = MN.NOTE_ID
	AND ( MN.IS_MAIN = 'Y' OR (MN.IS_MAIN <> 'Y' AND ND.NOTE_DATE_TIME = @monitoringDate)	)

LEFT OUTER JOIN WORK_EFFORT_NOTE MN2 ON  MN2.WORK_EFFORT_ID = MI.WORK_EFFORT_ID
	AND MN2.SEQUENCE_ID = '10'
LEFT OUTER JOIN NOTE_DATA NDR ON NDR.NOTE_ID = MN2.NOTE_ID
	AND ( MN2.IS_MAIN = 'Y' OR (MN2.IS_MAIN <> 'Y' AND NDR.NOTE_DATE_TIME = @monitoringDate)	)

-- INDICATORI LEGATI ALLA MISURA

LEFT OUTER JOIN (
  SELECT A.WORK_EFFORT_MEASURE_ID, A.GL_ACCOUNT_ID, A.WORK_EFFORT_ID, 
  B.DEFAULT_UOM_ID, B.INPUT_ENUM_ID,
  B.ACCOUNT_NAME@langLocale AS ACCOUNT_NAME,
  A.UOM_DESCR@langLocale AS UOM_DESCR 
  FROM WORK_EFFORT_MEASURE A
  INNER JOIN GL_ACCOUNT B ON B.GL_ACCOUNT_ID = A.GL_ACCOUNT_ID
  WHERE B.GL_ACCOUNT_TYPE_ID = 'CORMIS'
) WEM ON WEM.WORK_EFFORT_ID = MI.WORK_EFFORT_ID


LEFT OUTER JOIN UOM UOM ON WEM.DEFAULT_UOM_ID = UOM.UOM_ID
LEFT OUTER JOIN (																																				
	SELECT TP.VOUCHER_REF, TP.TRANSACTION_DATE, EP.AMOUNT, EP.CURRENCY_UOM_ID, EP.GL_ACCOUNT_ID																																			
	FROM ACCTG_TRANS TP																																			
	INNER JOIN ACCTG_TRANS_ENTRY EP ON EP.ACCTG_TRANS_ID = TP.ACCTG_TRANS_ID																																		
	WHERE EP.GL_FISCAL_TYPE_ID = 'BUDGET'																												
	) INDICRI ON INDICRI.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID AND INDICRI.TRANSACTION_DATE = @date3112
	AND INDICRI.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID
	
LEFT OUTER JOIN (																																				
	SELECT TP2.VOUCHER_REF, TP2.TRANSACTION_DATE, EP2.AMOUNT, EP2.CURRENCY_UOM_ID, EP2.GL_ACCOUNT_ID																																			
	FROM ACCTG_TRANS TP2																																			
	INNER JOIN ACCTG_TRANS_ENTRY EP2 ON EP2.ACCTG_TRANS_ID = TP2.ACCTG_TRANS_ID																																		
	WHERE EP2.GL_FISCAL_TYPE_ID = 'BUDGET' AND TP2.TRANSACTION_DATE = @dateP1																											
	) INDICRI2 ON INDICRI2.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID AND INDICRI2.TRANSACTION_DATE = @dateP1
	AND INDICRI2.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID	
	 
LEFT OUTER JOIN ( 																																				
	SELECT TP3.VOUCHER_REF, TP3.TRANSACTION_DATE, EP3.AMOUNT, EP3.CURRENCY_UOM_ID, EP3.GL_ACCOUNT_ID																																			
	FROM ACCTG_TRANS TP3																																			
	INNER JOIN ACCTG_TRANS_ENTRY EP3 ON EP3.ACCTG_TRANS_ID = TP3.ACCTG_TRANS_ID																																		
	WHERE EP3.GL_FISCAL_TYPE_ID = 'BUDGET' AND TP3.TRANSACTION_DATE = @dateP2																												
	) INDICRI3 ON INDICRI3.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID AND INDICRI3.TRANSACTION_DATE = @dateP2
	AND INDICRI3.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID	
	   
LEFT OUTER JOIN WORK_EFFORT_MEAS_RAT_SC O ON WEM.WORK_EFFORT_MEASURE_ID = O.WORK_EFFORT_MEASURE_ID
    AND O.UOM_ID = INDICRI.CURRENCY_UOM_ID AND O.UOM_RATING_VALUE = INDICRI.AMOUNT
				
LEFT OUTER JOIN WORK_EFFORT_MEAS_RAT_SC O2 ON WEM.WORK_EFFORT_MEASURE_ID = O2.WORK_EFFORT_MEASURE_ID
    AND O2.UOM_ID = INDICRI2.CURRENCY_UOM_ID AND O2.UOM_RATING_VALUE = INDICRI2.AMOUNT
    
LEFT OUTER JOIN WORK_EFFORT_MEAS_RAT_SC O3 ON WEM.WORK_EFFORT_MEASURE_ID = O3.WORK_EFFORT_MEASURE_ID
    AND O3.UOM_ID = INDICRI3.CURRENCY_UOM_ID AND O3.UOM_RATING_VALUE = INDICRI3.AMOUNT    				
WHERE SP.WORK_EFFORT_ID = ? ]]></xml-property>
