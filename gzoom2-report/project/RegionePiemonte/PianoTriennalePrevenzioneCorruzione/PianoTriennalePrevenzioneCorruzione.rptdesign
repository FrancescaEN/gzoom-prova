        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="RelazioniDS" id="52982">
            <list-property name="computedColumns">
                <structure>
                    <property name="name">ETCH_TITOLO</property>
                    <expression name="expression">row["FROM_ETCH"] != null &amp;&amp; row["FROM_ETCH"] != '' ? row["FROM_ETCH"]+' - '+row["FROM_NAME"] : row["FROM_NAME"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">COUNT</property>
                    <property name="dataType">integer</property>
                    <property name="aggregateFunction">COUNT</property>
                </structure>
            </list-property>
            <list-property name="columnHints"/>
            <list-property name="parameters">
                <structure>
                    <property name="name">workEffortId</property>
                    <property name="nativeName"></property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">0</property>
                    <property name="position">1</property>
                    <expression name="defaultValue" type="constant">N/A</expression>
                    <property name="isOptional">false</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">CONTENT_ID</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">ETCH</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">FROM_ETCH</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">4</property>
                        <property name="name">FROM_NAME</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">5</property>
                        <property name="name">ETCH_TITOLO</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">6</property>
                        <property name="name">COUNT</property>
                        <property name="dataType">integer</property>
                    </structure>
                </list-property>
            </structure>
            <method name="beforeOpen"><![CDATA[this.queryText = this.queryText.replace("@langLocale",  params["langLocale"].value);
//this.queryText = this.queryText.replace("@langLocale",  "");]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">CONTENT_ID</property>
                    <property name="nativeName">CONTENT_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">ETCH</property>
                    <property name="nativeName">ETCH</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">FROM_ETCH</property>
                    <property name="nativeName">FROM_ETCH</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">FROM_NAME</property>
                    <property name="nativeName">FROM_NAME</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
     WC.CONTENT_ID AS "CONTENT_ID", WC.ETCH@langLocale AS "ETCH", WEA.WE_FROM_ETCH AS "FROM_ETCH", WEA.WE_FROM_NAME@langLocale AS "FROM_NAME"
FROM WORK_EFFORT WE
INNER JOIN work_effort_type_content WC ON WC.WORK_EFFORT_TYPE_ID = WE.WORK_EFFORT_TYPE_ID AND WC.WE_TYPE_CONTENT_TYPE_ID = 'FOLDER' AND WC.CONTENT_ID LIKE 'WEFLD_WET%'
INNER JOIN work_effort_type_assoc WA ON WA.WORK_EFFORT_TYPE_ID = WC.WORK_EFFORT_TYPE_ID AND WA.CONTENT_ID = WC.CONTENT_ID
LEFT JOIN WORK_EFFORT_ASSOC_VIEW WEA ON WEA.WE_TO_ID = WE.WORK_EFFORT_ID AND WEA.WE_FROM_TYPE_ID = WA.WORK_EFFORT_TYPE_ID_REF
INNER JOIN WORK_EFFORT_TYPE WT ON WT.WORK_EFFORT_TYPE_ID = WEA.WE_FROM_TYPE_ID
WHERE WE.WORK_EFFORT_ID = ? AND WT.PARENT_TYPE_ID = 'CTX_PR'
]]></xml-property>
        </oda-data-set>
