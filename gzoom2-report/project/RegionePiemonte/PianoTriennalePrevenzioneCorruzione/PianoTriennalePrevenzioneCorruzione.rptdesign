                    <property name="nativeName">ETHC_PROC</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">LIV_0</property>
                    <property name="nativeName">LIV_0</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
