            <method name="beforeOpen"><![CDATA[this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );			
//this.queryText = this.queryText.replace("@date3112",  "'2019-12-31 00:00:00.000'" );

this.queryText = this.queryText.replace("@langLocale",  params["langLocale"].value);
//this.queryText = this.queryText.replace("@langLocale",  "");

//ReportLog.info("......this.queryText scoreDS "+this.queryText);]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">AMOUNT</property>
                    <property name="nativeName">AMOUNT</property>
                    <property name="dataType">float</property>
                    <property name="nativeDataType">8</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">COMMENTS</property>
                    <property name="nativeName">COMMENTS</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">OBJECT_INFO</property>
                    <property name="nativeName">OBJECT_INFO</property>
                    <property name="dataType">string</property>
