                    <property name="name">FINALITA_SOTTOPROCESSO</property>
                    <expression name="expression">if (row["FINALITA_SOTTOPROC"] != null &amp;&amp; row["FINALITA_SOTTOPROC"] != '' &amp;&amp; BirtStr.indexOf('.',row["FINALITA_SOTTOPROC"],0) >= 0) {&#13;
