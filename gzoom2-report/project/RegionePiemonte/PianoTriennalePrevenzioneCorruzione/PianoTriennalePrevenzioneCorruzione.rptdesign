                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT WE_AREA.WORK_EFFORT_NAME@langLocale AS "WORK_EFFORT_NAME",
COUNT(*) AS "NUM_PROC",
WT.ETCH@langLocale AS "ETHC_PROC",
SUM(CASE WHEN VP.RANGE_VALUES_FACTOR = 0 THEN 1 ELSE 0 END) AS "LIV_0",
SUM(CASE WHEN VP.RANGE_VALUES_FACTOR = 25 THEN 1 ELSE 0 END) AS "LIV_25",
SUM(CASE WHEN VP.RANGE_VALUES_FACTOR = 30 THEN 1 ELSE 0 END) AS "LIV_33",
SUM(CASE WHEN VP.RANGE_VALUES_FACTOR = 50 THEN 1 ELSE 0 END) AS "LIV_50",
SUM(CASE WHEN VP.RANGE_VALUES_FACTOR = 60 THEN 1 ELSE 0 END) AS "LIV_67",
SUM(CASE WHEN VP.RANGE_VALUES_FACTOR = 75 THEN 1 ELSE 0 END) AS "LIV_75",
SUM(CASE WHEN VP.RANGE_VALUES_FACTOR = 100 THEN 1 ELSE 0 END) AS "LIV_100"
FROM WORK_EFFORT FIL_W
@filterInnerJoin
@filterLeftJoin	
INNER JOIN WORK_EFFORT_ASSOC WEA ON FIL_W.WORK_EFFORT_ID=WEA.WORK_EFFORT_ID_TO
INNER JOIN WORK_EFFORT WE_SUB ON WEA.WORK_EFFORT_ID_FROM=WE_SUB.WORK_EFFORT_ID
INNER JOIN WORK_EFFORT_ASSOC WEA_2 ON WEA_2.WORK_EFFORT_ID_TO = WE_SUB.WORK_EFFORT_ID
INNER JOIN WORK_EFFORT WE_AREA ON WEA_2.WORK_EFFORT_ID_FROM = WE_AREA.WORK_EFFORT_ID
INNER JOIN WORK_EFFORT_MEASURE WM ON WM.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID AND WM.GL_ACCOUNT_ID = 'SCORE'
INNER JOIN WORK_EFFORT_TYPE WT ON WT.WORK_EFFORT_TYPE_ID = FIL_W.WORK_EFFORT_TYPE_ID
	
INNER JOIN ACCTG_TRANS_ENTRY EP ON EP.VOUCHER_REF = WM.WORK_EFFORT_MEASURE_ID AND EP.GL_FISCAL_TYPE_ID = 'CORRIS'
INNER JOIN ACCTG_TRANS TP ON TP.ACCTG_TRANS_ID = EP.ACCTG_TRANS_ID AND TP.TRANSACTION_DATE = @date3112																						
INNER JOIN UOM_RANGE_VALUES VP ON VP.UOM_RANGE_ID = WT.UOM_RANGE_SCORE_ID																											
		AND VP.FROM_VALUE <= EP.AMOUNT AND VP.THRU_VALUE >= EP.AMOUNT	
INNER JOIN UOM_RANGE UR ON VP.UOM_RANGE_ID = UR.UOM_RANGE_ID		
WHERE FIL_W.WORK_EFFORT_TYPE_ID='15AP3PRO' AND WE_SUB.WORK_EFFORT_TYPE_ID='15AP2SAR' AND WE_AREA.WORK_EFFORT_TYPE_ID='15AP1ARE'
AND FIL_W.WORK_EFFORT_REVISION_ID IS NULL AND WE_SUB.WORK_EFFORT_REVISION_ID IS NULL AND WE_AREA.WORK_EFFORT_REVISION_ID IS NULL 
AND EXISTS (SELECT 1 FROM WORK_EFFORT_ASSOC WA INNER JOIN WORK_EFFORT RIS ON RIS.WORK_EFFORT_ID = WA.WORK_EFFORT_ID_TO 
				INNER JOIN WORK_EFFORT_ASSOC WAM ON WAM.WORK_EFFORT_ID_FROM = RIS.WORK_EFFORT_ID 
				INNER JOIN WORK_EFFORT MIS ON MIS.WORK_EFFORT_ID = WAM.WORK_EFFORT_ID_TO 
				WHERE WA.WORK_EFFORT_ID_FROM = FIL_W.WORK_EFFORT_ID AND RIS.WORK_EFFORT_TYPE_ID = '15AP4RIS'
				AND MIS.WORK_EFFORT_TYPE_ID LIKE '15AP5M%') 
@filterWhere
@orgUnitId
@workEffortId
AND WE_AREA.WORK_EFFORT_ID = ?
GROUP BY  WE_AREA.WORK_EFFORT_NAME@langLocale,WT.ETCH@langLocale

]]></xml-property>
