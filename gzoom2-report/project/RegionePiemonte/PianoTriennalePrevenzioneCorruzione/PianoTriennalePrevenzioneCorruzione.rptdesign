                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT
	VP.COMMENTS@langLocale AS "FASCIA_VALORE",
	VP.UOM_RANGE_VALUES_ID AS "FASCIA_VALORE_ID",
	VP.RANGE_VALUES_FACTOR AS "COEFFICIENTE"
FROM
	WORK_EFFORT FIL_W
INNER JOIN WORK_EFFORT_TYPE WT ON
	WT.WORK_EFFORT_TYPE_ID = FIL_W.WORK_EFFORT_TYPE_ID
INNER JOIN UOM_RANGE_VALUES VP ON
	VP.UOM_RANGE_ID = WT.UOM_RANGE_SCORE_ID
WHERE
	FIL_W.WORK_EFFORT_TYPE_ID = '15AP3PRO'
GROUP BY
	VP.COMMENTS@langLocale,
	VP.UOM_RANGE_VALUES_ID, 
	VP.RANGE_VALUES_FACTOR ]]></xml-property>
