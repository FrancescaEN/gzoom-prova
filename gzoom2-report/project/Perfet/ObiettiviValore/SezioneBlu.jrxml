	<group name="GruppoIdStrategia">
		<groupExpression><![CDATA[$F{ID Strategia}]]></groupExpression>
		<groupHeader>
			<band height="95" splitType="Stretch">
				<property name="com.jaspersoft.studio.unit.height" value="px"/>
				<frame>
					<reportElement positionType="Float" x="0" y="20" width="1151" height="15" uuid="32d5b5fd-4046-4dc9-9108-16b02943793b"/>
					<textField textAdjust="StretchHeight">
