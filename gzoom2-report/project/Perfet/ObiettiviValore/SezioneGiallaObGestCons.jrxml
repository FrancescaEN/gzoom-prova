	<queryString language="SQL">
		<![CDATA[select 
	obg.work_effort_id as "ID Obiettivo Gestionale",
	obg.etch as "Etichetta Obiettivo Gestionale",
	obg.work_effort_name as "Nome Obiettivo Gestionale",
	obg.estimated_start_date as "Data inizio",
	obg.estimated_completion_date as "Data fine",
	ppr.parent_role_code as "Codice struttura responsabile",
	p.party_name as "Struttura responsabile",
	nd.note_info as "Descrizione",
	case when gl.debit_credit_default = 'D' then '+' else '-' end as "Polarità",
	gl.gl_account_id as "ID Indicatore",
	gl.account_name as "Indicatore",
	gl.description as "Formula",
	u.uom_type_id as "Tipo indicatore",
	u.abbreviation as "UDM",
	wem.kpi_score_weight as "Peso",
	gl.source as "Fonte",
	val.target_q1_valore, val.target_q1_stringa, val.consuntivo_q1_valore, val.consuntivo_q1_stringa,
	val.target_q2_valore, val.target_q2_stringa, val.consuntivo_q2_valore, val.consuntivo_q2_stringa,
	val.target_q3_valore, val.target_q3_stringa, val.consuntivo_q3_valore, val.consuntivo_q3_stringa,
	ROW_NUMBER() OVER (PARTITION BY obg.work_effort_id ORDER BY wem.sequence_id,wem.work_effort_measure_id) as "Progressivo"
/* OBIETTIVO GESTIONALE */
from work_effort obg
/* STRUTTURA RESPONSABILE */
join party p on p.party_id = obg.org_unit_id 
join party_parent_role ppr on ppr.party_id = p.party_id 
/* DESCRIZIONE */
join work_effort_note wen on wen.work_effort_id = obg.work_effort_id and wen.sequence_id = 10
join note_data nd on nd.note_id = wen.note_id
/* INDICATORI */
left join work_effort_measure wem on wem.work_effort_id = obg.work_effort_id and wem.gl_account_id <> 'SCORE' and wem.gl_account_id <> 'SAL03'
left join gl_account gl on gl.gl_account_id = wem.gl_account_id 
left join uom u on u.uom_id = gl.default_uom_id 
/* VALORI INDICATORI */
left join (
	select 
		ate.gl_account_id,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and act.transaction_date = $P{date3004} then ate.amount else null end) as target_q1_valore,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and act.transaction_date = $P{date3108} then ate.amount else null end) as target_q2_valore,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and act.transaction_date = $P{date3112} then ate.amount else null end) as target_q3_valore,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and act.transaction_date = $P{date3004} then ate.amount else null end) as consuntivo_q1_valore,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and act.transaction_date = $P{date3108} then ate.amount else null end) as consuntivo_q2_valore,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and act.transaction_date = $P{date3112} then ate.amount else null end) as consuntivo_q3_valore,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and act.transaction_date = $P{date3004} then gamrs.uom_descr else null end) as target_q1_stringa,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and act.transaction_date = $P{date3108} then gamrs.uom_descr else null end) as target_q2_stringa,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and act.transaction_date = $P{date3112} then gamrs.uom_descr else null end) as target_q3_stringa,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and act.transaction_date = $P{date3004} then gamrs.uom_descr else null end) as consuntivo_q1_stringa,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and act.transaction_date = $P{date3108} then gamrs.uom_descr else null end) as consuntivo_q2_stringa,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and act.transaction_date = $P{date3112} then gamrs.uom_descr else null end) as consuntivo_q3_stringa
	from acctg_trans_entry ate
	join acctg_trans act on act.acctg_trans_id = ate.acctg_trans_id
	left join gl_account_meas_rat_sc gamrs on gamrs.gl_account_id = ate.gl_account_id and gamrs.uom_rating_value = ate.amount
	where ate.gl_account_id not like 'SCORE%'
	group by
		ate.gl_account_id
) val on val.gl_account_id = wem.gl_account_id 
where obg.work_effort_type_id = '23R82OBG' and obg.work_effort_parent_id =  $P{idPerf} /* ID PERF PASSATO DA SOPRA */
order by obg.etch]]>
	</queryString>
