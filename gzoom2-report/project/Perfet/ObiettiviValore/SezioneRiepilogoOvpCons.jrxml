	<parameter name="idOvp" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select
	ovp.work_effort_id as "ID Obiettivo di Valore Pubblico",
	ovp.work_effort_name as "Obiettivo di Valore Pubblico",
	ovp.etch as "Etichetta Obiettivo di Valore Pubblico",
	nd.note_info as "Valore pubblico atteso",
	score.score_baseline,
	score.score_target,
	score.score_consuntivo,
	score.score_target_p1,
	score.score_target_p2,
	note.forza, note.debolezza, note.opp, note.minacce
/* OBIETTIVO VALORE PUBBLICO */
from work_effort ovp
/* VALORE PUBBLICO ATTESO */
join work_effort_note wen on wen.work_effort_id = ovp.work_effort_id and wen.sequence_id = 110
join note_data nd on nd.note_id = wen.note_id
/* SCORE */
left join (
	select
		wem.work_effort_id,
		max(case when ate.gl_fiscal_type_id = 'BASELINE' and extract(year from act.transaction_date) = $P{YEAR} then ate.amount else null end) as score_baseline,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEAR} then ate.amount else null end) as score_target,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEAR} then ate.amount else null end) as score_consuntivo,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP1} then ate.amount else null end) as score_target_p1,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP2} then ate.amount else null end) as score_target_p2
	from work_effort_measure wem
	left join acctg_trans act on act.voucher_ref = wem.work_effort_measure_id
	left join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id and ate.gl_account_id = 'SCORE'
	where wem.gl_account_id = 'SCORE'
	group by
		wem.work_effort_id
) score on score.work_effort_id = ovp.work_effort_id
/* VALORE PUBBLICO DI ENTE */
join work_effort_assoc wea on wea.work_effort_id_to = ovp.work_effort_id and wea.work_effort_assoc_type_id = '23R6C'
join work_effort ente on ente.work_effort_id = wea.work_effort_id_from
/* NOTE ANALISI */
left join (
	select
		wen.work_effort_id,
		max(case when wen.sequence_id = 110 then nd.note_info else null end) as forza,
		max(case when wen.sequence_id = 120 then nd.note_info else null end) as debolezza,
		max(case when wen.sequence_id = 130 then nd.note_info else null end) as opp,
		max(case when wen.sequence_id = 140 then nd.note_info else null end) as minacce
	from work_effort_note wen
	join note_data nd on nd.note_id = wen.note_id
	group by
		wen.work_effort_id
) note on note.work_effort_id = ente.work_effort_id
where ovp.work_effort_id = $P{idOvp} /* passato dalla query sopra */]]>
	</queryString>
