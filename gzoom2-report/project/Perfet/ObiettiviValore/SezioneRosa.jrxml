	<subDataset name="DatasetIndicatori" uuid="1248eb68-4806-4d07-9d00-e584289f92ba">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="gzoom_mur_DEMO"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="idMisura" class="java.lang.String"/>
		<parameter name="YEAR" class="java.lang.Integer"/>
		<parameter name="YEARM2" class="java.lang.Integer">
			<defaultValueExpression><![CDATA[$P{YEAR}-2]]></defaultValueExpression>
		</parameter>
		<parameter name="YEARM1" class="java.lang.Integer">
			<defaultValueExpression><![CDATA[$P{YEAR}-1]]></defaultValueExpression>
		</parameter>
		<parameter name="YEARP1" class="java.lang.Integer">
			<defaultValueExpression><![CDATA[$P{YEAR}+1]]></defaultValueExpression>
		</parameter>
		<parameter name="YEARP2" class="java.lang.Integer">
			<defaultValueExpression><![CDATA[$P{YEAR}+2]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select 
	mis.work_effort_id as "ID Misura",
	wem.work_effort_measure_id as "ID indicatore su scheda",
	gl.gl_account_id as "ID indicatore",
	u.abbreviation as "Unità di misura",
	u.uom_type_id as "Tipo indicatore",
	wem.uom_descr as "Descrizione",
	wem."comments" as "Fonte del dato",
	baseline_valore, baseline_stringa, baseline_commento,
	consuntivo_m2_valore, consuntivo_m2_stringa, consuntivo_m2_commento,
	preconsuntivo_m1_valore, preconsuntivo_m1_stringa, preconsuntivo_m1_commento,
	target_valore, target_stringa, target_commento,
	target_p1_valore, target_p1_stringa, target_p1_commento,
	target_p2_valore, target_p2_stringa, target_p2_commento
/* MISURA */
from work_effort mis
/* INDICATORE */
join work_effort_measure wem on wem.work_effort_id = mis.work_effort_id and wem.gl_account_id not like 'SCORE%'
join gl_account gl on gl.gl_account_id = wem.gl_account_id
join uom u on u.uom_id = gl.default_uom_id
/* VALORI INDICATORE */
left join (
	select 
		act.voucher_ref,
		max(case when ate.gl_fiscal_type_id = 'BASELINE' and extract(year from act.transaction_date) = 2022 then ate.amount else null end) as baseline_valore,
		max(case when ate.gl_fiscal_type_id = 'BASELINE' and extract(year from act.transaction_date) = 2022 then gamrs.uom_descr else null end) as baseline_stringa,
		max(case when ate.gl_fiscal_type_id = 'BASELINE' and extract(year from act.transaction_date) = 2022 then act.description else null end) as baseline_commento,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEARM2}  then ate.amount else null end) as consuntivo_m2_valore,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEARM2}  then gamrs.uom_descr else null end) as consuntivo_m2_stringa,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEARM2}  then act.description else null end) as consuntivo_m2_commento,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEARM1}  then ate.amount else null end) as preconsuntivo_m1_valore,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEARM1}  then gamrs.uom_descr else null end) as preconsuntivo_m1_stringa,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEARM1}  then act.description else null end) as preconsuntivo_m1_commento,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEAR}  then ate.amount else null end) as target_valore,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEAR}  then gamrs.uom_descr else null end) as target_stringa,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEAR}  then act.description else null end) as target_commento,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP1}  then ate.amount else null end) as target_p1_valore,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP1}  then gamrs.uom_descr else null end) as target_p1_stringa,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP1}  then act.description else null end) as target_p1_commento,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP2}  then ate.amount else null end) as target_p2_valore,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP2}  then gamrs.uom_descr else null end) as target_p2_stringa,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP2}  then act.description else null end) as target_p2_commento
	from acctg_trans act
	join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id and ate.gl_account_id not like 'SCORE%'
	left join gl_account_meas_rat_sc gamrs on gamrs.gl_account_id = ate.gl_account_id and ate.amount = gamrs.uom_rating_value 
	group by
		act.voucher_ref
) val on val.voucher_ref = wem.work_effort_measure_id 
where  mis.work_effort_id =  $P{idMisura} 
and mis.work_effort_type_id = '24A48MIS' and mis.work_effort_revision_id is null]]>
		</queryString>
