	<subDataset name="DatasetTabella" uuid="113a7bf4-aec7-4962-89c4-18e2923ed40c">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="gzoom_mur_DEMO"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="idMisura" class="java.lang.String"/>
		<parameter name="YEAR" class="java.lang.Integer"/>
		<parameter name="YEARM2" class="java.lang.Integer">
			<defaultValueExpression><![CDATA[$P{YEAR}-2]]></defaultValueExpression>
		</parameter>
		<parameter name="YEARM1" class="java.lang.Integer">
			<defaultValueExpression><![CDATA[$P{YEAR}-1]]></defaultValueExpression>
		</parameter>
		<parameter name="YEARP1" class="java.lang.Integer">
			<defaultValueExpression><![CDATA[$P{YEAR}+1]]></defaultValueExpression>
		</parameter>
		<parameter name="YEARP2" class="java.lang.Integer">
			<defaultValueExpression><![CDATA[$P{YEAR}+2]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select 
    mis.work_effort_id as "Id Misura",
	mis.work_effort_name as "Nome misura",
	mis.etch as "Etichetta misura",
	obp.lista as "Obiettivi di Performance",
	ndmis.note_info as "Responsabile misura",
	wept.description as "Tipologia misura",
	ris.work_effort_id as "Id Rischio",
	ris.work_effort_name as "Nome rischio"
	/* RISCHI */
from work_effort_assoc wea3 
 join work_effort ris on ris.work_effort_id = wea3.work_effort_id_to
	and ris.work_effort_type_id = '24A46RIS' and ris.work_effort_revision_id is null
	/* MISURE */
join work_effort_assoc wea4 on wea4.work_effort_id_from = ris.work_effort_id and wea4.work_effort_assoc_type_id = '24APPRO'
join work_effort mis on mis.work_effort_id = wea4.work_effort_id_to
	and mis.work_effort_type_id = '24A48MIS' and mis.work_effort_revision_id is null
/* RESPONSABILE MISURA */
left join work_effort_note wenmis on wenmis.work_effort_id = mis.work_effort_id and wenmis.sequence_id = 100
left join note_data ndmis on ndmis.note_id = wenmis.note_id 
/* TIPOLOGIA MISURA */
left join work_effort_purpose_type wept on wept.work_effort_purpose_type_id = mis.work_effort_purpose_type_id 
/* OBIETTIVO DI PERFORMANCE */
join (
	select 
		wea.work_effort_id_to,
		string_agg(concat(obp.etch, ' - ', obp.work_effort_name), '

' order by obp.etch) as lista
	from work_effort_assoc wea 
	join work_effort obp on obp.work_effort_id = wea.work_effort_id_from and obp.work_effort_revision_id is null and obp.work_effort_type_id = '23R82OBA'
	where wea.work_effort_assoc_type_id = '23R4'
	group by
		wea.work_effort_id_to 
) obp on obp.work_effort_id_to = mis.work_effort_id 
where mis.work_effort_id= $P{idMisura}  and wea3.work_effort_assoc_type_id = '24APPRO']]>
		</queryString>
		<field name="Id Misura" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Id Misura"/>
			<property name="com.jaspersoft.studio.field.label" value="Id Misura"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort"/>
		</field>
		<field name="Nome misura" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Nome misura"/>
			<property name="com.jaspersoft.studio.field.label" value="Nome misura"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort"/>
		</field>
		<field name="Obiettivi di Performance" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Obiettivi di Performance"/>
			<property name="com.jaspersoft.studio.field.label" value="Obiettivi di Performance"/>
		</field>
		<field name="Responsabile misura" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Responsabile misura"/>
			<property name="com.jaspersoft.studio.field.label" value="Responsabile misura"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="note_data"/>
		</field>
		<field name="Tipologia misura" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Tipologia misura"/>
			<property name="com.jaspersoft.studio.field.label" value="Tipologia misura"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort_purpose_type"/>
		</field>
		<field name="Id Rischio" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Id Rischio"/>
			<property name="com.jaspersoft.studio.field.label" value="Id Rischio"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort"/>
		</field>
		<field name="Nome rischio" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Nome rischio"/>
			<property name="com.jaspersoft.studio.field.label" value="Nome rischio"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort"/>
		</field>
		<field name="Etichetta misura" class="java.lang.String"/>
		<group name="GroupMisura">
			<groupExpression><![CDATA[$F{Id Misura}]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="DatasetTabellaColorata" uuid="015e6362-88bd-4ecf-a919-e3037972219e">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="gzoom_mur_DEMO"/>
		<parameter name="idProcesso" class="java.lang.String"/>
		<queryString language="SQL">
			<![CDATA[select
	perf.lista,
	ris.work_effort_id as "ID Rischio",
	ris.work_effort_name as "Evento rischioso",
	val.p1,	val.p2,	val.p3,	val.p4, val.p, 	val.i1,	val.i2,	val.i3,	val.i4,	val.i,	val.c1,	val.c2,	val.c3,	val.c4,	val.c,
	val.livello, val.valutazione,
	nd.note_info as "Motivazione"
from work_effort ris
join work_effort proc on proc.work_effort_id=ris.work_effort_parent_id
/* INDICATORI */
join (
	select
		wem.work_effort_id,
		max(case when ate.gl_account_id = 'MP10221' then ate.amount else null end) as P1,
		max(case when ate.gl_account_id = 'MP10222' then ate.amount else null end) as P2,
		max(case when ate.gl_account_id = 'MP10223' then ate.amount else null end) as P3,
		max(case when ate.gl_account_id = 'MP10224' then ate.amount else null end) as P4,
		max(case when ate.gl_account_id = 'MP10226' then ate.amount else null end) as P,
		max(case when ate.gl_account_id = 'MP10227' then ate.amount else null end) as I1,
		max(case when ate.gl_account_id = 'MP10228' then ate.amount else null end) as I2,
		max(case when ate.gl_account_id = 'MP10229' then ate.amount else null end) as I3,
		max(case when ate.gl_account_id = 'MP10230' then ate.amount else null end) as I4,
		max(case when ate.gl_account_id = 'MP10231' then ate.amount else null end) as I,
		max(case when ate.gl_account_id = 'MP10232' then ate.amount else null end) as C1,
		max(case when ate.gl_account_id = 'MP10233' then ate.amount else null end) as C2,
		max(case when ate.gl_account_id = 'MP10234' then ate.amount else null end) as C3,
		max(case when ate.gl_account_id = 'MP10225' then ate.amount else null end) as C4,
		max(case when ate.gl_account_id = 'MP10235' then ate.amount else null end) as C,
		max(case when ate.gl_account_id = 'MP10236' then ate.amount else null end) as Livello,
		max(case when ate.gl_account_id = 'MP10237' then wemrs.uom_descr  else null end) as Valutazione
	from work_effort_measure wem
	left join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id
	left join work_effort_meas_rat_sc wemrs on wemrs.work_effort_measure_id = ate.voucher_ref and wemrs.uom_rating_value = ate.amount
	where ate.gl_account_id not like 'SCORE%'
	group by
		wem.work_effort_id
) val on val.work_effort_id = ris.work_effort_id
/* MOTIVAZIONE */
join work_effort_note wen on wen.work_effort_id = ris.work_effort_id and wen.sequence_id = 400
join note_data nd on nd.note_id = wen.note_id
/* ELENCO OBIETTIVI DI PERFORMANCE */
left join (
	select
		wea.work_effort_id_from,
		string_agg(distinct concat(ob.etch, ' - ', ob.work_effort_name), '
			
') as lista
	from work_effort_assoc wea
	join work_effort mis on mis.work_effort_id = wea.work_effort_id_to and mis.work_effort_type_id = '24A48MIS' and mis.work_effort_revision_id is null
	join (
		select
			wea2.work_effort_id_to,
			perf.etch,
			perf.work_effort_name
		from work_effort_assoc wea2
		join work_effort perf on perf.work_effort_id = wea2.work_effort_id_from and perf.work_effort_type_id = '23R82OBA'
		where wea2.work_effort_assoc_type_id = '23R4'
		order by
			perf.etch
	) ob on ob.work_effort_id_to = mis.work_effort_id
	where wea.work_effort_assoc_type_id = '24APPRO'
	group by
		wea.work_effort_id_from
) perf on perf.work_effort_id_from = ris.work_effort_id
where ris.work_effort_type_id = '24A46RIS' and proc.work_effort_id = $P{idProcesso}]]>
		</queryString>
