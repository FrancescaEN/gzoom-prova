	<parameter name="idOvp" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[/* SOTTOSEZIONE ANTICORRUZIONE E TRASPARENZA */
select
	ROW_NUMBER() OVER (PARTITION BY proc.work_effort_id ORDER BY proc.etch,ris.etch,mis.etch, wem.sequence_id) as "Progressivo",
	ROW_NUMBER() OVER (PARTITION BY mis.work_effort_id ORDER BY proc.etch,ris.etch,mis.etch, wem.sequence_id) as "Progressivo indicatore",
	proc.etch as "Codice",
	proc.work_effort_id as "ID Processo",
	proc.work_effort_name as "Denominazione",
	ppr.parent_role_code as "Codice struttura responsabile Processo",
	p.party_name as "Struttura responsabile Processo",
	ovp.work_effort_name as "Obiettivo di Valore Pubblico",
	obp.lista as "Obiettivi di Performance",
	note.nome_resp as "Nome nota Responsabile processo",
	note.resp as "Responsabile processo",
	note.nome_procedimento as "Nome note Procedimento",
	note.procedimento as "Procedimento",
	note.nome_prio as "Nome nota Ordine di priorità",
	note.prio as "Ordine di priorità",
	note.nome_inp as "Nome nota Input",
	note.inp as "Input",
	note.nome_fasi as "Nome nota fasi",
	note.fasi as "Fasi",
	note.nome_outp as "Nome nota Output",
	note.outp as "Output",
	note.nome_interni as "Nome nota Attori interni",
	note.interni as "Attori interni",
	note.nome_esterni as "Nome nota Attori esterni",
	note.esterni as "Attori esterni",
	ar.lista as "Area di rischio",
	ris.work_effort_id as "Id Rischio",
	ris.work_effort_name as "Nome rischio",
	ris.etch as "Etichetta rischio",
	ppr2.parent_role_code as "Codice struttura responsabile Rischio",
	p2.party_name as "Struttura responsabile Rischio",
	wea3.sequence_num as "Graduatoria rischio",
	mis.work_effort_id as "Id Misura",
	mis.work_effort_name as "Nome misura",
	mis.etch as "Etichetta misura",
	ppr3.parent_role_code as "Codice struttura responsabile Misura",
	p3.party_name as "Struttura responsabile Misura",
	ndmis.note_info as "Responsabile misura",
	wept.description as "Tipologia misura",
	gl.gl_account_id as "ID indicatore",
	u.abbreviation as "Unità di misura",
	u.uom_type_id as "Tipo indicatore",
	wem.uom_descr as "Descrizione",
	wem."comments" as "Fonte del dato",
	baseline_valore, baseline_stringa,
	target_valore, target_stringa,
	consuntivo_valore, consuntivo_stringa,
	target_p1_valore, target_p1_stringa,
	target_p2_valore, target_p2_stringa
/* PROCESSO */
from work_effort proc
/* STRUTTURA RESPONSABILE */
join party p on p.party_id = proc.org_unit_id 
join party_parent_role ppr on ppr.party_id = p.party_id 
/* COLLEGAMENTO A SOTTOSEZIONE */
join work_effort_assoc weasez on weasez.work_effort_id_to = proc.work_effort_id and weasez.work_effort_assoc_type_id = '23R4'
join work_effort subsez on subsez.work_effort_id = weasez.work_effort_id_from
	and subsez.work_effort_type_id = '23R44S23' and subsez.work_effort_revision_id is null
/* OBIETTIVO DI VALORE PUBBLICO */
join work_effort ovp on ovp.work_effort_id = subsez.work_effort_parent_id
	and ovp.work_effort_type_id = '23R40PIAO' and ovp.work_effort_revision_id is null
/* OBIETTIVI DI PERFORMANCE PROTETTI */
left join (
	select 
		wea.work_effort_id_to,
		string_agg(ob.work_effort_name, '
' order by ob.etch) as lista
	from work_effort_assoc wea
	join work_effort ob on ob.work_effort_id = wea.work_effort_id_from and ob.work_effort_type_id = '23R82OBA'
	where wea.work_effort_assoc_type_id = '24A42C'
	group by
		wea.work_effort_id_to
) obp on obp.work_effort_id_to = proc.work_effort_id 
/* NOTE */
left join (
	select wen.work_effort_id,
		max(case when wen.sequence_id = 100 then nd.note_info else null end) as procedimento,
		max(case when wen.sequence_id = 200 then nd.note_info else null end) as prio,
		max(case when wen.sequence_id = 210 then nd.note_info else null end) as inp,
		max(case when wen.sequence_id = 220 then nd.note_info else null end) as fasi,
		max(case when wen.sequence_id = 230 then nd.note_info else null end) as outp,
		max(case when wen.sequence_id = 300 then nd.note_info else null end) as resp,
		max(case when wen.sequence_id = 310 then nd.note_info else null end) as interni,
		max(case when wen.sequence_id = 320 then nd.note_info else null end) as esterni,
		max(case when wen.sequence_id = 100 then nd.note_name else null end) as nome_procedimento,
		max(case when wen.sequence_id = 200 then nd.note_name else null end) as nome_prio,
		max(case when wen.sequence_id = 210 then nd.note_name else null end) as nome_inp,
		max(case when wen.sequence_id = 220 then nd.note_name else null end) as nome_fasi,
		max(case when wen.sequence_id = 230 then nd.note_name else null end) as nome_outp,
		max(case when wen.sequence_id = 300 then nd.note_name else null end) as nome_resp,
		max(case when wen.sequence_id = 310 then nd.note_name else null end) as nome_interni,
		max(case when wen.sequence_id = 320 then nd.note_name else null end) as nome_esterni
	from work_effort_note wen
	join note_data nd on nd.note_id = wen.note_id
	group by wen.work_effort_id
) note on note.work_effort_id = proc.work_effort_id
/* AREA DI RISCHIO */
left join (
	select 
		wea.work_effort_id_to,
		string_agg(case when ar.etch is null then null else concat(ar.etch, ' - ', ar.work_effort_name) end, '
' order by ar.etch) as lista 
	from work_effort_assoc wea
	left join work_effort ar on ar.work_effort_id = wea.work_effort_id_from
		and ar.work_effort_type_id = '24A24ARE' and ar.work_effort_revision_id is null
	where wea.work_effort_assoc_type_id = '24APSARC'
	group by
		wea.work_effort_id_to
) ar on ar.work_effort_id_to = proc.work_effort_id
/* RISCHI */
join work_effort_assoc wea3 on wea3.work_effort_id_from = proc.work_effort_id and wea3.work_effort_assoc_type_id = '24APPRO'
join work_effort ris on ris.work_effort_id = wea3.work_effort_id_to
	and ris.work_effort_type_id = '24A46RIS' and ris.work_effort_revision_id is null
/* STRUTTURA RESPONSABILE RISCHIO */
join party p2 on p2.party_id = ris.org_unit_id 
join party_parent_role ppr2 on ppr2.party_id = p2.party_id 
/* MISURE */
join work_effort_assoc wea4 on wea4.work_effort_id_from = ris.work_effort_id and wea4.work_effort_assoc_type_id = '24APPRO'
join work_effort mis on mis.work_effort_id = wea4.work_effort_id_to
	and mis.work_effort_type_id = '24A48MIS' and mis.work_effort_revision_id is null
/* STRUTTURA RESPONSABILE MISURA */
join party p3 on p3.party_id = mis.org_unit_id 
join party_parent_role ppr3 on ppr3.party_id = p3.party_id 
/* RESPONSABILE MISURA */
join work_effort_note wenmis on wenmis.work_effort_id = mis.work_effort_id and wenmis.sequence_id = 100
join note_data ndmis on ndmis.note_id = wenmis.note_id
/* TIPOLOGIA MISURA */
left join work_effort_purpose_type wept on wept.work_effort_purpose_type_id = mis.work_effort_purpose_type_id
/* INDICATORE */
left join work_effort_measure wem on wem.work_effort_id = mis.work_effort_id and wem.gl_account_id not like 'SCORE%'
left join gl_account gl on gl.gl_account_id = wem.gl_account_id
left join uom u on u.uom_id = gl.default_uom_id
/* VALORI INDICATORE */
left join (
	select 
		act.voucher_ref,
		max(case when ate.gl_fiscal_type_id = 'BASELINE' and extract(year from act.transaction_date) = $P{YEAR} then ate.amount else null end) as baseline_valore,
		max(case when ate.gl_fiscal_type_id = 'BASELINE' and extract(year from act.transaction_date) = $P{YEAR} then gamrs.uom_descr else null end) as baseline_stringa,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEAR}  then ate.amount else null end) as target_valore,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEAR}  then gamrs.uom_descr else null end) as target_stringa,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEAR}  then ate.amount else null end) as consuntivo_valore,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEAR}  then gamrs.uom_descr else null end) as consuntivo_stringa,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP1}  then ate.amount else null end) as target_p1_valore,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP1}  then gamrs.uom_descr else null end) as target_p1_stringa,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP2}  then ate.amount else null end) as target_p2_valore,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP2}  then gamrs.uom_descr else null end) as target_p2_stringa
	from acctg_trans act
	join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id and ate.gl_account_id not like 'SCORE%'
	left join gl_account_meas_rat_sc gamrs on gamrs.gl_account_id = ate.gl_account_id and ate.amount = gamrs.uom_rating_value 
	group by
		act.voucher_ref
) val on val.voucher_ref = wem.work_effort_measure_id 
where proc.work_effort_type_id = '24A42PRO' and proc.work_effort_revision_id is null
	and extract(year from proc.estimated_start_date) <= $P{YEAR} and extract(year from proc.estimated_completion_date) >= $P{YEAR}
	and ovp.work_effort_id = $P{idOvp}
	and ppr.role_type_id = 'ORGANIZATION_UNIT'
order by proc.etch,ROW_NUMBER() OVER (PARTITION BY proc.work_effort_id ORDER BY proc.etch,ris.etch,mis.etch, wem.sequence_id),ROW_NUMBER() OVER (PARTITION BY mis.work_effort_id ORDER BY proc.etch,ris.etch,mis.etch, wem.sequence_id)]]>
	</queryString>
	<field name="Progressivo" class="java.lang.Long">
		<property name="com.jaspersoft.studio.field.name" value="Progressivo"/>
		<property name="com.jaspersoft.studio.field.label" value="Progressivo"/>
	</field>
	<field name="Progressivo indicatore" class="java.lang.Long">
		<property name="com.jaspersoft.studio.field.name" value="Progressivo indicatore"/>
		<property name="com.jaspersoft.studio.field.label" value="Progressivo indicatore"/>
	</field>
	<field name="Codice" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="Codice"/>
		<property name="com.jaspersoft.studio.field.label" value="Codice"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="work_effort"/>
	</field>
	<field name="ID Processo" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="ID Processo"/>
		<property name="com.jaspersoft.studio.field.label" value="ID Processo"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="work_effort"/>
	</field>
	<field name="Denominazione" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="Denominazione"/>
		<property name="com.jaspersoft.studio.field.label" value="Denominazione"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="work_effort"/>
	</field>
	<field name="Codice struttura responsabile Processo" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="Codice struttura responsabile Processo"/>
		<property name="com.jaspersoft.studio.field.label" value="Codice struttura responsabile Processo"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="party_parent_role"/>
	</field>
	<field name="Struttura responsabile Processo" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="Struttura responsabile Processo"/>
		<property name="com.jaspersoft.studio.field.label" value="Struttura responsabile Processo"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="party"/>
