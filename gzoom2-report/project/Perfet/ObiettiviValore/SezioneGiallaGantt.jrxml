	<queryString>
		<![CDATA[select 
	obg.work_effort_id as "ID Obiettivo Gestionale",
	obg.etch as "Etichetta Obiettivo Gestionale",
	obg.work_effort_name as "Nome Obiettivo Gestionale",
	obg.estimated_start_date as "Data inizio",
	obg.estimated_completion_date as "Data fine"
/* OBIETTIVO GESTIONALE */
from work_effort obg
where obg.work_effort_type_id = '23R82OBG' 
and obg.work_effort_parent_id = $P{idPerf}  /* ID PERF PASSATO DA SOPRA */
order by obg.etch]]>
	</queryString>
