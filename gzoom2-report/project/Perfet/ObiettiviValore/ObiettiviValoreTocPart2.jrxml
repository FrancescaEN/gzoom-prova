		<parameter name="workEffortId" class="java.lang.String" isForPrompting="false"/>
		<queryString language="SQL">
			<![CDATA[select
	ovp.work_effort_id as "ID OVP",
	ovp.work_effort_name as "Nome OVP",
	ovp.info_url as "Num. Allegato",
    p.party_name as "Nome Struttura"
from work_effort ovp
join party p on p.party_id = ovp.org_unit_id 
where ovp.work_effort_type_id = '23R40PIAO' 
and ovp.work_effort_id =  $P{workEffortId}]]>
		</queryString>
