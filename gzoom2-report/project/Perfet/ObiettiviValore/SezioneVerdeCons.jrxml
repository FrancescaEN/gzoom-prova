	<queryString language="SQL">
		<![CDATA[/* SOTTOSEZIONE AZIONI ORGANIZZATIVE */
select
	azi.work_effort_id as "ID Azione Organizzativa",
	azi.etch as "Codice",
	azi.work_effort_name as "Nome",
	note.descr as "Descrizione",
	note.esterni as "Contributors esterni",
	interni.lista as "Contributors interni",
	upper(gac.description) as "Dimensione",
	case when gl.debit_credit_default = 'D' then '+' else '-' end as "Polarità",
	gl.account_name as "Nome indicatore", /* DA CONCATENARE CON CAMPO PRECEDENTE, ANDANDO A CAPO */
	wem.uom_descr as "Formula",
	wem.kpi_score_weight as "Peso",
	u.uom_type_id as "Tipo misura", /* SE RATING SCALE MOSTRO STRINGA, ALTRIMENTI VALORE */
	soginf_valore, soginf_stringa, sogsup_valore, sogsup_stringa,
	baseline_valore, baseline_stringa, baseline_scorekpi,
	target_valore, target_stringa, target_scorekpi,
	consuntivo_valore, consuntivo_stringa, consuntivo_scorekpi,
	target_p1_valore, target_p1_stringa, target_p1_scorekpi,
	target_p2_valore, target_p2_stringa, target_p2_scorekpi,
	gl.source as "Fonte",
	u.abbreviation as "UDM",
    ppr.parent_role_code as "Codice struttura",
    p.party_name as "Struttura responsabile",
	ROW_NUMBER() OVER (PARTITION BY AZI.work_effort_id ORDER BY wem.sequence_id,wem.work_effort_measure_id) as "Progressivo"
/* AZIONE ORGANIZZATIVA */
from work_effort azi
/* STRUTTURA RESPONSABILE */
join party p on p.party_id = azi.org_unit_id 
join party_parent_role ppr on ppr.party_id = p.party_id
/* COLLEGAMENTO CON OBIETTIVO DI VALORE PUBBLICO */
join work_effort_assoc wea on wea.work_effort_id_to = azi.work_effort_id and wea.work_effort_assoc_type_id = '23R4'
join work_effort subsez on subsez.work_effort_id = wea.work_effort_id_from
	and subsez.work_effort_type_id = '23R44S31' and subsez.work_effort_revision_id is null
join work_effort ovp on ovp.work_effort_id = subsez.work_effort_parent_id
	and ovp.work_effort_type_id = '23R40PIAO' and ovp.work_effort_revision_id is null
/* NOTE */
left join (
	select
		wen.work_effort_id,
		max(case when wen.sequence_id = 100 then nd.note_info else null end) as descr,
		max(case when wen.sequence_id = 200 then nd.note_info else null end) as esterni
	from work_effort_note wen
	join note_data nd on nd.note_id = wen.note_id
	group by
		wen.work_effort_id
) note on note.work_effort_id = azi.work_effort_id
/* CONTRIBUTORS INTERNI */
left join (
	select 
		wepa.work_effort_id,
		string_agg(concat(ppr.parent_role_code,  ' - ', p.party_name), '
' order by ppr.parent_role_code) as lista
	from work_effort_party_assignment wepa 
	join party p on p.party_id = wepa.party_id
	join party_parent_role ppr on ppr.party_id = p.party_id 
	group by
		wepa.work_effort_id
) interni on interni.work_effort_id = azi.work_effort_id 
/* INDICATORI */
left join work_effort_measure wem on wem.work_effort_id = azi.work_effort_id and wem.gl_account_id not like 'SCORE%'
left join gl_account gl on gl.gl_account_id = wem.gl_account_id
left join gl_account_class gac on gac.gl_account_class_id = gl.gl_account_class_id
left join uom u on u.uom_id = gl.default_uom_id
/* VALORI INDICATORI */
left join (
	select
		ate.gl_account_id,
		ate.voucher_ref,
		max(case when ate.gl_fiscal_type_id = 'BASELINE' and extract(year from act.transaction_date) = $P{YEAR} then ate.amount else null end) as baseline_valore,
		max(case when ate.gl_fiscal_type_id = 'BASELINE' and extract(year from act.transaction_date) = $P{YEAR} then gamrs.uom_descr else null end) as baseline_stringa,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEAR} then ate.amount else null end) as target_valore,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEAR} then gamrs.uom_descr else null end) as target_stringa,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEAR} then ate.amount else null end) as consuntivo_valore,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEAR} then gamrs.uom_descr else null end) as consuntivo_stringa,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP1} then ate.amount else null end) as target_p1_valore,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP1} then gamrs.uom_descr else null end) as target_p1_stringa,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP2} then ate.amount else null end) as target_p2_valore,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP2} then gamrs.uom_descr else null end) as target_p2_stringa,
		max(case when ate.gl_fiscal_type_id = 'SOGINF' then ate.amount else null end) as soginf_valore,
		max(case when ate.gl_fiscal_type_id = 'SOGINF' then gamrs.uom_descr else null end) as soginf_stringa,
		max(case when ate.gl_fiscal_type_id = 'SOGSUP' then ate.amount else null end) as sogsup_valore,
		max(case when ate.gl_fiscal_type_id = 'SOGSUP' then gamrs.uom_descr else null end) as sogsup_stringa
	from acctg_trans_entry ate
	join acctg_trans act on act.acctg_trans_id = ate.acctg_trans_id
	left join gl_account_meas_rat_sc gamrs on gamrs.gl_account_id = ate.gl_account_id
		and ate.amount = gamrs.uom_rating_value
	where ate.gl_account_id not like 'SCORE%'
	group by
		ate.gl_account_id,
		ate.voucher_ref
) valind on (valind.gl_account_id = wem.gl_account_id and gl.input_enum_id = 'ACCINP_UO') or
	(gl.input_enum_id = 'ACCINP_OBJ' and valind.voucher_ref = wem.work_effort_measure_id)
/* SCOREKPI */
left join (
	select
		wem.work_effort_id,
		gl.gl_account_id,
		max(case when ate.gl_fiscal_type_id = 'BASELINE' and extract(year from act.transaction_date) = $P{YEAR} then ate.amount else null end) as baseline_scorekpi,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEAR}  then ate.amount else null end) as target_scorekpi,
		max(case when ate.gl_fiscal_type_id = 'ACTUAL' and extract(year from act.transaction_date) = $P{YEAR}  then ate.amount else null end) as consuntivo_scorekpi,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP1}  then ate.amount else null end) as target_p1_scorekpi,
		max(case when ate.gl_fiscal_type_id = 'BUDGET' and extract(year from act.transaction_date) = $P{YEARP2}  then ate.amount else null end) as target_p2_scorekpi
	from work_effort_measure wem
	join gl_account gl on gl.gl_account_id = wem.gl_account_id
	join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id and ate.gl_account_id = 'SCOREKPI'
	join acctg_trans act on act.acctg_trans_id = ate.acctg_trans_id
	group by
		wem.work_effort_id,
		gl.gl_account_id
) scorekpi on (scorekpi.gl_account_id, scorekpi.work_effort_id) = (valind.gl_account_id, wem.work_effort_id)
where azi.work_effort_type_id = '23R85AOR' and azi.work_effort_revision_id is null
	and extract(year from azi.estimated_start_date) <= $P{YEAR} and extract(year from azi.estimated_completion_date) >= $P{YEAR}	
	and ovp.work_effort_id= $P{idOvp}
	and ppr.role_type_id = 'ORGANIZATION_UNIT'
	/* ID OVP PASSATO DA QUERY SOPRA */
order by azi.etch]]>
	</queryString>
