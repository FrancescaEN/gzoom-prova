                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
	     A0.WORK_EFFORT_ID AS ID0, B0.ETCH AS ETICHETTA0, A0.ETCH AS ETCH0, Z0.ASSOC_WEIGHT AS ASSOC_WEIGHT0, A0.WORK_EFFORT_NAME AS NAME0,
	     A0.ESTIMATED_START_DATE, A0.ESTIMATED_COMPLETION_DATE,
	     ND1.NOTE_INFO,
	     P_STRUT.PARTY_NAME AS STRUTTURA,
	     I.ACTUAL
	     
FROM WORK_EFFORT W
	 -- 
	 INNER JOIN WORK_EFFORT_ASSOC Z0 ON Z0.WORK_EFFORT_ID_FROM = W.WORK_EFFORT_ID	 
     INNER JOIN WORK_EFFORT A0 ON A0.WORK_EFFORT_ID = Z0.WORK_EFFORT_ID_TO
     INNER JOIN WORK_EFFORT_TYPE B0 ON B0.WORK_EFFORT_TYPE_ID = A0.WORK_EFFORT_TYPE_ID     
	 
     -- PUNTEGGIO 
	LEFT OUTER JOIN (
            SELECT Q.WORK_EFFORT_ID, MAX(R.AMOUNT) AS ACTUAL
            FROM ACCTG_TRANS Q 
            INNER JOIN ACCTG_TRANS_ENTRY R ON Q.ACCTG_TRANS_ID = R.ACCTG_TRANS_ID
            WHERE R.GL_ACCOUNT_ID = 'SCORE' 
                  AND Q.TRANSACTION_DATE = ?
            GROUP BY Q.WORK_EFFORT_ID
    ) I ON I.WORK_EFFORT_ID = A0.WORK_EFFORT_ID 
    
	-- STRUTTURA
   LEFT OUTER JOIN PARTY P_STRUT ON P_STRUT.PARTY_ID = A0.ORG_UNIT_ID
		
   LEFT OUTER JOIN WORK_EFFORT_NOTE WEN1 ON WEN1.WORK_EFFORT_ID = W.WORK_EFFORT_ID
   		AND WEN1.IS_MAIN = 'Y' 
   		AND WEN1.SEQUENCE_ID = 1
   LEFT OUTER JOIN NOTE_DATA ND1 ON ND1.NOTE_ID = WEN1.NOTE_ID
     
WHERE W.WORK_EFFORT_ID = ?
  ]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="IndicatoriPerformanceDS" id="54602">
            <property name="nullsOrdering">nulls lowest</property>
