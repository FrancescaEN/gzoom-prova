                    <property name="name">ASSOC_WEIGHT0</property>
                    <property name="nativeName">ASSOC_WEIGHT0</property>
                    <property name="dataType">float</property>
                    <property name="nativeDataType">8</property>
                </structure>
                <structure>
                    <property name="position">10</property>
                    <property name="name">RESPONSABILE</property>
                    <property name="nativeName">RESPONSABILE</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">11</property>
                    <property name="name">STRUTTURA</property>
                    <property name="nativeName">STRUTTURA</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">12</property>
                    <property name="name">ACTUAL</property>
                    <property name="nativeName">ACTUAL</property>
                    <property name="dataType">float</property>
                    <property name="nativeDataType">8</property>
                </structure>
                <structure>
                    <property name="position">13</property>
                    <property name="name">NOTE_INFO1</property>
                    <property name="nativeName">NOTE_INFO1</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">14</property>
                    <property name="name">NOTE_NAME1</property>
                    <property name="nativeName">NOTE_NAME1</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
		
	   WT.WORK_EFFORT_TYPE_ID,
	   WT.ETCH AS ETICHETTA, W.ETCH AS ETCH, W.WORK_EFFORT_NAME AS NAME, W.WORK_EFFORT_ID AS ID, W.DESCRIPTION AS DESCRIPTION,   	   
	   W.ESTIMATED_START_DATE, W.ESTIMATED_COMPLETION_DATE,
	   Z0.ASSOC_WEIGHT AS ASSOC_WEIGHT0,
	   P.PARTY_NAME AS RESPONSABILE,
	   P_STRUT.PARTY_NAME AS STRUTTURA,	   
 	   I.ACTUAL,
 	   ND1.NOTE_INFO AS NOTE_INFO1,
 	   ND1.NOTE_NAME AS NOTE_NAME1
      
FROM WORK_EFFORT W
     INNER JOIN WORK_EFFORT_TYPE WT ON WT.WORK_EFFORT_TYPE_ID = W.WORK_EFFORT_TYPE_ID 
     
     INNER JOIN WORK_EFFORT_ASSOC Z0 ON Z0.WORK_EFFORT_ID_TO = W.WORK_EFFORT_ID   
     
    -- PUNTEGGIO 
	LEFT OUTER JOIN (
            SELECT Q.WORK_EFFORT_ID, MAX(R.AMOUNT) AS ACTUAL
            FROM ACCTG_TRANS Q 
            INNER JOIN ACCTG_TRANS_ENTRY R ON Q.ACCTG_TRANS_ID = R.ACCTG_TRANS_ID
            WHERE R.GL_ACCOUNT_ID = 'SCORE' 
                  AND Q.TRANSACTION_DATE = ?
            GROUP BY Q.WORK_EFFORT_ID
    ) I ON I.WORK_EFFORT_ID = W.WORK_EFFORT_ID 
    
     -- responsabile obiettivo
  	 LEFT OUTER JOIN PARTY_RELATIONSHIP P_RESP ON  P_RESP.PARTY_ID_FROM = W.ORG_UNIT_ID
     	AND P_RESP.ROLE_TYPE_ID_FROM = W.ORG_UNIT_ROLE_TYPE_ID
     	AND P_RESP.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
     	AND P_RESP.THRU_DATE IS NULL
	LEFT OUTER JOIN PARTY P ON P.PARTY_ID = P_RESP.PARTY_ID_TO
	
	-- STRUTTURA
	LEFT OUTER JOIN PARTY P_STRUT ON P_STRUT.PARTY_ID = W.ORG_UNIT_ID
	
	
	
   LEFT OUTER JOIN WORK_EFFORT_NOTE WEN1 ON WEN1.WORK_EFFORT_ID = W.WORK_EFFORT_ID
   		AND WEN1.IS_MAIN = 'Y' 
   		AND WEN1.SEQUENCE_ID = 10
   LEFT OUTER JOIN NOTE_DATA ND1 ON ND1.NOTE_ID = WEN1.NOTE_ID
   
WHERE W.WORK_EFFORT_ID = ?
  
  
	    ]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="SettoriCoinvoltiDS" id="53935">
            <list-property name="columnHints">
                <structure>
                    <property name="columnName">WORK_EFFORT_ID</property>
                    <property name="analysis">dimension</property>
