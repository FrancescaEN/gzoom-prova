    <property name="units">in</property>
    <method name="initialize"><![CDATA[importPackage(Packages.java.util);
importPackage(Packages.java.lang);
importPackage(Packages.javolution.util);
importPackage(Packages.org.ofbiz.base.util);
importPackage(Packages.com.mapsengineering.base.appheader);
importPackage(Packages.it.mapsgroup.gzoom);
importPackage(Packages.com.mapsengineering.base.birt.util);


var vectorPageNumber = new Vector();
reportContext.setGlobalVariable("vectorPageNumber", vectorPageNumber);
reportContext.setGlobalVariable("nPagina", 1);
reportContext.setGlobalVariable("NpageIndex", 0 );
reportContext.setGlobalVariable("nPageEmpty", 0 );

var title =	
	(
		(BirtDateTime.day(params["monitoringDate"].value) == 31 &amp;&amp; BirtDateTime.month(params["monitoringDate"].value) == 3) ||
		(BirtDateTime.day(params["monitoringDate"].value) == 30 &amp;&amp; BirtDateTime.month(params["monitoringDate"].value) == 6) ||
		(BirtDateTime.day(params["monitoringDate"].value) == 30 &amp;&amp; BirtDateTime.month(params["monitoringDate"].value) == 9) ||
		(BirtDateTime.day(params["monitoringDate"].value) == 31 &amp;&amp; BirtDateTime.month(params["monitoringDate"].value) == 12)
	)
	 
	? reportContext.getMessage('HeaderLabelCons', reportContext.getLocale())+" al "+ Formatter.format(params["monitoringDate"].value,'dd/MM/yyyy') 
	: reportContext.getMessage('HeaderLabelPrev', reportContext.getLocale())+" "+ BirtDateTime.year(params["monitoringDate"].value)
	
var reportTitle = 
	(
		(BirtDateTime.day(params["monitoringDate"].value) == 31 &amp;&amp; BirtDateTime.month(params["monitoringDate"].value) == 3) ||
		(BirtDateTime.day(params["monitoringDate"].value) == 30 &amp;&amp; BirtDateTime.month(params["monitoringDate"].value) == 6) ||
		(BirtDateTime.day(params["monitoringDate"].value) == 30 &amp;&amp; BirtDateTime.month(params["monitoringDate"].value) == 9) ||
		(BirtDateTime.day(params["monitoringDate"].value) == 31 &amp;&amp; BirtDateTime.month(params["monitoringDate"].value) == 12)
	)
	 
	? reportContext.getMessage('report_title_cons', reportContext.getLocale()) 
	: reportContext.getMessage('report_title_prev', reportContext.getLocale())]]></method>
