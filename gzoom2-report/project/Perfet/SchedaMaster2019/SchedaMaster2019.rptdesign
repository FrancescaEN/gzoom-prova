                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">WORK_EFFORT_NAME</property>
                    <property name="nativeName">WORK_EFFORT_NAME</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">ETCH</property>
                    <property name="nativeName">ETCH</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
	C.WORK_EFFORT_NAME, C.ETCH

FROM WORK_EFFORT A
INNER JOIN WORK_EFFORT_ASSOC B ON B.WORK_EFFORT_ID_TO = A.WORK_EFFORT_ID
	AND B.WORK_EFFORT_ASSOC_TYPE_ID like '%STAKEC'
INNER JOIN WORK_EFFORT C ON B.WORK_EFFORT_ID_FROM = C.WORK_EFFORT_ID
  
WHERE A.WORK_EFFORT_ID = ? ]]></xml-property>
