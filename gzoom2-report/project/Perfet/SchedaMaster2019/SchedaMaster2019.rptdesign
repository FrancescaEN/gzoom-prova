            <xml-property name="queryText"><![CDATA[SELECT 
	   RAD.WORK_EFFORT_NAME AS TITLE, RAT.ETCH AS RAD_TITOLO_ETCH, RAD.WORK_EFFORT_ID AS ID_RAD, RADTC.ETCH AS RAD_TITOLO,   	   
	   B1.ETCH AS ETICHETTA1, A1.ETCH AS ETCH1, A1.WORK_EFFORT_NAME AS NAME1, Z1.SEQUENCE_NUM AS SEQ1, A1.WORK_EFFORT_ID AS ID1, A1.DESCRIPTION AS DESCRIPTION1, Z1.ASSOC_WEIGHT AS ASSOC_WEIGHT1, A1.SOURCE_REFERENCE_ID AS CODE1,
       B2.ETCH AS ETICHETTA2, A2.ETCH AS ETCH2, A2.WORK_EFFORT_NAME AS NAME2, Z2.SEQUENCE_NUM AS SEQ2, A2.WORK_EFFORT_ID AS ID2, A2.DESCRIPTION AS DESCRIPTION2, Z2.ASSOC_WEIGHT AS ASSOC_WEIGHT2, A2.SOURCE_REFERENCE_ID AS CODE2,            
       B3.ETCH AS ETICHETTA3, A3.ETCH AS ETCH3, A3.WORK_EFFORT_NAME AS NAME3, Z3.SEQUENCE_NUM AS SEQ3, A3.WORK_EFFORT_ID AS ID3, A3.DESCRIPTION AS DESCRIPTION3, Z3.ASSOC_WEIGHT AS ASSOC_WEIGHT3, A3.SOURCE_REFERENCE_ID AS CODE3,            
       B4.ETCH AS ETICHETTA4, A4.ETCH AS ETCH4, A4.WORK_EFFORT_NAME AS NAME4, Z4.SEQUENCE_NUM AS SEQ4, A4.WORK_EFFORT_ID AS ID4, A4.DESCRIPTION AS DESCRIPTION4, Z4.ASSOC_WEIGHT AS ASSOC_WEIGHT4, A4.SOURCE_REFERENCE_ID AS CODE4,            
 	    	   
 	   MAX(I1.AMOUNT) AS ACTUAL1,
 	   MAX(I2.AMOUNT) AS ACTUAL2,
 	   MAX(I3.AMOUNT) AS ACTUAL3,
 	   MAX(I4.AMOUNT) AS ACTUAL4
      
FROM WORK_EFFORT RAD
	 INNER JOIN WORK_EFFORT_TYPE RAT ON RAT.WORK_EFFORT_TYPE_ID = RAD.WORK_EFFORT_TYPE_ID	
	 INNER JOIN WORK_EFFORT_TYPE_CONTENT RADTC ON RADTC.WORK_EFFORT_TYPE_ID = RAD.WORK_EFFORT_TYPE_ID
		AND RADTC.CONTENT_ID = ?    
	 	
	 -- linea mandato
     LEFT OUTER JOIN WORK_EFFORT_ASSOC Z1 ON Z1.WORK_EFFORT_ID_FROM = RAD.WORK_EFFORT_ID
     	AND Z1.WORK_EFFORT_ASSOC_TYPE_ID = RAT.HIERARCHY_ASSOC_TYPE_ID
     LEFT OUTER JOIN WORK_EFFORT A1 ON A1.WORK_EFFORT_ID = Z1.WORK_EFFORT_ID_TO
     LEFT OUTER JOIN WORK_EFFORT_ASSOC_TYPE D1 ON D1.WORK_EFFORT_ASSOC_TYPE_ID = Z1.WORK_EFFORT_ASSOC_TYPE_ID     
     LEFT OUTER JOIN WORK_EFFORT_TYPE B1 ON B1.WORK_EFFORT_TYPE_ID = A1.WORK_EFFORT_TYPE_ID     	
     
     -- obiettivo strategico
     LEFT OUTER JOIN WORK_EFFORT_ASSOC Z2 ON Z2.WORK_EFFORT_ID_FROM = A1.WORK_EFFORT_ID
     	AND Z2.WORK_EFFORT_ASSOC_TYPE_ID = RAT.HIERARCHY_ASSOC_TYPE_ID
     LEFT OUTER JOIN WORK_EFFORT A2 ON A2.WORK_EFFORT_ID = Z2.WORK_EFFORT_ID_TO
     LEFT OUTER JOIN WORK_EFFORT_ASSOC_TYPE D2 ON D2.WORK_EFFORT_ASSOC_TYPE_ID = Z2.WORK_EFFORT_ASSOC_TYPE_ID     
     LEFT OUTER JOIN WORK_EFFORT_TYPE B2 ON B2.WORK_EFFORT_TYPE_ID = A2.WORK_EFFORT_TYPE_ID
     
     -- obiettivo operativo
     LEFT OUTER JOIN WORK_EFFORT_ASSOC Z3 ON Z3.WORK_EFFORT_ID_FROM = A2.WORK_EFFORT_ID
     	AND Z3.WORK_EFFORT_ASSOC_TYPE_ID = RAT.HIERARCHY_ASSOC_TYPE_ID
     LEFT OUTER JOIN WORK_EFFORT A3 ON A3.WORK_EFFORT_ID = Z3.WORK_EFFORT_ID_TO
     LEFT OUTER JOIN WORK_EFFORT_ASSOC_TYPE D3 ON D3.WORK_EFFORT_ASSOC_TYPE_ID = Z3.WORK_EFFORT_ASSOC_TYPE_ID     
     LEFT OUTER JOIN WORK_EFFORT_TYPE B3 ON B3.WORK_EFFORT_TYPE_ID = A3.WORK_EFFORT_TYPE_ID
     
     -- obiettivo gestionale
     LEFT OUTER JOIN WORK_EFFORT_ASSOC Z4 ON Z4.WORK_EFFORT_ID_FROM = A3.WORK_EFFORT_ID
     	AND Z4.WORK_EFFORT_ASSOC_TYPE_ID = RAT.HIERARCHY_ASSOC_TYPE_ID
     LEFT OUTER JOIN WORK_EFFORT A4 ON A4.WORK_EFFORT_ID = Z4.WORK_EFFORT_ID_TO
     LEFT OUTER JOIN WORK_EFFORT_ASSOC_TYPE D4 ON D4.WORK_EFFORT_ASSOC_TYPE_ID = Z4.WORK_EFFORT_ASSOC_TYPE_ID     
     LEFT OUTER JOIN WORK_EFFORT_TYPE B4 ON B4.WORK_EFFORT_TYPE_ID = A4.WORK_EFFORT_TYPE_ID
    
     LEFT OUTER JOIN (
            SELECT Q.WORK_EFFORT_ID, Q.TRANSACTION_DATE, R.AMOUNT, R.GL_FISCAL_TYPE_ID
            FROM ACCTG_TRANS Q 
            INNER JOIN ACCTG_TRANS_ENTRY R ON Q.ACCTG_TRANS_ID = R.ACCTG_TRANS_ID
            WHERE R.GL_ACCOUNT_ID = 'SCORE' 
                  AND Q.TRANSACTION_DATE = ?
    ) I1 ON I1.WORK_EFFORT_ID = A1.WORK_EFFORT_ID  
    
    LEFT OUTER JOIN (
            SELECT Q.WORK_EFFORT_ID, Q.TRANSACTION_DATE, R.AMOUNT, R.GL_FISCAL_TYPE_ID
            FROM ACCTG_TRANS Q 
            INNER JOIN ACCTG_TRANS_ENTRY R ON Q.ACCTG_TRANS_ID = R.ACCTG_TRANS_ID
            WHERE R.GL_ACCOUNT_ID = 'SCORE' 
                  AND Q.TRANSACTION_DATE = ?
    ) I2 ON I2.WORK_EFFORT_ID = A2.WORK_EFFORT_ID 
    
    LEFT OUTER JOIN (
            SELECT Q.WORK_EFFORT_ID, Q.TRANSACTION_DATE, R.AMOUNT, R.GL_FISCAL_TYPE_ID
            FROM ACCTG_TRANS Q 
            INNER JOIN ACCTG_TRANS_ENTRY R ON Q.ACCTG_TRANS_ID = R.ACCTG_TRANS_ID
            WHERE R.GL_ACCOUNT_ID = 'SCORE' 
                  AND Q.TRANSACTION_DATE = ?
    ) I3 ON I3.WORK_EFFORT_ID = A3.WORK_EFFORT_ID 
    
    LEFT OUTER JOIN (
            SELECT Q.WORK_EFFORT_ID, Q.TRANSACTION_DATE, R.AMOUNT, R.GL_FISCAL_TYPE_ID
            FROM ACCTG_TRANS Q 
            INNER JOIN ACCTG_TRANS_ENTRY R ON Q.ACCTG_TRANS_ID = R.ACCTG_TRANS_ID
            WHERE R.GL_ACCOUNT_ID = 'SCORE' 
                  AND Q.TRANSACTION_DATE = ?
    ) I4 ON I4.WORK_EFFORT_ID = A4.WORK_EFFORT_ID 
    
WHERE RAD.WORK_EFFORT_ID = ?
  
GROUP BY
		RAD.WORK_EFFORT_NAME, RAT.ETCH, RAD.WORK_EFFORT_ID, RADTC.ETCH,   	   
	   B1.ETCH, A1.ETCH, A1.WORK_EFFORT_NAME, Z1.SEQUENCE_NUM, A1.WORK_EFFORT_ID, A1.DESCRIPTION, Z1.ASSOC_WEIGHT, A1.SOURCE_REFERENCE_ID,
       B2.ETCH, A2.ETCH, A2.WORK_EFFORT_NAME, Z2.SEQUENCE_NUM, A2.WORK_EFFORT_ID, A2.DESCRIPTION, Z2.ASSOC_WEIGHT, A2.SOURCE_REFERENCE_ID,            
       B3.ETCH, A3.ETCH, A3.WORK_EFFORT_NAME, Z3.SEQUENCE_NUM, A3.WORK_EFFORT_ID, A3.DESCRIPTION, Z3.ASSOC_WEIGHT, A3.SOURCE_REFERENCE_ID,            
       B4.ETCH, A4.ETCH, A4.WORK_EFFORT_NAME, Z4.SEQUENCE_NUM, A4.WORK_EFFORT_ID, A4.DESCRIPTION, Z4.ASSOC_WEIGHT, A4.SOURCE_REFERENCE_ID
 ORDER BY
       Z1.SEQUENCE_NUM, A1.SOURCE_REFERENCE_ID, A1.WORK_EFFORT_ID,
       Z2.SEQUENCE_NUM, A2.SOURCE_REFERENCE_ID, A2.WORK_EFFORT_ID,
       Z3.SEQUENCE_NUM, A3.SOURCE_REFERENCE_ID, A3.WORK_EFFORT_ID,
       Z4.SEQUENCE_NUM, A4.SOURCE_REFERENCE_ID, A4.WORK_EFFORT_ID]]></xml-property>
        </oda-data-set>
