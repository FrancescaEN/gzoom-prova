            <property name="dataSource">DataSourceScripted</property>
            <method name="open"><![CDATA[
size = 0;
countRow = 0;

listProductId = reportContext.getPersistentGlobalVariable("listProductId");
//Debug.log("........ listProductId=" + listProductId);
if (listProductId != null ) {
	size = listProductId.size();
}
]]></method>
            <method name="fetch"><![CDATA[if( countRow >= size ) { 
	return false; 
}

var value = listProductId.get(countRow);
row["PRODUCT_ID"] = value;

countRow += 1;
return true;]]></method>
        </script-data-set>
