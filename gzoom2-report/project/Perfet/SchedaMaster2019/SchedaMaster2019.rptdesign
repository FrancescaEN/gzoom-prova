        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="EntrateSpeseDS" id="54471">
            <list-property name="parameters">
                <structure>
                    <property name="name">workEffortId</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <expression name="defaultValue" type="constant">N/A</expression>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">SPESA</property>
                        <property name="dataType">float</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">ENTRATA</property>
                        <property name="dataType">float</property>
                    </structure>
                </list-property>
            </structure>
            <method name="beforeOpen"><![CDATA[importPackage(Packages.org.ofbiz.base.util);

this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value );

  
/**
this.queryText = this.queryText.replace("@date3112",  "''" );
this.queryText = this.queryText.replace("@date0101",  "''" );
*/
//Debug.log("... this.queryText= "+this.queryText);]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">SPESA</property>
                    <property name="nativeName">SPESA</property>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">ENTRATA</property>
                    <property name="nativeName">ENTRATA</property>
                    <property name="dataType">float</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
		
	  SUM(CASE WHEN INDIC.G_DEBIT_CREDIT_DEFAULT = 'C' THEN INDIC.TM_AMOUNT ELSE NULL END)  SPESA,
	  MAX(CASE WHEN INDIC.G_DEBIT_CREDIT_DEFAULT = 'D' THEN INDIC.TM_AMOUNT ELSE NULL END)  ENTRATA
	    
	    
	FROM WORK_EFFORT_TRANS_INDIC_VIEW INDIC
	
	WHERE (INDIC.G_GL_ACCOUNT_ID <> 'SCORE' OR INDIC.G_GL_ACCOUNT_ID IS NULL)
		 AND INDIC.G_ACCOUNT_TYPE_ENUM_ID = 'INDICATOR'
		 AND ( INDIC.TM_GL_ACCOUNT_ID <> 'SCOREKPI'	OR INDIC.TM_GL_ACCOUNT_ID IS NULL )	 
		  AND INDIC.M_WORK_EFFORT_ID = ?
   		 AND INDIC.M_THRU_DATE >= @date0101
	  	 AND INDIC.M_FROM_DATE <= @date3112
	  	 AND INDIC.M_WE_MEASURE_TYPE_ENUM_ID = 'WEMT_FINANCIAL'
	  	 AND INDIC.TT_GL_FISCAL_TYPE_ID = 'BUDGET'	
	  	 AND INDIC.TT_TRANSACTION_DATE = @date3112

]]></xml-property>
