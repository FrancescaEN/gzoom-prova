            <method name="onFetch"><![CDATA[importPackage(Packages.java.util);

var listProductId = reportContext.getPersistentGlobalVariable("listProductId");
if (listProductId == null) {
	listProductId = new java.util.ArrayList();
}

if (!listProductId.contains(row["ID1"]) &amp;&amp; row["ID1"] != null) {
	listProductId.add(row["ID1"])
}

if (!listProductId.contains(row["ID2"]) &amp;&amp; row["ID2"] != null) {
	listProductId.add(row["ID2"])
}

if (!listProductId.contains(row["ID3"]) &amp;&amp; row["ID3"] != null) {
	listProductId.add(row["ID3"])
}

if (!listProductId.contains(row["ID4"]) &amp;&amp; row["ID4"] != null) {
	listProductId.add(row["ID4"])
}

reportContext.setPersistentGlobalVariable("listProductId", listProductId);
//Debug.log("........ listProductId=" + listProductId);
]]></method>
