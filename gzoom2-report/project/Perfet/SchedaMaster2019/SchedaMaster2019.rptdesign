                    <property name="position">33</property>
                    <property name="name">JUL_AMOUNT_ACTUAL</property>
                    <property name="nativeName">JUL_AMOUNT_ACTUAL</property>
                    <property name="dataType">float</property>
                    <property name="nativeDataType">8</property>
                </structure>
                <structure>
                    <property name="position">34</property>
                    <property name="name">AUG_AMOUNT_ACTUAL</property>
                    <property name="nativeName">AUG_AMOUNT_ACTUAL</property>
                    <property name="dataType">float</property>
                    <property name="nativeDataType">8</property>
                </structure>
                <structure>
                    <property name="position">35</property>
                    <property name="name">SEP_AMOUNT_ACTUAL</property>
                    <property name="nativeName">SEP_AMOUNT_ACTUAL</property>
                    <property name="dataType">float</property>
                    <property name="nativeDataType">8</property>
                </structure>
                <structure>
                    <property name="position">36</property>
                    <property name="name">OCT_AMOUNT_ACTUAL</property>
                    <property name="nativeName">OCT_AMOUNT_ACTUAL</property>
                    <property name="dataType">float</property>
                    <property name="nativeDataType">8</property>
                </structure>
                <structure>
                    <property name="position">37</property>
                    <property name="name">NOV_AMOUNT_ACTUAL</property>
                    <property name="nativeName">NOV_AMOUNT_ACTUAL</property>
