            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
	     P.PARTY_NAME,
	     
	     A0.WORK_EFFORT_ID AS ID0, B0.ETCH AS ETICHETTA0, A0.ETCH AS ETCH0, A0.WORK_EFFORT_NAME AS NAME0,
	     A1.WORK_EFFORT_ID AS ID1, B1.ETCH AS ETICHETTA1, A1.ETCH AS ETCH1, A1.WORK_EFFORT_NAME AS NAME1,
	     A2.WORK_EFFORT_ID AS ID2, B2.ETCH AS ETICHETTA2, A2.ETCH AS ETCH2, A2.WORK_EFFORT_NAME AS NAME2,
	     A3.WORK_EFFORT_ID AS ID3, B3.ETCH AS ETICHETTA3, A3.ETCH AS ETCH3, A3.WORK_EFFORT_NAME AS NAME3
	     
	     
FROM WORK_EFFORT RAD
	 INNER JOIN WORK_EFFORT_TYPE RAT ON RAT.WORK_EFFORT_TYPE_ID = RAD.WORK_EFFORT_TYPE_ID	
	 	
	 -- LINEA
	 INNER JOIN WORK_EFFORT_ASSOC Z0 ON Z0.WORK_EFFORT_ID_FROM = RAD.WORK_EFFORT_ID
	 	AND Z0.WORK_EFFORT_ASSOC_TYPE_ID = RAT.HIERARCHY_ASSOC_TYPE_ID
     INNER JOIN WORK_EFFORT A0 ON A0.WORK_EFFORT_ID = Z0.WORK_EFFORT_ID_TO
     INNER JOIN WORK_EFFORT_TYPE B0 ON B0.WORK_EFFORT_TYPE_ID = A0.WORK_EFFORT_TYPE_ID     
	 
	 -- PROGRAMMA
     LEFT OUTER JOIN WORK_EFFORT_ASSOC Z1 ON Z1.WORK_EFFORT_ID_FROM = A0.WORK_EFFORT_ID
     	AND Z1.WORK_EFFORT_ASSOC_TYPE_ID = RAT.HIERARCHY_ASSOC_TYPE_ID
     LEFT OUTER JOIN WORK_EFFORT A1 ON A1.WORK_EFFORT_ID = Z1.WORK_EFFORT_ID_TO
     LEFT OUTER JOIN WORK_EFFORT_TYPE B1 ON B1.WORK_EFFORT_TYPE_ID = A1.WORK_EFFORT_TYPE_ID     
	 
     -- PROGETTO
     LEFT OUTER JOIN WORK_EFFORT_ASSOC Z2 ON Z2.WORK_EFFORT_ID_FROM = A1.WORK_EFFORT_ID
     	AND Z2.WORK_EFFORT_ASSOC_TYPE_ID = RAT.HIERARCHY_ASSOC_TYPE_ID
     LEFT OUTER JOIN WORK_EFFORT A2 ON A2.WORK_EFFORT_ID = Z2.WORK_EFFORT_ID_TO
     LEFT OUTER JOIN WORK_EFFORT_TYPE B2 ON B2.WORK_EFFORT_TYPE_ID = A2.WORK_EFFORT_TYPE_ID     
	 
     -- OBIETTIVO
     LEFT OUTER JOIN WORK_EFFORT_ASSOC Z3 ON Z3.WORK_EFFORT_ID_FROM = A2.WORK_EFFORT_ID
     	AND Z3.WORK_EFFORT_ASSOC_TYPE_ID = RAT.HIERARCHY_ASSOC_TYPE_ID
     LEFT OUTER JOIN WORK_EFFORT A3 ON A3.WORK_EFFORT_ID = Z3.WORK_EFFORT_ID_TO
     LEFT OUTER JOIN WORK_EFFORT_TYPE B3 ON B3.WORK_EFFORT_TYPE_ID = A3.WORK_EFFORT_TYPE_ID     
	 
	  -- AZIONE
     LEFT OUTER JOIN WORK_EFFORT_ASSOC Z4 ON Z4.WORK_EFFORT_ID_FROM = A3.WORK_EFFORT_ID
     	AND Z4.WORK_EFFORT_ASSOC_TYPE_ID = RAT.HIERARCHY_ASSOC_TYPE_ID
     LEFT OUTER JOIN WORK_EFFORT A4 ON A4.WORK_EFFORT_ID = Z4.WORK_EFFORT_ID_TO
     LEFT OUTER JOIN WORK_EFFORT_TYPE B4 ON B4.WORK_EFFORT_TYPE_ID = A4.WORK_EFFORT_TYPE_ID
    
    
    LEFT OUTER JOIN WORK_EFFORT_PARTY_ASSIGNMENT A ON A.WORK_EFFORT_ID = A3.WORK_EFFORT_ID
		AND A.ROLE_TYPE_ID = 'WEM_ASSESORE'
		AND A.FROM_DATE <= ?
    	AND A.THRU_DATE >= ?
    
	LEFT OUTER JOIN PARTY P ON P.PARTY_ID = A.PARTY_ID
     
WHERE RAD.WORK_EFFORT_ID = ?
	AND (A0.WORK_EFFORT_ID = ? OR A1.WORK_EFFORT_ID = ? OR A2.WORK_EFFORT_ID = ? OR A3.WORK_EFFORT_ID = ? OR A4.WORK_EFFORT_ID = ?)
  ]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="StakeholdersDS" id="54277">
            <list-property name="computedColumns">
                <structure>
                    <property name="name">TITOLO</property>
                    <expression name="expression">row["ETCH"] != null &amp;&amp; row["ETCH"] != '' ? row["ETCH"] + " - " + row["WORK_EFFORT_NAME"] : row["WORK_EFFORT_NAME"]</expression>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
