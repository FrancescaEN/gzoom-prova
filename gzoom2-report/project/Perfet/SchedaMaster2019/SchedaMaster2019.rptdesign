                                                                    <property name="textAlign">center</property>
                                                                    <list-property name="visibility"/>
                                                                    <expression name="valueExpr">importPackage(Packages.com.mapsengineering.base.birt.util);&#13;
if (row["G_UOM_TYPE_ID"] == 'RATING_SCALE') {&#13;
	row["BUDGET_COD"];	&#13;
} else if (row["G_UOM_TYPE_ID"] == 'DATE_MEASURE') {&#13;
	UtilDateTime.numberConvertToDate(row["BUDGET_DATO"], reportContext.getLocale());&#13;
} else {&#13;
	row["BUDGET_DATO"] != null ? Formatter.format(row["FORMAT"].indexOf('%') != -1 ? row["BUDGET_DATO"]/100 : row["BUDGET_DATO"], row["FORMAT"]) : '';&#13;
}</expression>
                                                                    <property name="contentType">html</property>
                                                                </text-data>
                                                                <data id="54349">
                                                                    <property name="fontSize">8pt</property>
                                                                    <property name="textAlign">center</property>
                                                                    <list-property name="visibility">
                                                                        <structure>
                                                                            <property name="format">all</property>
                                                                            <expression name="valueExpr" type="javascript">row["BUDGET_RIFERIMENTO"] == null || row["BUDGET_RIFERIMENTO"] == ''</expression>
                                                                        </structure>
                                                                    </list-property>
                                                                    <property name="resultSetColumn">BUDGET_RIFERIMENTO</property>
                                                                </data>
