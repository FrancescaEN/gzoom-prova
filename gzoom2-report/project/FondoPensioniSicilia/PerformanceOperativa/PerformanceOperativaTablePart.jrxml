	</parameter>
	<parameter name="old_orgUnitIdString" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[($P{orgUnitId}  != null && $P{orgUnitId}  != "" && $P{onlyFirstChildLevel}.equals("N")) ?" AND (FIL_W.ORG_UNIT_ID = '"+ $P{orgUnitId} + "' OR FIL_W.WORK_EFFORT_ID = '"+ $P{workEffortId} + "')" :
(($P{orgUnitId}  != null && $P{orgUnitId}  != "" && $P{onlyFirstChildLevel}.equals("Y")) ? " AND org_unit_id_sup = '"+ $P{orgUnitId} + "'" : " AND FIL_W.ORG_UNIT_ID like '%%'")]]></defaultValueExpression>
	</parameter>
	<parameter name="workEffortTypeIdStr" class="java.lang.String">
		<defaultValueExpression><![CDATA[! $P{workEffortTypeId}.equals("20D42") ? " AND EXP.WORK_EFFORT_TYPE_ID_STR = '" + $P{workEffortTypeId} + "'"  : ""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select * from exp_ope_str EXP
inner join work_effort FIL_W
on FIL_W.work_effort_id = EXP.work_effort_id_str
/* START filterInnerJoin */
   $P!{filterInnerJoinString} 
/* END filterInnerJoin */
/* START filterLeftJoin */
  $P!{filterLeftJoinString} 
/* END filterLeftJoin */
where anno = TO_CHAR($P{monitoringDateString}::date, 'YYYY')
  /* START filterWhere */
 $P!{filterWhereString} 
   /* END filterWhere */  
 /* START orgUnitIdString */
 $P!{orgUnitIdString}
 /* END orgUnitIdString */]]>
	</queryString>
