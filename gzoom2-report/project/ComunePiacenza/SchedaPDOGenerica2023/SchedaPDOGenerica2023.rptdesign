            <xml-property name="queryText"><![CDATA[ SELECT 

    FIL_W.ETCH AS "ETCH1",
    FIL_W.WORK_EFFORT_NAME AS "NAME1",
    T_OB1.ETCH AS "T_ETCH1",
    FIL_W.SOURCE_REFERENCE_ID AS "CODE1",
    FIL_W.WORK_EFFORT_ID AS "ID1",
    P_RES_A.PARTY_NAME AS "PARTY_NAME1",
	OB3.ID_MATCH AS "ID_MATCH",
		OB3.DESCRIPTION3 AS "DESCRIPTION3",
		OB3.T_DESCRIPTION3  AS "T_DESCRIPTION3",
		OB3.T_ETCH3 AS "T_ETCH3",
		OB3.ETCH3 AS "ETCH3",
		OB3.NAME3 AS "NAME3",   
		OB3.SEQ3 AS "SEQ3",
		OB3.CODE3 AS "CODE3",
		OB3.ID3 AS "ID3",
		OB3.WORK_EFFORT_TYPE_ID3 AS "WORK_EFFORT_TYPE_ID3",
		OB3.ESTIMATED_START_DATE3 AS "ESTIMATED_START_DATE3",
		OB3.ESTIMATED_COMPLETION_DATE3 AS "ESTIMATED_COMPLETION_DATE3",
		OB3.CODE_PREFIX AS "CODE_PREFIX"
    
FROM WORK_EFFORT FIL_W 	
INNER JOIN WORK_EFFORT_TYPE T_OB1 ON T_OB1.WORK_EFFORT_TYPE_ID = FIL_W.WORK_EFFORT_TYPE_ID
	AND FIL_W.WORK_EFFORT_TYPE_ID = '18ORG1DIR'

@filterInnerJoin
@filterLeftJoin

-- vado a prendere sia obietti/attivita e processi del livello di dirigenziale e non
LEFT OUTER JOIN (
	SELECT 
		A_OB3.WORK_EFFORT_ID_FROM AS ID_MATCH,
		OB3.DESCRIPTION AS DESCRIPTION3,
		T_OB3.DESCRIPTION  AS T_DESCRIPTION3,
		T_OB3.ETCH AS T_ETCH3,
		OB3.ETCH AS ETCH3,
		OB3.WORK_EFFORT_NAME AS NAME3,   
		A_OB3.SEQUENCE_NUM AS SEQ3,
		OB3.SOURCE_REFERENCE_ID AS CODE3,
		OB3.WORK_EFFORT_ID AS ID3,
		OB3.WORK_EFFORT_TYPE_ID AS WORK_EFFORT_TYPE_ID3,
		OB3.ESTIMATED_START_DATE AS ESTIMATED_START_DATE3,
		OB3.ESTIMATED_COMPLETION_DATE AS ESTIMATED_COMPLETION_DATE3,
		T_OB3.CODE_PREFIX AS CODE_PREFIX
        
    FROM WORK_EFFORT_ASSOC A_OB3
    INNER JOIN WORK_EFFORT_ASSOC_TYPE TA_OB3 ON TA_OB3.WORK_EFFORT_ASSOC_TYPE_ID = A_OB3.WORK_EFFORT_ASSOC_TYPE_ID
	INNER JOIN WORK_EFFORT OB3 ON A_OB3.WORK_EFFORT_ID_TO = OB3.WORK_EFFORT_ID
		-- AND  (A_OB3.THRU_DATE = OB1.ESTIMATED_COMPLETION_DATE OR A_OB3.THRU_DATE = OB3.ESTIMATED_COMPLETION_DATE)
		AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND( A_OB3.FROM_DATE     <= @date3112 AND A_OB3.THRU_DATE >= @date0101    )))
	INNER JOIN WORK_EFFORT_TYPE T_OB3 ON  T_OB3.WORK_EFFORT_TYPE_ID = OB3.WORK_EFFORT_TYPE_ID

    WHERE A_OB3.WORK_EFFORT_ASSOC_TYPE_ID = '18ORGDIR'
		AND ( T_OB3.CODE_PREFIX LIKE 'O%' OR T_OB3.CODE_PREFIX LIKE 'A%' OR T_OB3.CODE_PREFIX LIKE 'P%' OR T_OB3.CODE_PREFIX LIKE 'V%')
        AND OB3.WORK_EFFORT_REVISION_ID IS NULL
        @excludeStructuralActivities
        @excludeProcesses
    UNION
    
    SELECT 
		A_OB2.WORK_EFFORT_ID_FROM AS ID_MATCH,
		OB3.DESCRIPTION AS DESCRIPTION3,
		T_OB3.DESCRIPTION  AS T_DESCRIPTION3,
		T_OB3.ETCH AS T_ETCH3,
		OB3.ETCH AS ETCH3,
		OB3.WORK_EFFORT_NAME AS NAME3,   
		A_OB3.SEQUENCE_NUM AS SEQ3,
		OB3.SOURCE_REFERENCE_ID AS CODE3,
		OB3.WORK_EFFORT_ID AS ID3,
		OB3.WORK_EFFORT_TYPE_ID AS WORK_EFFORT_TYPE_ID3,
		OB3.ESTIMATED_START_DATE AS ESTIMATED_START_DATE3,
		OB3.ESTIMATED_COMPLETION_DATE AS ESTIMATED_COMPLETION_DATE3,
		T_OB3.CODE_PREFIX
        
    FROM WORK_EFFORT_ASSOC A_OB2
    INNER JOIN WORK_EFFORT OB2 ON  A_OB2.WORK_EFFORT_ID_TO = OB2.WORK_EFFORT_ID
		AND A_OB2.WORK_EFFORT_ASSOC_TYPE_ID = '18ORGDIRC'
		AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND( A_OB2.FROM_DATE      <= @date3112 AND A_OB2.THRU_DATE >= @date0101    )))
	INNER JOIN WORK_EFFORT_TYPE T_OB2 ON T_OB2.WORK_EFFORT_TYPE_ID = OB2.WORK_EFFORT_TYPE_ID

	-- obiettivo / attivit / processo
	INNER JOIN WORK_EFFORT_ASSOC A_OB3 ON  A_OB3.WORK_EFFORT_ID_FROM  = OB2.WORK_EFFORT_ID
		AND A_OB3.WORK_EFFORT_ASSOC_TYPE_ID = '18ORGAPO'
	INNER JOIN WORK_EFFORT OB3 ON A_OB3.WORK_EFFORT_ID_TO = OB3.WORK_EFFORT_ID
		-- AND  (A_OB3.THRU_DATE = OB2.ESTIMATED_COMPLETION_DATE OR A_OB3.THRU_DATE = OB3.ESTIMATED_COMPLETION_DATE)
		AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND( A_OB3.FROM_DATE      <= @date3112 AND A_OB3.THRU_DATE >= @date0101    )))
	INNER JOIN WORK_EFFORT_TYPE T_OB3 ON  T_OB3.WORK_EFFORT_TYPE_ID = OB3.WORK_EFFORT_TYPE_ID


    WHERE ( T_OB3.CODE_PREFIX LIKE 'A%' OR T_OB3.CODE_PREFIX LIKE 'P%')
		AND OB2.WORK_EFFORT_REVISION_ID IS NULL
		AND OB3.WORK_EFFORT_REVISION_ID IS NULL
		@excludeStructuralActivities
		@excludeProcesses
    
) OB3  ON OB3.ID_MATCH = FIL_W.WORK_EFFORT_ID
   

LEFT OUTER JOIN PARTY_RELATIONSHIP PR_RES_A
     ON  PR_RES_A.PARTY_ID_FROM  = FIL_W.ORG_UNIT_ID
     AND PR_RES_A.ROLE_TYPE_ID_FROM  = FIL_W.ORG_UNIT_ROLE_TYPE_ID
     AND PR_RES_A.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
	AND (@excludeValidity = 'N' OR (@excludeValidity = 'Y' AND PR_RES_A.THRU_DATE IS NULL))
	AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND(PR_RES_A.FROM_DATE   <= @monitoringDate AND (PR_RES_A.THRU_DATE  >= @monitoringDate OR PR_RES_A.THRU_DATE IS NULL)  )))
LEFT OUTER JOIN PARTY P_RES_A ON P_RES_A.PARTY_ID = PR_RES_A.PARTY_ID_TO     

	 
WHERE 	(@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND( FIL_W.ESTIMATED_START_DATE <= @date3112 AND FIL_W.ESTIMATED_COMPLETION_DATE >= @date0101 )))
	AND FIL_W.WORK_EFFORT_REVISION_ID IS NULL
	
	@workEffortIdChild
	@workEffortId
	@orgUnitId
	@partyId
	@workEffortTypeId_Obb
		
		
	@filterWhere]]></xml-property>
            <xml-property name="designerValues"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<model:DesignValues xmlns:design="http://www.eclipse.org/datatools/connectivity/oda/design" xmlns:model="http://www.eclipse.org/birt/report/model/adapter/odaModel">
  <Version>2.0</Version>
  <design:ResultSets derivedMetaData="true">
    <design:resultSetDefinitions>
      <design:resultSetColumns>
        <design:resultColumnDefinitions>
          <design:attributes>
            <design:identifier>
              <design:name>TITOLO_RADICE</design:name>
              <design:position>1</design:position>
