                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT  P_RESP.PARTY_NAME AS  "RESP_TECNICO_DETTAGLIO" 
FROM    WORK_EFFORT_PARTY_ASSIGNMENT WA
JOIN    PARTY P_RESP ON      P_RESP.PARTY_ID = WA.PARTY_ID

WHERE   WA.ROLE_TYPE_ID LIKE 'WEM%'
AND  WA.ROLE_TYPE_ID <> 'WEM_ASSESORE'
AND (? = 'Y' OR (? = 'N' AND( WA.FROM_DATE  <= ? AND WA.THRU_DATE >= ? )))      
AND  WA.WORK_EFFORT_ID = ? 
       
ORDER BY  P_RESP.PARTY_NAME]]></xml-property>
