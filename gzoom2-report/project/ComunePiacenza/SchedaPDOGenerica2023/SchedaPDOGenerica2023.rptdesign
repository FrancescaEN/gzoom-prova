            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">ID_DIPENDENTE</property>
                    <property name="nativeName">ID_DIPENDENTE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">MATRICOLA</property>
                    <property name="nativeName">MATRICOLA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">DIPENDENTE</property>
                    <property name="nativeName">DIPENDENTE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">ID_PROFILO</property>
                    <property name="nativeName">ID_PROFILO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">PROFILO</property>
                    <property name="nativeName">PROFILO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">CATEGORIA</property>
                    <property name="nativeName">CATEGORIA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">PER_PR</property>
                    <property name="nativeName">PER_PR</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">IMPIEGATO</property>
                    <property name="nativeName">IMPIEGATO</property>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="position">9</property>
                    <property name="name">CDR_APPARTENENZA</property>
                    <property name="nativeName">CDR_APPARTENENZA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">10</property>
                    <property name="name">ANNI_PERSONA</property>
                    <property name="nativeName">ANNI_PERSONA</property>
                    <property name="dataType">float</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
PA.PARTY_ID          AS  "ID_DIPENDENTE",
PPR.PARENT_ROLE_CODE AS  "MATRICOLA",
PA.PARTY_NAME        AS  "DIPENDENTE",
PA1.PARTY_ID         AS  "ID_PROFILO",
PA1.PARTY_NAME       AS  "PROFILO",
E.DESCRIPTION 	     AS  "CATEGORIA", 
PE.employment_amount AS  "PER_PR",   
WA.ROLE_TYPE_WEIGHT  AS  "IMPIEGATO",
P_UO.PARTY_NAME     AS  "CDR_APPARTENENZA",
CASE WHEN (PE.EMPLOYMENT_AMOUNT IS NOT NULL AND WA.ROLE_TYPE_WEIGHT IS NOT NULL)  
     THEN (PE.EMPLOYMENT_AMOUNT * WA.ROLE_TYPE_WEIGHT/100)/100 
     ELSE 0.0 
END "ANNI_PERSONA"


FROM (
	SELECT 
		OB.WORK_EFFORT_ID AS ID_MATCH,
		OB.WORK_EFFORT_ID AS OB2_WORK_EFFORT_ID
        
    FROM WORK_EFFORT OB
    
    UNION
    
    SELECT 
		A_OB2.WORK_EFFORT_ID_FROM AS ID_MATCH,
		OB2.WORK_EFFORT_ID AS OB2_WORK_EFFORT_ID
        
    FROM WORK_EFFORT_ASSOC A_OB2
    INNER JOIN WORK_EFFORT OB2 ON  A_OB2.WORK_EFFORT_ID_TO = OB2.WORK_EFFORT_ID
		AND A_OB2.WORK_EFFORT_ASSOC_TYPE_ID = '18ORGDIRC'
		AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND( OB2.ESTIMATED_START_DATE      <= @date3112 AND OB2.ESTIMATED_COMPLETION_DATE >= @date0101    )))

) OB2


INNER JOIN WORK_EFFORT_PARTY_ASSIGNMENT WA ON WA.WORK_EFFORT_ID = OB2.OB2_WORK_EFFORT_ID
INNER JOIN PARTY PA ON WA.PARTY_ID = PA.PARTY_ID
INNER JOIN PARTY_PARENT_ROLE PPR ON PPR.PARTY_ID = PA.PARTY_ID
INNER JOIN PERSON PE ON WA.PARTY_ID = PE.PARTY_ID
LEFT OUTER JOIN EMPL_POSITION_TYPE E ON E.EMPL_POSITION_TYPE_ID = PE.EMPL_POSITION_TYPE_ID
LEFT OUTER JOIN PARTY_RELATIONSHIP PR ON PR.PARTY_ID_FROM = WA.PARTY_ID
	AND PR.PARTY_RELATIONSHIP_TYPE_ID = 'QUALIF'
	AND PR.THRU_DATE IS NULL
LEFT OUTER JOIN PARTY PA1 ON PR.PARTY_ID_TO = PA1.PARTY_ID
LEFT OUTER JOIN PARTY_RELATIONSHIP PR_UO ON PR_UO.PARTY_ID_TO = WA.PARTY_ID
	AND PR_UO.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_EMPLOYMENT'
	AND PR_UO.THRU_DATE IS NULL
LEFT OUTER JOIN PARTY P_UO ON P_UO.PARTY_ID = PR_UO.PARTY_ID_FROM
WHERE WA.ROLE_TYPE_ID = 'WE_ASSIGNMENT'  
	AND OB2.ID_MATCH  = ?
 	AND WA.FROM_DATE <= @date3112 
    AND WA.THRU_DATE >= @date0101



ORDER BY PA.PARTY_NAME, PA1.PARTY_NAME
]]></xml-property>
        </oda-data-set>
