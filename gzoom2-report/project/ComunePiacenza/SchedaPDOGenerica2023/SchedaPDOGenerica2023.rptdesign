SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3004  THEN TM_AMOUNT ELSE NULL END)  "BUDGET_DATO_3004",  
SUM(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'BUDGET' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3108  THEN TM_AMOUNT ELSE NULL END)  "BUDGET_DATO_3108",
