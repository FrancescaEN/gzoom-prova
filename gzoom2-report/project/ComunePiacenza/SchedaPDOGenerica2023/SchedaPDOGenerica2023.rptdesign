            <xml-property name="queryText"><![CDATA[SELECT  
    M_WORK_EFFORT_MEASURE_ID AS "M_WORK_EFFORT_MEASURE_ID", 
    GT.DESCRIPTION AS "DESCRIPTION", 
    G_ACCOUNT_NAME AS "G_ACCOUNT_NAME",
    G_DESCRIPTION AS "G_DESCRIPTION", 
    G_UOM_ABBREVIATION AS "G_UOM_ABBREVIATION", 
    G_DETAIL_ENUM_ID AS "G_DETAIL_ENUM_ID", 
    G_INPUT_ENUM_ID AS "G_INPUT_ENUM_ID", 
    WP.UOM_DESCR AS "UOM_DESCR", 
    WP.COMMENTS AS "COMMENTS", 
    M_UOM_DESCR AS "M_UOM_DESCR", 
    M_COMMENTS AS "M_COMMENTS", 
    V.M_SEQUENCE_ID AS "M_SEQUENCE_ID",
    M_PARTY_NAME AS "DESCRIZIONE_CENTRO_COSTO",  
    M_PARENT_ROLE_CODE AS "CODICE_CENTRO_COSTO",
    V.M_WE_MEASURE_TYPE_ENUM_ID AS "M_WE_MEASURE_TYPE_ENUM_ID",
    V.G_ACCOUNT_CODE AS "G_ACCOUNT_CODE",
    V.G_GL_ACCOUNT_ID AS "G_GL_ACCOUNT_ID",
    V.G_GL_ACCOUNT_TYPE_ID AS "G_GL_ACCOUNT_TYPE_ID",
    V.G_UOM_TYPE_ID AS "G_UOM_TYPE_ID",
    V.W_WORK_EFFORT_TYPE_ID AS "W_WORK_EFFORT_TYPE_ID",
    G_UOM_DECIMAL_SCALE AS "G_UOM_DECIMAL_SCALE",
    WTIC.CONTENT_ID AS "CONTENT_FOLDER_IND",
    WTIC.ETCH AS "ETCH_FOLDER_IND",
    COUNT(*) AS "COUNTER",
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3103  THEN TT_DESCRIPTION ELSE NULL END)  "ACTUAL_ACC_TRN_ABB_3103",
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3006  THEN TT_DESCRIPTION ELSE NULL END)  "ACTUAL_ACC_TRN_ABB_3006",
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3009  THEN TT_DESCRIPTION ELSE NULL END)  "ACTUAL_ACC_TRN_ABB_3009",  
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3004  THEN TT_DESCRIPTION ELSE NULL END)  "ACTUAL_ACC_TRN_ABB_3004",
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3108  THEN TT_DESCRIPTION ELSE NULL END)  "ACTUAL_ACC_TRN_ABB_3108", 
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3112  THEN TT_DESCRIPTION ELSE NULL END)  "ACTUAL_ACC_TRN_ABB_3112",
MAX(CASE WHEN TT_GL_FISCAL_TYPE_ID = 'ACTUAL' AND TM_GL_ACCOUNT_ID <> 'SCOREKPI' AND TT_TRANSACTION_DATE = @date3103  THEN TM_DESCRIPTION ELSE NULL END)  "ACTUAL_ACC_TRN_ENTRY_ABB_3103",
