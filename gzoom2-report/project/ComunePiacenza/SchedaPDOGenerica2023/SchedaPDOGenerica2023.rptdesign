            <method name="beforeOpen"><![CDATA[
this.queryText = this.queryText.replace("@excludeValidity", "'" + params["excludeValidity"].value+ "'");

this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value );
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );
/*
this.queryText = this.queryText.replace("@monitoringDate",  "'2023-12-31'");
this.queryText = this.queryText.replace("@date0101", "'2023-12-31'");
this.queryText = this.queryText.replace("@date3112", "'2023-12-31'");*/




//@workEffortIdChild
var workEffortIdChildString = '';
if (params["workEffortIdChild"].value != null &amp;&amp; params["workEffortIdChild"].value != '') {
	workEffortIdChildString = "AND ( FIL_W.WORK_EFFORT_ID = '"+ params["workEffortIdChild"].value +"' OR OB3.ID3 = '"+ params["workEffortIdChild"].value + "')";	
}
this.queryText = this.queryText.replace("@workEffortIdChild",  workEffortIdChildString );

//@workEffortId
var workEffortIdString = '';
if (params["workEffortId"].value != null &amp;&amp; params["workEffortId"].value != '') {
	//workEffortIdString = "AND FIL_W.WORK_EFFORT_ID = '"+ params["workEffortId"].value + "'";	
}
this.queryText = this.queryText.replace("@workEffortId",  workEffortIdString );

//@orgUnitId
var orgUnitIdString = '';
if (params["orgUnitId"].value != null &amp;&amp; params["orgUnitId"].value != '') {
	// orgUnitIdString = "AND FIL_W.ORG_UNIT_ID = '"+ params["orgUnitId"].value + "'";	
}
this.queryText = this.queryText.replace("@orgUnitId",  orgUnitIdString );

//@partyId
var partyIdString = '';
if (params["partyId"].value != null &amp;&amp; params["partyId"].value != '') {
	orgUnitIdString = "AND P_RES_A.PARTY_ID = '"+ params["partyId"].value + "'";	
}
this.queryText = this.queryText.replace("@partyId", partyIdString );

//@workEffortTypeId_Obb
var workEffortTypeId_Obb = '';
if (params["workEffortTypeId_Obb"].value != null &amp;&amp; params["workEffortTypeId_Obb"].value != '') {
	workEffortTypeId_Obb = " OB3.WORK_EFFORT_TYPE_ID3 LIKE  = '%"+ params["workEffortTypeId_Obb"].value + "%'";	
}
this.queryText = this.queryText.replace("@workEffortTypeId_Obb", workEffortTypeId_Obb );

//@excludeStructuralActivities
var excludeStructuralActivities = '';
if (params["excludeStructuralActivities"].value != null &amp;&amp; params["excludeStructuralActivities"].value == 'Y') {
    excludeStructuralActivities = "AND OB3.WORK_EFFORT_TYPE_ID <> '18PEG4ATT'";
}
this.queryText = this.queryText.replace("@excludeStructuralActivities", excludeStructuralActivities);

//@excludeProcesses
var excludeProcesses = '';
if (params["excludeProcesses"].value != null &amp;&amp; params["excludeProcesses"].value == 'Y') {
    excludeProcesses = "AND OB3.WORK_EFFORT_TYPE_ID <> '18PEG3PRO'";
}
this.queryText = this.queryText.replace("@excludeProcesses", excludeProcesses);




//GESTIRE PERMESSI
/**/
filter = new com.mapsengineering.base.birt.util.UtilFilter(params["userLoginId"].value, params["localDispatcherName"].value);
var filterInnerJoin = filter.getWorkEffortFilterInner();
var filterLeftJoin = filter.getWorkEffortFilterLeftJoin();
var filterWhere = filter.getWorkEffortFilterWhere();

/*
var filterInnerJoin = "";
var filterLeftJoin = "";
var filterWhere = "";
*/
this.queryText = this.queryText.replace("@filterInnerJoin",  filterInnerJoin );
this.queryText = this.queryText.replace("@filterLeftJoin",  filterLeftJoin );
this.queryText = this.queryText.replace("@filterWhere",  filterWhere );

]]></method>
