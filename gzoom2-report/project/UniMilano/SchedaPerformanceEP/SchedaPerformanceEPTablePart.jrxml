			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort"/>
		</field>
		<field name="Peso obiettivo" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="Peso obiettivo"/>
			<property name="com.jaspersoft.studio.field.label" value="Peso obiettivo"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort_assoc"/>
		</field>
		<field name="Obiettivo strategico" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Obiettivo strategico"/>
			<property name="com.jaspersoft.studio.field.label" value="Obiettivo strategico"/>
		</field>
		<field name="Soggetto a rimodulazione o sterilizzazione" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Soggetto a rimodulazione o sterilizzazione"/>
			<property name="com.jaspersoft.studio.field.label" value="Soggetto a rimodulazione o sterilizzazione"/>
		</field>
		<field name="Commento soggetto a rimodulazione o sterilizzazione" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Commento soggetto a rimodulazione o sterilizzazione"/>
			<property name="com.jaspersoft.studio.field.label" value="Commento soggetto a rimodulazione o sterilizzazione"/>
		</field>
		<field name="Stato avanzamento dell&apos;obiettivo" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name">
				<![CDATA[Stato avanzamento dell'obiettivo]]>
			</property>
			<property name="com.jaspersoft.studio.field.label">
				<![CDATA[Stato avanzamento dell'obiettivo]]>
			</property>
		</field>
		<field name="Commento stato avanzamento dell&apos;obiettivo" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name">
				<![CDATA[Commento stato avanzamento dell'obiettivo]]>
			</property>
			<property name="com.jaspersoft.studio.field.label">
				<![CDATA[Commento stato avanzamento dell'obiettivo]]>
