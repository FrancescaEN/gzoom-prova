		<field name="Autovalutazione raggiungimento obiettivo" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="Autovalutazione raggiungimento obiettivo"/>
			<property name="com.jaspersoft.studio.field.label" value="Autovalutazione raggiungimento obiettivo"/>
		</field>
		<field name="Valutazione DG raggiungimento obiettivo" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="Valutazione DG raggiungimento obiettivo"/>
