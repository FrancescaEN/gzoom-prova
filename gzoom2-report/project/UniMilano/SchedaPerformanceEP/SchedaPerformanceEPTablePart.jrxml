	<subDataset name="Dataset4" uuid="73cb13ca-1386-46d6-b23d-fd9ce933ce93">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="217"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="777"/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="postgres_unimilano "/>
		<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="826"/>
		<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="162"/>
		<parameter name="date3112sql" class="java.lang.String" isForPrompting="false"/>
		<parameter name="date0101sql" class="java.lang.String" isForPrompting="false"/>
		<queryString language="SQL">
			<![CDATA[select 
	stato.source_reference_id as "Codice stato di salute",
	stato.work_effort_name as "Stato di salute",
	indic.account_name as "Indicatore",
	max(case when wetav.tm_gl_fiscal_type_id = 'BASELINE' and wetav.tt_transaction_date =CAST($P{date3112sql} AS TIMESTAMP) then wetav.tm_amount else null end) as "Baseline",
	max(case when wetav.tm_gl_fiscal_type_id = 'BUDGET' and wetav.tt_transaction_date =CAST($P{date3112sql} AS TIMESTAMP) then wetav.tm_amount else null end) as "Target",
	indic.kpi_score_weight as "Peso indicatore"
/* PERFORMANCE AMMINISTRAZIONE CENTRALE */
from work_effort amm
/* STATO DI SALUTE */
join work_effort_assoc wea on wea.work_effort_id_from = amm.work_effort_id and wea.work_effort_assoc_type_id = '20D8CEN'
join work_effort stato on stato.work_effort_id = wea.work_effort_id_to and stato.work_effort_type_id = '20D82SAL' and stato.work_effort_revision_id is null
	and stato.estimated_start_date <= CAST($P{date3112sql} AS TIMESTAMP) and (stato.estimated_completion_date >= CAST($P{date0101sql} AS TIMESTAMP) or stato.estimated_completion_date is null)
/* AMBITO DI PERFORMANCE */
join work_effort_assoc wea2 on wea2.work_effort_id_from = stato.work_effort_id and wea2.work_effort_assoc_type_id = '20D8CEN'
join work_effort ambito on ambito.work_effort_id = wea2.work_effort_id_to and ambito.work_effort_type_id = '20D84AMB' and ambito.work_effort_revision_id is null
	and ambito.estimated_start_date <= CAST($P{date3112sql} AS TIMESTAMP) and (ambito.estimated_completion_date >= CAST($P{date0101sql} AS TIMESTAMP) or ambito.estimated_completion_date is null)
/* INDICATORI */
left join (
	select 
		wem.work_effort_id,
		gl.account_name,
		gl.gl_account_id,
		wem.kpi_score_weight 
	from work_effort_measure wem
	join gl_account gl on gl.gl_account_id = wem.gl_account_id 
	join work_effort_purpose_account wepa on wepa.gl_account_id = wem.gl_account_id and wepa.work_effort_purpose_type_id = 'INDSAL'
) indic on indic.work_effort_id = ambito.work_effort_id
/* VALORI DEGLI INDICATORI */
left join work_effort_trans_all_view wetav on wetav.m_work_effort_id = ambito.work_effort_id
where amm.work_effort_type_id = '20D80CEN' and amm.work_effort_revision_id is null
	and amm.estimated_start_date <= CAST($P{date3112sql} AS TIMESTAMP) and (amm.estimated_completion_date >= CAST($P{date0101sql} AS TIMESTAMP) or amm.estimated_completion_date is null)
group by
	stato.source_reference_id,
	stato.work_effort_name,
	indic.account_name,
	indic.kpi_score_weight
order by
	stato.source_reference_id]]>
		</queryString>
		<field name="Codice stato di salute" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Codice stato di salute"/>
			<property name="com.jaspersoft.studio.field.label" value="Codice stato di salute"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort"/>
		</field>
		<field name="Stato di salute" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Stato di salute"/>
			<property name="com.jaspersoft.studio.field.label" value="Stato di salute"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort"/>
		</field>
		<field name="Indicatore" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Indicatore"/>
			<property name="com.jaspersoft.studio.field.label" value="Indicatore"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="gl_account"/>
		</field>
		<field name="Baseline" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="Baseline"/>
			<property name="com.jaspersoft.studio.field.label" value="Baseline"/>
		</field>
		<field name="Target" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="Target"/>
			<property name="com.jaspersoft.studio.field.label" value="Target"/>
		</field>
		<field name="Peso indicatore" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="Peso indicatore"/>
			<property name="com.jaspersoft.studio.field.label" value="Peso indicatore"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort_measure"/>
		</field>
		<variable name="SumPesoInd" class="java.lang.Double" calculation="Sum">
			<variableExpression><![CDATA[$F{Peso indicatore}]]></variableExpression>
		</variable>
	</subDataset>
	<subDataset name="Dataset5" uuid="e467f642-f28e-4961-b583-30a70d443d5e">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="232"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="762"/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.jrdax"/>
		<parameter name="work_effort_id" class="java.lang.String"/>
		<parameter name="date3112sql" class="java.lang.String" isForPrompting="false"/>
		<queryString language="SQL">
			<![CDATA[select
	wem.uom_descr as "Indicatore",
	u.uom_type_id,
	u.decimal_scale,
	u.abbreviation,
	max(case when ate.gl_fiscal_type_id = 'ACTUAL' then gamrs.uom_descr else null end) as "Consuntivo",
    max(case when ate.gl_fiscal_type_id = 'ACTUAL' then ate.amount else null end) as "Consuntivo_amount",
	max(case when ate.gl_fiscal_type_id = 'BUDGET' then gamrs.uom_descr else null end) as "Target",
	max(case when ate.gl_fiscal_type_id = 'BUDGET' then ate.amount else null end) as "Target_amount"
	
/* MODELLO VALUTAZIONE DIRIGENTI */
from work_effort_measure wem  
left join acctg_trans act on act.voucher_ref = wem.work_effort_measure_id and act.transaction_date = CAST($P{date3112sql} AS TIMESTAMP)
left join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id and ate.gl_account_id <>'SCOREKPI'
left join gl_account gl on gl.gl_account_id = wem.gl_account_id
left join work_effort_purpose_account wepa2 on wepa2.gl_account_id = gl.gl_account_id 
left join uom u on u.uom_id = gl.default_uom_id 
left join gl_account_meas_rat_sc gamrs on gamrs.gl_account_id = ate.gl_account_id 
	and gamrs.uom_rating_value <= ate.amount and gamrs.uom_rating_value >= ate.amount
where wepa2.work_effort_purpose_type_id = 'INDOPE'
AND wem.work_effort_id =  $P{work_effort_id}
group by
	wem.uom_descr, u.decimal_scale, u.abbreviation, u.uom_type_id
order by
	wem.uom_descr]]>
		</queryString>
		<field name="Indicatore" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Indicatore"/>
			<property name="com.jaspersoft.studio.field.label" value="Indicatore"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort_measure"/>
		</field>
		<field name="uom_type_id" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="uom_type_id"/>
			<property name="com.jaspersoft.studio.field.label" value="uom_type_id"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="uom"/>
		</field>
		<field name="decimal_scale" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="decimal_scale"/>
			<property name="com.jaspersoft.studio.field.label" value="decimal_scale"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="uom"/>
		</field>
		<field name="abbreviation" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="abbreviation"/>
			<property name="com.jaspersoft.studio.field.label" value="abbreviation"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="uom"/>
		</field>
		<field name="Consuntivo" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Consuntivo"/>
			<property name="com.jaspersoft.studio.field.label" value="Consuntivo"/>
		</field>
		<field name="Consuntivo_amount" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="Consuntivo_amount"/>
			<property name="com.jaspersoft.studio.field.label" value="Consuntivo_amount"/>
		</field>
		<field name="Target" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Target"/>
			<property name="com.jaspersoft.studio.field.label" value="Target"/>
		</field>
		<field name="Target_amount" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="Target_amount"/>
			<property name="com.jaspersoft.studio.field.label" value="Target_amount"/>
		</field>
		<variable name="FORMAT" class="java.lang.String">
			<variableExpression><![CDATA[com.mapsengineering.base.birt.util.UtilNumber.getFormatPattern($F{decimal_scale}.intValue(), $F{abbreviation})]]></variableExpression>
		</variable>
	</subDataset>
	<subDataset name="ObOperExtraPiano" uuid="5c7aa795-1222-4c50-9a0c-1b650007e85c">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="postgres_unimilano "/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="310"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="684"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="personId" class="java.lang.String" isForPrompting="false"/>
		<parameter name="PesoObiettivi" class="java.lang.Double"/>
		<parameter name="date3112sql" class="java.lang.String" isForPrompting="false"/>
		<parameter name="date0101sql" class="java.lang.String" isForPrompting="false"/>
		<parameter name="workEffortId" class="java.lang.String" isForPrompting="false"/>
		<queryString>
			<![CDATA[/* VERSIONE V1.1 CON #COND0# = GG/MM/AAAA 
 * AGGIUNTE 3 COLONNE
 Obiettivi Operativi Seconda Tabella
 */

select
	p.party_name as "Valutato",
	strutt.party_name as "Struttura",
	wet.description as "Tipo obiettivo",
	obo.work_effort_name as "Obiettivo",
	wea3.assoc_weight as "Peso obiettivo",
	concat(obs.etch, ' - ', obs.work_effort_name) as "Obiettivo strategico",
	max(case when act.transaction_date =  CAST($P{date0101sql} AS TIMESTAMP)  and wem.gl_account_id = '10097' then gamrs.uom_descr else null end) as "Soggetto a rimodulazione o sterilizzazione",
	max(case when act.transaction_date =  CAST($P{date0101sql} AS TIMESTAMP)  and wem.gl_account_id = '10097' then act.description else null end) as "Commento soggetto a rimodulazione o sterilizzazione",
	max(case when act.transaction_date =  CAST($P{date0101sql} AS TIMESTAMP)  and wem.gl_account_id = '10098' then gamrs.uom_descr else null end) as "Stato avanzamento dell'obiettivo",
	max(case when act.transaction_date =  CAST($P{date0101sql} AS TIMESTAMP)  and wem.gl_account_id = '10098' then act.description else null end) as "Commento stato avanzamento dell'obiettivo",
	max(case when act.transaction_date =  CAST($P{date3112sql} AS TIMESTAMP)  and wem.gl_account_id = '10099' then ate.amount else null end) as "Autovalutazione raggiungimento obiettivo",
	max(case when act.transaction_date =  CAST($P{date3112sql} AS TIMESTAMP)  and wem.gl_account_id = '10100' then ate.amount else null end) as "Valutazione DG raggiungimento obiettivo",
	max(case when wen.sequence_id = '110' then nd.note_info else null end) as "Motivazione sterilizzazione o rimodulazione",
	max(case when wen.sequence_id = '120' then nd.note_info else null end) as "Descrizione rimodulazione",
	obo.work_effort_id as work_effort_id
/* MODELLO VALUTAZIONE DIRIGENTI */
from work_effort dir
/* DIRIGENTE */
join work_effort_party_assignment wepa on wepa.work_effort_id = dir.work_effort_id and wepa.role_type_id = 'WEM_EVAL_IN_CHARGE'
join party p on p.party_id = wepa.party_id
/* STRUTTURA */
join party strutt on strutt.party_id = dir.org_unit_id
/* COLLEGAMENTO A OBIETTIVI */
join work_effort_assoc wea on wea.work_effort_id_from = dir.work_effort_id and wea.work_effort_assoc_type_id = '20D2SCH'
join work_effort_assoc wea2 on wea2.work_effort_id_from = wea.work_effort_id_to and wea2.work_effort_assoc_type_id = '20D2SCH'
join work_effort_assoc wea3 on wea3.work_effort_id_from = wea2.work_effort_id_to and wea3.work_effort_assoc_type_id = '20D2SCH'
join work_effort obo on obo.work_effort_id = wea3.work_effort_id_to and obo.work_effort_type_id = '20D26OOE' and obo.work_effort_revision_id is null
	and obo.estimated_start_date <=  CAST($P{date3112sql} AS TIMESTAMP)  and (obo.estimated_completion_date >= CAST($P{date0101sql} AS TIMESTAMP)  or obo.estimated_completion_date is null)
join work_effort_type wet on wet.work_effort_type_id = obo.work_effort_type_id
/* COLLEGAMENTO A OBIETTIVO STRATEGICO */
left join work_effort_assoc wea4 on wea4.work_effort_id_to = obo.work_effort_id and wea4.work_effort_assoc_type_id = '20D6OBSC'
left join work_effort obs on obs.work_effort_id = wea4.work_effort_id_from and obs.work_effort_type_id = '20D64OBS' and obs.work_effort_revision_id is null
	and obs.estimated_start_date <=  CAST($P{date3112sql} AS TIMESTAMP)  and (obs.estimated_completion_date >=  CAST($P{date0101sql} AS TIMESTAMP)  or obs.estimated_completion_date is null)	
/* VALUTAZIONE E MONITORAGGIO */
left join work_effort_measure wem on wem.work_effort_id = obo.work_effort_id
left join acctg_trans act on act.voucher_ref = wem.work_effort_measure_id
left join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id
left join gl_account_meas_rat_sc gamrs on gamrs.gl_account_id = ate.gl_account_id 
	and ate.amount <= gamrs.uom_rating_value and ate.amount >= gamrs.uom_rating_value 
/* NOTE DEGLI OBIETTIVI */
left join work_effort_note wen on wen.work_effort_id = obo.work_effort_id
left join note_data nd on nd.note_id = wen.note_id and TO_CHAR(ND.NOTE_DATE_TIME, 'YYYY-MM-DD') LIKE concat('%', DATE_PART('year',  CAST($P{date0101sql} AS TIMESTAMP) ::date), '%')
where dir.work_effort_type_id = '20D20SCH' and dir.work_effort_revision_id is null
	and dir.estimated_start_date <=  CAST($P{date3112sql} AS TIMESTAMP)  and (dir.estimated_completion_date >=  CAST($P{date0101sql} AS TIMESTAMP)  or dir.estimated_completion_date is null)
	and (p.party_id = $P{personId} or dir.work_effort_id = $P{workEffortId})
	 and dir.work_effort_name like '%Modello valutazione EP%'
group by
	wea3.assoc_weight,
	p.party_name,
	strutt.party_name,
	wet.description,
	obo.work_effort_name,
	concat(obs.etch, ' - ', obs.work_effort_name),
	obo.work_effort_id
order by
	p.party_name,
	strutt.party_name,
	wet.description,
	obo.work_effort_name]]>
		</queryString>
		<field name="Valutato" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Valutato"/>
			<property name="com.jaspersoft.studio.field.label" value="Valutato"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="party"/>
		</field>
		<field name="Struttura" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Struttura"/>
			<property name="com.jaspersoft.studio.field.label" value="Struttura"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="party"/>
		</field>
		<field name="Tipo obiettivo" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Tipo obiettivo"/>
			<property name="com.jaspersoft.studio.field.label" value="Tipo obiettivo"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort_type"/>
		</field>
		<field name="Obiettivo" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Obiettivo"/>
			<property name="com.jaspersoft.studio.field.label" value="Obiettivo"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort"/>
		</field>
