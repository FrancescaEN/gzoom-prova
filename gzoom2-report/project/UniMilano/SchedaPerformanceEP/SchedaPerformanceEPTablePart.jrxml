		</variable>
		<variable name="SumValPond" class="java.lang.Double" calculation="Sum">
			<variableExpression><![CDATA[($F{Peso obiettivo} * $F{Valutazione DG raggiungimento obiettivo}) / 100]]></variableExpression>
			<initialValueExpression><![CDATA[0]]></initialValueExpression>
		</variable>
