	<subDataset name="ObiettiviOperativiDS" uuid="8ba92253-cd1c-4e1a-9bd1-6c3ca577a670">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="220"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="774"/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="project\UniMilano\SchedaPerformanceEP\DataAdapter.jrdax"/>
		<parameter name="personId" class="java.lang.String" isForPrompting="false"/>
		<parameter name="PesoObiettivi" class="java.lang.Double"/>
		<parameter name="date3112sql" class="java.lang.String" isForPrompting="false"/>
		<parameter name="date0101sql" class="java.lang.String" isForPrompting="false"/>
		<parameter name="workEffortId" class="java.lang.String" isForPrompting="false"/>
		<queryString language="SQL">
			<![CDATA[/* VERSIONE V1.1 CON #COND0# = GG/MM/AAAA 
 * AGGIUNTE 3 COLONNE
 * ObiettiviOperativiDS
 */

select
	p.party_name as "Valutato",
	strutt.party_name as "Struttura",
	wet.description as "Tipo obiettivo",
	obo.work_effort_name as "Obiettivo",
	wea3.assoc_weight as "Peso obiettivo",
	concat(obs.etch, ' - ', obs.work_effort_name) as "Obiettivo strategico",
	max(case when  wem.gl_account_id = '10097' then gamrs.uom_descr else null end) as "Soggetto a rimodulazione o sterilizzazione",
	max(case when  wem.gl_account_id = '10097' then act.description else null end) as "Commento soggetto a rimodulazione o sterilizzazione",
	max(case when  wem.gl_account_id = '10098' then gamrs.uom_descr else null end) as "Stato avanzamento dell'obiettivo",
	max(case when wem.gl_account_id = '10098' then act.description else null end) as "Commento stato avanzamento dell'obiettivo",
	max(case when wem.gl_account_id = '10099' then ate.amount else null end) as "Autovalutazione raggiungimento obiettivo",
	max(case when wem.gl_account_id = '10100' then ate.amount else null end) as "Valutazione DG raggiungimento obiettivo",
	max(case when wen.sequence_id = '210' then nd.note_info else null end) as "Motivazione annullamento o rimodulazione",
    max(case when wen.sequence_id = '220' then nd.note_info else null end) as "Descrizione stato avanzamento",
    max(case when wen.sequence_id = '310' then nd.note_info else null end) as "Descrizione sintetica delle azioni svolte",
	obo.work_effort_id as work_effort_id
/* MODELLO VALUTAZIONE DIRIGENTI */
from work_effort dir
/* DIRIGENTE */
join work_effort_party_assignment wepa on wepa.work_effort_id = dir.work_effort_id and wepa.role_type_id = 'WEM_EVAL_IN_CHARGE'
join party p on p.party_id = wepa.party_id
/* STRUTTURA */
join party strutt on strutt.party_id = dir.org_unit_id
/* COLLEGAMENTO A OBIETTIVI */
join work_effort_assoc wea on wea.work_effort_id_from = dir.work_effort_id and wea.work_effort_assoc_type_id = '20D2SCH'
join work_effort_assoc wea2 on wea2.work_effort_id_from = wea.work_effort_id_to and wea2.work_effort_assoc_type_id = '20D2SCH'
join work_effort_assoc wea3 on wea3.work_effort_id_from = wea2.work_effort_id_to and wea3.work_effort_assoc_type_id = '20D2SCH'
join work_effort obo on obo.work_effort_id = wea3.work_effort_id_to and obo.work_effort_type_id in ('20D26OOP','20D26OOE') and obo.work_effort_revision_id is null
	and obo.estimated_start_date <= CAST($P{date3112sql} AS TIMESTAMP) and (obo.estimated_completion_date >= CAST($P{date0101sql} AS TIMESTAMP) or obo.estimated_completion_date is null)
join work_effort_type wet on wet.work_effort_type_id = obo.work_effort_type_id
/* COLLEGAMENTO A OBIETTIVO STRATEGICO */
left join work_effort_assoc wea4 on wea4.work_effort_id_to = obo.work_effort_id and wea4.work_effort_assoc_type_id = '20D6OBSC'
left join work_effort obs on obs.work_effort_id = wea4.work_effort_id_from and obs.work_effort_type_id = '20D64OBS' and obs.work_effort_revision_id is null
	and obs.estimated_start_date <= CAST($P{date3112sql} AS TIMESTAMP) and (obs.estimated_completion_date >= CAST($P{date0101sql} AS TIMESTAMP) or obs.estimated_completion_date is null)	
/* VALUTAZIONE E MONITORAGGIO */
left join work_effort_measure wem on wem.work_effort_id = obo.work_effort_id
left join acctg_trans act on act.voucher_ref = wem.work_effort_measure_id
left join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id
left join gl_account_meas_rat_sc gamrs on gamrs.gl_account_id = ate.gl_account_id 
	and ate.amount <= gamrs.uom_rating_value and ate.amount >= gamrs.uom_rating_value 
/* NOTE DEGLI OBIETTIVI */
left join work_effort_note wen on wen.work_effort_id = obo.work_effort_id
left join note_data nd on nd.note_id = wen.note_id 
and TO_CHAR(ND.NOTE_DATE_TIME, 'YYYY-MM-DD') LIKE concat('%', DATE_PART('year', CAST($P{date0101sql} AS TIMESTAMP)::date), '%')
where dir.work_effort_type_id = '20D20SCH' and dir.work_effort_revision_id is null
	and dir.estimated_start_date <= CAST($P{date3112sql} AS TIMESTAMP) and (dir.estimated_completion_date >= CAST($P{date0101sql} AS TIMESTAMP) or dir.estimated_completion_date is null)
	and (p.party_id = $P{personId} or dir.work_effort_id = $P{workEffortId})
	 and dir.work_effort_name like '%Modello valutazione EP%'
group by
	wea3.assoc_weight,
	p.party_name,
	strutt.party_name,
	wet.description,
	obo.work_effort_name,
	concat(obs.etch, ' - ', obs.work_effort_name),
	obo.work_effort_id
order by
	p.party_name,
	strutt.party_name,
	wet.description,
	obo.work_effort_name]]>
		</queryString>
		<field name="Valutato" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Valutato"/>
			<property name="com.jaspersoft.studio.field.label" value="Valutato"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="party"/>
		</field>
