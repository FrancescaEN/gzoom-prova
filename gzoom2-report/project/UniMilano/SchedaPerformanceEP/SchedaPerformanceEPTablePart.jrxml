	<subDataset name="Dataset2" uuid="9333c97f-180e-4e04-afdb-835b139e0cbf">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="postgres_unimilano "/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="183"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="811"/>
		<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="694"/>
		<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="293"/>
		<parameter name="personId" class="java.lang.String" isForPrompting="false"/>
		<parameter name="PesoComportamenti" class="java.lang.Double"/>
		<parameter name="ValAteneo" class="java.lang.Double"/>
		<parameter name="PesoAteneo" class="java.lang.Double"/>
		<parameter name="ValAmm" class="java.lang.Double"/>
		<parameter name="PesoAmm" class="java.lang.Double"/>
		<parameter name="PesoObb" class="java.lang.Double"/>
		<parameter name="ValObb" class="java.lang.Double"/>
		<parameter name="date3112sql" class="java.lang.String" isForPrompting="false"/>
		<parameter name="date0101sql" class="java.lang.String" isForPrompting="false"/>
		<parameter name="workEffortId" class="java.lang.String" isForPrompting="false"/>
		<parameter name="PesoObbPIANO" class="java.lang.Double"/>
		<parameter name="PesoObbEXTRA" class="java.lang.Double"/>
		<parameter name="ValObbPIANO" class="java.lang.Double"/>
		<parameter name="ValObbEXTRA" class="java.lang.Double"/>
		<queryString language="SQL">
			<![CDATA[select  
	p.party_name as "Valutato",
	strutt.party_name as "Struttura",
	gl.account_name as "Comportamento",
	gl.description as "Descrizione Comportamento",
	wem.kpi_score_weight as "Peso comportamenti",
	-- comp.weight_kpi as "Peso comportamenti organizzativi",
	wea.assoc_weight as "Peso comportamenti organizzativi",
	indic.amount as "Valutazione",
	dir.work_effort_id as work_effort_id
/* MODELLO VALUTAZIONE DIRIGENTI */
from work_effort dir
/* DIRIGENTE */
join work_effort_party_assignment wepa on wepa.work_effort_id = dir.work_effort_id and wepa.role_type_id = 'WEM_EVAL_IN_CHARGE'
join party p on p.party_id = wepa.party_id
/* STRUTTURA */
join party strutt on strutt.party_id = dir.org_unit_id
/* VALUTAZIONE COMPORTAMENTI */
join work_effort_assoc wea on wea.work_effort_id_from = dir.work_effort_id and wea.work_effort_assoc_type_id = '20D2SCH'
join work_effort comp on comp.work_effort_id = wea.work_effort_id_to and comp.work_effort_type_id = '20D2S2COM' and comp.work_effort_revision_id is null
	and comp.estimated_start_date <=  CAST($P{date3112sql} AS TIMESTAMP) and (comp.estimated_completion_date >=  CAST($P{date0101sql} AS TIMESTAMP) or comp.estimated_completion_date is null)
/* INDICATORI COMPORTAMENTI */
left join work_effort_measure wem on wem.work_effort_id = comp.work_effort_id
left join gl_account gl on gl.gl_account_id = wem.gl_account_id
left join (
	select act.voucher_ref ,
			ate.amount ,
			ate.gl_account_id 
	from acctg_trans act
	join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id  and ate.gl_account_id = 'SCOREKPI'
	where act.transaction_date = CAST($P{date3112sql} AS TIMESTAMP)
) indic on indic.voucher_ref = wem.work_effort_measure_id  where dir.work_effort_type_id = '20D20SCH' and dir.work_effort_revision_id is null
	and dir.estimated_start_date <= CAST($P{date3112sql} AS TIMESTAMP) and (dir.estimated_completion_date >= CAST($P{date0101sql} AS TIMESTAMP) or dir.estimated_completion_date is null)
	and (p.party_id = $P{personId} or dir.work_effort_id = $P{workEffortId})
	and wem.gl_account_id <> 'SCORE'
	and dir.work_effort_name like '%Modello valutazione EP%']]>
		</queryString>
		<field name="Valutato" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Valutato"/>
			<property name="com.jaspersoft.studio.field.label" value="Valutato"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="party"/>
		</field>
