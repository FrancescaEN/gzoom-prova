			<property name="com.jaspersoft.studio.field.name" value="Valutazione"/>
			<property name="com.jaspersoft.studio.field.label" value="Valutazione"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="acctg_trans_entry"/>
		</field>
		<field name="work_effort_id" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="work_effort_id"/>
			<property name="com.jaspersoft.studio.field.label" value="work_effort_id"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort"/>
		</field>
		<variable name="SumPesoComp" class="java.lang.Double" calculation="Sum">
			<variableExpression><![CDATA[$F{Peso comportamenti}]]></variableExpression>
			<initialValueExpression><![CDATA[0]]></initialValueExpression>
		</variable>
		<variable name="SumValPond" class="java.lang.Double" calculation="Sum">
			<variableExpression><![CDATA[$F{Peso comportamenti} * $F{Valutazione} / 100]]></variableExpression>
			<initialValueExpression><![CDATA[0]]></initialValueExpression>
		</variable>
