			<groupExpression><![CDATA[$F{Valutazione}]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="Dataset3" uuid="9acf0e55-376a-4e4f-918b-ce412d2a074c">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="81"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="914"/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="postgres_unimilano "/>
		<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="609"/>
		<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="380"/>
		<parameter name="Ruolo" class="java.lang.String"/>
		<parameter name="date3112sql" class="java.lang.String" isForPrompting="false"/>
		<parameter name="date0101sql" class="java.lang.String" isForPrompting="false"/>
		<queryString language="SQL">
			<![CDATA[/* VERSIONE V1.2 CON ORDINAMENTO PER AREA E INSERIMENTO CODICE INDICATORE 
 * AGGIUNTI INDICATORI E NOTE DI MONITORAGGIO 
 */

select
	concat(area.etch, ' - ', area.work_effort_name) as "Area strategica",
	obs.work_effort_name as "Obiettivo strategico",
	obs.etch as "Codice Obiettivo strategico",
	monit.rim as "Soggetto a rimodulazione o annullamento",
	monit.rim_nota as "Commento Soggetto a rimodulazione o annullamento",
	monit.stato as "Stato avanzamento dell'obiettivo",
	monit.stato_nota as "Commento Stato avanzamento dell'obiettivo",
	note.note_info as "Descrizione stato avanzamento",
	weta.g_account_name as "Indicatore",
	weta.g_account_code as "Codice Indicatore",
	weta.g_uom_abbreviation as "UDM",
	max(case when weta.tt_transaction_date =CAST($P{date3112sql} AS TIMESTAMP) and weta.tm_gl_fiscal_type_id = 'BASELINE' then 
	(case when weta.g_uom_type_id = 'RATING_SCALE' then weta.r_uom_code else 
	(case when left(to_char(weta.tm_amount,'FM999999999.00'), 1) = '.' then concat('0', to_char(weta.tm_amount,'FM999999999.00')) else to_char(weta.tm_amount,'FM999999999.00') end) end) else null end) as "Baseline",
	max(case when weta.tt_transaction_date = CAST($P{date3112sql} AS TIMESTAMP) and weta.tm_gl_fiscal_type_id = 'BUDGET' then 
	(case when weta.g_uom_type_id = 'RATING_SCALE' then weta.r_uom_code else 
	(case when left(to_char(weta.tm_amount,'FM999999999.00'), 1) = '.' then concat('0', to_char(weta.tm_amount,'FM999999999.00')) else to_char(weta.tm_amount,'FM999999999.00') end) end) else null end) as "Target",
	max(case when weta.tt_transaction_date = CAST($P{date3112sql} AS TIMESTAMP) and weta.tm_gl_fiscal_type_id = 'ACTUAL' then 
	(case when weta.g_uom_type_id = 'RATING_SCALE' then weta.r_uom_code else 
	(case when left(to_char(weta.tm_amount,'FM999999999.00'), 1) = '.' then concat('0', to_char(weta.tm_amount,'FM999999999.00')) else to_char(weta.tm_amount,'FM999999999.00') end) end) else null end) as "Consuntivo",
	max(case when weta.tt_transaction_date = CAST($P{date3112sql} AS TIMESTAMP) and weta.tm_gl_fiscal_type_id = 'BUDGET' then weta.tt_description else null end) as "Nota target",
	max(case when weta.tt_transaction_date =CAST($P{date3112sql} AS TIMESTAMP) and weta.tm_gl_fiscal_type_id = 'ACTUAL' then weta.tt_description else null end) as "Nota consuntivo",
	max(case when weta.tt_transaction_date = cast(concat(DATE_PART('year', CAST($P{date3112sql} AS TIMESTAMP)::date) + 1, '-12-31') as date) and weta.tm_gl_fiscal_type_id = 'BUDGET' then 
	(case when weta.g_uom_type_id = 'RATING_SCALE' then weta.r_uom_code else 
	(case when left(to_char(weta.tm_amount,'FM999999999.00'), 1) = '.' then concat('0', to_char(weta.tm_amount,'FM999999999.00')) else to_char(weta.tm_amount,'FM999999999.00') end) end) else null end) as "Target anno+1",
	max(case when weta.tt_transaction_date = cast(concat(DATE_PART('year', CAST($P{date3112sql} AS TIMESTAMP)::date) + 2, '-12-31') as date) and weta.tm_gl_fiscal_type_id = 'BUDGET' then 
	(case when weta.g_uom_type_id = 'RATING_SCALE' then weta.r_uom_code else 
	(case when left(to_char(weta.tm_amount,'FM999999999.00'), 1) = '.' then concat('0', to_char(weta.tm_amount,'FM999999999.00')) else to_char(weta.tm_amount,'FM999999999.00') end) end) else null end) as "Target anno+2",
	weta.m_kpi_score_weight as "Peso",
	max(case when score.tt_transaction_date =CAST($P{date3112sql} AS TIMESTAMP) then score.tm_amount else null end) as "Punteggio",
	wept.description as "Tipologia obiettivo"
/* AREA STRATEGICA */
from work_effort area
/* OBIETTIVO STRATEGICO */
join work_effort_assoc wea on wea.work_effort_id_from = area.work_effort_id and wea.work_effort_assoc_type_id = '20D6ATE'
join work_effort obs on obs.work_effort_id = wea.work_effort_id_to and obs.work_effort_type_id = '20D64OBS' and obs.work_effort_revision_id is null
	and obs.estimated_start_date <=CAST($P{date3112sql} AS TIMESTAMP) and (obs.estimated_completion_date >=CAST($P{date0101sql} AS TIMESTAMP)  or obs.estimated_completion_date is null)
	join work_effort_purpose_type wept on wept.work_effort_purpose_type_id = obs.work_effort_purpose_type_id
/* INDICATORI OBIETTIVO STRATEGICO */
left join work_effort_trans_all_view weta on weta.m_work_effort_id = obs.work_effort_id 
	and weta.m_from_date <= CAST($P{date3112sql} AS TIMESTAMP) and weta.m_thru_date >=CAST($P{date0101sql} AS TIMESTAMP) and weta.g_gl_account_type_id = 'INDRIS'
/* MONITORAGGIO */
left join (
	select 
		wem.work_effort_id,
		max(case when ate.gl_account_id = '10097' then gamrs.uom_descr else null end) as rim,
		max(case when ate.gl_account_id = '10097' then act.description else null end) as rim_nota,
		max(case when ate.gl_account_id = '10098' then gamrs.uom_descr else null end) as stato,
		max(case when ate.gl_account_id = '10098' then act.description else null end) as stato_nota
	from work_effort_measure wem
	join work_effort_purpose_account wepa on wepa.gl_account_id = wem.gl_account_id and wepa.work_effort_purpose_type_id = 'MONOPE'
	join acctg_trans act on act.voucher_ref = wem.work_effort_measure_id 
	join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id 
	left join gl_account_meas_rat_sc gamrs on gamrs.gl_account_id = wem.gl_account_id 
		and gamrs.uom_rating_value = ate.amount
	group by wem.work_effort_id 
) monit on monit.work_effort_id = obs.work_effort_id
/* NOTE */
left join (
	select 
		wen.work_effort_id,
		nd.note_info 
	from work_effort_note wen
	join note_data nd on nd.note_id = wen.note_id and to_char(nd.note_date_time, 'YYYY-MM-DD') like '%' || cast(DATE_PART('year', CAST($P{date3112sql} AS TIMESTAMP) ::date) as varchar) || '%'
) note on note.work_effort_id = obs.work_effort_id 
/* PUNTEGGIO OBIETTIVO STRATEGICO */
left join work_effort_trans_all_view score on score.m_work_effort_id = obs.work_effort_id 
	and score.m_from_date <=CAST($P{date3112sql} AS TIMESTAMP) and score.m_thru_date >=CAST($P{date0101sql} AS TIMESTAMP)  and score.m_gl_account_id = 'SCORE'
where area.work_effort_type_id = '20D62ARE' and area.work_effort_revision_id is null
	and area.estimated_start_date <=CAST($P{date3112sql} AS TIMESTAMP) and (area.estimated_completion_date >= CAST($P{date0101sql} AS TIMESTAMP)  or area.estimated_completion_date is null)
	
group by
	concat(area.etch, ' - ', area.work_effort_name),
	obs.work_effort_name,
	obs.etch,
	weta.g_account_name,
	weta.g_account_code,
	weta.g_uom_abbreviation,
	monit.rim,
	monit.rim_nota,
	monit.stato,
	note.note_info,
	monit.stato_nota,
	weta.m_kpi_score_weight,
    area.source_reference_id,
    wept.description
order by
    area.source_reference_id,
    obs.etch]]>
		</queryString>
