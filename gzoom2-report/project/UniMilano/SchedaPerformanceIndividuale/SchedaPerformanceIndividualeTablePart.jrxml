	<subDataset name="Dataset4" uuid="73cb13ca-1386-46d6-b23d-fd9ce933ce93">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="217"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="777"/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="postgres_unimilano "/>
		<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="826"/>
		<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="162"/>
		<parameter name="date3112sql" class="java.lang.String" isForPrompting="false"/>
		<parameter name="date0101sql" class="java.lang.String" isForPrompting="false"/>
		<queryString language="SQL">
			<![CDATA[select 
	stato.source_reference_id as "Codice stato di salute",
	stato.work_effort_name as "Stato di salute",
	indic.account_name as "Indicatore",
	max(case when wetav.tm_gl_fiscal_type_id = 'BASELINE' and wetav.tt_transaction_date =CAST($P{date3112sql} AS TIMESTAMP) then wetav.tm_amount else null end) as "Baseline",
	max(case when wetav.tm_gl_fiscal_type_id = 'BUDGET' and wetav.tt_transaction_date =CAST($P{date3112sql} AS TIMESTAMP) then wetav.tm_amount else null end) as "Target",
	indic.kpi_score_weight as "Peso indicatore"
/* PERFORMANCE AMMINISTRAZIONE CENTRALE */
from work_effort amm
/* STATO DI SALUTE */
join work_effort_assoc wea on wea.work_effort_id_from = amm.work_effort_id and wea.work_effort_assoc_type_id = '20D8CEN'
join work_effort stato on stato.work_effort_id = wea.work_effort_id_to and stato.work_effort_type_id = '20D82SAL' and stato.work_effort_revision_id is null
	and stato.estimated_start_date <= CAST($P{date3112sql} AS TIMESTAMP) and (stato.estimated_completion_date >= CAST($P{date0101sql} AS TIMESTAMP) or stato.estimated_completion_date is null)
/* AMBITO DI PERFORMANCE */
join work_effort_assoc wea2 on wea2.work_effort_id_from = stato.work_effort_id and wea2.work_effort_assoc_type_id = '20D8CEN'
join work_effort ambito on ambito.work_effort_id = wea2.work_effort_id_to and ambito.work_effort_type_id = '20D84AMB' and ambito.work_effort_revision_id is null
	and ambito.estimated_start_date <= CAST($P{date3112sql} AS TIMESTAMP) and (ambito.estimated_completion_date >= CAST($P{date0101sql} AS TIMESTAMP) or ambito.estimated_completion_date is null)
/* INDICATORI */
left join (
	select 
		wem.work_effort_id,
		gl.account_name,
		gl.gl_account_id,
		wem.kpi_score_weight 
	from work_effort_measure wem
	join gl_account gl on gl.gl_account_id = wem.gl_account_id 
	join work_effort_purpose_account wepa on wepa.gl_account_id = wem.gl_account_id and wepa.work_effort_purpose_type_id = 'INDSAL'
) indic on indic.work_effort_id = ambito.work_effort_id
/* VALORI DEGLI INDICATORI */
left join work_effort_trans_all_view wetav on wetav.m_work_effort_id = ambito.work_effort_id
where amm.work_effort_type_id = '20D80CEN' and amm.work_effort_revision_id is null
	and amm.estimated_start_date <= CAST($P{date3112sql} AS TIMESTAMP) and (amm.estimated_completion_date >= CAST($P{date0101sql} AS TIMESTAMP) or amm.estimated_completion_date is null)
group by
	stato.source_reference_id,
	stato.work_effort_name,
	indic.account_name,
	indic.kpi_score_weight
order by
	stato.source_reference_id]]>
		</queryString>
		<field name="Codice stato di salute" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Codice stato di salute"/>
			<property name="com.jaspersoft.studio.field.label" value="Codice stato di salute"/>
