			<property name="com.jaspersoft.studio.field.name" value="Peso comportamenti organizzativi"/>
			<property name="com.jaspersoft.studio.field.label" value="Peso comportamenti organizzativi"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort_assoc"/>
		</field>
