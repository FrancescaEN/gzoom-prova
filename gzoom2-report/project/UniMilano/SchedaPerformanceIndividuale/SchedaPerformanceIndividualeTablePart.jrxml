		</field>
		<field name="Soggetto a rimodulazione o sterilizzazione" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Soggetto a rimodulazione o sterilizzazione"/>
			<property name="com.jaspersoft.studio.field.label" value="Soggetto a rimodulazione o sterilizzazione"/>
		</field>
		<field name="Commento soggetto a rimodulazione o sterilizzazione" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Commento soggetto a rimodulazione o sterilizzazione"/>
			<property name="com.jaspersoft.studio.field.label" value="Commento soggetto a rimodulazione o sterilizzazione"/>
		</field>
