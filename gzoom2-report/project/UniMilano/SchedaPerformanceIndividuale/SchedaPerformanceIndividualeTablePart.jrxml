	<field name="Risultato performance amministrazione centrale" class="java.lang.Double">
		<property name="com.jaspersoft.studio.field.name" value="Risultato performance amministrazione centrale"/>
		<property name="com.jaspersoft.studio.field.label" value="Risultato performance amministrazione centrale"/>
