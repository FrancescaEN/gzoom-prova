	<subDataset name="Dataset5" uuid="e467f642-f28e-4961-b583-30a70d443d5e">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="232"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="762"/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.jrdax"/>
		<parameter name="work_effort_id" class="java.lang.String"/>
		<parameter name="date3112sql" class="java.lang.String" isForPrompting="false"/>
		<queryString language="SQL">
			<![CDATA[select
	wem.uom_descr as "Indicatore",
	u.uom_type_id,
	u.decimal_scale,
	u.abbreviation,
	max(case when ate.gl_fiscal_type_id = 'ACTUAL' then gamrs.uom_descr else null end) as "Consuntivo",
    max(case when ate.gl_fiscal_type_id = 'ACTUAL' then ate.amount else null end) as "Consuntivo_amount",
	max(case when ate.gl_fiscal_type_id = 'BUDGET' then gamrs.uom_descr else null end) as "Target",
	max(case when ate.gl_fiscal_type_id = 'BUDGET' then ate.amount else null end) as "Target_amount"
	
/* MODELLO VALUTAZIONE DIRIGENTI */
from work_effort_measure wem  
left join acctg_trans act on act.voucher_ref = wem.work_effort_measure_id and act.transaction_date = CAST($P{date3112sql} AS TIMESTAMP)
left join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id and ate.gl_account_id<>'SCOREKPI'
left join gl_account gl on gl.gl_account_id = wem.gl_account_id
left join work_effort_purpose_account wepa2 on wepa2.gl_account_id = gl.gl_account_id 
left join uom u on u.uom_id = gl.default_uom_id 
left join gl_account_meas_rat_sc gamrs on gamrs.gl_account_id = ate.gl_account_id 
	and gamrs.uom_rating_value <= ate.amount and gamrs.uom_rating_value >= ate.amount
where wepa2.work_effort_purpose_type_id = 'INDOPE'
AND wem.work_effort_id =  $P{work_effort_id}
group by
	wem.uom_descr, u.decimal_scale, u.abbreviation, u.uom_type_id
order by
	wem.uom_descr]]>
		</queryString>
