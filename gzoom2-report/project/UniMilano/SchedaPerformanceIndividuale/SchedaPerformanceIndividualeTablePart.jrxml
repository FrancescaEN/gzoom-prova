	<parameter name="personId" class="java.lang.String" isForPrompting="false"/>
	<parameter name="workEffortId" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[/* VERSIONE V1.1 CON 2022 = AAAA + peso da modelli
 * NESSUN FILTRO SU STRUTTURA
 */

select 
	valut.party_name as "Valutato",
	CONCAT(ppr.parent_role_code, ' - ',strutt.party_name) as "Struttura",
	templ.work_effort_name as "Modello di valutazione",
	-- val.assoc_weight as "Peso da modello",
	ate.amount as "Risultato valutazione",	
	max(case when wen.sequence_id = '120' then nd.note_info else null end) as "Note del valutatore",
	max(case when wen.sequence_id = '220' then nd.note_info else null end) as "Note del valutato",
	max(case when val.work_effort_type_id = '20D2S2ATE' then val.amount else null end) as "Risultato performance di ateneo",
	max(case when val.work_effort_type_id = '20D2S2AMM' then val.amount else null end) as "Risultato performance amministrazione centrale",
	max(case when val.work_effort_type_id = '20D2S2OBI' then val.amount else null end) as "Risultato obiettivi operativi",
	max(case when val.work_effort_type_id = '20D2S2COM' then val.amount else null end) as "Risultato comportamenti organizzativi",
	ept.description as "Ruolo",
	max(case when val.work_effort_type_id = '20D2S2ATE' then val.assoc_weight else null end) as "Peso Risultato performance di ateneo",
	max(case when val.work_effort_type_id = '20D2S2AMM' then val.assoc_weight else null end) as "Peso Risultato performance amministrazione centrale",
	max(case when val.work_effort_type_id = '20D2S2OBI' then val.assoc_weight else null end) as "Peso Risultato obiettivi operativi",
	max(case when val.work_effort_type_id = '20D2S2COM' then val.assoc_weight else null end) as "Peso Risultato comportamenti organizzativi",
	FIL_W.work_effort_id as work_effort_id
/* SCHEDA FIL_WIGENTE */
from work_effort FIL_W 
/* VALUTATO */
join work_effort_party_assignment wepa on wepa.work_effort_id = FIL_W.work_effort_id and wepa.role_type_id = 'WEM_EVAL_IN_CHARGE'
join party valut on valut.party_id = wepa.party_id
/* RUOLO */
join person pe on pe.party_id = valut.party_id

/* START filterInnerJoin */
   $P!{filterInnerJoinString} 
/* END filterInnerJoin */
/* START filterLeftJoin */
  $P!{filterLeftJoinString} 
/* END filterLeftJoin */

left join empl_position_type ept on ept.empl_position_type_id = pe.empl_position_type_id
/* UNITA' RESPONSABILE */
join party strutt on strutt.party_id = FIL_W.org_unit_id
join party_parent_role ppr on ppr.party_id=strutt.party_id
/* MODELLO DI VALUTAZIONE */
join work_effort_assoc wea on wea.work_effort_id_from = FIL_W.work_effort_id and wea.work_effort_assoc_type_id = 'TEMPL'
join work_effort templ on templ.work_effort_id = wea.work_effort_id_to and templ.work_effort_type_id = '20D2M0SCH' and templ.work_effort_revision_id is null
	and templ.estimated_start_date <= CAST($P{date3112sql} AS TIMESTAMP) and (templ.estimated_completion_date >= CAST($P{date0101sql} AS TIMESTAMP) or templ.estimated_completion_date is null)
/* NOTE DEL VALUTATO E DEL VALUTATORE */
left join work_effort_note wen on wen.work_effort_id = FIL_W.work_effort_id 
left join note_data nd on nd.note_id = wen.note_id and nd.note_date_time = CAST($P{monitoringDateString} AS TIMESTAMP)
/* RISULTATO ELEMENTI DI VALUTAZIONE */
left join(
	select 
		wea2.work_effort_id_from,
		ate.amount,
		wea2.assoc_weight,
		elem.work_effort_type_id 
	from work_effort_assoc wea2
	join work_effort elem on elem.work_effort_id = wea2.work_effort_id_to and elem.work_effort_revision_id is null
		and elem.estimated_start_date <= CAST($P{date3112sql} AS TIMESTAMP) and (elem.estimated_completion_date >= CAST($P{date0101sql} AS TIMESTAMP) or elem.estimated_completion_date is null)
	left join work_effort_measure wem on wem.work_effort_id = elem.work_effort_id 
	left join acctg_trans act on act.voucher_ref = wem.work_effort_measure_id and act.transaction_date = CAST($P{date3112sql} AS TIMESTAMP)
	left join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id and ate.gl_account_id = 'SCORE'
	where wea2.work_effort_assoc_type_id = '20D2SCH'
) val on val.work_effort_id_from = FIL_W.work_effort_id 
/* RISULTATO VALUTAZIONE */
left join work_effort_measure wem on wem.work_effort_id = FIL_W.work_effort_id 
left join acctg_trans act on act.voucher_ref = wem.work_effort_measure_id and act.transaction_date = CAST($P{date3112sql} AS TIMESTAMP)
left join acctg_trans_entry ate on ate.acctg_trans_id = act.acctg_trans_id and ate.gl_account_id = 'SCORE'
where FIL_W.work_effort_type_id = '20D20SCH' and FIL_W.work_effort_revision_id is null
	and FIL_W.estimated_start_date <= CAST($P{date3112sql} AS TIMESTAMP) and (FIL_W.estimated_completion_date >= CAST($P{date0101sql} AS TIMESTAMP) or FIL_W.estimated_completion_date is null)
	and (valut.party_id = $P{personId} or FIL_W.work_effort_id = $P{workEffortId})
	and (templ.work_effort_name like '%Modello valutazione dirigenti%' or templ.work_effort_name like '%Modello valutazione Direttore Generale%')
  /* START filterWhere */
 $P!{filterWhereString} 
   /* END filterWhere */
 
group by
	ate.amount,	
	valut.party_name,
	-- strutt.party_name,
	CONCAT(ppr.parent_role_code, ' - ',strutt.party_name),
	templ.work_effort_name,
	-- val.assoc_weight,
	FIL_W.work_effort_id,
	ept.description]]>
	</queryString>
	<field name="Valutato" class="java.lang.String">
