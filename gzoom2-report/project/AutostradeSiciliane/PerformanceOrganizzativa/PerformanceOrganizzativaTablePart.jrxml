			<property name="com.jaspersoft.studio.field.label" value="anno_fine"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="exp_org_ot_ind"/>
		</field>
		<field name="indicatore" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="indicatore"/>
			<property name="com.jaspersoft.studio.field.label" value="indicatore"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="exp_org_ot_ind"/>
		</field>
		<field name="commento_base_line" class="java.lang.String">
