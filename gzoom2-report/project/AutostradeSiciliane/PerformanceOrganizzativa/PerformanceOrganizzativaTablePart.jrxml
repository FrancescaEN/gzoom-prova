	<subDataset name="Dataset_RisultatiTriennio" uuid="30b74846-f0ea-46be-a1b2-5c96ca0f99fc">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="project\RegioneSiciliana\PerformanceOrganizzativa\DataAdapter.xml"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="0"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="1000"/>
		<parameter name="eInRendicontazione" class="java.lang.Boolean"/>
		<parameter name="p_isTestMode" class="java.lang.Boolean">
			<defaultValueExpression><![CDATA[false]]></defaultValueExpression>
		</parameter>
		<parameter name="p_anno" class="java.lang.String"/>
		<parameter name="p_annoDopo" class="java.lang.Integer"/>
		<parameter name="p_annoDopoAncora" class="java.lang.Integer"/>
		<parameter name="p_workEffortIdOt" class="java.lang.String">
			<defaultValueExpression><![CDATA["44771"]]></defaultValueExpression>
		</parameter>
		<queryString language="SQL">
			<![CDATA[-- query effettiva su EXP_ORG_OT_IND

select 
	-- logici
	eooi.work_effort_id_ot,
	-- da visualizzare
	eooi.anno_inizio as anno_inizio,
	eooi.anno_fine as anno_fine,
	eooi.indicatore as indicatore,
	concat(
		eooi.base_line,
		case when eooi.commento_base_line is null then '' else concat(chr(10), eooi.commento_base_line) end
		)
	as commento_base_line,
	concat(
		eooi.target_aa,
		case when eooi.commento_target_aa is null then '' else concat(chr(10), eooi.commento_target_aa) end
		)
	as commento_target_aa,
	concat(
		eooi.target_aa_1,
		case when eooi.commento_target_aa_1 is null then '' else concat(chr(10), eooi.commento_target_aa_1) end
		)
	as commento_target_aa_1,
	concat(
		eooi.target_aa_2,
		case when eooi.commento_target_aa_2 is null then '' else concat(chr(10), eooi.commento_target_aa_2) end
		)
	as commento_target_aa_2,
	concat(
		eooi.consuntivo,
		case when eooi.commento_consuntivo is null then '' else concat(chr(10), eooi.commento_consuntivo) end
		)
	as commento_consuntivo,
	eooi.risultato_ind as risultato_ind
from EXP_ORG_OT_IND eooi
where eooi.work_effort_id_ot = $P{p_workEffortIdOt}

-- query farlocca
/*
select 
	-- logici
	eooi.work_effort_id,
	-- da visualizzare
	'2021' as anno_inizio,
	'2023' as anno_fine,
	'Percentuale di sentenze massime e pubblicate' as indicatore,
	'Target raggiunto al 31/12/2020' as commento_base_line,
	'70%' as commento_target_aa,
	'obiettivo si conclude con annualità 2021' as commento_target_aa_1,
	'obiettivo si conclude con annualità 2021' as commento_target_aa_2,
	'70%' as commento_consuntivo,
	'100%' as risultato_ind
from work_effort eooi
limit 3
* 
*/]]>
		</queryString>
		<field name="work_effort_id_ot" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="work_effort_id_ot"/>
