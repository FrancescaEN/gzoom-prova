		<parameterDescription><![CDATA[Parametro per distinguere ANTE (visible = true) da POST (false)]]></parameterDescription>
		<defaultValueExpression><![CDATA[//!$P{_dataSelezionataEst3112}
DAY($P{monitoringDate}) != 31 || MONTH($P{monitoringDate}) != 12]]></defaultValueExpression>
	</parameter>
	<parameter name="_testMode" class="java.lang.Boolean">
		<parameterDescription><![CDATA[Può essere messo a true solo in sviluppo]]></parameterDescription>
		<defaultValueExpression><![CDATA[false]]></defaultValueExpression>
	</parameter>
	<parameter name="_dataSelezionata" class="java.lang.String">
		<defaultValueExpression><![CDATA[IF ($P{_testMode},
	"Data in input: " + DAY($P{monitoringDate}) + "/" + MONTH($P{monitoringDate}) + "/" + YEAR($P{monitoringDate}),
	"")]]></defaultValueExpression>
	</parameter>
	<parameter name="_dataSelezionataEst3112" class="java.lang.Boolean">
		<defaultValueExpression><![CDATA[DAY($P{monitoringDate}) == 31 && MONTH($P{monitoringDate}) == 12]]></defaultValueExpression>
	</parameter>
	<parameter name="workEffortIdConstraint" class="java.lang.String">
		<defaultValueExpression><![CDATA[IF ($P{workEffortId} != null && $P{workEffortId}  != ""  && LEN($P{workEffortId}) != 0,
	" AND FIL_W.WORK_EFFORT_ID = '"+ $P{workEffortId} + "' "  ,
	" AND true"
	)]]></defaultValueExpression>
	</parameter>
	<parameter name="workEffortId" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[-- query PRINCIPALE (root): EXP_ORG_STR join (1-to-many) con EXP_ORG_OT

select
----------- EXP_ORG_STR ----------
-- logici
eos.work_effort_id_str as "work_effort_id_str_EXP_ORG_STR",
-- da visualizzare
eos.anno_inizio as "anno_inizio",
eos.anno_fine as "anno_fine",
eos.anno as "anno",
eos.des_pre_ass as "des_pre_ass",
eos.des_dip_cra as "des_dip_cra",
eos.dirigente as "dirigente",
----------- EXP_ORG_OT -----------
-- logici
eoo.work_effort_id_str as "work_effort_id_str_EXP_ORG_OT",
-- da visualizzare in report
eoo.des_ipp as "des_ipp",
eoo.titolo_ot as "titolo_ot",
eoo.des_ot as "des_ot",
eoo.risultato_ot as "risultato_ot",
eoo.cod_programma as "cod_programma",
eoo.des_programma as "des_programma",
eoo.etch_os as "etch_os",
eoo.des_os as "des_os",
eoo.str_coinv as "str_coinv",
--
eoo.work_effort_id_ot as "work_effort_id_ot",
FIL_W.work_effort_id as soloPerJoin
from exp_org_str as eos
inner join EXP_ORG_OT as eoo on eos.work_effort_id_str = eoo.work_effort_id_str
----------- work_effort FIL_W -----------
inner join work_effort FIL_W on FIL_W.work_effort_id = eos.work_effort_id_str
/* START filterInnerJoin */
 $P!{filterInnerJoinString} 
/* END filterInnerJoin */
/* START filterLeftJoin */
 $P!{filterLeftJoinString} 
/* END filterLeftJoin */
where eos.anno = TO_CHAR($P{monitoringDateString}::date, 'YYYY')
  /* START filterWhere */
 $P!{filterWhereString} 
-- Condizione aggiunta solo se il filtro opzionale 'Unità Responsabile' (orgUnitId) è stato specificato dall'utente
/* START orgUnitIdString */
$P!{orgUnitIdString}
/* END orgUnitIdString */
-- Condizione aggiunta solo se il filtro su workEffortId è stato specificato (stampa di dettaglio)
/* START workEffortIdConstraint */
$P!{workEffortIdConstraint}
/* END workEffortIdConstraint */
order by eos.cod_pre_ass desc, eos.cod_dip_cra desc]]>
	</queryString>
