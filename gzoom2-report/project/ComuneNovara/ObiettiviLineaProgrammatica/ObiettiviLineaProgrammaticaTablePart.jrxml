			<property name="com.jaspersoft.studio.field.label" value="ID linea"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort"/>
		</field>
		<group name="Group1" isStartNewPage="true" isReprintHeaderOnEachPage="true">
