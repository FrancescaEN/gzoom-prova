		<queryString>
			<![CDATA[/* LINEA PROGRAMMATICA */
select 
	concat(linea.etch, ' - ', linea.work_effort_name) as "Linea programmatica",
	linea.work_effort_id as "ID linea"
from work_effort linea
where linea.work_effort_type_id = '20D62LIN' and linea.work_effort_revision_id is null
	and linea.estimated_start_date <= CAST($P{date3112sql}AS TIMESTAMP) and linea.estimated_completion_date >= CAST($P{date0101sql} AS TIMESTAMP)
order by
	linea.etch]]>
		</queryString>
		<field name="Linea programmatica" class="java.lang.String">
