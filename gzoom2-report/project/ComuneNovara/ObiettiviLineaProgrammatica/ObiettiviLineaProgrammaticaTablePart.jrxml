	<subDataset name="DatasetDummy" uuid="29c868d5-049f-4596-8cce-72ebd300379f">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="postgres_gzoom_maps"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="date3112sql" class="java.lang.String"/>
		<parameter name="date0101sql" class="java.lang.String"/>
		<queryString>
			<![CDATA[select 
	concat(linea.etch, ' - ', linea.work_effort_name) as "Linea programmatica",
	concat(ind.etch, ' - ', ind.work_effort_name) as "Indirizzo strategico",
	concat(man.etch, ' - ', man.work_effort_name) as "Obiettivo di mandato",
	fil_w.work_effort_name as "Obiettivo strategico",
	resp.party_name as "Responsabile",
	linea.work_effort_id as "ID linea",
	ind.work_effort_id as "ID indirizzo",
	man.work_effort_id as "ID mandato",
	fil_w.etch as "Etichetta obiettivo strategico",
	fil_w.work_effort_id as "ID obiettivo strategico",
	resp.party_id as "ID struttura"
/* LINEA PROGRAMMATICA */
from work_effort linea
/* INDIRIZZO STRATEGICO */
join work_effort_assoc wea on wea.work_effort_id_from = linea.work_effort_id and wea.work_effort_assoc_type_id = '20D6'
join work_effort ind on ind.work_effort_id = wea.work_effort_id_to and ind.work_effort_type_id = '20D64OST' and ind.work_effort_revision_id is null
	and ind.estimated_start_date <= CAST($P{date3112sql}AS TIMESTAMP) and ind.estimated_completion_date >= CAST($P{date0101sql}AS TIMESTAMP)
/* OBIETTIVO DI MANDATO */
join work_effort_assoc wea2 on wea2.work_effort_id_from = ind.work_effort_id and wea2.work_effort_assoc_type_id = '20D6C'
join work_effort man on man.work_effort_id = wea2.work_effort_id_to and man.work_effort_type_id = '20D66OOP' and man.work_effort_revision_id is null
	and man.estimated_start_date <= CAST($P{date3112sql}AS TIMESTAMP) and man.estimated_completion_date >= CAST($P{date0101sql}AS TIMESTAMP)
/* OBIETTIVO STRATEGICO */
join work_effort_assoc wea3 on wea3.work_effort_id_from = man.work_effort_id and wea3.work_effort_assoc_type_id = '20D6OC'
join work_effort fil_w on fil_w.work_effort_id = wea3.work_effort_id_to and fil_w.work_effort_type_id = '20P44OPD' and fil_w.work_effort_revision_id is null
	and fil_w.estimated_start_date <= CAST($P{date3112sql}AS TIMESTAMP) and fil_w.estimated_completion_date >= CAST($P{date0101sql}AS TIMESTAMP)
/* RESPONSABILE */
left join party p on p.party_id = fil_w.org_unit_id
left join party_relationship pr on pr.party_id_from = p.party_id and pr.thru_date is null and pr.party_relationship_type_id = 'ORG_RESPONSIBLE'
left join party resp on resp.party_id = pr.party_id_to 
where linea.work_effort_type_id = '20D62LIN' and linea.work_effort_revision_id is null
	and linea.estimated_start_date <= CAST($P{date3112sql}AS TIMESTAMP) and linea.estimated_completion_date >= CAST($P{date0101sql} AS TIMESTAMP)
order by
	linea.etch,
	ind.etch,
	man.etch,
	fil_w.work_effort_name]]>
		</queryString>
