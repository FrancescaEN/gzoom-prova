			<![CDATA[/* INDIRIZZO STRATEGICO */
select 
	concat(ind.etch, ' - ', ind.work_effort_name) as "Indirizzo strategico",
	ind.work_effort_id as "ID indirizzo"
from work_effort_assoc wea
join work_effort ind on ind.work_effort_id = wea.work_effort_id_to and ind.work_effort_type_id = '20D64OST' and ind.work_effort_revision_id is null
	and ind.estimated_start_date <= CAST($P{date3112sql}AS TIMESTAMP) and ind.estimated_completion_date >= CAST($P{date0101sql}AS TIMESTAMP)
where wea.work_effort_assoc_type_id = '20D6'  and wea.work_effort_id_from =  $P{idLinea} 
order by
	ind.etch]]>
		</queryString>
