			<property name="com.jaspersoft.studio.field.label" value="ID OBS"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort"/>
		</field>
		<field name="Etichetta obiettivo strategico" class="java.lang.String">
