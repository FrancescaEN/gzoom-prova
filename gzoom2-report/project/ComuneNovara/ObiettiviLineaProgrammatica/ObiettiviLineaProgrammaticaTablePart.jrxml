	<subDataset name="Dataset4" uuid="1b88eec0-8404-47e6-9d95-ab506e72ce15">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="postgres_gzoom_maps"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="292"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="703"/>
		<parameter name="idObiettivoMandato" class="java.lang.String"/>
		<parameter name="localDispatcherName" class="java.lang.String">
			<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
		</parameter>
		<parameter name="monitoringDate" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[TODAY( )]]></defaultValueExpression>
		</parameter>
		<parameter name="date3112" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilDateTime.getMonthEndFromDatetime("12",$P{REPORT_TIME_ZONE}.getID(),YEAR($P{monitoringDate}), $P{REPORT_LOCALE}.getDefault())]]></defaultValueExpression>
		</parameter>
		<parameter name="date3112sql" class="java.lang.String">
			<defaultValueExpression><![CDATA[SUBSTITUTE(com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc($P{date3112}, $P{odaDialect}),"'","")]]></defaultValueExpression>
		</parameter>
		<parameter name="date0101" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilDateTime.getMonthStartFromDatetime("1",$P{REPORT_TIME_ZONE}.getID(),YEAR($P{monitoringDate}), $P{REPORT_LOCALE}.getDefault())]]></defaultValueExpression>
		</parameter>
		<parameter name="date0101sql" class="java.lang.String">
			<defaultValueExpression><![CDATA[SUBSTITUTE(com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc($P{date0101}, $P{odaDialect}),"'","")]]></defaultValueExpression>
		</parameter>
		<parameter name="odaDialect" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[/* OBIETTIVO STRATEGICO */
select 
	fil_w.work_effort_name as "Obiettivo strategico",
	fil_w.work_effort_id as "ID OBS",
	fil_w.etch as "Etichetta obiettivo strategico",
	resp.party_name as "Responsabile",
	resp.party_id as "ID struttura"
from work_effort_assoc wea3
join work_effort fil_w on fil_w.work_effort_id = wea3.work_effort_id_to and fil_w.work_effort_type_id = '20P44OPD' and fil_w.work_effort_revision_id is null
	and fil_w.estimated_start_date <= CAST($P{date3112sql}AS TIMESTAMP) and fil_w.estimated_completion_date >= CAST($P{date0101sql}AS TIMESTAMP)
/* RESPONSABILE */
left join party p on p.party_id = fil_w.org_unit_id
left join party_relationship pr on pr.party_id_from = p.party_id and pr.thru_date is null and pr.party_relationship_type_id = 'ORG_RESPONSIBLE'
left join party resp on resp.party_id = pr.party_id_to 
where wea3.work_effort_assoc_type_id = '20D6OC' and wea3.work_effort_id_from =  $P{idObiettivoMandato} 
order by
	fil_w.work_effort_name]]>
		</queryString>
