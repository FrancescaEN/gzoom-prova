	<subDataset name="Dataset3" uuid="103ee222-d318-407e-b491-6cb3853165bf">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="postgres_gzoom_maps"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="idSoggetto" class="java.lang.String"/>
		<parameter name="localDispatcherName" class="java.lang.String">
			<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
		</parameter>
		<parameter name="monitoringDate" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[TODAY( )]]></defaultValueExpression>
		</parameter>
		<parameter name="date3112" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilDateTime.getMonthEndFromDatetime("12",$P{REPORT_TIME_ZONE}.getID(),YEAR($P{monitoringDate}), $P{REPORT_LOCALE}.getDefault())]]></defaultValueExpression>
		</parameter>
		<parameter name="date3112sql" class="java.lang.String"/>
		<parameter name="date0101" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilDateTime.getMonthStartFromDatetime("1",$P{REPORT_TIME_ZONE}.getID(),YEAR($P{monitoringDate}), $P{REPORT_LOCALE}.getDefault())]]></defaultValueExpression>
		</parameter>
		<parameter name="date0101sql" class="java.lang.String"/>
		<parameter name="odaDialect" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[/* LA PERSONA È ASSEGNATA A UNA FASE FIGLIA DI UN OBIETTIVO */
select 
	wepa2.party_id,
	ob.source_reference_id as codice_ob,
	ob.work_effort_name as nome_ob,
	ob.work_effort_id as id_ob,
	fas.source_reference_id as codice_fas,
	fas.work_effort_name as nome_fas,
	fas.etch as etch_fas,
	fas.work_effort_id as id_fas,
	wepa2.role_type_weight as percentuale_fas,
	wepa2.from_date as data_inizio,
	wepa2.thru_date as data_fine
from work_effort_party_assignment wepa2 
join work_effort fas on fas.work_effort_id = wepa2.work_effort_id and fas.work_effort_type_id = '20P46FAS' and fas.work_effort_revision_id is null
	and fas.estimated_start_date <=  CAST($P{date3112sql}AS TIMESTAMP) and fas.estimated_completion_date >=  CAST($P{date0101sql}AS TIMESTAMP)
join work_effort ob on ob.work_effort_id = fas.work_effort_parent_id and ob.work_effort_type_id in ('20P44OPD', '20P44SER') and ob.work_effort_revision_id is null
	and ob.estimated_start_date <=  CAST($P{date3112sql}AS TIMESTAMP) and ob.estimated_completion_date >=  CAST($P{date0101sql}AS TIMESTAMP)
where wepa2.role_type_id = 'WE_ASSIGNMENT' and wepa2.from_date <=  CAST($P{date3112sql}AS TIMESTAMP) and wepa2.thru_date >=  CAST($P{date0101sql}AS TIMESTAMP)
	and wepa2.party_id =  $P{idSoggetto} 
group by
	wepa2.party_id,	ob.source_reference_id,	ob.work_effort_name, ob.work_effort_id,	fas.source_reference_id, fas.work_effort_name,
	fas.etch, fas.work_effort_id, wepa2.role_type_weight, wepa2.from_date, wepa2.thru_date]]>
		</queryString>
		<field name="party_id" class="java.lang.String">
