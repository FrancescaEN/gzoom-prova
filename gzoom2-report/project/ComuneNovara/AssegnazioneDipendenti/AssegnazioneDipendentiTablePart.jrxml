	<subDataset name="Dataset1" uuid="9c3c9652-fadc-4637-9b5e-e3b979c8ed7f">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="postgres_gzoom_maps"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="241"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="754"/>
		<parameter name="localDispatcherName" class="java.lang.String">
			<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
		</parameter>
		<parameter name="monitoringDate" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[TODAY( )]]></defaultValueExpression>
		</parameter>
		<parameter name="date3112" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilDateTime.getMonthEndFromDatetime("12",$P{REPORT_TIME_ZONE}.getID(),YEAR($P{monitoringDate}), $P{REPORT_LOCALE}.getDefault())]]></defaultValueExpression>
		</parameter>
		<parameter name="date3112sql" class="java.lang.String"/>
		<parameter name="date0101" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilDateTime.getMonthStartFromDatetime("1",$P{REPORT_TIME_ZONE}.getID(),YEAR($P{monitoringDate}), $P{REPORT_LOCALE}.getDefault())]]></defaultValueExpression>
		</parameter>
		<parameter name="date0101sql" class="java.lang.String"/>
		<parameter name="odaDialect" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
		</parameter>
		<parameter name="idLinea" class="java.lang.String"/>
		<parameter name="filterWhereString" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[$P{filterWhereString}]]></defaultValueExpression>
		</parameter>
		<parameter name="filterLeftJoinString" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[$P{filterLeftJoinString}]]></defaultValueExpression>
		</parameter>
		<parameter name="filterInnerJoinString" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[$P{filterInnerJoinString}]]></defaultValueExpression>
		</parameter>
		<parameter name="orgUnitId" class="java.lang.String">
			<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
		</parameter>
		<parameter name="orgUnitIdString" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[$P{orgUnitIdString}]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[/* STRUTTURA */
select
	ppr.parent_role_code as "Codice struttura",
	strutt.party_name as "Struttura",
	strutt.party_id as "ID struttura"
from party strutt
join party_parent_role ppr on ppr.party_id = strutt.party_id and ppr.role_type_id = 'ORGANIZATION_UNIT'
join party_role prole on prole.party_id = ppr.party_id 
/* HA ALMENO UN SOGGETTO */
join party_relationship pr on pr.party_id_from = strutt.party_id and pr.party_relationship_type_id = 'ORG_EMPLOYMENT'
	and pr.from_date <= CAST($P{date3112sql}AS TIMESTAMP) and (pr.thru_date >= CAST($P{date0101sql}AS TIMESTAMP) or pr.thru_date is null)
/* IL SOGGETTO DEVE AVERE ALMENO UN OBIETTIVO ASSEGNATO */
join work_effort_party_assignment wepa on wepa.party_id = pr.party_id_to
	and wepa.role_type_id = 'WE_ASSIGNMENT' and wepa.from_date <= CAST($P{date3112sql}AS TIMESTAMP) and wepa.thru_date >= CAST($P{date0101sql}AS TIMESTAMP)
join work_effort we on we.work_effort_id = wepa.work_effort_id and we.work_effort_type_id in ('20P44OPD', '20P44SER', '20P46FAS') and we.work_effort_revision_id is null
	and we.estimated_start_date <= CAST($P{date3112sql}AS TIMESTAMP) and we.estimated_completion_date >= CAST($P{date0101sql}AS TIMESTAMP)
 $P!{filterInnerJoinString} 
 $P!{filterLeftJoinString} 
where strutt.party_type_id = 'PARTY_GROUP' and strutt.status_id = 'PARTY_ENABLED'
 $P!{filterWhereString} 
  and (($P!{orgUnitIdString} and prole.role_type_id = '30SSL') or (($P!{orgUnitIdString} and prole.role_type_id = '20SPL') or (strutt.party_id in (
		select 
			pr2.party_id_to 
		from party_relationship pr2
		join party strutt on strutt.party_id = pr2.party_id_from 
		join party_role prole on prole.party_id = strutt.party_id 
		where $P!{orgUnitIdString} and prole.role_type_id = '20SPL' and pr2.party_relationship_type_id = 'GROUP_ROLLUP'
			and (pr2.from_date <= CAST($P{date3112sql}AS TIMESTAMP) and (pr2.thru_date >= CAST($P{date0101sql}AS TIMESTAMP) or pr2.thru_date is null)))
	)))
group by
	ppr.parent_role_code,
	strutt.party_name,
	strutt.party_id
order by
	ppr.parent_role_code]]>
		</queryString>
		<field name="Codice struttura" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Codice struttura"/>
			<property name="com.jaspersoft.studio.field.label" value="Codice struttura"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="party_parent_role"/>
		</field>
		<field name="Struttura" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Struttura"/>
			<property name="com.jaspersoft.studio.field.label" value="Struttura"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="party"/>
		</field>
		<field name="ID struttura" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="ID struttura"/>
			<property name="com.jaspersoft.studio.field.label" value="ID struttura"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="party"/>
		</field>
		<group name="Group1" isStartNewPage="true" isReprintHeaderOnEachPage="true">
			<groupExpression><![CDATA[$F{ID struttura}]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="Dataset2" uuid="16dc5e45-a364-48d6-9e16-61303e04abb9">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="postgres_gzoom_maps"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="localDispatcherName" class="java.lang.String">
			<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
		</parameter>
		<parameter name="monitoringDate" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[TODAY( )]]></defaultValueExpression>
		</parameter>
		<parameter name="date3112" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilDateTime.getMonthEndFromDatetime("12",$P{REPORT_TIME_ZONE}.getID(),YEAR($P{monitoringDate}), $P{REPORT_LOCALE}.getDefault())]]></defaultValueExpression>
		</parameter>
		<parameter name="date3112sql" class="java.lang.String"/>
		<parameter name="date0101" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilDateTime.getMonthStartFromDatetime("1",$P{REPORT_TIME_ZONE}.getID(),YEAR($P{monitoringDate}), $P{REPORT_LOCALE}.getDefault())]]></defaultValueExpression>
		</parameter>
		<parameter name="date0101sql" class="java.lang.String"/>
		<parameter name="odaDialect" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
		</parameter>
		<parameter name="idStruttura" class="java.lang.String"/>
		<queryString>
			<![CDATA[/* ELENCO DEI SOGGETTI APPARTENENTI ALLA STRUTTURA */
select 
	sogg.party_name as "Soggetto",
	sogg.party_id as "ID soggetto",
	ept.description as "Categoria economica"
from party_relationship pr 
join party sogg on sogg.party_id = pr.party_id_to and sogg.party_type_id = 'PERSON' and sogg.status_id = 'PARTY_ENABLED'
/* CATEGORIA ECONOMICA DEL SOGGETTO */
join person pe on pe.party_id = sogg.party_id 
join empl_position_type ept on ept.empl_position_type_id = pe.empl_position_type_id 
/* IL SOGGETTO DEVE AVERE ALMENO UN OBIETTIVO ASSEGNATO */
join work_effort_party_assignment wepa on wepa.party_id = sogg.party_id 
	and wepa.role_type_id = 'WE_ASSIGNMENT' and wepa.from_date <= CAST($P{date3112sql}AS TIMESTAMP) and wepa.thru_date >= CAST($P{date0101sql}AS TIMESTAMP)
join work_effort we on we.work_effort_id = wepa.work_effort_id and we.work_effort_type_id in ('20P44OPD', '20P44SER', '20P46FAS') and we.work_effort_revision_id is null
	and we.estimated_start_date <= CAST($P{date3112sql}AS TIMESTAMP) and we.estimated_completion_date >= CAST($P{date0101sql}AS TIMESTAMP)
where pr.party_relationship_type_id = 'ORG_EMPLOYMENT'
	and pr.from_date <= CAST($P{date3112sql}AS TIMESTAMP) and (pr.thru_date >= CAST($P{date0101sql}AS TIMESTAMP) or pr.thru_date is null)
	and pr.party_id_from =  $P{idStruttura} 
group by
	sogg.party_name,
	sogg.party_id,
	ept.description
order by
	sogg.party_name]]>
		</queryString>
		<field name="Soggetto" class="java.lang.String">
