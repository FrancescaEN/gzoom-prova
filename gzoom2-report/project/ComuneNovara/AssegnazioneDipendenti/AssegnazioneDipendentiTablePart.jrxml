		<parameter name="idPartyId" class="java.lang.String"/>
		<queryString>
			<![CDATA[select 
	wepa.party_id,
	wepa.role_type_weight,
	ob.source_reference_id as codice_ob,
	ob.work_effort_name nome_ob,
	null codice_fas,
	null nome_fas,
	null id_fas
from work_effort_party_assignment wepa 
join work_effort ob on ob.work_effort_id = wepa.work_effort_id and ob.work_effort_type_id in ('20P44OPD', '20P44SER') and ob.work_effort_revision_id is null
	and ob.estimated_start_date <=  CAST($P{date3112sql}AS TIMESTAMP) and ob.estimated_completion_date >=  CAST($P{date0101sql}AS TIMESTAMP)
where wepa.role_type_id = 'WE_ASSIGNMENT' and wepa.from_date <=  CAST($P{date3112sql}AS TIMESTAMP) and wepa.thru_date >=  CAST($P{date0101sql}AS TIMESTAMP)
and ob.work_effort_id= $P{idObiettivo} 
union all
select 
	wepa.party_id,
	wepa.role_type_weight,
	ob.source_reference_id as codice_ob,
	ob.work_effort_name as nome_ob,
	fas.source_reference_id as codice_fas,
	fas.work_effort_name as nome_fas,
	fas.work_effort_id as id_fas
from work_effort_party_assignment wepa 
join work_effort fas on fas.work_effort_id = wepa.work_effort_id and fas.work_effort_type_id = '20P46FAS' and fas.work_effort_revision_id is null
	and fas.estimated_start_date <=  CAST($P{date3112sql}AS TIMESTAMP) and fas.estimated_completion_date >=  CAST($P{date0101sql}AS TIMESTAMP)
join work_effort ob on ob.work_effort_id = fas.work_effort_parent_id and ob.work_effort_type_id in ('20P44OPD', '20P44SER') and ob.work_effort_revision_id is null
	and ob.estimated_start_date <=  CAST($P{date3112sql}AS TIMESTAMP) and ob.estimated_completion_date >=  CAST($P{date0101sql}AS TIMESTAMP)
where wepa.role_type_id = 'WE_ASSIGNMENT' and wepa.from_date <=  CAST($P{date3112sql}AS TIMESTAMP) and wepa.thru_date >=  CAST($P{date0101sql}AS TIMESTAMP)
	and ob.work_effort_id = $P{idObiettivo} 
order by
	codice_ob,
	codice_fas]]>
		</queryString>
