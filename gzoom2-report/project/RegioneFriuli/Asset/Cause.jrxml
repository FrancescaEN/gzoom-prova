			<band height="20">
				<textField textAdjust="StretchHeight">
					<reportElement mode="Opaque" x="0" y="0" width="555" height="20" forecolor="#878787" backcolor="#EDEDED" uuid="fcc7cd5b-fef9-42a0-be01-d67f201b43d1">
						<property name="com.jaspersoft.studio.unit.x" value="px"/>
					</reportElement>
					<box>
						<pen lineWidth="0.2"/>
						<topPen lineWidth="0.2" lineStyle="Solid" lineColor="#878787"/>
						<leftPen lineWidth="0.2" lineStyle="Solid" lineColor="#878787"/>
						<bottomPen lineWidth="0.2" lineStyle="Solid" lineColor="#878787"/>
						<rightPen lineWidth="0.2" lineStyle="Solid" lineColor="#878787"/>
					</box>
					<textElement textAlignment="Center" verticalAlignment="Middle">
						<font size="10"/>
					</textElement>
					<textFieldExpression><![CDATA[$F{ETCH}]]></textFieldExpression>
				</textField>
			</band>
		</groupHeader>
	</group>
	<detail>
		<band height="18" splitType="Immediate">
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" stretchType="ContainerHeight" x="0" y="0" width="555" height="18" uuid="56e7cde0-ec2c-45ee-9000-7332c128210b">
					<property name="com.jaspersoft.studio.unit.leftIndent" value="px"/>
					<property name="com.jaspersoft.studio.unit.rightIndent" value="px"/>
					<property name="com.jaspersoft.studio.unit.spacingBefore" value="px"/>
					<property name="com.jaspersoft.studio.unit.spacingAfter" value="px"/>
					<property name="com.jaspersoft.studio.unit.x" value="px"/>
				</reportElement>
				<box>
					<topPen lineWidth="0.2" lineStyle="Solid" lineColor="#878787"/>
					<leftPen lineWidth="0.2" lineStyle="Solid" lineColor="#878787"/>
					<bottomPen lineWidth="0.2" lineStyle="Solid" lineColor="#878787"/>
					<rightPen lineWidth="0.2" lineStyle="Solid" lineColor="#878787"/>
				</box>
				<textElement markup="html">
					<font size="8"/>
					<paragraph leftIndent="5" rightIndent="5" spacingBefore="5" spacingAfter="5"/>
				</textElement>
				<textFieldExpression><![CDATA[$V{AGGREGATION}+"</html>"]]></textFieldExpression>
			</textField>
		</band>
	</detail>
</jasperReport>
