		<property name="com.jaspersoft.studio.field.label" value="PARENT_ROLE_CODE"/>
	</field>
	<variable name="AGGREGATION" class="java.lang.String" resetType="Group" resetGroup="Gruppo1">
		<variableExpression><![CDATA[$V{AGGREGATION}+($V{AGGREGATION}.isEmpty()? "<html>":"<br>")+$F{ETCH_NAME}+" - "+$F{NAME}]]></variableExpression>
		<initialValueExpression><![CDATA[""]]></initialValueExpression>
	</variable>
	<group name="Gruppo1">
		<groupExpression><![CDATA[$F{ETCH}]]></groupExpression>
