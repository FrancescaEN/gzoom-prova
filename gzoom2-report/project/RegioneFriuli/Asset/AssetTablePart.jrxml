			<property name="com.jaspersoft.studio.field.label" value="IS_HTML"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort_note"/>
		</field>
		<field name="CONTENT_ID" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="CONTENT_ID"/>
			<property name="com.jaspersoft.studio.field.label" value="CONTENT_ID"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort_type_attr"/>
		</field>
		<field name="ETCH" class="java.lang.String">
