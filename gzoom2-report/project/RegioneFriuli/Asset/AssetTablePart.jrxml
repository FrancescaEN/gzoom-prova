			<property name="com.jaspersoft.studio.field.label" value="GL_ACCOUNT_ID"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="gl_account"/>
		</field>
		<field name="ACTUAL" class="java.lang.Double">
