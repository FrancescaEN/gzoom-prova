		<queryString>
			<![CDATA[select we1.source_reference_id, we1.work_effort_name from work_effort_assoc wea
join work_effort we on we.work_effort_id = wea.work_effort_id_from
join work_effort we1 on we1.work_effort_id = wea.work_effort_id_to
where wea.work_effort_assoc_type_id = '18PRNCNCO'
and WE.WORK_EFFORT_ID =  $P{workEffortId}]]>
