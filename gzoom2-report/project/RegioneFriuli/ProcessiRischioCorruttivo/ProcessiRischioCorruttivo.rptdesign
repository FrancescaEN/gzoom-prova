            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">LISTA_FATTORI</property>
                    <property name="nativeName">LISTA_FATTORI</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">M_WORK_EFFORT_ID</property>
                    <property name="nativeName">M_WORK_EFFORT_ID</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT
	--LISTAGG(WETA.G_ACCOUNT_NAME, '') WITHIN GROUP (ORDER BY WETA.G_ACCOUNT_NAME) AS "LISTA_FATTORI",
	WETA.G_ACCOUNT_NAME AS "LISTA_FATTORI",
	WETA.M_WORK_EFFORT_ID
FROM WORK_EFFORT_TRANS_ALL_VIEW WETA
WHERE WETA.M_FROM_DATE <= @date3112 AND (WETA.M_THRU_DATE >= @date0101 OR WETA.M_THRU_DATE IS NULL)
	AND WETA.M_GL_ACCOUNT_ID LIKE 'CORFA%' AND WETA.TM_AMOUNT = 1
	AND WETA.M_WORK_EFFORT_ID = ?
--GROUP BY
--	WETA.M_WORK_EFFORT_ID ]]></xml-property>
