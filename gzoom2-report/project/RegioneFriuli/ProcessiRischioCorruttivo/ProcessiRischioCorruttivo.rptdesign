            <xml-property name="queryText"><![CDATA[SELECT 
	CONCAT(RIS.ETCH, CONCAT(' - ', RIS.WORK_EFFORT_NAME)) AS "Rischio",
	WEA6.WORK_EFFORT_ID_FROM,
	RIS.WORK_EFFORT_ID
/* RISCHIO */
FROM WORK_EFFORT_ASSOC WEA6
JOIN WORK_EFFORT RIS ON RIS.WORK_EFFORT_ID = WEA6.WORK_EFFORT_ID_TO AND RIS.WORK_EFFORT_TYPE_ID = '15AP4RIS' AND RIS.WORK_EFFORT_REVISION_ID IS NULL 
	AND RIS.ESTIMATED_START_DATE <= @date3112 AND (RIS.ESTIMATED_COMPLETION_DATE >= @date0101 OR RIS.ESTIMATED_COMPLETION_DATE IS NULL)
WHERE WEA6.WORK_EFFORT_ASSOC_TYPE_ID = '15APSARC'
AND WEA6.WORK_EFFORT_ID_FROM = ?]]></xml-property>
