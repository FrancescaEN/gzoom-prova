            <xml-property name="queryText"><![CDATA[--ALTER SESSION SET CURRENT_SCHEMA = GZOOM_FVG_TEST

SELECT
	CONCAT(PROC.SOURCE_REFERENCE_ID, CONCAT(' - ', PROC.WORK_EFFORT_NAME)) AS "Processo",
	WEPT.DESCRIPTION AS "Tipologia",
	MAX(CASE WHEN WEN.SEQUENCE_ID = '110' THEN TO_CHAR(ND.NOTE_INFO) ELSE NULL END) AS "Descrizione",
	MAX(CASE WHEN WEN.SEQUENCE_ID = '120' THEN TO_CHAR(ND.NOTE_INFO) ELSE NULL END) AS "Output",
	TO_CHAR(PROC.ESTIMATED_START_DATE, 'DD/MM/YYYY') AS "Data inizio",
	TO_CHAR(PROC.ESTIMATED_COMPLETION_DATE, 'DD/MM/YYYY') AS "Data fine",
	CONCAT(PPRUO.PARENT_ROLE_CODE, CONCAT(' - ', UO.PARTY_NAME)) AS "Unità responsabile",
	CONCAT(PPRESP.PARENT_ROLE_CODE, CONCAT(' - ', RESP.PARTY_NAME)) AS "Responsabile",
	CONCAT(AREA.ETCH, CONCAT(' - ', AREA.WORK_EFFORT_NAME)) AS "Area di rischio",
	CONCAT(PCS.ETCH, CONCAT(' - ', PCS.WORK_EFFORT_NAME)) AS "Processo",
	CONCAT(PROG.ETCH, CONCAT(' - ', PROG.WORK_EFFORT_NAME)) AS "Programma",
	PROC.WORK_EFFORT_ID AS "WORK_EFFORT_ID" 
FROM WORK_EFFORT PTPC
/* AREA DI RISCHIO */
JOIN WORK_EFFORT_ASSOC WEA ON WEA.WORK_EFFORT_ID_FROM = PTPC.WORK_EFFORT_ID AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '15APPPC'
JOIN WORK_EFFORT AREA ON AREA.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_TO AND AREA.WORK_EFFORT_TYPE_ID = '15AP1ARE' AND AREA.WORK_EFFORT_REVISION_ID IS NULL
	AND AREA.ESTIMATED_START_DATE <= @date3112 AND (AREA.ESTIMATED_COMPLETION_DATE >= @date0101 OR AREA.ESTIMATED_COMPLETION_DATE IS NULL)
/* PROCESSO A RISCHIO CORRUTTIVO*/
JOIN WORK_EFFORT_ASSOC WEA2 ON WEA2.WORK_EFFORT_ID_FROM = AREA.WORK_EFFORT_ID AND WEA2.WORK_EFFORT_ASSOC_TYPE_ID = '15APPPC'
JOIN WORK_EFFORT PROC ON PROC.WORK_EFFORT_ID = WEA2.WORK_EFFORT_ID_TO AND PROC.WORK_EFFORT_TYPE_ID = '15AP2SAR' AND PROC.WORK_EFFORT_REVISION_ID IS NULL
	AND PROC.ESTIMATED_START_DATE <= @date3112 AND (PROC.ESTIMATED_COMPLETION_DATE >= @date0101 OR PROC.ESTIMATED_COMPLETION_DATE IS NULL)
LEFT JOIN WORK_EFFORT_PURPOSE_TYPE WEPT ON WEPT.WORK_EFFORT_PURPOSE_TYPE_ID = PROC.WORK_EFFORT_PURPOSE_TYPE_ID
/* UNITA' RESPONSABILE  */
JOIN PARTY UO ON UO.PARTY_ID = PROC.ORG_UNIT_ID 
JOIN PARTY_PARENT_ROLE PPRUO ON PPRUO.PARTY_ID = UO.PARTY_ID
/* SOGGETTO RESPONSABILE */
LEFT JOIN PARTY_RELATIONSHIP PR ON PR.PARTY_ID_FROM = UO.PARTY_ID AND PR.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE' AND PR.THRU_DATE IS NULL
LEFT JOIN PARTY RESP ON RESP.PARTY_ID = PR.PARTY_ID_TO
LEFT JOIN PARTY_PARENT_ROLE PPRESP ON PPRESP.PARTY_ID = RESP.PARTY_ID 
/* NOTE DEL PROCESSO A RISCHIO CORRUTTIVO */
LEFT JOIN WORK_EFFORT_NOTE WEN ON WEN.WORK_EFFORT_ID = PROC.WORK_EFFORT_ID 
LEFT JOIN NOTE_DATA ND ON ND.NOTE_ID = WEN.NOTE_ID
/* COLLEGAMENTO A PROCESSO */
LEFT JOIN WORK_EFFORT_ASSOC WEA3 ON WEA3.WORK_EFFORT_ID_TO = PROC.WORK_EFFORT_ID AND WEA3.WORK_EFFORT_ASSOC_TYPE_ID = '21C4PROC4'
LEFT JOIN WORK_EFFORT PCS ON PCS.WORK_EFFORT_ID = WEA3.WORK_EFFORT_ID_FROM AND PCS.WORK_EFFORT_TYPE_ID = '21C40PRO' AND PCS.WORK_EFFORT_REVISION_ID IS NULL 
	AND PCS.ESTIMATED_START_DATE <= @date3112 AND (PCS.ESTIMATED_COMPLETION_DATE >= @date0101 OR PCS.ESTIMATED_COMPLETION_DATE IS NULL)
/* COLLEGAMENTO A PROGRAMMA */
LEFT JOIN WORK_EFFORT_ASSOC WEA4 ON WEA4.WORK_EFFORT_ID_TO = PROC.WORK_EFFORT_ID AND WEA4.WORK_EFFORT_ASSOC_TYPE_ID = '21D2C2'
LEFT JOIN WORK_EFFORT PROG ON PROG.WORK_EFFORT_ID = WEA4.WORK_EFFORT_ID_FROM AND PROG.WORK_EFFORT_TYPE_ID = '21D24PRO' AND PROG.WORK_EFFORT_REVISION_ID IS NULL 
	AND PROG.ESTIMATED_START_DATE <= @date3112 AND (PROG.ESTIMATED_COMPLETION_DATE >= @date0101 OR PROG.ESTIMATED_COMPLETION_DATE IS NULL)
@filterInnerJoin
@filterLeftJoin

WHERE PTPC.WORK_EFFORT_TYPE_ID = '15AP0PPC' AND PTPC.WORK_EFFORT_REVISION_ID IS NULL
	AND PTPC.ESTIMATED_START_DATE <= @date3112 AND (PTPC.ESTIMATED_COMPLETION_DATE >= @date0101 OR PTPC.ESTIMATED_COMPLETION_DATE IS NULL)
@orgUnitId
@filterWhere
GROUP BY 
	PROC.SOURCE_REFERENCE_ID,
	PROC.WORK_EFFORT_NAME,
	WEPT.DESCRIPTION,
	TO_CHAR(PROC.ESTIMATED_START_DATE, 'DD/MM/YYYY'),
	TO_CHAR(PROC.ESTIMATED_COMPLETION_DATE, 'DD/MM/YYYY'),
	CONCAT(PPRUO.PARENT_ROLE_CODE, CONCAT(' - ', UO.PARTY_NAME)),
	CONCAT(PPRESP.PARENT_ROLE_CODE, CONCAT(' - ', RESP.PARTY_NAME)),
	CONCAT(AREA.ETCH, CONCAT(' - ', AREA.WORK_EFFORT_NAME)),
	CONCAT(PCS.ETCH, CONCAT(' - ', PCS.WORK_EFFORT_NAME)),
	CONCAT(PROG.ETCH, CONCAT(' - ', PROG.WORK_EFFORT_NAME)),
	PROC.WORK_EFFORT_ID
	





]]></xml-property>
        </oda-data-set>
