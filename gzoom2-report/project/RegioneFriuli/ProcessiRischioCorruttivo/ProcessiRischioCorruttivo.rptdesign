var element = mapRealPageNumber.get(key);
if (element == null) {	
	var NPage = reportContext.getGlobalVariable("nPagina");
	mapRealPageNumber.put(key, NPage);
	reportContext.setPersistentGlobalVariable("mapRealPageNumber", mapRealPageNumber);
}

]]></method>
