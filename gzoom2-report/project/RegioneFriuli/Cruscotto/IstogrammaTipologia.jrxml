	<queryString language="SQL">
		<![CDATA[select m2.DATA_RIFERIMENTO,m2.ANNO,
	m2.ETCH_TIPO_MISURA, 
	m2.TIPO_MISURA, 
	m2.TIPO_MISURA_LANG, 
	m2.MIS_TIP,
	m2.MIS_PREVISTE, 
	-- round(cast(m2.MIS_PREVISTE as decimal(10,2))  / cast(m2.MIS_ANNO as decimal(10,2)) * 100.0 , 0) as MIS_PRE_PERC, 
	-- round((cast(m2.MIS_ATTUATE  as decimal(10,2)) / cast(m2.MIS_PREVISTE  as decimal(10,2)) * 100.0) - 100.0 , 0) as MIS_DELTA_PERC,
		m2.MIS_ATTUATE
from (select m1.DATA_RIFERIMENTO,m1.ANNO,m1.ETCH_TIPO_MISURA, m1.TIPO_MISURA, m1.TIPO_MISURA_LANG, m1.MIS_TIP, sum(m1.MIS_PREVISTE) as MIS_PREVISTE, sum(m1.MIS_ATTUATE) as MIS_ATTUATE,
(select count(*) from COR_MIS_REPORT_VIEW t where t.ANNO = m1.ANNO ) as MIS_ANNO
from (select m.DATA_RIFERIMENTO,m.ANNO, m.ETCH_TIPO_MISURA,m.TIPO_MISURA, m.TIPO_MISURA_LANG, m.MIS_TIP, 1 as MIS_PREVISTE, m.SAL_ATTUATA as MIS_ATTUATE
from COR_MIS_REPORT_VIEW m
where m.anno= $P{YEAR} 
 $P!{orgUnitIdString} ) m1
group by m1.DATA_RIFERIMENTO,m1.ANNO,m1.ETCH_TIPO_MISURA, m1.TIPO_MISURA, m1.TIPO_MISURA_LANG, m1.MIS_TIP
order by m1.DATA_RIFERIMENTO,m1.ANNO,m1.ETCH_TIPO_MISURA, m1.TIPO_MISURA, m1.TIPO_MISURA_LANG, m1.MIS_TIP
) m2
   where 1=1
   and m2.DATA_RIFERIMENTO= $P{customTimePeriod} ]]>
	</queryString>
	<field name="ANNO" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="ANNO"/>
		<property name="com.jaspersoft.studio.field.label" value="ANNO"/>
