	<parameter name="userLoginId" class="java.lang.String" isForPrompting="false"/>
	<parameter name="customTimePeriod" class="java.util.Date" isForPrompting="false"/>
	<parameter name="filterWhere" class="java.lang.String"/>
	<parameter name="filterLeftJoin" class="java.lang.String"/>
	<parameter name="filterInnerJoin" class="java.lang.String"/>
	<parameter name="date3112" class="java.util.Date" isForPrompting="false"/>
	<parameter name="date3112sql" class="java.lang.String" isForPrompting="false"/>
	<parameter name="odaDialect" class="java.lang.String" isForPrompting="false"/>
	<parameter name="date0101" class="java.util.Date" isForPrompting="false"/>
	<parameter name="date0101sql" class="java.lang.String"/>
	<parameter name="Company" class="java.lang.String" isForPrompting="false"/>
	<parameter name="ReportSmallPath" class="java.lang.String" isForPrompting="false"/>
	<parameter name="IconNavPath" class="java.lang.String" isForPrompting="false"/>
	<parameter name="workEffortTypeId" class="java.lang.String"/>
	<parameter name="reportContentId" class="java.lang.String" isForPrompting="false"/>
	<parameter name="filterWhereString" class="java.lang.String" isForPrompting="false"/>
	<parameter name="filterLeftJoinString" class="java.lang.String" isForPrompting="false"/>
	<parameter name="filterInnerJoinString" class="java.lang.String" isForPrompting="false"/>
	<parameter name="customTimePeriodString" class="java.lang.String" isForPrompting="false"/>
	<parameter name="personId" class="java.lang.String" isForPrompting="false"/>
	<parameter name="workEffortId" class="java.lang.String" isForPrompting="false"/>
	<parameter name="date3009" class="java.util.Date" isForPrompting="false"/>
	<parameter name="date3009sql" class="java.lang.String" isForPrompting="false"/>
	<parameter name="exposePaginator" class="java.lang.String" isForPrompting="false"/>
	<parameter name="YEAR" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select m2.DATA_RIFERIMENTO,m2.ANNO, 
	m2.TIPO_MISURA, 
	m2.TIPO_MISURA_LANG, 
	m2.MIS_TIP, 
	m2.MIS_PREVISTE, 
	-- round(cast(m2.MIS_PREVISTE as decimal(10,2))  / cast(m2.MIS_ANNO as decimal(10,2)) * 100.0 , 0) as MIS_PRE_PERC, 
	-- round((cast(m2.MIS_ATTUATE  as decimal(10,2)) / cast(m2.MIS_PREVISTE  as decimal(10,2)) * 100.0) - 100.0 ,0) as MIS_DELTA_PERC,
	m2.MIS_ATTUATE
from (select m1.DATA_RIFERIMENTO,m1.ANNO, m1.TIPO_MISURA, m1.TIPO_MISURA_LANG, m1.MIS_TIP, sum(m1.MIS_PREVISTE) as MIS_PREVISTE, sum(m1.MIS_ATTUATE) as MIS_ATTUATE,
(select count(*) from COR_MIS_REPORT_VIEW t where t.ANNO = m1.ANNO ) as MIS_ANNO
from (select m.DATA_RIFERIMENTO,m.ANNO, m.TIPO_MISURA, m.TIPO_MISURA_LANG, m.MIS_TIP, 1 as MIS_PREVISTE, m.SAL_ATTUATA as MIS_ATTUATE
from COR_MIS_REPORT_VIEW m
where m.anno= $P{YEAR} 
 $P!{orgUnitIdString} ) m1
group by m1.DATA_RIFERIMENTO,m1.ANNO, m1.TIPO_MISURA, m1.TIPO_MISURA_LANG, m1.MIS_TIP
order by m1.DATA_RIFERIMENTO,m1.ANNO, m1.TIPO_MISURA, m1.TIPO_MISURA_LANG, m1.MIS_TIP) m2
   where 1=1
   and m2.DATA_RIFERIMENTO= $P{customTimePeriod} ]]>
	</queryString>
