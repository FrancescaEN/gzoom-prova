	<subDataset name="Dataset1" uuid="a235b51b-2772-45f3-a4b7-ec19ebc962db">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="oracle_friuli"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="111"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="883"/>
		<parameter name="ReportTitle" class="java.lang.String" isForPrompting="false"/>
		<parameter name="langLocale" class="java.lang.String"/>
		<parameter name="defaultOrganizationPartyId" class="java.lang.String"/>
		<parameter name="orgUnitId" class="java.lang.String"/>
		<parameter name="orgUnitIdString" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[$P{orgUnitId}  != null && $P{orgUnitId}  != "" ? 
	" AND m.FAS_RESP='" + $P{orgUnitId}  + "'"
: " "]]></defaultValueExpression>
		</parameter>
		<parameter name="localDispatcherName" class="java.lang.String"/>
		<parameter name="userLoginId" class="java.lang.String" isForPrompting="false"/>
		<parameter name="customTimePeriod" class="java.util.Date" isForPrompting="false"/>
		<parameter name="filterWhere" class="java.lang.String"/>
		<parameter name="filterLeftJoin" class="java.lang.String"/>
		<parameter name="filterInnerJoin" class="java.lang.String"/>
		<parameter name="date3112" class="java.util.Date" isForPrompting="false"/>
		<parameter name="date3112sql" class="java.lang.String" isForPrompting="false"/>
		<parameter name="odaDialect" class="java.lang.String" isForPrompting="false"/>
		<parameter name="date0101" class="java.util.Date" isForPrompting="false"/>
		<parameter name="date0101sql" class="java.lang.String"/>
		<parameter name="Company" class="java.lang.String" isForPrompting="false"/>
		<parameter name="ReportSmallPath" class="java.lang.String" isForPrompting="false"/>
		<parameter name="IconNavPath" class="java.lang.String" isForPrompting="false"/>
		<parameter name="workEffortTypeId" class="java.lang.String"/>
		<parameter name="reportContentId" class="java.lang.String" isForPrompting="false"/>
		<parameter name="filterWhereString" class="java.lang.String" isForPrompting="false"/>
		<parameter name="filterLeftJoinString" class="java.lang.String" isForPrompting="false"/>
		<parameter name="filterInnerJoinString" class="java.lang.String" isForPrompting="false"/>
		<parameter name="customTimePeriodString" class="java.lang.String" isForPrompting="false"/>
		<parameter name="personId" class="java.lang.String" isForPrompting="false"/>
		<parameter name="workEffortId" class="java.lang.String" isForPrompting="false"/>
		<parameter name="date3009" class="java.util.Date" isForPrompting="false"/>
		<parameter name="date3009sql" class="java.lang.String" isForPrompting="false"/>
		<parameter name="exposePaginator" class="java.lang.String" isForPrompting="false"/>
		<parameter name="YEAR" class="java.lang.String"/>
		<queryString language="SQL">
			<![CDATA[SELECT m1.DATA_RIFERIMENTO,
    m1.ANNO,
    m1.ETCH_AREA_RISCHIO,
    m1.AREA_RISCHIO, 
    SUM(m1.MIS_PREVISTE) AS MIS_PREVISTE, 
    SUM(m1.MIS_ATTUATE) AS MIS_ATTUATE,
    (SELECT COUNT(*) FROM COR_PRO_DETAIL_VIEW p WHERE p.ANNO = m1.ANNO AND p.ARE_ID = m1.ARE_ID) AS PRO_PREVISTI,
    CASE 
        WHEN (SELECT COUNT(*) FROM COR_PRO_DETAIL_VIEW p WHERE p.ANNO = m1.ANNO AND p.ARE_ID = m1.ARE_ID) = 0 THEN NULL
        ELSE ROUND(
            SUM(m1.MIS_PREVISTE) / 
            CAST((SELECT COUNT(*) FROM COR_PRO_DETAIL_VIEW p WHERE p.ANNO = m1.ANNO AND p.ARE_ID = m1.ARE_ID) AS DECIMAL(10,2)), 
            0
        )
    END AS MIS_PRO, 
    m1.ARE_ID
FROM (
    SELECT m.DATA_RIFERIMENTO,
        m.ANNO,
        m.ETCH_AREA_RISCHIO,
        m.ARE_ID, 
        m.AREA_RISCHIO,
        1.0 AS MIS_PREVISTE, 
        cast(m.SAL_ATTUATA AS DECIMAL(10,2)) AS MIS_ATTUATE
    FROM COR_MIS_REPORT_VIEW m
    WHERE EXISTS (
        SELECT 1 
        FROM USER_LOGIN_SECURITY_GROUP ULSG 
        INNER JOIN SECURITY_GROUP_PERMISSION SP ON SP.GROUP_ID = ULSG.GROUP_ID AND SP.PERMISSION_ID = 'CORPERFMGR_ADMIN'
        WHERE ULSG.USER_LOGIN_ID =  $P{userLoginId} 
        AND m.ANNO =  $P{YEAR} 
         $P!{orgUnitIdString} 
    )
    OR EXISTS (
        SELECT 1 
        FROM USER_LOGIN_SECURITY_GROUP ULSG 
        INNER JOIN SECURITY_GROUP_PERMISSION SP ON SP.GROUP_ID = ULSG.GROUP_ID AND SP.PERMISSION_ID = 'CORPERFORG_ADMIN'
        INNER JOIN USER_LOGIN UL ON UL.USER_LOGIN_ID = ULSG.USER_LOGIN_ID 
        INNER JOIN PARTY_RELATIONSHIP PRO ON PRO.PARTY_ID_TO = UL.PARTY_ID
        AND (PRO.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
            OR (PRO.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_DELEGATE' AND (PRO.CTX_ENABLED IS NULL OR PRO.CTX_ENABLED LIKE 'CTX_CO')))
        WHERE ULSG.USER_LOGIN_ID =  $P{userLoginId} 
        AND EXTRACT(YEAR FROM PRO.FROM_DATE) <= cast(m.ANNO AS decimal(10,0))
        AND (PRO.THRU_DATE IS NULL OR EXTRACT(YEAR FROM PRO.THRU_DATE) >= cast(m.ANNO AS decimal(10,0)) )
        AND m.ANNO =  $P{YEAR}
         $P!{orgUnitIdString}
    )
) m1
   where 1=1
   AND m1.DATA_RIFERIMENTO= $P{customTimePeriod} 
GROUP BY 
    m1.DATA_RIFERIMENTO,
    m1.ANNO,
    m1.ETCH_AREA_RISCHIO, 
    m1.AREA_RISCHIO, 
    m1.ARE_ID
ORDER BY 
m1.DATA_RIFERIMENTO,
    m1.ANNO,
    m1.ETCH_AREA_RISCHIO, 
    m1.AREA_RISCHIO, 
    m1.ARE_ID]]>
		</queryString>
		<field name="ANNO" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="ANNO"/>
			<property name="com.jaspersoft.studio.field.label" value="ANNO"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="custom_time_period"/>
		</field>
		<field name="ETCH_AREA_RISCHIO" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="ETCH_AREA_RISCHIO"/>
			<property name="com.jaspersoft.studio.field.label" value="ETCH_AREA_RISCHIO"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort"/>
		</field>
		<field name="AREA_RISCHIO" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="AREA_RISCHIO"/>
			<property name="com.jaspersoft.studio.field.label" value="AREA_RISCHIO"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort"/>
		</field>
		<field name="MIS_PREVISTE" class="java.lang.Integer">
			<property name="com.jaspersoft.studio.field.name" value="MIS_PREVISTE"/>
			<property name="com.jaspersoft.studio.field.label" value="MIS_PREVISTE"/>
		</field>
		<field name="MIS_ATTUATE" class="java.lang.Integer">
			<property name="com.jaspersoft.studio.field.name" value="MIS_ATTUATE"/>
			<property name="com.jaspersoft.studio.field.label" value="MIS_ATTUATE"/>
		</field>
		<field name="PRO_PREVISTI" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="PRO_PREVISTI"/>
			<property name="com.jaspersoft.studio.field.label" value="PRO_PREVISTI"/>
		</field>
		<field name="MIS_PRO" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="MIS_PRO"/>
			<property name="com.jaspersoft.studio.field.label" value="MIS_PRO"/>
		</field>
		<field name="ARE_ID" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="ARE_ID"/>
			<property name="com.jaspersoft.studio.field.label" value="ARE_ID"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort"/>
		</field>
		<field name="DATA_RIFERIMENTO" class="java.util.Date"/>
		<variable name="MISPROGCOUNT" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{MIS_PREVISTE}]]></variableExpression>
		</variable>
		<variable name="MISATTCOUNT" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{MIS_ATTUATE}]]></variableExpression>
		</variable>
		<variable name="MISDELTACOUNT" class="java.math.BigDecimal">
			<variableExpression><![CDATA[$V{MISPROGCOUNT} != null && $V{MISPROGCOUNT}.compareTo(BigDecimal.ZERO) != 0 
    ? (($V{MISATTCOUNT}.divide($V{MISPROGCOUNT}, MathContext.DECIMAL64))
        .multiply(new BigDecimal(100))
        .subtract(new BigDecimal(100))
        .setScale(0, RoundingMode.HALF_UP))
    : BigDecimal.ZERO]]></variableExpression>
			<initialValueExpression><![CDATA[$V{MISPROGCOUNT} != null && $V{MISPROGCOUNT}.compareTo(BigDecimal.ZERO) != 0 
    ? (($V{MISATTCOUNT}.divide($V{MISPROGCOUNT}, MathContext.DECIMAL64))
        .multiply(new BigDecimal(100))
        .subtract(new BigDecimal(100))
        .setScale(0, RoundingMode.HALF_UP))
    : BigDecimal.ZERO]]></initialValueExpression>
		</variable>
		<variable name="SUM_MIS_PREVISTE" class="java.lang.Integer" calculation="Sum">
			<variableExpression><![CDATA[$F{MIS_PREVISTE}]]></variableExpression>
		</variable>
		<variable name="MIS_DELTA_PERC" class="java.math.BigDecimal">
			<variableExpression><![CDATA[$F{MIS_PREVISTE} != null && new BigDecimal($F{MIS_PREVISTE}).compareTo(BigDecimal.ZERO) != 0 
    ? ((new BigDecimal($F{MIS_ATTUATE}).divide(new BigDecimal($F{MIS_PREVISTE}), MathContext.DECIMAL64)).multiply(new BigDecimal(100)) .subtract(new BigDecimal(100)).setScale(0, RoundingMode.HALF_UP)): BigDecimal.ZERO]]></variableExpression>
			<initialValueExpression><![CDATA[$F{MIS_PREVISTE} != null && new BigDecimal($F{MIS_PREVISTE}).compareTo(BigDecimal.ZERO) != 0 
    ? ((new BigDecimal($F{MIS_ATTUATE}).divide(new BigDecimal($F{MIS_PREVISTE}), MathContext.DECIMAL64)).multiply(new BigDecimal(100)) .subtract(new BigDecimal(100)).setScale(0, RoundingMode.HALF_UP)): BigDecimal.ZERO]]></initialValueExpression>
		</variable>
	</subDataset>
	<parameter name="ReportTitle" class="java.lang.String" isForPrompting="false"/>
	<parameter name="langLocale" class="java.lang.String"/>
