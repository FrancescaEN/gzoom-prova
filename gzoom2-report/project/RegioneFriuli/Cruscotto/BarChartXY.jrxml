	<queryString language="SQL">
		<![CDATA[select m2.ANNO,
	m2.ETCH_TIPO_MISURA, 
	m2.TIPO_MISURA, 
	m2.TIPO_MISURA_LANG, 
	m2.MIS_TIP,	
	m2.MIS_PREVISTE, 
	m2.MIS_ANNO,
--	round(cast(m2.MIS_PREVISTE as decimal(10,2))  / cast(m2.MIS_ANNO as decimal(10,2)) * 100.0 , 0) as MIS_PRE_PERC,
	m2.MIS_ATTUATE -- , 
--	round((cast(m2.MIS_ATTUATE  as decimal(10,2)) / cast(m2.MIS_PREVISTE  as decimal(10,2)) * 100.0) - 100.0 , 0) as MIS_DELTA_PERC
from (
	select m1.ANNO,
		m1.ETCH_TIPO_MISURA, 
		m1.TIPO_MISURA, 
		m1.TIPO_MISURA_LANG, 
		m1.MIS_TIP, 
		sum(m1.MIS_PREVISTE) as MIS_PREVISTE, 
		sum(m1.MIS_ATTUATE) as MIS_ATTUATE,
		(select count(*) from COR_MIS_REPORT_VIEW t where t.ANNO = m1.ANNO ) as MIS_ANNO
	from (select m.ANNO, m.ETCH_TIPO_MISURA,
					m.TIPO_MISURA, 
					m.TIPO_MISURA_LANG, 
					m.MIS_TIP, 
					1 as MIS_PREVISTE, 
					m.SAL_ATTUATA as MIS_ATTUATE
				from COR_MIS_REPORT_VIEW m
				where m.anno= $P{YEAR} 
 				$P!{orgUnitIdString} 
) m1
 where 1=1 
group by m1.ANNO,m1.ETCH_TIPO_MISURA, m1.TIPO_MISURA, m1.TIPO_MISURA_LANG, m1.MIS_TIP
order by m1.ANNO,m1.ETCH_TIPO_MISURA, m1.TIPO_MISURA, m1.TIPO_MISURA_LANG, m1.MIS_TIP) m2]]>
	</queryString>
