	<subDataset name="Empty Dataset1" uuid="50d95cc9-955c-4e2a-99be-ed9d666ca8d5">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="milanocciaPROD"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="area" class="java.lang.String"/>
		<queryString>
			<![CDATA[select m1.ANNO, m1.AREA_RISCHIO, SUM(m1.MIS_PREVISTE) as MIS_PREVISTE, SUM(m1.MIS_ATTUATE) as MIS_ATTUATE, 
-- round(cast((SUM(m1.MIS_ATTUATE) / SUM(m1.MIS_PREVISTE) * 100) - 100 as decimal(10,2)),0) as MIS_DELTA_PERC,
(select count(*) from COR_PRO_DETAIL_VIEW p where p.ANNO = m1.ANNO and p.ARE_ID = m1.ARE_ID) as PRO_PREVISTI,
-- round(cast(SUM(m1.MIS_PREVISTE) as decimal(10,2)) / cast((select count(*) from COR_PRO_DETAIL_VIEW p where p.ANNO = m1.ANNO and p.ARE_ID = m1.ARE_ID) as decimal(10,2)),0) as MIS_PRO, 
m1.ARE_ID
from (select m.ANNO, m.ARE_ID, m.AREA_RISCHIO,1 as MIS_PREVISTE, m.SAL_ATTUATA as MIS_ATTUATE
from COR_MIS_REPORT_VIEW m
where exists (SELECT 1 from USER_LOGIN_SECURITY_GROUP ULSG 
INNER JOIN SECURITY_GROUP_PERMISSION SP ON SP.GROUP_ID = ULSG.GROUP_ID AND SP.PERMISSION_ID = 'CORPERFMGR_ADMIN'
WHERE ULSG.USER_LOGIN_ID = 'admin')
or exists (SELECT 1 from USER_LOGIN_SECURITY_GROUP ULSG 
INNER JOIN SECURITY_GROUP_PERMISSION SP ON SP.GROUP_ID = ULSG.GROUP_ID AND SP.PERMISSION_ID = 'CORPERFORG_ADMIN'
INNER JOIN USER_LOGIN UL ON UL.USER_LOGIN_ID = ULSG.USER_LOGIN_ID 
INNER JOIN PARTY_RELATIONSHIP PRO ON PRO.PARTY_ID_TO = UL.PARTY_ID
AND (PRO.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
or (PRO.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_DELEGATE' AND (PRO.CTX_ENABLED IS NULL OR PRO.CTX_ENABLED LIKE 'CTX_CO')))
WHERE ULSG.USER_LOGIN_ID = 'admin'
and LEFT(PRO.FROM_DATE,4) <= m.ANNO
and (PRO.THRU_DATE is null or left(PRO.THRU_DATE,4) >= m.ANNO)
AND PRO.PARTY_ID_FROM = m.PRO_RESP)
) m1 
where m1.anno=2024
and area_rischio=@area
group by m1.ANNO, m1.AREA_RISCHIO, m1.ARE_ID]]>
		</queryString>
		<field name="ANNO" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="ANNO"/>
			<property name="com.jaspersoft.studio.field.label" value="ANNO"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="custom_time_period"/>
