            <xml-property name="queryText"><![CDATA[SELECT
	CONCAT(MIS.ETCH, CONCAT(' - ', MIS.WORK_EFFORT_NAME)) AS "Misura",
	WEPT.DESCRIPTION AS "Tipologia misura",
	MAX(CASE WHEN WENMIS.SEQUENCE_ID = '10' THEN TO_CHAR(NDMIS.NOTE_INFO) ELSE NULL END) AS "Responsabile della misura",
	MAX(CASE WHEN WENMIS.SEQUENCE_ID = '30' THEN TO_CHAR(NDMIS.NOTE_INFO) ELSE NULL END) AS "Descrizione dell'intervento",
	MAX(CASE WHEN WETAMIS.M_GL_ACCOUNT_ID = 'CORMIS.SAL' THEN WETAMIS.R_UOM_CODE ELSE NULL END) AS "Risultato misura",
	MAX(CASE WHEN WETAMIS.M_GL_ACCOUNT_ID = 'CORMIS.SAL' THEN WETAMIS.TT_DESCRIPTION ELSE NULL END) AS "Commento risultato",
	TO_CHAR(MIS.ESTIMATED_START_DATE, 'DD/MM/YYYY') AS "Inizio misura",
	TO_CHAR(MIS.ESTIMATED_COMPLETION_DATE, 'DD/MM/YYYY') AS "Fine misura",	
	WEA7.WORK_EFFORT_ID_FROM
/* MISURA */
FROM WORK_EFFORT_ASSOC WEA7 
LEFT JOIN WORK_EFFORT MIS ON MIS.WORK_EFFORT_ID = WEA7.WORK_EFFORT_ID_TO AND MIS.WORK_EFFORT_TYPE_ID = '15AP5M1' AND MIS.WORK_EFFORT_REVISION_ID IS NULL 
	AND MIS.ESTIMATED_START_DATE <= @date3112 AND (MIS.ESTIMATED_COMPLETION_DATE >= @date0101 OR MIS.ESTIMATED_COMPLETION_DATE IS NULL)
LEFT JOIN WORK_EFFORT_PURPOSE_TYPE WEPT ON WEPT.WORK_EFFORT_PURPOSE_TYPE_ID = MIS.WORK_EFFORT_PURPOSE_TYPE_ID 
/* NOTE DELLA MISURA */
LEFT JOIN WORK_EFFORT_NOTE WENMIS ON WENMIS.WORK_EFFORT_ID = MIS.WORK_EFFORT_ID 
LEFT JOIN NOTE_DATA NDMIS ON NDMIS.NOTE_ID = WENMIS.NOTE_ID
/* INDICATORI SULLA MISURA */
LEFT JOIN WORK_EFFORT_TRANS_ALL_VIEW WETAMIS ON WETAMIS.M_WORK_EFFORT_ID = MIS.WORK_EFFORT_ID 
	AND WETAMIS.M_FROM_DATE <= @date3112 AND (WETAMIS.M_THRU_DATE >= @date0101 OR WETAMIS.M_THRU_DATE IS NULL)
	AND WETAMIS.TT_TRANSACTION_DATE = @date3112
WHERE WEA7.WORK_EFFORT_ASSOC_TYPE_ID = '15APSARC'
AND WEA7.WORK_EFFORT_ID_FROM = ?
GROUP BY
	CONCAT(MIS.ETCH, CONCAT(' - ', MIS.WORK_EFFORT_NAME)),
	WEPT.DESCRIPTION,
	TO_CHAR(MIS.ESTIMATED_START_DATE, 'DD/MM/YYYY'),
	TO_CHAR(MIS.ESTIMATED_COMPLETION_DATE, 'DD/MM/YYYY'),	
	WEA7.WORK_EFFORT_ID_FROM ]]></xml-property>
