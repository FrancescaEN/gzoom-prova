            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">Fase</property>
                    <property name="nativeName">Fase</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">Elemento di valutazione</property>
                    <property name="nativeName">Elemento di valutazione</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">Valutazione</property>
                    <property name="nativeName">Valutazione</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">Commento valutazione</property>
                    <property name="nativeName">Commento valutazione</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">WORK_EFFORT_ID_FROM</property>
                    <property name="nativeName">WORK_EFFORT_ID_FROM</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">WORK_EFFORT_ID</property>
                    <property name="nativeName">WORK_EFFORT_ID</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
	CONCAT(FASE.ETCH, CONCAT(' - ', FASE.WORK_EFFORT_NAME)) AS "Fase",
	MAX(CASE WHEN WETA.M_GL_ACCOUNT_ID = 'CORRIS.5.1' THEN WETA.G_ACCOUNT_NAME ELSE NULL END) AS "Elemento di valutazione",
	MAX(CASE WHEN WETA.M_GL_ACCOUNT_ID = 'CORRIS.5.1' THEN WETA.R_UOM_CODE ELSE NULL END) AS "Valutazione",
	MAX(CASE WHEN WETA.M_GL_ACCOUNT_ID = 'CORRIS.5.1' THEN WETA.TT_DESCRIPTION ELSE NULL END) AS "Commento valutazione",
	WEA5.WORK_EFFORT_ID_FROM,
	FASE.WORK_EFFORT_ID
FROM WORK_EFFORT_ASSOC WEA5
JOIN WORK_EFFORT FASE ON FASE.WORK_EFFORT_ID = WEA5.WORK_EFFORT_ID_TO AND FASE.WORK_EFFORT_TYPE_ID = '15AP3PRO' AND FASE.WORK_EFFORT_REVISION_ID IS NULL
	AND FASE.ESTIMATED_START_DATE <= @date3112 AND (FASE.ESTIMATED_COMPLETION_DATE >= @date0101 OR FASE.ESTIMATED_COMPLETION_DATE IS NULL)
/* INDICATORI */
LEFT JOIN WORK_EFFORT_TRANS_ALL_VIEW WETA ON WETA.M_WORK_EFFORT_ID = FASE.WORK_EFFORT_ID 
	AND WETA.M_FROM_DATE <= @date3112 AND (WETA.M_THRU_DATE >= @date0101 OR WETA.M_THRU_DATE IS NULL)
	AND WETA.TT_TRANSACTION_DATE = @date3112
WHERE WEA5.WORK_EFFORT_ASSOC_TYPE_ID = '15APSARC'
AND WEA5.WORK_EFFORT_ID_FROM = ?
GROUP BY
	CONCAT(FASE.ETCH, CONCAT(' - ', FASE.WORK_EFFORT_NAME)),
	WEA5.WORK_EFFORT_ID_FROM,
	FASE.WORK_EFFORT_ID]]></xml-property>
