                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <method name="beforeOpen"><![CDATA[
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value);
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value);	


					
/* 
//this.queryText = this.queryText.replace("@date0101",  "'2019-01-01 00:00:00.000'" );
this.queryText = this.queryText.replace("@date3112",  "'2019-12-31 00:00:00.000'" );
this.queryText = this.queryText.replace("@workEffortId", "''");
*/


/*
ReportLog.info("FattoriAbilitantiDS :");
ReportLog.info(this.queryText);
*/]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">ACCOUNT_NAME</property>
                    <property name="nativeName">ACCOUNT_NAME</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT ACCOUNT_NAME
FROM WORK_EFFORT_MEASURE WEM
	JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID 
	JOIN WORK_EFFORT_PURPOSE_ACCOUNT WEPA ON WEPA.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID AND WEPA.WORK_EFFORT_PURPOSE_TYPE_ID = 'CORFAT'
	JOIN ACCTG_TRANS ACT ON ACT.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID 
	JOIN ACCTG_TRANS_ENTRY ATE ON ATE.ACCTG_TRANS_ID = ACT.ACCTG_TRANS_ID
    AND ATE.AMOUNT = '1'
WHERE WEM.WORK_EFFORT_ID = ?
]]></xml-property>
