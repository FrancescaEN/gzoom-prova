            <method name="beforeOpen"><![CDATA[
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value);
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value);	
this.queryText = this.queryText.replace("@workEffortTypeId",  "'" + params["workEffortTypeId"].value + "'");
this.queryText = this.queryText.replace("@year",  params["year"].value);

/*
this.queryText = this.queryText.replace("@date0101",  "'2019-01-01 00:00:00.000'" );
this.queryText = this.queryText.replace("@date3112",  "'2019-12-31 00:00:00.000'" );
this.queryText = this.queryText.replace("@workEffortTypeId", "''");
this.queryText = this.queryText.replace("@year", '2021');
*/

var orgUnitIdString = "";
if (params["orgUnitId"].value != null &amp;&amp; params["orgUnitId"].value != '') {
	orgUnitIdString = " AND ('" + params["orgUnitId"].value + "' IS NULL OR '" + params["orgUnitId"].value + "' = '' OR '" + params["orgUnitId"].value + "' = PV.PARTY_ID_ROOT) ";
}else{
	orgUnitIdString = " AND PV.TREE_LEVEL = 0 ";
}
this.queryText = this.queryText.replace("@orgUnitId", orgUnitIdString);

var struttIncardString = "";
if (params["includiStruttureIncardinate"].value != null &amp;&amp; params["includiStruttureIncardinate"].value != '' &amp;&amp; params["includiStruttureIncardinate"].value == 'N') {
	struttIncardString = " AND PV.TREE_LEVEL = 0 ";
}
this.queryText = this.queryText.replace("@includiStruttureIncardinate", struttIncardString);

var gradoRischioString = "";
if (params["enumeration"].value != null &amp;&amp; params["enumeration"].value != '') {
	
	if (params["enumeration"].value == 'GRD_RSC_ALTO'){
		gradoRischioString = " AND VAL.VAL7 = 'ALTO' ";
	} else if (params["enumeration"].value == 'GRD_RSC_MEDIO'){
		gradoRischioString = " AND VAL.VAL7 = 'MEDIO' ";
	} else if (params["enumeration"].value == 'GRD_RSC_BASSO'){
		gradoRischioString = " AND VAL.VAL7 = 'BASSO' ";
	} 
	
}
this.queryText = this.queryText.replace("@enumeration", gradoRischioString);
//ReportLog.info("VAL ENUMERATION:  --- "+params["enumeration"].value);

//GESTIRE PERMESSI


filter = new com.mapsengineering.base.birt.util.UtilFilter(params["userLoginId"].value, params["localDispatcherName"].value);
var filterInnerJoin = filter.getWorkEffortFilterInner();
var filterLeftJoin = filter.getWorkEffortFilterLeftJoin();
var filterWhere = filter.getWorkEffortFilterWhere(); 


/*
var filterInnerJoin = "";
var filterLeftJoin = "";
var filterWhere = "";
*/
this.queryText = this.queryText.replace("@filterInnerJoin",  filterInnerJoin );
this.queryText = this.queryText.replace("@filterLeftJoin",  filterLeftJoin );
this.queryText = this.queryText.replace("@filterWhere",  filterWhere );
 

/**/
ReportLog.info("ProcessiDS :");
ReportLog.info(this.queryText);
]]></method>
            <property name="dataSource">GeneralDataSource</property>
