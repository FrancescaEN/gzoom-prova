                <structure>
                    <property name="position">20</property>
                    <property name="name">LIVELLO DI ESPOSIZIONE AL RISCHIO</property>
                    <property name="nativeName">LIVELLO DI ESPOSIZIONE AL RISCHIO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">21</property>
                    <property name="name">Motivazione del livello di esposizione al rischio</property>
                    <property name="nativeName">Motivazione del livello di esposizione al rischio</property>
