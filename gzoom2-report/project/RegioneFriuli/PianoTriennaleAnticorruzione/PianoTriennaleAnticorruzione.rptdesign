                    <property name="position">24</property>
                    <property name="name">Responsabili attuazione</property>
                    <property name="nativeName">Responsabili attuazione</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">25</property>
                    <property name="name">Descrizione e fasi di attuazione</property>
                    <property name="nativeName">Descrizione e fasi di attuazione</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">26</property>
                    <property name="name">Indicatore di attuazione della misura</property>
                    <property name="nativeName">Indicatore di attuazione della misura</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">27</property>
                    <property name="name">Descrizione (indicatore)</property>
                    <property name="nativeName">Descrizione (indicatore)</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">28</property>
                    <property name="name">Target</property>
                    <property name="nativeName">Target</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">29</property>
                    <property name="name">Consuntivo</property>
                    <property name="nativeName">Consuntivo</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">30</property>
                    <property name="name">Data</property>
                    <property name="nativeName">Data</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">31</property>
                    <property name="name">Correlazione Fattori Abilitanti</property>
                    <property name="nativeName">Correlazione Fattori Abilitanti</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[
SELECT
    '@year' AS "Annualità ",
    SI.DESCRIPTION AS "Stato",
    FIL_W.SOURCE_REFERENCE_ID AS "Codice processo",
    WEPT.DESCRIPTION AS "Tipologia",
    CONCAT(CONCAT(FIL_W.SOURCE_REFERENCE_ID, ' - '),FIL_W.WORK_EFFORT_NAME) AS "Processo",
    CONCAT(PPRUO.PARENT_ROLE_CODE, CONCAT(' - ', UO.PARTY_NAME)) AS "Unità  responsabile",
    NOTE.DESCR AS "Descrizione",
	--NOTE.PROD AS "Prodotto",
    CONCAT(AREA.ETCH, CONCAT(' - ', AREA.WORK_EFFORT_NAME)) AS "Area di rischio",
    CONCAT(PROCTIP.ETCH, CONCAT(' - ', PROCTIP.WORK_EFFORT_NAME)) AS "Processo (tipo)",
    CONCAT(TEM.ETCH, CONCAT(' - ', TEM.WORK_EFFORT_NAME)) AS "Area tematica",
	--NOTE.DEST AS "Destinatari",
	--NOTE.STAKE AS "Stakeholder",
    FASE.WORK_EFFORT_NAME AS "Fase",
    FASE.ETCH AS "Fase Etch",
	--CONCAT(NOTEFAS.DESCR,NOTEFAS.DESCR1) AS "Descrizione (Fase)",
    CONCAT(RIS.ETCH, CONCAT(' - ', RIS.WORK_EFFORT_NAME)) AS "Evento rischioso",
    VAL.VAL1 AS "Livello di interesse esterno",
    VAL.VAL2 AS "Grado di discrezionalità  del decisore interno alla PA",
    VAL.VAL3 AS "Manifestazione di eventi corruttivi in passato nel processo",
    VAL.VAL4 AS "Livello di opacità  del processo decisionale",
    VAL.VAL5 AS "Mancata attuazione delle misure di trattamento (livello)",
    VAL.VAL6 AS "Livello di arretrato per mancato rispetto dei termini dei procedimenti coinvolti nel processo",
    VAL.VAL7 AS "LIVELLO DI ESPOSIZIONE AL RISCHIO",
    MAX(CASE WHEN WENRIS.SEQUENCE_ID = '10' THEN TO_CHAR(NDRIS.NOTE_INFO) ELSE NULL END) AS "Motivazione del livello di esposizione al rischio",
    CONCAT(MIS.ETCH, CONCAT(' - ', MIS.WORK_EFFORT_NAME)) AS "Misura ulteriore",
    WEPTMIS.DESCRIPTION AS "Categoria",
    MAX(CASE WHEN WENMIS.SEQUENCE_ID = '30' THEN TO_CHAR(NDMIS.NOTE_INFO) ELSE NULL END) AS "Responsabili attuazione",
    MAX(CASE WHEN WENMIS.SEQUENCE_ID = '10' THEN TO_CHAR(NDMIS.NOTE_INFO) ELSE NULL END) AS "Descrizione e fasi di attuazione",
    INDIC.ACCOUNT_NAME AS "Indicatore di attuazione della misura",
    INDIC.UOM_DESCR AS "Descrizione (indicatore)",
    MAX(CASE WHEN INDIC.TRANSACTION_DATE = @date3112 AND INDIC.GL_FISCAL_TYPE_ID = 'BUDGET' THEN
       (CASE WHEN INDIC.UOM_TYPE_ID = 'RATING_SCALE' THEN INDIC.UOM_CODE  ELSE TO_CHAR(INDIC.AMOUNT) END) ELSE NULL END) AS "Target",
    MAX(CASE WHEN INDIC.TRANSACTION_DATE = @date3112 AND INDIC.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN
        (CASE WHEN INDIC.UOM_TYPE_ID = 'RATING_SCALE' THEN INDIC.UOM_CODE  ELSE TO_CHAR(INDIC.AMOUNT) END) ELSE NULL END) AS "Consuntivo",
    MAX(CASE WHEN WENMIS.SEQUENCE_ID = '110' THEN TO_CHAR(NDMIS.NOTE_DATE_TIME, 'DD/MM/YYYY') ELSE NULL END) AS "Data",
	--MAX(CASE WHEN WENMIS.SEQUENCE_ID = '110' THEN TO_CHAR(NDMIS.NOTE_INFO) ELSE NULL END) AS --"Monitoraggio",
	--MIS.WORK_EFFORT_PURPOSE_TYPE_ID AS "Categoria misura",
    RIS.WORK_EFFORT_ID AS "Correlazione Fattori Abilitanti"
/* PIANO PREVENZIONE CORRUZIONE */
FROM WORK_EFFORT PTPC
/* AREA DI RISCHIO */
JOIN WORK_EFFORT_ASSOC WEA ON WEA.WORK_EFFORT_ID_FROM = PTPC.WORK_EFFORT_ID AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '15APPPC'
JOIN WORK_EFFORT AREA ON AREA.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_TO AND AREA.WORK_EFFORT_TYPE_ID = '15AP1ARE' AND AREA.WORK_EFFORT_REVISION_ID IS NULL
    AND AREA.ESTIMATED_START_DATE <= @date3112 AND (AREA.ESTIMATED_COMPLETION_DATE >= @date0101 OR AREA.ESTIMATED_COMPLETION_DATE IS NULL )
/* PROCESSO */
JOIN WORK_EFFORT_ASSOC WEA2 ON WEA2.WORK_EFFORT_ID_FROM = AREA.WORK_EFFORT_ID AND WEA2.WORK_EFFORT_ASSOC_TYPE_ID = '15APPPC'
JOIN WORK_EFFORT FIL_W ON FIL_W.WORK_EFFORT_ID = WEA2.WORK_EFFORT_ID_TO
    AND FIL_W.WORK_EFFORT_TYPE_ID = '15AP2SAR'
    AND FIL_W.WORK_EFFORT_REVISION_ID IS NULL
    AND FIL_W.ESTIMATED_START_DATE <= @date3112
    AND (FIL_W.ESTIMATED_COMPLETION_DATE >= @date0101 OR FIL_W.ESTIMATED_COMPLETION_DATE IS NULL)
JOIN PARTY_ROLLUP_VIEW PV ON PV.PARTY_ID_TO = FIL_W.ORG_UNIT_ID
    AND PV.FROM_DATE <= @date3112
    AND (PV.THRU_DATE >= @date0101 OR PV.THRU_DATE IS NULL )
JOIN STATUS_ITEM SI ON SI.STATUS_ID = FIL_W.CURRENT_STATUS_ID
LEFT JOIN WORK_EFFORT_PURPOSE_TYPE WEPT ON WEPT.WORK_EFFORT_PURPOSE_TYPE_ID = FIL_W.WORK_EFFORT_PURPOSE_TYPE_ID
 
@filterInnerJoin
@filterLeftJoin
 
 
/* NOTE DEL PROCESSO */
LEFT JOIN (
    SELECT
        WEN.WORK_EFFORT_ID,
		MAX(CASE WHEN WEN.SEQUENCE_ID = '110' THEN TO_CHAR(ND.NOTE_INFO) ELSE NULL END) AS DESCR /*,
		MAX(CASE WHEN WEN.SEQUENCE_ID = '120' THEN TO_CHAR(ND.NOTE_INFO) ELSE NULL END) AS PROD,
		MAX(CASE WHEN WEN.SEQUENCE_ID = '220' THEN TO_CHAR(ND.NOTE_INFO) ELSE NULL END) AS DEST,
		MAX(CASE WHEN WEN.SEQUENCE_ID = '240' THEN TO_CHAR(ND.NOTE_INFO) ELSE NULL END) AS STAKE*/
    FROM WORK_EFFORT_NOTE WEN
    JOIN NOTE_DATA ND ON ND.NOTE_ID = WEN.NOTE_ID
    GROUP BY
        WEN.WORK_EFFORT_ID
) NOTE ON NOTE.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
/* STRUTTURA RESPONSABILE */
JOIN PARTY UO ON UO.PARTY_ID = FIL_W.ORG_UNIT_ID
JOIN PARTY_PARENT_ROLE PPRUO ON PPRUO.PARTY_ID = UO.PARTY_ID
/* COLLEGAMENTO A PROCESSO TIPO */
LEFT JOIN WORK_EFFORT_ASSOC WEATIP ON WEATIP.WORK_EFFORT_ID_TO = FIL_W.WORK_EFFORT_ID AND WEATIP.WORK_EFFORT_ASSOC_TYPE_ID = '21C4PROC4'
LEFT JOIN WORK_EFFORT PROCTIP ON PROCTIP.WORK_EFFORT_ID = WEATIP.WORK_EFFORT_ID_FROM AND PROCTIP.WORK_EFFORT_TYPE_ID = '21C40PRO' AND PROCTIP.WORK_EFFORT_REVISION_ID IS NULL
    AND PROCTIP.ESTIMATED_START_DATE <= @date3112 AND (PROCTIP.ESTIMATED_COMPLETION_DATE >= @date0101 OR PROCTIP.ESTIMATED_COMPLETION_DATE IS NULL)
/* COLLEGAMENTO AD AREA TEMATICA */
LEFT JOIN WORK_EFFORT_ASSOC WEATEM ON WEATEM.WORK_EFFORT_ID_TO = FIL_W.WORK_EFFORT_ID AND WEATEM.WORK_EFFORT_ASSOC_TYPE_ID = '21D2C2'
LEFT JOIN WORK_EFFORT TEM ON TEM.WORK_EFFORT_ID = WEATEM.WORK_EFFORT_ID_FROM AND TEM.WORK_EFFORT_TYPE_ID = '21D24PRO' AND TEM.WORK_EFFORT_REVISION_ID IS NULL
    AND TEM.ESTIMATED_START_DATE <= @date3112 AND (TEM.ESTIMATED_COMPLETION_DATE >= @date0101 OR TEM.ESTIMATED_COMPLETION_DATE IS NULL)
/* FASE/ATTIVITA' */
JOIN WORK_EFFORT_ASSOC WEA3 ON WEA3.WORK_EFFORT_ID_FROM = FIL_W.WORK_EFFORT_ID AND WEA3.WORK_EFFORT_ASSOC_TYPE_ID = '15APSARC'
JOIN WORK_EFFORT FASE ON FASE.WORK_EFFORT_ID = WEA3.WORK_EFFORT_ID_TO AND FASE.WORK_EFFORT_TYPE_ID = '15AP3PRO' AND FASE.WORK_EFFORT_REVISION_ID IS NULL
    AND FASE.ESTIMATED_START_DATE <= @date3112 AND (FASE.ESTIMATED_COMPLETION_DATE >= @date0101 OR FASE.ESTIMATED_COMPLETION_DATE IS NULL)
/* NOTE DELLA FASE */
/* LEFT JOIN (
	SELECT 
		WEN.WORK_EFFORT_ID,
		MAX(CASE WHEN WEN.SEQUENCE_ID = '10' THEN dbms_lob.substr(ND.NOTE_INFO,3880,1) 
		--TO_CHAR(ND.NOTE_INFO) 
		ELSE NULL END) AS DESCR,
		MAX(CASE WHEN WEN.SEQUENCE_ID = '10' THEN dbms_lob.substr(ND.NOTE_INFO,7800,3881) ELSE NULL END) AS DESCR1
	FROM WORK_EFFORT_NOTE WEN
	JOIN NOTE_DATA ND ON ND.NOTE_ID = WEN.NOTE_ID
	GROUP BY WEN.WORK_EFFORT_ID
) NOTEFAS ON NOTEFAS.WORK_EFFORT_ID = FASE.WORK_EFFORT_ID */
/* RISCHIO */
JOIN WORK_EFFORT_ASSOC WEA4 ON WEA4.WORK_EFFORT_ID_FROM = FASE.WORK_EFFORT_ID AND WEA4.WORK_EFFORT_ASSOC_TYPE_ID = '15APSARC'
JOIN WORK_EFFORT RIS ON RIS.WORK_EFFORT_ID = WEA4.WORK_EFFORT_ID_TO AND RIS.WORK_EFFORT_TYPE_ID = '15AP4RIS' AND RIS.WORK_EFFORT_REVISION_ID IS NULL
    AND RIS.ESTIMATED_START_DATE <= @date3112 AND (RIS.ESTIMATED_COMPLETION_DATE >= @date0101 OR RIS.ESTIMATED_COMPLETION_DATE IS NULL)
/* NOTE DEL RISCHIO */
LEFT JOIN WORK_EFFORT_NOTE WENRIS ON WENRIS.WORK_EFFORT_ID = RIS.WORK_EFFORT_ID
LEFT JOIN NOTE_DATA NDRIS ON NDRIS.NOTE_ID = WENRIS.NOTE_ID
/* VALUTAZIONE RISCHIO */
LEFT JOIN (
    SELECT
        WEM.WORK_EFFORT_ID,
        MAX(CASE WHEN WEM.GL_ACCOUNT_ID = 'CORRIS.1.1' THEN GAMRS.UOM_DESCR ELSE NULL END) AS VAL1,
        MAX(CASE WHEN WEM.GL_ACCOUNT_ID = 'CORRIS.1.2' THEN GAMRS.UOM_DESCR ELSE NULL END) AS VAL2,
        MAX(CASE WHEN WEM.GL_ACCOUNT_ID = 'CORRIS.1.3' THEN GAMRS.UOM_DESCR ELSE NULL END) AS VAL3,
        MAX(CASE WHEN WEM.GL_ACCOUNT_ID = 'CORRIS.1.4' THEN GAMRS.UOM_DESCR ELSE NULL END) AS VAL4,
        MAX(CASE WHEN WEM.GL_ACCOUNT_ID = 'CORRIS.3.1' THEN GAMRS.UOM_DESCR ELSE NULL END) AS VAL5,
        MAX(CASE WHEN WEM.GL_ACCOUNT_ID = 'CORRIS.4.1' THEN GAMRS.UOM_DESCR ELSE NULL END) AS VAL6,
        MAX(CASE WHEN WEM.GL_ACCOUNT_ID = 'CORRIS.5.1' THEN GAMRS.UOM_DESCR ELSE NULL END) AS VAL7
    FROM WORK_EFFORT_MEASURE WEM
    JOIN WORK_EFFORT_PURPOSE_ACCOUNT WEPA ON WEPA.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID AND WEPA.WORK_EFFORT_PURPOSE_TYPE_ID = 'CORRIS'
    JOIN ACCTG_TRANS ACT ON ACT.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID --AND ACT.TRANSACTION_DATE = @date3112
    JOIN ACCTG_TRANS_ENTRY ATE ON ATE.ACCTG_TRANS_ID = ACT.ACCTG_TRANS_ID
    LEFT JOIN GL_ACCOUNT_MEAS_RAT_SC GAMRS ON GAMRS.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID
        AND GAMRS.UOM_RATING_VALUE = ATE.AMOUNT
    GROUP BY WEM.WORK_EFFORT_ID
) VAL ON VAL.WORK_EFFORT_ID = RIS.WORK_EFFORT_ID
/* MISURA */
 
JOIN WORK_EFFORT_ASSOC WEA5 ON
WEA5.WORK_EFFORT_ID_FROM = RIS.WORK_EFFORT_ID
AND WEA5.WORK_EFFORT_ASSOC_TYPE_ID = '15APSARC'
JOIN WORK_EFFORT MIS ON MIS.WORK_EFFORT_ID = WEA5.WORK_EFFORT_ID_TO AND MIS.WORK_EFFORT_TYPE_ID = '15AP5M1' AND MIS.WORK_EFFORT_REVISION_ID IS NULL
    AND MIS.ESTIMATED_START_DATE <= @date3112 AND (MIS.ESTIMATED_COMPLETION_DATE >= @date0101 OR MIS.ESTIMATED_COMPLETION_DATE IS NULL)
LEFT JOIN WORK_EFFORT_PURPOSE_TYPE WEPTMIS ON WEPTMIS.WORK_EFFORT_PURPOSE_TYPE_ID = MIS.WORK_EFFORT_PURPOSE_TYPE_ID
/* NOTE DELLA MISURA */
LEFT JOIN WORK_EFFORT_NOTE WENMIS ON WENMIS.WORK_EFFORT_ID = MIS.WORK_EFFORT_ID
LEFT JOIN NOTE_DATA NDMIS ON NDMIS.NOTE_ID = WENMIS.NOTE_ID
/* INDICATORI SULLA MISURA */
LEFT JOIN (
	SELECT
		WEM_INDIC.WORK_EFFORT_ID, 
		GA.ACCOUNT_NAME,
		WEM_INDIC.UOM_DESCR,
		INDIC.AMOUNT,INDIC.UOM_CODE,U.UOM_TYPE_ID,INDIC.GL_FISCAL_TYPE_ID,INDIC.TRANSACTION_DATE
	FROM WORK_EFFORT_MEASURE WEM_INDIC
	JOIN GL_ACCOUNT GA ON WEM_INDIC.GL_ACCOUNT_ID = GA.GL_ACCOUNT_ID AND GA.INPUT_ENUM_ID = 'ACCINP_OBJ'
	JOIN WORK_EFFORT_PURPOSE_ACCOUNT WEPA ON WEPA.GL_ACCOUNT_ID = GA.GL_ACCOUNT_ID AND WEPA.WORK_EFFORT_PURPOSE_TYPE_ID = 'CORMIS'
	JOIN UOM U ON GA.DEFAULT_UOM_ID = U.UOM_ID
	LEFT JOIN (
		SELECT ATE.VOUCHER_REF,ATE.AMOUNT,WEMRS.UOM_CODE,AT2.GL_FISCAL_TYPE_ID,AT2.TRANSACTION_DATE
		FROM ACCTG_TRANS_ENTRY ATE
		JOIN ACCTG_TRANS AT2 ON AT2.ACCTG_TRANS_ID = ATE.ACCTG_TRANS_ID AND AT2.TRANSACTION_DATE = @date3112
		LEFT JOIN WORK_EFFORT_MEAS_RAT_SC WEMRS ON ATE.VOUCHER_REF = WEMRS.WORK_EFFORT_MEASURE_ID
	) INDIC ON INDIC.VOUCHER_REF = WEM_INDIC.WORK_EFFORT_MEASURE_ID
	WHERE WEM_INDIC.FROM_DATE <= @date3112 AND (WEM_INDIC.THRU_DATE >= @date0101 OR WEM_INDIC.THRU_DATE IS NULL)
) INDIC ON INDIC.WORK_EFFORT_ID = MIS.WORK_EFFORT_ID

/*LEFT JOIN WORK_EFFORT_TRANS_ALL_VIEW WETA ON WETA.M_WORK_EFFORT_ID = MIS.WORK_EFFORT_ID 
    AND WETA.M_FROM_DATE <= TO_DATE('12/31/2024','MM/DD/YYYY') AND (WETA.M_THRU_DATE >= TO_DATE('01/01/2024','MM/DD/YYYY') OR WETA.M_THRU_DATE IS NULL)
    AND WETA.TT_TRANSACTION_DATE = TO_DATE('12/31/2024','MM/DD/YYYY')*/

WHERE PTPC.WORK_EFFORT_TYPE_ID = '15AP0PPC' AND PTPC.WORK_EFFORT_REVISION_ID IS NULL
    AND PTPC.ESTIMATED_START_DATE <= @date3112 AND (PTPC.ESTIMATED_COMPLETION_DATE >= @date0101 OR PTPC.ESTIMATED_COMPLETION_DATE IS NULL)

    @orgUnitId
    @includiStruttureIncardinate
    @enumeration
    @filterWhere
    
    
    
GROUP BY
    FIL_W.SOURCE_REFERENCE_ID,
    CONCAT(CONCAT(FIL_W.SOURCE_REFERENCE_ID, ' - '),FIL_W.WORK_EFFORT_NAME),
    CONCAT(PPRUO.PARENT_ROLE_CODE,
    CONCAT(' - ', UO.PARTY_NAME)),SI.DESCRIPTION,WEPT.DESCRIPTION,NOTE.DESCR,--NOTE.PROD,
    CONCAT(AREA.ETCH, CONCAT(' - ', AREA.WORK_EFFORT_NAME)),
    CONCAT(PROCTIP.ETCH, CONCAT(' - ', PROCTIP.WORK_EFFORT_NAME)),
    CONCAT(TEM.ETCH, CONCAT(' - ', TEM.WORK_EFFORT_NAME)),--NOTE.DEST,NOTE.STAKE,CONCAT(NOTEFAS.DESCR,NOTEFAS.DESCR1),
    FASE.ETCH,
    FASE.WORK_EFFORT_NAME,RIS.WORK_EFFORT_NAME,
    VAL.VAL1,VAL.VAL2,VAL.VAL3,VAL.VAL4,VAL.VAL5,VAL.VAL6,VAL.VAL7,
    CONCAT(MIS.ETCH, CONCAT(' - ', MIS.WORK_EFFORT_NAME)),WEPTMIS.DESCRIPTION,INDIC.ACCOUNT_NAME,INDIC.UOM_DESCR, 
    CONCAT(RIS.ETCH, CONCAT(' - ', RIS.WORK_EFFORT_NAME)),
    --MIS.WORK_EFFORT_PURPOSE_TYPE_ID,
    RIS.WORK_EFFORT_ID
ORDER BY
    CONCAT(AREA.ETCH, CONCAT(' - ', AREA.WORK_EFFORT_NAME)),
    FIL_W.SOURCE_REFERENCE_ID,
    FASE.ETCH,
    CONCAT(RIS.ETCH, CONCAT(' - ', RIS.WORK_EFFORT_NAME)),
    CONCAT(MIS.ETCH, CONCAT(' - ', MIS.WORK_EFFORT_NAME))]]></xml-property>
        </oda-data-set>
    </data-sets>
