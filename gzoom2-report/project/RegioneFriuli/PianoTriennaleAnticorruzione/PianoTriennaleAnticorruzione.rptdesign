                    <property name="name">Mancata attuazione delle misure di trattamento (livello)</property>
                    <property name="nativeName">Mancata attuazione delle misure di trattamento (livello)</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">19</property>
                    <property name="name">Livello di arretrato per mancato rispetto dei termini dei procedimenti coinvolti nel processo</property>
                    <property name="nativeName">Livello di arretrato per mancato rispetto dei termini dei procedimenti coinvolti nel processo</property>
