                    <property name="nativeName">Fase Etch</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">13</property>
                    <property name="name">Evento rischioso</property>
                    <property name="nativeName">Evento rischioso</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">14</property>
                    <property name="name">Livello di interesse esterno</property>
                    <property name="nativeName">Livello di interesse esterno</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">15</property>
                    <property name="name">Grado di discrezionalità  del decisore interno alla PA</property>
                    <property name="nativeName">Grado di discrezionalità  del decisore interno alla PA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">16</property>
                    <property name="name">Manifestazione di eventi corruttivi in passato nel processo</property>
                    <property name="nativeName">Manifestazione di eventi corruttivi in passato nel processo</property>
