	<queryString>
		<![CDATA[select 
	wet.etch as TIPOLOGIA_TRATTAMENTO,
	FIL_W.work_effort_name as NOME_TRATTAMENTO,
	FIL_W.etch as ETCH_TRATTAMENTO, 
	FIL_W.source_reference_id as CODICE_TRATTAMENTO,
	FIL_W.estimated_start_date as DATA_INIZIO_TRATTAMENTO, 
	FIL_W.estimated_completion_date as DATA_FINE_TRATTAMENTO,
	rl.description as TIPOLOGIA_UNITA_RESPONSABILE, 
	CONCAT(pprstrutt.parent_role_code, CONCAT(' - ', strutt.party_name)) as UNITA_RESPONSABILE,
	/* 1 - Descrizione trattamento */
	NOTE.NOME_DESCRIZIONE_TRATTAMENTO as NOME1, 
	NOTE.DESCRIZIONE_TRATTAMENTO as INFO1, 
	/* 2 - Base giuridica del trattmento */
	--folder.nome_basgiu as NOME2, 
	note.NOME_BASE as NOME2,
	basgiu.lista as INFO2,
	/* 3 - Trasferimento dati all'estero */
	--folder.nome_basgiu as NOME3, 
	note.NOME_TRASFERIMENTO as NOME3, 
	trasdat.lista as INFO3, 
	/* 4 - Categorie di dati personali trattati */
	folder.nome_datpart as NOME4, 
	datpart.lista as INFO4,
	/* 5 - Categorie di destinatari */
	--folder.nome_dest as NOME5,
	note.NOME_DESTINATARI as NOME5,
	dest.lista as INFO5,
	/* 6 - Categorie di interessati */
	--folder.nome_dest as NOME6, 
	note.NOME_INTERESSATI as NOME6,
	catint.lista as INFO6, 
	/* 7 - Misure di sicurezza */
	folder.nome_missic as NOME7, 
	missic.lista as INFO7, 
	/* 8 - Responsabili del trattamento */
	note.NOME_RESPONSABILE_ESTERNO as NOME8, 
	note.RESPONSABILE_ESTERNO as INFO8,
	/* 9 - Legge */
	note.NOME_LEGGE as NOME9, 
	note.LEGGE as INFO9, 
	/* 10 - Ulteriori misure di sicurezza */
	note.nome_ulteriori as NOME10, 
	note.ulteriori_misure as INFO10,
	/* 11 - Dettagli attività che comporta il trattamento */
	note.NOME_ATTIVITA as NOME11, 
	note.ATTIVITA_TRATTAMENTO as INFO11, 
	/* 12 - Termini di cancellazione */
	note.NOME_TERMINE as NOME12, 
	note.TERMINE as INFO12, 
	/* 13 - Messa a disposizione dell’Informativa agli interessati */
	tracar.nome_indic1 as NOME13, 
	tracar.indic1 as INFO13, 
	/* 14 - Atto di nomina del responsabile esterno */
	tracar.nome_indic2 as NOME14, 
	tracar.indic2 as INFO14,
	/* 15 - Nota Base giuridica del trattamento */
	note.NOME_BASE as NOME15, 
	note.BASE_GIURIDICA as INFO15, 
	/* 16 - Note Trasferimento dati estero */
	note.NOME_TRASFERIMENTO as NOME16, 
	note.TRASFERIMENTO_DATI as INFO16,
	/* 17 - Note Categorie di dati personali trattate */
	note.NOME_PERSONALI as NOME17, 
	note.DATI_PERSONALI as INFO17,
	/* 18 - Note Categorie di interessati */
	note.NOME_INTERESSATI as NOME18, 
	note.INTERESSATI as INFO18, 
	/* 19 - Note Categorie di destinatari */
	note.NOME_DESTINATARI as NOME19, 
	note.DESTINATARI as INFO19,
	/* 20 - Note */
	NOTE.NOME_NOTE as NOME20, 
	NOTE.NOTE as INFO20,
	/* 21 - XXXX */
	NULL as NOME21, 
	NULL as INFO21, 
	/* 22 - XXXX */
	NULL as NOME22, 
	NULL as INFO22, 
	null as NOME23, 
	null as INFO23, 
	null as NOME24, 
	null as INFO24, 
	null as NOME25, 
	null as INFO25 
/* TRATTAMENTO */
from work_effort FIL_W
join work_effort_type wet on wet.work_effort_type_id = FIL_W.work_effort_type_id
/* UNITA' RESPONSABILE */
join party strutt on strutt.party_id = FIL_W.org_unit_id
join party_parent_role pprstrutt on pprstrutt.party_id = strutt.party_id
join party_role prstrutt on prstrutt.party_id = strutt.party_id
join role_type rl on rl.role_type_id = prstrutt.role_type_id and rl.parent_type_id = 'ORGANIZATION_UNIT'
join party org on org.party_id = FIL_W.organization_id

$P!{filterInnerJoinString} 
$P!{filterLeftJoinString} 

/* NOMI DEI FOLDER */
left join (
	select 
		WETC.WORK_EFFORT_TYPE_ID,
		MAX(case when WETC.CONTENT_ID = 'WEFLD_IND' then WETC.ETCH else null END) as NOME_TRACAR,
		MAX(case when WETC.CONTENT_ID = 'WEFLD_IND2' then WETC.ETCH else null END) as NOME_BASGIU,
		MAX(case when WETC.CONTENT_ID = 'WEFLD_IND3' then WETC.ETCH else null END) as NOME_DATPART,
		MAX(case when WETC.CONTENT_ID = 'WEFLD_IND4' then WETC.ETCH else null END) as NOME_DEST,
		MAX(case when WETC.CONTENT_ID = 'WEFLD_IND5' then WETC.ETCH else null END) as NOME_MISSIC
	from WORK_EFFORT_TYPE_CONTENT WETC
	group by
		WETC.WORK_EFFORT_TYPE_ID
) FOLDER on FOLDER.WORK_EFFORT_TYPE_ID = FIL_W.WORK_EFFORT_TYPE_ID
/* NOTE */
left join (
	select 
		wen.work_effort_id,
		max(case when wen.sequence_id = 110 then nd.note_name else null end) as NOME_DESCRIZIONE_TRATTAMENTO,
		MAX(CASE WHEN WEN.SEQUENCE_ID = 110 THEN TO_CHAR(ND.NOTE_INFO) ELSE NULL END) AS DESCRIZIONE_TRATTAMENTO,
		max(case when wen.sequence_id = 160 then nd.note_name else null end) as NOME_RESPONSABILE_ESTERNO,
		max(case when wen.sequence_id = 160 then TO_CHAR(ND.NOTE_INFO) ELSE NULL END) as RESPONSABILE_ESTERNO,
		max(case when wen.sequence_id = 130 then nd.note_name else null end) as NOME_LEGGE,
		max(case when wen.sequence_id = 130 then TO_CHAR(ND.NOTE_INFO) ELSE NULL END) as LEGGE,
		max(case when wen.sequence_id = 350 then nd.note_name else null end) as NOME_ULTERIORI,
		max(case when wen.sequence_id = 350 then TO_CHAR(ND.NOTE_INFO) ELSE NULL END) as ULTERIORI_MISURE,
		max(case when wen.sequence_id = 100 then nd.note_name else null end) as NOME_ATTIVITA,
		max(case when wen.sequence_id = 100 then TO_CHAR(ND.NOTE_INFO) ELSE NULL END) as ATTIVITA_TRATTAMENTO,
		max(case when wen.sequence_id = 120 then nd.note_name else null end) as NOME_TERMINE,
		max(case when wen.sequence_id = 120 then TO_CHAR(ND.NOTE_INFO) ELSE NULL END) as TERMINE,
		--max(case when wen.sequence_id = 150 then nd.note_name else null end) as NOME_BASE,
		'Base giuridica del trattamento' AS NOME_BASE,
		max(case when wen.sequence_id = 150 then TO_CHAR(ND.NOTE_INFO) ELSE NULL END) as BASE_GIURIDICA,
		--max(case when wen.sequence_id = 170 then nd.note_name else null end) as NOME_TRASFERIMENTO,
		'Trasferimento dati personali verso Paesi terzi o organizzazioni internazionali' AS NOME_TRASFERIMENTO,
		max(case when wen.sequence_id = 170 then TO_CHAR(ND.NOTE_INFO) ELSE NULL END) as TRASFERIMENTO_DATI,
		max(case when wen.sequence_id = 180 then nd.note_name else null end) as NOME_PERSONALI,
		max(case when wen.sequence_id = 180 then TO_CHAR(ND.NOTE_INFO) ELSE NULL END) as DATI_PERSONALI,
		--max(case when wen.sequence_id = 190 then nd.note_name else null end) as NOME_INTERESSATI,
		'Categorie di interessati' AS NOME_INTERESSATI,
		max(case when wen.sequence_id = 190 then TO_CHAR(ND.NOTE_INFO) ELSE NULL END) as INTERESSATI,
		--max(case when wen.sequence_id = 200 then nd.note_name else null end) as NOME_DESTINATARI,
		'Categorie di destinatari' AS NOME_DESTINATARI,
		max(case when wen.sequence_id = 200 then TO_CHAR(ND.NOTE_INFO) ELSE NULL END) as DESTINATARI,
	    max(case when wen.sequence_id = 140 then nd.note_name else null end) as NOME_NOTE,
		max(case when wen.sequence_id = 140 then TO_CHAR(ND.NOTE_INFO) ELSE NULL END) as NOTE
	from work_effort_note wen 
	join note_data nd on nd.note_id = wen.note_id
	group by wen.work_effort_id
) note on note.work_effort_id = FIL_W.work_effort_id
/* BASE GIURIDICA DI TRATTAMENTO */
left join (
	select 
		wem.work_effort_id,
		LISTAGG(account_name, ',') WITHIN GROUP (ORDER BY account_name) as lista
	from work_effort_measure wem
	join gl_account gl on gl.gl_account_id = wem.gl_account_id AND gl.account_code LIKE 'BASGIU%'
	join work_effort_purpose_account wepa on wepa.gl_account_id = wem.gl_account_id and wepa.work_effort_purpose_type_id = 'BASGIU' --AND wepa.work_effort_purpose_type_id <> 'TRASDAT') 
	join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id and ate.amount = 1
	group by
		wem.work_effort_id 
) basgiu ON basgiu.work_effort_id = FIL_W.work_effort_id
/* TRASFERIMENTO DATI ESTERO */
left join (
	select 
		wem.work_effort_id,
		LISTAGG(account_name, ',') WITHIN GROUP (ORDER BY account_name) as lista
	from work_effort_measure wem
	join gl_account gl on gl.gl_account_id = wem.gl_account_id 
	join work_effort_purpose_account wepa on wepa.gl_account_id = wem.gl_account_id and wepa.work_effort_purpose_type_id = 'TRASDAT'
	join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id and ate.amount = 1
	group by
		wem.work_effort_id 
) trasdat ON trasdat.work_effort_id = FIL_W.work_effort_id
/* CATEGORIA DATI PARTICOLARI TRATTATI */
left join (
	select 
		wem.work_effort_id,
		LISTAGG(account_name, ',') WITHIN GROUP (ORDER BY account_name) as lista
	from work_effort_measure wem
	join gl_account gl on gl.gl_account_id = wem.gl_account_id 
	join work_effort_purpose_account wepa on wepa.gl_account_id = wem.gl_account_id and wepa.work_effort_purpose_type_id = 'DATPART'
	join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id and ate.amount = 1
	group by
		wem.work_effort_id 
) datpart ON datpart.work_effort_id = FIL_W.work_effort_id
/* CATEGORIA DESTINATARI */
left join (
	select 
		wem.work_effort_id,
		LISTAGG(account_name, ',') WITHIN GROUP (ORDER BY account_name) as lista
	from work_effort_measure wem
	join gl_account gl on gl.gl_account_id = wem.gl_account_id AND gl.account_code LIKE 'DEST%'
	join work_effort_purpose_account wepa on wepa.gl_account_id = wem.gl_account_id and wepa.work_effort_purpose_type_id = 'DEST' --and wepa.work_effort_purpose_type_id <> 'CATINT'
	join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id and ate.amount = 1
	group by
		wem.work_effort_id 
) dest ON dest.work_effort_id = FIL_W.work_effort_id
/* CATEGORIA INTERESSATI */
left join (
	select 
		wem.work_effort_id,
		LISTAGG(account_name, ',') WITHIN GROUP (ORDER BY account_name) as lista
	from work_effort_measure wem
	join gl_account gl on gl.gl_account_id = wem.gl_account_id 
	join work_effort_purpose_account wepa on wepa.gl_account_id = wem.gl_account_id and wepa.work_effort_purpose_type_id = 'CATINT'
	join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id and ate.amount = 1
	group by
		wem.work_effort_id 
) catint ON catint.work_effort_id = FIL_W.work_effort_id
/* MISURE DI SICUREZZA */
left join (
	select 
		wem.work_effort_id,
		LISTAGG(account_name, ',') WITHIN GROUP (ORDER BY account_name) as lista
	from work_effort_measure wem
	join gl_account gl on gl.gl_account_id = wem.gl_account_id 
	join work_effort_purpose_account wepa on wepa.gl_account_id = wem.gl_account_id and wepa.work_effort_purpose_type_id = 'MISSIC'
	join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id and ate.amount = 1
	group by
		wem.work_effort_id 
) missic on missic.work_effort_id = FIL_W.work_effort_id
/* CARATTERISTICHE PRIVACY */
left join (
	select 
		wem.work_effort_id,
		max(case when gl.gl_account_id = '10042' then gl.account_name else null end) as nome_indic1,
		max(case when gl.gl_account_id = '10043' then gl.account_name else null end) as nome_indic2,
		max(case when gl.gl_account_id = '10042' then gamrs.uom_descr else null end) as indic1,
		max(case when gl.gl_account_id = '10043' then gamrs.uom_descr else null end) as indic2
	from work_effort_measure wem
	join gl_account gl on gl.gl_account_id = wem.gl_account_id 
	join work_effort_purpose_account wepa on wepa.gl_account_id = wem.gl_account_id and wepa.work_effort_purpose_type_id = 'TRACAR'
	join acctg_trans_entry ate on ate.voucher_ref = wem.work_effort_measure_id
	join gl_account_meas_rat_sc gamrs on gamrs.gl_account_id = wem.gl_account_id 
		and gamrs.uom_rating_value = ate.amount 
	group by
		wem.work_effort_id 
) tracar on tracar.work_effort_id = FIL_W.work_effort_id
where FIL_W.work_effort_type_id = '18PRTR0TRA' and FIL_W.work_effort_revision_id is null
	and FIL_W.ESTIMATED_START_DATE <= CAST($P{date3112} AS TIMESTAMP ) and (FIL_W.ESTIMATED_COMPLETION_DATE >=CAST($P{date0101} AS TIMESTAMP ) or FIL_W.ESTIMATED_COMPLETION_DATE is null)
	$P!{filterWhereString} 
	$P!{orgUnitIdString} 
ORDER BY
	WET.ETCH,
	FIL_W.ETCH]]>
	</queryString>
	<field name="TIPOLOGIA_TRATTAMENTO" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="TIPOLOGIA_TRATTAMENTO"/>
		<property name="com.jaspersoft.studio.field.label" value="TIPOLOGIA_TRATTAMENTO"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="work_effort_type"/>
	</field>
	<field name="NOME_TRATTAMENTO" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="NOME_TRATTAMENTO"/>
		<property name="com.jaspersoft.studio.field.label" value="NOME_TRATTAMENTO"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="work_effort"/>
	</field>
	<field name="ETCH_TRATTAMENTO" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="ETCH_TRATTAMENTO"/>
		<property name="com.jaspersoft.studio.field.label" value="ETCH_TRATTAMENTO"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="work_effort"/>
	</field>
	<field name="CODICE_TRATTAMENTO" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="CODICE_TRATTAMENTO"/>
		<property name="com.jaspersoft.studio.field.label" value="CODICE_TRATTAMENTO"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="work_effort"/>
	</field>
	<field name="DATA_INIZIO_TRATTAMENTO" class="java.sql.Timestamp">
