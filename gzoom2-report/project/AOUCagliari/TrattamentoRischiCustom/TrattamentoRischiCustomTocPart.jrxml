	<parameter name="orgUnitId" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="orgUnitIdString" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$P{orgUnitId}  != null && $P{orgUnitId}  != "" ? " AND (FIL_W.ORG_UNIT_ID = '"+ $P{orgUnitId} + "' OR FIL_W.WORK_EFFORT_ID = '"+ $P{workEffortId} + "')" : " AND FIL_W.ORG_UNIT_ID like '%%'"]]></defaultValueExpression>
	</parameter>
	<parameter name="localDispatcherName" class="java.lang.String">
		<defaultValueExpression><![CDATA["GDPRPERF"]]></defaultValueExpression>
	</parameter>
	<parameter name="customTimePeriod" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2020/01/01"]]></defaultValueExpression>
	</parameter>
	<parameter name="filterWhere" class="java.lang.String">
		<defaultValueExpression><![CDATA[new com.mapsengineering.base.birt.util.UtilFilter($P{userLoginId}, $P{localDispatcherName}).getWorkEffortFilterWhere()]]></defaultValueExpression>
	</parameter>
	<parameter name="filterLeftJoin" class="java.lang.String">
		<defaultValueExpression><![CDATA[new com.mapsengineering.base.birt.util.UtilFilter($P{userLoginId}, $P{localDispatcherName}).getWorkEffortFilterLeftJoin()]]></defaultValueExpression>
	</parameter>
	<parameter name="filterInnerJoin" class="java.lang.String">
		<defaultValueExpression><![CDATA[new com.mapsengineering.base.birt.util.UtilFilter($P{userLoginId}, $P{localDispatcherName}).getWorkEffortFilterInner()]]></defaultValueExpression>
	</parameter>
	<parameter name="date3112" class="java.util.Date" isForPrompting="false">
		<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilDateTime.getMonthEndFromDatetime("12",$P{REPORT_TIME_ZONE}.getID(),INTEGER_VALUE($P{customTimePeriod}.substring(0,4)), $P{REPORT_LOCALE}.getDefault())]]></defaultValueExpression>
	</parameter>
	<parameter name="date3112sql" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[SUBSTITUTE(com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc($P{date3112}, $P{odaDialect}),"'","")]]></defaultValueExpression>
	</parameter>
	<parameter name="odaDialect" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="date0101" class="java.util.Date" isForPrompting="false">
		<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilDateTime.getMonthStartFromDatetime("1",$P{REPORT_TIME_ZONE}.getID(),INTEGER_VALUE($P{customTimePeriod}.substring(0,4)), $P{REPORT_LOCALE}.getDefault())]]></defaultValueExpression>
	</parameter>
	<parameter name="date0101sql" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[SUBSTITUTE(com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc($P{date0101}, $P{odaDialect}),"'","")]]></defaultValueExpression>
	</parameter>
	<parameter name="workEffortId" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[select
	WET.ETCH as TIPOLOGIA_TRATTAMENTO,
	FIL_W.WORK_EFFORT_ID as WORK_EFFORT_ID,
	FIL_W.WORK_EFFORT_NAME as TITOLO_TRATTAMENTO,
	FIL_W.ETCH as ETCH_TRATTAMENTO,
	FIL_W.SOURCE_REFERENCE_ID as CODICE_TRATTAMENTO,
	FIL_W.ESTIMATED_START_DATE as DATA_INIZIO_TRATTAMENTO,
	FIL_W.ESTIMATED_COMPLETION_DATE as DATA_FINE_TRATTAMENTO,
	RL.DESCRIPTION as TIPOLOGIA_UNITA_RESPONSABILE,
	CONCAT(PPRSTRUTT.PARENT_ROLE_CODE, ' - ', STRUTT.PARTY_NAME) as UNITA_RESPONSABILE,
	/* 1 - Descrizione trattamento */
	NOTE.NOME_DESCRIZIONE_TRATTAMENTO as NOME1,
	NOTE.DESCRIZIONE_TRATTAMENTO as INFO1,
	/* 3 - Categorie trattamenti */
	NOTE.NOME_CATEGORIE_TRATTAMENTI as NOME3,
	NOTE.CATEGORIE_TRATTAMENTI as INFO3,
	/* 4 - Finalità trattamento */
	FIN.ACCOUNT_NAME NOME4,
	FIN.LISTA as INFO4,
	/* 5 - Base giuridica e legittimità */
	BASE.ACCOUNT_NAME as NOME5,
	BASE.LISTA as INFO5,
	/* 6 - Strutture aziendali coinvolte */
	FOLDER.NOME_UNITA_ORGANIZZATIVE as NOME6,
	UO.LISTA as INFO6,
	/* 9 - Contitolari */
	CON.DESCRIPTION as NOME9,
	CON.LISTA as INFO9,
	/* 10 - Titolari */
	"Titolare" as NOME10,
	case when WET.WORK_EFFORT_TYPE_ID = '18PRTR0TRA' then ORG.PARTY_NAME when WET.WORK_EFFORT_TYPE_ID = '18PRTR0TRR' then TIT.LISTA END as INFO10,
	/* 11 - Responsabili */
	RESP.DESCRIPTION as NOME11,
	RESP.LISTA as INFO11,
	/* 12  - Categorie di Interessati */
	CATINT.ACCOUNT_NAME as NOME12,
	CATINT.LISTA as INFO12,
	/* 13 - Categorie di destinatari dei dati personali */
	CATDEST.ACCOUNT_NAME as NOME13,
	CATDEST.LISTA as INFO13,
	/* 14 - Categorie di Dati Personali */
	DATPERS.ACCOUNT_NAME as NOME14,
	DATPERS.LISTA as INFO14,
	/* 15 - Asset utilizzati */
	FOLDER.NOME_ASSET as NOME15,
	ASSET.LISTA as INFO15,
	/* 17 - Termini cancellazione */
	NOTE.NOME_TERMINI_CANCELLAZIONE as NOME17,
	NOTE.TERMINI_CANCELLAZIONE as INFO17,
	/* 18 - Trasferimento dati */
	NOTE.NOME_TRASFERIMENTO_DATI as NOME18,
	NOTE.TRASFERIMENTO_DATI as INFO18,
	/* 20 - Misure di sicurezza */
	FOLDER.NOME_MISURE as NOME20,
	MIS.LISTA as INFO20,
	/* 21 - Necessità DPIA */
	FOLDER.NOME_DPIA as NOME21,
	DPIA.LISTA as INFO21
/* TRATTAMENTO */
FROM WORK_EFFORT_TYPE WET
JOIN WORK_EFFORT FIL_W ON FIL_W.WORK_EFFORT_TYPE_ID = WET.WORK_EFFORT_TYPE_ID
/* UNITA' RESPONSABILE */
join PARTY STRUTT on STRUTT.PARTY_ID = FIL_W.ORG_UNIT_ID 
join PARTY_PARENT_ROLE PPRSTRUTT on PPRSTRUTT.PARTY_ID = STRUTT.PARTY_ID and PPRSTRUTT.ROLE_TYPE_ID = 'ORGANIZATION_UNIT'
join PARTY_ROLE PRSTRUTT on PRSTRUTT.PARTY_ID = STRUTT.PARTY_ID 
join ROLE_TYPE RL on RL.ROLE_TYPE_ID = PRSTRUTT.ROLE_TYPE_ID and RL.PARENT_TYPE_ID = 'ORGANIZATION_UNIT'
join PARTY ORG on ORG.PARTY_ID = FIL_W.ORGANIZATION_ID

/* START filterInnerJoin */
 $P!{filterInnerJoin}
/* END filterInnerJoin */
/* START filterLeftJoin */
 $P!{filterLeftJoin}
/* END filterLeftJoin */

/* NOMI DEI FOLDER */
left join (
	select 
		WETC.WORK_EFFORT_TYPE_ID,
		MAX(case when WETC.CONTENT_ID = 'WEFLD_ORGUNIT' then WETC.ETCH else null END) as NOME_UNITA_ORGANIZZATIVE,
		MAX(case when WETC.CONTENT_ID = 'WEFLD_WEFROM' then WETC.ETCH else null END) as NOME_ASSET,
		MAX(case when WETC.CONTENT_ID = 'WEFLD_IND2' then WETC.ETCH else null END) as NOME_MISURE,
		MAX(case when WETC.CONTENT_ID = 'WEFLD_IND3' then WETC.ETCH else null END) as NOME_DPIA
	from WORK_EFFORT_TYPE_CONTENT WETC
	group by
		WETC.WORK_EFFORT_TYPE_ID
) FOLDER on FOLDER.WORK_EFFORT_TYPE_ID = WET.WORK_EFFORT_TYPE_ID 
/* CAMPI NOTE */
LEFT JOIN (
	select
		WEN.WORK_EFFORT_ID,
		MAX(case when WEN.SEQUENCE_ID = 110 then ND.NOTE_NAME else null END) as NOME_CATEGORIE_TRATTAMENTI,
		MAX(case when WEN.SEQUENCE_ID = 110 then ND.NOTE_INFO else null END) as CATEGORIE_TRATTAMENTI,
		MAX(case when WEN.SEQUENCE_ID = 130 then ND.NOTE_NAME else null END) as NOME_DESCRIZIONE_TRATTAMENTO,
		MAX(case when WEN.SEQUENCE_ID = 130 then ND.NOTE_INFO else null END) as DESCRIZIONE_TRATTAMENTO,
		MAX(case when WEN.SEQUENCE_ID = 200 then ND.NOTE_NAME else null END) as NOME_TRASFERIMENTO_DATI,
		MAX(case when WEN.SEQUENCE_ID = 200 then ND.NOTE_INFO else null END) as TRASFERIMENTO_DATI,
		MAX(case when WEN.SEQUENCE_ID = 210 then ND.NOTE_NAME else null END) as NOME_TERMINI_CANCELLAZIONE,
		MAX(case when WEN.SEQUENCE_ID = 210 then ND.NOTE_INFO else null END) as TERMINI_CANCELLAZIONE,
		MAX(case when WEN.SEQUENCE_ID = 220 then ND.NOTE_NAME else null END) as NOME_GESTIONE_SICUREZZA,
		MAX(case when WEN.SEQUENCE_ID = 220 then ND.NOTE_INFO else null END) as GESTIONE_SICUREZZA
	from WORK_EFFORT_NOTE WEN
	join NOTE_DATA ND on ND.NOTE_ID = WEN.NOTE_ID
	group by WEN.WORK_EFFORT_ID 
) NOTE on NOTE.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
/* 4 - Finalità trattamento */
LEFT JOIN (
	SELECT WEM.WORK_EFFORT_ID, GL.ACCOUNT_NAME,
	GROUP_CONCAT(WEMRS.UOM_CODE ORDER BY WEMRS.UOM_RATING_VALUE SEPARATOR ',
') AS LISTA
	FROM WORK_EFFORT_MEASURE WEM 
	JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID 
	JOIN ACCTG_TRANS_ENTRY ATE ON ATE.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID
	JOIN WORK_EFFORT_MEAS_RAT_SC WEMRS ON WEMRS.WORK_EFFORT_MEASURE_ID = ATE.VOUCHER_REF
  		AND WEMRS.UOM_ID = GL.DEFAULT_UOM_ID AND WEMRS.UOM_RATING_VALUE = ATE.AMOUNT
	WHERE WEM.GL_ACCOUNT_ID IN ('10001','10054','10055','10056','10057')
	GROUP BY WEM.WORK_EFFORT_ID, GL.ACCOUNT_NAME
) FIN ON FIN.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
/* 5 - Base giuridica e legittimità */
LEFT JOIN (
	SELECT WEM.WORK_EFFORT_ID, GL.ACCOUNT_NAME, 
	GROUP_CONCAT(WEMRS.UOM_CODE ORDER BY WEMRS.UOM_RATING_VALUE SEPARATOR ',
') AS LISTA
	FROM WORK_EFFORT_MEASURE WEM 
	JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID 
	JOIN ACCTG_TRANS_ENTRY ATE ON ATE.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID
	JOIN WORK_EFFORT_MEAS_RAT_SC WEMRS ON WEMRS.WORK_EFFORT_MEASURE_ID = ATE.VOUCHER_REF
  		AND WEMRS.UOM_ID = GL.DEFAULT_UOM_ID AND WEMRS.UOM_RATING_VALUE = ATE.AMOUNT
	WHERE WEM.GL_ACCOUNT_ID IN ('10012','10050','10051','10052','10053')
	GROUP BY WEM.WORK_EFFORT_ID, GL.ACCOUNT_NAME
) BASE ON BASE.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
/* 6 - Struttura aziendali coinvolte */
LEFT JOIN (
	select
		WEPA.WORK_EFFORT_ID,
		GROUP_CONCAT(CONCAT(UOPPR.PARENT_ROLE_CODE, ' - ', UO.PARTY_NAME) ORDER BY CONCAT(UOPPR.PARENT_ROLE_CODE, ' - ', UO.PARTY_NAME) SEPARATOR ',
') AS LISTA
	from WORK_EFFORT_PARTY_ASSIGNMENT WEPA
	join PARTY UO on UO.PARTY_ID = WEPA.PARTY_ID
	join PARTY_PARENT_ROLE UOPPR on UOPPR.PARTY_ID = UO.PARTY_ID
	where WEPA.ROLE_TYPE_ID = 'STR' and WEPA.FROM_DATE <= $P{date3112sql} and (WEPA.THRU_DATE >= $P{date0101sql} or WEPA.THRU_DATE is NULL)
	group by WEPA.WORK_EFFORT_ID
) UO on UO.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
/* 9 - Contitolari */
LEFT JOIN (
	select
		WEPA.WORK_EFFORT_ID,
		GROUP_CONCAT(CONCAT(CONPPR.PARENT_ROLE_CODE, ' - ', CON.PARTY_NAME) ORDER BY CONCAT(CONPPR.PARENT_ROLE_CODE, ' - ', CON.PARTY_NAME) SEPARATOR ',
') AS LISTA,
	RL.DESCRIPTION
	from WORK_EFFORT_PARTY_ASSIGNMENT WEPA
	join PARTY CON on CON.PARTY_ID = WEPA.PARTY_ID
	join PARTY_PARENT_ROLE CONPPR on CONPPR.PARTY_ID = CON.PARTY_ID
	join PARTY_ROLE PRCON on PRCON.PARTY_ID = CON.PARTY_ID 
	join ROLE_TYPE RL on RL.ROLE_TYPE_ID = PRCON.ROLE_TYPE_ID and RL.ROLE_TYPE_ID = 'WEM_GDPR_CONTIT'
	where WEPA.ROLE_TYPE_ID = 'WEM_GDPR_CONTIT' and WEPA.FROM_DATE <= $P{date3112sql} and (WEPA.THRU_DATE >= $P{date0101sql} or WEPA.THRU_DATE is NULL)
	group by WEPA.WORK_EFFORT_ID, RL.DESCRIPTION, RL.DESCRIPTION
) CON on CON.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
/* 10 - Titolari */
LEFT JOIN (
	select
		WEPA.WORK_EFFORT_ID,
		GROUP_CONCAT(CONCAT(TITPPR.PARENT_ROLE_CODE, ' - ', TIT.PARTY_NAME) ORDER BY CONCAT(TITPPR.PARENT_ROLE_CODE, ' - ', TIT.PARTY_NAME) SEPARATOR ',
') AS LISTA,
	RL.DESCRIPTION
	from WORK_EFFORT_PARTY_ASSIGNMENT WEPA
	join PARTY TIT on TIT.PARTY_ID = WEPA.PARTY_ID
	join PARTY_PARENT_ROLE TITPPR on TITPPR.PARTY_ID = TIT.PARTY_ID
	join PARTY_ROLE PRTIT on PRTIT.PARTY_ID = TIT.PARTY_ID 
	join ROLE_TYPE RL on RL.ROLE_TYPE_ID = PRTIT.ROLE_TYPE_ID
	where WEPA.ROLE_TYPE_ID = 'WEM_GDPR_TRATTIT' and WEPA.FROM_DATE <= $P{date3112sql} and (WEPA.THRU_DATE >= $P{date0101sql} or WEPA.THRU_DATE is NULL)
	group by WEPA.WORK_EFFORT_ID, RL.DESCRIPTION
) TIT on TIT.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
/* 11 - Responsabili */
LEFT JOIN (
	select
		WEPA.WORK_EFFORT_ID,
		GROUP_CONCAT(CONCAT(RESPPPR.PARENT_ROLE_CODE, ' - ', RESP.PARTY_NAME) ORDER BY CONCAT(RESPPPR.PARENT_ROLE_CODE, ' - ', RESP.PARTY_NAME) SEPARATOR ',
') AS LISTA,
RL.DESCRIPTION
	from WORK_EFFORT_PARTY_ASSIGNMENT WEPA
	join PARTY RESP on RESP.PARTY_ID = WEPA.PARTY_ID
	join PARTY_PARENT_ROLE RESPPPR on RESPPPR.PARTY_ID = RESP.PARTY_ID
	join PARTY_ROLE PRRESP on PRRESP.PARTY_ID = RESP.PARTY_ID 
	join ROLE_TYPE RL on RL.ROLE_TYPE_ID = PRRESP.ROLE_TYPE_ID and RL.ROLE_TYPE_ID = 'WEM_GDPR_RESP'
	where WEPA.ROLE_TYPE_ID = 'WEM_GDPR_RESP' and WEPA.FROM_DATE <= $P{date3112sql} and (WEPA.THRU_DATE >= $P{date0101sql} or WEPA.THRU_DATE is NULL)
	group by WEPA.WORK_EFFORT_ID, RL.DESCRIPTION
) RESP on RESP.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
/* 12  - Categorie di Interessati */
LEFT JOIN (
	SELECT WEM.WORK_EFFORT_ID, GL.ACCOUNT_NAME, 
	GROUP_CONCAT(WEMRS.UOM_CODE ORDER BY WEMRS.UOM_RATING_VALUE SEPARATOR ',
') AS LISTA
	FROM WORK_EFFORT_MEASURE WEM 
	JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID 
	JOIN ACCTG_TRANS_ENTRY ATE ON ATE.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID
	JOIN WORK_EFFORT_MEAS_RAT_SC WEMRS ON WEMRS.WORK_EFFORT_MEASURE_ID = ATE.VOUCHER_REF
  		AND WEMRS.UOM_ID = GL.DEFAULT_UOM_ID AND WEMRS.UOM_RATING_VALUE = ATE.AMOUNT
	WHERE WEM.GL_ACCOUNT_ID IN ('10002','10058','10059','10060','10061')
	GROUP BY WEM.WORK_EFFORT_ID, GL.ACCOUNT_NAME
) CATINT ON CATINT.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
/* 13 - Categorie di destinatari dei dati personali */
LEFT JOIN (
	SELECT WEM.WORK_EFFORT_ID, GL.ACCOUNT_NAME,
	GROUP_CONCAT(WEMRS.UOM_CODE ORDER BY WEMRS.UOM_RATING_VALUE SEPARATOR ',
') AS LISTA
	FROM WORK_EFFORT_MEASURE WEM 
	JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID 
	JOIN ACCTG_TRANS_ENTRY ATE ON ATE.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID
	JOIN WORK_EFFORT_MEAS_RAT_SC WEMRS ON WEMRS.WORK_EFFORT_MEASURE_ID = ATE.VOUCHER_REF
  		AND WEMRS.UOM_ID = GL.DEFAULT_UOM_ID AND WEMRS.UOM_RATING_VALUE = ATE.AMOUNT
	WHERE WEM.GL_ACCOUNT_ID IN ('10011','10066','10067','10068','10069')
	GROUP BY WEM.WORK_EFFORT_ID, GL.ACCOUNT_NAME
) CATDEST ON CATDEST.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
/* 14 - Categorie di Dati Personali */
LEFT JOIN (
	SELECT WEM.WORK_EFFORT_ID, GL.ACCOUNT_NAME, 
	GROUP_CONCAT(WEMRS.UOM_CODE ORDER BY WEMRS.UOM_RATING_VALUE SEPARATOR ',
') AS LISTA
	FROM WORK_EFFORT_MEASURE WEM 
	JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID 
	JOIN ACCTG_TRANS_ENTRY ATE ON ATE.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID
	JOIN WORK_EFFORT_MEAS_RAT_SC WEMRS ON WEMRS.WORK_EFFORT_MEASURE_ID = ATE.VOUCHER_REF
  		AND WEMRS.UOM_ID = GL.DEFAULT_UOM_ID AND WEMRS.UOM_RATING_VALUE = ATE.AMOUNT
	WHERE WEM.GL_ACCOUNT_ID IN ('10000','10062','10063','10064','10065')
	GROUP BY WEM.WORK_EFFORT_ID, GL.ACCOUNT_NAME
) DATPERS ON DATPERS.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID 
/* 15 - Asset utilizzati */
left join (
	select WEA.WORK_EFFORT_ID_FROM,
		GROUP_CONCAT(CONCAT(WE.ETCH, ' - ', WE.WORK_EFFORT_NAME) ORDER BY CONCAT(WE.ETCH, ' - ', WE.WORK_EFFORT_NAME) SEPARATOR ',
') AS LISTA
	from WORK_EFFORT_ASSOC WEA
	join WORK_EFFORT WE on WE.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_TO and WE.WORK_EFFORT_REVISION_ID is null and WE.WORK_EFFORT_TYPE_ID = '18PRAS0ASS'
	where WEA.WORK_EFFORT_ASSOC_TYPE_ID = '18PRTRTRAC' and WEA.FROM_DATE <= $P{date3112sql} and (WEA.THRU_DATE >= $P{date0101sql} or WEA.THRU_DATE is NULL)
	group by WEA.WORK_EFFORT_ID_FROM
) ASSET on ASSET.WORK_EFFORT_ID_FROM = FIL_W.WORK_EFFORT_ID
/* 20 - Misure di sicurezza */
LEFT JOIN (
	SELECT 
		WEM.WORK_EFFORT_ID,
		GROUP_CONCAT(GL.ACCOUNT_NAME ORDER BY GL.ACCOUNT_NAME SEPARATOR ',
') AS LISTA
	FROM WORK_EFFORT_MEASURE WEM 
	JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID
	join WORK_EFFORT_PURPOSE_ACCOUNT WEPA on WEPA.GL_ACCOUNT_ID = GL.GL_ACCOUNT_ID 
	JOIN ACCTG_TRANS_ENTRY ATE ON ATE.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID and ATE.AMOUNT = 100
	JOIN WORK_EFFORT_MEAS_RAT_SC WEMRS ON WEMRS.WORK_EFFORT_MEASURE_ID = ATE.VOUCHER_REF
  		AND WEMRS.UOM_ID = GL.DEFAULT_UOM_ID AND WEMRS.UOM_RATING_VALUE = ATE.AMOUNT
	WHERE WEPA.WORK_EFFORT_PURPOSE_TYPE_ID = 'TRAMIS'
	group by
		WEM.WORK_EFFORT_ID
) MIS ON MIS.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
/* 21 - Necessità DPIA */
LEFT JOIN (
	SELECT 
		WEM.WORK_EFFORT_ID,
		GROUP_CONCAT(GL.ACCOUNT_NAME ORDER BY GL.ACCOUNT_NAME SEPARATOR ',
') AS LISTA
	FROM WORK_EFFORT_MEASURE WEM 
	JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID = WEM.GL_ACCOUNT_ID
	join WORK_EFFORT_PURPOSE_ACCOUNT WEPA on WEPA.GL_ACCOUNT_ID = GL.GL_ACCOUNT_ID 
	JOIN ACCTG_TRANS_ENTRY ATE ON ATE.VOUCHER_REF = WEM.WORK_EFFORT_MEASURE_ID and ATE.AMOUNT = 100
	JOIN WORK_EFFORT_MEAS_RAT_SC WEMRS ON WEMRS.WORK_EFFORT_MEASURE_ID = ATE.VOUCHER_REF
  		AND WEMRS.UOM_ID = GL.DEFAULT_UOM_ID AND WEMRS.UOM_RATING_VALUE = ATE.AMOUNT
	WHERE WEPA.WORK_EFFORT_PURPOSE_TYPE_ID = 'TRAVIP'
	group by
		WEM.WORK_EFFORT_ID
) DPIA ON DPIA.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
WHERE WET.WORK_EFFORT_TYPE_ID = $P{workEffortTypeId} and FIL_W.WORK_EFFORT_REVISION_ID is null
	and FIL_W.ESTIMATED_START_DATE <= $P{date3112sql} and (FIL_W.ESTIMATED_COMPLETION_DATE >= $P{date0101sql} or FIL_W.ESTIMATED_COMPLETION_DATE is null)
 /* START orgUnitIdString */
 $P!{orgUnitIdString}
 /* END orgUnitIdString */
  /* START filterWhere */
 $P!{filterWhere} 
   /* END filterWhere */
ORDER BY
	PPRSTRUTT.PARENT_ROLE_CODE,
	FIL_W.WORK_EFFORT_NAME]]>
	</queryString>
