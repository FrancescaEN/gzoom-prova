	<parameter name="orgUnitIdString" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$P{orgUnitId}  != null && $P{orgUnitId}  != "" ? " AND (FIL_W.ORG_UNIT_ID = '"+ $P{orgUnitId} + "' OR FIL_W.WORK_EFFORT_ID = '"+ $P{workEffortId} + "')" : " AND FIL_W.ORG_UNIT_ID like '%%'"]]></defaultValueExpression>
