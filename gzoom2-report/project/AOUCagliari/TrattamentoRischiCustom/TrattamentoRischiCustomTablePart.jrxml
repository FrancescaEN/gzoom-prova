	<subDataset name="StruttureAziendaliDS" uuid="2fa62515-e9f2-458e-b8c8-fbf8e3200346">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="gzoom_aoucagliari"/>
		<parameter name="date3112_struttAziendali" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilDateTime.getMonthEndFromDatetime("12",$P{REPORT_TIME_ZONE}.getID(),INTEGER_VALUE($P{customTimePeriod_struttAziendali}.substring(0,4)), $P{REPORT_LOCALE}.getDefault())]]></defaultValueExpression>
		</parameter>
		<parameter name="date3112sql_struttAziendali" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc($P{date3112_struttAziendali}, $P{odaDialect_struttAziendali});]]></defaultValueExpression>
		</parameter>
		<parameter name="date0101_struttAziendali" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilDateTime.getMonthStartFromDatetime("1",$P{REPORT_TIME_ZONE}.getID(),INTEGER_VALUE($P{customTimePeriod_struttAziendali}.substring(0,4)), $P{REPORT_LOCALE}.getDefault())]]></defaultValueExpression>
		</parameter>
		<parameter name="date0101sql_struttAziendali" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc($P{date0101_struttAziendali}, $P{odaDialect_struttAziendali});]]></defaultValueExpression>
		</parameter>
		<parameter name="work_effort_id_struttAziendali" class="java.lang.String">
			<defaultValueExpression><![CDATA[$P{work_effort_id_struttAziendali}]]></defaultValueExpression>
		</parameter>
		<parameter name="customTimePeriod_struttAziendali" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["2020/01/01"]]></defaultValueExpression>
		</parameter>
		<parameter name="odaDialect_struttAziendali" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
		</parameter>
		<queryString language="SQL">
			<![CDATA[select
WEPA.WORK_EFFORT_ID,
CONCAT(UOPPR.PARENT_ROLE_CODE, ' - ', UO.PARTY_NAME) AS LISTA
from WORK_EFFORT_PARTY_ASSIGNMENT WEPA
join PARTY UO on UO.PARTY_ID = WEPA.PARTY_ID
join PARTY_PARENT_ROLE UOPPR on UOPPR.PARTY_ID = UO.PARTY_ID
where WORK_EFFORT_ID = $P{work_effort_id_struttAziendali} AND
WEPA.ROLE_TYPE_ID = 'STR' and WEPA.FROM_DATE <= $P{date3112_struttAziendali} and (WEPA.THRU_DATE >= $P{date0101_struttAziendali} or WEPA.THRU_DATE is NULL)]]>
		</queryString>
		<field name="WORK_EFFORT_ID" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="WORK_EFFORT_ID"/>
			<property name="com.jaspersoft.studio.field.label" value="WORK_EFFORT_ID"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort_party_assignment"/>
		</field>
		<field name="LISTA" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="LISTA"/>
			<property name="com.jaspersoft.studio.field.label" value="LISTA"/>
		</field>
		<variable name="lista_struttAziendali" class="java.lang.String">
			<variableExpression><![CDATA[$F{LISTA}]]></variableExpression>
		</variable>
	</subDataset>
