	<variable name="ETICHETTA_MISURA" class="java.lang.String">
		<variableExpression><![CDATA[$F{MISURA_FINALITA} != null && $F{MISURA_FINALITA} != "" ? $F{MISURA_FINALITA}: $F{TIPO_MISURA_ETCH}]]></variableExpression>
		<initialValueExpression><![CDATA[$F{MISURA_FINALITA} != null && $F{MISURA_FINALITA} != "" ? $F{MISURA_FINALITA}: $F{TIPO_MISURA_ETCH}]]></initialValueExpression>
	</variable>
