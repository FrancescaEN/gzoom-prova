	<parameter name="date3112P2" class="java.util.Date" isForPrompting="false">
		<defaultValueExpression><![CDATA[com.mapsengineering.base.birt.util.UtilDateTime.getMonthEndFromDatetime("12",$P{REPORT_TIME_ZONE}.getID(),(YEAR($P{monitoringDate})+2), $P{REPORT_LOCALE}.getDefault())]]></defaultValueExpression>
	</parameter>
	<parameter name="date3112P2sql" class="java.lang.String">
		<defaultValueExpression><![CDATA[SUBSTITUTE(com.mapsengineering.base.birt.util.UtilsConvertJdbc.getConvertDateToDateJdbc($P{date3112P2}, $P{odaDialect}),"'","")]]></defaultValueExpression>
	</parameter>
	<parameter name="isAdmin" class="java.lang.Boolean" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT 
	RADTC.ETCH AS "RAD_TITOLO",
	RA.WORK_EFFORT_ID AS "RA_WORK_EFFORT_ID",
	RR.SEQUENCE_NUM AS "AREA_SEQUENCE",
	ART.ETCH AS "AREA_ETCH_TYPE", 
	AR.ETCH AS "AREA_ETCH", 
	AR.WORK_EFFORT_NAME AS "AREA_NAME",
	AR.WORK_EFFORT_ID AS "AREA_ID",
	AR.DESCRIPTION AS "AREA_DESC",																											
	PR.ETCH AS "PROCESSO_ETCH", 
	PRT.ETCH AS "PROCESSO_ETCH_TYPE", 
	PR.WORK_EFFORT_NAME AS "PROCESSO_NAME",	
	PR.WORK_EFFORT_ID AS "PROCESSO_ID",
	PR.DESCRIPTION AS "PROCESSO_DESC",	
	AP.SEQUENCE_NUM AS "PROCESSO_SEQUENCE",																								
	FIL_W.ETCH AS "SOTTOPROC_ETCH", 
	SPT.ETCH AS "SOTTOPROC_ETCH_TYPE",
	FIL_W.WORK_EFFORT_NAME AS "SOTTOPROC_NAME",
	FIL_W.WORK_EFFORT_ID AS "SOTTOPROC_ID",
	FIL_W.DESCRIPTION AS "SOTTOPROC_DESC",
	FIL_W.ESTIMATED_START_DATE AS "SOT_ESTI_START_DATE",
	PP.SEQUENCE_NUM AS "SOTTOPROC_SEQUENCE",			
	SC.PARENT_ROLE_CODE AS "SC_PARENT_ROLE_CODE", 
	ST.PARTY_NAME AS "ST_PARTY_NAME",																										
	RI.ETCH AS "RISCHIO_ETCH", 
	RIT.ETCH AS "RISCHIO_ETCH_TYPE",
	RI.WORK_EFFORT_NAME AS "RISCHIO_NAME",
	RI.WORK_EFFORT_ID AS "RISCHIO_ID",
	RI.DESCRIPTION AS "RISCHIO_DESCRI",
	AK.SEQUENCE_NUM	as "RISCHIO_SEQUENCE_NUM",	
	P_RES.PARTY_NAME AS "RESPONSABILE", 																					
	SPND.NOTE_NAME AS "SOTTOPRO_NOTE_NAME",
	SPND.NOTE_INFO AS "SOTTOPRO_NOTE_INFO",
	WEPT.DESCRIPTION AS "FINALITA_SOTTOPROC",
	WEPT.WORK_EFFORT_PURPOSE_TYPE_CODE AS "FINALITA_CODICE",
	SPT.PURPOSE_ETCH AS "ETICHETTA_FINALITA",
	WETCSP.ETCH AS "ETICHETTA_FATT_RISC"
																										
FROM WORK_EFFORT RA																											
INNER JOIN WORK_EFFORT_TYPE RAT ON RAT.WORK_EFFORT_TYPE_ID = RA.WORK_EFFORT_TYPE_ID	
INNER JOIN WORK_EFFORT_TYPE_CONTENT RADTC ON RADTC.WORK_EFFORT_TYPE_ID = RAT.WORK_EFFORT_TYPE_ID
	AND RADTC.CONTENT_ID = $P{reportContentId}
	
-- area																										
INNER JOIN WORK_EFFORT_ASSOC RR ON RR.WORK_EFFORT_ID_FROM = RA.WORK_EFFORT_ID																											
	AND RR.WORK_EFFORT_ASSOC_TYPE_ID = RAT.HIERARCHY_ASSOC_TYPE_ID																										
INNER JOIN WORK_EFFORT AR ON AR.WORK_EFFORT_ID = RR.WORK_EFFORT_ID_TO
		AND ($P{excludeValidity} = 'Y' OR ($P{excludeValidity} = 'N' AND AR.ESTIMATED_START_DATE <= $P{date3112} AND AR.ESTIMATED_COMPLETION_DATE >= $P{date0101}))	
INNER JOIN WORK_EFFORT_TYPE ART ON ART.WORK_EFFORT_TYPE_ID = AR.WORK_EFFORT_TYPE_ID	

-- Processo
INNER JOIN WORK_EFFORT_ASSOC AP ON AP.WORK_EFFORT_ID_FROM = AR.WORK_EFFORT_ID																											
	AND AP.WORK_EFFORT_ASSOC_TYPE_ID = ART.WORK_EFFORT_ASSOC_TYPE_ID		
INNER JOIN WORK_EFFORT PR ON PR.WORK_EFFORT_ID = AP.WORK_EFFORT_ID_TO
		AND ($P{excludeValidity} = 'Y' OR ($P{excludeValidity} = 'N' AND PR.ESTIMATED_START_DATE <= $P{date3112} AND PR.ESTIMATED_COMPLETION_DATE >= $P{date0101}))																												
INNER JOIN WORK_EFFORT_TYPE PRT ON PRT.WORK_EFFORT_TYPE_ID = PR.WORK_EFFORT_TYPE_ID

-- Sottoprocesso																										
INNER JOIN WORK_EFFORT_ASSOC PP ON PP.WORK_EFFORT_ID_FROM = PR.WORK_EFFORT_ID																											
	AND PP.WORK_EFFORT_ASSOC_TYPE_ID = PRT.WORK_EFFORT_ASSOC_TYPE_ID
INNER JOIN WORK_EFFORT FIL_W ON FIL_W.WORK_EFFORT_ID = PP.WORK_EFFORT_ID_TO	
		AND ($P{excludeValidity} = 'Y' OR ($P{excludeValidity} = 'N' AND FIL_W.ESTIMATED_START_DATE <= $P{date3112} AND FIL_W.ESTIMATED_COMPLETION_DATE >= $P{date0101}))																											
INNER JOIN WORK_EFFORT_TYPE SPT ON SPT.WORK_EFFORT_TYPE_ID = FIL_W.WORK_EFFORT_TYPE_ID
LEFT OUTER JOIN WORK_EFFORT_PURPOSE_TYPE WEPT ON WEPT.WORK_EFFORT_PURPOSE_TYPE_ID = FIL_W.WORK_EFFORT_PURPOSE_TYPE_ID

LEFT OUTER JOIN WORK_EFFORT_TYPE_CONTENT WETCSP ON WETCSP.WORK_EFFORT_TYPE_ID = SPT.WORK_EFFORT_TYPE_ID
  AND WETCSP.CONTENT_ID LIKE '%WEFLD_IND%' AND WETCSP.WORK_EFFORT_PURPOSE_TYPE_ID = 'CORFAT'
  AND WETCSP.WE_TYPE_CONTENT_TYPE_ID = 'FOLDER'																							

INNER JOIN PARTY ST ON  ST.PARTY_ID = FIL_W.ORG_UNIT_ID 
INNER JOIN PARTY_PARENT_ROLE SC ON SC.PARTY_ID = ST.PARTY_ID  AND SC.ROLE_TYPE_ID = 'ORGANIZATION_UNIT'

/* START filterInnerJoin */
   $P!{filterInnerJoinString} 
/* END filterInnerJoin */
/* START filterLeftJoin */
  $P!{filterLeftJoinString} 
/* END filterLeftJoin */
																						
-- 	rischio
INNER JOIN WORK_EFFORT_ASSOC AK ON AK.WORK_EFFORT_ID_FROM = FIL_W.WORK_EFFORT_ID																											
	AND AK.WORK_EFFORT_ASSOC_TYPE_ID = SPT.HIERARCHY_ASSOC_TYPE_ID											
INNER JOIN WORK_EFFORT RI ON RI.WORK_EFFORT_ID = AK.WORK_EFFORT_ID_TO
		AND ($P{excludeValidity} = 'Y' OR ($P{excludeValidity} = 'N' AND RI.ESTIMATED_START_DATE <= $P{date3112} AND RI.ESTIMATED_COMPLETION_DATE >= $P{date0101}))	
INNER JOIN WORK_EFFORT_TYPE RIT ON RIT.WORK_EFFORT_TYPE_ID = RI.WORK_EFFORT_TYPE_ID		

																											
--  RESPONSABILE
LEFT OUTER JOIN PARTY_RELATIONSHIP PR_RES ON  PR_RES.PARTY_ID_FROM = FIL_W.ORG_UNIT_ID
     AND PR_RES.ROLE_TYPE_ID_FROM = FIL_W.ORG_UNIT_ROLE_TYPE_ID
     AND PR_RES.PARTY_RELATIONSHIP_TYPE_ID = 'ORG_RESPONSIBLE'
AND ($P{excludeValidity} = 'N' OR ($P{excludeValidity} = 'Y' AND PR_RES.THRU_DATE IS NULL))
AND ($P{excludeValidity} = 'Y' OR ($P{excludeValidity} = 'N' AND(PR_RES.FROM_DATE   <= $P{monitoringDate} AND (PR_RES.THRU_DATE  >= $P{monitoringDate} OR PR_RES.THRU_DATE IS NULL)  )))

LEFT OUTER JOIN PARTY P_RES ON P_RES.PARTY_ID = PR_RES.PARTY_ID_TO


LEFT OUTER JOIN WORK_EFFORT_NOTE MN3 ON  MN3.WORK_EFFORT_ID = FIL_W.WORK_EFFORT_ID
	AND MN3.SEQUENCE_ID = '10'
LEFT OUTER JOIN NOTE_DATA SPND ON SPND.NOTE_ID = MN3.NOTE_ID
	AND ( MN3.IS_MAIN = 'Y' OR (MN3.IS_MAIN <> 'Y' AND SPND.NOTE_DATE_TIME = $P{monitoringDate}))


																											
WHERE 0=0
	
	 /* START orgUnitIdString */
	$P!{orgUnitIdString}
	/* END orgUnitIdString */
	
	/* START workEffortIdString */
	$P!{workEffortIdString}
	/* END workEffortIdString */

	/* START filterWhere */
	$P!{filterWhereString} 
   /* END filterWhere */  

	AND RA.WORK_EFFORT_REVISION_ID IS NULL AND AR.WORK_EFFORT_REVISION_ID IS NULL AND PR.WORK_EFFORT_REVISION_ID IS NULL AND FIL_W.WORK_EFFORT_REVISION_ID IS NULL 
	AND EXISTS(
		SELECT
			1
		FROM
			WORK_EFFORT_ASSOC WA
		INNER JOIN WORK_EFFORT RIS ON
			RIS.WORK_EFFORT_ID = WA.WORK_EFFORT_ID_TO
		INNER JOIN WORK_EFFORT_ASSOC WAM ON
			WAM.WORK_EFFORT_ID_FROM = RIS.WORK_EFFORT_ID
		INNER JOIN WORK_EFFORT MIS ON
			MIS.WORK_EFFORT_ID = WAM.WORK_EFFORT_ID_TO
		WHERE
			WA.WORK_EFFORT_ID_FROM = FIL_W.WORK_EFFORT_ID
			AND RIS.WORK_EFFORT_TYPE_ID = '15AP4RIS'
			AND MIS.WORK_EFFORT_TYPE_ID LIKE '15AP5M%'
	)
	         
ORDER BY RR.SEQUENCE_NUM,
	AR.ETCH, 
	AP.SEQUENCE_NUM,
	PR.ETCH,
	PP.SEQUENCE_NUM,
	FIL_W.ETCH,
	FIL_W.WORK_EFFORT_NAME,
	FIL_W.DESCRIPTION]]>
	</queryString>
