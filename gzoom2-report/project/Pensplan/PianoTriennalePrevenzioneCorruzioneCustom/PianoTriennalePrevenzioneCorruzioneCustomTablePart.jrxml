					<line>
						<reportElement stretchType="ContainerHeight" x="100" y="0" width="1" height="15" isRemoveLineWhenBlank="true" isPrintWhenDetailOverflows="true" forecolor="#808080" uuid="4a53f2dd-eb6e-4d2a-9400-f7065133bf24">
							<property name="com.jaspersoft.studio.unit.y" value="px"/>
							<property name="com.jaspersoft.studio.unit.width" value="px"/>
