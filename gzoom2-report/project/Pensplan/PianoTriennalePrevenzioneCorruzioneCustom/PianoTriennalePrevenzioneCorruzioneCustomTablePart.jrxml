					</line>
				</frame>
				<frame>
					<reportElement positionType="Float" mode="Transparent" x="0" y="15" width="555" height="15" isRemoveLineWhenBlank="true" backcolor="#F5F5F5" uuid="2ad6336b-1b8f-41b1-a5ee-8bd4b6543f5c">
						<property name="com.jaspersoft.studio.unit.x" value="px"/>
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
						<property name="com.jaspersoft.studio.unit.y" value="px"/>
						<property name="com.jaspersoft.studio.element.name" value="Frame Finalità Sottoprocesso"/>
						<printWhenExpression><![CDATA[$F{FINALITA_SOTTOPROC}!=null && $F{FINALITA_SOTTOPROC}!=""]]></printWhenExpression>
					</reportElement>
					<box>
						<pen lineWidth="0.2" lineColor="#A5A5A5"/>
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.1" lineStyle="Solid" lineColor="#A5A5A5"/>
						<bottomPen lineWidth="0.1" lineStyle="Solid" lineColor="#A5A5A5"/>
						<rightPen lineWidth="0.1" lineStyle="Solid" lineColor="#A5A5A5"/>
