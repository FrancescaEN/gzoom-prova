($F{SOTTOPROC_ETCH} !=null && $F{SOTTOPROC_ETCH}!="" ? $F{SOTTOPROC_ETCH}  + " - "  + $F{SOTTOPROC_NAME} : $F{SOTTOPROC_NAME})]]></textFieldExpression>
