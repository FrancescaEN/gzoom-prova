	<subDataset name="RelationshipMisureDS" uuid="dce4a85b-4195-4d81-9951-95c3caee5eb5">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="gzoom_provbrescia_prod"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="workEffortId" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[$P{workEffortId} != null && $P{workEffortId}  != ""  && LEN($P{workEffortId}) != 0? " AND FIL_W.WORK_EFFORT_ID = '"+ $P{workEffortId} + "'" : " "]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT 
/*QUERYY
 */
     WC.ETCH AS "ETCH", 
     STRING_AGG(WEA.WE_FROM_NAME,E'\n' ) AS "NAME", 
     WC.CONTENT_ID AS "CONTENT_ID",
     WEA.WE_ASS_COMMENTS AS "COMMENTS",
     WC.ETCH AS "WC_ETCH",
     p.party_name,
     ppr.parent_role_code 
FROM WORK_EFFORT WE
INNER JOIN WORK_EFFORT_TYPE_CONTENT WC ON WC.WORK_EFFORT_TYPE_ID = WE.WORK_EFFORT_TYPE_ID 
	AND WC.WE_TYPE_CONTENT_TYPE_ID = 'FOLDER' 
	AND WC.CONTENT_ID LIKE 'WEFLD_WET%'
	AND WC.IS_VISIBLE = 'Y'
INNER JOIN WORK_EFFORT_TYPE_ASSOC WA ON WA.WORK_EFFORT_TYPE_ID = WC.WORK_EFFORT_TYPE_ID 
	AND WA.CONTENT_ID = WC.CONTENT_ID
INNER JOIN WORK_EFFORT_ASSOC_VIEW WEA ON WEA.WE_TO_ID = WE.WORK_EFFORT_ID 
	AND WEA.WE_FROM_TYPE_ID = WA.WORK_EFFORT_TYPE_ID_REF
join party p on p.party_id = WEA.we_from_org_unit_id 
join party_parent_role ppr on ppr.party_id = p.party_id and ppr.role_type_id != 'INTERNAL_ORGANIZATIO'
WHERE WE.WORK_EFFORT_ID =  $P{workEffortId} 
AND WC.ETCH like 'Misure di sicurezza'
group by ppr.parent_role_code,WC.ETCH, 
     WC.CONTENT_ID,
     WEA.WE_ASS_COMMENTS,
     WC.ETCH,
     p.party_name
UNION ALL
SELECT 
     WC.ETCH AS "ETCH", 
     STRING_AGG(WEA.WE_TO_NAME, E'\n') AS "NAME", 
     WC.CONTENT_ID AS "CONTENT_ID",
     WEA.WE_ASS_COMMENTS  AS "COMMENTS",
     WC.ETCH AS "WC_ETCH",
     p.party_name,
     ppr.parent_role_code 
FROM WORK_EFFORT WE
INNER JOIN WORK_EFFORT_TYPE_CONTENT WC ON WC.WORK_EFFORT_TYPE_ID = WE.WORK_EFFORT_TYPE_ID 
	AND WC.WE_TYPE_CONTENT_TYPE_ID = 'FOLDER' 
	AND WC.CONTENT_ID LIKE 'WEFLD_WEF%'
INNER JOIN WORK_EFFORT_TYPE_ASSOC WA ON WA.WORK_EFFORT_TYPE_ID = WC.WORK_EFFORT_TYPE_ID
	AND WA.CONTENT_ID = WC.CONTENT_ID
	AND WC.IS_VISIBLE = 'Y'
INNER JOIN WORK_EFFORT_ASSOC_VIEW WEA ON WEA.WE_FROM_ID = WE.WORK_EFFORT_ID 
	AND WE_ASS_PARENT_TYPE_ID IS NULL
	AND WA.WORK_EFFORT_TYPE_ID_REF = WEA.WE_TO_TYPE_ID
	join party p on p.party_id = WEA.we_from_org_unit_id 
join party_parent_role ppr on ppr.party_id = p.party_id and ppr.role_type_id != 'INTERNAL_ORGANIZATIO'
WHERE WE.WORK_EFFORT_ID =  $P{workEffortId}
AND WC.ETCH like 'Misure di sicurezza'
group by ppr.parent_role_code,WC.ETCH,
     WC.CONTENT_ID,
     WEA.WE_ASS_COMMENTS,
     WC.ETCH,
     p.party_name]]>
		</queryString>
