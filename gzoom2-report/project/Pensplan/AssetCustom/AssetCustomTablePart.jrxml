	<subDataset name="RelationshipDS" uuid="deefdd9d-55df-4e23-b150-2dd40d494033">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="gzoom_provbrescia_prod"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="workEffortId" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[$P{workEffortId} != null && $P{workEffortId}  != ""  && LEN($P{workEffortId}) != 0? " AND FIL_W.WORK_EFFORT_ID = '"+ $P{workEffortId} + "'" : " "]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT 
/*QUERYY
 */
     WC.ETCH AS "ETCH", 
     STRING_AGG(WEA.WE_FROM_NAME,E'\n' ) AS "NAME", 
     WC.CONTENT_ID AS "CONTENT_ID",
     WEA.WE_ASS_COMMENTS AS "COMMENTS",
     WC.ETCH AS "WC_ETCH",
     p.party_name,
     ppr.parent_role_code 
FROM WORK_EFFORT WE
INNER JOIN WORK_EFFORT_TYPE_CONTENT WC ON WC.WORK_EFFORT_TYPE_ID = WE.WORK_EFFORT_TYPE_ID 
	AND WC.WE_TYPE_CONTENT_TYPE_ID = 'FOLDER' 
	AND WC.CONTENT_ID LIKE 'WEFLD_WET%'
	AND WC.IS_VISIBLE = 'Y'
INNER JOIN WORK_EFFORT_TYPE_ASSOC WA ON WA.WORK_EFFORT_TYPE_ID = WC.WORK_EFFORT_TYPE_ID 
	AND WA.CONTENT_ID = WC.CONTENT_ID
INNER JOIN WORK_EFFORT_ASSOC_VIEW WEA ON WEA.WE_TO_ID = WE.WORK_EFFORT_ID 
	AND WEA.WE_FROM_TYPE_ID = WA.WORK_EFFORT_TYPE_ID_REF
join party p on p.party_id = WEA.we_from_org_unit_id 
join party_parent_role ppr on ppr.party_id = p.party_id and ppr.role_type_id != 'INTERNAL_ORGANIZATIO'
WHERE WE.WORK_EFFORT_ID =  $P{workEffortId} 
AND WC.ETCH like 'Trattamenti dati'
group by ppr.parent_role_code,WC.ETCH, 
     WC.CONTENT_ID,
     WEA.WE_ASS_COMMENTS,
     WC.ETCH,
     p.party_name
UNION ALL
SELECT 
     WC.ETCH AS "ETCH", 
     STRING_AGG(WEA.WE_TO_NAME, E'\n') AS "NAME", 
     WC.CONTENT_ID AS "CONTENT_ID",
     WEA.WE_ASS_COMMENTS  AS "COMMENTS",
     WC.ETCH AS "WC_ETCH",
     p.party_name,
     ppr.parent_role_code 
FROM WORK_EFFORT WE
INNER JOIN WORK_EFFORT_TYPE_CONTENT WC ON WC.WORK_EFFORT_TYPE_ID = WE.WORK_EFFORT_TYPE_ID 
	AND WC.WE_TYPE_CONTENT_TYPE_ID = 'FOLDER' 
	AND WC.CONTENT_ID LIKE 'WEFLD_WEF%'
INNER JOIN WORK_EFFORT_TYPE_ASSOC WA ON WA.WORK_EFFORT_TYPE_ID = WC.WORK_EFFORT_TYPE_ID
	AND WA.CONTENT_ID = WC.CONTENT_ID
	AND WC.IS_VISIBLE = 'Y'
INNER JOIN WORK_EFFORT_ASSOC_VIEW WEA ON WEA.WE_FROM_ID = WE.WORK_EFFORT_ID 
	AND WE_ASS_PARENT_TYPE_ID IS NULL
	AND WA.WORK_EFFORT_TYPE_ID_REF = WEA.WE_TO_TYPE_ID
	join party p on p.party_id = WEA.we_from_org_unit_id 
join party_parent_role ppr on ppr.party_id = p.party_id and ppr.role_type_id != 'INTERNAL_ORGANIZATIO'
WHERE WE.WORK_EFFORT_ID =  $P{workEffortId}
AND WC.ETCH like 'Trattamenti dati'
group by ppr.parent_role_code,WC.ETCH,
     WC.CONTENT_ID,
     WEA.WE_ASS_COMMENTS,
     WC.ETCH,
     p.party_name]]>
		</queryString>
		<field name="ETCH" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="ETCH"/>
			<property name="com.jaspersoft.studio.field.label" value="ETCH"/>
		</field>
		<field name="NAME" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="NAME"/>
			<property name="com.jaspersoft.studio.field.label" value="NAME"/>
		</field>
		<field name="CONTENT_ID" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="CONTENT_ID"/>
			<property name="com.jaspersoft.studio.field.label" value="CONTENT_ID"/>
		</field>
		<field name="COMMENTS" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="COMMENTS"/>
			<property name="com.jaspersoft.studio.field.label" value="COMMENTS"/>
		</field>
		<field name="WC_ETCH" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="WC_ETCH"/>
			<property name="com.jaspersoft.studio.field.label" value="WC_ETCH"/>
		</field>
		<field name="party_name" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="party_name"/>
			<property name="com.jaspersoft.studio.field.label" value="party_name"/>
		</field>
		<field name="parent_role_code" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="parent_role_code"/>
			<property name="com.jaspersoft.studio.field.label" value="parent_role_code"/>
		</field>
		<variable name="Variable_1" class="java.lang.Integer" resetType="Group" resetGroup="Group2" calculation="Count">
			<variableExpression><![CDATA[$F{NAME}]]></variableExpression>
		</variable>
		<group name="Group2" keepTogether="true">
			<groupExpression><![CDATA[$F{parent_role_code}]]></groupExpression>
		</group>
		<group name="Group1" isReprintHeaderOnEachPage="true" keepTogether="true">
			<groupExpression><![CDATA[$F{ETCH}]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="IndicatoriDS" uuid="189294c4-fc70-49bb-9ab7-22f69097ee3e">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="gzoom_provbrescia_prod"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="256"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="739"/>
		<parameter name="workEffortId" class="java.lang.String" isForPrompting="false"/>
		<parameter name="retrieveWorkEffortId" class="java.lang.String">
			<defaultValueExpression><![CDATA[IF ($P{workEffortId} != null && $P{workEffortId}  != ""  && LEN($P{workEffortId}) != 0,
	" AND  FIL_W.ORG_UNIT_ID= '"+ $P{workEffortId} + "' "  ,
	" AND true"
	)]]></defaultValueExpression>
		</parameter>
		<parameter name="accountName" class="java.lang.String">
			<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
		</parameter>
		<parameter name="workEffortId1" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[$P{workEffortId1}]]></defaultValueExpression>
		</parameter>
		<parameter name="customTimePeriod" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[TODAY( )]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT WN.WORK_EFFORT_MEASURE_ID AS "WORK_EFFORT_MEASURE_ID", 
U.ABBREVIATION AS "ABBREVIATION", 
U.DECIMAL_SCALE AS "DECIMAL_SCALE", 
U.UOM_TYPE_ID AS "UOM_TYPE_ID", 
WN.UOM_DESCR AS "UOM_DESCR", 
GL.ACCOUNT_NAME AS "ACCOUNT_NAME",  
WTIC.CONTENT_ID AS "CONTENT_FOLDER_IND", 
WTIC.ETCH AS "ETCH_FOLDER_IND",
GL.ACCOUNT_CODE AS "ACCOUNT_CODE", 
GL.GL_ACCOUNT_ID AS "GL_ACCOUNT_ID", 
	
MAX(CASE WHEN IND.GL_ACCOUNT_ID <> 'SCOREKPI' THEN IND.AMOUNT ELSE NULL END) AS "ACTUAL",
MAX(CASE WHEN IND.GL_ACCOUNT_ID <> 'SCOREKPI' THEN O.UOM_CODE   ELSE NULL END) AS "ACTUAL_CODE"
      	
FROM  WORK_EFFORT_MEASURE WN
INNER JOIN WORK_EFFORT W ON W.WORK_EFFORT_ID = WN.WORK_EFFORT_ID
INNER JOIN WORK_EFFORT_TYPE_CONTENT WTIC ON WTIC.WORK_EFFORT_TYPE_ID = W.WORK_EFFORT_TYPE_ID
	AND WTIC.WE_TYPE_CONTENT_TYPE_ID = 'FOLDER' 
	AND WTIC.CONTENT_ID LIKE 'WEFLD_IND%'
	
INNER JOIN GL_ACCOUNT GL ON GL.GL_ACCOUNT_ID =  WN.GL_ACCOUNT_ID
INNER JOIN UOM U ON GL.DEFAULT_UOM_ID = U.UOM_ID	
INNER JOIN  WORK_EFFORT_PURPOSE_ACCOUNT WA ON WA.GL_ACCOUNT_ID = GL.GL_ACCOUNT_ID 
	AND WA.WORK_EFFORT_PURPOSE_TYPE_ID =  WTIC.WORK_EFFORT_PURPOSE_TYPE_ID
	
LEFT OUTER JOIN (
	SELECT  Q0.VOUCHER_REF, Q0.TRANSACTION_DATE, R0.AMOUNT, R0.GL_FISCAL_TYPE_ID, R0.GL_ACCOUNT_ID, R0.CURRENCY_UOM_ID        
        FROM  ACCTG_TRANS Q0 
        INNER JOIN ACCTG_TRANS_ENTRY R0 ON Q0.ACCTG_TRANS_ID = R0.ACCTG_TRANS_ID                     
       WHERE EXTRACT(YEAR FROM Q0.TRANSACTION_DATE) = EXTRACT(YEAR FROM CAST($P{customTimePeriod} AS TIMESTAMP))
) IND ON IND.VOUCHER_REF = WN.WORK_EFFORT_MEASURE_ID 

LEFT OUTER JOIN WORK_EFFORT_MEAS_RAT_SC O ON WN.WORK_EFFORT_MEASURE_ID = O.WORK_EFFORT_MEASURE_ID
                   AND O.UOM_ID = IND.CURRENCY_UOM_ID AND O.UOM_RATING_VALUE = IND.AMOUNT
                   AND IND.GL_ACCOUNT_ID NOT LIKE 'SCORE%'    
WHERE WN.WORK_EFFORT_ID =  $P{workEffortId} 
GROUP BY  WN.WORK_EFFORT_MEASURE_ID, U.ABBREVIATION, U.DECIMAL_SCALE, U.UOM_TYPE_ID, WN.UOM_DESCR, GL.ACCOUNT_NAME, WTIC.CONTENT_ID, 
	WTIC.ETCH, GL.ACCOUNT_CODE, GL.GL_ACCOUNT_ID
	
order by WTIC.ETCH DESC, GL.ACCOUNT_CODE]]>
		</queryString>
		<field name="WORK_EFFORT_MEASURE_ID" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="WORK_EFFORT_MEASURE_ID"/>
			<property name="com.jaspersoft.studio.field.label" value="WORK_EFFORT_MEASURE_ID"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort_measure"/>
		</field>
		<field name="ABBREVIATION" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="ABBREVIATION"/>
