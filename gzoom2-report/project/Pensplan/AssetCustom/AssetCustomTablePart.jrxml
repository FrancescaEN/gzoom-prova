			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort_measure"/>
		</field>
		<field name="ACCOUNT_NAME" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="ACCOUNT_NAME"/>
			<property name="com.jaspersoft.studio.field.label" value="ACCOUNT_NAME"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="gl_account"/>
		</field>
		<field name="CONTENT_FOLDER_IND" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="CONTENT_FOLDER_IND"/>
			<property name="com.jaspersoft.studio.field.label" value="CONTENT_FOLDER_IND"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="work_effort_type_content"/>
