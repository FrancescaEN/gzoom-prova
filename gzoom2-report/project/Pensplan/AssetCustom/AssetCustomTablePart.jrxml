	<parameter name="orgUnitId1" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="workEffortId1" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="exposeReleaseDate" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT 
	  		  /*TEST1*/
              B.ETCH AS "ETICHETTA",
              B.DESCRIPTION AS "TYPE_DESCR",
              FIL_W.ETCH AS "ETCH",
              FIL_W.WORK_EFFORT_NAME AS "WORK_EFFORT_NAME",
              FIL_W.WORK_EFFORT_ID AS "WORK_EFFORT_ID",
              FIL_W.DESCRIPTION AS "DESCRIPTION",
              FIL_W.SOURCE_REFERENCE_ID AS "CODE",
              FIL_W.ESTIMATED_START_DATE AS "ESTIMATED_START_DATE",
              FIL_W.ESTIMATED_COMPLETION_DATE AS "ESTIMATED_COMPLETION_DATE",
              P.PARTY_NAME AS "ORG_UNIT_NAME",
              PPR.PARENT_ROLE_CODE AS "ORG_UNIT_CODE",
              TC.ETCH AS "REPORT_TITOLO",
              
              FIGLIO.SEQUENCE_NUM AS "SEQ1",
              FIGLIO.ETICHETTA1 AS "ETICHETTA1",
              FIGLIO.TYPE_DESCR1 AS "TYPE_DESCR1",              
              FIGLIO.WORK_EFFORT_ID AS "WORK_EFFORT_ID1",
              FIGLIO.WORK_EFFORT_NAME AS "WORK_EFFORT_NAME1",
              FIGLIO.DESCRIPTION AS "DESCRIPTION1",
              FIGLIO.ETCH AS "ETCH1",
              FIGLIO.SOURCE_REFERENCE_ID AS "CODE1",
              FIGLIO.ESTIMATED_START_DATE AS "ESTIMATED_START_DATE1",
              FIGLIO.ESTIMATED_COMPLETION_DATE AS "ESTIMATED_COMPLETION_DATE1",
              FIGLIO.PARTY_NAME AS "ORG_UNIT_NAME1",
              FIGLIO.PARENT_ROLE_CODE AS "ORG_UNIT_CODE1",
              WEPT.DESCRIPTION AS "DESCRTRATT"
	           
FROM WORK_EFFORT FIL_W

INNER JOIN WORK_EFFORT_TYPE B ON B.WORK_EFFORT_TYPE_ID = FIL_W.WORK_EFFORT_TYPE_ID	 
left join work_effort_purpose_type wept on wept.work_effort_purpose_type_id = FIL_W.work_effort_purpose_type_id

LEFT OUTER JOIN WORK_EFFORT_TYPE_CONTENT TC ON TC.WORK_EFFORT_TYPE_ID = FIL_W.WORK_EFFORT_TYPE_ID
	   AND TC.CONTENT_ID = $P{reportContentId} 
LEFT OUTER JOIN PARTY P ON P.PARTY_ID = FIL_W.ORG_UNIT_ID
LEFT OUTER JOIN PARTY_PARENT_ROLE PPR ON PPR.PARTY_ID = P.PARTY_ID AND PPR.ROLE_TYPE_ID = 'ORGANIZATION_UNIT' 	
  
LEFT OUTER JOIN (
		SELECT Z1.WORK_EFFORT_ID_FROM, A1.WORK_EFFORT_ID, A1.WORK_EFFORT_NAME, A1.ETCH, A1.ESTIMATED_START_DATE, A1.ESTIMATED_COMPLETION_DATE, 
		Z1.SEQUENCE_NUM, P.PARTY_NAME, PPR.PARENT_ROLE_CODE, A1.SOURCE_REFERENCE_ID, A1.DESCRIPTION, B1.DESCRIPTION AS TYPE_DESCR1, B1.ETCH AS ETICHETTA1, Z1.WORK_EFFORT_ASSOC_TYPE_ID
		FROM WORK_EFFORT_ASSOC Z1 
	        INNER JOIN WORK_EFFORT A1 ON A1.WORK_EFFORT_ID = Z1.WORK_EFFORT_ID_TO AND A1.WORK_EFFORT_REVISION_ID IS NULL        	
	        INNER JOIN WORK_EFFORT_ASSOC_TYPE D1 ON D1.WORK_EFFORT_ASSOC_TYPE_ID = Z1.WORK_EFFORT_ASSOC_TYPE_ID
	        INNER JOIN WORK_EFFORT_TYPE B1 ON B1.WORK_EFFORT_TYPE_ID = A1.WORK_EFFORT_TYPE_ID
		    LEFT OUTER JOIN PARTY P ON P.PARTY_ID = A1.ORG_UNIT_ID
			LEFT OUTER JOIN PARTY_PARENT_ROLE PPR ON PPR.PARTY_ID = P.PARTY_ID AND PPR.ROLE_TYPE_ID = 'ORGANIZATION_UNIT' 	
		    
	       WHERE (  $P{excludeValidity}  = 'Y' OR  ( $P{excludeValidity}  = 'N' AND ( Z1.FROM_DATE <= CAST($P{customTimePeriod} AS TIMESTAMP )AND (Z1.THRU_DATE >= CAST($P{customTimePeriod} AS TIMESTAMP )OR Z1.THRU_DATE IS NULL ))))
			 $P!{workEffortTypeTrattString} 		
					
) FIGLIO ON FIGLIO.WORK_EFFORT_ID_FROM = FIL_W.WORK_EFFORT_ID  
    $P!{workEffortAssocTypeIdString} 
    $P!{filterInnerJoinString}
    $P!{filterLeftJoinString} 
   
	
	WHERE (  $P{excludeValidity} = 'Y' OR  ( $P{excludeValidity} = 'N' AND ( FIL_W.ESTIMATED_START_DATE <= CAST($P{customTimePeriod} AS TIMESTAMP ) AND FIL_W.ESTIMATED_COMPLETION_DATE >= CAST($P{customTimePeriod} AS TIMESTAMP ))))
 	AND FIL_W.WORK_EFFORT_REVISION_ID IS NULL
 	 $P!{orgUnitIdString} 
 	 $P!{retrieveWorkEffortId} 
 	 $P!{workEffortTypeList} 
 	 $P!{filterWhereString}]]>
	</queryString>
	<field name="ETICHETTA" class="java.lang.String">
