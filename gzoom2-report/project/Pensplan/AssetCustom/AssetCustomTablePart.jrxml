			<![CDATA[V09SS19FRkZPUlQgLDE1LDE1LDY0NWY0NmMwLTFmNWEtNGMyNS1iYjY5LWZkYWI0Y2QzMWI1MDtX
T1JLX0VGRk9SVF9BU1NPQyAsMjg4LDE1LDc3MDc2YmVkLTY4OTQtNDRlNi1hZjk0LWFmYTZkYzNl
NmUxZjtXT1JLX0VGRk9SVCAsMTU3LDE1LDZkOTE2ZjZmLTcwN2YtNGFiMC05MjM5LTk2NGJiMzI0
MjhkYzs=]]>
		</property>
		<parameter name="workEffortId" class="java.lang.String"/>
		<parameter name="customTimePeriod" class="java.util.Date"/>
		<queryString>
			<![CDATA[SELECT
  TRA.WORK_EFFORT_NAME AS "TRATTAMENTO"
FROM WORK_EFFORT W
LEFT JOIN WORK_EFFORT_ASSOC WEA 
  ON WEA.WORK_EFFORT_ID_TO = W.WORK_EFFORT_ID 
  AND WEA.WORK_EFFORT_ASSOC_TYPE_ID = '18PRTRTRA'
INNER JOIN WORK_EFFORT TRA 
  ON TRA.WORK_EFFORT_ID = WEA.WORK_EFFORT_ID_FROM
WHERE W.WORK_EFFORT_ID = $P{workEffortId} 
  AND TRA.ESTIMATED_COMPLETION_DATE >= CAST( $P{customTimePeriod} AS TIMESTAMP)
  AND TRA.ESTIMATED_START_DATE <= CAST( $P{customTimePeriod} AS TIMESTAMP)]]>
		</queryString>
		<field name="TRATTAMENTO" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="TRATTAMENTO"/>
			<property name="com.jaspersoft.studio.field.name" value="TRATTAMENTO"/>
		</field>
	</subDataset>
