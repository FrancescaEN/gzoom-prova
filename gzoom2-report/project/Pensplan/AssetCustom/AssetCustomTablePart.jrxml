			<![CDATA[V09SS19FRkZPUlRfQ09OVEVOVCAsMjUwLDE1LDI5YjliMDc5LTdlMzctNDJjNC1hZmE5LWQxYTMz
NDA3ZDJiYjtXT1JLX0VGRk9SVCAsMTE5LDE1LGViZDMwYzExLTZkODUtNDc5Mi1hOTIwLTAxOTRj
ZjQ4YzliNTtDT05URU5UICwxNSwxNSw5ZDk1MmEzZS05OTkwLTQ4MmYtODY2NS1mYTRhMDMzM2U5
Mjc7]]>
		</property>
		<parameter name="workEffortId" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT
  C.DESCRIPTION AS "ALLEGATI"
FROM WORK_EFFORT W
LEFT JOIN WORK_EFFORT_CONTENT WEC ON WEC.WORK_EFFORT_ID = W.WORK_EFFORT_ID
LEFT JOIN CONTENT C ON C.CONTENT_ID = WEC.CONTENT_ID
WHERE WEC.WORK_EFFORT_CONTENT_TYPE_ID = 'GDPR'
  AND WEC.WORK_EFFORT_ID =  $P{workEffortId} 
ORDER BY C.DESCRIPTION ASC]]>
		</queryString>
