            <method name="beforeOpen"><![CDATA[
//@workEffortIdChild
//@workEffortId
var workEffortIdString = '';
/**/if (params["workEffortIdChild"].value != null &amp;&amp; params["workEffortIdChild"].value != '') {
	workEffortIdString = "AND ( OB1.WORK_EFFORT_ID = '"+ params["workEffortIdChild"].value 
		+ "' OR OB2.WORK_EFFORT_ID = '" + params["workEffortIdChild"].value + "' OR OB3.WORK_EFFORT_ID = '" + params["workEffortIdChild"].value +"' OR OB4.WORK_EFFORT_ID = '" +
	    params["workEffortIdChild"].value + "')";	
} else if (params["workEffortId"].value != null &amp;&amp; params["workEffortId"].value != '') {
	workEffortIdString = "AND RAD.WORK_EFFORT_ID = '"+ params["workEffortId"].value + "'";	
} 

this.queryText = this.queryText.replace("@workEffortId",  workEffortIdString );


/**/ 

//@orgUnitIdÌ
var orgUnitIdString = '';
/**/ if (params["orgUnitId"].value != null &amp;&amp; params["orgUnitId"].value != '') {
	orgUnitIdString = "AND OB3.ORG_UNIT_ID = '"+ params["orgUnitId"].value + "'";	
} 
this.queryText = this.queryText.replace("@orgUnitId",  orgUnitIdString );

//aggiungo controllo parametro onlyMeasureAnomalous
var onlyMeasureAnomalousString = '';
/**/ if (params["onlyMeasureAnomalous"].value == 'Y') {
	onlyMeasureAnomalousString = "AND AC.GL_ACCOUNT_TYPE_ID = 'CORSAL' AND  RI.GL_FISCAL_TYPE_ID = 'ACTUAL' AND  RI.AMOUNT < 100";	
}
this.queryText = this.queryText.replace("@onlyMeasureAnomalous",  onlyMeasureAnomalousString );

// se sono nel caso di andamento misure prendo le sole misure con  AC.GL_ACCOUNT_TYPE_ID = 'CORSAL' e amount !=null
var andamentoMisuraString = '';
/**/ if (params["reportContentId"].value == 'REPORT_ANDA_MIS' ) {
	andamentoMisuraString = " AND AC.GL_ACCOUNT_TYPE_ID = 'CORSAL' AND RI.AMOUNT IS NOT NULL ";
} 
this.queryText = this.queryText.replace("@andamentoMisura",  andamentoMisuraString );

var organizationIdString = "";
/**/ if (params["organizationId"].value != null &amp;&amp; params["organizationId"].value != '') {
    organizationIdString = "AND RAD.ORGANIZATION_ID = '" + params["organizationId"].value + "'";
} 
this.queryText = this.queryText.replace("@organizationId", organizationIdString);

//@userProfile
this.queryText = this.queryText.replace("@userProfile",  "'" + params["userProfile"].value + "'" );
//@userLoginId
this.queryText = this.queryText.replace("@userLoginId",  "'" + params["userLoginId"].value + "'" );


//AGGIUNGO PARAMETRI PER GESTIRE IL BILINGUISMO
//estraggo la descrizione corretta agg. _LANG se è la seconda, 
//altrimenti aggiungerà solo una stringa vuota
this.queryText = this.queryText.replace("@langLocale",  params["langLocale"].value);

/**/
this.queryText = this.queryText.replace("@reportContentId", "'" + params["reportContentId"].value  + "'");
this.queryText = this.queryText.replace("@excludeValidity", "'" + params["excludeValidity"].value  + "'");
this.queryText = this.queryText.replace("@date0101",  params["date0101Sql"].value );
this.queryText = this.queryText.replace("@date3112",  params["date3112Sql"].value );	
this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );
/* 
this.queryText = this.queryText.replace("@date0101",  "'2019-01-01 00:00:00.000'" );
this.queryText = this.queryText.replace("@date3112",  "'2019-12-31 00:00:00.000'" );
this.queryText = this.queryText.replace("@monitoringDate",  "'2019-12-31 00:00:00.000'"); 
this.queryText = this.queryText.replace("@excludeValidity", "'N'");
*/

//this.queryText = this.queryText.replace("@reportContentId",  "'REPORT_PTPC_NO_NOTE'" ); 

//GESTIRE PERMESSI
/* */
filter = new com.mapsengineering.base.birt.util.UtilFilter(params["userLoginId"].value, params["localDispatcherName"].value);
var filterInnerJoin = filter.getWorkEffortFilterInner();
var filterLeftJoin = filter.getWorkEffortFilterLeftJoin();
var filterWhere = filter.getWorkEffortFilterWhere();

/*
var filterInnerJoin = "";
var filterLeftJoin = "";
var filterWhere = "";  
*/
this.queryText = this.queryText.replace("@filterInnerJoin",  filterInnerJoin );
this.queryText = this.queryText.replace("@filterLeftJoin",  filterLeftJoin );
this.queryText = this.queryText.replace("@filterWhere",  filterWhere );

ReportLog.info(".HeaderDS... "+this.queryText);
ReportLog.info(".PARAMS... "+this.getInputParameters());
]]></method>
