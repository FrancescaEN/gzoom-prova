            <xml-property name="queryText"><![CDATA[SELECT 
	-- INDICATORI
	AC.ACCOUNT_NAME AS "ACCOUNT_NAME", WI.UOM_DESCR AS "UOM_DESCR", UOM.DECIMAL_SCALE AS "DECIMAL_SCALE", UOM.ABBREVIATION AS "ABBREVIATION", AC.GL_ACCOUNT_TYPE_ID AS "GL_ACCOUNT_TYPE_ID",
		
	MAX(CASE WHEN RI.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN RI.AMOUNT ELSE NULL END)  "ACTUAL_AMOUNT",
	MAX(CASE WHEN RI.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN RI.ATE_DESCRIPTION ELSE NULL END)  "ACTUAL_RIF",
		MAX(CASE WHEN RI.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN RI.AT_DESCRIPTION ELSE NULL END)  "ACTUAL_COMM",			
	MAX(CASE WHEN RI.GL_FISCAL_TYPE_ID = 'BUDGET' THEN RI.AMOUNT ELSE NULL END)  "BUDGET_AMOUNT"
			
FROM WORK_EFFORT_MEASURE WI 		
	LEFT JOIN GL_ACCOUNT AC ON AC.GL_ACCOUNT_ID = WI.GL_ACCOUNT_ID
  and AC.gl_account_type_id <> 'CORRIS'
	LEFT JOIN UOM UOM ON AC.DEFAULT_UOM_ID = UOM.UOM_ID
																						
	LEFT JOIN (																																				
		SELECT TP.VOUCHER_REF, TP.TRANSACTION_DATE, EP.AMOUNT, TP.GL_FISCAL_TYPE_ID, TP.DESCRIPTION	 AS AT_DESCRIPTION,
			EP.DESCRIPTION	 AS ATE_DESCRIPTION																																			
		FROM ACCTG_TRANS TP																																			
			INNER JOIN ACCTG_TRANS_ENTRY EP ON EP.ACCTG_TRANS_ID = TP.ACCTG_TRANS_ID																																		
		WHERE EP.GL_ACCOUNT_ID <> 'SCOREKPI'																																		
		) RI ON RI.VOUCHER_REF = WI.WORK_EFFORT_MEASURE_ID AND RI.TRANSACTION_DATE = ?    
			
																												
WHERE WI.WORK_EFFORT_ID= ?
	AND WI.WE_MEASURE_TYPE_ENUM_ID <> 'WEMT_SCORE'
	AND AC.GL_ACCOUNT_TYPE_ID <> 'CORSAL'

GROUP BY		
	-- INDICATORI
	AC.ACCOUNT_NAME, WI.UOM_DESCR, UOM.DECIMAL_SCALE, UOM.ABBREVIATION, AC.GL_ACCOUNT_TYPE_ID

																						
]]></xml-property>
