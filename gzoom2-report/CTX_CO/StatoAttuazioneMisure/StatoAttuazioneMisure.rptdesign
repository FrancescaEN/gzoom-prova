            </list-property>
            <xml-property name="queryText"><![CDATA[
	SELECT  
		RADTC.ETCH@langLocale AS "RAD_TITOLO",
		OB1.WORK_EFFORT_ID AS "WORK_EFFORT_ID1", OB1T.ETCH@langLocale AS "ETCH_TYPE1", OB1.ETCH AS "ETCH1", OB1.WORK_EFFORT_NAME@langLocale AS "WORK_EFFORT_NAME1", OB1A.SEQUENCE_NUM AS "SEQUENCE_NUM1", OB1.DESCRIPTION@langLocale AS "DESCRIPTION1", OB1A.ASSOC_WEIGHT AS "ASSOC_WEIGHT1", OB1.SOURCE_REFERENCE_ID AS "SOURCE_REFERENCE_ID1",        
		OB2.WORK_EFFORT_ID AS "WORK_EFFORT_ID2", OB2T.ETCH@langLocale AS "ETCH_TYPE2", OB2.ETCH AS "ETCH2", OB2.WORK_EFFORT_NAME@langLocale AS "WORK_EFFORT_NAME2", OB2A.SEQUENCE_NUM AS "SEQUENCE_NUM2", OB2.DESCRIPTION@langLocale AS "DESCRIPTION2", OB2A.ASSOC_WEIGHT AS "ASSOC_WEIGHT2", OB2.SOURCE_REFERENCE_ID AS "SOURCE_REFERENCE_ID2",  
		OB3.WORK_EFFORT_ID AS "WORK_EFFORT_ID3", OB3T.ETCH@langLocale AS "ETCH_TYPE3", OB3.ETCH AS "ETCH3", OB3.WORK_EFFORT_NAME@langLocale AS "WORK_EFFORT_NAME3", OB3A.SEQUENCE_NUM AS "SEQUENCE_NUM3", OB3.DESCRIPTION@langLocale AS "DESCRIPTION3", OB3A.ASSOC_WEIGHT AS "ASSOC_WEIGHT3", OB3.SOURCE_REFERENCE_ID AS "SOURCE_REFERENCE_ID3",	
		OB4.WORK_EFFORT_ID AS "WORK_EFFORT_ID4", OB4T.ETCH@langLocale AS "ETCH_TYPE4", OB4.ETCH AS "ETCH4", OB4.WORK_EFFORT_NAME@langLocale AS "WORK_EFFORT_NAME4", OB4A.SEQUENCE_NUM AS "SEQUENCE_NUM4", OB4.DESCRIPTION@langLocale AS "DESCRIPTION4", OB4A.ASSOC_WEIGHT AS "ASSOC_WEIGHT4", OB4.SOURCE_REFERENCE_ID AS "SOURCE_REFERENCE_ID4",	
		OB5.WORK_EFFORT_ID AS "WORK_EFFORT_ID5", OB5T.ETCH@langLocale AS "ETCH_TYPE5", OB5.ETCH AS "ETCH5", OB5.WORK_EFFORT_NAME@langLocale AS "WORK_EFFORT_NAME5", OB5A.SEQUENCE_NUM AS "SEQUENCE_NUM5", OB5.DESCRIPTION@langLocale AS "DESCRIPTION5", OB5A.ASSOC_WEIGHT AS "ASSOC_WEIGHT5", OB5.SOURCE_REFERENCE_ID AS "SOURCE_REFERENCE_ID5",	
			OB5T.DESCRIPTION@langLocale AS "DESCRIPTION_TYPE5",
		SC.PARENT_ROLE_CODE AS "SC_PARENT_ROLE_CODE", ST.PARTY_NAME@langLocale AS "ST_PARTY_NAME",
		
		
		-- INDICATORI
		AC.ACCOUNT_NAME@langLocale AS "ACCOUNT_NAME", WI.UOM_DESCR@langLocale AS "UOM_DESCR", UOM.DECIMAL_SCALE AS "DECIMAL_SCALE", UOM.ABBREVIATION@langLocale AS "ABBREVIATION", AC.GL_ACCOUNT_TYPE_ID AS "GL_ACCOUNT_TYPE_ID", AC.GL_ACCOUNT_ID AS "GL_ACCOUNT_ID",
		
		MAX(CASE WHEN RI.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN RI.AMOUNT ELSE NULL END)  "ACTUAL_AMOUNT",
		MAX(CASE WHEN RI.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN RI.ATE_DESCRIPTION ELSE NULL END)  "ACTUAL_RIF",
		MAX(CASE WHEN RI.GL_FISCAL_TYPE_ID = 'ACTUAL' THEN RI.AT_DESCRIPTION ELSE NULL END)  "ACTUAL_COMM",	
		MAX(CASE WHEN RI.GL_FISCAL_TYPE_ID = 'BUDGET' THEN RI.AMOUNT ELSE NULL END)  "BUDGET_AMOUNT"
				
			
	FROM WORK_EFFORT RAD		

	INNER JOIN WORK_EFFORT_TYPE RADT ON RADT.WORK_EFFORT_TYPE_ID = RAD.WORK_EFFORT_TYPE_ID
	LEFT JOIN WORK_EFFORT_TYPE_CONTENT RADTC ON RADTC.WORK_EFFORT_TYPE_ID = RAD.WORK_EFFORT_TYPE_ID
		AND RADTC.CONTENT_ID = @reportContentId

	-- area																									
	INNER JOIN WORK_EFFORT_ASSOC OB1A ON OB1A.WORK_EFFORT_ID_FROM = RAD.WORK_EFFORT_ID																											
		AND OB1A.WORK_EFFORT_ASSOC_TYPE_ID = RADT.HIERARCHY_ASSOC_TYPE_ID																										
	INNER JOIN WORK_EFFORT OB1 ON OB1.WORK_EFFORT_ID = OB1A.WORK_EFFORT_ID_TO
		AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND OB1.ESTIMATED_START_DATE <= @date3112 AND OB1.ESTIMATED_COMPLETION_DATE >= @date0101))	
	INNER JOIN WORK_EFFORT_TYPE OB1T ON OB1T.WORK_EFFORT_TYPE_ID = OB1.WORK_EFFORT_TYPE_ID		

	-- sottoarea
	INNER JOIN WORK_EFFORT_ASSOC OB2A ON OB2A.WORK_EFFORT_ID_FROM = OB1.WORK_EFFORT_ID																											
		AND OB2A.WORK_EFFORT_ASSOC_TYPE_ID = OB1T.WORK_EFFORT_ASSOC_TYPE_ID
	INNER JOIN WORK_EFFORT OB2 ON OB2.WORK_EFFORT_ID = OB2A.WORK_EFFORT_ID_TO
		AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND OB2.ESTIMATED_START_DATE <= @date3112 AND OB2.ESTIMATED_COMPLETION_DATE >= @date0101))																											
	INNER JOIN WORK_EFFORT_TYPE OB2T ON OB2T.WORK_EFFORT_TYPE_ID = OB2.WORK_EFFORT_TYPE_ID

	-- processo																										
	INNER JOIN WORK_EFFORT_ASSOC OB3A ON OB3A.WORK_EFFORT_ID_FROM = OB2.WORK_EFFORT_ID																											
		AND OB3A.WORK_EFFORT_ASSOC_TYPE_ID = OB2T.WORK_EFFORT_ASSOC_TYPE_ID	
	INNER JOIN WORK_EFFORT OB3 ON OB3.WORK_EFFORT_ID = OB3A.WORK_EFFORT_ID_TO
		AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND OB3.ESTIMATED_START_DATE <= @date3112 AND OB3.ESTIMATED_COMPLETION_DATE >= @date0101))																											
	INNER JOIN WORK_EFFORT_TYPE OB3T ON OB3T.WORK_EFFORT_TYPE_ID = OB3.WORK_EFFORT_TYPE_ID																										

	INNER JOIN PARTY ST ON  ST.PARTY_ID = OB3.ORG_UNIT_ID 
	INNER JOIN PARTY_PARENT_ROLE SC ON SC.PARTY_ID = ST.PARTY_ID  AND SC.ROLE_TYPE_ID = 'ORGANIZATION_UNIT'

	INNER JOIN WORK_EFFORT FIL_W on
	FIL_W.WORK_EFFORT_ID = OB3A.WORK_EFFORT_ID_TO

	-- rischi																										
	INNER JOIN WORK_EFFORT_ASSOC OB4A ON OB4A.WORK_EFFORT_ID_FROM = OB3.WORK_EFFORT_ID
		AND OB4A.WORK_EFFORT_ASSOC_TYPE_ID = OB3T.HIERARCHY_ASSOC_TYPE_ID																												
	INNER JOIN WORK_EFFORT OB4 ON OB4.WORK_EFFORT_ID = OB4A.WORK_EFFORT_ID_TO
		AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND OB4.ESTIMATED_START_DATE <= @date3112 AND OB4.ESTIMATED_COMPLETION_DATE >= @date0101))																											
	INNER JOIN WORK_EFFORT_TYPE OB4T ON OB4T.WORK_EFFORT_TYPE_ID = OB4.WORK_EFFORT_TYPE_ID	
		
	-- MISURA																										
	INNER JOIN WORK_EFFORT_ASSOC OB5A ON OB5A.WORK_EFFORT_ID_FROM = OB4.WORK_EFFORT_ID
		AND OB5A.WORK_EFFORT_ASSOC_TYPE_ID = OB3T.HIERARCHY_ASSOC_TYPE_ID																												
	INNER JOIN WORK_EFFORT OB5 ON OB5.WORK_EFFORT_ID = OB5A.WORK_EFFORT_ID_TO
		AND (@excludeValidity = 'Y' OR (@excludeValidity = 'N' AND OB5.ESTIMATED_START_DATE <= @date3112 AND OB5.ESTIMATED_COMPLETION_DATE >= @date0101))																											
	INNER JOIN WORK_EFFORT_TYPE OB5T ON OB5T.WORK_EFFORT_TYPE_ID = OB5.WORK_EFFORT_TYPE_ID	


	@filterInnerJoin
  @filterLeftJoin
  
  -- VADO A PRENDERE GLI INDICATORI
	LEFT JOIN WORK_EFFORT_MEASURE WI ON WI.WORK_EFFORT_ID = OB5.WORK_EFFORT_ID
		AND WI.WE_MEASURE_TYPE_ENUM_ID <> 'WEMT_SCORE'
		AND WI.from_date <= @monitoringDate
		AND (WI.thru_date>= @monitoringDate or WI.thru_date=null)
	LEFT JOIN GL_ACCOUNT AC ON AC.GL_ACCOUNT_ID = WI.GL_ACCOUNT_ID
	LEFT JOIN UOM UOM ON AC.DEFAULT_UOM_ID = UOM.UOM_ID
																						
	LEFT JOIN (																																				
		SELECT TP.VOUCHER_REF, TP.TRANSACTION_DATE, EP.AMOUNT, TP.GL_FISCAL_TYPE_ID, TP.DESCRIPTION AS AT_DESCRIPTION,
			EP.DESCRIPTION AS ATE_DESCRIPTION																																			
		FROM ACCTG_TRANS TP																																			
			INNER JOIN ACCTG_TRANS_ENTRY EP ON EP.ACCTG_TRANS_ID = TP.ACCTG_TRANS_ID																																		
		WHERE EP.GL_ACCOUNT_ID <> 'SCOREKPI'																																		
		) RI ON RI.VOUCHER_REF = WI.WORK_EFFORT_MEASURE_ID AND RI.TRANSACTION_DATE = @monitoringDate    
																												
	WHERE 0=0
		 @workEffortId
		 @orgUnitId
		 @onlyMeasureAnomalous
		 @andamentoMisura -- USATO NEL CASO DI ANDAMENTO MISURA
		 @organizationId
     @filterWhere
		
	GROUP BY
		RADTC.ETCH@langLocale,
		OB1.WORK_EFFORT_ID, OB1T.ETCH@langLocale, OB1.ETCH, OB1.WORK_EFFORT_NAME@langLocale, OB1A.SEQUENCE_NUM, OB1.DESCRIPTION@langLocale, OB1A.ASSOC_WEIGHT, OB1.SOURCE_REFERENCE_ID,        
		OB2.WORK_EFFORT_ID, OB2T.ETCH@langLocale, OB2.ETCH, OB2.WORK_EFFORT_NAME@langLocale, OB2A.SEQUENCE_NUM, OB2.DESCRIPTION@langLocale, OB2A.ASSOC_WEIGHT, OB2.SOURCE_REFERENCE_ID,  
		OB3.WORK_EFFORT_ID, OB3T.ETCH@langLocale, OB3.ETCH, OB3.WORK_EFFORT_NAME@langLocale, OB3A.SEQUENCE_NUM, OB3.DESCRIPTION@langLocale, OB3A.ASSOC_WEIGHT, OB3.SOURCE_REFERENCE_ID,	
		OB4.WORK_EFFORT_ID, OB4T.ETCH@langLocale, OB4.ETCH, OB4.WORK_EFFORT_NAME@langLocale, OB4A.SEQUENCE_NUM, OB4.DESCRIPTION@langLocale, OB4A.ASSOC_WEIGHT, OB4.SOURCE_REFERENCE_ID,	
		OB5.WORK_EFFORT_ID, OB5T.ETCH@langLocale, OB5.ETCH, OB5.WORK_EFFORT_NAME@langLocale, OB5A.SEQUENCE_NUM, OB5.DESCRIPTION@langLocale, OB5A.ASSOC_WEIGHT, OB5.SOURCE_REFERENCE_ID,	
			OB5T.DESCRIPTION@langLocale,
		SC.PARENT_ROLE_CODE, ST.PARTY_NAME@langLocale,
		-- INDICATORI
		AC.ACCOUNT_NAME@langLocale, WI.UOM_DESCR@langLocale, UOM.DECIMAL_SCALE, UOM.ABBREVIATION@langLocale, AC.GL_ACCOUNT_TYPE_ID, AC.GL_ACCOUNT_ID
-- END	]]></xml-property>
