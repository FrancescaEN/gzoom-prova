                                <row id="59047">
                                    <method name="onCreate"><![CDATA[//adesso so il numero di pagina corretto vado a settare dentro il vettore il numero della pagina

var mapRealPageNumber = reportContext.getPersistentGlobalVariable("mapRealPageNumber");

var key = this.getRowData().getColumnValue("WORK_EFFORT_ID1") + "_" + this.getRowData().getColumnValue("WORK_EFFORT_ID2") + "_" + this.getRowData().getColumnValue("WORK_EFFORT_ID3") 
//+ "_" + this.getRowData().getColumnValue("WORK_EFFORT_ID4");
var element = mapRealPageNumber.get(key);	
if (element == null) {	
	var NPage = reportContext.getGlobalVariable("nPagina");
	mapRealPageNumber.put(key, NPage);
	reportContext.setPersistentGlobalVariable("mapRealPageNumber", mapRealPageNumber);
}
]]></method>
