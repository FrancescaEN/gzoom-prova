                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT ND.NOTE_NAME AS "OB5_NOTE_NAME" , ND.NOTE_INFO AS "OB5_NOTE_INFO", ND.NOTE_ID AS "note_id", ND.NOTE_DATE_TIME AS "note_date_time", MN.WORK_EFFORT_ID AS "work_effort_id"
  FROM WORK_EFFORT_NOTE MN
  INNER JOIN NOTE_DATA ND ON ND.NOTE_ID = MN.NOTE_ID
  WHERE (MN.IS_MAIN = 'N' OR MN.IS_MAIN IS null)
  AND ND.NOTE_DATE_TIME = @monitoringDate 
  and ND.NOTE_INFO is not null
  and MN.WORK_EFFORT_ID = ?]]></xml-property>
