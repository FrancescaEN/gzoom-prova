	<queryString language="SQL">
		<![CDATA[select m2.DATA_RIFERIMENTO,m2.ANNO, 
	m2.TIPO_MISURA, 
	m2.TIPO_MISURA_LANG, 
	m2.MIS_TIP, 
	-- round(cast(m2.MIS_PREVISTE as decimal(10,2))  / cast(m2.MIS_ANNO as decimal(10,2)) * 100,0) as MIS_PRE_PERC,
	 m2.MIS_ATTUATE, 
	-- round((cast(m2.MIS_ATTUATE  as decimal(10,2)) / cast(m2.MIS_PREVISTE  as decimal(10,2)) * 100) - 100,0) as MIS_DELTA_PERC,
		m2.MIS_PREVISTE
from (select m1.DATA_RIFERIMENTO,m1.ANNO, m1.TIPO_MISURA, m1.TIPO_MISURA_LANG, m1.MIS_TIP, sum(m1.MIS_PREVISTE) as MIS_PREVISTE, sum(m1.MIS_ATTUATE) as MIS_ATTUATE,
(select count(*) from COR_MIS_DETAIL_VIEW t where t.ANNO = m1.ANNO ) as MIS_ANNO
from (select m.DATA_RIFERIMENTO,m.ANNO, m.TIPO_MISURA, m.TIPO_MISURA_LANG, m.MIS_TIP, 1 as MIS_PREVISTE, m.SAL_ATTUATA as MIS_ATTUATE
from COR_MIS_DETAIL_VIEW m
where m.anno=  $P{YEAR} 
$P!{orgUnitIdString} ) m1
   where 1=1
   and m1.DATA_RIFERIMENTO= $P{customTimePeriod} 
group by m1.DATA_RIFERIMENTO,m1.ANNO, m1.TIPO_MISURA, m1.TIPO_MISURA_LANG, m1.MIS_TIP
order by m1.DATA_RIFERIMENTO,m1.ANNO, m1.TIPO_MISURA, m1.TIPO_MISURA_LANG, m1.MIS_TIP) m2]]>
	</queryString>
