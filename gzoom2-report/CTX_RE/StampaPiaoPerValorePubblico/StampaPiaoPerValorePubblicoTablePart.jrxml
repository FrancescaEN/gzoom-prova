	<queryString>
		<![CDATA[select REND.* ,
REND.nome_dimensione$P!{langLocale} as nome_dimensione,
REND.nome_sottodimensione$P!{langLocale} as nome_sottodimensione,
REND.nome_sezione$P!{langLocale} as nome_sezione,
REND.nome_sottosezione$P!{langLocale} as nome_sottosezione,
REND.nome_articolazione$P!{langLocale} as nome_articolazione,
REND.nome_obiettivo_operativo$P!{langLocale} as nome_obiettivo_operativo,
REND.nome_obiettivo_strategico$P!{langLocale} as nome_obiettivo_strategico,
REND.nome_area_strategica$P!{langLocale} as nome_area_strategica,
REND.nome_programma$P!{langLocale} as nome_programma,
REND.nome_missione$P!{langLocale} as nome_missione,
REND.nome_struttura$P!{langLocale} as nome_struttura
from REND_PIAO_VIEW  REND
inner join work_effort FIL_W
on FIL_W.work_effort_id = REND.ID_OBIETTIVO_OPERATIVO
/* START filterInnerJoin */
   $P!{filterInnerJoinString} 
/* END filterInnerJoin */
/* START filterLeftJoin */
  $P!{filterLeftJoinString} 
/* END filterLeftJoin */
where REND.DATA_INIZIO_OBIETTIVO_OPERATIVO <= CAST($P{date3112sql} AS TIMESTAMP) AND REND.DATA_FINE_OBIETTIVO_OPERATIVO >= CAST($P{date0101sql} AS TIMESTAMP) 
  /* START filterWhere */
 $P!{filterWhereString} 
   /* END filterWhere */  
 /* START orgUnitIdString */
 $P!{orgUnitIdString}
 /* END orgUnitIdString */
order by REND.ETCH_DIMENSIONE,
REND.ETCH_SOTTODIMENSIONE,
REND.ETCH_ARTICOLAZIONE,
REND.ETCH_OBIETTIVO_OPERATIVO]]>
	</queryString>
