		<queryString language="SQL">
			<![CDATA[select RESP_POL.ID_SCHEDA,
RESP_POL.NOME_SOGGETTO$P!{langLocale} as nome_soggetto,
RESP_POL.RUOLO_SOGGETTO$P!{langLocale} as ruolo_soggetto
from OBO_RESP_POL RESP_POL
where RESP_POL.ID_SCHEDA = $P{workEffortId}
and RESP_POL.DATA_INIZIO_RESPONSABILITA  <= CAST($P{date3112sql} AS TIMESTAMP) 
and RESP_POL.DATA_FINE_RESPONSABILITA  >= CAST($P{date0101sql} AS TIMESTAMP)]]>
