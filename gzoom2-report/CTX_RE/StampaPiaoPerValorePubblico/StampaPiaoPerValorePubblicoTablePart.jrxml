			<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT 
		INDIC.ID_SCHEDA,
		INDIC.ID_INDICATORE_M,
		INDIC.ID_INDICATORE_A,
		INDIC.NOME_INDICATORE$P!{langLocale} as NOME_INDICATORE,
		INDIC.CODICE_INDICATORE,
		INDIC.UDM$P!{langLocale} as UDM,
		INDIC.TIPO_VALORE,			
		
      MAX(CASE WHEN INDIC.PERIODO_RILEVAZIONE = 'BUDGET' AND INDIC.DATA_VALORE = CAST($P{date3112sql} AS TIMESTAMP) THEN INDIC.VALORE_NUMERICO ELSE NULL END)  BUDGET_VALORE_NUMERICO,
	  MAX(CASE WHEN INDIC.PERIODO_RILEVAZIONE = 'BUDGET' AND INDIC.DATA_VALORE = CAST($P{date3112sql} AS TIMESTAMP) THEN INDIC.VALORE_STRINGA ELSE NULL END)  BUDGET_VALORE_STRINGA,
	  
	  MAX(CASE WHEN INDIC.PERIODO_RILEVAZIONE = 'ACTUAL' AND INDIC.DATA_VALORE = CAST($P{date3112sql} AS TIMESTAMP) THEN INDIC.VALORE_NUMERICO ELSE NULL END)  ACTUAL_VALORE_NUMERICO,
	  MAX(CASE WHEN INDIC.PERIODO_RILEVAZIONE = 'ACTUAL' AND INDIC.DATA_VALORE = CAST($P{date3112sql} AS TIMESTAMP) THEN INDIC.VALORE_STRINGA ELSE NULL END)  ACTUAL_VALORE_STRINGA,	  	   
	  
	  MAX(CASE WHEN INDIC.PERIODO_RILEVAZIONE_PUNTEGGIO = 'ACTUAL' AND INDIC.DATA_PUNTEGGIO = CAST($P{date3112sql} AS TIMESTAMP) THEN INDIC.PUNTEGGIO ELSE NULL END) ACTUAL_PUNTEGGIO,
	  MAX(CASE WHEN INDIC.PERIODO_RILEVAZIONE_PUNTEGGIO = 'ACTUAL' AND INDIC.DATA_PUNTEGGIO = CAST($P{date3112sql} AS TIMESTAMP) THEN INDIC.COMMENTO ELSE NULL END) ACTUAL_PUNTEGGIO_COMMENTO,
	  MAX(CASE WHEN INDIC.PERIODO_RILEVAZIONE_PUNTEGGIO = 'ACTUAL' AND INDIC.DATA_PUNTEGGIO = CAST($P{date3112sql} AS TIMESTAMP) THEN INDIC.EMOTICON ELSE NULL END) ACTUAL_PUNTEGGIO_EMOTICON,
	  
	  MAX(CASE WHEN INDIC.PERIODO_RILEVAZIONE = 'BUDGET' AND INDIC.DATA_VALORE = CAST($P{date3112P1sql} AS TIMESTAMP) THEN INDIC.VALORE_NUMERICO ELSE NULL END)  BUDGET_VALORE_NUMERICO_P1,
	  MAX(CASE WHEN INDIC.PERIODO_RILEVAZIONE = 'BUDGET' AND INDIC.DATA_VALORE = CAST($P{date3112P1sql} AS TIMESTAMP) THEN INDIC.VALORE_STRINGA ELSE NULL END)  BUDGET_VALORE_STRINGA_P1,

	  MAX(CASE WHEN INDIC.PERIODO_RILEVAZIONE = 'ACTUAL' AND INDIC.DATA_VALORE = CAST($P{date3112P1sql} AS TIMESTAMP) THEN INDIC.VALORE_NUMERICO ELSE NULL END)  ACTUAL_VALORE_NUMERICO_P1,
	  MAX(CASE WHEN INDIC.PERIODO_RILEVAZIONE = 'ACTUAL' AND INDIC.DATA_VALORE = CAST($P{date3112P1sql} AS TIMESTAMP) THEN INDIC.VALORE_STRINGA ELSE NULL END)  ACTUAL_VALORE_STRINGA_P1,

	   
	  MAX(CASE WHEN INDIC.PERIODO_RILEVAZIONE = 'BUDGET' AND INDIC.DATA_VALORE = CAST($P{date3112P2sql} AS TIMESTAMP) THEN INDIC.VALORE_NUMERICO ELSE NULL END)  BUDGET_VALORE_NUMERICO_P2,
	  MAX(CASE WHEN INDIC.PERIODO_RILEVAZIONE = 'BUDGET' AND INDIC.DATA_VALORE = CAST($P{date3112P2sql} AS TIMESTAMP) THEN INDIC.VALORE_STRINGA ELSE NULL END)  BUDGET_VALORE_STRINGA_P2,

	  MAX(CASE WHEN INDIC.PERIODO_RILEVAZIONE = 'ACTUAL' AND INDIC.DATA_VALORE = CAST($P{date3112P2sql} AS TIMESTAMP) THEN INDIC.VALORE_NUMERICO ELSE NULL END)  ACTUAL_VALORE_NUMERICO_P2,
	  MAX(CASE WHEN INDIC.PERIODO_RILEVAZIONE = 'ACTUAL' AND INDIC.DATA_VALORE = CAST($P{date3112P2sql} AS TIMESTAMP) THEN INDIC.VALORE_STRINGA ELSE NULL END)  ACTUAL_VALORE_STRINGA_P2,
	  
	  MAX(CASE WHEN INDIC.PERIODO_RILEVAZIONE = 'BUDGET' AND INDIC.DATA_VALORE = CAST($P{date3112M2sql} AS TIMESTAMP) THEN INDIC.VALORE_NUMERICO ELSE NULL END)  BUDGET_VALORE_NUMERICO_M2,
	  MAX(CASE WHEN INDIC.PERIODO_RILEVAZIONE = 'BUDGET' AND INDIC.DATA_VALORE = CAST($P{date3112M2sql} AS TIMESTAMP) THEN INDIC.VALORE_STRINGA ELSE NULL END)  BUDGET_VALORE_STRINGA_M2,

	  MAX(CASE WHEN INDIC.PERIODO_RILEVAZIONE = 'ACTUAL' AND INDIC.DATA_VALORE = CAST($P{date3112M2sql} AS TIMESTAMP) THEN INDIC.VALORE_NUMERICO ELSE NULL END)  ACTUAL_VALORE_NUMERICO_M2,
	  MAX(CASE WHEN INDIC.PERIODO_RILEVAZIONE = 'ACTUAL' AND INDIC.DATA_VALORE = CAST($P{date3112M2sql} AS TIMESTAMP) THEN INDIC.VALORE_STRINGA ELSE NULL END)  ACTUAL_VALORE_STRINGA_M2

FROM PERF_INDIC_VIEW INDIC
where ID_SCHEDA = $P{workEffortId}
 GROUP BY          	
		INDIC.ID_SCHEDA,
		INDIC.ID_INDICATORE_M,
		INDIC.ID_INDICATORE_A,
		INDIC.NOME_INDICATORE$P!{langLocale},
		INDIC.CODICE_INDICATORE,
		INDIC.UDM$P!{langLocale},
		INDIC.TIPO_VALORE
order by INDIC.CODICE_INDICATORE]]>
		</queryString>
