    <data-sets>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="MasterDS" id="59472">
            <property name="nullsOrdering">nulls lowest</property>
            <list-property name="computedColumns">
                <structure>
                    <property name="name">etch_titolo</property>
                    <expression name="expression">row["ETICHETTA"]+" - "+row["TITOLO"]</expression>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <list-property name="columnHints"/>
            <list-property name="parameters"/>
            <structure name="cachedMetaData"/>
            <method name="beforeOpen"><![CDATA[
//this.queryText = this.queryText.replace("@monitoringDate",  "'2021-01-01 00:00:00.000'");


this.queryText = this.queryText.replace("@monitoringDate",  params["monitoringDateSql"].value );

//ReportLog.info("workEffortID prima: "+params["workEffortIdParametric"].value);
//WorkEffortId->WorkEffortIdChild
var workEffortId = '';
/**/if (params["workEffortIdParametric"].value != null &amp;&amp; params["workEffortIdParametric"].value != '') {

	workEffortId = " AND PRO.WORK_EFFORT_ID IN ("+params["workEffortIdParametric"].value+")";
} 
else if(params["workEffortId"].value != null &amp;&amp; params["workEffortId"].value != '') {
	workEffortId = " AND PRO.WORK_EFFORT_ID = '"+params["workEffortId"].value+"'";
}
this.queryText = this.queryText.replace("@workEffortId",  workEffortId );

//@orgUnitId
var orgUnitIdString = '';
/**/if (params["orgUnitId"].value != null &amp;&amp; params["orgUnitId"].value != '') {
	orgUnitIdString = " and pro.org_unit_id = '"+ params["orgUnitId"].value +"' " ;	
}
this.queryText = this.queryText.replace("@orgUnitId",  orgUnitIdString );


//GESTIRE PERMESSI
/*
var filterInnerJoin = "";
var filterLeftJoin = "";
var filterWhere = ""; 
*/
/**/
filter = new com.mapsengineering.base.birt.util.UtilFilter(params["userLoginId"].value, params["localDispatcherName"].value);
filterInnerJoin = filter.getWorkEffortFilterInner();
filterLeftJoin = filter.getWorkEffortFilterLeftJoin();
filterWhere = filter.getWorkEffortFilterWhere();

this.queryText = this.queryText.replace("@filterInnerJoin",  filterInnerJoin );
this.queryText = this.queryText.replace("@filterLeftJoin",  filterLeftJoin );
this.queryText = this.queryText.replace("@filterWhere",  filterWhere );
 
//ReportLog.info("query Rischio Processo "+this.queryText);]]></method>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet"/>
            <xml-property name="queryText"><![CDATA[SELECT 
AR.WORK_EFFORT_NAME AS "AREA",
PRO.ETCH AS "ETICHETTA", 
PRO.WORK_EFFORT_NAME AS "TITOLO",
RESP.PARTY_NAME AS "UNITA_RESPONSABILE",
RISD.UOM_CODE AS "RISCHIO_RESIDUO",
INDT.DESCRIPTION AS "TIPO_INDICATORE_COMPORTAMENTO",
IND.WORK_EFFORT_NAME AS "DESCRIZIONE_INDICATORE_COMPORTAMENTO",
PRID.UOM_CODE AS "POSSIBILI_RISCHI",
MIS.WORK_EFFORT_NAME AS "DESCRIZIONE_MISURA",
M1D.UOM_CODE AS "MISURA_OBBLIGATORIA_ULTERIORE", 
M2D.UOM_CODE AS "TIPOLOGIA_MISURA",
MISNTD.NOTE_INFO AS "TEMPI_ATTUAZIONE",
MISNRD.NOTE_INFO AS "RESPONSABILE_MISURA",
PRO.SOURCE_REFERENCE_ID AS "ORDINAMENTO_1", 
IND.SOURCE_REFERENCE_ID AS "ORDINAMENTO_2",  
MIS.SOURCE_REFERENCE_ID AS "ORDINAMENTO_3"
FROM WORK_EFFORT PRO
INNER JOIN PARTY RESP ON RESP.PARTY_ID = PRO.ORG_UNIT_ID
INNER JOIN WORK_EFFORT_ASSOC ARPRO ON ARPRO.WORK_EFFORT_ID_TO = PRO.WORK_EFFORT_ID 
INNER JOIN WORK_EFFORT AR ON AR.WORK_EFFORT_ID = ARPRO.WORK_EFFORT_ID_FROM AND AR.WORK_EFFORT_TYPE_ID = '20S22ARE'
LEFT JOIN WORK_EFFORT_MEASURE PROM ON PROM.WORK_EFFORT_ID = PRO.WORK_EFFORT_ID AND PROM.GL_ACCOUNT_ID = '10044'
LEFT JOIN ACCTG_TRANS ATR ON PROM.WORK_EFFORT_MEASURE_ID IS NOT NULL AND ATR.VOUCHER_REF = PROM.WORK_EFFORT_MEASURE_ID AND ATR.TRANSACTION_DATE = @monitoringDate -- input.data_ref
LEFT JOIN ACCTG_TRANS_ENTRY RIS ON ATR.ACCTG_TRANS_ID IS NOT NULL AND RIS.ACCTG_TRANS_ID = ATR.ACCTG_TRANS_ID 
LEFT JOIN WORK_EFFORT_MEAS_RAT_SC RISD ON PROM.WORK_EFFORT_MEASURE_ID IS NOT NULL AND RISD.WORK_EFFORT_MEASURE_ID = PROM.WORK_EFFORT_MEASURE_ID 
  AND RIS.AMOUNT IS NOT NULL AND RISD.UOM_RATING_VALUE = RIS.AMOUNT AND RISD.UOM_ID = RIS.CURRENCY_UOM_ID 
INNER JOIN WORK_EFFORT_ASSOC PROIND ON PROIND.WORK_EFFORT_ID_FROM = PRO.WORK_EFFORT_ID AND PROIND.WORK_EFFORT_ASSOC_TYPE_ID = '20C20PRO'
  AND PROIND.FROM_DATE <= @monitoringDate AND PROIND.THRU_DATE >= @monitoringDate -- input.data_ref
INNER JOIN WORK_EFFORT IND ON IND.WORK_EFFORT_ID = PROIND.WORK_EFFORT_ID_TO
INNER JOIN WORK_EFFORT_TYPE INDT ON INDT.WORK_EFFORT_TYPE_ID = IND.WORK_EFFORT_TYPE_ID
INNER JOIN WORK_EFFORT_MEASURE INDM ON INDM.WORK_EFFORT_ID = IND.WORK_EFFORT_ID AND INDM.GL_ACCOUNT_ID = '10020'
  AND INDM.FROM_DATE <= @monitoringDate AND INDM.THRU_DATE >= @monitoringDate -- input.data_ref
LEFT JOIN ACCTG_TRANS_ENTRY PRI ON PRI.VOUCHER_REF = INDM.WORK_EFFORT_MEASURE_ID 
LEFT JOIN WORK_EFFORT_MEAS_RAT_SC PRID ON PRID.WORK_EFFORT_MEASURE_ID = INDM.WORK_EFFORT_MEASURE_ID AND PRID.UOM_RATING_VALUE = PRI.AMOUNT AND PRID.UOM_ID = PRI.CURRENCY_UOM_ID 
LEFT JOIN WORK_EFFORT_ASSOC INDMIS ON INDMIS.WORK_EFFORT_ID_FROM = IND.WORK_EFFORT_ID AND INDMIS.WORK_EFFORT_ASSOC_TYPE_ID = '20C20PRO'
LEFT JOIN WORK_EFFORT MIS ON MIS.WORK_EFFORT_ID = INDMIS.WORK_EFFORT_ID_TO
LEFT JOIN WORK_EFFORT_NOTE MISNT ON MISNT.WORK_EFFORT_ID = MIS.WORK_EFFORT_ID AND MISNT.SEQUENCE_ID = 100
LEFT JOIN NOTE_DATA MISNTD ON MISNTD.NOTE_ID = MISNT.NOTE_ID
LEFT JOIN WORK_EFFORT_NOTE MISNR ON MISNR.WORK_EFFORT_ID = MIS.WORK_EFFORT_ID  AND MISNR.SEQUENCE_ID = 110
LEFT JOIN NOTE_DATA MISNRD ON MISNRD.NOTE_ID = MISNR.NOTE_ID
LEFT JOIN WORK_EFFORT_MEASURE M1M ON M1M.WORK_EFFORT_ID = MIS.WORK_EFFORT_ID AND M1M.GL_ACCOUNT_ID = '10021'
LEFT JOIN ACCTG_TRANS_ENTRY M1E ON M1E.VOUCHER_REF = M1M.WORK_EFFORT_MEASURE_ID 
LEFT JOIN WORK_EFFORT_MEAS_RAT_SC M1D ON M1D.WORK_EFFORT_MEASURE_ID = M1M.WORK_EFFORT_MEASURE_ID AND M1D.UOM_RATING_VALUE = M1E.AMOUNT
AND M1D.UOM_ID = M1E.CURRENCY_UOM_ID AND M1E.AMOUNT IS NOT NULL AND M1M.WORK_EFFORT_MEASURE_ID IS NOT NULL
LEFT JOIN WORK_EFFORT_MEASURE M2M ON M2M.WORK_EFFORT_ID = MIS.WORK_EFFORT_ID AND M2M.GL_ACCOUNT_ID = '10022'
LEFT JOIN ACCTG_TRANS_ENTRY M2E ON M2E.VOUCHER_REF = M2M.WORK_EFFORT_MEASURE_ID 
LEFT JOIN WORK_EFFORT_MEAS_RAT_SC M2D ON M2D.WORK_EFFORT_MEASURE_ID = M2M.WORK_EFFORT_MEASURE_ID AND M2D.UOM_RATING_VALUE = M2E.AMOUNT
AND M2D.UOM_ID = M2E.CURRENCY_UOM_ID AND M2E.AMOUNT IS NOT NULL AND M2M.WORK_EFFORT_MEASURE_ID IS NOT NULL
INNER JOIN WORK_EFFORT FIL_W ON FIL_W.WORK_EFFORT_ID = ARPRO.WORK_EFFORT_ID_TO
@filterInnerJoin
@filterLeftJoin	
WHERE PRO.WORK_EFFORT_TYPE_ID = '20C20PRO'
@workEffortId
@orgUnitId
@filterWhere

ORDER BY PRO.SOURCE_REFERENCE_ID, IND.SOURCE_REFERENCE_ID, MIS.SOURCE_REFERENCE_ID]]></xml-property>
