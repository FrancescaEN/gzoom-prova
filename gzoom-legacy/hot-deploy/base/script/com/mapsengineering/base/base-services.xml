		        <!-- invoco un servizio sincrono, in modo che nella job_sandbox rimane il servizio in stato SERVICE_RUNNING -->
		        <call-service service-name="standardImport" in-map-name="parameters" include-user-login="true">
		        	<result-to-field result-name="resultList"/>
		        </call-service>
		        <check-errors/>
			
				<log level="timing" message=" #################################### resultList ${resultList}"/>
				<iterate entry="result" list="resultList">
					<log level="timing" message=" #################################### result ${result}"/>
					<log level="timing" message=" #################################### result.entityName ${result.entityName}"/>
				</iterate>
			    <field-to-result field="sessionId" result-name="sessionId"/>
			    
			    <set field="argListNames[]" from-field="sessionId"/>
		        <property-to-field resource="StandardImportUiLabels" property="STD_SESSION_ID" field="STD_SESSION_ID" arg-list-name="argListNames"/>
				<!-- <property-to-field resource="StandardImportUiLabels" property="STD_BLOC_ERR" field="STD_BLOC_ERR"/>
				<property-to-field resource="StandardImportUiLabels" property="STD_REC_ELAB" field="STD_REC_ELAB"/>
				<set field="errorRootPrefix" value="&lt;br&gt;${rootLabel} &lt;b&gt;${workEffortRoot.workEffortName}&lt;/b&gt;: &lt;br&gt;"/>
						        	<string-append prefix="&lt;br&gt;" suffix="&lt;br&gt;" string="${errorRootPrefix}" field="lastFailMessage"/>
						        	<string-append string="${firstLabel}" field="lastFailMessage"/>
						        	<string-append prefix=" " suffix=" " string="${newAmount}" field="lastFailMessage"/>
						        	<string-append string="${secondLabel}" field="lastFailMessage"/>
						        	<if-not-empty field="oldAmount">
										<string-append prefix=" " suffix=" " string="${oldAmount}" field="lastFailMessage"/>
