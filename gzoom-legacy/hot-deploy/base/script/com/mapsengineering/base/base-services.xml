    <simple-method use-transaction="false" method-name="standardImportScheduled" short-description="standardImport Scheduled">
        <log level="info" message=" ############################### standardImportScheduled "></log>
		<set field="listSize" value="0" type="Integer"/>
        
        <!-- insert into job_sandbox (job_id, job_name, status_id, run_time, service_name
		   , pool_id, run_as_user, max_recurrence_count, run_by_instance_id
		   , finish_Date_Time) values ('INTERFACE', 'INTERFACE', 'SERVICE_PENDING', '2000-01-01 00:00:00.000', 'standardImportScheduled'
		   , 'pool', 'system', 1, null, null
		); la lista include se stesso -->
		<entity-condition list="standardImportScheduledJobList" entity-name="JobSandbox">
			<condition-list>
				<condition-list combine="or">
					<condition-expr field-name="serviceName" value="standardImportScheduled"/>
					<condition-expr field-name="serviceName" value="standardImport"/>
				</condition-list>
				<condition-list combine="or">
					<condition-expr field-name="statusId" value="SERVICE_RUNNING"/>
					<condition-expr field-name="statusId" value="SERVICE_PENDING"/>
				</condition-list>
			</condition-list>
		</entity-condition>
		<log level="always" message=" #################################### standardImportScheduledJobList ${standardImportScheduledJobList}"/>
        
        <property-to-field resource="StandardImportUiLabels" property="ERROR_STD_SCHE" field="ERROR_STD_SCHE"/>
		<log level="timing" message=" #################################### ERROR_STD_SCHE ${ERROR_STD_SCHE}"/>
		
		<if-not-empty field="standardImportScheduledJobList">
			<call-object-method obj-field="standardImportScheduledJobList" method-name="size" ret-field="listSize"/>
		    <if-compare field="listSize" operator="equals" value="1" type="Integer">
		    	<call-class-method class-name="org.ofbiz.base.util.UtilDateTime" method-name="nowAsString" ret-field="nowStamp"/>
		        <call-class-method method-name="getDigestHash" class-name="org.ofbiz.base.crypto.HashCrypt" ret-field="sessionId">
		            <field field="nowStamp"/>
		            <string value="SHA"/>
		        </call-class-method>
		
				<set field="beginIndex" value="37" type="Integer"/>
