<?xml version="1.0" encoding="UTF-8"?>
<entity-engine-xml>
    <!--  administrative security groups -->
    <SecurityGroup groupId="FULLADMIN"/>
    
    <SecurityPermission description="View operations in the Custom Component." enabled="Y" permissionId="CUSTOM_VIEW"/>
    <SecurityPermission description="Create operations in the Custom Component." enabled="Y" permissionId="CUSTOM_CREATE"/>
    <SecurityPermission description="Update operations in the Custom Component." enabled="Y" permissionId="CUSTOM_UPDATE"/>
    <SecurityPermission description="Delete operations in the Custom Component." enabled="Y" permissionId="CUSTOM_DELETE"/>
    <SecurityPermission description="ALL operations in the Custom Component." enabled="Y" permissionId="CUSTOM_ADMIN"/>

    <SecurityGroupPermission groupId="FULLADMIN" permissionId="CUSTOM_ADMIN"/>
    
    <!-- System UserLogin Account - see additional data in SecurityExtData -->
    <UserLogin userLoginId="system" enabled="N" isSystem="Y"/>
    <UserLoginSecurityGroup groupId="FULLADMIN" userLoginId="system" fromDate="2001-01-01 12:00:00.0"/>
    <!-- Anonymous UserLogin is referenced by services in various components -->
    <UserLogin userLoginId="anonymous" enabled="N"/>
</entity-engine-xml>
